# labwc's own frames, which only dialogs of Linux applications get (XP's
# frames come from Wine): Luna's caption and border colours, flat.
border.width: 3
window.active.border.color: #0831d9
window.inactive.border.color: #7a96df
window.active.title.bg.color: #0a5fe8
window.inactive.title.bg.color: #7a96df
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #d8e4f8
window.label.text.justify: left
window.active.button.unpressed.image.color: #ffffff
window.inactive.button.unpressed.image.color: #d8e4f8
window.active.shadow.size: 0
window.inactive.shadow.size: 0
