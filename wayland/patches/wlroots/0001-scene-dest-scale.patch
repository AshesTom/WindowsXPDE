From: win4wine
Subject: [PATCH] scene: show a surface at a fraction of its size, or a part of it

Purpose: show an Xwayland window one X pixel to one output pixel on an
output of scale 1.5 (or any scale), and a window that spans outputs of
different scales as one part per output.
Before: a scene surface is always shown at its surface size in layout
coordinates; the output's scale then enlarges (and blurs) it.
Change: wlr_scene_surface_set_dest_scale() shows the surface SCALE times
smaller (its input coordinates are scaled back); wlr_scene_surface_set_crop()
shows only a part of it (the existing clip of subsurface trees).
Used by: labwc's xwayland-scale.c (win4wine).
---
 include/wlr/types/wlr_scene.h | 15 +++++++++++++++
 types/scene/surface.c         | 26 ++++++++++++++++++++++++++
 2 files changed, 41 insertions(+)

diff --git a/include/wlr/types/wlr_scene.h b/include/wlr/types/wlr_scene.h
index a8fc215..7abf09e 100644
--- a/include/wlr/types/wlr_scene.h
+++ b/include/wlr/types/wlr_scene.h
@@ -119,6 +119,8 @@ struct wlr_scene_surface {
 	// private state
 
 	struct wlr_box clip;
+	// win4wine: the surface is shown this many times smaller (1 = as is)
+	float dest_scale;
 
 	struct wlr_addon addon;
 
@@ -353,6 +355,19 @@ struct wlr_scene_tree *wlr_scene_tree_from_node(struct wlr_scene_node *node);
  */
 struct wlr_scene_rect *wlr_scene_rect_from_node(struct wlr_scene_node *node);
 
+/**
+ * win4wine: show the surface SCALE times smaller than its size, so that on an
+ * output of that scale each of its pixels takes one output pixel (an Xwayland
+ * client drawing at the output's resolution). 1 shows it as is.
+ */
+void wlr_scene_surface_set_dest_scale(struct wlr_scene_surface *scene_surface, float scale);
+/**
+ * win4wine: show only the part CROP of the surface (surface-local
+ * coordinates); an empty box shows all of it.
+ */
+void wlr_scene_surface_set_crop(struct wlr_scene_surface *scene_surface,
+	const struct wlr_box *crop);
+
 /**
  * If this buffer is backed by a surface, then the struct wlr_scene_surface is
  * returned. If not, NULL will be returned.
diff --git a/types/scene/surface.c b/types/scene/surface.c
index 1905b4d..794ac29 100644
--- a/types/scene/surface.c
+++ b/types/scene/surface.c
@@ -3,6 +3,7 @@
 #include <wlr/types/wlr_alpha_modifier_v1.h>
 #include <wlr/types/wlr_compositor.h>
 #include <wlr/types/wlr_scene.h>
+#include <wlr/util/region.h>
 #include <wlr/types/wlr_fractional_scale_v1.h>
 #include <wlr/types/wlr_presentation_time.h>
 #include <wlr/util/transform.h>
@@ -140,6 +141,13 @@ static void surface_reconfigure(struct wlr_scene_surface *scene_surface) {
 		pixman_region32_intersect_rect(&opaque, &opaque, 0, 0, width, height);
 	}
 
+	if (scene_surface->dest_scale > 0 && scene_surface->dest_scale != 1) {
+		float scale = 1 / scene_surface->dest_scale;
+		width = (int)(width * scale + 0.5f);
+		height = (int)(height * scale + 0.5f);
+		wlr_region_scale(&opaque, &opaque, scale);
+	}
+
 	if (width <= 0 || height <= 0) {
 		wlr_scene_buffer_set_buffer(scene_buffer, NULL);
 		pixman_region32_fini(&opaque);
@@ -200,6 +208,10 @@ static bool scene_buffer_point_accepts_input(struct wlr_scene_buffer *scene_buff
 	struct wlr_scene_surface *scene_surface =
 		wlr_scene_surface_try_from_buffer(scene_buffer);
 
+	if (scene_surface->dest_scale > 0 && scene_surface->dest_scale != 1) {
+		*sx *= scene_surface->dest_scale;
+		*sy *= scene_surface->dest_scale;
+	}
 	*sx += scene_surface->clip.x;
 	*sy += scene_surface->clip.y;
 
@@ -229,6 +241,20 @@ static const struct wlr_addon_interface surface_addon_impl = {
 	.destroy = surface_addon_destroy,
 };
 
+void wlr_scene_surface_set_crop(struct wlr_scene_surface *scene_surface,
+		const struct wlr_box *crop) {
+	struct wlr_box clip = *crop;
+	scene_surface_set_clip(scene_surface, wlr_box_empty(&clip) ? NULL : &clip);
+}
+
+void wlr_scene_surface_set_dest_scale(struct wlr_scene_surface *scene_surface, float scale) {
+	if (scene_surface->dest_scale == scale) {
+		return;
+	}
+	scene_surface->dest_scale = scale;
+	surface_reconfigure(scene_surface);
+}
+
 struct wlr_scene_surface *wlr_scene_surface_try_from_buffer(
 		struct wlr_scene_buffer *scene_buffer) {
 	struct wlr_addon *addon = wlr_addon_find(&scene_buffer->node.addons,
