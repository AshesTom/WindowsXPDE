From: win4wine
Subject: [PATCH] xwayland: name the activated window in _NET_ACTIVE_WINDOW

Purpose: _NET_ACTIVE_WINDOW names the window the compositor activated,
also when its client had moved X's focus there first.
Before: a client may move X's focus among its own windows (the XWM keeps
such a change, xwm_handle_focus_in); activating that window afterwards
did nothing, as it already had the focus, and _NET_ACTIVE_WINDOW kept
naming the window before. Wine takes the window manager's
_NET_ACTIVE_WINDOW as the foreground window, so it activated the previous
window again: the first jump list of Windows 7's taskbar, which Wine
focuses itself, lost its activation at once and stayed black.
Change: the XWM remembers the window it named; activating the focused
window names it if it does not already.
---
 include/xwayland/xwm.h |  2 ++
 xwayland/xwm.c         | 17 +++++++++++++++--
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/include/xwayland/xwm.h b/include/xwayland/xwm.h
index a62366b..364b9de 100644
--- a/include/xwayland/xwm.h
+++ b/include/xwayland/xwm.h
@@ -114,6 +114,8 @@ struct wlr_xwm {
 	struct wlr_xwm_selection dnd_selection;
 
 	struct wlr_xwayland_surface *focus_surface;
+	// win4wine: the window _NET_ACTIVE_WINDOW names
+	xcb_window_t net_active_window;
 
 	// Surfaces in creation order
 	struct wl_list surfaces; // wlr_xwayland_surface.link
diff --git a/xwayland/xwm.c b/xwayland/xwm.c
index 27e9432..0876dcd 100644
--- a/xwayland/xwm.c
+++ b/xwayland/xwm.c
@@ -254,6 +254,7 @@ static struct wlr_xwayland_surface *xwayland_surface_create(
 
 static void xwm_set_net_active_window(struct wlr_xwm *xwm,
 		xcb_window_t window) {
+	xwm->net_active_window = window;
 	xcb_change_property(xwm->xcb_conn, XCB_PROP_MODE_REPLACE,
 			xwm->screen->root, xwm->atoms[NET_ACTIVE_WINDOW],
 			xwm->atoms[WINDOW], 32, 1, &window);
@@ -399,8 +400,20 @@ static void xwm_set_focus_window(struct wlr_xwm *xwm,
 
 static void xwm_surface_activate(struct wlr_xwm *xwm,
 		struct wlr_xwayland_surface *xsurface) {
-	if (xwm->focus_surface == xsurface ||
-			(xsurface && xsurface->override_redirect)) {
+	if (xsurface && xsurface->override_redirect) {
+		return;
+	}
+	if (xwm->focus_surface == xsurface) {
+		/*
+		 * win4wine: the client may have moved X's focus there itself
+		 * (xwm_handle_focus_in), which left _NET_ACTIVE_WINDOW naming
+		 * the window before; Wine then activated that one again.
+		 */
+		xcb_window_t window = xsurface ? xsurface->window_id : XCB_WINDOW_NONE;
+		if (xwm->net_active_window != window) {
+			xwm_set_net_active_window(xwm, window);
+			xcb_flush(xwm->xcb_conn);
+		}
 		return;
 	}
 
