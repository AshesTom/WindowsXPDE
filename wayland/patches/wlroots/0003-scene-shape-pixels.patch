From: win4wine
Subject: [PATCH] scene: a surface's shape, and its exact place on an output

Purpose: show an Xwayland window as an X server does: only inside its
bounding shape, and at its exact pixel position on an output of a
fractional scale.
Before: the whole buffer of a shaped X window showed (Xwayland does not
apply the shape), so Wine's window regions (rounded frame corners, the
unused part of Windows 7's Start menu) were black; and a surface shown one
to one (patch 0001) was placed at its layout position times the scale,
rounded, one output pixel off when the X position is not a multiple of
the scale's denominator.
Change: wlr_scene_surface_set_shape() limits drawing, the opaque region
and input to a region in surface coordinates (no direct scan-out then);
wlr_scene_surface_set_output_pixels() gives the surface's top left corner
in an output's pixels, used when it is drawn one to one on that output.
Damage on fractional scales already covers the pixel either way.
Used by: labwc's xwayland-scale.c (win4wine).
---
 include/types/wlr_scene.h     |  3 +++
 include/wlr/types/wlr_scene.h | 20 ++++++++++++++++++++
 types/scene/surface.c         | 38 ++++++++++++++++++++++++++++++++++++++
 types/scene/wlr_scene.c       | 37 +++++++++++++++++++++++++++++++++++++
 4 files changed, 98 insertions(+)

diff --git a/include/types/wlr_scene.h b/include/types/wlr_scene.h
index 80dcfd1..59191ea 100644
--- a/include/types/wlr_scene.h
+++ b/include/types/wlr_scene.h
@@ -7,4 +7,7 @@ struct wlr_scene *scene_node_get_root(struct wlr_scene_node *node);
 
 void scene_surface_set_clip(struct wlr_scene_surface *surface, struct wlr_box *clip);
 
+// win4wine: the node's visibility and damage after its shape changed
+void scene_node_update_whole(struct wlr_scene_node *node);
+
 #endif
diff --git a/include/wlr/types/wlr_scene.h b/include/wlr/types/wlr_scene.h
index 7abf09e..728750b 100644
--- a/include/wlr/types/wlr_scene.h
+++ b/include/wlr/types/wlr_scene.h
@@ -121,6 +121,12 @@ struct wlr_scene_surface {
 	struct wlr_box clip;
 	// win4wine: the surface is shown this many times smaller (1 = as is)
 	float dest_scale;
+	// win4wine: only this part of the surface shows (an X window's shape)
+	bool has_shape;
+	pixman_region32_t shape;
+	// win4wine: its exact place on this output, in the output's pixels
+	struct wlr_output *pixel_output;
+	int pixel_x, pixel_y;
 
 	struct wlr_addon addon;
 
@@ -367,6 +373,20 @@ void wlr_scene_surface_set_dest_scale(struct wlr_scene_surface *scene_surface, f
  */
 void wlr_scene_surface_set_crop(struct wlr_scene_surface *scene_surface,
 	const struct wlr_box *crop);
+/**
+ * win4wine: show and take input only in SHAPE (surface-local coordinates),
+ * as an X server does for a window's bounding shape; NULL shows all of it.
+ */
+void wlr_scene_surface_set_shape(struct wlr_scene_surface *scene_surface,
+	const pixman_region32_t *shape);
+/**
+ * win4wine: on OUTPUT, when shown one to one (wlr_scene_surface_set_dest_scale
+ * with the output's scale), draw the surface with its top left corner at X, Y
+ * in the output's pixels rather than at its rounded place in layout
+ * coordinates (one pixel off on a fractional scale). NULL: none.
+ */
+void wlr_scene_surface_set_output_pixels(struct wlr_scene_surface *scene_surface,
+	struct wlr_output *output, int x, int y);
 
 /**
  * If this buffer is backed by a surface, then the struct wlr_scene_surface is
diff --git a/types/scene/surface.c b/types/scene/surface.c
index 4d83689..d9a7ed7 100644
--- a/types/scene/surface.c
+++ b/types/scene/surface.c
@@ -114,6 +114,9 @@ static void surface_reconfigure(struct wlr_scene_surface *scene_surface) {
 	pixman_region32_t opaque;
 	pixman_region32_init(&opaque);
 	pixman_region32_copy(&opaque, &surface->opaque_region);
+	if (scene_surface->has_shape) {
+		pixman_region32_intersect(&opaque, &opaque, &scene_surface->shape);
+	}
 
 	int width = state->width;
 	int height = state->height;
@@ -221,6 +224,11 @@ static bool scene_buffer_point_accepts_input(struct wlr_scene_buffer *scene_buff
 	*sx += scene_surface->clip.x;
 	*sy += scene_surface->clip.y;
 
+	if (scene_surface->has_shape && !pixman_region32_contains_point(
+			&scene_surface->shape, floor(*sx), floor(*sy), NULL)) {
+		return false;
+	}
+
 	return wlr_surface_point_accepts_input(scene_surface->surface, *sx, *sy);
 }
 
@@ -239,6 +247,7 @@ static void surface_addon_destroy(struct wlr_addon *addon) {
 	wl_list_remove(&surface->surface_destroy.link);
 	wl_list_remove(&surface->surface_commit.link);
 
+	pixman_region32_fini(&surface->shape);
 	free(surface);
 }
 
@@ -253,6 +262,34 @@ void wlr_scene_surface_set_crop(struct wlr_scene_surface *scene_surface,
 	scene_surface_set_clip(scene_surface, wlr_box_empty(&clip) ? NULL : &clip);
 }
 
+void wlr_scene_surface_set_shape(struct wlr_scene_surface *scene_surface,
+		const pixman_region32_t *shape) {
+	if (!shape ? !scene_surface->has_shape : scene_surface->has_shape &&
+			pixman_region32_equal(&scene_surface->shape, shape)) {
+		return;
+	}
+	scene_surface->has_shape = shape != NULL;
+	if (shape) {
+		pixman_region32_copy(&scene_surface->shape, shape);
+	} else {
+		pixman_region32_clear(&scene_surface->shape);
+	}
+	surface_reconfigure(scene_surface);
+	scene_node_update_whole(&scene_surface->buffer->node);
+}
+
+void wlr_scene_surface_set_output_pixels(struct wlr_scene_surface *scene_surface,
+		struct wlr_output *output, int x, int y) {
+	if (scene_surface->pixel_output == output && (!output ||
+			(scene_surface->pixel_x == x && scene_surface->pixel_y == y))) {
+		return;
+	}
+	scene_surface->pixel_output = output;
+	scene_surface->pixel_x = x;
+	scene_surface->pixel_y = y;
+	scene_node_update_whole(&scene_surface->buffer->node);
+}
+
 void wlr_scene_surface_set_dest_scale(struct wlr_scene_surface *scene_surface, float scale) {
 	if (scene_surface->dest_scale == scale) {
 		return;
@@ -288,6 +325,7 @@ struct wlr_scene_surface *wlr_scene_surface_create(struct wlr_scene_tree *parent
 
 	surface->buffer = scene_buffer;
 	surface->surface = wlr_surface;
+	pixman_region32_init(&surface->shape);
 	scene_buffer->point_accepts_input = scene_buffer_point_accepts_input;
 
 	surface->outputs_update.notify = handle_scene_buffer_outputs_update;
diff --git a/types/scene/wlr_scene.c b/types/scene/wlr_scene.c
index 742fc61..9e3a67a 100644
--- a/types/scene/wlr_scene.c
+++ b/types/scene/wlr_scene.c
@@ -849,6 +849,10 @@ void wlr_scene_buffer_set_buffer(struct wlr_scene_buffer *scene_buffer,
 	wlr_scene_buffer_set_buffer_with_damage(scene_buffer, buffer, NULL);
 }
 
+void scene_node_update_whole(struct wlr_scene_node *node) {
+	scene_node_update(node, NULL);
+}
+
 void wlr_scene_buffer_set_opaque_region(struct wlr_scene_buffer *scene_buffer,
 		const pixman_region32_t *region) {
 	if (pixman_region32_equal(&scene_buffer->opaque_region, region)) {
@@ -1248,6 +1252,34 @@ static void scene_entry_render(struct render_list_entry *entry, const struct ren
 				dst_box.width = width;
 				dst_box.height = height;
 			}
+			if (scene_surface->pixel_output == data->output->output) {
+				dst_box.x = scene_surface->pixel_x;
+				dst_box.y = scene_surface->pixel_y;
+			}
+		}
+	}
+
+	/* win4wine: a shaped surface (an X window's shape) draws only inside it */
+	if (node->type == WLR_SCENE_NODE_BUFFER) {
+		struct wlr_scene_surface *scene_surface =
+			wlr_scene_surface_try_from_buffer(wlr_scene_buffer_from_node(node));
+		if (scene_surface && scene_surface->has_shape) {
+			float dest_scale = scene_surface->dest_scale > 0 ? scene_surface->dest_scale : 1;
+			float factor = fabsf(dest_scale - data->scale) < 0.001f ? 1 : data->scale / dest_scale;
+			pixman_region32_t shape;
+			pixman_region32_init(&shape);
+			pixman_region32_copy(&shape, &scene_surface->shape);
+			pixman_region32_translate(&shape, -scene_surface->clip.x, -scene_surface->clip.y);
+			if (factor != 1) {
+				wlr_region_scale(&shape, &shape, factor);
+			}
+			pixman_region32_translate(&shape, dst_box.x, dst_box.y);
+			pixman_region32_intersect(&render_region, &render_region, &shape);
+			pixman_region32_fini(&shape);
+			if (!pixman_region32_not_empty(&render_region)) {
+				pixman_region32_fini(&render_region);
+				return;
+			}
 		}
 	}
 
@@ -1663,6 +1695,11 @@ static bool scene_entry_try_direct_scanout(struct render_list_entry *entry,
 	}
 
 	struct wlr_scene_buffer *buffer = wlr_scene_buffer_from_node(node);
+	/* win4wine: a shaped surface needs its clip (scene_entry_render) */
+	struct wlr_scene_surface *shaped = wlr_scene_surface_try_from_buffer(buffer);
+	if (shaped && shaped->has_shape) {
+		return false;
+	}
 	if (buffer->buffer == NULL) {
 		return false;
 	}
