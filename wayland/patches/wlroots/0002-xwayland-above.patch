From: win4wine
Subject: [PATCH] xwayland: keep _NET_WM_STATE_ABOVE

Purpose: Win32 topmost windows (Wine sets _NET_WM_STATE_ABOVE) stay above
the others, as XP's dimmed log-off screen above the taskbar.
Before: the XWM rewrote _NET_WM_STATE with the states it knows and dropped
ABOVE; the compositor could not know about it.
Change: track "above" like the other states (initial property and client
messages), keep it in the property, list it in _NET_SUPPORTED and emit
request_above when it changes.
---
 include/wlr/xwayland/xwayland.h |  4 ++++
 include/xwayland/xwm.h          |  1 +
 xwayland/xwm.c                  | 17 ++++++++++++++++-
 3 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/include/wlr/xwayland/xwayland.h b/include/wlr/xwayland/xwayland.h
index 4b476a0..96025da 100644
--- a/include/wlr/xwayland/xwayland.h
+++ b/include/wlr/xwayland/xwayland.h
@@ -159,6 +159,8 @@ struct wlr_xwayland_surface {
 	bool maximized_vert, maximized_horz;
 	bool minimized;
 	bool withdrawn;
+	// win4wine: _NET_WM_STATE_ABOVE (a Win32 topmost window)
+	bool above;
 
 	bool has_alpha;
 
@@ -171,6 +173,8 @@ struct wlr_xwayland_surface {
 		struct wl_signal request_maximize;
 		struct wl_signal request_fullscreen;
 		struct wl_signal request_activate;
+		// win4wine: _NET_WM_STATE_ABOVE changed (see above)
+		struct wl_signal request_above;
 
 		struct wl_signal associate;
 		struct wl_signal dissociate;
diff --git a/include/xwayland/xwm.h b/include/xwayland/xwm.h
index 4386446..a62366b 100644
--- a/include/xwayland/xwm.h
+++ b/include/xwayland/xwm.h
@@ -47,6 +47,7 @@ enum atom_name {
 	NET_WM_STATE_MAXIMIZED_VERT,
 	NET_WM_STATE_MAXIMIZED_HORZ,
 	NET_WM_STATE_HIDDEN,
+	NET_WM_STATE_ABOVE,
 	NET_WM_PING,
 	WM_CHANGE_STATE,
 	WM_STATE,
diff --git a/xwayland/xwm.c b/xwayland/xwm.c
index b315fa0..27e9432 100644
--- a/xwayland/xwm.c
+++ b/xwayland/xwm.c
@@ -46,6 +46,7 @@ static const char *const atom_map[ATOM_LAST] = {
 	[NET_WM_STATE_MAXIMIZED_VERT] = "_NET_WM_STATE_MAXIMIZED_VERT",
 	[NET_WM_STATE_MAXIMIZED_HORZ] = "_NET_WM_STATE_MAXIMIZED_HORZ",
 	[NET_WM_STATE_HIDDEN] = "_NET_WM_STATE_HIDDEN",
+	[NET_WM_STATE_ABOVE] = "_NET_WM_STATE_ABOVE",
 	[NET_WM_PING] = "_NET_WM_PING",
 	[WM_CHANGE_STATE] = "WM_CHANGE_STATE",
 	[WM_STATE] = "WM_STATE",
@@ -206,6 +207,7 @@ static struct wlr_xwayland_surface *xwayland_surface_create(
 	wl_signal_init(&surface->events.request_maximize);
 	wl_signal_init(&surface->events.request_fullscreen);
 	wl_signal_init(&surface->events.request_activate);
+	wl_signal_init(&surface->events.request_above);
 	wl_signal_init(&surface->events.associate);
 	wl_signal_init(&surface->events.dissociate);
 	wl_signal_init(&surface->events.set_class);
@@ -424,7 +426,7 @@ static void xsurface_set_net_wm_state(struct wlr_xwayland_surface *xsurface) {
 		return;
 	}
 
-	uint32_t property[6];
+	uint32_t property[7];
 	size_t i = 0;
 	if (xsurface->modal) {
 		property[i++] = xwm->atoms[NET_WM_STATE_MODAL];
@@ -441,6 +443,9 @@ static void xsurface_set_net_wm_state(struct wlr_xwayland_surface *xsurface) {
 	if (xsurface->minimized) {
 		property[i++] = xwm->atoms[NET_WM_STATE_HIDDEN];
 	}
+	if (xsurface->above) {
+		property[i++] = xwm->atoms[NET_WM_STATE_ABOVE];
+	}
 	if (xsurface == xwm->focus_surface) {
 		property[i++] = xwm->atoms[NET_WM_STATE_FOCUSED];
 	}
@@ -833,6 +838,8 @@ static void read_surface_net_wm_state(struct wlr_xwm *xwm,
 			xsurface->maximized_horz = true;
 		} else if (atom[i] == xwm->atoms[NET_WM_STATE_HIDDEN]) {
 			xsurface->minimized = true;
+		} else if (atom[i] == xwm->atoms[NET_WM_STATE_ABOVE]) {
+			xsurface->above = true;
 		}
 	}
 }
@@ -1363,6 +1370,7 @@ static void xwm_handle_net_wm_state_message(struct wlr_xwm *xwm,
 	bool fullscreen = xsurface->fullscreen;
 	bool maximized = xsurface_is_maximized(xsurface);
 	bool minimized = xsurface->minimized;
+	bool above = xsurface->above;
 
 	uint32_t action = client_message->data.data32[0];
 	for (size_t i = 0; i < 2; ++i) {
@@ -1379,6 +1387,8 @@ static void xwm_handle_net_wm_state_message(struct wlr_xwm *xwm,
 			changed = update_state(action, &xsurface->maximized_horz);
 		} else if (property == xwm->atoms[NET_WM_STATE_HIDDEN]) {
 			changed = update_state(action, &xsurface->minimized);
+		} else if (property == xwm->atoms[NET_WM_STATE_ABOVE]) {
+			changed = update_state(action, &xsurface->above);
 		} else if (property != XCB_ATOM_NONE && wlr_log_get_verbosity() >= WLR_DEBUG) {
 			char *prop_name = xwm_get_atom_name(xwm, property);
 			wlr_log(WLR_DEBUG, "Unhandled NET_WM_STATE property change "
@@ -1401,6 +1411,10 @@ static void xwm_handle_net_wm_state_message(struct wlr_xwm *xwm,
 		wl_signal_emit_mutable(&xsurface->events.request_maximize, NULL);
 	}
 
+	if (above != xsurface->above) {
+		wl_signal_emit_mutable(&xsurface->events.request_above, NULL);
+	}
+
 	if (minimized != xsurface->minimized) {
 		struct wlr_xwayland_minimize_event minimize_event = {
 			.surface = xsurface,
@@ -2236,6 +2250,7 @@ struct wlr_xwm *xwm_create(struct wlr_xwayland *xwayland, int wm_fd) {
 		xwm->atoms[NET_WM_STATE_MAXIMIZED_VERT],
 		xwm->atoms[NET_WM_STATE_MAXIMIZED_HORZ],
 		xwm->atoms[NET_WM_STATE_HIDDEN],
+		xwm->atoms[NET_WM_STATE_ABOVE],
 		xwm->atoms[NET_CLIENT_LIST],
 		xwm->atoms[NET_CLIENT_LIST_STACKING],
 	};
