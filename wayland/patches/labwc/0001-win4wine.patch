diff --git a/include/win4wine.h b/include/win4wine.h
new file mode 100644
index 0000000..bb1f8a3
--- /dev/null
+++ b/include/win4wine.h
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * win4wine: the Windows XP shell on Wine (Xwayland) as the desktop.
+ *
+ * With WIN4WINE_IPC set to the session's IPC directory, labwc speaks the
+ * protocol of win4wine's X11 window manager (bridge-wm) with the session's
+ * proxy.exe: native windows (Wayland, and X11 ones that are not Wine's) get
+ * genuine XP frames drawn by Wine, appear on the XP taskbar and in XP's
+ * Alt+Tab window, and XP's desktop and taskbar keep their places.
+ */
+#ifndef LABWC_WIN4WINE_H
+#define LABWC_WIN4WINE_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <xkbcommon/xkbcommon.h>
+#include "config.h"
+
+struct border;
+struct output;
+struct server;
+struct view;
+struct wlr_box;
+struct wlr_xwayland_surface;
+struct wlr_surface;
+
+enum win4wine_kind {
+	WIN4WINE_UNKNOWN = 0,
+	WIN4WINE_NATIVE,  /* a Linux application's window */
+	WIN4WINE_WINE,    /* a Win32 window (other than the ones below) */
+	WIN4WINE_FRAME,   /* proxy.exe's XP frame for a native window */
+	WIN4WINE_DESKTOP, /* XP's desktop (Progman) */
+	WIN4WINE_DOCK,    /* XP's taskbar */
+	WIN4WINE_POPUP,   /* XP's Start menu */
+};
+
+#if HAVE_XWAYLAND
+void win4wine_init(struct server *server);
+void win4wine_finish(struct server *server);
+/* Whether labwc runs as win4wine's session compositor (WIN4WINE_IPC) */
+bool win4wine_enabled(void);
+/* Xwayland is ready for an X connection of our own */
+void win4wine_xwayland_ready(struct server *server);
+
+/* Something the bridge reports changed; sync on the next idle */
+void win4wine_changed(void);
+/* The keyboard goes to SURFACE (seat_focus) */
+void win4wine_focus_changed(struct wlr_surface *surface);
+void win4wine_view_map(struct view *view);
+void win4wine_view_unmap(struct view *view);
+void win4wine_view_destroy(struct view *view);
+/* A Wayland view's app_id changed: its icon on XP's taskbar follows */
+void win4wine_view_app_id(struct view *view);
+/* A view moved or changed size: its frame follows at once */
+void win4wine_view_moved(struct view *view);
+/* The native window of a frame view, or NULL */
+struct view *win4wine_frame_owner(struct view *view);
+/* A view was raised: keep frames below their windows, the desktop at the bottom */
+void win4wine_view_raised(struct view *view);
+
+enum win4wine_kind win4wine_kind(struct view *view);
+/* The view that takes the keyboard instead of VIEW (a frame's window), or NULL */
+struct view *win4wine_focus_target(struct view *view);
+/* Whether Wine, not labwc, chooses the window to activate after VIEW unmaps */
+bool win4wine_activates_next(struct view *view);
+/* Whether map should focus the view (not frames, the desktop or the taskbar) */
+bool win4wine_focus_on_map(struct view *view);
+/* Whether a Wine window keeps the keyboard when Wine maps an unmanaged window */
+bool win4wine_unmanaged_keeps_keyboard(struct wlr_xwayland_surface *xsurface);
+/*
+ * Show NODE (disabled) once SURFACE commits again after the commit that
+ * mapped it, or after a short while: an X window's first buffer is its blank
+ * (black) background, drawn before the client draws. VIEW, if given, is
+ * not shown if it unmapped or was minimized meanwhile.
+ */
+struct wlr_scene_node;
+void win4wine_show_when_drawn(struct server *server, struct wlr_scene_node *node,
+	struct wlr_surface *surface, struct view *view);
+/* Follow a mapped X window's bounding shape (xwayland_shape_set) */
+void win4wine_watch_shape(uint32_t window);
+/* The XP frame around a native view, in layout coordinates */
+bool win4wine_margin(struct view *view, struct border *margin);
+/* Whether labwc leaves a maximize request to the client (Wine sizes its own) */
+bool win4wine_client_maximizes(struct view *view);
+/* Each output's usable area in X space, for Wine (_GTK_WORKAREAS_D0) */
+void win4wine_set_workareas(const struct wlr_box *areas, size_t count);
+/* XP's taskbar takes its edge of the output's usable area */
+void win4wine_adjust_usable_area(struct output *output, struct wlr_box *usable);
+/* The edges the taskbar sets, exactly in X space (XOB: the output's X box) */
+void win4wine_adjust_x_area(struct output *output, const struct wlr_box *xob, struct wlr_box *xarea);
+/* Where a dragged window would snap (NULL: nowhere), for the proxy to show. True if it does. */
+bool win4wine_snap_preview(const struct wlr_box *box);
+/* Keys for XP: Alt+Tab, the Windows key and Ctrl+Esc. True if consumed. */
+bool win4wine_key(struct server *server, uint32_t keycode, const xkb_keysym_t *syms,
+	int nr_syms, uint32_t modifiers, bool pressed);
+#else
+static inline void win4wine_init(struct server *server) {}
+static inline void win4wine_finish(struct server *server) {}
+static inline bool win4wine_enabled(void) { return false; }
+static inline void win4wine_changed(void) {}
+static inline void win4wine_focus_changed(struct wlr_surface *surface) {}
+static inline void win4wine_xwayland_ready(struct server *server) {}
+static inline void win4wine_view_map(struct view *view) {}
+static inline void win4wine_view_unmap(struct view *view) {}
+static inline void win4wine_view_destroy(struct view *view) {}
+static inline void win4wine_view_raised(struct view *view) {}
+static inline void win4wine_view_moved(struct view *view) {}
+static inline void win4wine_view_app_id(struct view *view) {}
+static inline void win4wine_watch_shape(uint32_t window) {}
+static inline void win4wine_adjust_x_area(struct output *output, const struct wlr_box *xob, struct wlr_box *xarea) {}
+static inline struct view *win4wine_frame_owner(struct view *view) { return NULL; }
+static inline enum win4wine_kind win4wine_kind(struct view *view) { return WIN4WINE_UNKNOWN; }
+static inline struct view *win4wine_focus_target(struct view *view) { return view; }
+static inline bool win4wine_focus_on_map(struct view *view) { return true; }
+static inline bool win4wine_unmanaged_keeps_keyboard(struct wlr_xwayland_surface *xsurface) { return false; }
+static inline bool win4wine_activates_next(struct view *view) { return false; }
+static inline bool win4wine_margin(struct view *view, struct border *margin) { return false; }
+static inline bool win4wine_client_maximizes(struct view *view) { return false; }
+static inline void win4wine_set_workareas(const struct wlr_box *areas, size_t count) {}
+static inline void win4wine_adjust_usable_area(struct output *output, struct wlr_box *usable) {}
+static inline bool win4wine_snap_preview(const struct wlr_box *box) { return false; }
+static inline bool win4wine_key(struct server *server, uint32_t keycode,
+	const xkb_keysym_t *syms, int nr_syms, uint32_t modifiers, bool pressed) { return false; }
+#endif
+#endif /* LABWC_WIN4WINE_H */
diff --git a/include/xwayland-scale.h b/include/xwayland-scale.h
new file mode 100644
index 0000000..ba09727
--- /dev/null
