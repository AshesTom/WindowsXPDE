@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * win4wine: Xwayland clients at the outputs' own resolution.
+ *
+ * Xwayland sees each output at its size in pixels, the outputs side by side
+ * from left to right in that pixel space ("X space"). Labwc keeps its views in
+ * layout coordinates; an Xwayland window on an output of scale S is shown S
+ * times smaller, so that each of its pixels takes one output pixel and it is
+ * not stretched (or blurred). The X client draws larger itself (Wine at the
+ * DPI it is given).
+ */
+#ifndef LABWC_XWAYLAND_SCALE_H
+#define LABWC_XWAYLAND_SCALE_H
+#include <pixman.h>
+#include <stdbool.h>
+#include <wayland-server-core.h>
+#include <wlr/util/box.h>
+
+struct server;
+struct wl_global;
+struct wlr_scene_surface;
+struct wlr_scene_tree;
+struct wlr_surface;
+
+#define XWAYLAND_MAX_SLICES 8
+
+/*
+ * An X window on outputs of different scales is shown as one cropped scene
+ * surface per output, each at that output's scale: every part keeps one
+ * output pixel per X pixel.
+ */
+struct xwayland_slice {
+	struct wlr_scene_surface *scene_surface;
+	struct wl_listener destroy;
+};
+
+struct xwayland_slices {
+	struct wlr_surface *surface;
+	struct xwayland_slice slice[XWAYLAND_MAX_SLICES];
+	int count;
+};
+
+void xwayland_scale_init(struct server *server);
+/* Whether GLOBAL is the xdg-output manager shown to Xwayland only */
+bool xwayland_scale_is_global(struct wl_global *global);
+/* Send the outputs' X space again after a layout change */
+void xwayland_scale_update(struct server *server);
+/*
+ * Win32's primary monitor: the output NAME (or, without one, the
+ * leftmost) comes first in X space, at X 0,0.
+ */
+void xwayland_scale_set_primary(struct server *server, const char *name);
+/* The primary output's box in X space and its name */
+bool xwayland_scale_primary(struct server *server, struct wlr_box *xbox, const char **name);
+
+/* Scale of the output under a box in X space, or in layout coordinates */
+float xwayland_scale_for_xbox(struct server *server, const struct wlr_box *xbox);
+float xwayland_scale_for_box(struct server *server, const struct wlr_box *box);
+void xwayland_scale_to_x(struct server *server, const struct wlr_box *box, struct wlr_box *xbox);
+/* The layout box of an X window: the bounding box of its parts on the outputs */
+void xwayland_scale_from_x(struct server *server, const struct wlr_box *xbox, struct wlr_box *box);
+/* A point in layout coordinates in X space (the output under it, or the nearest) */
+void xwayland_scale_point_to_x(struct server *server, double lx, double ly, double *x, double *y);
+
+/*
+ * Show SURFACE, an X window at XBOX, in TREE whose origin is at ORIGIN_X,
+ * ORIGIN_Y in layout coordinates.
+ */
+void xwayland_slices_show(struct server *server, struct xwayland_slices *slices,
+	struct wlr_scene_tree *tree, struct wlr_surface *surface, const struct wlr_box *xbox,
+	int origin_x, int origin_y);
+void xwayland_slices_clear(struct xwayland_slices *slices);
+/*
+ * An X window's bounding shape (X's SHAPE extension), in window coordinates:
+ * Xwayland shows the whole window, the slices only this part. NULL: none.
+ */
+void xwayland_shape_set(uint32_t window, const pixman_region32_t *shape);
+void xwayland_shape_forget(uint32_t window);
+#endif
