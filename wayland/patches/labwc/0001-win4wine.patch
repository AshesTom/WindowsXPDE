+// SPDX-License-Identifier: GPL-2.0-only
+#define _POSIX_C_SOURCE 200809L
+/*
+ * win4wine: bridge-wm's protocol with the session's proxy.exe (see
+ * include/win4wine.h and win4wine's bridge-wm/wm.py, which does the same
+ * on X11).
+ *
+ * Files in the IPC directory (WIN4WINE_IPC):
+ *  - windows.tsv (written here): native top-level windows, "id hidden active title"
+ *  - geometry.tsv (here): their geometry and the work area, in Win32 screen
+ *    coordinates (X space less the primary output's origin, xwayland-scale.h)
+ *  - frames.tsv (proxy): each XP frame's HWND, its window's id and borders
+ *  - *.cmd (proxy): activate, minimize, maximize, restore, close, geometry, switch;
+ *    snap and unsnap (window_snap: Win+arrows) name a Wine window or a frame by its HWND
+ *    ("snap HWND SIDE [X Y WIDTH HEIGHT]": SIDE 0 left, 1 right, and the window's
+ *    or frame's rectangle to restore it to later, in Win32 coordinates)
+ *  - tiled.tsv (here): "HWND EDGE" for each window snapped to the left or right
+ *    half of its output (EDGE 0 left, 1 right), Wine's by their HWND, native ones
+ *    by their frame's
+ *  - snapping.tsv (here): "SEQUENCE X Y WIDTH HEIGHT", where a window being dragged
+ *    would snap (all 0 for none); the proxy draws XP's outline there
+ *  - switch.tsv (here): XP's Alt+Tab window, "session steps state"
+ *  - shellkeys.tsv (here): the Windows key and Ctrl+Esc under a native window
+ *  - icon-ID.argb (here): a native window's icon ("W4I1", width, height, ARGB)
+ *  - primary (supervisor): the name of the output that is Win32's primary monitor
+ *
+ * Native windows are xdg-shell toplevels (ids from 0x7f000000, which X never
+ * gives) and X11 windows that are not Wine's (their X window id). Wine's
+ * windows carry _WIN4WINE_CLASS and _WIN4WINE_HWND (Wine patch 0022); this
+ * reads them over an X connection of its own, without blocking on replies.
+ */
+#include <assert.h>
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/inotify.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/util/log.h>
+#include <wlr/xwayland.h>
+#include <xcb/randr.h>
