+
+/* win4wine: the deferred frame is due (the output is ready: its frame came) */
+static int
+handle_frame_timer(void *data)
+{
+	struct output *output = data;
+	if (output->frame_deferred) {
+		output->frame_deferred = false;
+		if (output_is_usable(output) && output->scene_output
+				&& (!output->server->session || output->server->session->active)) {
+			output_frame_draw(output);
+		}
+	}
+	return 0;
+}
+
+/*
+ * win4wine: whether a frame now would come sooner than the output's refresh
+ * allows; if so, it is drawn when it does. A display that ends page flips at
+ * once (no vertical blank, as a virtual machine's VGA) otherwise draws a
+ * frame for each change, more often than it shows them: dragging a window
+ * drew 77 frames a second on a 60 Hz output, and with software rendering
+ * into its framebuffer that kept a CPU busy. Where page flips wait for the
+ * vertical blank, frames are never sooner and nothing changes. Only frames
+ * with something to draw wait (an empty one would be committed and end in
+ * another frame: an endless loop at the refresh rate).
+ */
+static bool
+output_frame_too_soon(struct output *output, const struct timespec *now)
+{
+	int refresh = output->wlr_output->refresh; /* mHz */
+	if (refresh <= 0 || (!output->last_frame.tv_sec && !output->last_frame.tv_nsec)
+			|| output_get_tearing_allowance(output)) {
+		return false;
+	}
+	if (!output->wlr_output->needs_frame && !output->gamma_lut_changed
+			&& !pixman_region32_not_empty(&output->scene_output->pending_commit_damage)) {
+		return false;
+	}
+	int64_t interval = 1000000000000LL / refresh;
+	int64_t elapsed = (now->tv_sec - output->last_frame.tv_sec) * 1000000000LL
+		+ (now->tv_nsec - output->last_frame.tv_nsec);
+	/* a little early is on time: the next vertical blank is the same */
+	int64_t wait = interval - elapsed - 1000000;
+	if (wait <= 0) {
+		return false;
+	}
+	if (!output->frame_timer) {
+		output->frame_timer = wl_event_loop_add_timer(
+			output->server->wl_event_loop, handle_frame_timer, output);
+	}
+	if (!output->frame_timer) {
+		return false;
+	}
+	wl_event_source_timer_update(output->frame_timer, (int)((wait + 999999) / 1000000));
+	output->frame_deferred = true;
+	return true;
+}
+
+static void
+output_frame_draw(struct output *output)
+{
+	struct timespec frame_time = { 0 };
+	clock_gettime(CLOCK_MONOTONIC, &frame_time);
+	if (output->wlr_output->needs_frame || output->gamma_lut_changed
+			|| pixman_region32_not_empty(&output->scene_output->pending_commit_damage)) {
+		output->last_frame = frame_time;
+	}
+
+	if (output->gamma_lut_changed) {
+		/*
+		 * We are not mixing the gamma state with
+		 * other pending output changes to make it
+		 * easier to handle a failed output commit
+		 * due to gamma without impacting other
+		 * unrelated output changes.
+		 */
+		output_apply_gamma(output);
+	} else {
+		struct wlr_scene_output *scene_output = output->scene_output;
+		struct wlr_output_state *pending = &output->pending;
+
+		pending->tearing_page_flip = output_get_tearing_allowance(output);
+
+		lab_wlr_scene_output_commit(scene_output, pending);
+	}
+
+	struct timespec now = { 0 };
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	wlr_scene_output_send_frame_done(output->scene_output, &now);
+}
