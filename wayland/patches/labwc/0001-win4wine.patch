+#include "xwayland-scale.h"
+
+#define NATIVE_ID_BASE 0x7f000000u
+#define ICON_SIZE 32
+
+struct win4wine_view {
+	struct view *view;
+	uint32_t id;                /* on the IPC: X window id or NATIVE_ID_BASE + n */
+	enum win4wine_kind kind;
+	/* Xwayland windows: Wine's identity (0 / "" for X11 natives) */
+	uint32_t hwnd;
+	char wclass[32];
+	unsigned int pending;       /* outstanding property replies */
+	bool no_activation;         /* _NET_WM_USER_TIME 0: Wine shows it without activating it */
+	/* native windows */
+	uint32_t frame_hwnd;        /* their frame's HWND from frames.tsv */
+	struct view *frame;         /* the frame's view, once both are known */
+	int extents[4];             /* frame borders in X pixels: left right top bottom */
+	int clip[2];                /* the frame's hidden border when maximized */
+	bool frame_ready;
+	bool placed;                /* the first position with a frame is done */
+	bool margin_changed;        /* frames.tsv changed its borders */
+	uint32_t last_frame_hwnd;   /* frame_hwnd before frames.tsv was read again */
+	struct wlr_box dock_box;    /* a taskbar's box when the work area was last set */
+	bool icon_dirty;
+	char *icon;                 /* the last icon written, and its size */
+	size_t icon_size;
+};
+
+struct request {
+	struct wl_list link;
+	unsigned int sequence;
+	xcb_window_t window;
+	xcb_atom_t atom;
+};
+
+static struct {
+	struct server *server;
+	char *ipc;
+	struct wl_event_source *idle, *inotify_source, *x_source;
+	int inotify_fd;
+	uint32_t next_native;
+	char *windows_text, *geometry_text, *tiled_text, *classes_text;
+	unsigned int snapping_seq;
+	int cascade_slot;           /* the last default-window slot (cascade) */
+	bool dock_moved;            /* the taskbar changed: the work area follows */
+	struct wlr_box snapping;    /* the box last written to snapping.tsv */
+	/* the X connection */
+	xcb_connection_t *x;
+	xcb_window_t root;
+	xcb_atom_t atom_hwnd, atom_class, atom_net_wm_icon, atom_gtk_workareas,
+		atom_net_active_window, atom_user_time;
+	struct wl_list requests;    /* struct request, in sequence order */
+	int origin_x, origin_y;     /* the primary output in X space: Win32's 0,0 */
+	bool randr;
+	uint8_t randr_event;
+	bool shape;                 /* X's SHAPE extension (shaped Wine windows) */
+	uint8_t shape_event;
+	struct wl_list shape_requests; /* struct shape_request, in sequence order */
+	xcb_randr_output_t randr_primary;
+	struct timespec focus_time; /* when the keyboard last went to another surface */
+	struct view *active_frame;  /* the frame named active for its window */
+	xcb_window_t x_focus;       /* the Wine window given X's focus */
+	struct wlr_surface *focused;
+	struct wlr_box *workareas;  /* _GTK_WORKAREAS_D0, in X space */
+	size_t workarea_count;
+	/* XP's Alt+Tab window (switch.tsv) */
+	bool switching;
+	struct view *switch_view;   /* had the keyboard before */
+	unsigned int switch_session;
+	int switch_steps;
+	uint32_t switch_keys[8];    /* keys pressed while switching (consumed) */
+	/* the Windows key under a native window (shellkeys.tsv) */
+	bool shell_combo;
+	unsigned int shell_seq;
+	int combo_keys[16], combo_count;
+	uint32_t combo_keycodes[16];
+	int combo_keycode_count;
+	uint32_t super_keycode;
+} w;
+
+bool
+win4wine_enabled(void)
+{
+	return w.ipc;
+}
+
+/* How long a new X window may take to draw before it is shown anyway */
+#define DRAW_WAIT_MS 100
+
+struct show_when_drawn {
+	struct wlr_scene_node *node;
+	struct wlr_surface *surface;
+	struct view *view;
+	uint32_t seq;
+	struct wl_listener commit, unmap, surface_destroy, node_destroy;
+	struct wl_event_source *timer;
+};
+
+static void
+show_when_drawn_finish(struct show_when_drawn *s, bool show)
+{
+	if (show && (!s->view || (s->view->mapped && !s->view->minimized))) {
+		wlr_scene_node_set_enabled(s->node, true);
+	}
+	wl_list_remove(&s->commit.link);
+	wl_list_remove(&s->unmap.link);
+	wl_list_remove(&s->surface_destroy.link);
+	wl_list_remove(&s->node_destroy.link);
+	wl_event_source_remove(s->timer);
+	free(s);
+}
+
+/*
+ * A hidden surface gets no frame events from the scene, and Xwayland waits
+ * for one before it commits the client's drawing: let it go on.
+ */
+static void
+show_when_drawn_frame_done(struct show_when_drawn *s)
+{
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	wlr_surface_send_frame_done(s->surface, &now);
+}
+
+static void
+show_when_drawn_commit(struct wl_listener *listener, void *data)
+{
+	struct show_when_drawn *s = wl_container_of(listener, s, commit);
+	/* The commit that mapped the surface comes here too */
+	if (s->surface->current.seq != s->seq) {
+		show_when_drawn_finish(s, true);
+	} else {
+		show_when_drawn_frame_done(s);
+	}
+}
+
+static int
+show_when_drawn_timeout(void *data)
+{
+	show_when_drawn_finish(data, true);
+	return 0;
+}
+
+static void
+show_when_drawn_unmap(struct wl_listener *listener, void *data)
+{
+	struct show_when_drawn *s = wl_container_of(listener, s, unmap);
+	show_when_drawn_finish(s, false);
+}
+
+static void
+show_when_drawn_surface_destroy(struct wl_listener *listener, void *data)
+{
+	struct show_when_drawn *s = wl_container_of(listener, s, surface_destroy);
+	show_when_drawn_finish(s, false);
+}
+
+static void
+show_when_drawn_node_destroy(struct wl_listener *listener, void *data)
+{
+	struct show_when_drawn *s = wl_container_of(listener, s, node_destroy);
+	show_when_drawn_finish(s, false);
+}
+
+void
+win4wine_show_when_drawn(struct server *server, struct wlr_scene_node *node,
+		struct wlr_surface *surface, struct view *view)
+{
+	struct show_when_drawn *s = znew(*s);
+	s->node = node;
+	s->surface = surface;
+	s->view = view;
+	s->seq = surface->current.seq;
+	wlr_scene_node_set_enabled(node, false);
+	s->commit.notify = show_when_drawn_commit;
+	wl_signal_add(&surface->events.commit, &s->commit);
+	s->unmap.notify = show_when_drawn_unmap;
+	wl_signal_add(&surface->events.unmap, &s->unmap);
+	s->surface_destroy.notify = show_when_drawn_surface_destroy;
+	wl_signal_add(&surface->events.destroy, &s->surface_destroy);
+	s->node_destroy.notify = show_when_drawn_node_destroy;
+	wl_signal_add(&node->events.destroy, &s->node_destroy);
+	s->timer = wl_event_loop_add_timer(server->wl_event_loop, show_when_drawn_timeout, s);
+	wl_event_source_timer_update(s->timer, DRAW_WAIT_MS);
+	show_when_drawn_frame_done(s);
+}
+
+static struct win4wine_view *
+data_of(struct view *view)
+{
+	return view ? view->win4wine : NULL;
+}
+
+/* File helpers */
+
+static void
+write_file(const char *name, const char *text, size_t size)
+{
+	char path[4096], tmp[4096];
+	snprintf(path, sizeof(path), "%s/%s", w.ipc, name);
+	snprintf(tmp, sizeof(tmp), "%s/%s.labwc", w.ipc, name);
+	FILE *f = fopen(tmp, "w");
+	if (!f) {
+		return;
+	}
+	bool ok = fwrite(text, 1, size, f) == size;
+	ok = !fclose(f) && ok;
+	if (!ok || rename(tmp, path)) {
+		unlink(tmp);
+	}
+}
+
+/* Write NAME when TEXT differs from *PREVIOUS (which keeps TEXT) */
+static void
+write_if_changed(const char *name, char *text, char **previous)
+{
+	if (*previous && !strcmp(*previous, text)) {
+		free(text);
+		return;
+	}
+	write_file(name, text, strlen(text));
+	free(*previous);
+	*previous = text;
+}
+
+/*
+ * The proxy holds a lock on proxy.lock while it runs (Wine maps it to a
+ * POSIX lock, dropped when the process ends).
+ */
+static bool
+bridge_alive(void)
+{
+	char path[4096];
+	snprintf(path, sizeof(path), "%s/proxy.lock", w.ipc);
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		return false;
+	}
+	struct flock lock = {.l_type = F_WRLCK, .l_whence = SEEK_SET, .l_start = 0, .l_len = 1};
+	bool alive = !fcntl(fd, F_GETLK, &lock) && lock.l_type != F_UNLCK;
+	close(fd);
+	return alive;
+}
+
+/* Views */
+
+enum win4wine_kind
+win4wine_kind(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	return data ? data->kind : WIN4WINE_UNKNOWN;
+}
+
+static bool
+is_native(struct view *view)
+{
+	return win4wine_kind(view) == WIN4WINE_NATIVE;
+}
+
+/* A native window that is no other window's dialog: it gets a frame and a task */
+static bool
+is_native_task(struct view *view)
+{
+	if (!is_native(view)) {
+		return false;
+	}
+	if (view->type == LAB_XWAYLAND_VIEW) {
+		return !xwayland_surface_from_view(view)->parent;
+	}
+	return view_get_root(view) == view;
+}
+
+static enum win4wine_kind
+classify(struct view *view, struct win4wine_view *data)
+{
+	if (view->type != LAB_XWAYLAND_VIEW) {
+		return WIN4WINE_NATIVE;
+	}
+	if (!strcasecmp(data->wclass, "win4wineproxy")) {
+		return WIN4WINE_FRAME;
+	}
+	/*
+	 * A top-level WorkerW is not the desktop: Show Desktop moves the
+	 * desktop's icons into one and raises it over the minimized windows.
+	 */
+	if (!strcasecmp(data->wclass, "progman")
+			|| view_contains_window_type(view, NET_WM_WINDOW_TYPE_DESKTOP)) {
+		return WIN4WINE_DESKTOP;
+	}
+	if (!strcasecmp(data->wclass, "shell_traywnd")
+			|| view_contains_window_type(view, NET_WM_WINDOW_TYPE_DOCK)) {
+		return WIN4WINE_DOCK;
+	}
+	if (!strcasecmp(data->wclass, "dv2controlhost")) {
+		return WIN4WINE_POPUP;
+	}
+	return data->hwnd || data->wclass[0] ? WIN4WINE_WINE : WIN4WINE_NATIVE;
+}
+
+static struct view *
+view_for_id(uint32_t id)
+{
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (data && data->id == id) {
+			return view;
+		}
+	}
+	return NULL;
+}
+
+/* A Wine window, or the native window of a frame, by its HWND */
+static struct view *
+view_for_hwnd(uint32_t hwnd)
+{
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (hwnd && data && ((data->kind == WIN4WINE_WINE && data->hwnd == hwnd)
+				|| (data->kind == WIN4WINE_NATIVE && data->frame_hwnd == hwnd))) {
+			return view;
+		}
+	}
+	return NULL;
+}
+
+static struct view *
+native_of_frame(struct view *frame)
+{
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (data && data->kind == WIN4WINE_NATIVE && data->frame == frame) {
+			return view;
+		}
+	}
+	return NULL;
+}
+
+static struct win4wine_view *
+ensure_data(struct view *view)
+{
+	if (!view->win4wine) {
+		struct win4wine_view *data = znew(*data);
+		data->view = view;
+		data->icon_dirty = true;
+		if (view->type == LAB_XWAYLAND_VIEW) {
+			data->id = xwayland_surface_from_view(view)->window_id;
+		} else {
+			data->id = NATIVE_ID_BASE + w.next_native++;
+		}
+		view->win4wine = data;
+	}
+	return view->win4wine;
+}
+
+/* The X connection: Wine's window identity, icons, the primary output */
+
+static xcb_atom_t
+intern(const char *name)
+{
+	xcb_intern_atom_reply_t *reply = xcb_intern_atom_reply(w.x,
+		xcb_intern_atom(w.x, 0, strlen(name), name), NULL);
+	xcb_atom_t atom = reply ? reply->atom : XCB_ATOM_NONE;
+	free(reply);
+	return atom;
+}
+
+static void
+request_property(xcb_window_t window, xcb_atom_t atom, uint32_t length)
+{
+	if (!w.x || atom == XCB_ATOM_NONE) {
+		return;
+	}
+	struct request *request = znew(*request);
+	request->sequence = xcb_get_property(w.x, 0, window, atom, XCB_ATOM_ANY, 0, length).sequence;
+	request->window = window;
+	request->atom = atom;
+	wl_list_insert(w.requests.prev, &request->link);
+	struct view *view = view_for_id(window);
+	if (view && atom != w.atom_net_wm_icon) {
+		data_of(view)->pending++;
+	}
+}
+
+/*
+ * Shaped windows: Xwayland shows an X window's whole buffer, also outside
+ * its bounding shape (Wine's window regions: the rounded corners of
+ * Windows 7's and XP's frames, the Start menu's unused part). The
+ * compositor reads the shape and shows only that part (xwayland_shape_set).
+ */
+struct shape_request {
+	unsigned int sequence;
+	xcb_window_t window;
+	bool rectangles;            /* xcb_shape_get_rectangles, else query_extents */
+	struct wl_list link;
+};
+
+static void
+request_shape(xcb_window_t window, bool rectangles)
+{
+	struct shape_request *request = znew(*request);
+	request->sequence = rectangles
+		? xcb_shape_get_rectangles(w.x, window, XCB_SHAPE_SK_BOUNDING).sequence
+		: xcb_shape_query_extents(w.x, window).sequence;
+	request->window = window;
+	request->rectangles = rectangles;
+	wl_list_insert(w.shape_requests.prev, &request->link);
+}
+
+/* Follow a mapped X window's shape */
+void
+win4wine_watch_shape(uint32_t window)
+{
+	if (!w.x || !w.shape) {
+		return;
+	}
+	xcb_shape_select_input(w.x, window, 1);
+	request_shape(window, false);
+	xcb_flush(w.x);
+}
+
+static void
+handle_shape_reply(struct shape_request *request, void *reply)
+{
+	if (!request->rectangles) {
+		xcb_shape_query_extents_reply_t *extents = reply;
+		if (extents && extents->bounding_shaped) {
+			request_shape(request->window, true);
+		} else {
+			xwayland_shape_set(request->window, NULL);
+		}
+		return;
+	}
+	xcb_shape_get_rectangles_reply_t *rectangles = reply;
+	if (!rectangles) {
+		xwayland_shape_set(request->window, NULL);
+		return;
+	}
+	xcb_rectangle_t *rect = xcb_shape_get_rectangles_rectangles(rectangles);
+	int count = xcb_shape_get_rectangles_rectangles_length(rectangles);
+	pixman_box32_t *boxes = znew_n(pixman_box32_t, count > 0 ? count : 1);
+	for (int i = 0; i < count; i++) {
+		boxes[i] = (pixman_box32_t){rect[i].x, rect[i].y,
+			rect[i].x + rect[i].width, rect[i].y + rect[i].height};
+	}
+	pixman_region32_t region;
+	pixman_region32_init_rects(&region, boxes, count);
+	xwayland_shape_set(request->window, &region);
+	pixman_region32_fini(&region);
+	free(boxes);
+}
+
+/* Ask for a new Xwayland window's identity and follow its changes */
+static void
+watch_window(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	if (!w.x || view->type != LAB_XWAYLAND_VIEW) {
+		return;
+	}
+	uint32_t mask = XCB_EVENT_MASK_PROPERTY_CHANGE;
+	xcb_change_window_attributes(w.x, data->id, XCB_CW_EVENT_MASK, &mask);
+	request_property(data->id, w.atom_class, 8);
+	request_property(data->id, w.atom_hwnd, 1);
+	request_property(data->id, w.atom_user_time, 1);
+	xcb_flush(w.x);
+}
+
+static void reclassify(struct view *view);
+
+static void
+store_icon(struct win4wine_view *data, const uint32_t *values, uint32_t count)
+{
+	/* _NET_WM_ICON: width, height, pixels, ... The one nearest 32x32. */
+	uint32_t offset = 0, best = 0, best_width = 0, best_height = 0;
+	long best_score = -1;
+	while (count - offset >= 2) {
+		uint32_t width = values[offset], height = values[offset + 1];
+		offset += 2;
+		if (!width || !height || (uint64_t)width * height > count - offset) {
+			break;
+		}
+		if (width <= 256 && height <= 256) {
+			long score = labs((long)(width > height ? width : height) - ICON_SIZE) * 100000L
+				- (long)width * height;
+			if (best_score < 0 || score < best_score) {
+				best_score = score, best = offset, best_width = width, best_height = height;
+			}
+		}
+		offset += width * height;
+	}
+	free(data->icon);
+	data->icon = NULL;
+	data->icon_size = 0;
+	if (best_score >= 0) {
+		data->icon_size = 12 + 4 * (size_t)best_width * best_height;
+		data->icon = xmalloc(data->icon_size);
+		memcpy(data->icon, "W4I1", 4);
+		memcpy(data->icon + 4, &best_width, 4);
+		memcpy(data->icon + 8, &best_height, 4);
+		memcpy(data->icon + 12, values + best, 4 * (size_t)best_width * best_height);
+	}
+	data->icon_dirty = true;
+}
+
+/* A Wayland window's icon: its application's (the desktop entry for its app_id) */
+static void
+load_app_icon(struct win4wine_view *data)
+{
+	free(data->icon);
+	data->icon = NULL;
+	data->icon_size = 0;
+#if HAVE_LIBSFDO
+	const char *app_id = view_get_string_prop(data->view, "app_id");
+	struct lab_img *img = app_id && *app_id
+		? desktop_entry_load_icon_from_app_id(w.server, app_id, ICON_SIZE, 1) : NULL;
+	struct lab_data_buffer *buffer = img ? lab_img_render(img, ICON_SIZE, ICON_SIZE, 1) : NULL;
+	if (buffer && buffer->base.width == ICON_SIZE && buffer->base.height == ICON_SIZE) {
+		uint32_t size = ICON_SIZE;
+		data->icon_size = 12 + 4 * ICON_SIZE * ICON_SIZE;
+		data->icon = xmalloc(data->icon_size);
+		memcpy(data->icon, "W4I1", 4);
+		memcpy(data->icon + 4, &size, 4);
+		memcpy(data->icon + 8, &size, 4);
+		uint32_t *out = (uint32_t *)(data->icon + 12);
+		for (int y = 0; y < ICON_SIZE; y++) {
+			const uint32_t *row = (const uint32_t *)((const char *)buffer->data + y * buffer->stride);
+			for (int x = 0; x < ICON_SIZE; x++) {
+				/* cairo's premultiplied ARGB to _NET_WM_ICON's straight ARGB */
+				uint32_t p = row[x], a = p >> 24;
+				uint32_t r = a ? ((p >> 16) & 0xff) * 255 / a : 0;
+				uint32_t g = a ? ((p >> 8) & 0xff) * 255 / a : 0;
+				uint32_t b = a ? (p & 0xff) * 255 / a : 0;
+				out[y * ICON_SIZE + x] = a << 24 | r << 16 | g << 8 | b;
+			}
+		}
+	}
+	if (buffer) {
+		wlr_buffer_drop(&buffer->base);
+	}
+	if (img) {
+		lab_img_destroy(img);
+	}
+#endif
+	data->icon_dirty = true;
+}
+
+void
+win4wine_view_app_id(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	if (w.ipc && data && data->kind == WIN4WINE_NATIVE && view->type != LAB_XWAYLAND_VIEW) {
+		load_app_icon(data);
+		win4wine_changed();
+	}
+}
+
+static void
+handle_reply(struct request *request, xcb_get_property_reply_t *reply)
+{
+	struct view *view = view_for_id(request->window);
+	struct win4wine_view *data = data_of(view);
+	if (!data) {
+		return;
+	}
+	if (request->atom != w.atom_net_wm_icon && data->pending) {
+		data->pending--;
+	}
+	int length = reply ? xcb_get_property_value_length(reply) : 0;
+	void *value = reply ? xcb_get_property_value(reply) : NULL;
+	if (request->atom == w.atom_class) {
+		int n = length < (int)sizeof(data->wclass) - 1 ? length : (int)sizeof(data->wclass) - 1;
+		memcpy(data->wclass, value, n);
+		data->wclass[n] = '\0';
+	} else if (request->atom == w.atom_hwnd) {
+		data->hwnd = length >= 4 ? *(uint32_t *)value : 0;
+	} else if (request->atom == w.atom_user_time) {
+		data->no_activation = length >= 4 && !*(uint32_t *)value;
+	} else if (request->atom == w.atom_net_wm_icon) {
+		if (reply && reply->format == 32 && !reply->bytes_after) {
+			store_icon(data, value, length / 4);
+		} else {
+			store_icon(data, NULL, 0);
+		}
+	}
+	if (!data->pending) {
+		reclassify(view);
+	}
+	win4wine_changed();
+}
+
+/* Make Xwayland's RandR primary the output that comes first in X space */
+static void
+set_randr_primary(void)
+{
+	const char *name = NULL;
+	struct wlr_box xbox;
+	if (!w.x || !w.randr || !xwayland_scale_primary(w.server, &xbox, &name) || !name) {
+		return;
+	}
+	xcb_randr_get_screen_resources_current_reply_t *resources =
+		xcb_randr_get_screen_resources_current_reply(w.x,
+			xcb_randr_get_screen_resources_current(w.x, w.root), NULL);
+	if (!resources) {
+		return;
+	}
+	xcb_randr_output_t *outputs = xcb_randr_get_screen_resources_current_outputs(resources);
+	int count = xcb_randr_get_screen_resources_current_outputs_length(resources);
+	for (int i = 0; i < count; i++) {
+		xcb_randr_get_output_info_reply_t *info = xcb_randr_get_output_info_reply(w.x,
+			xcb_randr_get_output_info(w.x, outputs[i], resources->config_timestamp), NULL);
+		if (info && xcb_randr_get_output_info_name_length(info) == (int)strlen(name)
+				&& !memcmp(xcb_randr_get_output_info_name(info), name, strlen(name))
+				&& outputs[i] != w.randr_primary) {
+			/* Setting it notifies RandR's clients, this one too: only once */
+			xcb_randr_set_output_primary(w.x, w.root, outputs[i]);
+			w.randr_primary = outputs[i];
+		}
+		free(info);
+	}
+	free(resources);
+	xcb_flush(w.x);
+}
+
+static void
+update_origin(void)
+{
+	if (!w.x || !w.randr) {
+		return;
+	}
+	/* Win32's 0,0 is the top-left of the X server's primary output */
+	xcb_randr_get_output_primary_reply_t *primary = xcb_randr_get_output_primary_reply(w.x,
+		xcb_randr_get_output_primary(w.x, w.root), NULL);
+	int x = 0, y = 0;
+	if (primary && primary->output) {
+		xcb_randr_get_output_info_reply_t *info = xcb_randr_get_output_info_reply(w.x,
+			xcb_randr_get_output_info(w.x, primary->output, XCB_CURRENT_TIME), NULL);
+		if (info && info->crtc) {
+			xcb_randr_get_crtc_info_reply_t *crtc = xcb_randr_get_crtc_info_reply(w.x,
+				xcb_randr_get_crtc_info(w.x, info->crtc, XCB_CURRENT_TIME), NULL);
+			if (crtc) {
+				x = crtc->x, y = crtc->y;
+			}
+			free(crtc);
+		}
+		free(info);
+	}
+	free(primary);
+	if (x != w.origin_x || y != w.origin_y) {
+		w.origin_x = x, w.origin_y = y;
+		win4wine_changed();
+	}
+}
+
+static void focus_wine_window(struct wlr_surface *focused);
+
+static int
+handle_x_events(int fd, uint32_t mask, void *unused)
+{
+	if (mask & (WL_EVENT_HANGUP | WL_EVENT_ERROR)) {
+		wl_event_source_remove(w.x_source);
+		w.x_source = NULL;
+		struct request *request, *tmp;
+		wl_list_for_each_safe(request, tmp, &w.requests, link) {
+			wl_list_remove(&request->link);
+			free(request);
+		}
+		struct shape_request *shape_request, *shape_tmp;
+		wl_list_for_each_safe(shape_request, shape_tmp, &w.shape_requests, link) {
+			wl_list_remove(&shape_request->link);
+			free(shape_request);
+		}
+		xcb_disconnect(w.x);
+		w.x = NULL;
+		return 0;
+	}
+	xcb_generic_event_t *event;
+	bool origin = false, refocus = false;
+	while ((event = xcb_poll_for_event(w.x))) {
+		uint8_t type = event->response_type & 0x7f;
+		if (type == XCB_PROPERTY_NOTIFY) {
+			xcb_property_notify_event_t *ev = (void *)event;
+			if (ev->atom == w.atom_net_wm_icon) {
+				request_property(ev->window, ev->atom, 262144);
+			} else if (ev->atom == w.atom_class || ev->atom == w.atom_hwnd
+					|| ev->atom == w.atom_user_time) {
+				request_property(ev->window, ev->atom, ev->atom == w.atom_class ? 8 : 32);
+			}
+		} else if (type == XCB_FOCUS_IN) {
+			xcb_focus_in_event_t *ev = (void *)event;
+			if (ev->event == w.root && ev->mode == XCB_NOTIFY_MODE_NORMAL
+					&& ev->detail == XCB_NOTIFY_DETAIL_NONE) {
+				refocus = true;
+			}
+		} else if (w.shape && type == w.shape_event + XCB_SHAPE_NOTIFY) {
+			xcb_shape_notify_event_t *ev = (void *)event;
+			if (ev->shape_kind == XCB_SHAPE_SK_BOUNDING) {
+				request_shape(ev->affected_window, false);
+			}
+		} else if (w.randr && (type == w.randr_event + XCB_RANDR_SCREEN_CHANGE_NOTIFY
+				|| type == w.randr_event + XCB_RANDR_NOTIFY)) {
+			origin = true;
+		}
+		free(event);
+	}
+	struct request *request, *tmp;
+	wl_list_for_each_safe(request, tmp, &w.requests, link) {
+		void *reply = NULL;
+		xcb_generic_error_t *error = NULL;
+		if (!xcb_poll_for_reply(w.x, request->sequence, &reply, &error)) {
+			break;
+		}
+		handle_reply(request, reply);
+		free(reply);
+		free(error);
+		wl_list_remove(&request->link);
+		free(request);
+	}
+	struct shape_request *shape_request, *shape_tmp;
+	wl_list_for_each_safe(shape_request, shape_tmp, &w.shape_requests, link) {
+		void *reply = NULL;
+		xcb_generic_error_t *error = NULL;
+		if (!xcb_poll_for_reply(w.x, shape_request->sequence, &reply, &error)) {
+			break;
+		}
+		handle_shape_reply(shape_request, reply);
+		free(reply);
+		free(error);
+		wl_list_remove(&shape_request->link);
+		free(shape_request);
+	}
+	if (origin) {
+		set_randr_primary();
+		update_origin();
+	}
+	if (refocus) {
+		/*
+		 * X's focus went to no window. wlroots, on its own X
+		 * connection, clears X's focus when the keyboard moves from
+		 * one X window to another; that can come after this
+		 * connection gave the focus to a Wine window (the taskbar,
+		 * clicked). The keys then went nowhere (Esc in the ReactOS
+		 * Start menu, Win+E). Give it back to the window with the
+		 * keyboard, if a Wine one has it.
+		 */
+		w.x_focus = XCB_WINDOW_NONE;
+		focus_wine_window(w.server->seat.seat->keyboard_state.focused_surface);
+	}
+	xcb_flush(w.x);
+	return 0;
+}
+
+void
+win4wine_xwayland_ready(struct server *server)
+{
+	if (!w.ipc || w.x || !server->xwayland || !server->xwayland->display_name) {
+		return;
+	}
+	w.x = xcb_connect(server->xwayland->display_name, NULL);
+	if (xcb_connection_has_error(w.x)) {
+		wlr_log(WLR_ERROR, "win4wine: no X connection");
+		xcb_disconnect(w.x);
+		w.x = NULL;
+		return;
+	}
+	w.root = xcb_setup_roots_iterator(xcb_get_setup(w.x)).data->root;
+	w.atom_hwnd = intern("_WIN4WINE_HWND");
+	w.atom_class = intern("_WIN4WINE_CLASS");
+	w.atom_net_wm_icon = intern("_NET_WM_ICON");
+	w.atom_gtk_workareas = intern("_GTK_WORKAREAS_D0");
+	w.atom_net_active_window = intern("_NET_ACTIVE_WINDOW");
+	w.atom_user_time = intern("_NET_WM_USER_TIME");
+	const xcb_query_extension_reply_t *randr = xcb_get_extension_data(w.x, &xcb_randr_id);
+	w.randr = randr && randr->present;
+	w.randr_event = w.randr ? randr->first_event : 0;
+	const xcb_query_extension_reply_t *shape = xcb_get_extension_data(w.x, &xcb_shape_id);
+	w.shape = shape && shape->present;
+	w.shape_event = w.shape ? shape->first_event : 0;
+	if (w.randr) {
+		xcb_randr_select_input(w.x, w.root, XCB_RANDR_NOTIFY_MASK_SCREEN_CHANGE
+			| XCB_RANDR_NOTIFY_MASK_OUTPUT_CHANGE | XCB_RANDR_NOTIFY_MASK_CRTC_CHANGE);
+	}
+	/* X's focus going to no window (handle_x_events) */
+	uint32_t focus_mask = XCB_EVENT_MASK_FOCUS_CHANGE;
+	xcb_change_window_attributes(w.x, w.root, XCB_CW_EVENT_MASK, &focus_mask);
+	w.x_source = wl_event_loop_add_fd(server->wl_event_loop, xcb_get_file_descriptor(w.x),
+		WL_EVENT_READABLE, handle_x_events, NULL);
+	set_randr_primary();
+	update_origin();
+	if (w.workareas) {
+		struct wlr_box *areas = w.workareas;
+		w.workareas = NULL;
+		win4wine_set_workareas(areas, w.workarea_count);
+		free(areas);
+	}
+	struct view *view;
+	wl_list_for_each(view, &server->views, link) {
+		if (view->win4wine) {
+			watch_window(view);
+		}
+	}
+	xcb_flush(w.x);
+}
+
+void
+win4wine_set_workareas(const struct wlr_box *areas, size_t count)
+{
+	free(w.workareas);
+	w.workareas = count ? xmalloc(count * sizeof(*areas)) : NULL;
+	memcpy(w.workareas, areas, count * sizeof(*areas));
+	w.workarea_count = count;
+	if (!w.x || w.atom_gtk_workareas == XCB_ATOM_NONE) {
+		return;
+	}
+	uint32_t *data = xmalloc(4 * sizeof(uint32_t) * (count ? count : 1));
+	for (size_t i = 0; i < count; i++) {
+		data[4 * i] = areas[i].x;
+		data[4 * i + 1] = areas[i].y;
+		data[4 * i + 2] = areas[i].width;
+		data[4 * i + 3] = areas[i].height;
+	}
+	xcb_change_property(w.x, XCB_PROP_MODE_REPLACE, w.root, w.atom_gtk_workareas,
+		XCB_ATOM_CARDINAL, 32, 4 * count, data);
+	xcb_flush(w.x);
+	free(data);
+}
+
+/* Wait for a window's identity (map should not focus XP's desktop or a frame) */
+static void
+wait_for_identity(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	while (w.x && data->pending && !wl_list_empty(&w.requests)) {
+		struct request *request = wl_container_of(w.requests.next, request, link);
+		xcb_generic_error_t *error = NULL;
+		xcb_get_property_reply_t *reply = xcb_get_property_reply(w.x,
+			(xcb_get_property_cookie_t){request->sequence}, &error);
+		wl_list_remove(&request->link);
+		handle_reply(request, reply);
+		free(reply);
+		free(error);
+		free(request);
+	}
+	/* Events read meanwhile wait in xcb's queue */
+	if (w.x) {
+		handle_x_events(0, WL_EVENT_READABLE, NULL);
+	}
+}
+
+/* Stacking */
+
+static void
+set_layer(struct view *view, bool on_top, bool on_bottom)
+{
+	if (view_is_always_on_top(view) != on_top) {
+		view_toggle_always_on_top(view);
+	}
+	if (view_is_always_on_bottom(view) != on_bottom) {
+		view_toggle_always_on_bottom(view);
+	}
+}
+
+/* A Win32 topmost window, or one owned by one (it stays above its owner) */
+static bool
+topmost(struct view *view)
+{
+	for (struct wlr_xwayland_surface *x = xwayland_surface_from_view(view); x; x = x->parent) {
+		if (x->above) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+append_x_windows(struct wlr_scene_tree *tree, xcb_window_t **ids, size_t *count)
+{
+	struct wlr_scene_node *node;
+	wl_list_for_each(node, &tree->children, link) {
+		struct node_descriptor *desc = node->data;
+		if (!desc || desc->type != LAB_NODE_DESC_VIEW) {
+			continue;
+		}
+		struct view *view = desc->data;
+		if (view->type == LAB_XWAYLAND_VIEW && view->mapped) {
+			*ids = xrealloc(*ids, (*count + 1) * sizeof(**ids));
+			(*ids)[(*count)++] = xwayland_surface_from_view(view)->window_id;
+		}
+	}
+}
+
+/*
+ * Xwayland finds the window under the pointer by X's stacking, which
+ * must then follow the scene's; labwc restacks X only for a raised
+ * window (to the top, whatever its layer).
+ */
+static void
+sync_x_stacking(void)
+{
+	xcb_window_t *ids = NULL;
+	size_t count = 0;
+	append_x_windows(w.server->view_tree_always_on_bottom, &ids, &count);
+	append_x_windows(w.server->workspaces.current->tree, &ids, &count);
+	append_x_windows(w.server->view_tree_always_on_top, &ids, &count);
+	for (size_t i = 0; i < count; i++) {
+		struct view *view = view_for_id(ids[i]);
+		if (view) {
+			wlr_xwayland_surface_restack(xwayland_surface_from_view(view), NULL,
+				XCB_STACK_MODE_ABOVE);
+		}
+	}
+	free(ids);
+}
+
+/*
+ * XP's desktop below everything, the taskbar and topmost Win32 windows
+ * above the others, the Start menu above them; each frame right below
+ * its window (wm.py's restack).
+ */
+static void
+restack(void)
+{
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (!data || !view->mapped) {
+			continue;
+		}
+		switch (data->kind) {
+		case WIN4WINE_DESKTOP:
+			set_layer(view, false, true);
+			wlr_scene_node_lower_to_bottom(&view->scene_tree->node);
+			break;
+		case WIN4WINE_DOCK:
+		case WIN4WINE_POPUP:
+			set_layer(view, true, false);
+			break;
+		case WIN4WINE_WINE:
+			/* Win32 topmost windows (_NET_WM_STATE_ABOVE) and the ones they own */
+			set_layer(view, topmost(view), false);
+			if (view == w.server->active_view && topmost(view)) {
+				wlr_scene_node_raise_to_top(&view->scene_tree->node);
+			}
+			break;
+		default:
+			break;
+		}
+	}
+	/* The Start menu covers the taskbar */
+	wl_list_for_each(view, &w.server->views, link) {
+		if (view->mapped && win4wine_kind(view) == WIN4WINE_POPUP) {
+			wlr_scene_node_raise_to_top(&view->scene_tree->node);
+		}
+	}
+	wl_list_for_each(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (!data || data->kind != WIN4WINE_NATIVE || !data->frame) {
+			continue;
+		}
+		struct wlr_scene_node *frame = &data->frame->scene_tree->node;
+		if (frame->parent != view->scene_tree->node.parent) {
+			wlr_scene_node_reparent(frame, view->scene_tree->node.parent);
+		}
+		wlr_scene_node_place_below(frame, &view->scene_tree->node);
+	}
+	sync_x_stacking();
+}
+
+void
+win4wine_view_raised(struct view *view)
+{
+	if (w.ipc && data_of(view)) {
+		restack();
+	}
+}
+
+/* Coordinates: Win32 screen coordinates are X space less the primary's origin */
+
+/* A view's geometry in X space: an X window's own, exactly */
+static void
+x_geometry(struct view *view, struct wlr_box *xbox)
+{
+	if (view->type == LAB_XWAYLAND_VIEW) {
+		struct wlr_xwayland_surface *xsurface = xwayland_surface_from_view(view);
+		*xbox = (struct wlr_box){xsurface->x, xsurface->y, xsurface->width, xsurface->height};
+	} else {
+		xwayland_scale_to_x(w.server, &view->current, xbox);
+	}
+}
+
+static void
+to_win32(const struct wlr_box *box, struct wlr_box *out)
+{
+	xwayland_scale_to_x(w.server, box, out);
+	out->x -= w.origin_x;
+	out->y -= w.origin_y;
+}
+
+static void
+from_win32(const struct wlr_box *box, struct wlr_box *out)
+{
+	struct wlr_box xbox = *box;
+	xbox.x += w.origin_x;
+	xbox.y += w.origin_y;
+	xwayland_scale_from_x(w.server, &xbox, out);
+}
+
+static struct wlr_box
+work_area(struct view *view)
+{
+	/* The output that to_win32() converts the view with */
+	struct output *output = output_nearest_to(w.server, view->current.x + view->current.width / 2,
+		view->current.y + view->current.height / 2);
+	return output_is_usable(output) ? output_usable_area_in_layout_coords(output) : view->current;
+}
+
+static float
+scale_of(struct view *view)
+{
+	return xwayland_scale_for_box(w.server, &view->current);
+}
+
+bool
+win4wine_margin(struct view *view, struct border *margin)
+{
+	struct win4wine_view *data = data_of(view);
+	if (!w.ipc || !data || data->kind != WIN4WINE_NATIVE || !data->frame_hwnd
+			|| view->fullscreen) {
+		return false;
+	}
+	float scale = scale_of(view);
+	if (view->maximized == VIEW_AXIS_BOTH) {
+		/* A maximized XP window hides its outer border past the work area */
+		margin->left = (int)lroundf((data->extents[0] - data->clip[0]) / scale);
+		margin->right = (int)lroundf((data->extents[1] - data->clip[0]) / scale);
+		margin->top = (int)lroundf((data->extents[2] - data->clip[1]) / scale);
+		margin->bottom = (int)lroundf((data->extents[3] - data->clip[1]) / scale);
+	} else {
+		margin->left = (int)ceilf(data->extents[0] / scale);
+		margin->right = (int)ceilf(data->extents[1] / scale);
+		margin->top = (int)ceilf(data->extents[2] / scale);
+		margin->bottom = (int)ceilf(data->extents[3] / scale);
+	}
+	return true;
+}
+
+static struct win4wine_view *identify(struct view *view);
+static void place_frame(struct view *view);
+
+bool
+win4wine_client_maximizes(struct view *view)
+{
+	/* Wine computes its maximized rectangle from the work area itself */
+	if (!w.ipc || view->type != LAB_XWAYLAND_VIEW) {
+		return false;
+	}
+	return identify(view)->kind != WIN4WINE_NATIVE;
+}
+
+void
+win4wine_view_moved(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	if (!w.ipc || !data) {
+		return;
+	}
+	/* The frame follows at once (the proxy follows geometry.tsv later) */
+	if (data->kind == WIN4WINE_NATIVE) {
+		place_frame(view);
+	}
+	/*
+	 * The taskbar changed its size (Windows 7's small icons) or place:
+	 * the work area follows, and maximized windows with it
+	 */
+	if (data->kind == WIN4WINE_DOCK && view->mapped
+			&& !wlr_box_equal(&data->dock_box, &view->current)) {
+		data->dock_box = view->current;
+		w.dock_moved = true;    /* after this commit (sync_now) */
+	}
+	win4wine_changed();
+}
+
+struct view *
+win4wine_frame_owner(struct view *view)
+{
+	if (!w.ipc || win4wine_kind(view) != WIN4WINE_FRAME) {
+		return NULL;
+	}
+	return native_of_frame(view);
+}
+
+/* Put a frame around its window: the frame's X geometry from the window's */
+static void
+place_frame(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	if (!data->frame || !data->frame->mapped || !data->frame_ready) {
+		return;
+	}
+	struct wlr_box xbox;
+	x_geometry(view, &xbox);
+	xbox.x -= data->extents[0];
+	xbox.y -= data->extents[2];
+	xbox.width += data->extents[0] + data->extents[1];
+	xbox.height += data->extents[2] + data->extents[3];
+	xwayland_view_configure_x(data->frame, &xbox);
+}
+
+/* Sync */
+
+static void
+write_windows(void)
+{
+	char *text = NULL, *classes = NULL;
+	size_t size = 0, classes_size = 0;
+	FILE *f = open_memstream(&text, &size);
+	/*
+	 * Each window's application (Wayland app_id, X11 WM_CLASS class), as
+	 * the X11 session's WM writes it: Windows 7's taskbar groups the
+	 * windows of an application (the proxy's AppUserModelID). Written
+	 * before windows.tsv, which makes the proxy create the frames.
+	 */
+	FILE *c = open_memstream(&classes, &classes_size);
+	struct wlr_surface *focused = w.server->seat.seat->keyboard_state.focused_surface;
+	struct view *view;
+	wl_list_for_each_reverse(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (!is_native_task(view) || (!view->mapped && !view->minimized)) {
+			continue;
+		}
+		if (data->icon_dirty) {
+			char name[64];
+			snprintf(name, sizeof(name), "icon-%x.argb", data->id);
+			if (data->icon) {
+				write_file(name, data->icon, data->icon_size);
+			} else {
+				char path[4096];
+				snprintf(path, sizeof(path), "%s/%s", w.ipc, name);
+				unlink(path);
+			}
+			data->icon_dirty = false;
+		}
+		const char *title = view_get_string_prop(view, "title");
+		bool active = w.server->active_view == view && focused == view->surface;
+		fprintf(f, "%x\t%d\t%d\t", data->id, view->minimized, active);
+		int n = 0;
+		for (const char *p = title ? title : ""; *p && n < 500; p++, n++) {
+			fputc(*p == '\t' || *p == '\n' || *p == '\r' ? ' ' : *p, f);
+		}
+		fputc('\n', f);
+		const char *app_id = view_get_string_prop(view, "app_id");
+		fprintf(c, "%x\t", data->id);
+		n = 0;
+		for (const char *p = app_id ? app_id : ""; *p && n < 100; p++, n++) {
+			fputc(*p == '\t' || *p == '\n' || *p == '\r' ? ' ' : *p, c);
+		}
+		fputc('\n', c);
+	}
+	fclose(c);
+	write_if_changed("classes.tsv", classes, &w.classes_text);
+	fclose(f);
+	write_if_changed("windows.tsv", text, &w.windows_text);
+}
+
+static void
+write_geometry(void)
+{
+	char *text = NULL;
+	size_t size = 0;
+	FILE *f = open_memstream(&text, &size);
+	struct view *view;
+	wl_list_for_each_reverse(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (!is_native_task(view) || !view->mapped) {
+			continue;
+		}
+		struct wlr_box box, area = work_area(view), warea;
+		x_geometry(view, &box);
+		box.x -= w.origin_x;
+		box.y -= w.origin_y;
+		to_win32(&area, &warea);
+		fprintf(f, "%x %d %d %d %d %d %d %d %d %d\n", data->id, box.x, box.y,
+			box.width, box.height, view->maximized == VIEW_AXIS_BOTH,
+			warea.x, warea.y, warea.width, warea.height);
+	}
+	fclose(f);
+	write_if_changed("geometry.tsv", text, &w.geometry_text);
+}
+
+/* Windows snapped to half of their output, for Win+arrows in the proxy */
+static void
+write_tiled(void)
+{
+	char *text = NULL;
+	size_t size = 0;
+	FILE *f = open_memstream(&text, &size);
+	struct view *view;
+	wl_list_for_each_reverse(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		uint32_t hwnd = !data ? 0 : data->kind == WIN4WINE_WINE ? data->hwnd
+			: data->kind == WIN4WINE_NATIVE ? data->frame_hwnd : 0;
+		if (!hwnd || !view->mapped || view->fullscreen || view->maximized != VIEW_AXIS_NONE
+				|| (view->tiled != VIEW_EDGE_LEFT && view->tiled != VIEW_EDGE_RIGHT)) {
+			continue;
+		}
+		fprintf(f, "%x %d\n", hwnd, view->tiled == VIEW_EDGE_RIGHT);
+	}
+	fclose(f);
+	write_if_changed("tiled.tsv", text, &w.tiled_text);
+}
+
+bool
+win4wine_snap_preview(const struct wlr_box *box)
+{
+	struct wlr_box shown = {0};
+	if (!w.ipc || (!box && wlr_box_equal(&shown, &w.snapping))) {
+		/* (called as the pointer moves) */
+		return w.ipc;
+	}
+	if (box && !bridge_alive()) {
+		return false;
+	}
+	if (box) {
+		to_win32(box, &shown);
+	}
+	if (!wlr_box_equal(&shown, &w.snapping)) {
+		char text[96];
+		int n = snprintf(text, sizeof(text), "%u %d %d %d %d\n", ++w.snapping_seq,
+			shown.x, shown.y, shown.width, shown.height);
+		write_file("snapping.tsv", text, n);
+		w.snapping = shown;
+	}
+	return true;
+}
+
+/* frames.tsv: hwnd id left right top bottom maximized iconic clip_x clip_y */
+static void
+read_frames(void)
+{
+	char path[4096];
+	snprintf(path, sizeof(path), "%s/frames.tsv", w.ipc);
+	FILE *f = fopen(path, "r");
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (data && data->kind == WIN4WINE_NATIVE) {
+			data->last_frame_hwnd = data->frame_hwnd;
+			data->frame_hwnd = 0;
+		}
+	}
+	if (!f) {
+		return;
+	}
+	char line[256];
+	while (fgets(line, sizeof(line), f)) {
+		unsigned int hwnd, id;
+		int left, right, top, bottom, maximized, iconic = 0, clip_x = 0, clip_y = 0;
+		if (sscanf(line, "%x %x %d %d %d %d %d %d %d %d", &hwnd, &id, &left, &right,
+				&top, &bottom, &maximized, &iconic, &clip_x, &clip_y) < 7) {
+			continue;
+		}
+		struct view *native = view_for_id(id);
+		struct win4wine_view *data = data_of(native);
+		if (!data || data->kind != WIN4WINE_NATIVE) {
+			continue;
+		}
+		if (data->last_frame_hwnd != hwnd || data->extents[0] != left || data->extents[1] != right
+				|| data->extents[2] != top || data->extents[3] != bottom
+				|| data->clip[0] != clip_x || data->clip[1] != clip_y) {
+			data->margin_changed = true;
+		}
+		data->frame_hwnd = hwnd;
+		data->extents[0] = left, data->extents[1] = right;
+		data->extents[2] = top, data->extents[3] = bottom;
+		data->clip[0] = clip_x, data->clip[1] = clip_y;
+		data->frame_ready = !iconic;
+	}
+	fclose(f);
+}
+
+/*
+ * Windows' default-window slots, as wm.py: 22 pixels right (at 96 DPI,
+ * scaled by the frame's border) and the caption's height minus one down,
+ * again from the first after a quarter of the work area.
+ */
+static void
+cascade(struct wlr_box area, struct border margin, int *x, int *y)
+{
+	int step_x = (int)lround(22.0 * (margin.left > 1 ? margin.left : 1) / 4);
+	int step_y = margin.top - 1;
+	step_x = step_x > 1 ? step_x : 1;
+	step_y = step_y > 1 ? step_y : 1;
+	int slot = w.cascade_slot + 1;
+	if (slot * step_x > area.width / 4 || slot * step_y > area.height / 4) {
+		slot = 1;
+	}
+	w.cascade_slot = slot;
+	*x = area.x + slot * step_x + margin.left;
+	*y = area.y + slot * step_y + margin.top;
+}
+
+/* An X11 window that asked for its position (Wayland windows have none) */
+static bool
+positioned(struct view *view)
+{
+	if (view->type != LAB_XWAYLAND_VIEW) {
+		return false;
+	}
+	struct wlr_xwayland_surface *xsurface = xwayland_surface_from_view(view);
+	return xsurface->size_hints && (xsurface->size_hints->flags
+		& (XCB_ICCCM_SIZE_HINT_US_POSITION | XCB_ICCCM_SIZE_HINT_P_POSITION));
+}
+
+/* Pair frames (proxy windows) with their native windows */
+static void
+pair_frames(void)
+{
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (!data || data->kind != WIN4WINE_NATIVE) {
+			continue;
+		}
+		struct view *frame = NULL, *other;
+		if (data->frame_hwnd) {
+			wl_list_for_each(other, &w.server->views, link) {
+				struct win4wine_view *fdata = data_of(other);
+				if (fdata && fdata->kind == WIN4WINE_FRAME && fdata->hwnd == data->frame_hwnd) {
+					frame = other;
+					break;
+				}
+			}
+		}
+		if (frame != data->frame) {
+			data->frame = frame;
+			if (frame) {
+				view_set_ssd_mode(view, LAB_SSD_MODE_NONE);
+			}
+			restack();
+		}
+		if (frame && !data->placed && data->frame_ready) {
+			/*
+			 * The first frame: a window without a position of its own
+			 * takes Windows' next default-window slot (wm.py's cascade);
+			 * one with a position keeps its caption inside the work area.
+			 */
+			struct border margin;
+			if (win4wine_margin(view, &margin) && view_is_floating(view)) {
+				struct wlr_box area = work_area(view), box = view->pending;
+				if (!positioned(view)) {
+					cascade(area, margin, &box.x, &box.y);
+				}
+				if (box.x < area.x + margin.left) {
+					box.x = area.x + margin.left;
+				}
+				if (box.y < area.y + margin.top) {
+					box.y = area.y + margin.top;
+				}
+				if (box.x != view->pending.x || box.y != view->pending.y) {
+					view_move(view, box.x, box.y);
+				}
+			}
+			data->placed = true;
+		}
+		if (frame && data->frame_ready && data->margin_changed) {
+			/* A window maximized before its frame was known leaves room for it now */
+			data->margin_changed = false;
+			if (!view_is_floating(view)) {
+				view_reapply_special_geometry(view);
+			}
+		}
+		if (frame) {
+			place_frame(view);
+		}
+	}
+	/* Frames show only with their window */
+	wl_list_for_each(view, &w.server->views, link) {
+		if (win4wine_kind(view) != WIN4WINE_FRAME) {
+			continue;
+		}
+		struct view *native = native_of_frame(view);
+		struct win4wine_view *ndata = data_of(native);
+		bool shown = native && native->mapped && !native->minimized && ndata->frame_ready;
+		wlr_scene_node_set_enabled(&view->scene_tree->node, view->mapped && shown);
+	}
+}
+
+
+void
+win4wine_focus_changed(struct wlr_surface *surface)
+{
+	if (!w.ipc) {
+		return;
+	}
+	if (surface != w.focused) {
+		w.focused = surface;
+		clock_gettime(CLOCK_REALTIME, &w.focus_time);
+	}
+	/* In order with the focus changes: a later idle could undo a newer one */
+	focus_wine_window(surface);
+	win4wine_changed();
+}
+
+static bool
+before_focus_change(const struct timespec *t)
+{
+	return t->tv_sec < w.focus_time.tv_sec
+		|| (t->tv_sec == w.focus_time.tv_sec && t->tv_nsec < w.focus_time.tv_nsec);
+}
+
+/* Commands from the proxy: OP ID [X Y WIDTH HEIGHT], written at WHEN */
+static void
+run_command(const char *op, uint32_t id, int nargs, const int *args, const struct timespec *when)
+{
+	bool snap = !strcmp(op, "snap") || !strcmp(op, "unsnap");
+	struct view *view = snap ? view_for_hwnd(id) : view_for_id(id);
+	if (!view) {
+		return;
+	}
+	if (snap) {
+		/* Win+arrows (window_snap): labwc's snapping, as for a drag to an edge */
+		if (view->fullscreen) {
+			return;
+		}
+		if (!strcmp(op, "snap") && (nargs == 1 || nargs == 5)) {
+			bool natural = nargs == 5 && args[3] > 0 && args[4] > 0 && view_is_floating(view);
+			if (natural) {
+				/* A maximized window the proxy restored on the way */
+				struct win4wine_view *data = data_of(view);
+				struct wlr_box box = {args[1], args[2], args[3], args[4]};
+				if (data->kind == WIN4WINE_NATIVE) {
+					box.x += data->extents[0];
+					box.y += data->extents[2];
+					box.width -= data->extents[0] + data->extents[1];
+					box.height -= data->extents[2] + data->extents[3];
+				}
+				from_win32(&box, &view->natural_geometry);
+			}
+			view_snap_to_edge(view, args[0] ? VIEW_EDGE_RIGHT : VIEW_EDGE_LEFT,
+				/*across_outputs*/ true, /*store_natural_geometry*/ !natural);
+		} else if (!strcmp(op, "unsnap") && view->maximized == VIEW_AXIS_NONE
+				&& view_is_tiled(view)) {
+			view_set_untiled(view);
+			view_apply_natural_geometry(view);
+		}
+		win4wine_changed();
+		return;
+	}
+	if (!strcmp(op, "switch")) {
+		/* Alt+Tab chose this window, which may also be a Wine one */
+		desktop_focus_view(view, /*raise*/ true);
+		return;
+	}
+	if (!is_native(view)) {
+		return;
+	}
+	if (!strcmp(op, "activate")) {
+		/*
+		 * The proxy reports its frame's activation; a window that has
+		 * taken the keyboard since then (XP's log-off dialog after the
+		 * Start menu closed) keeps it.
+		 */
+		if (before_focus_change(when) && w.server->active_view != view) {
+			return;
+		}
+		desktop_focus_view(view, /*raise*/ true);
+	} else if (!strcmp(op, "minimize")) {
+		view_minimize(view, true);
+	} else if (!strcmp(op, "close")) {
+		view_close(view);
+	} else if (!strcmp(op, "maximize")) {
+		view_maximize(view, VIEW_AXIS_BOTH, /*store_natural_geometry*/ true);
+		desktop_focus_view(view, /*raise*/ true);
+	} else if (!strcmp(op, "restore")) {
+		view_maximize(view, VIEW_AXIS_NONE, /*store_natural_geometry*/ false);
+		desktop_focus_view(view, /*raise*/ true);
+	} else if (!strcmp(op, "geometry") && nargs == 4 && args[2] > 0 && args[3] > 0) {
+		struct wlr_box box = {args[0], args[1], args[2], args[3]}, geo;
+		from_win32(&box, &geo);
+		struct wlr_box current;
+		x_geometry(view, &current);
+		current.x -= w.origin_x;
+		current.y -= w.origin_y;
+		if (wlr_box_equal(&current, &box)) {
+			return;
+		}
+		if (view->type == LAB_XWAYLAND_VIEW) {
+			box.x += w.origin_x;
+			box.y += w.origin_y;
+			xwayland_view_configure_x(view, &box);
+		} else {
+			view_move_resize(view, geo);
+		}
+	}
+}
+
+static void
+run_commands(void)
+{
+	DIR *dir = opendir(w.ipc);
+	if (!dir) {
+		return;
+	}
+	struct dirent *entry;
+	char **names = NULL;
+	size_t count = 0;
+	while ((entry = readdir(dir))) {
+		size_t length = strlen(entry->d_name);
+		if (length > 4 && !strcmp(entry->d_name + length - 4, ".cmd")) {
+			names = xrealloc(names, (count + 1) * sizeof(*names));
+			names[count++] = xstrdup(entry->d_name);
+		}
+	}
+	closedir(dir);
+	/* In order, as wm.py (sorted names) */
+	for (size_t i = 1; i < count; i++) {
+		for (size_t j = i; j > 0 && strcmp(names[j - 1], names[j]) > 0; j--) {
+			char *t = names[j];
+			names[j] = names[j - 1];
+			names[j - 1] = t;
+		}
+	}
+	for (size_t i = 0; i < count; i++) {
+		char path[4096], op[32];
+		unsigned int id;
+		int args[5];
+		snprintf(path, sizeof(path), "%s/%s", w.ipc, names[i]);
+		struct stat st;
+		struct timespec when = {0};
+		if (!stat(path, &st)) {
+			when = st.st_mtim;
+		}
+		FILE *f = fopen(path, "r");
+		int fields = f ? fscanf(f, "%31s %x %d %d %d %d %d", op, &id, &args[0], &args[1],
+			&args[2], &args[3], &args[4]) : 0;
+		if (f) {
+			fclose(f);
+		}
+		unlink(path);
+		if (fields >= 2) {
+			run_command(op, id, fields - 2, args, &when);
+		}
+		free(names[i]);
+	}
+	free(names);
+}
+
+/*
+ * Wine makes the window in the root's _NET_ACTIVE_WINDOW its foreground
+ * window: name the frame of the native window with the keyboard there, so
+ * that XP shows it active. X's focus stays off the frame; an input method
+ * would otherwise take the frame (XIM) for the window that has the focus.
+ * labwc's X window manager writes the property again on its next change.
+ */
+static void
+set_net_active_window(xcb_window_t window)
+{
+	if (!w.x || w.atom_net_active_window == XCB_ATOM_NONE) {
+		return;
+	}
+	xcb_change_property(w.x, XCB_PROP_MODE_REPLACE, w.root, w.atom_net_active_window,
+		XCB_ATOM_WINDOW, 32, 1, &window);
+	xcb_flush(w.x);
+}
+
+/*
+ * Wine's windows take the focus themselves (ICCCM's globally active
+ * input: WM_TAKE_FOCUS, no input hint), and Wine ignores WM_TAKE_FOCUS
+ * from the window manager for a window other than its foreground one (the
+ * time is older than the foreground's). Clicking XP's desktop then left X's
+ * focus nowhere and Wine had no keys (Win+R). Give X's focus to the Wine
+ * window with the keyboard, as bridge-wm does.
+ */
+static void
+focus_wine_window(struct wlr_surface *focused)
+{
+	xcb_window_t window = XCB_WINDOW_NONE;
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		struct win4wine_view *data = data_of(view);
+		if (focused && view->surface == focused && view->type == LAB_XWAYLAND_VIEW
+				&& data && data->kind != WIN4WINE_NATIVE && data->kind != WIN4WINE_FRAME) {
+			window = data->id;
+			break;
+		}
+	}
+	if (window == w.x_focus) {
+		return;
+	}
+	w.x_focus = window;
+	if (window && w.x) {
+		xcb_set_input_focus(w.x, XCB_INPUT_FOCUS_POINTER_ROOT, window, XCB_CURRENT_TIME);
+		xcb_flush(w.x);
+	}
+}
+
+static void
+activate_frame(void)
+{
+	struct wlr_surface *focused = w.server->seat.seat->keyboard_state.focused_surface;
+	struct view *view = w.server->active_view;
+	struct win4wine_view *data = data_of(view);
+	struct view *frame = NULL;
+	if (focused && view && view->surface == focused && data && data->kind == WIN4WINE_NATIVE
+			&& data->frame && data->frame->mapped) {
+		frame = data->frame;
+	}
+	if (frame == w.active_frame) {
+		return;
+	}
+	if (w.active_frame && (!view || view->type != LAB_XWAYLAND_VIEW || is_native(view))) {
+		set_net_active_window(XCB_WINDOW_NONE);
+	}
+	w.active_frame = frame;
+	if (frame) {
+		set_net_active_window(xwayland_surface_from_view(frame)->window_id);
+	}
+}
+
+static void
+sync_now(void *unused)
+{
+	w.idle = NULL;
+	if (w.dock_moved) {
+		w.dock_moved = false;
+		output_update_all_usable_areas(w.server, false);
+	}
+	write_geometry();  /* first: frames follow their windows */
+	run_commands();
+	write_windows();
+	read_frames();
+	pair_frames();
+	write_geometry();
+	write_tiled();
+	activate_frame();
+}
+
+void
+win4wine_changed(void)
+{
+	if (w.ipc && !w.idle) {
+		w.idle = wl_event_loop_add_idle(w.server->wl_event_loop, sync_now, NULL);
+	}
+}
+
+/* The supervisor names Win32's primary monitor in the file "primary" */
+static void
+read_primary(void)
+{
+	char path[4096], name[128] = "";
+	snprintf(path, sizeof(path), "%s/primary", w.ipc);
+	FILE *f = fopen(path, "r");
+	if (!f) {
+		return;
+	}
+	if (fgets(name, sizeof(name), f)) {
+		name[strcspn(name, "\r\n")] = '\0';
+	}
+	fclose(f);
+	xwayland_scale_set_primary(w.server, name[0] ? name : NULL);
+	output_update_all_usable_areas(w.server, /*layout_changed*/ true);
+	set_randr_primary();
+}
+
+static int
+handle_inotify(int fd, uint32_t mask, void *unused)
+{
+	char buffer[4096] __attribute__((aligned(__alignof__(struct inotify_event))));
+	bool changed = false;
+	ssize_t length;
+	while ((length = read(fd, buffer, sizeof(buffer))) > 0) {
+		for (char *p = buffer; p < buffer + length; ) {
+			struct inotify_event *event = (struct inotify_event *)p;
+			size_t n = event->len ? strlen(event->name) : 0;
+			if (n && (!strcmp(event->name, "frames.tsv")
+					|| (n > 4 && !strcmp(event->name + n - 4, ".cmd")))) {
+				changed = true;
+			}
+			if (n && !strcmp(event->name, "primary")) {
+				read_primary();
+			}
+			p += sizeof(*event) + event->len;
+		}
+	}
+	if (changed) {
+		win4wine_changed();
+	}
+	return 0;
+}
+
+/* View life cycle */
+
+static void
+reclassify(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	enum win4wine_kind kind = classify(view, data);
+	if (kind == data->kind) {
+		restack();
+		return;
+	}
+	data->kind = kind;
+	wlr_log(WLR_DEBUG, "win4wine: %x is now %d (class %s, hwnd %x)", data->id, kind,
+		data->wclass, data->hwnd);
+	if (kind == WIN4WINE_FRAME) {
+		/* The proxy's windows show only as frames, with no decorations */
+		view_set_ssd_mode(view, LAB_SSD_MODE_NONE);
+	}
+	if (kind == WIN4WINE_NATIVE && view->type == LAB_XWAYLAND_VIEW) {
+		request_property(data->id, w.atom_net_wm_icon, 262144);
+		xcb_flush(w.x);
+	}
+	if (kind == WIN4WINE_DOCK || kind == WIN4WINE_DESKTOP) {
+		output_update_all_usable_areas(w.server, false);
+	}
+	restack();
+}
+
+/* The view's kind, known before it maps (an X window's identity comes from Wine) */
+static struct win4wine_view *
+identify(struct view *view)
+{
+	struct win4wine_view *data = ensure_data(view);
+	if (data->kind) {
+		return data;
+	}
+	if (view->type == LAB_XWAYLAND_VIEW) {
+		if (!data->pending) {
+			watch_window(view);
+		}
+		wait_for_identity(view);
+	}
+	data->kind = classify(view, data);
+	return data;
+}
+
+void
+win4wine_view_map(struct view *view)
+{
+	if (!w.ipc) {
+		return;
+	}
+	struct win4wine_view *data = identify(view);
+	wlr_log(WLR_DEBUG, "win4wine: map %x kind %d (class %s, hwnd %x)", data->id, data->kind,
+		data->wclass, data->hwnd);
+	if (data->kind == WIN4WINE_FRAME) {
+		view_set_ssd_mode(view, LAB_SSD_MODE_NONE);
+		/* Hidden until paired with its window */
+		wlr_scene_node_set_enabled(&view->scene_tree->node, false);
+	} else if (is_native_task(view) && bridge_alive()) {
+		/* The XP frame replaces labwc's */
+		view_set_ssd_mode(view, LAB_SSD_MODE_NONE);
+	}
+	if (data->kind == WIN4WINE_NATIVE && view->type == LAB_XWAYLAND_VIEW && !data->icon) {
+		request_property(data->id, w.atom_net_wm_icon, 262144);
+		xcb_flush(w.x);
+	}
+	if (data->kind == WIN4WINE_NATIVE && view->type != LAB_XWAYLAND_VIEW && !data->icon) {
+		load_app_icon(data);
+	}
+	if (data->kind == WIN4WINE_DOCK) {
+		output_update_all_usable_areas(view->server, false);
+	}
+	restack();
+	win4wine_changed();
+}
+
+void
+win4wine_view_unmap(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	if (!w.ipc || !data) {
+		return;
+	}
+	if (data->kind == WIN4WINE_DOCK) {
+		output_update_all_usable_areas(view->server, false);
+	}
+	win4wine_changed();
+}
+
+void
+win4wine_view_destroy(struct view *view)
+{
+	struct win4wine_view *data = data_of(view);
+	if (!data) {
+		return;
+	}
+	struct view *other;
+	wl_list_for_each(other, &view->server->views, link) {
+		struct win4wine_view *odata = data_of(other);
+		if (odata && odata->frame == view) {
+			odata->frame = NULL;
+		}
+	}
+	if (w.switch_view == view) {
+		w.switch_view = NULL;
+	}
+	if (w.active_frame == view) {
+		w.active_frame = NULL;
+	}
+	if (w.ipc && data->kind == WIN4WINE_NATIVE) {
+		char path[4096];
+		snprintf(path, sizeof(path), "%s/icon-%x.argb", w.ipc, data->id);
+		unlink(path);
+	}
+	free(data->icon);
+	free(data);
+	view->win4wine = NULL;
+	win4wine_changed();
+}
+
+struct view *
+win4wine_focus_target(struct view *view)
+{
+	if (w.ipc && data_of(view)) {
+		wlr_log(WLR_DEBUG, "win4wine: focus %x kind %d", data_of(view)->id, data_of(view)->kind);
+	}
+	if (!w.ipc || win4wine_kind(view) != WIN4WINE_FRAME) {
+		return view;
+	}
+	/* Wine activates the frame; its window takes the keyboard */
+	struct view *native = native_of_frame(view);
+	return native && native->mapped && !native->minimized ? native : NULL;
+}
+
+bool
+win4wine_activates_next(struct view *view)
+{
+	/*
+	 * When a Win32 window goes, Windows activates the next one in its
+	 * own order. Another window taking the keyboard meanwhile would
+	 * deactivate what Wine shows next; XP's log-off dialog closes then.
+	 */
+	switch (win4wine_kind(view)) {
+	case WIN4WINE_WINE:
+	case WIN4WINE_POPUP:
+	case WIN4WINE_DESKTOP:
+	case WIN4WINE_DOCK:
+		return w.ipc && bridge_alive();
+	default:
+		return false;
+	}
+}
+
+/*
+ * Wine's own unmanaged windows (override-redirect) take no keyboard when
+ * they map: Wine moves X's focus among its windows itself. Taking the
+ * keyboard made wlroots deactivate the Wine window and focus no X window;
+ * the ReactOS Start menu, shown without activation and read from its
+ * owner's (the taskbar's) keys, then had no keys (Esc), nor had Wine any
+ * after it closed (Win+E).
+ */
+bool
+win4wine_unmanaged_keeps_keyboard(struct wlr_xwayland_surface *xsurface)
+{
+	if (!w.ipc || !w.server) {
+		return false;
+	}
+	/*
+	 * Nor from a native window: a Wine tooltip (the Start button's,
+	 * shown after the Start menu closed with Esc) took the keyboard
+	 * from a Linux window, and the Windows key then went nowhere.
+	 * X11's window manager never focuses such windows either; Wine
+	 * asks for the keyboard itself when it wants it (request_activate).
+	 */
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		if (view->type != LAB_XWAYLAND_VIEW) {
+			continue;
+		}
+		switch (win4wine_kind(view)) {
+		case WIN4WINE_WINE:
+		case WIN4WINE_POPUP:
+		case WIN4WINE_DESKTOP:
+		case WIN4WINE_DOCK:
+			if (xwayland_surface_from_view(view)->pid == xsurface->pid) {
+				return true;
+			}
+			break;
+		default:
+			break;
+		}
+	}
+	return false;
+}
+
+bool
+win4wine_focus_on_map(struct view *view)
+{
+	switch (win4wine_kind(view)) {
+	case WIN4WINE_FRAME:
+	case WIN4WINE_DESKTOP:
+	case WIN4WINE_DOCK:
+		return false;
+	case WIN4WINE_WINE:
+	case WIN4WINE_POPUP: {
+		/*
+		 * Wine expects the window manager to activate a window it maps
+		 * as its foreground window, and marks the others with
+		 * _NET_WM_USER_TIME 0. It also asks for fullscreen windows to
+		 * be activated; XP's dimmed log-off screen is one (and topmost),
+		 * and its dialog, which maps next, closes when deactivated.
+		 */
+		struct win4wine_view *data = data_of(view);
+		if (!w.ipc || !data) {
+			return true;
+		}
+		struct wlr_xwayland_surface *xsurface = xwayland_surface_from_view(view);
+		return !data->no_activation && !(xsurface->fullscreen && xsurface->above);
+	}
+	default:
+		return true;
+	}
+}
+
+/* Usable area: XP's taskbar sets no strut; take its edge as wm.py does */
+void
+win4wine_adjust_usable_area(struct output *output, struct wlr_box *usable)
+{
+	if (!w.ipc) {
+		return;
+	}
+	struct wlr_box ob;
+	wlr_output_layout_get_box(w.server->output_layout, output->wlr_output, &ob);
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		if (!view->mapped || view->minimized || win4wine_kind(view) != WIN4WINE_DOCK
+				|| view_has_strut_partial(view)) {
+			continue;
+		}
+		struct wlr_box dock, overlap;
+		dock = view->current;
+		if (!wlr_box_intersection(&overlap, &dock, &ob)) {
+			continue;
+		}
+		/* output coordinates */
+		int x = dock.x - ob.x, y = dock.y - ob.y;
+		int right = usable->x + usable->width, bottom = usable->y + usable->height;
+		if (dock.width >= ob.width / 2) {
+			if (y >= ob.height / 2) {
+				bottom = y < bottom ? y : bottom;
+			} else {
+				int edge = y + dock.height;
+				usable->y = edge > usable->y ? edge : usable->y;
+			}
+		} else if (x >= ob.width / 2) {
+			right = x < right ? x : right;
+		} else {
+			int edge = x + dock.width;
+			usable->x = edge > usable->x ? edge : usable->x;
+		}
+		usable->width = right - usable->x > 1 ? right - usable->x : 1;
+		usable->height = bottom - usable->y > 1 ? bottom - usable->y : 1;
+	}
+}
+
+/*
+ * The same edges in X space, exactly: from the taskbar's X geometry rather
+ * than from its layout box, whose rounding on a fractional scale put the
+ * work area one pixel into the taskbar (maximized windows covered its top).
+ */
+void
+win4wine_adjust_x_area(struct output *output, const struct wlr_box *xob, struct wlr_box *xarea)
+{
+	if (!w.ipc) {
+		return;
+	}
+	struct wlr_box ob;
+	wlr_output_layout_get_box(w.server->output_layout, output->wlr_output, &ob);
+	struct view *view;
+	wl_list_for_each(view, &w.server->views, link) {
+		if (!view->mapped || view->minimized || win4wine_kind(view) != WIN4WINE_DOCK
+				|| view_has_strut_partial(view) || view->type != LAB_XWAYLAND_VIEW) {
+			continue;
+		}
+		struct wlr_box overlap, dock = view->current;
+		if (!wlr_box_intersection(&overlap, &dock, &ob)) {
+			continue;
+		}
+		struct wlr_xwayland_surface *xsurface = xwayland_surface_from_view(view);
+		int x = xsurface->x, y = xsurface->y;
+		int right = xarea->x + xarea->width, bottom = xarea->y + xarea->height;
+		/* the same sides as win4wine_adjust_usable_area */
+		if (dock.width >= ob.width / 2) {
+			if (dock.y - ob.y >= ob.height / 2) {
+				bottom = y < bottom && y > xob->y ? y : bottom;
+			} else {
+				int edge = y + xsurface->height;
+				xarea->y = edge > xarea->y ? edge : xarea->y;
+			}
+		} else if (dock.x - ob.x >= ob.width / 2) {
+			right = x < right && x > xob->x ? x : right;
+		} else {
+			int edge = x + xsurface->width;
+			xarea->x = edge > xarea->x ? edge : xarea->x;
+		}
+		xarea->width = right - xarea->x > 1 ? right - xarea->x : 1;
+		xarea->height = bottom - xarea->y > 1 ? bottom - xarea->y : 1;
+	}
+}
+
+/* Keys */
+
+static void
+write_switch(char state)
+{
+	char text[64];
+	int n = snprintf(text, sizeof(text), "%u %d %c\n", w.switch_session, w.switch_steps, state);
+	write_file("switch.tsv", text, n);
+}
+
+/*
+ * While XP's switch window is open no window has the keyboard (on X11 the
+ * WM grabs it): a lone Alt press and release would open a window's menu.
+ */
+static void
+begin_switch(bool reverse)
+{
+	w.switching = true;
+	w.switch_session++;
+	w.switch_steps = reverse ? -1 : 1;
+	w.switch_view = w.server->active_view;
+	seat_focus_surface(&w.server->seat, NULL);
+	write_switch('o');
+}
+
+static void
+end_switch(char state)
+{
+	write_switch(state);
+	w.switching = false;
+	struct view *view = w.switch_view;
+	w.switch_view = NULL;
+	if (view && view->mapped && !w.server->seat.seat->keyboard_state.focused_surface) {
+		desktop_focus_view(view, /*raise*/ false);
+	}
+}
+
+static void
+write_shell_keys(const char *kind)
+{
+	char text[256];
+	int n = snprintf(text, sizeof(text), "%u %s", ++w.shell_seq, kind);
+	for (int i = 0; i < w.combo_count && n < (int)sizeof(text) - 8; i++) {
+		n += snprintf(text + n, sizeof(text) - n, " %x", w.combo_keys[i]);
+	}
+	n += snprintf(text + n, sizeof(text) - n, "\n");
+	write_file("shellkeys.tsv", text, n);
+}
+
+/* The window with the keyboard, if it is a native one */
+static bool
+native_has_keyboard(void)
+{
+	struct wlr_surface *focused = w.server->seat.seat->keyboard_state.focused_surface;
+	struct view *view = w.server->active_view;
+	return focused && view && view->surface == focused && is_native(view);
+}
+
+/* Without the proxy, Alt+Tab goes through the windows directly */
+static void
+cycle(bool reverse)
+{
+	struct view **views = NULL, *view;
+	int count = 0, index = -1;
+	wl_list_for_each(view, &w.server->views, link) {
+		enum win4wine_kind kind = win4wine_kind(view);
+		if (view->mapped && (kind == WIN4WINE_NATIVE || kind == WIN4WINE_WINE)
+				&& view_is_focusable(view)) {
+			views = xrealloc(views, (count + 1) * sizeof(*views));
+			if (view == w.server->active_view) {
+				index = count;
+			}
+			views[count++] = view;
+		}
+	}
+	if (count) {
+		/* server->views is most recently focused first */
+		int next = reverse ? (index < 0 ? 0 : (index + count - 1) % count) : (index + 1) % count;
+		desktop_focus_view(views[next], /*raise*/ true);
+	}
+	free(views);
+}
+
+static int
+virtual_key(xkb_keysym_t sym)
+{
+	switch (sym) {
+	case XKB_KEY_Tab: return 0x09;
+	case XKB_KEY_Pause: case XKB_KEY_Break: return 0x13;
+	case XKB_KEY_space: return 0x20;
+	case XKB_KEY_Escape: return 0x1b;
+	case XKB_KEY_Return: return 0x0d;
+	case XKB_KEY_Left: return 0x25;
+	case XKB_KEY_Up: return 0x26;
+	case XKB_KEY_Right: return 0x27;
+	case XKB_KEY_Down: return 0x28;
+	}
+	if (sym >= XKB_KEY_a && sym <= XKB_KEY_z) {
+		return sym - XKB_KEY_a + 'A';
+	}
+	if (sym >= XKB_KEY_A && sym <= XKB_KEY_Z) {
+		return sym - XKB_KEY_A + 'A';
+	}
+	if (sym >= XKB_KEY_0 && sym <= XKB_KEY_9) {
+		return sym - XKB_KEY_0 + '0';
+	}
+	if (sym >= XKB_KEY_F1 && sym <= XKB_KEY_F24) {
+		return 0x70 + sym - XKB_KEY_F1;
+	}
+	return -1;
+}
+
+static bool
+has_sym(const xkb_keysym_t *syms, int nr_syms, xkb_keysym_t a, xkb_keysym_t b)
+{
+	for (int i = 0; i < nr_syms; i++) {
+		if (syms[i] == a || syms[i] == b) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+consumed_key(uint32_t keycode, bool remove)
+{
+	for (int i = 0; i < w.combo_keycode_count; i++) {
+		if (w.combo_keycodes[i] == keycode) {
+			if (remove) {
+				w.combo_keycodes[i] = w.combo_keycodes[--w.combo_keycode_count];
+			}
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+consume(uint32_t keycode)
+{
+	if (!consumed_key(keycode, false) && w.combo_keycode_count < 16) {
+		w.combo_keycodes[w.combo_keycode_count++] = keycode;
+	}
+	return true;
+}
+
+bool
+win4wine_key(struct server *server, uint32_t keycode, const xkb_keysym_t *syms,
+		int nr_syms, uint32_t modifiers, bool pressed)
+{
+	if (!w.ipc) {
+		return false;
+	}
+	bool alt_key = has_sym(syms, nr_syms, XKB_KEY_Alt_L, XKB_KEY_Alt_R);
+	bool super_key = has_sym(syms, nr_syms, XKB_KEY_Super_L, XKB_KEY_Super_R);
+	if (!pressed) {
+		if (w.switching && alt_key) {
+			/* Releasing Alt switches */
+			end_switch('c');
+		}
+		if (w.shell_combo && super_key) {
+			write_shell_keys("windows");
+			w.shell_combo = false;
+		}
+		/* The release of a consumed press is consumed too */
+		return consumed_key(keycode, true);
+	}
+
+	if (w.switching) {
+		if (has_sym(syms, nr_syms, XKB_KEY_Tab, XKB_KEY_ISO_Left_Tab)) {
+			w.switch_steps += (modifiers & WLR_MODIFIER_SHIFT) ? -1 : 1;
+			write_switch('o');
+			return consume(keycode);
+		}
+		if (has_sym(syms, nr_syms, XKB_KEY_Escape, XKB_KEY_Escape)) {
+			end_switch('x');
+			return consume(keycode);
+		}
+		return false;
+	}
+	if (w.shell_combo) {
+		/* The Windows key is held over a native window: XP's hotkeys */
+		if (!super_key && w.combo_count < 16) {
+			int vk = -1;
+			for (int i = 0; i < nr_syms && vk < 0; i++) {
+				vk = virtual_key(syms[i]);
+			}
+			if (vk >= 0) {
+				w.combo_keys[w.combo_count++] = vk;
+			}
+		}
+		return consume(keycode);
+	}
+
+	if ((modifiers & WLR_MODIFIER_ALT) && has_sym(syms, nr_syms, XKB_KEY_Tab, XKB_KEY_ISO_Left_Tab)) {
+		bool reverse = modifiers & WLR_MODIFIER_SHIFT;
+		if (!bridge_alive()) {
+			cycle(reverse);
+			return consume(keycode);
+		}
+		begin_switch(reverse);
+		return consume(keycode);
+	}
+	if (!native_has_keyboard()) {
+		/* Wine has these keys itself */
+		return false;
+	}
+	if (super_key) {
+		w.shell_combo = true;
+		w.combo_count = 0;
+		return consume(keycode);
+	}
+	if ((modifiers & WLR_MODIFIER_CTRL) && has_sym(syms, nr_syms, XKB_KEY_Escape, XKB_KEY_Escape)) {
+		w.combo_count = 0;
+		write_shell_keys("ctrl-escape");
+		return consume(keycode);
+	}
+	return false;
+}
+
+/* Setup */
+
+void
+win4wine_init(struct server *server)
+{
+	const char *ipc = getenv("WIN4WINE_IPC");
+	w.server = server;
+	wl_list_init(&w.requests);
+	wl_list_init(&w.shape_requests);
+	if (!ipc || !*ipc) {
+		return;
+	}
+	struct stat st;
+	if (stat(ipc, &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid() || (st.st_mode & 077)) {
+		wlr_log(WLR_ERROR, "win4wine: %s must be a directory of this user, mode 0700", ipc);
+		return;
+	}
+	w.ipc = xstrdup(ipc);
+	w.inotify_fd = inotify_init1(IN_NONBLOCK | IN_CLOEXEC);
+	if (w.inotify_fd >= 0 && inotify_add_watch(w.inotify_fd, w.ipc,
+			IN_CLOSE_WRITE | IN_MOVED_TO) >= 0) {
+		w.inotify_source = wl_event_loop_add_fd(server->wl_event_loop, w.inotify_fd,
+			WL_EVENT_READABLE, handle_inotify, NULL);
+	} else {
+		wlr_log_errno(WLR_ERROR, "win4wine: inotify");
+	}
+	wlr_log(WLR_INFO, "win4wine: bridge on %s", w.ipc);
+}
+
+void
+win4wine_finish(struct server *server)
+{
+	if (w.idle) {
+		wl_event_source_remove(w.idle);
+	}
+	if (w.inotify_source) {
+		wl_event_source_remove(w.inotify_source);
+	}
+	if (w.inotify_fd > 0) {
+		close(w.inotify_fd);
+	}
+	if (w.x_source) {
+		wl_event_source_remove(w.x_source);
+	}
+	struct request *request, *tmp;
+	wl_list_for_each_safe(request, tmp, &w.requests, link) {
+		wl_list_remove(&request->link);
+		free(request);
+	}
+	if (w.x) {
+		xcb_disconnect(w.x);
+	}
+	free(w.windows_text);
+	free(w.classes_text);
+	free(w.geometry_text);
+	free(w.tiled_text);
+	free(w.workareas);
+	free(w.ipc);
+	memset(&w, 0, sizeof(w));
+}
diff --git a/src/xwayland-scale.c b/src/xwayland-scale.c
new file mode 100644
index 0000000..5616153
--- /dev/null
+++ b/src/xwayland-scale.c
@@ -0,0 +1,566 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* win4wine: Xwayland clients at the outputs' own resolution (see xwayland-scale.h). */
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_output_layout.h>
+#include <wlr/types/wlr_scene.h>
+#include "common/macros.h"
+#include "common/mem.h"
+#include <wlr/util/log.h>
+#include <wlr/xwayland.h>
+#include "config.h"
+#include "labwc.h"
+#include "view.h"
+#include "xwayland.h"
+#include "xwayland-scale.h"
+#include "xdg-output-unstable-v1-protocol.h"
+
+struct xscale_output {
+	struct wl_list link;
+	struct wl_resource *resource;
+	struct wl_resource *output_resource;
+};
+
+static struct wl_global *manager_global;
+static struct wl_list xdg_outputs; /* struct xscale_output */
+
+static char *primary_name;
+
+static bool
+is_primary(struct output *output)
+{
+	return primary_name && !strcmp(output->wlr_output->name, primary_name);
+}
+
+/* Whether OTHER comes before OUTPUT in X space: the primary first, then from left to right */
+static bool
+comes_before(struct server *server, struct output *other, const struct wlr_box *obox,
+		struct output *output, const struct wlr_box *box)
+{
+	if (is_primary(other) != is_primary(output)) {
+		return is_primary(other);
+	}
+	return obox->x < box->x || (obox->x == box->x && other < output);
+}
+
+/* The output's rectangle in layout coordinates and in X space */
+static bool
+output_boxes(struct server *server, struct output *output, struct wlr_box *box, struct wlr_box *xbox)
+{
+	if (!output || !output->wlr_output->enabled) {
+		return false;
+	}
+	wlr_output_layout_get_box(server->output_layout, output->wlr_output, box);
+	if (wlr_box_empty(box)) {
+		return false;
+	}
+	int width, height;
+	wlr_output_transformed_resolution(output->wlr_output, &width, &height);
+	/*
+	 * Side by side in pixels. Win32's 0,0 is the top-left of the primary
+	 * monitor, and XP's desktop window starts at the top-left of the
+	 * virtual screen: the primary output comes first, so that XP's
+	 * desktop icons and wallpaper stay on it.
+	 */
+	int x = 0;
+	struct output *other;
+	wl_list_for_each(other, &server->outputs, link) {
+		struct wlr_box obox;
+		if (other == output || !other->wlr_output->enabled) {
+			continue;
+		}
+		wlr_output_layout_get_box(server->output_layout, other->wlr_output, &obox);
+		if (!wlr_box_empty(&obox) && comes_before(server, other, &obox, output, box)) {
+			int w, h;
+			wlr_output_transformed_resolution(other->wlr_output, &w, &h);
+			x += w;
+		}
+	}
+	*xbox = (struct wlr_box){x, 0, width, height};
+	return true;
+}
+
+bool
+xwayland_scale_primary(struct server *server, struct wlr_box *xbox, const char **name)
+{
+	struct output *output, *first = NULL;
+	wl_list_for_each(output, &server->outputs, link) {
+		struct wlr_box box, ob;
+		if (!output_boxes(server, output, &box, &ob)) {
+			continue;
+		}
+		if (ob.x == 0 && (!first || is_primary(output))) {
+			first = output;
+			*xbox = ob;
+		}
+	}
+	if (first && name) {
+		*name = first->wlr_output->name;
+	}
+	return first;
+}
+
+void
+xwayland_scale_set_primary(struct server *server, const char *name)
+{
+	if ((!name && !primary_name) || (name && primary_name && !strcmp(name, primary_name))) {
+		return;
+	}
+	free(primary_name);
+	primary_name = name ? xstrdup(name) : NULL;
+	xwayland_scale_update(server);
+}
+
+static struct output *
+output_for_xbox(struct server *server, const struct wlr_box *xbox, struct wlr_box *box, struct wlr_box *ob)
+{
+	int cx = xbox->x + xbox->width / 2, cy = xbox->y + xbox->height / 2;
+	struct output *output, *best = NULL;
+	long best_distance = -1;
+	wl_list_for_each(output, &server->outputs, link) {
+		struct wlr_box lbox, xb;
+		if (!output_boxes(server, output, &lbox, &xb)) {
+			continue;
+		}
+		long dx = cx < xb.x ? xb.x - cx : cx >= xb.x + xb.width ? cx - (xb.x + xb.width - 1) : 0;
+		long dy = cy < xb.y ? xb.y - cy : cy >= xb.y + xb.height ? cy - (xb.y + xb.height - 1) : 0;
+		long distance = dx * dx + dy * dy;
+		if (best_distance < 0 || distance < best_distance) {
+			best = output, best_distance = distance, *box = lbox, *ob = xb;
+		}
+	}
+	return best;
+}
+
+float
+xwayland_scale_for_xbox(struct server *server, const struct wlr_box *xbox)
+{
+	struct wlr_box box, ob;
+	struct output *output = output_for_xbox(server, xbox, &box, &ob);
+	return output ? output->wlr_output->scale : 1;
+}
+
+float
+xwayland_scale_for_box(struct server *server, const struct wlr_box *box)
+{
+	struct output *output = output_nearest_to(server,
+		box->x + box->width / 2, box->y + box->height / 2);
+	return output ? output->wlr_output->scale : 1;
+}
+
+void
+xwayland_scale_to_x(struct server *server, const struct wlr_box *box, struct wlr_box *xbox)
+{
+	struct output *output = output_nearest_to(server,
+		box->x + box->width / 2, box->y + box->height / 2);
+	struct wlr_box lbox, ob;
+	if (!output_boxes(server, output, &lbox, &ob)) {
+		*xbox = *box;
+		return;
+	}
+	float scale = output->wlr_output->scale;
+	xbox->x = ob.x + (int)lroundf((box->x - lbox.x) * scale);
+	xbox->y = ob.y + (int)lroundf((box->y - lbox.y) * scale);
+	xbox->width = (int)lroundf(box->width * scale);
+	xbox->height = (int)lroundf(box->height * scale);
+}
+
+/* An X window's part on one output, in X space and in layout coordinates */
+struct part {
+	struct wlr_box xbox, box;
+	struct output *output;      /* its pixels on this output start at px, py */
+	int px, py;
+	float scale;
+	double offset_x, offset_y; /* layout = offset + X / scale on this output */
+};
+
+static int
+window_parts(struct server *server, const struct wlr_box *xbox, struct part *parts)
+{
+	int count = 0;
+	struct output *output;
+	wl_list_for_each(output, &server->outputs, link) {
+		struct wlr_box lbox, ob, xpart;
+		if (count == XWAYLAND_MAX_SLICES || !output_boxes(server, output, &lbox, &ob)
+				|| !wlr_box_intersection(&xpart, xbox, &ob)) {
+			continue;
+		}
+		float scale = output->wlr_output->scale;
+		long x0 = lbox.x + lroundf((xpart.x - ob.x) / scale);
+		long y0 = lbox.y + lroundf((xpart.y - ob.y) / scale);
+		long x1 = lbox.x + lroundf((xpart.x + xpart.width - ob.x) / scale);
+		long y1 = lbox.y + lroundf((xpart.y + xpart.height - ob.y) / scale);
+		parts[count++] = (struct part){
+			.xbox = xpart,
+			.box = {x0, y0, x1 - x0, y1 - y0},
+			.output = output,
+			.px = xpart.x - ob.x,
+			.py = xpart.y - ob.y,
+			.scale = scale,
+			.offset_x = lbox.x - ob.x / scale,
+			.offset_y = lbox.y - ob.y / scale,
+		};
+	}
+	return count;
+}
+
+/* A window within one output, or off them: by the output nearest its centre */
+static bool
+whole_window(struct server *server, const struct wlr_box *xbox, struct part *part)
+{
+	struct wlr_box lbox, ob;
+	struct output *output = output_for_xbox(server, xbox, &lbox, &ob);
+	if (!output) {
+		*part = (struct part){.xbox = *xbox, .box = *xbox, .scale = 1};
+		return true;
+	}
+	float scale = output->wlr_output->scale;
+	part->xbox = *xbox;
+	part->output = output;
+	part->px = xbox->x - ob.x;
+	part->py = xbox->y - ob.y;
+	part->box.x = lbox.x + (int)lroundf((xbox->x - ob.x) / scale);
+	part->box.y = lbox.y + (int)lroundf((xbox->y - ob.y) / scale);
+	part->box.width = (int)lroundf(xbox->width / scale);
+	part->box.height = (int)lroundf(xbox->height / scale);
+	part->scale = scale;
+	return true;
+}
+
+/*
+ * One part for the whole window when its outputs show X space alike (the
+ * same scale, side by side as in X space); otherwise a part per output.
+ */
+static int
+layout_parts(struct server *server, const struct wlr_box *xbox, struct part *parts)
+{
+	int count = window_parts(server, xbox, parts);
+	bool mixed = false;
+	for (int i = 1; i < count; i++) {
+		mixed |= parts[i].scale != parts[0].scale
+			|| fabs(parts[i].offset_x - parts[0].offset_x) > 0.01
+			|| fabs(parts[i].offset_y - parts[0].offset_y) > 0.01;
+	}
+	if (!mixed) {
+		whole_window(server, xbox, &parts[0]);
+		return 1;
+	}
+	return count;
+}
+
+void
+xwayland_scale_from_x(struct server *server, const struct wlr_box *xbox, struct wlr_box *box)
+{
+	struct part parts[XWAYLAND_MAX_SLICES];
+	int count = layout_parts(server, xbox, parts);
+	*box = parts[0].box;
+	for (int i = 1; i < count; i++) {
+		int right = MAX(box->x + box->width, parts[i].box.x + parts[i].box.width);
+		int bottom = MAX(box->y + box->height, parts[i].box.y + parts[i].box.height);
+		box->x = MIN(box->x, parts[i].box.x);
+		box->y = MIN(box->y, parts[i].box.y);
+		box->width = right - box->x;
+		box->height = bottom - box->y;
+	}
+}
+
+void
+xwayland_scale_point_to_x(struct server *server, double lx, double ly, double *x, double *y)
+{
+	struct output *output = output_nearest_to(server, (int)lx, (int)ly);
+	struct wlr_box lbox, ob;
+	if (!output_boxes(server, output, &lbox, &ob)) {
+		*x = lx, *y = ly;
+		return;
+	}
+	float scale = output->wlr_output->scale;
+	*x = ob.x + (lx - lbox.x) * scale;
+	*y = ob.y + (ly - lbox.y) * scale;
+}
+
+static void
+handle_slice_destroy(struct wl_listener *listener, void *data)
+{
+	struct xwayland_slice *slice = wl_container_of(listener, slice, destroy);
+	wl_list_remove(&slice->destroy.link);
+	slice->scene_surface = NULL;
+}
+
+void
+xwayland_slices_clear(struct xwayland_slices *slices)
+{
+	for (int i = 0; i < slices->count; i++) {
+		struct xwayland_slice *slice = &slices->slice[i];
+		if (slice->scene_surface) {
+			struct wlr_scene_node *node = &slice->scene_surface->buffer->node;
+			handle_slice_destroy(&slice->destroy, NULL);
+			wlr_scene_node_destroy(node);
+		}
+	}
+	slices->count = 0;
+	slices->surface = NULL;
+}
+
+static struct server *the_server;
+
+/* Shaped X windows (xwayland_shape_set) */
+struct shape {
+	uint32_t window;
+	pixman_region32_t region;
+	struct wl_list link;
+};
+static struct wl_list shapes = {&shapes, &shapes};
+
+static struct shape *
+shape_of(uint32_t window)
+{
+	struct shape *shape;
+	wl_list_for_each(shape, &shapes, link) {
+		if (shape->window == window) {
+			return shape;
+		}
+	}
+	return NULL;
+}
+
+/* Show the slices of X window WINDOW only in its shape (its slices' surface may be gone) */
+static void
+apply_shape(struct xwayland_slices *slices, uint32_t window)
+{
+	struct shape *shape = window ? shape_of(window) : NULL;
+	for (int i = 0; i < slices->count; i++) {
+		if (slices->slice[i].scene_surface) {
+			wlr_scene_surface_set_shape(slices->slice[i].scene_surface,
+				shape ? &shape->region : NULL);
+		}
+	}
+}
+
+/* Apply WINDOW's shape again; false if no mapped window has that id */
+static bool
+reapply_shape(uint32_t window)
+{
+	bool mapped = false;
+	if (!the_server) {
+		return false;
+	}
+	struct view *view;
+	wl_list_for_each(view, &the_server->views, link) {
+		if (view->type == LAB_XWAYLAND_VIEW) {
+			struct xwayland_view *xview = wl_container_of(view, xview, base);
+			if (xview->xwayland_surface && xview->xwayland_surface->window_id == window) {
+				apply_shape(&xview->slices, window);
+				mapped |= view->mapped;
+			}
+		}
+	}
+	struct xwayland_unmanaged *unmanaged;
+	wl_list_for_each(unmanaged, &the_server->unmanaged_surfaces, link) {
+		if (unmanaged->xwayland_surface->window_id == window) {
+			apply_shape(&unmanaged->slices, window);
+			mapped = true;  /* listed while mapped */
+		}
+	}
+	return mapped;
+}
+
+void
+xwayland_shape_set(uint32_t window, const pixman_region32_t *region)
+{
+	struct shape *shape = shape_of(window);
+	if (!region) {
+		if (!shape) {
+			return;
+		}
+		xwayland_shape_forget(window);
+	} else {
+		if (!shape) {
+			shape = znew(*shape);
+			shape->window = window;
+			pixman_region32_init(&shape->region);
+			wl_list_insert(&shapes, &shape->link);
+		} else if (pixman_region32_equal(&shape->region, region)) {
+			return;
+		}
+		pixman_region32_copy(&shape->region, region);
+	}
+	/*
+	 * Only mapped windows keep their shape (it is asked for again when a
+	 * window maps): a shape notified while a window is hidden or after it
+	 * was destroyed would stay in the list.
+	 */
+	if (!reapply_shape(window) && region) {
+		xwayland_shape_forget(window);
+	}
+}
+
+void
+xwayland_shape_forget(uint32_t window)
+{
+	struct shape *shape = shape_of(window);
+	if (shape) {
+		wl_list_remove(&shape->link);
+		pixman_region32_fini(&shape->region);
+		free(shape);
+		reapply_shape(window);
+	}
+}
+
+void
+xwayland_slices_show(struct server *server, struct xwayland_slices *slices,
+		struct wlr_scene_tree *tree, struct wlr_surface *surface, const struct wlr_box *xbox,
+		int origin_x, int origin_y)
+{
+	struct part parts[XWAYLAND_MAX_SLICES];
+	int count = layout_parts(server, xbox, parts);
+	/* Slices of a destroyed surface are gone with it */
+	bool gone = false;
+	for (int i = 0; i < slices->count; i++) {
+		gone |= !slices->slice[i].scene_surface;
+	}
+	if (slices->surface != surface || gone) {
+		xwayland_slices_clear(slices);
+		slices->surface = surface;
+	}
+	while (slices->count > count) {
+		struct xwayland_slice *slice = &slices->slice[--slices->count];
+		struct wlr_scene_node *node = &slice->scene_surface->buffer->node;
+		handle_slice_destroy(&slice->destroy, NULL);
+		wlr_scene_node_destroy(node);
+	}
+	while (slices->count < count) {
+		struct xwayland_slice *slice = &slices->slice[slices->count];
+		slice->scene_surface = wlr_scene_surface_create(tree, surface);
+		if (!slice->scene_surface) {
+			break;
+		}
+		slice->destroy.notify = handle_slice_destroy;
+		wl_signal_add(&slice->scene_surface->buffer->node.events.destroy, &slice->destroy);
+		slices->count++;
+	}
+	for (int i = 0; i < slices->count; i++) {
+		struct wlr_scene_surface *scene_surface = slices->slice[i].scene_surface;
+		struct wlr_box crop = {0};
+		if (count > 1) {
+			crop = (struct wlr_box){parts[i].xbox.x - xbox->x, parts[i].xbox.y - xbox->y,
+				parts[i].xbox.width, parts[i].xbox.height};
+		}
+		wlr_scene_surface_set_dest_scale(scene_surface, parts[i].scale);
+		wlr_scene_surface_set_crop(scene_surface, &crop);
+		/* exact on a fractional scale, where the layout box is rounded */
+		wlr_scene_surface_set_output_pixels(scene_surface,
+			parts[i].output ? parts[i].output->wlr_output : NULL, parts[i].px, parts[i].py);
+		wlr_scene_node_set_position(&scene_surface->buffer->node,
+			parts[i].box.x - origin_x, parts[i].box.y - origin_y);
+	}
+	struct wlr_xwayland_surface *xsurface = wlr_xwayland_surface_try_from_wlr_surface(surface);
+	apply_shape(slices, xsurface ? xsurface->window_id : 0);
+}
+
+/* zxdg_output_manager_v1 for Xwayland: logical size and position in X space */
+
+
+static void
+send_details(struct xscale_output *xo)
+{
+	struct wlr_output *wlr_output = wlr_output_from_resource(xo->output_resource);
+	struct wlr_box box, xbox;
+	if (!wlr_output || !output_boxes(the_server, wlr_output->data, &box, &xbox)) {
+		return;
+	}
+	zxdg_output_v1_send_logical_position(xo->resource, xbox.x, xbox.y);
+	zxdg_output_v1_send_logical_size(xo->resource, xbox.width, xbox.height);
+	if (wl_resource_get_version(xo->resource) >= ZXDG_OUTPUT_V1_NAME_SINCE_VERSION) {
+		zxdg_output_v1_send_name(xo->resource, wlr_output->name);
+		if (wlr_output->description) {
+			zxdg_output_v1_send_description(xo->resource, wlr_output->description);
+		}
+	}
+	zxdg_output_v1_send_done(xo->resource);
+}
+
+static void
+handle_resource_destroy(struct wl_resource *resource)
+{
+	struct xscale_output *xo = wl_resource_get_user_data(resource);
+	if (xo) {
+		wl_list_remove(&xo->link);
+		free(xo);
+	}
+}
+
+static void
+handle_destroy_request(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static const struct zxdg_output_v1_interface xdg_output_impl = {
+	.destroy = handle_destroy_request,
+};
+
+static void
+handle_get_xdg_output(struct wl_client *client, struct wl_resource *resource,
+		uint32_t id, struct wl_resource *output_resource)
+{
+	struct wl_resource *xdg = wl_resource_create(client, &zxdg_output_v1_interface,
+		wl_resource_get_version(resource), id);
+	if (!xdg) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	struct xscale_output *xo = calloc(1, sizeof(*xo));
+	xo->resource = xdg;
+	xo->output_resource = output_resource;
+	wl_list_insert(&xdg_outputs, &xo->link);
+	wl_resource_set_implementation(xdg, &xdg_output_impl, xo, handle_resource_destroy);
+	send_details(xo);
+}
+
+static const struct zxdg_output_manager_v1_interface manager_impl = {
+	.destroy = handle_destroy_request,
+	.get_xdg_output = handle_get_xdg_output,
+};
+
+static void
+manager_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id)
+{
+	struct wl_resource *resource = wl_resource_create(client,
+		&zxdg_output_manager_v1_interface, version, id);
+	if (!resource) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	wl_resource_set_implementation(resource, &manager_impl, NULL, NULL);
+}
+
+void
+xwayland_scale_init(struct server *server)
+{
+	the_server = server;
+	wl_list_init(&xdg_outputs);
+	/* Version 2: done is sent per xdg_output, not through wl_output */
+	manager_global = wl_global_create(server->wl_display,
+		&zxdg_output_manager_v1_interface, 2, NULL, manager_bind);
+}
+
+bool
+xwayland_scale_is_global(struct wl_global *global)
+{
+	return global && global == manager_global;
+}
+
+void
+xwayland_scale_update(struct server *server)
+{
+	struct xscale_output *xo;
+	if (!manager_global) {
+		return;
+	}
+	wl_list_for_each(xo, &xdg_outputs, link) {
+		send_details(xo);
+	}
+}
