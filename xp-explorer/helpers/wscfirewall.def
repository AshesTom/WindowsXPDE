; HNetCfg.dll beside XP's Security Center service (wscfirewall.c).
LIBRARY HNetCfg.dll
EXPORTS
    IcfChangeNotificationCreate = IcfChangeNotificationCreate@8
    IcfChangeNotificationDestroy = IcfChangeNotificationDestroy@4
    IcfConnect = IcfConnect@4
    IcfDisconnect = IcfDisconnect@4
    IcfFreeAdapters = IcfFreeAdapters@4
    IcfGetAdapters = IcfGetAdapters@8
    IcfGetOperationalMode = IcfGetOperationalMode@12
    ServiceMain = ServiceMain@8
