From: Codex <codex@localhost>
Subject: [PATCH] ntdll: give Windows 7's DLLs Windows 7's comctl32 in the Windows 7 shell session

Purpose: give Windows 7's shell Windows 7's Common Controls 6 while every
other program keeps Wine's.
Windows 7 behavior: explorer.exe's manifest asks for Common Controls 6
(Microsoft.Windows.Common-Controls 6.0.0.0), which the loader takes from
its SxS assembly.
Wine before: the SxS redirection leads to Wine's own Common Controls 6
assembly. A prefix that put Windows 7's comctl32.dll in that assembly's
place broke Wine's programs: they load it with the builtin load order,
which then gave them Wine's version 5 comctl32 (Wine's Notepad took no
input and showed column 59057).
Change: with WIN4WINE_SHELL=win7, when the SxS redirection resolves
comctl32.dll in w7-explorer.exe (the name the shell has in the prefix)
and a comctl32.dll that is not a Wine builtin lies beside it, that file
is used (C:\w7\comctl32.dll, which the shell loads native). In other
programs, when the active activation context is the own manifest of a
DLL that is not a Wine builtin (Windows 7's shell32, explorerframe and
the others, which the session gives every program for Windows 7's file
dialogs), comctl32.dll resolves to C:\w7\comctl32.dll, or
C:\w7\wow64\comctl32.dll in 32-bit programs, if that is not a Wine
builtin. The program itself, and Wine's DLLs, keep the assembly's file,
also when they bring a comctl32.dll of their own.
Evidence: +loaddll shows C:\w7\comctl32.dll (native) in w7-explorer.exe
and Wine's assembly (builtin) in Notepad, which takes input again. In a
64-bit and a 32-bit program, IFileOpenDialog shows Windows 7's dialog
with its icons (Windows 7's shell32 with Wine's comctl32 drew no icons)
while the program's own controls stay Wine's.
Scope: only with WIN4WINE_SHELL=win7 and only comctl32.dll: in
w7-explorer.exe with a non-builtin copy beside it, elsewhere for
non-builtin DLLs' manifests with a non-builtin copy in C:\w7.
---
 dlls/ntdll/loader.c | 102 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 102 insertions(+)

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 5c32fb1..607a569 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3249,6 +3249,99 @@ done:
     return status;
 }
 
+/* whether PATH is a PE file that is not a Wine builtin */
+static BOOL native_pe_file( const WCHAR *path )
+{
+    static const char builtin_signature[] = "Wine builtin DLL";
+    UNICODE_STRING nt_name;
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    char header[0x40 + sizeof(builtin_signature)];
+    LARGE_INTEGER offset = {{ 0 }};
+    HANDLE file;
+    BOOL native = FALSE;
+
+    if (RtlDosPathNameToNtPathName_U_WithStatus( path, &nt_name, NULL, NULL )) return FALSE;
+    InitializeObjectAttributes( &attr, &nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (!NtOpenFile( &file, GENERIC_READ | SYNCHRONIZE, &attr, &io, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                     FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE ))
+    {
+        if (!NtReadFile( file, 0, NULL, NULL, &io, header, sizeof(header), &offset, NULL ) &&
+            io.Information == sizeof(header) && header[0] == 'M' && header[1] == 'Z')
+            native = memcmp( header + 0x40, builtin_signature, sizeof(builtin_signature) - 1 ) != 0;
+        NtClose( file );
+    }
+    RtlFreeUnicodeString( &nt_name );
+    return native;
+}
+
+/* whether the active activation context is that of a native (Windows) DLL's own manifest */
+static BOOL native_module_context(void)
+{
+    ACTIVATION_CONTEXT_DETAILED_INFORMATION *info;
+    struct _ACTIVATION_CONTEXT *context = NULL;
+    SIZE_T size = 0;
+    BOOL ret = FALSE;
+
+    if (RtlGetActiveActivationContext( &context ) || !context) return FALSE;
+    RtlQueryInformationActivationContext( 0, context, NULL, ActivationContextDetailedInformation, NULL, 0, &size );
+    if (size && (info = RtlAllocateHeap( GetProcessHeap(), 0, size )))
+    {
+        if (!RtlQueryInformationActivationContext( 0, context, NULL, ActivationContextDetailedInformation,
+                                                   info, size, NULL ) && info->lpRootManifestPath)
+        {
+            size_t len = wcslen( info->lpRootManifestPath );
+            ret = len > 4 && !wcsicmp( info->lpRootManifestPath + len - 4, L".dll" ) &&
+                  native_pe_file( info->lpRootManifestPath );
+        }
+        RtlFreeHeap( GetProcessHeap(), 0, info );
+    }
+    RtlReleaseActivationContext( context );
+    return ret;
+}
+
+/***********************************************************************
+ *	shell_comctl32
+ *
+ * Windows 7's shell (w7-explorer.exe) takes Windows 7's Common Controls 6
+ * from beside its executable (C:\w7\comctl32.dll), where its manifest's SxS
+ * redirection leads to Wine's own assembly. In other programs, Windows 7's
+ * DLLs (its shell32 and explorerframe in their file dialogs) take it from
+ * C:\w7 (C:\w7\wow64 for 32-bit programs) when they ask for it in their own
+ * manifest's context; the programs themselves keep Wine's assembly. A copy
+ * there that is a Wine builtin is not used.
+ */
+static WCHAR *shell_comctl32(void)
+{
+    const UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    WCHAR *path;
+    unsigned int dir;
+    BOOL shell;
+
+    if (win4wine_shell() != WIN4WINE_SHELL_WIN7 || !image->Buffer) return NULL;
+    for (dir = image->Length / sizeof(WCHAR); dir && image->Buffer[dir - 1] != '\\'; dir--);
+    shell = image->Length / sizeof(WCHAR) - dir == 15 && !wcsnicmp( image->Buffer + dir, L"w7-explorer.exe", 15 );
+    if (shell)
+    {
+        if (!dir || !(path = RtlAllocateHeap( GetProcessHeap(), 0, (dir + 13) * sizeof(WCHAR) ))) return NULL;
+        memcpy( path, image->Buffer, dir * sizeof(WCHAR) );
+        wcscpy( path + dir, L"comctl32.dll" );
+    }
+    else if (native_module_context())
+    {
+        /* A Windows 7 DLL that another program loaded (the shell's DLLs in its file
+         * dialogs) binds to Windows 7's Common Controls 6, the program to Wine's. */
+        static const WCHAR native64[] = L"C:\\w7\\comctl32.dll", native32[] = L"C:\\w7\\wow64\\comctl32.dll";
+        const WCHAR *native = sizeof(void *) == 8 ? native64 : native32;
+        if (!(path = RtlAllocateHeap( GetProcessHeap(), 0, (wcslen( native ) + 1) * sizeof(WCHAR) ))) return NULL;
+        wcscpy( path, native );
+    }
+    else return NULL;
+    if (native_pe_file( path )) return path;
+    RtlFreeHeap( GetProcessHeap(), 0, path );
+    return NULL;
+}
+
 /***********************************************************************
  *	find_dll_file
  *
@@ -3275,6 +3368,15 @@ static NTSTATUS find_dll_file( const WCHAR *load_path, const WCHAR *libname, UNI
         {
             status = find_actctx_dll( libname, &fullname );
             if (status == STATUS_SUCCESS) *redirected = TRUE;
+            if (status == STATUS_SUCCESS && !wcsicmp( libname, L"comctl32.dll" ))
+            {
+                WCHAR *shell = shell_comctl32();
+                if (shell)
+                {
+                    RtlFreeHeap( GetProcessHeap(), 0, fullname );
+                    fullname = shell;
+                }
+            }
         }
 
         if (status == STATUS_SUCCESS)
