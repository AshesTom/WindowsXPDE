From: Codex <codex@localhost>
Subject: [PATCH] user32, uxtheme: show and track the caption help button in the external shell

Purpose: give XP dialogs such as Run their "?" caption button.
XP behavior: a DS_CONTEXTHELP dialog gets WS_EX_CONTEXTHELP, which shows a help
button left of the close button when there are no minimize or maximize
boxes; clicking it enters context help mode: a help cursor until the next
click, which sends WM_HELP to the control under it, or Escape.
Wine before: set neither the style nor drew, tracked or handled the button.
Change: add the extended style, draw Luna's help button in the maximize
button's place, report HTHELP, hot-track and press it, and enter the context
help mode of SC_CONTEXTHELP on release. Showing the help text is left to the
application's WinHelp call.
Evidence: the button's pixels equal the reference XP machine's, apart from
the rounding of its alpha corners shared with the close button.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0067.
---
 dlls/user32/defwnd.c  | 86 ++++++++++++++++++++++++++++++++++++++++++++++++++-
 dlls/user32/dialog.c  |  5 +++
 dlls/uxtheme/window.c | 14 ++++++++-
 3 files changed, 103 insertions(+), 2 deletions(-)

diff --git a/dlls/user32/defwnd.c b/dlls/user32/defwnd.c
index 92ecf6d..6b7bb39 100644
--- a/dlls/user32/defwnd.c
+++ b/dlls/user32/defwnd.c
@@ -143,7 +143,7 @@ static void external_shell_nonclient_mouse( HWND hwnd, UINT msg )
     {
         GetCursorPos(&point);
         hit = SendMessageW(hwnd, WM_NCHITTEST, 0, MAKELPARAM(point.x, point.y));
-        if (hit != HTCLOSE && hit != HTMINBUTTON && hit != HTMAXBUTTON) hit = 0;
+        if (hit != HTCLOSE && hit != HTMINBUTTON && hit != HTMAXBUTTON && hit != HTHELP) hit = 0;
         NtUserTrackMouseEvent(&track);
     }
     if (hit != previous)
@@ -154,6 +154,84 @@ static void external_shell_nonclient_mouse( HWND hwnd, UINT msg )
     }
 }
 
+/* The caption's help button: track the press like the other caption buttons,
+ * then enter XP's context help mode, where the next click on a control sends
+ * it WM_HELP. Wine's default window procedure has neither. */
+static void external_shell_track_help( HWND hwnd )
+{
+    BOOL pressed = TRUE, previous;
+    MSG msg = {0};
+
+    if (!win4wine_external_shell()) return;
+    NtUserSetCapture( hwnd );
+    external_shell_draw_nonclient( hwnd, NULL );
+    for (;;)
+    {
+        if (!GetMessageW( &msg, 0, WM_MOUSEFIRST, WM_MOUSELAST )) break;
+        if (NtUserCallMsgFilter( &msg, MSGF_MAX )) continue;
+        if (msg.message == WM_LBUTTONUP) break;
+        if (msg.message != WM_MOUSEMOVE) continue;
+        previous = pressed;
+        pressed = SendMessageW( hwnd, WM_NCHITTEST, 0, MAKELPARAM( msg.pt.x, msg.pt.y ) ) == HTHELP;
+        if (pressed != previous) external_shell_draw_nonclient( hwnd, NULL );
+    }
+    NtUserReleaseCapture();
+    external_shell_draw_nonclient( hwnd, NULL );
+    if (pressed) SendMessageW( hwnd, WM_SYSCOMMAND, SC_CONTEXTHELP, MAKELPARAM( msg.pt.x, msg.pt.y ) );
+}
+
+static void external_shell_context_help( HWND hwnd )
+{
+    HCURSOR cursor = LoadCursorW( 0, (LPCWSTR)IDC_HELP );
+    MSG msg;
+
+    if (!win4wine_external_shell()) return;
+    NtUserSetCapture( hwnd );
+    NtUserSetCursor( cursor );
+    while (GetCapture() == hwnd)
+    {
+        if (!GetMessageW( &msg, 0, 0, 0 ))
+        {
+            NtUserPostQuitMessage( msg.wParam );
+            break;
+        }
+        if (msg.message == WM_KEYDOWN || msg.message == WM_SYSKEYDOWN)
+        {
+            if (msg.wParam == VK_ESCAPE) break;
+            continue;
+        }
+        if (msg.message == WM_LBUTTONDOWN || msg.message == WM_NCLBUTTONDOWN)
+        {
+            HWND child = hwnd, next;
+            POINT point = msg.pt;
+            HELPINFO info = {sizeof(info)};
+
+            NtUserReleaseCapture();
+            if (WindowFromPoint( msg.pt ) != hwnd && !IsChild( hwnd, WindowFromPoint( msg.pt ) )) return;
+            for (;;)
+            {
+                POINT client = point;
+                ScreenToClient( child, &client );
+                next = ChildWindowFromPointEx( child, client, CWP_SKIPINVISIBLE );
+                if (!next || next == child) break;
+                child = next;
+            }
+            info.iContextType = HELPINFO_WINDOW;
+            info.iCtrlId = GetDlgCtrlID( child );
+            info.hItemHandle = child;
+            info.dwContextId = NtUserGetWindowContextHelpId( child );
+            info.MousePos = point;
+            SendMessageW( child, WM_HELP, 0, (LPARAM)&info );
+            return;
+        }
+        if (msg.message >= WM_MOUSEFIRST && msg.message <= WM_MOUSELAST) { NtUserSetCursor( cursor ); continue; }
+        if (msg.message >= WM_NCMOUSEMOVE && msg.message <= WM_NCMBUTTONDBLCLK) { NtUserSetCursor( cursor ); continue; }
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+    if (GetCapture() == hwnd) NtUserReleaseCapture();
+}
+
 /* XP captures the Start panel through WM_PRINT before its show animation.
  * The win32u default only prints the parent; include visible descendants in
  * the caller's DC for the explicitly selected external shell. */
@@ -259,6 +337,12 @@ static LRESULT external_shell_defwnd( HWND hwnd, UINT msg, WPARAM wparam, LPARAM
         break;
     case WM_NCHITTEST:
         return external_shell_nonclient_hit( hwnd, lparam, result );
+    case WM_NCLBUTTONDOWN:
+        if (wparam == HTHELP) external_shell_track_help( hwnd );
+        break;
+    case WM_SYSCOMMAND:
+        if ((wparam & 0xfff0) == SC_CONTEXTHELP) external_shell_context_help( hwnd );
+        break;
     case WM_NCMOUSEMOVE:
     case WM_NCMOUSELEAVE:
         external_shell_nonclient_mouse( hwnd, msg );
diff --git a/dlls/user32/dialog.c b/dlls/user32/dialog.c
index ad530d7..4e4a682 100644
--- a/dlls/user32/dialog.c
+++ b/dlls/user32/dialog.c
@@ -27,6 +27,7 @@
 #include "user_private.h"
 #include "controls.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dialog);
 
@@ -524,6 +525,10 @@ static HWND DIALOG_CreateIndirect( HINSTANCE hInst, LPCVOID dlgTemplate,
         template.exStyle |= WS_EX_DLGMODALFRAME;
     if ((template.style & DS_CONTROL) || !(template.style & WS_CHILD))
         template.exStyle |= WS_EX_CONTROLPARENT;
+    /* Windows gives a DS_CONTEXTHELP dialog the extended style that shows the
+     * caption's help button; the opted-in external shell draws that button. */
+    if ((template.style & DS_CONTEXTHELP) && win4wine_external_shell())
+        template.exStyle |= WS_EX_CONTEXTHELP;
     AdjustWindowRectEx( &rect, template.style, (hMenu != 0), template.exStyle );
     pos.x = rect.left;
     pos.y = rect.top;
diff --git a/dlls/uxtheme/window.c b/dlls/uxtheme/window.c
index 2385d9a..068b050 100644
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -353,10 +353,13 @@ LRESULT WINAPI Win4WineNcHitTest(HWND hwnd, LPARAM coordinates, LRESULT original
     buttons[2].left -= margin;
     buttons[0].top = buttons[1].top = buttons[2].top = border_y;
     buttons[0].bottom = buttons[1].bottom = buttons[2].bottom = caption.bottom;
-    left = style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX) ? buttons[2].left : buttons[0].left;
+    left = style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX) ? buttons[2].left
+        : exstyle & WS_EX_CONTEXTHELP ? buttons[1].left : buttons[0].left;
     if (point.x < left || point.x >= window.right - window.left - border_x
         || point.y < border_y || point.y >= border_y + GetSystemMetrics(SM_CYCAPTION)) return original;
     if (PtInRect(&buttons[0], point)) return HTCLOSE;
+    if (!(style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) && (exstyle & WS_EX_CONTEXTHELP))
+        return PtInRect(&buttons[1], point) ? HTHELP : HTCAPTION;
     if (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX))
     {
         if ((style & WS_MAXIMIZEBOX) && PtInRect(&buttons[1], point)) return HTMAXBUTTON;
@@ -506,6 +509,15 @@ BOOL WINAPI Win4WineDrawNonClient(HWND hwnd, HDC target)
             DrawThemeBackground(theme, dc, WP_MINBUTTON, button_state, &part, NULL);
             text.right = part.left - 2;
         }
+        else if (exstyle & WS_EX_CONTEXTHELP)
+        {
+            /* XP puts the help button in the maximize button's place. */
+            part = buttons[1];
+            button_state = hit == HTHELP ? (GetKeyState(VK_LBUTTON) < 0 ? HBS_PUSHED : HBS_HOT) : HBS_NORMAL;
+            button_state = caption_button_state(hwnd, theme, WP_HELPBUTTON, button_state);
+            DrawThemeBackground(theme, dc, WP_HELPBUTTON, button_state, &part, NULL);
+            text.right = part.left - 2;
+        }
     }
     /* The caption font of SPI_GETNONCLIENTMETRICS, which applying the theme
      * set: above 96 DPI the theme's point size converted again would be a
