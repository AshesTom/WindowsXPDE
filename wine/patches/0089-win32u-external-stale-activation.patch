From: Codex <codex@localhost>
Subject: [PATCH] win32u: a window that is no longer the foreground window is not activated late

Purpose: a window shown and made the foreground window right after a
click on the taskbar stays active (Windows 7's jump list, XP's Start menu
under the Wayland session).
Windows behavior: the foreground window is the one last made so; a window
activated by an earlier change does not take it back.
Wine before: when a thread makes a window of another thread the
foreground window, it sends that thread WM_WINE_SETACTIVEWINDOW, which
activates the window when the thread gets to the message. A click on the
taskbar under the Wayland session's compositor made the taskbar the
window manager's active window; Notepad's thread followed it and sent
the taskbar's thread the message, which the shell's thread, busy showing
the jump list (or the Start menu), handled only after it had made the
jump list the foreground window: the taskbar was activated again, and
the jump list, deactivated, stayed black (the Start menu closed).
Change: in win4wine's sessions the message carries the time it was sent,
and a thread records when it last made one of its own windows the
foreground window; the message does nothing when the thread did so after
it was sent. (The foreground window alone cannot tell: until the thread
handles the message, GetForegroundWindow is still its earlier active
window, so comparing with it stopped every activation from another
thread, as of Notepad from the window manager in the XP shell's X11
session.)
Evidence: right-clicking a taskbar button after the desktop's and the
taskbar's context menus opened a black jump list in 3 of 4 fresh nested
sessions; with the change 4 of 4 showed it. The XP shell's Start menu
stays open with a folder window open (3 of 3; it closed every time) and
over other windows. The XP and ReactOS X11 scenes are unchanged.
Scope: win4wine's sessions (win4wine_external_shell).
---
 dlls/win32u/input.c          |  8 +++++++-
 dlls/win32u/message.c        | 12 +++++++++++-
 dlls/win32u/ntuser_private.h |  1 +
 3 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index 66c010c..e4741c9 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -37,6 +37,7 @@
 #include "wine/server.h"
 #include "wine/debug.h"
 #include "kbd.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
 WINE_DECLARE_DEBUG_CHANNEL(keyboard);
@@ -2303,11 +2304,16 @@ BOOL set_foreground_window( HWND hwnd, BOOL mouse, BOOL internal )
         else if (send_msg_new)  /* old window belongs to us but new one to other thread */
             ret = set_active_window( 0, NULL, mouse, TRUE, new_thread_id );
 
+        /* win4wine: the message carries when it was sent (see WM_WINE_SETACTIVEWINDOW) */
         if (send_msg_new)  /* new window belongs to other thread */
-            NtUserMessageCall( hwnd, WM_WINE_SETACTIVEWINDOW, (WPARAM)hwnd, 0,
+            NtUserMessageCall( hwnd, WM_WINE_SETACTIVEWINDOW, (WPARAM)hwnd,
+                               win4wine_external_shell() ? NtGetTickCount() | 1 : 0,
                                0, NtUserSendNotifyMessage, FALSE );
         else  /* new window belongs to us */
+        {
             ret = set_active_window( hwnd, NULL, mouse, TRUE, 0 );
+            get_user_thread_info()->foreground_time = NtGetTickCount() | 1;
+        }
     }
     return ret;
 }
diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index d34c965..16779fc 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2211,7 +2211,17 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
         HWND prev;
 
         if (!wparam && NtUserGetForegroundWindow() == hwnd) return 0;
-        if (!set_active_window( (HWND)wparam, &prev, FALSE, TRUE, lparam )) return 0;
+        /* win4wine: another thread made the window the foreground window (at the time in
+         * lparam), but this thread got to the message only after it had made one of its
+         * own windows the foreground window (as Windows 7's jump list, shown meanwhile);
+         * activating the window now would deactivate that newer one. */
+        if (wparam && lparam && win4wine_external_shell() &&
+            (int)(get_user_thread_info()->foreground_time - (DWORD)lparam) > 0)
+        {
+            TRACE( "%p: the thread made another window the foreground window since\n", (HWND)wparam );
+            return 0;
+        }
+        if (!set_active_window( (HWND)wparam, &prev, FALSE, TRUE, wparam ? 0 : lparam )) return 0;
         return (LRESULT)prev;
     }
     case WM_WINE_KEYBOARD_LL_HOOK:
diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
index 77480ae..b05f7ab 100644
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -128,6 +128,7 @@ struct user_thread_info
     DWORD                         clipping_reset;         /* time when clipping was last reset */
     struct session_thread_data   *session_data;           /* shared session thread data */
     struct mouse_tracking_info   *mouse_tracking_info;    /* NtUserTrackMouseEvent handling */
+    DWORD                         foreground_time;        /* win4wine: when the thread last made one of its windows the foreground window */
 };
 
 C_ASSERT( sizeof(struct user_thread_info) <= sizeof(((TEB *)0)->Win32ClientInfo) );
