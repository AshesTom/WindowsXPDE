From: Win4Wine contributors
Subject: [PATCH] uxtheme: honor measured Japanese Luna task text profile

Public XP APIs report MS UI Gothic at -12 for TaskBand::Toolbar, while
Wine selects Tahoma at -11. The actual Explorer task text uses part zero
and normal/checked states; owned public draws reproduce the same difference.
Use the explicit, validated registry profile for those class/state queries.
Keep stock/control fonts and unprofiled callers unchanged.

--- a/dlls/uxtheme/font-profile.c
+++ b/dlls/uxtheme/font-profile.c
@@ -133,6 +133,10 @@
     if (!lstrcmpiW(cls->szAppName, L"TrayNotify") && !lstrcmpiW(cls->szClassName, L"Clock")
         && part == CLP_TIME && state == CLS_NORMAL)
         return profile_font(cls->tf, dc, L"ClockFont", font);
+    if (!lstrcmpiW(cls->szAppName, L"TaskBand") && !lstrcmpiW(cls->szClassName, L"Toolbar")
+        && ((!part && state >= 0 && state <= TS_OTHERSIDEHOT)
+            || (part == TP_BUTTON && state >= TS_NORMAL && state <= TS_OTHERSIDEHOT)))
+        return profile_font(cls->tf, dc, L"TaskFont", font);
     return FALSE;
 }
 
