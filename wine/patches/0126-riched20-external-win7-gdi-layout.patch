From: Codex <codex@localhost>
Subject: [PATCH] riched20: Windows 7's search boxes: the host's font, laid out with GDI

Purpose: show Japanese and Latin text in Windows 7's search boxes (the
Start menu's and the folder windows'), windowless rich edit controls, in
the font Windows 7 shows.
Windows behavior: the search box's host gives its font (Meiryo, 9 point)
after creating the text services, with TXTBIT_CHARFORMATCHANGE. Rich edit
binds fonts: Latin text in the face, Japanese text in a font that has it
(rewidth.exe's control in Segoe UI places the characters after "A" at
9, 21, 33, 44 and 55).
Wine before: the change of the host's character format was ignored, and
the text kept the default font (System, 10 point). Every paragraph was
laid out with Uniscribe's glyphs, which are the font's own (ScriptShape
does not link fonts): Japanese text in Segoe UI was drawn as boxes, 8
pixels apart, and in the search boxes it overlapped. A font asked for
with the system's charset (Shift-JIS) took a Japanese face for the Latin
text too.
Change: with an external shell, TXTBIT_CHARFORMATCHANGE reads the host's
character format as the default. In the Windows 7 shell, a paragraph
without complex scripts (the paragraph mark aside, a control character
for Uniscribe) is measured and drawn with GDI, as one with a password
character is, and fonts are made with DEFAULT_CHARSET (but the symbol
charset): the face draws its own characters and GDI links the fonts for
the others.
Evidence: rewidth.exe on Windows 7 SP1 (Japanese, 96 dpi): Segoe UI 1 9
21 33 44 55 59 67 73, Meiryo UI 1 9 21 33 43 53 57 65 72; in the session
Segoe UI 1 9 21 33 45 57 60 68 75 (GDI's linked font for the kana),
Meiryo UI the same. The Start menu's search box with "kouho Ag" typed: the
same pixels as Windows 7 apart from ClearType's colours; the Japanese
glyphs match bindw.exe's Meiryo -12 on Windows 7.
Scope: the host's format with external shells (WIN4WINE_EXTERNAL_SHELL),
the rest in the Windows 7 shell (WIN4WINE_SHELL=win7).
---
 dlls/riched20/style.c  |  7 +++++++
 dlls/riched20/txtsrv.c | 19 +++++++++++++++++++
 dlls/riched20/wrap.c   | 21 ++++++++++++++++++---
 3 files changed, 44 insertions(+), 3 deletions(-)

diff --git a/dlls/riched20/style.c b/dlls/riched20/style.c
index 8102ec6..eff8f83 100644
--- a/dlls/riched20/style.c
+++ b/dlls/riched20/style.c
@@ -19,6 +19,7 @@
  */
 
 #include "editor.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(richedit);
 WINE_DECLARE_DEBUG_CHANNEL(richedit_style);
@@ -326,6 +327,12 @@ ME_LogFontFromStyle(ME_Context* c, LOGFONTW *lf, const ME_Style *s)
     lf->lfPitchAndFamily = s->fmt.bPitchAndFamily;
   if (s->fmt.dwMask & CFM_CHARSET)
     lf->lfCharSet = s->fmt.bCharSet;
+  /* In the Windows 7 shell, the face is used for its own characters and GDI
+   * links fonts for the others (Japanese text in Segoe UI takes Meiryo), as
+   * Windows' rich edit binds fonts: the system's charset asked for a Japanese
+   * face for the whole text. */
+  if (win4wine_shell() == WIN4WINE_SHELL_WIN7 && lf->lfCharSet != SYMBOL_CHARSET)
+    lf->lfCharSet = DEFAULT_CHARSET;
 }
 
 void ME_CharFormatFromLogFont(HDC hDC, const LOGFONTW *lf, CHARFORMAT2W *fmt)
diff --git a/dlls/riched20/txtsrv.c b/dlls/riched20/txtsrv.c
index 5c63b3d..834cecf 100644
--- a/dlls/riched20/txtsrv.c
+++ b/dlls/riched20/txtsrv.c
@@ -29,6 +29,7 @@
 #include "textserv.h"
 #include "wine/debug.h"
 #include "editstr.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(richedit);
 
@@ -459,6 +460,24 @@ HRESULT __thiscall fnTextSrv_OnTxPropertyBitsChange( ITextServices *iface, DWORD
         if (SUCCEEDED( hr )) repaint = TRUE;
     }
 
+    /* win4wine: the host's new default character format (Windows 7's search
+     * boxes give theirs, Segoe UI, after creating the services). */
+    if ((mask & TXTBIT_CHARFORMATCHANGE) && win4wine_external_shell())
+    {
+        const CHARFORMATW *host_cf;
+
+        if (ITextHost_TxGetCharFormat( services->editor->texthost, &host_cf ) == S_OK)
+        {
+            CHARFORMAT2W cf = { sizeof(cf) };
+
+            if (cfany_to_cf2w( &cf, (CHARFORMAT2W *)host_cf ))
+            {
+                ME_SetDefaultCharFormat( services->editor, &cf );
+                repaint = TRUE;
+            }
+        }
+    }
+
     if (mask & TXTBIT_USEPASSWORD)
     {
         if (bits & TXTBIT_USEPASSWORD) ITextHost_TxGetPasswordChar( services->editor->texthost, &services->editor->password_char );
diff --git a/dlls/riched20/wrap.c b/dlls/riched20/wrap.c
index a4d638a..6a56e77 100644
--- a/dlls/riched20/wrap.c
+++ b/dlls/riched20/wrap.c
@@ -21,6 +21,7 @@
 
 
 #include "editor.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(richedit);
 
@@ -814,6 +815,22 @@ static HRESULT shape_para( ME_Context *c, ME_Paragraph *para )
     return hr;
 }
 
+/* Whether to lay out the paragraph's runs with Uniscribe's glyphs. These are
+ * the font's own, without font linking: Japanese text in a Latin font, such
+ * as Windows 7's search boxes in Segoe UI, was drawn as boxes or overlapped.
+ * In the Windows 7 shell, text without complex scripts is measured and drawn
+ * with GDI, which links fonts. */
+static BOOL shape_paragraph( ME_Context *c, ME_Paragraph *para )
+{
+    int len = para->text->nLen;
+
+    if (c->editor->password_char) return FALSE;
+    if (win4wine_shell() != WIN4WINE_SHELL_WIN7) return TRUE;
+    /* The paragraph's end (a control character, complex for Uniscribe) */
+    while (len && (para->text->szData[len - 1] == '\r' || para->text->szData[len - 1] == '\n')) len--;
+    return ScriptIsComplex( para->text->szData, len, SIC_COMPLEX ) == S_OK;
+}
+
 static void ME_WrapTextParagraph( ME_TextEditor *editor, ME_Context *c, ME_Paragraph *para )
 {
   ME_Run *run;
@@ -828,9 +845,7 @@ static void ME_WrapTextParagraph( ME_TextEditor *editor, ME_Context *c, ME_Parag
   /* Calculate paragraph numbering label */
   para_num_init( c, para );
 
-  /* For now treating all non-password text as complex for better testing */
-  if (!c->editor->password_char /* &&
-      ScriptIsComplex( tp->member.para.text->szData, tp->member.para.text->nLen, SIC_COMPLEX ) == S_OK */)
+  if (shape_paragraph( c, para ))
   {
       if (SUCCEEDED( itemize_para( c, para ) ))
           shape_para( c, para );
