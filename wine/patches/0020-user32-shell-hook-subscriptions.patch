From: Codex <codex@localhost>
Subject: [PATCH] user32: store shell hook subscriptions for the companion proxy

Purpose: make RegisterShellHookWindow subscriptions visible to the bridge
proxy.
XP behavior: taskbars receive SHELLHOOK messages about application windows.
Change: RegisterShellHookWindow and DeregisterShellHookWindow set and remove
a Win4WineShellHook property. The proxy sends the create, destroy,
activate and redraw notifications when WinEvents or its IPC files report
a change; this is not a complete implementation of shell hooks.
Scope: every Wine application (the functions were stubs that failed);
without the proxy nothing is sent.
Old patches: 0002.
---
 dlls/user32/misc.c | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/dlls/user32/misc.c b/dlls/user32/misc.c
index 7805333..feb79ae 100644
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -243,8 +243,12 @@ void WINAPI RegisterSystemThread(DWORD flags, DWORD reserved)
  */
 BOOL WINAPI RegisterShellHookWindow(HWND hWnd)
 {
-    FIXME("(%p): stub\n", hWnd);
-    return FALSE;
+    if (!IsWindow(hWnd))
+    {
+        SetLastError(ERROR_INVALID_WINDOW_HANDLE);
+        return FALSE;
+    }
+    return SetPropW(hWnd, L"Win4WineShellHook", (HANDLE)1);
 }
 
 
@@ -253,8 +257,12 @@ BOOL WINAPI RegisterShellHookWindow(HWND hWnd)
  */
 BOOL WINAPI DeregisterShellHookWindow(HWND hWnd)
 {
-    FIXME("(%p): stub\n", hWnd);
-    return FALSE;
+    if (!IsWindow(hWnd))
+    {
+        SetLastError(ERROR_INVALID_WINDOW_HANDLE);
+        return FALSE;
+    }
+    return RemovePropW(hWnd, L"Win4WineShellHook") != NULL;
 }
 
 
