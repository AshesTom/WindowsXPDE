From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: SetWindowThemeAttribute's caption options

Purpose: draw Windows 7's folder windows without a caption text and icon,
as Windows 7 does.
Windows behavior: SetWindowThemeAttribute(hwnd, WTA_NONCLIENT,
&WTA_OPTIONS, sizeof(WTA_OPTIONS)) sets, for the bits in dwMask, the
window's WTNCA_NODRAWCAPTION, WTNCA_NODRAWICON, WTNCA_NOSYSMENU and
WTNCA_NOMIRRORHELP options; the themed frame then leaves out the caption
text and the icon. Other types and sizes, or mask bits outside
WTNCA_VALIDBITS, are E_INVALIDARG. Windows 7's explorer calls it once for
each folder window (CabinetWClass): its address bar shows the location,
and the caption is empty.
Wine before: the function was a stub (E_NOTIMPL), and the frame showed
the window text and its icon.
Change: the options are kept in a window property and the frame is
redrawn; the external shell's themed frame (0058) leaves out the text
with WTNCA_NODRAWCAPTION and the icon with WTNCA_NODRAWICON. uxtheme.h
gets WTA_OPTIONS and the WTNCA_* flags.
Evidence: Windows 7 SP1 x64 explorer.exe calls it with 8 bytes for its
folder window; with the change its caption is empty when active and
inactive, and the caption buttons follow the activation.
Scope: windows that call SetWindowThemeAttribute; the frame drawing only
with WIN4WINE_EXTERNAL_SHELL.
---
 dlls/uxtheme/system.c | 18 ++++++++++++++++--
 dlls/uxtheme/window.c |  7 ++++++-
 include/uxtheme.h     | 12 ++++++++++++
 3 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
index 4eb7f9b..b5e2192 100644
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -749,8 +749,22 @@ HRESULT WINAPI SetWindowTheme(HWND hwnd, LPCWSTR pszSubAppName,
 HRESULT WINAPI SetWindowThemeAttribute(HWND hwnd, enum WINDOWTHEMEATTRIBUTETYPE type,
                                        PVOID attribute, DWORD size)
 {
-   FIXME("(%p,%d,%p,%ld): stub\n", hwnd, type, attribute, size);
-   return E_NOTIMPL;
+    const WTA_OPTIONS *options = attribute;
+    DWORD flags;
+
+    TRACE("(%p,%d,%p,%ld)\n", hwnd, type, attribute, size);
+
+    if (type != WTA_NONCLIENT || !options || size != sizeof(*options) ||
+        (options->dwMask & ~WTNCA_VALIDBITS))
+        return E_INVALIDARG;
+    if (!IsWindow(hwnd)) return E_HANDLE;
+
+    flags = (DWORD)(DWORD_PTR)GetPropW(hwnd, L"Win4WineNonClientOptions");
+    flags = (flags & ~options->dwMask) | (options->dwFlags & options->dwMask);
+    if (flags) SetPropW(hwnd, L"Win4WineNonClientOptions", (HANDLE)(DWORD_PTR)flags);
+    else RemovePropW(hwnd, L"Win4WineNonClientOptions");
+    RedrawWindow(hwnd, NULL, 0, RDW_FRAME | RDW_INVALIDATE);
+    return S_OK;
 }
 
 /***********************************************************************
diff --git a/dlls/uxtheme/window.c b/dlls/uxtheme/window.c
index a9ab39d..e7fea6b 100644
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -463,6 +463,7 @@ static BOOL draw_non_client(HWND hwnd, HDC target, BOOL paint)
     HFONT font = NULL;
     WCHAR title[512];
     HICON icon;
+    DWORD options;
 
     if (!win4wine_external_shell()
         || (style & WS_CAPTION) != WS_CAPTION || (style & WS_CHILD)
@@ -545,6 +546,7 @@ static BOOL draw_non_client(HWND hwnd, HDC target, BOOL paint)
     text.top = border_y;
     text.left += border_x + 2;
     text.right -= border_x + 2;
+    options = (DWORD)(DWORD_PTR)GetPropW(hwnd, L"Win4WineNonClientOptions");
     icon = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_SMALL, 0);
     if (!icon) icon = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_BIG, 0);
     if (!icon) icon = (HICON)GetClassLongPtrW(hwnd, GCLP_HICONSM);
@@ -554,6 +556,8 @@ static BOOL draw_non_client(HWND hwnd, HDC target, BOOL paint)
         icon = LoadImageW(NULL, (LPCWSTR)IDI_WINLOGO, IMAGE_ICON,
                          GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON),
                          LR_DEFAULTCOLOR | LR_SHARED);
+    /* SetWindowThemeAttribute: Windows 7's folder windows draw neither */
+    if (options & WTNCA_NODRAWICON) icon = NULL;
     if (icon && (style & WS_SYSMENU))
     {
         int width = GetSystemMetrics(SM_CXSMICON), height = GetSystemMetrics(SM_CYSMICON);
@@ -612,7 +616,8 @@ static BOOL draw_non_client(HWND hwnd, HDC target, BOOL paint)
     }
     if (font) SelectObject(dc, font);
     SetBkMode(dc, TRANSPARENT);
-    GetWindowTextW(hwnd, title, ARRAY_SIZE(title));
+    title[0] = 0;
+    if (!(options & WTNCA_NODRAWCAPTION)) GetWindowTextW(hwnd, title, ARRAY_SIZE(title));
     SetTextColor(dc, GetThemeSysColor(theme, active ? COLOR_CAPTIONTEXT : COLOR_INACTIVECAPTIONTEXT));
     text.bottom = text.top + GetSystemMetrics(SM_CYCAPTION);
     DrawThemeText(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, title, -1,
diff --git a/include/uxtheme.h b/include/uxtheme.h
index b7fa3f9..2df94e9 100644
--- a/include/uxtheme.h
+++ b/include/uxtheme.h
@@ -212,6 +212,18 @@ THEMEAPI_(HTHEME) GetWindowTheme(HWND);
 
 enum WINDOWTHEMEATTRIBUTETYPE { WTA_NONCLIENT = 1 };
 
+typedef struct _WTA_OPTIONS
+{
+    DWORD dwFlags;
+    DWORD dwMask;
+} WTA_OPTIONS, *PWTA_OPTIONS;
+
+#define WTNCA_NODRAWCAPTION       0x00000001
+#define WTNCA_NODRAWICON          0x00000002
+#define WTNCA_NOSYSMENU           0x00000004
+#define WTNCA_NOMIRRORHELP        0x00000008
+#define WTNCA_VALIDBITS           (WTNCA_NODRAWCAPTION | WTNCA_NODRAWICON | WTNCA_NOSYSMENU | WTNCA_NOMIRRORHELP)
+
 THEMEAPI HitTestThemeBackground(HTHEME,HDC,int,int,DWORD,const RECT*, HRGN,POINT,WORD*);
 THEMEAPI_(BOOL) IsAppThemed(void);
 THEMEAPI_(BOOL) IsCompositionActive(void);
