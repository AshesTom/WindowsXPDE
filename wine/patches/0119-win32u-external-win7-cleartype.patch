From: Codex <codex@localhost>
Subject: [PATCH] win32u: Windows 7's ClearType levels and blending

Purpose: draw ClearType text in the Windows 7 shell session with
Windows 7's colors.
Windows behavior: Windows 7 SP1 samples the outline as XP does (seven
levels per subpixel, shapes and positions as with 0052), but blends
linearly at the same default settings (FontSmoothingGamma 0,
FontSmoothingType 2): black text on white gives only 0, 43, 85, 128,
170, 212 and 255, where XP gives 0, 114, 155, 186, 212, 234 and 255.
Wine before (0052): XP's gamma of 2.2 and levels rounded the other way
in two places.
Change: for WIN4WINE_SHELL=win7, a linear gamma and Windows 7's level
table.
Evidence: text of a test window on white has Windows 7's seven values;
most of the remaining text differences against Windows 7 are gone (a
few glyphs still sit a subpixel apart).
Scope: Windows 7 shell session with ClearType only.
---
 dlls/win32u/font.c     | 6 ++++--
 dlls/win32u/freetype.c | 8 ++++++--
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index caf5918..eb6a319 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -4778,8 +4778,10 @@ static UINT init_font_options(void)
     /* Calibrating the difference between the registry value and the Wine gamma value.
        This looks roughly similar to Windows Native with the same registry value.
        MS GDI seems to be rasterizing the outline at a different rate than FreeType. */
-    /* XP's ClearType at its default contrast (1400) blends with a gamma of 2.2. */
-    if (external_cleartype) gamma = 2200 * gamma / 1400;
+    /* XP's ClearType at its default contrast (1400) blends with a gamma of 2.2;
+     * Windows 7's linearly (black on white gives 0, 43, 85, 128, 170, 212 and
+     * 255 on the reference machine, with the same settings). */
+    if (external_cleartype && win4wine_shell() != WIN4WINE_SHELL_WIN7) gamma = 2200 * gamma / 1400;
     else gamma = 1000 * gamma / 1400;
     if (gamma != 1000)
     {
diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
index 8e346ac..32691a5 100644
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -2882,11 +2882,15 @@ static DWORD get_subpixel_glyph_bitmap( FT_GlyphSlot glyph, FT_BBox bbox, UINT f
 /* XP's ClearType: the outline, hinted vertically only, is drawn black and
  * white at six times the horizontal resolution; each subpixel is as dark as
  * the share of the six samples set around it (its own two and two on either
- * side), so it has one of seven levels. */
+ * side), so it has one of seven levels (Windows 7 rounds two of them the
+ * other way, and blends them linearly: see init_font_options). */
 static DWORD get_xp_cleartype_bitmap( struct gdi_font *font, FT_Face ft_face, UINT glyph, UINT format,
                                       const FT_Matrix *matrices, GLYPHMETRICS *gm, DWORD buflen, BYTE *buf )
 {
     static const FT_Matrix six = {6 << 16, 0, 0, 1 << 16};
+    /* Windows 7's levels: black on white gives 255, 212, 170, 128, 85, 43 and 0 */
+    static const BYTE win7_levels[7] = { 0, 43, 85, 127, 170, 212, 255 };
+    BOOL win7 = win4wine_shell() == WIN4WINE_SHELL_WIN7;
     FT_Bitmap *bitmap;
     int left, first, last, width, height, x, y, c, s;
     DWORD pitch, needed;
@@ -2942,7 +2946,7 @@ static DWORD get_xp_cleartype_bitmap( struct gdi_font *font, FT_Face ft_face, UI
 
                 for (s = 2 * j - 2 - left; s < 2 * j + 4 - left; s++)
                     if (s >= 0 && s < (int)bitmap->width && (src[s >> 3] & (0x80 >> (s & 7)))) count++;
-                pixel |= (count * 255 + 3) / 6 << (bgr ? 8 * c : 16 - 8 * c);
+                pixel |= (win7 ? win7_levels[count] : (count * 255 + 3) / 6) << (bgr ? 8 * c : 16 - 8 * c);
             }
             dst[x] = pixel;
         }
