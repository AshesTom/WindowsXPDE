                                  BOOL menu_bar, struct menu *menu )
@@ -2127,6 +2253,12 @@ static void calc_menu_item_size( HDC hdc, struct menu_item *item, HWND owner, IN
         return;
     }
 
+    if (!menu_bar && themed_menus())
