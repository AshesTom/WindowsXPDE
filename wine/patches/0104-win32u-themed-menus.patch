+        POINT org;
+
+        bmprc.left = (check_width - item->bmpsize.cx) / 2;
+        bmprc.top = (rect.bottom - rect.top - item->bmpsize.cy) / 2;
+        bmprc.right = bmprc.left + item->bmpsize.cx;
+        bmprc.bottom = bmprc.top + item->bmpsize.cy;
+        set_viewport_org( hdc, rect.left, rect.top, &org );
+        draw_bitmap_item( hwnd, hdc, item, &bmprc, menu, owner, odaction );
+        set_viewport_org( hdc, org.x, org.y, NULL );
+    }
+    else if ((item->fState & MF_CHECKED) && !(menu->dwStyle & MNS_NOCHECK))
+    {
+        r.left += menu_theme.check_margins.left;
+        r.top += menu_theme.check_margins.top;
+        r.right -= menu_theme.check_margins.right;
+        r.bottom -= menu_theme.check_margins.bottom;
+        if (item->fType & MFT_RADIOCHECK)
+            draw_menu_part( hwnd, hdc, MENU_POPUPCHECK, grayed ? MC_BULLETDISABLED : MC_BULLETNORMAL, &r );
+        else
+            draw_menu_part( hwnd, hdc, MENU_POPUPCHECK, grayed ? MC_CHECKMARKDISABLED : MC_CHECKMARKNORMAL, &r );
+    }
+
+    if (item->fType & MF_POPUP)
+    {
+        r.right = rect.right - menu_theme.submenu_margins.right;
+        r.left = r.right - menu_theme.submenu.cx;
+        r.top = rect.top + (rect.bottom - rect.top - menu_theme.submenu.cy) / 2;
+        r.bottom = r.top + menu_theme.submenu.cy;
+        draw_menu_part( hwnd, hdc, MENU_POPUPSUBMENU, grayed ? MSM_DISABLED : MSM_NORMAL, &r );
+    }
+
+    r = rect;
+    r.left += theme_text_left( menu );
+    /* xTab is relative to the items' area, like item->rect */
+    draw_themed_item_text( hdc, item, r, DT_LEFT | DT_VCENTER | DT_SINGLELINE, menu_theme.popup_text[state - 1],
+                           item->xTab + rect.left - item->rect.left );
+}
