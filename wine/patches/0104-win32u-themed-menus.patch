+    if (themed_menus()) menu->Height++;
+    rect->bottom = menu->items_rect.top + menu->Height;
 
     /* Flush right all items between the MF_RIGHTJUSTIFY and */
     /* the last item (if several lines, only move the last line) */
@@ -2465,6 +2600,160 @@ got_bitmap:
     NtGdiDeleteObjectApp( mem_hdc );
 }
 
+/* the text of a themed menu item and its shortcut (see themed_menus) */
+static void draw_themed_item_text( HDC hdc, struct menu_item *item, RECT rect, UINT format, COLORREF color,
+                                   int tab )
+{
+    HFONT prev_font = 0;
+    int i;
+
+    if (!item->text) return;
+    if (hide_menu_prefixes()) format |= DT_HIDEPREFIX;
+    if (item->fState & MFS_DEFAULT) prev_font = NtGdiSelectFont( hdc, get_menu_font( TRUE ));
+    NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, color, NULL );
+    NtGdiGetAndSetDCDword( hdc, NtGdiSetBkMode, TRANSPARENT, NULL );
+    for (i = 0; item->text[i]; i++)
+        if (item->text[i] == '\t' || item->text[i] == '\b') break;
+    DrawTextW( hdc, item->text, i, &rect, format );
+    if (item->text[i] == '\t')
+    {
+        rect.left = tab;
+        DrawTextW( hdc, item->text + i + 1, -1, &rect, format );
+    }
+    else if (item->text[i] == '\b')
+    {
+        rect.right -= THEME_TEXT_END;
+        DrawTextW( hdc, item->text + i + 1, -1, &rect, (format & ~DT_LEFT) | DT_RIGHT );
+    }
+    if (prev_font) NtGdiSelectFont( hdc, prev_font );
+}
+
+static void draw_themed_bar_item( HWND hwnd, struct menu *menu, HDC hdc, struct menu_item *item, RECT rect,
+                                  UINT odaction )
+{
+    BOOL grayed = item->fState & MF_GRAYED, hilite = item->fState & MF_HILITE;
+    BOOL active = win_get_flags( hwnd ) & WIN_NCACTIVATED;
+    BOOL hot = !hilite && item - menu->items == menu->hot_item && active;
+    int state = grayed ? (hilite ? MBI_DISABLEDPUSHED : hot ? MBI_DISABLEDHOT : MBI_DISABLED) :
+                         (hilite ? MBI_PUSHED : hot ? MBI_HOT : MBI_NORMAL);
+    RECT bar = menu->items_rect;
+    HRGN clip;
+
+    if (item->fType & MF_SEPARATOR) return;
+    /* the bar's background under the item */
+    if ((clip = NtGdiCreateRectRgn( rect.left, rect.top, rect.right, rect.bottom )))
+    {
+        NtGdiExtSelectClipRgn( hdc, clip, RGN_AND );
+        NtGdiDeleteObjectApp( clip );
+    }
+    draw_menu_part( hwnd, hdc, MENU_BARBACKGROUND, active ? MB_ACTIVE : MB_INACTIVE, &bar );
+    if (hilite || hot) draw_menu_part( hwnd, hdc, MENU_BARITEM, state, &rect );
+    if (item->hbmpItem)
+    {
+        RECT bmprc;
+        POINT org;
+
+        bmprc.left = item->hbmpItem == HBMMENU_CALLBACK ? 3 : item->text ? menucharsize.cx : 0;
+        bmprc.top = item->hbmpItem == HBMMENU_CALLBACK ? (rect.bottom - rect.top - item->bmpsize.cy) / 2 : 0;
+        bmprc.right = bmprc.left + item->bmpsize.cx;
+        bmprc.bottom = bmprc.top + item->bmpsize.cy;
+        set_viewport_org( hdc, rect.left, rect.top, &org );
+        draw_bitmap_item( hwnd, hdc, item, &bmprc, menu, hwnd, odaction );
+        set_viewport_org( hdc, org.x, org.y, NULL );
+        rect.left += item->bmpsize.cx;
+    }
+    /* an inactive window's bar has gray text, like disabled items */
+    draw_themed_item_text( hdc, item, rect, DT_CENTER | DT_VCENTER | DT_SINGLELINE,
+                           menu_theme.bar_text[(active || hilite ? state : MBI_DISABLED) - 1], 0 );
+}
+
