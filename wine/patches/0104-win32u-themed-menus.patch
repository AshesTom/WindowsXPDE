+
+/* Windows 7's menus, for the opted-in external shell with a version 4 visual
+ * style: the style's Menu class draws the menu bar and popup menus (uxtheme
+ * through user32's MenuTheme callback). The layout was measured on Windows 7
+ * SP1 with tests/menu-theme-layout.c (GetMenuItemRect, text extents) and
+ * screenshots: a popup item is as tall as the check background (check mark and its
+ * margins) or the text and the item margins; a separator is the separator
+ * part and the item margins; the gutter is the check background and its
+ * margins; the text starts after the gutter and the background's border
+ * size; the shortcuts start 33 pixels after the longest text and end 19
+ * pixels before the item's end; the submenu arrow adds no width. Menu bar
+ * items fill the bar's height from its top. */
+#define THEME_TAB_GAP  33
+#define THEME_TEXT_END 19
+
+static struct menu_theme_metrics menu_theme;
+static BOOL menu_theme_active;
+
+/* refreshed where a menu is laid out or drawn as a whole */
+static void update_menu_theme(void)
+{
+    struct menu_theme_params params = { MENU_THEME_METRICS };
+    void *ret_ptr;
+    ULONG ret_len;
+
+    if (!win4wine_external_shell()) return;
+    if (!KeUserModeCallback( NtUserMenuTheme, &params, sizeof(params), &ret_ptr, &ret_len ) &&
+        ret_len == sizeof(menu_theme))
+    {
+        memcpy( &menu_theme, ret_ptr, sizeof(menu_theme) );
+        menu_theme_active = TRUE;
+    }
+    else menu_theme_active = FALSE;
+}
+
+static BOOL themed_menus(void)
+{
+    return menu_theme_active;
+}
+
+static void draw_menu_part( HWND hwnd, HDC hdc, int part, int state, const RECT *rect )
+{
+    struct menu_theme_params params = { MENU_THEME_DRAW, hwnd, hdc, part, state, *rect };
+    void *ret_ptr;
+    ULONG ret_len;
+
+    KeUserModeCallback( NtUserMenuTheme, &params, sizeof(params), &ret_ptr, &ret_len );
+}
+
+/* the check mark column: as wide as the check background, or the widest item bitmap */
+static int theme_check_width( const struct menu *menu )
+{
+    return max( menu_theme.check.cx, (int)menu->textOffset ) + menu_theme.check_margins.left +
+           menu_theme.check_margins.right;
+}
+
+static int theme_check_height( const struct menu_item *item )
+{
+    return max( menu_theme.check.cy, item->hbmpItem ? item->bmpsize.cy : 0 ) +
+           menu_theme.check_margins.top + menu_theme.check_margins.bottom;
+}
+
+static int theme_gutter_width( const struct menu *menu )
+{
+    return theme_check_width( menu ) + menu_theme.check_bg_margins.left + menu_theme.check_bg_margins.right;
+}
+
+static int theme_text_left( const struct menu *menu )
+{
+    return theme_gutter_width( menu ) + menu_theme.background_border;
+}
+
+/* With keyboard cues off, Windows 7 underlines the access keys of menus only
+ * while they are used with the keyboard (Alt, F10). */
+static BOOL menu_keyboard_mode;
+
+static BOOL hide_menu_prefixes(void)
+{
+    BOOL cues = TRUE;
+
+    if (!win4wine_external_shell() || menu_keyboard_mode) return FALSE;
+    NtUserSystemParametersInfo( SPI_GETKEYBOARDCUES, 0, &cues, 0 );
+    return !cues;
 }
 
 static HBITMAP get_xp_arrow_bitmap(void)
@@ -2075,6 +2164,43 @@ static void get_bitmap_item_size( struct menu_item *item, SIZE *size, HWND owner
     }
 }
 
+/* A popup item of a themed menu (see themed_menus). The bitmaps were measured
+ * by calc_popup_menu_size into the check mark column. */
+static void calc_themed_popup_item_size( HDC hdc, struct menu_item *item, int org_x, const struct menu *menu )
+{
+    int text_width = 0, text_height = 0, accel_width = 0;
+    HFONT prev_font = 0;
+    RECT rc;
+    WCHAR *p;
+
+    if (item->fType & MF_SEPARATOR)
+    {
+        item->rect.bottom += menu_theme.separator.cy + menu_theme.item_margins.top +
+                             menu_theme.item_margins.bottom;
+        return;
+    }
+    if (item->text && !(item->fType & MF_SYSMENU))
+    {
+        int n = (p = wcschr( item->text, '\t' )) ? p - item->text : -1;
+
+        if (item->fState & MFS_DEFAULT) prev_font = NtGdiSelectFont( hdc, get_menu_font( TRUE ));
+        SetRectEmpty( &rc );
+        text_height = DrawTextW( hdc, item->text, n, &rc, DT_SINGLELINE | DT_CALCRECT );
+        text_width = rc.right - rc.left;
+        if (p)
+        {
+            SetRectEmpty( &rc );
+            text_height = max( text_height, DrawTextW( hdc, p + 1, -1, &rc, DT_SINGLELINE | DT_CALCRECT ));
+            accel_width = rc.right - rc.left;
+        }
+        if (prev_font) NtGdiSelectFont( hdc, prev_font );
+    }
+    item->xTab = org_x + theme_text_left( menu ) + text_width + THEME_TAB_GAP;
+    item->rect.right = item->xTab + accel_width + THEME_TEXT_END;
+    item->rect.bottom += max( theme_check_height( item ),
+                              text_height + menu_theme.item_margins.top + menu_theme.item_margins.bottom );
+}
+
 /* Calculate the size of the menu item and store it in item->rect */
