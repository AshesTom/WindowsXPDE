+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "ntuser.h"
+#include "uxthemedll.h"
+#include "vssym32.h"
+
+static void get_margins(HTHEME theme, int part, RECT *margins)
+{
+    MARGINS m = {0};
+
+    GetThemeMargins(theme, NULL, part, 0, TMT_CONTENTMARGINS, NULL, &m);
+    SetRect(margins, m.cxLeftWidth, m.cyTopHeight, m.cxRightWidth, m.cyBottomHeight);
+}
+
+static COLORREF text_color(HTHEME theme, int part, int state, int fallback)
+{
+    COLORREF color;
+
+    if (FAILED(GetThemeColor(theme, part, state, TMT_TEXTCOLOR, &color))) color = GetSysColor(fallback);
+    return color;
+}
+
+/* Windows 7 (and Vista) draw their menus with the visual style's Menu class.
+ * win32u lays the menus out and draws their text; this gives it the sizes of
+ * the parts and draws them. Only for a version 4 style that has the parts
+ * (XP's styles have no popup menu parts). */
+BOOL WINAPI Win4WineMenuTheme(UINT op, HWND hwnd, HDC hdc, INT part, INT state, const RECT *rect,
+                              struct menu_theme_metrics *metrics)
+{
+    HTHEME theme;
+    int i;
+
+    if (!MSSTYLES_ActiveThemeFormat4()) return FALSE;
+    if (!(theme = OpenThemeData(NULL, L"Menu"))) return FALSE;
+    if (!IsThemePartDefined(theme, MENU_POPUPITEM, 0))
+    {
+        CloseThemeData(theme);
+        return FALSE;
+    }
+    if (op == MENU_THEME_DRAW)
+    {
+        DrawThemeBackground(theme, hdc, part, state, rect, NULL);
+        CloseThemeData(theme);
+        return TRUE;
+    }
+
+    memset(metrics, 0, sizeof(*metrics));
+    GetThemePartSize(theme, NULL, MENU_POPUPCHECK, 0, NULL, TS_TRUE, &metrics->check);
+    get_margins(theme, MENU_POPUPCHECK, &metrics->check_margins);
+    get_margins(theme, MENU_POPUPCHECKBACKGROUND, &metrics->check_bg_margins);
+    get_margins(theme, MENU_POPUPITEM, &metrics->item_margins);
+    GetThemeInt(theme, MENU_POPUPBACKGROUND, 0, TMT_BORDERSIZE, &metrics->background_border);
+    GetThemePartSize(theme, NULL, MENU_POPUPSEPARATOR, 0, NULL, TS_TRUE, &metrics->separator);
+    GetThemePartSize(theme, NULL, MENU_POPUPSUBMENU, 0, NULL, TS_TRUE, &metrics->submenu);
+    get_margins(theme, MENU_POPUPSUBMENU, &metrics->submenu_margins);
+    for (i = 0; i < ARRAY_SIZE(metrics->popup_text); i++)
+        metrics->popup_text[i] = text_color(theme, MENU_POPUPITEM, i + 1,
+                                            i + 1 >= MPI_DISABLED ? COLOR_GRAYTEXT : COLOR_MENUTEXT);
+    for (i = 0; i < ARRAY_SIZE(metrics->bar_text); i++)
+        metrics->bar_text[i] = text_color(theme, MENU_BARITEM, i + 1,
+                                          i + 1 >= MBI_DISABLED ? COLOR_GRAYTEXT : COLOR_MENUTEXT);
+    CloseThemeData(theme);
+    return TRUE;
+}
