+/* The menu parts of the visual style, from Wine's own uxtheme for the
+ * opted-in external shell (win32u lays the menus out and draws the text). */
+static NTSTATUS WINAPI User32MenuTheme( void *args, ULONG size )
+{
+    static BOOL (WINAPI *menu_theme)( UINT, HWND, HDC, INT, INT, const RECT *, struct menu_theme_metrics * );
+    const struct menu_theme_params *params = args;
+    struct menu_theme_metrics metrics;
+    HMODULE module;
+
+    if (!menu_theme && (module = GetModuleHandleW( L"uxtheme.dll" )))
+        menu_theme = (void *)GetProcAddress( module, "Win4WineMenuTheme" );
+    if (!menu_theme || !menu_theme( params->op, params->hwnd, params->hdc, params->part, params->state,
+                                    &params->rect, &metrics ))
+        return STATUS_NOT_SUPPORTED;
+    if (params->op == MENU_THEME_METRICS) return NtCallbackReturn( &metrics, sizeof(metrics), STATUS_SUCCESS );
+    return STATUS_SUCCESS;
+}
+
