 @ stdcall HBITMAP_UserUnmarshal(ptr ptr ptr) combase.HBITMAP_UserUnmarshal
+@ stdcall -arch=win64 HBITMAP_UserUnmarshal64(ptr ptr ptr) combase.HBITMAP_UserUnmarshal
