From: Codex <codex@localhost>
Subject: [PATCH] dwmapi, combase, ole32: what Windows 7's shell needs for the Windows key and folder windows

Purpose: open Windows 7's Start menu with the Windows key, and get
Windows 7's folder windows (Win+E) further.
Windows 7 behavior: when its task switcher gets HSHELL_TASKMAN (the
Windows key, 0029), the taskbar calls dwmapi's DwmpActivateLivePreview
(ordinal 113) before it opens the Start menu; clicking or pointing at a
taskbar button calls DwmpRegisterThumbnail (ordinal 124) for a window
thumbnail. Opening a folder window,
explorer registers in the global interface table its own objects'
interfaces that their QueryInterface does not give (for example
IBrowserProgressAggregator), and its proxies (actxprxy.dll) import the
NDR64 names of ole32's user marshal functions (HWND_UserSize64, ...).
Wine before: DwmpActivateLivePreview was a stub and the shell ended at the
Windows key, and at a click on a taskbar button; the free-threaded marshaler asks the object for the
interface even within the process and failed with E_NOINTERFACE, which
explorer showed as "ファイル システムのエラーです"; the NDR64 names were
missing, so Windows 7's proxies could not marshal.
Windows 7 Basic has no desktop composition: DwmIsCompositionEnabled
gives FALSE there, and the taskbar then shows the window list of a
button it is pointed at in its basic look (it calls SetWindowTheme with
"BasicMenuMode" on TaskListThumbnailWnd; a hook of the reference
machine's explorer logged both).
Change: on 64-bit, DwmpActivateLivePreview returns S_OK without reading
its arguments (there is no desktop composition, so no preview; the
caller passes the arguments in registers and removes them); it stays a
stub on 32-bit. DwmpRegisterThumbnail fails with E_NOTIMPL in the same way
(as DwmRegisterThumbnail does: there is no thumbnail without composition). In
the Windows 7 shell's process (w7-explorer.exe, WIN4WINE_SHELL=win7),
DwmIsCompositionEnabled gives FALSE, as on Windows 7 Basic (Wine gives
TRUE from Windows 8.1 on, and the prefix is Windows 10's: the window list
was drawn with Aero's glass image, black without the glass). With WIN4WINE_SHELL=win7, the free-threaded marshaler
passes the given pointer within the process when the object's
QueryInterface does not give the interface, marks it so in the marshaled
data, and unmarshaling gives that pointer back without asking again
(asking again failed the same way when the thumbnail cache's interface
was taken from the global interface table). On 64-bit, ole32 exports
HACCEL, HBITMAP, HGLOBAL, HICON, HMENU and HWND _UserSize64,
_UserMarshal64, _UserUnmarshal64 and _UserFree64 as the classic
functions, as 0094 does for oleaut32.
Evidence: Windows 7 SP1 x64 explorer.exe opens its Start menu for the
Windows key and Ctrl+Esc, and stays when taskbar buttons are clicked; Win+E creates the folder window (CabinetWClass)
with Windows 7's actxprxy.dll loaded for its interfaces. The folder
window does not show yet. Pointing at a taskbar button shows the window list in
the reference machine's colors (the BasicMenuMode image, 117,134,154 in
a 201,216,234 border).
Scope: the marshaler change only with WIN4WINE_SHELL=win7, the
composition only in w7-explorer.exe with it; the other changes are new
64-bit exports.
---
 dlls/combase/marshal.c    | 25 +++++++++++++++++++++++-
 dlls/dwmapi/dwmapi.spec   |  6 ++++--
 dlls/dwmapi/dwmapi_main.c | 50 +++++++++++++++++++++++++++++++++++++++++++++++
 dlls/ole32/ole32.spec     | 24 +++++++++++++++++++++++
 4 files changed, 102 insertions(+), 3 deletions(-)

diff --git a/dlls/combase/marshal.c b/dlls/combase/marshal.c
index f638604..c5c63c2 100644
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -28,6 +28,7 @@
 #include "combase_private.h"
 
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(ole);
 
@@ -299,6 +300,9 @@ static HRESULT WINAPI ftmarshaler_GetMarshalSizeMax(IMarshal *iface, REFIID riid
     return hr;
 }
 
+/* Marks in the marshaled data a pointer passed as it was given. */
+#define FTM_AS_GIVEN 0x77346d66
+
 static HRESULT WINAPI ftmarshaler_MarshalInterface(IMarshal *iface, IStream *stream, REFIID riid,
         void *pv, DWORD dest_context, void *pvDestContext, DWORD mshlflags)
 {
@@ -317,6 +321,17 @@ static HRESULT WINAPI ftmarshaler_MarshalInterface(IMarshal *iface, IStream *str
 
         data.value = 0;
         hr = IUnknown_QueryInterface((IUnknown *)pv, riid, (void **)&data.object);
+        if (FAILED(hr) && win4wine_shell() == WIN4WINE_SHELL_WIN7)
+        {
+            /* Windows 7's explorer registers in the global interface table
+             * interfaces of its own objects that their QueryInterface does
+             * not give (IBrowserProgressAggregator, opening a folder window);
+             * within the process the pointer is passed as it is. */
+            data.object = pv;
+            IUnknown_AddRef(data.object);
+            unknown_guid.Data1 = FTM_AS_GIVEN;
+            hr = S_OK;
+        }
         if (FAILED(hr))
             return hr;
 
@@ -361,7 +376,15 @@ static HRESULT WINAPI ftmarshaler_UnmarshalInterface(IMarshal *iface, IStream *s
     hr = IStream_Read(stream, &unknown_guid, sizeof(unknown_guid), NULL);
     if (hr != S_OK) return STG_E_READFAULT;
 
-    hr = IUnknown_QueryInterface(data.object, riid, ppv);
+    if (unknown_guid.Data1 == FTM_AS_GIVEN)
+    {
+        /* passed as it was given (see ftmarshaler_MarshalInterface) */
+        *ppv = data.object;
+        IUnknown_AddRef(data.object);
+        hr = S_OK;
+    }
+    else
+        hr = IUnknown_QueryInterface(data.object, riid, ppv);
     if (!(mshlflags & (MSHLFLAGS_TABLEWEAK | MSHLFLAGS_TABLESTRONG)))
         IUnknown_Release(data.object);
 
diff --git a/dlls/dwmapi/dwmapi.spec b/dlls/dwmapi/dwmapi.spec
index d899a7a..a6e82ef 100644
--- a/dlls/dwmapi/dwmapi.spec
+++ b/dlls/dwmapi/dwmapi.spec
@@ -10,14 +10,16 @@
 109 stub -noname DwmpOpenGraphicsStream
 110 stub -noname DwmpCloseGraphicsStream
 112 stub -noname DwmpSetGraphicsStreamTransformHint
-113 stub -noname DwmpActivateLivePreview
+113 stdcall -noname -arch=win64 DwmpActivateLivePreview()
+113 stub -noname -arch=win32 DwmpActivateLivePreview
 114 stub -noname DwmpQueryThumbnailType
 115 stub -noname DwmpStartupViaUserInit
 118 stub -noname DwmpGetAssessment
 119 stub -noname DwmpGetAssessmentUsage
 120 stub -noname DwmpSetAssessmentUsage
 121 stub -noname DwmpIsSessionDWM
-124 stub -noname DwmpRegisterThumbnail
+124 stdcall -noname -arch=win64 DwmpRegisterThumbnail()
+124 stub -noname -arch=win32 DwmpRegisterThumbnail
 125 stub DwmpDxBindSwapChain
 126 stub DwmpDxUnbindSwapChain
 127 stdcall -noname DwmpGetColorizationParameters(ptr)
diff --git a/dlls/dwmapi/dwmapi_main.c b/dlls/dwmapi/dwmapi_main.c
index 4b881b4..bf3a5df 100644
--- a/dlls/dwmapi/dwmapi_main.c
+++ b/dlls/dwmapi/dwmapi_main.c
@@ -29,9 +29,28 @@
 #include "winuser.h"
 #include "dwmapi.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dwmapi);
 
+/* Windows 7's shell (w7-explorer.exe) in win4wine's session: as on Windows 7
+ * Basic, there is no desktop composition, so it chooses its basic looks (the
+ * taskbar's window list shows as "BasicMenuMode", not over glass). */
+static BOOL win7_shell_process(void)
+{
+    static int shell = -1;
+
+    if (shell < 0)
+    {
+        WCHAR path[MAX_PATH];
+        DWORD len = GetModuleFileNameW( NULL, path, MAX_PATH );
+        const WCHAR *name = path + len;
+
+        while (name > path && name[-1] != '\\' && name[-1] != '/') name--;
+        shell = win4wine_shell() == WIN4WINE_SHELL_WIN7 && !wcsicmp( name, L"w7-explorer.exe" );
+    }
+    return shell;
+}
 
 /**********************************************************************
  *           DwmIsCompositionEnabled         (DWMAPI.@)
@@ -46,6 +65,8 @@ HRESULT WINAPI DwmIsCompositionEnabled(BOOL *enabled)
         return E_INVALIDARG;
 
     *enabled = FALSE;
+    if (win7_shell_process())
+        return S_OK;
     version.dwOSVersionInfoSize = sizeof(version);
     if (!RtlGetVersion(&version))
         *enabled = (version.dwMajorVersion > 6 || (version.dwMajorVersion == 6 && version.dwMinorVersion >= 3));
@@ -376,3 +397,32 @@ HRESULT WINAPI DwmpGetColorizationParameters(void *params)
     FIXME("(%p) stub\n", params);
     return E_NOTIMPL;
 }
+
+/**********************************************************************
+ *           DwmpActivateLivePreview         (DWMAPI.113)
+ *
+ * Windows 7's taskbar calls it (for example when the task list opens) to
+ * start or end a window preview. There is no desktop composition here, so
+ * there is no preview. Its arguments have no public description; on 64-bit
+ * the caller passes them in registers and removes them itself, so returning
+ * without reading them is safe.
+ */
+HRESULT WINAPI DwmpActivateLivePreview(void)
+{
+    TRACE( "\n" );
+    return S_OK;
+}
+
+/**********************************************************************
+ *           DwmpRegisterThumbnail         (DWMAPI.124)
+ *
+ * Windows 7's taskbar calls it for the thumbnail of a window when a button
+ * is pointed at or clicked. Without desktop composition there is no
+ * thumbnail; DwmRegisterThumbnail fails the same way. Its arguments have no
+ * public description and are not read (see DwmpActivateLivePreview).
+ */
+HRESULT WINAPI DwmpRegisterThumbnail(void)
+{
+    TRACE( "\n" );
+    return E_NOTIMPL;
+}
