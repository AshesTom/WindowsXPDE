From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] shcore: store SHRegSetPath's whole path, unexpanded

Purpose: XP's shimgvw.dll registers its image types' icons and Open
commands whole: Display Properties and folders show the JPEG, bitmap,
GIF, PNG and TIFF icons, and opening a picture starts the viewer.
Windows behavior: SHRegSetPath replaces the start of the path with its
environment strings (PathUnExpandEnvStrings) and stores a REG_EXPAND_SZ
then, or the path as REG_SZ; the size includes the terminating null, in
bytes.
Wine before: a semi-stub stored REG_SZ with lstrlenW(path) as the size in
bytes: half the string ("shimgvw.dll,3" became "shimgvw", the Open
command stopped at "...\system32\s").
Change: the size in bytes with the null, and the unexpanded path as
REG_EXPAND_SZ when it has one (shcore imports kernelbase for it); the same
for SHRegSetPathA.
Scope: SHRegSetPathA/W (shcore, and shlwapi, which forwards to it).
---
diff --git a/dlls/shcore/main.c b/dlls/shcore/main.c
--- a/dlls/shcore/main.c
+++ b/dlls/shcore/main.c
@@ -2343,12 +2343,13 @@
  */
 DWORD WINAPI SHRegSetPathA(HKEY hkey, const char *subkey, const char *value, const char *path, DWORD flags)
 {
-    FIXME("%p, %s, %s, %s, %#lx - semi-stub\n", hkey, debugstr_a(subkey),
-            debugstr_a(value), debugstr_a(path), flags);
+    char unexpanded[MAX_PATH];
 
-    /* FIXME: PathUnExpandEnvStringsA() */
+    TRACE("%p, %s, %s, %s, %#lx\n", hkey, debugstr_a(subkey), debugstr_a(value), debugstr_a(path), flags);
 
-    return SHSetValueA(hkey, subkey, value, REG_SZ, path, lstrlenA(path));
+    if (PathUnExpandEnvStringsA(path, unexpanded, ARRAY_SIZE(unexpanded)))
+        return SHSetValueA(hkey, subkey, value, REG_EXPAND_SZ, unexpanded, lstrlenA(unexpanded) + 1);
+    return SHSetValueA(hkey, subkey, value, REG_SZ, path, lstrlenA(path) + 1);
 }
 
 /*************************************************************************
@@ -2356,12 +2357,15 @@
  */
 DWORD WINAPI SHRegSetPathW(HKEY hkey, const WCHAR *subkey, const WCHAR *value, const WCHAR *path, DWORD flags)
 {
-    FIXME("%p, %s, %s, %s, %#lx semi-stub\n", hkey, debugstr_w(subkey),
-            debugstr_w(value), debugstr_w(path), flags);
+    WCHAR unexpanded[MAX_PATH];
 
-    /* FIXME: PathUnExpandEnvStringsW(); */
+    TRACE("%p, %s, %s, %s, %#lx\n", hkey, debugstr_w(subkey), debugstr_w(value), debugstr_w(path), flags);
 
-    return SHSetValueW(hkey, subkey, value, REG_SZ, path, lstrlenW(path));
+    /* The path with its folders as environment strings (%SystemRoot%...), a
+     * REG_EXPAND_SZ then; the size is in bytes, with the terminating null. */
+    if (PathUnExpandEnvStringsW(path, unexpanded, ARRAY_SIZE(unexpanded)))
+        return SHSetValueW(hkey, subkey, value, REG_EXPAND_SZ, unexpanded, (lstrlenW(unexpanded) + 1) * sizeof(WCHAR));
+    return SHSetValueW(hkey, subkey, value, REG_SZ, path, (lstrlenW(path) + 1) * sizeof(WCHAR));
 }
 
 /*************************************************************************
diff --git a/dlls/shcore/Makefile.in b/dlls/shcore/Makefile.in
--- a/dlls/shcore/Makefile.in
+++ b/dlls/shcore/Makefile.in
@@ -1,6 +1,6 @@
 MODULE    = shcore.dll
 IMPORTLIB = shcore
-IMPORTS   = advapi32
+IMPORTS   = advapi32 kernelbase
 DELAYIMPORTS = user32 ole32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
