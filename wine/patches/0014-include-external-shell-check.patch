From: Codex <codex@localhost>
Subject: [PATCH] include: add the external shell opt-in check

Purpose: one definition of the switch that limits the external XP shell's
changes to the processes that ask for them.
Change: wine/win4wine.h provides win4wine_external_shell(), true when
WIN4WINE_EXTERNAL_SHELL is in the environment (with any value). Unix
libraries read the Unix environment, PE modules the process environment
(ntdll, which cannot call kernel32, through RtlQueryEnvironmentVariable_U),
as the individual checks did. The session sets it to 1 for the XP shell,
its helpers and the bridge proxy. win4wine_shell() also names the session's
shell, from WIN4WINE_SHELL (win7 or reactos, in any case; unset for XP's),
and is WIN4WINE_SHELL_NONE without the opt-in, so that one parser serves
every later patch that tells the shells apart. The header is listed in
include/Makefile.in so that makedep finds it in a fresh build tree.
Scope: no behaviour by itself. Ordinary Wine applications do not set the
variable and keep Wine's behaviour in every later patch that uses it.
---
 include/Makefile.in     |   1 +
 include/wine/win4wine.h | 131 ++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 132 insertions(+)

diff --git a/include/Makefile.in b/include/Makefile.in
index e0987ce..71af5b6 100644
--- a/include/Makefile.in
+++ b/include/Makefile.in
@@ -996,6 +996,7 @@ SOURCES = \
 	wine/vulkan.h \
 	wine/vulkan_driver.h \
 	wine/wgl.h \
+	wine/win4wine.h \
 	wine/winbase16.h \
 	wine/windef16.h \
 	wine/wine_common_ver.rc \
diff --git a/include/wine/win4wine.h b/include/wine/win4wine.h
new file mode 100644
index 0000000..4e4c42e
--- /dev/null
+++ b/include/wine/win4wine.h
@@ -0,0 +1,131 @@
+/*
+ * Opt-in check for the external XP shell (win4wine)
+ *
+ * The changes made for the external XP shell apply only to processes that
+ * have WIN4WINE_EXTERNAL_SHELL in their environment (with any value), so
+ * that ordinary Wine applications keep Wine's behaviour. Unix libraries
+ * read the Unix environment, PE modules (ntdll through Rtl) the process
+ * environment.
+ *
+ * WIN4WINE_SHELL names the session's shell when it is not XP's: win7 or
+ * reactos (in any case). win4wine_shell() gives it, or WIN4WINE_SHELL_NONE
+ * without the opt-in.
+ */
+
+#ifndef __WINE_WINE_WIN4WINE_H
+#define __WINE_WINE_WIN4WINE_H
+
+enum win4wine_shell
+{
+    WIN4WINE_SHELL_NONE,     /* not an external shell session */
+    WIN4WINE_SHELL_XP,       /* no WIN4WINE_SHELL */
+    WIN4WINE_SHELL_WIN7,
+    WIN4WINE_SHELL_REACTOS,
+    WIN4WINE_SHELL_OTHER,
+};
+
+/* NAME is WIN4WINE_SHELL's value, LEN characters */
+#define WIN4WINE_SHELL_KIND(name, len) \
+    (win4wine_shell_name_is( (name), (len), "win7" ) ? WIN4WINE_SHELL_WIN7 : \
+     win4wine_shell_name_is( (name), (len), "reactos" ) ? WIN4WINE_SHELL_REACTOS : WIN4WINE_SHELL_OTHER)
+
+#ifdef WINE_UNIX_LIB
+
+#include <stdlib.h>
+#include <string.h>
+
+static inline BOOL win4wine_external_shell(void)
+{
+    return getenv( "WIN4WINE_EXTERNAL_SHELL" ) != NULL;
+}
+
+static inline BOOL win4wine_shell_name_is( const char *name, size_t len, const char *expected )
+{
+    return len == strlen( expected ) && !strncasecmp( name, expected, len );
+}
+
+static inline enum win4wine_shell win4wine_shell(void)
+{
+    static int kind = -1;
+
+    if (!win4wine_external_shell()) return WIN4WINE_SHELL_NONE;
+    if (kind < 0)
+    {
+        const char *name = getenv( "WIN4WINE_SHELL" );
+        kind = name ? WIN4WINE_SHELL_KIND( name, strlen( name ) ) : WIN4WINE_SHELL_XP;
+    }
+    return kind;
+}
+
+#else
+
+static inline BOOL win4wine_shell_name_is( const WCHAR *name, unsigned int len, const char *expected )
+{
+    unsigned int i;
+
+    for (i = 0; i < len && expected[i]; i++)
+        if ((name[i] >= 'A' && name[i] <= 'Z' ? name[i] + 'a' - 'A' : name[i]) != (unsigned char)expected[i])
+            return FALSE;
+    return i == len && !expected[i];
+}
+
+#ifdef _NTSYSTEM_
+
+static inline BOOL win4wine_external_shell(void)
+{
+    UNICODE_STRING name = RTL_CONSTANT_STRING( L"WIN4WINE_EXTERNAL_SHELL" ), value = { 0 };
+    return RtlQueryEnvironmentVariable_U( NULL, &name, &value ) != STATUS_VARIABLE_NOT_FOUND;
+}
+
+static inline enum win4wine_shell win4wine_shell(void)
+{
+    static int kind = -1;
+
+    if (!win4wine_external_shell()) return WIN4WINE_SHELL_NONE;
+    if (kind < 0)
+    {
+        UNICODE_STRING name = RTL_CONSTANT_STRING( L"WIN4WINE_SHELL" ), value;
+        WCHAR buffer[16];
+        NTSTATUS status;
+
+        value.Buffer = buffer;
+        value.Length = 0;
+        value.MaximumLength = sizeof(buffer);
+        status = RtlQueryEnvironmentVariable_U( NULL, &name, &value );
+        if (status == STATUS_VARIABLE_NOT_FOUND) kind = WIN4WINE_SHELL_XP;
+        else if (status) kind = WIN4WINE_SHELL_OTHER;
+        else kind = WIN4WINE_SHELL_KIND( buffer, value.Length / sizeof(WCHAR) );
+    }
+    return kind;
+}
+
+#else
+
+static inline BOOL win4wine_external_shell(void)
+{
+    return GetEnvironmentVariableW( L"WIN4WINE_EXTERNAL_SHELL", NULL, 0 ) != 0;
+}
+
+static inline enum win4wine_shell win4wine_shell(void)
+{
+    static int kind = -1;
+
+    if (!win4wine_external_shell()) return WIN4WINE_SHELL_NONE;
+    if (kind < 0)
+    {
+        DWORD error = GetLastError(), len;
+        WCHAR buffer[16];
+
+        if (!(len = GetEnvironmentVariableW( L"WIN4WINE_SHELL", buffer, ARRAY_SIZE(buffer) )))
+            kind = GetLastError() == ERROR_ENVVAR_NOT_FOUND ? WIN4WINE_SHELL_XP : WIN4WINE_SHELL_OTHER;
+        else kind = len < ARRAY_SIZE(buffer) ? WIN4WINE_SHELL_KIND( buffer, len ) : WIN4WINE_SHELL_OTHER;
+        SetLastError( error );
+    }
+    return kind;
+}
+
+#endif
+
+#endif
+
+#endif  /* __WINE_WINE_WIN4WINE_H */
