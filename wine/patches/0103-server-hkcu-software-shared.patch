From: Codex <codex@localhost>
Subject: [PATCH] server: share HKCU\Software between the 32-bit and 64-bit views

Purpose: keep 32-bit programs on the user's settings (Wine's X11 driver
settings and the active visual style among them) after 64-bit software
has created HKCU\Software\Wow6432Node.
Windows behavior: HKEY_CURRENT_USER\Software is shared by 32-bit and
64-bit programs; only keys under Software\Classes have a 32-bit view.
HKCU\Software\Wow6432Node is an ordinary key that 64-bit software can
create (Windows 7's explorer does, for Active Setup).
Wine before: a Wow6432Node subkey redirected every 32-bit access below its
parent, so once Windows 7's explorer had made HKCU\Software\Wow6432Node,
32-bit programs saw an empty HKCU\Software: the session's proxy windows
lost Wine's "Decorated"="N" (their frames shrank on every move) and the
visual style (classic caption buttons), and Wine set up its font links
again from the 32-bit view.
Change: a Wow6432Node directly in HKCU\Software does not redirect;
HKCU\Software\Classes and HKLM keep their views.
Evidence: in a Windows 7 shell prefix whose HKCU\Software\Wow6432Node
exists, the proxy windows of Linux applications keep their size and the
themed caption buttons in later sessions.
Scope: prefixes with HKCU\Software\Wow6432Node; others behave as before.
---
 server/registry.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/server/registry.c b/server/registry.c
index bb7897e..5dd507c 100644
--- a/server/registry.c
+++ b/server/registry.c
@@ -120,6 +120,8 @@ struct key_value
 
 /* the root of the registry tree */
 static struct key *root_key;
+/* HKCU\Software: shared by both views (only Software\Classes has a 32-bit view) */
+static struct key *hkcu_software;
 
 static const timeout_t ticks_1601_to_1970 = (timeout_t)86400 * (369 * 365 + 89) * TICKS_PER_SEC;
 static const timeout_t save_period = 30 * -TICKS_PER_SEC;  /* delay between periodic saves */
@@ -606,7 +608,8 @@ static int key_link_name( struct object *obj, struct object_name *name, struct o
         parent_key->subkeys[i] = parent_key->subkeys[i - 1];
     parent_key->subkeys[index] = (struct key *)grab_object( key );
     if (is_wow6432node( name->name, name->len ) &&
-        !is_wow6432node( parent_key->obj.name->name, parent_key->obj.name->len ))
+        !is_wow6432node( parent_key->obj.name->name, parent_key->obj.name->len ) &&
+        parent_key != hkcu_software)
         parent_key->wow6432node = key;
     name->parent = parent;
     return 1;
@@ -1956,6 +1959,16 @@ void init_registry(void)
     free( current_user_path );
     load_init_registry_from_file( "user.reg", hkcu );
 
+    /* A Wow6432Node in HKCU\Software is an ordinary key, as on Windows, where
+     * 64-bit software creates it (Windows 7's Active Setup); 32-bit programs
+     * keep sharing HKCU\Software, Wine's settings among them. */
+    {
+        static const WCHAR software[] = {'S','o','f','t','w','a','r','e'};
+        struct unicode_str name = { software, sizeof(software) };
+        if ((hkcu_software = create_key_recursive( hkcu, &name, current_time )))
+            hkcu_software->wow6432node = NULL;
+    }
+
     /* set the shared flag on Software\Classes\Wow6432Node for all platforms */
     for (i = 1; i < supported_machines_count; i++)
     {
