From: Codex <codex@localhost>
Subject: [PATCH] comctl32: Windows 7's report view list views and headers

Purpose: lay out and draw report view list views of programs in the
Windows 7 shell session as Windows 7's comctl32 6 does, with the
Explorer window theme too.
Windows behavior (measured on Windows 7 SP1 with
tests/listview-layout.c and screenshots of the same test window):
- rows are as tall as the font plus four pixels, or a small icon plus
  one; the first column's icon and label start four pixels in, the
  icon as tall as the row (drawn centered), the text two pixels into
  the label;
- a themed header is at least as tall as the style's header item (24
  pixels), and its rest after the last item is HP_HEADERITEMRIGHT
  (Aero's Explorer::Header leaves the part to the class's image: a
  divider next to the last item, a white edge, the item gradient
  starting a row higher);
- with SetWindowTheme(L"Explorer"), a selected row has the style's
  list item behind it (LISS_SELECTED, or LISS_SELECTEDNOTFOCUS when
  unfocused with LVS_SHOWSELALWAYS) and keeps the normal text color;
  each column ends in the style's column detail line, from the header
  to the bottom, under the rows; the item under the mouse has the hot
  state (LISS_HOT, or LISS_HOTSELECTED when selected, focused or not),
  with or without LVS_EX_TRACKSELECT.
Wine before: rows of the font plus one, icons and labels two pixels
in, a header as tall as its font, and the classic highlight; the hot
item was only tracked for the hot-tracking styles and never drawn.
Change: as above, for the Windows 7 shell session (WIN4WINE_SHELL=win7,
Common Controls 6). Explorer-themed report views follow the item under
the mouse (TME_LEAVE clears it), and an item's invalidation reaches the
row's left edge, where the themed row starts.
Evidence: the test window's list view, its header included, matches
Windows 7's apart from ClearType's colors; tests/listview-layout.c gives
Windows 7's rectangles; tests/theme-part-pixels.c draws
HP_HEADERITEMRIGHT identically on Windows 7 and in Wine; lvsel.exe (four
list views) with the mouse over an item, a selected item and an
unfocused selected item has the same backgrounds as Windows 7.
Scope: Windows 7 shell session only.
---
 dlls/comctl32/header.c   |  29 ++++++++++-
 dlls/comctl32/listview.c | 132 +++++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 156 insertions(+), 5 deletions(-)

diff --git a/dlls/comctl32/header.c b/dlls/comctl32/header.c
index 2543e0a..96d953f 100644
--- a/dlls/comctl32/header.c
+++ b/dlls/comctl32/header.c
@@ -629,6 +629,14 @@ static void HEADER_DrawRestBackground(HEADER_INFO *infoPtr, HDC hdc, RECT *rect)
 #if __WINE_COMCTL32_VERSION == 6
     HTHEME theme = GetWindowTheme(infoPtr->hwndSelf);
 
+    /* Windows 7 SP1 draws the rest with the right item part, which Aero's
+     * Explorer::Header leaves to the class's image (its divider next to the
+     * last item), seen with tests/theme-part-pixels.c */
+    if (theme && COMCTL32_IsWin7Shell())
+    {
+        DrawThemeBackground(theme, hdc, HP_HEADERITEMRIGHT, HIRS_NORMAL, rect, NULL);
+        return;
+    }
     if (theme)
     {
         DrawThemeBackground(theme, hdc, HP_HEADERITEM, HIS_NORMAL, rect, NULL);
@@ -1492,9 +1500,26 @@ HEADER_InsertItemT (HEADER_INFO *infoPtr, INT nItem, const HDITEMW *phdi, BOOL b
 }
 
 
+/* Windows 7 SP1 (tests/listview-layout.c): a themed header is at least as
+ * tall as the style's header item */
+static INT HEADER_GetHeight (const HEADER_INFO *infoPtr)
+{
+#if __WINE_COMCTL32_VERSION == 6
+    HTHEME theme = GetWindowTheme (infoPtr->hwndSelf);
+    SIZE size;
+
+    if (theme && COMCTL32_IsWin7Shell() &&
+        SUCCEEDED(GetThemePartSize (theme, NULL, HP_HEADERITEM, HIS_NORMAL, NULL, TS_TRUE, &size)))
+        return max (infoPtr->nHeight, size.cy);
+#endif
+    return infoPtr->nHeight;
+}
+
 static LRESULT
 HEADER_Layout (HEADER_INFO *infoPtr, LPHDLAYOUT lpLayout)
 {
+    INT height = HEADER_GetHeight (infoPtr);
+
     lpLayout->pwpos->hwndInsertAfter = 0;
     lpLayout->pwpos->x = lpLayout->prc->left;
     lpLayout->pwpos->y = lpLayout->prc->top;
@@ -1502,8 +1527,8 @@ HEADER_Layout (HEADER_INFO *infoPtr, LPHDLAYOUT lpLayout)
     if (infoPtr->dwStyle & HDS_HIDDEN)
         lpLayout->pwpos->cy = 0;
     else {
-        lpLayout->pwpos->cy = infoPtr->nHeight;
-        lpLayout->prc->top += infoPtr->nHeight;
+        lpLayout->pwpos->cy = height;
+        lpLayout->prc->top += height;
     }
     lpLayout->pwpos->flags = SWP_NOZORDER;
 
diff --git a/dlls/comctl32/listview.c b/dlls/comctl32/listview.c
index f91e63f..e2d48e0 100644
--- a/dlls/comctl32/listview.c
+++ b/dlls/comctl32/listview.c
@@ -1085,6 +1085,38 @@ static inline DWORD notify_customdraw (const LISTVIEW_INFO *infoPtr, DWORD dwDra
     return result;
 }
 
+/* Windows 7 (comctl32 6 in the Windows 7 shell session, measured on SP1
+ * with tests/listview-layout.c and screenshots): report view rows are as
+ * tall as the font plus four pixels (or a small icon plus one), the first
+ * column's icon and label start four pixels in, the text two pixels into
+ * the label; with the Explorer window
+ * theme the style's list item lies behind a selected row (the selected look
+ * whatever the focus unless LVS_SHOWSELALWAYS) and its column detail line
+ * ends each column. */
+static BOOL win7_listview(void)
+{
+#if __WINE_COMCTL32_VERSION == 6
+    return COMCTL32_IsWin7Shell();
+#else
+    return FALSE;
+#endif
+}
+
+#if __WINE_COMCTL32_VERSION == 6
+static HTHEME explorer_theme(const LISTVIEW_INFO *infoPtr)
+{
+    HTHEME theme;
+
+    if (!win7_listview() || !(theme = GetWindowTheme(infoPtr->hwndSelf))) return NULL;
+    return IsThemePartDefined(theme, LVP_LISTITEM, 0) ? theme : NULL;
+}
+#else
+static inline void *explorer_theme(const LISTVIEW_INFO *infoPtr)
+{
+    return NULL;
+}
+#endif
+
 static void prepaint_setup (const LISTVIEW_INFO *infoPtr, HDC hdc, const NMLVCUSTOMDRAW *cd, BOOL SubItem)
 {
     COLORREF backcolor, textcolor;
@@ -1093,7 +1125,7 @@ static void prepaint_setup (const LISTVIEW_INFO *infoPtr, HDC hdc, const NMLVCUS
     textcolor = cd->clrText;
 
     /* apparently, for selected items, we have to override the returned values */
-    if (!SubItem)
+    if (!SubItem && !explorer_theme(infoPtr))
     {
         if (cd->nmcd.uItemState & CDIS_SELECTED)
         {
@@ -1760,6 +1792,8 @@ static inline void LISTVIEW_InvalidateItem(const LISTVIEW_INFO *infoPtr, INT nIt
         return;
 
     LISTVIEW_GetItemBox(infoPtr, nItem, &rcBox);
+    /* the themed row starts left of the item box */
+    if (explorer_theme(infoPtr) && infoPtr->uView == LV_VIEW_DETAILS) rcBox.left = infoPtr->rcList.left;
     LISTVIEW_InvalidateRect(infoPtr, &rcBox);
 }
 
@@ -2427,7 +2461,7 @@ static void LISTVIEW_GetItemMetrics(const LISTVIEW_INFO *infoPtr, const LVITEMW
 	    {
 		/* we need the indent in report mode */
 		assert(lpLVItem->mask & LVIF_INDENT);
-		Icon.left += infoPtr->iconSize.cx * lpLVItem->iIndent + REPORT_MARGINX;
+		Icon.left += infoPtr->iconSize.cx * lpLVItem->iIndent + (win7_listview() ? 4 : REPORT_MARGINX);
 	    }
 
 	    Icon.top    = Box.top;
@@ -2437,6 +2471,9 @@ static void LISTVIEW_GetItemMetrics(const LISTVIEW_INFO *infoPtr, const LVITEMW
                  ((infoPtr->dwLvExStyle & LVS_EX_SUBITEMIMAGES) && lpLVItem->iImage != I_IMAGECALLBACK)))
 		Icon.right += infoPtr->iconSize.cx;
 	    Icon.bottom = Icon.top + infoPtr->iconSize.cy;
+	    /* as tall as the row on Windows 7 */
+	    if (win7_listview() && infoPtr->uView == LV_VIEW_DETAILS)
+		Icon.bottom = Icon.top + infoPtr->nItemHeight;
 	}
 	if(lprcIcon) *lprcIcon = Icon;
 	TRACE("    - icon=%s\n", wine_dbgstr_rect(&Icon));
@@ -3024,6 +3061,8 @@ static INT LISTVIEW_CalculateItemHeight(const LISTVIEW_INFO *infoPtr)
     else
     {
 	nItemHeight = infoPtr->ntmHeight;
+	if (win7_listview() && infoPtr->uView == LV_VIEW_DETAILS)
+	    nItemHeight += 3;
 	if (infoPtr->himlState)
 	    nItemHeight = max(nItemHeight, infoPtr->iconStateSize.cy);
 	if (infoPtr->himlSmall)
@@ -4034,6 +4073,35 @@ static VOID CALLBACK LISTVIEW_ScrollTimer(HWND hWnd, UINT uMsg, UINT_PTR idEvent
     }
 }
 
+/* Windows 7's Explorer-themed list views light the item under the mouse;
+ * pt is NULL when the mouse leaves */
+static void LISTVIEW_TrackHotItem(LISTVIEW_INFO *infoPtr, const POINT *pt)
+{
+    INT item = -1, old = infoPtr->nHotItem;
+
+    if (!explorer_theme(infoPtr) || infoPtr->uView != LV_VIEW_DETAILS) return;
+    if (pt)
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_QUERY };
+        LVHITTESTINFO ht;
+
+        ht.pt = *pt;
+        item = LISTVIEW_HitTest(infoPtr, &ht, FALSE, TRUE);
+        _TrackMouseEvent(&tme);
+        if (!(tme.dwFlags & TME_LEAVE) || tme.hwndTrack != infoPtr->hwndSelf)
+        {
+            tme.dwFlags = TME_LEAVE | (tme.hwndTrack == infoPtr->hwndSelf ? tme.dwFlags : 0);
+            tme.hwndTrack = infoPtr->hwndSelf;
+            tme.dwHoverTime = infoPtr->dwHoverTime;
+            _TrackMouseEvent(&tme);
+        }
+    }
+    if (item == old) return;
+    infoPtr->nHotItem = item;
+    if (old != -1) LISTVIEW_InvalidateItem(infoPtr, old);
+    if (item != -1) LISTVIEW_InvalidateItem(infoPtr, item);
+}
+
 /***
  * DESCRIPTION:
  * Called whenever WM_MOUSEMOVE is received.
@@ -4055,6 +4123,8 @@ static LRESULT LISTVIEW_MouseMove(LISTVIEW_INFO *infoPtr, WORD fwKeys, INT x, IN
     pt.x = x;
     pt.y = y;
 
+    LISTVIEW_TrackHotItem(infoPtr, infoPtr->bMarqueeSelect ? NULL : &pt);
+
     if (!(fwKeys & MK_LBUTTON))
         infoPtr->bLButtonDown = FALSE;
 
@@ -4674,7 +4744,10 @@ static void LISTVIEW_DrawItemPart(LISTVIEW_INFO *infoPtr, LVITEMW *item, const N
     else
         background = &rcSelect;
 
-    if (nmlvcd->clrTextBk != CLR_NONE)
+    /* an Explorer-themed row keeps the erased background with its column
+     * lines, and a selected one the list item */
+    if (nmlvcd->clrTextBk != CLR_NONE &&
+        !(explorer_theme(infoPtr) && ((item->state & LVIS_SELECTED) || nmlvcd->clrTextBk == CLR_DEFAULT)))
         ExtTextOutW(nmlvcd->nmcd.hdc, background->left, background->top, ETO_OPAQUE, background, NULL, 0, NULL);
 
     if (item->state & LVIS_FOCUSED)
@@ -4731,6 +4804,12 @@ static void LISTVIEW_DrawItemPart(LISTVIEW_INFO *infoPtr, LVITEMW *item, const N
         else
             style = ILD_NORMAL;
 
+        /* centered in a Windows 7 row */
+        if (win7_listview() && infoPtr->uView == LV_VIEW_DETAILS)
+        {
+            rcIcon.top += (rcIcon.bottom - rcIcon.top - infoPtr->iconSize.cy) / 2;
+            rcIcon.bottom = rcIcon.top + infoPtr->iconSize.cy;
+        }
         ImageList_DrawEx(himl, item->iImage, nmlvcd->nmcd.hdc, rcIcon.left, rcIcon.top,
                          rcIcon.right - rcIcon.left, rcIcon.bottom - rcIcon.top, infoPtr->clrBk,
                          item->state & LVIS_CUT ? RGB(255, 255, 255) : CLR_DEFAULT,
@@ -4756,6 +4835,7 @@ static void LISTVIEW_DrawItemPart(LISTVIEW_INFO *infoPtr, LVITEMW *item, const N
     if (!(format & (DT_RIGHT | DT_CENTER)))
     {
         if (himl && item->iImage >= 0 && !IsRectEmpty(&rcIcon)) rcLabel.left += IMAGE_PADDING;
+        else if (win7_listview() && infoPtr->uView == LV_VIEW_DETAILS) rcLabel.left += 2;
         else rcLabel.left += LABEL_HOR_PADDING;
     }
     else if (format & DT_RIGHT) rcLabel.right -= LABEL_HOR_PADDING;
@@ -4836,6 +4916,22 @@ static BOOL LISTVIEW_DrawItem(LISTVIEW_INFO *infoPtr, HDC hdc, INT nItem, ITERAT
         cdsubitemmode = notify_customdraw(infoPtr, CDDS_ITEMPREPAINT, &nmlvcd);
     if (cdsubitemmode & CDRF_SKIPDEFAULT) goto postpaint;
 
+#if __WINE_COMCTL32_VERSION == 6
+    if (explorer_theme(infoPtr) && infoPtr->uView == LV_VIEW_DETAILS &&
+        ((lvItem.state & LVIS_SELECTED) || lvItem.iItem == infoPtr->nHotItem))
+    {
+        RECT row = rcBox;
+        int state = !(lvItem.state & LVIS_SELECTED) ? LISS_HOT :
+                    lvItem.iItem == infoPtr->nHotItem ? LISS_HOTSELECTED :
+                    infoPtr->bFocus || !(infoPtr->dwStyle & LVS_SHOWSELALWAYS) ? LISS_SELECTED : LISS_SELECTEDNOTFOCUS;
+
+        if (!(infoPtr->dwLvExStyle & LVS_EX_FULLROWSELECT) && DPA_GetPtrCount(infoPtr->hdpaColumns) > 0)
+            row.right = row.left + LISTVIEW_GetColumnInfo(infoPtr, 0)->rcHeader.right -
+                        LISTVIEW_GetColumnInfo(infoPtr, 0)->rcHeader.left;
+        DrawThemeBackground(explorer_theme(infoPtr), hdc, LVP_LISTITEM, state, &row, NULL);
+    }
+#endif
+
     if (subitems)
     {
         while (iterator_next(subitems))
@@ -5054,6 +5150,27 @@ static void LISTVIEW_RefreshReport(LISTVIEW_INFO *infoPtr, ITERATOR *i, HDC hdc,
     iterator_destroy(&j);
 }
 
+#if __WINE_COMCTL32_VERSION == 6
+/* Windows 7's Explorer-themed report view: a column detail line ends each
+ * column, from the header to the bottom, under the items (see explorer_theme) */
+static void LISTVIEW_RefreshColumnDetails(LISTVIEW_INFO *infoPtr, HDC hdc)
+{
+    HTHEME theme = explorer_theme(infoPtr);
+    POINT origin;
+    RECT rect;
+    INT col;
+
+    LISTVIEW_GetOrigin(infoPtr, &origin);
+    for (col = 0; col < DPA_GetPtrCount(infoPtr->hdpaColumns); col++)
+    {
+        LISTVIEW_GetHeaderRect(infoPtr, col, &rect);
+        if (rect.right <= rect.left) continue;
+        SetRect(&rect, rect.right + origin.x - 2, infoPtr->rcList.top, rect.right + origin.x, infoPtr->rcList.bottom);
+        DrawThemeBackground(theme, hdc, LVP_COLUMNDETAIL, 0, &rect, NULL);
+    }
+}
+#endif
+
 /***
  * DESCRIPTION:
  * Draws the gridlines if necessary when in report display mode.
@@ -5283,6 +5400,11 @@ static void LISTVIEW_Refresh(LISTVIEW_INFO *infoPtr, HDC hdc, const RECT *prcEra
     	notify_hdr(infoPtr, LVN_ODCACHEHINT, &nmlv.hdr);
     }
 
+#if __WINE_COMCTL32_VERSION == 6
+    /* under the items, which a selected row's list item shows through */
+    if (infoPtr->uView == LV_VIEW_DETAILS && explorer_theme(infoPtr))
+        LISTVIEW_RefreshColumnDetails(infoPtr, hdc);
+#endif
     if ((infoPtr->dwStyle & LVS_OWNERDRAWFIXED) && (infoPtr->uView == LV_VIEW_DETAILS))
 	LISTVIEW_RefreshOwnerDraw(infoPtr, &i, hdc, cdmode);
     else
@@ -11869,6 +11991,10 @@ LISTVIEW_WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
   case WM_MOUSEHOVER:
     return LISTVIEW_MouseHover(infoPtr, (SHORT)LOWORD(lParam), (SHORT)HIWORD(lParam));
 
+  case WM_MOUSELEAVE:
+    LISTVIEW_TrackHotItem(infoPtr, NULL);
+    return 0;
+
   case WM_NCDESTROY:
     return LISTVIEW_NCDestroy(infoPtr);
 
