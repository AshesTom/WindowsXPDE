From: Codex <codex@localhost>
Subject: [PATCH] kernelbase: preserve the opt-in XP shell module name

Purpose: allow the renamed XP shell to find its own executable module.
XP behavior: native shell components call GetModuleHandleW("explorer.exe")
to retrieve the shell module. Our executable is named xp-explorer.exe to
isolate native DLL overrides from Wine's desktop manager and recovery shell.
Execution logs show the original-name queries fail with DLL_NOT_FOUND.
Alias only the bare original name in that process with the external-shell
opt-in environment variable. Preserve the normal refcount and flag handling.
This is a project-specific compatibility experiment, not a general Wine fix.

diff --git a/dlls/kernelbase/loader.c b/dlls/kernelbase/loader.c
index 7afbe04..8fa0701 100644
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -395,6 +395,19 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetModuleHandleExW( DWORD flags, LPCWSTR name, HMO
         return FALSE;
     }
 
+    /* The opt-in XP shell is renamed to isolate its native DLL overrides. */
+    if (name && !(flags & GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS)
+        && !wcsicmp( name, L"explorer.exe" )
+        && GetEnvironmentVariableW( L"WIN4WINE_EXTERNAL_SHELL", NULL, 0 ))
+    {
+        WCHAR path[MAX_PATH], *basename;
+
+        if (GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) )
+            && (basename = wcsrchr( path, '\\' ))
+            && !wcsicmp( basename + 1, L"xp-explorer.exe" ))
+            name = NULL;
+    }
+
     if (name && !(flags & GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS))
     {
         UNICODE_STRING wstr;
