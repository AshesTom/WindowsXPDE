diff --git a/dlls/uxtheme/rebar.c b/dlls/uxtheme/rebar.c
new file mode 100644
--- /dev/null
+++ b/dlls/uxtheme/rebar.c
@@ -0,0 +1,115 @@
+/*
+ * Native external taskbar ReBar theming using its public band geometry.
+ *
+ * Copyright 2026 Win4Wine contributors
+ *
