From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: resize, place and select theme images like XP in the external shell

Purpose: match XP's pixels wherever a theme image is resized or a glyph
placed.
XP behavior:
- the theme manager resizes images itself, taking for each destination
  pixel the source pixel under its centre, and the lower one when the
  centre falls on a boundary (the Start button keeps rows 0, 2 and 4 of its
  six middle rows shrunk to three, which neither StretchBlt nor
  TransparentBlt does);
- when a destination is smaller than both sizing margins, it shrinks them
  in proportion to each other and scales the source margins into them;
- size-selected glyphs are chosen and centred inside the content margins
  (a 21x21 Luna caption button uses its 13x13 glyph), on the difference
  between the rectangle and the glyph.
Wine before: stretched with HALFTONE, divided the margins by the whole image
width and cropped the corners (a 6 pixel toolbar separator had its line one
pixel right, narrower ones lost it), chose glyphs by the outer rectangle
(19x19) and centred each size separately (an odd glyph in an even rectangle
sat one pixel lower).
Change: the same as XP. A resized part is copied once in 32 bpp and picked
pixel by pixel from that copy.
Evidence: tests/margin-shrink.c prints XP's pixels for Luna's separators and
gripper at widths 1 to 12; the folder window's separators, the Start button
background, the address bar's drop-down button and an active close button
equal XP's on screen.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0046, 0061, 0063.
---
 dlls/uxtheme/draw.c | 135 ++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 132 insertions(+), 3 deletions(-)

diff --git a/dlls/uxtheme/draw.c b/dlls/uxtheme/draw.c
index e205736..40c4480 100644
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -336,14 +336,72 @@ static HRESULT UXTHEME_LoadImage(HTHEME hTheme, int iPartId, int iStateId, const
     return S_OK;
 }
 
+static BOOL UXTHEME_StretchBlt(HDC hdcDst, int nXOriginDst, int nYOriginDst, int nWidthDst, int nHeightDst,
+                               HDC hdcSrc, int nXOriginSrc, int nYOriginSrc, int nWidthSrc, int nHeightSrc,
+                               INT transparent, COLORREF transcolor);
+
+/* XP's theme manager resizes images itself: each destination pixel takes the
+ * source pixel under its centre, the lower one when the centre falls on a
+ * boundary. That keeps rows 0, 2 and 4 of six shrunk to three, as XP's Start
+ * button shows, where GDI's colour-keyed stretch keeps rows 1, 3 and 5. */
+static int xp_stretch_source(int d, int src, int dst)
+{
+    return (int)(((2LL * d + 1) * src + 2LL * dst - 1) / (2LL * dst)) - 1;
+}
+
+static BOOL xp_stretch(HDC hdcDst, int x, int y, int width, int height, HDC hdcSrc, int xs, int ys,
+                       int src_width, int src_height, INT transparent, COLORREF transcolor)
+{
+    BITMAPINFO info = {{sizeof(BITMAPINFOHEADER)}};
+    HDC source = CreateCompatibleDC(hdcSrc), rows = CreateCompatibleDC(hdcSrc);
+    HBITMAP source_bitmap = NULL, row_bitmap = NULL;
+    HGDIOBJ old_source = NULL, old_rows = NULL;
+    DWORD *source_bits, *row_bits;
+    int *columns = NULL, i, j;
+    BOOL ret = FALSE;
+
+    /* The part is copied once in 32 bpp, which converts it as a blit of each
+     * column and row would, and then picked pixel by pixel. */
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biWidth = src_width;
+    info.bmiHeader.biHeight = -src_height;
+    if (!source || !rows || !(columns = malloc(width * sizeof(*columns))) ||
+        !(source_bitmap = CreateDIBSection(source, &info, DIB_RGB_COLORS, (void **)&source_bits, NULL, 0)))
+        goto done;
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    if (!(row_bitmap = CreateDIBSection(rows, &info, DIB_RGB_COLORS, (void **)&row_bits, NULL, 0))) goto done;
+    old_source = SelectObject(source, source_bitmap);
+    old_rows = SelectObject(rows, row_bitmap);
+    if (!BitBlt(source, 0, 0, src_width, src_height, hdcSrc, xs, ys, SRCCOPY)) goto done;
+    GdiFlush();
+    for (i = 0; i < width; i++) columns[i] = xp_stretch_source(i, src_width, width);
+    for (j = 0; j < height; j++)
+    {
+        const DWORD *line = source_bits + xp_stretch_source(j, src_height, height) * src_width;
+        for (i = 0; i < width; i++) row_bits[j * width + i] = line[columns[i]];
+    }
+    ret = UXTHEME_StretchBlt(hdcDst, x, y, width, height, rows, 0, 0, width, height, transparent, transcolor);
+done:
+    free(columns);
+    if (old_source) SelectObject(source, old_source);
+    if (old_rows) SelectObject(rows, old_rows);
+    if (source_bitmap) DeleteObject(source_bitmap);
+    if (row_bitmap) DeleteObject(row_bitmap);
+    if (source) DeleteDC(source);
+    if (rows) DeleteDC(rows);
+    return ret;
+}
+
 /***********************************************************************
  *      UXTHEME_StretchBlt
  *
  * Pseudo TransparentBlt/StretchBlt
  */
-static inline BOOL UXTHEME_StretchBlt(HDC hdcDst, int nXOriginDst, int nYOriginDst, int nWidthDst, int nHeightDst,
-                                      HDC hdcSrc, int nXOriginSrc, int nYOriginSrc, int nWidthSrc, int nHeightSrc,
-                                      INT transparent, COLORREF transcolor)
+static BOOL UXTHEME_StretchBlt(HDC hdcDst, int nXOriginDst, int nYOriginDst, int nWidthDst, int nHeightDst,
+                               HDC hdcSrc, int nXOriginSrc, int nYOriginSrc, int nWidthSrc, int nHeightSrc,
+                               INT transparent, COLORREF transcolor)
 {
     static const BLENDFUNCTION blendFunc = 
     {
@@ -357,6 +415,11 @@ static inline BOOL UXTHEME_StretchBlt(HDC hdcDst, int nXOriginDst, int nYOriginD
     int old_stretch_mode;
     POINT old_brush_org;
 
+    if ((nWidthDst != nWidthSrc || nHeightDst != nHeightSrc) && nWidthDst > 0 && nHeightDst > 0
+        && nWidthSrc > 0 && nHeightSrc > 0 && win4wine_external_shell())
+        return xp_stretch(hdcDst, nXOriginDst, nYOriginDst, nWidthDst, nHeightDst, hdcSrc, nXOriginSrc,
+                          nYOriginSrc, nWidthSrc, nHeightSrc, transparent, transcolor);
+
     old_stretch_mode = SetStretchBltMode(hdcDst, HALFTONE);
     SetBrushOrgEx(hdcDst, nXOriginDst, nYOriginDst, &old_brush_org);
 
@@ -594,6 +657,21 @@ static HRESULT UXTHEME_DrawImageGlyph(HTHEME hTheme, HDC hdc, int iPartId,
     POINT srcSize;
     POINT topleft;
     BOOL hasAlpha, hasDefaultTransparentColour;
+    RECT content;
+    MARGINS margins;
+
+    /* XP chooses and centres size-selected glyphs inside the content rectangle.
+     * A 21x21 Luna caption button has 2px content margins and uses its 13x13
+     * glyph; choosing by the outer rectangle selected the 19x19 glyph. */
+    if (win4wine_external_shell() &&
+        SUCCEEDED(GetThemeMargins(hTheme, hdc, iPartId, iStateId, TMT_CONTENTMARGINS, NULL, &margins)))
+    {
+        content.left = pRect->left + margins.cxLeftWidth;
+        content.top = pRect->top + margins.cyTopHeight;
+        content.right = pRect->right - margins.cxRightWidth;
+        content.bottom = pRect->bottom - margins.cyBottomHeight;
+        if (content.right > content.left && content.bottom > content.top) pRect = &content;
+    }
 
     hr = UXTHEME_LoadImage(hTheme, iPartId, iStateId, pRect, TRUE, &bmpSrc, &rcSrc, &hasAlpha,
                            &hasDefaultTransparentColour, NULL);
@@ -622,6 +700,13 @@ static HRESULT UXTHEME_DrawImageGlyph(HTHEME hTheme, HDC hdc, int iPartId,
     else if(halign == HA_RIGHT)  topleft.x += dstSize.x-srcSize.x;
     if(valign == VA_CENTER)      topleft.y += (dstSize.y/2)-(srcSize.y/2);
     else if(valign == VA_BOTTOM) topleft.y += dstSize.y-srcSize.y;
+    /* XP centres on the difference: an odd glyph in an even rectangle sits a
+     * pixel higher, as the ComboBox drop-down arrow does. */
+    if (pRect == &content)
+    {
+        if (halign == HA_CENTER) topleft.x = pRect->left + (dstSize.x - srcSize.x) / 2;
+        if (valign == VA_CENTER) topleft.y = pRect->top + (dstSize.y - srcSize.y) / 2;
+    }
 
     if(!UXTHEME_Blt(hdc, topleft.x, topleft.y, srcSize.x, srcSize.y,
                     hdcSrc, rcSrc.left, rcSrc.top,
@@ -835,6 +920,49 @@ static HRESULT UXTHEME_DrawImageBackground(HTHEME hTheme, HDC hdc, int iPartId,
 
         GetThemeMargins(hTheme, hdc, iPartId, iStateId, TMT_SIZINGMARGINS, NULL, &sm);
 
+        /* XP shrinks the margins in proportion to each other when the destination
+         * is smaller than both of them, and scales the source margins into them;
+         * measured with Luna's toolbar separator, which XP draws narrower than 7. */
+        if ((sm.cyTopHeight + sm.cyBottomHeight > dstSize.y || sm.cxLeftWidth + sm.cxRightWidth > dstSize.x)
+            && win4wine_external_shell()) {
+            BOOL shrink_x = sm.cxLeftWidth + sm.cxRightWidth > dstSize.x;
+            BOOL shrink_y = sm.cyTopHeight + sm.cyBottomHeight > dstSize.y;
+            BOOL borderonly = FALSE;
+            int src_x[4], src_y[4], dst_x[4], dst_y[4], i, j;
+
+            src_x[0] = 0; src_x[1] = sm.cxLeftWidth; src_x[2] = srcSize.x - sm.cxRightWidth; src_x[3] = srcSize.x;
+            src_y[0] = 0; src_y[1] = sm.cyTopHeight; src_y[2] = srcSize.y - sm.cyBottomHeight; src_y[3] = srcSize.y;
+            dst_x[0] = 0; dst_x[3] = dstSize.x;
+            dst_y[0] = 0; dst_y[3] = dstSize.y;
+            dst_x[1] = shrink_x ? sm.cxLeftWidth * dstSize.x / (sm.cxLeftWidth + sm.cxRightWidth) : sm.cxLeftWidth;
+            dst_x[2] = shrink_x ? dst_x[1] : dstSize.x - sm.cxRightWidth;
+            dst_y[1] = shrink_y ? sm.cyTopHeight * dstSize.y / (sm.cyTopHeight + sm.cyBottomHeight) : sm.cyTopHeight;
+            dst_y[2] = shrink_y ? dst_y[1] : dstSize.y - sm.cyBottomHeight;
+            GetThemeBool(hTheme, iPartId, iStateId, TMT_BORDERONLY, &borderonly);
+
+            OffsetViewportOrgEx(hdc, rcDst.left, rcDst.top, &org);
+            for (j = 0; j < 3; j++)
+                for (i = 0; i < 3; i++)
+                {
+                    int dw = dst_x[i + 1] - dst_x[i], dh = dst_y[j + 1] - dst_y[j];
+                    int sw = src_x[i + 1] - src_x[i], sh = src_y[j + 1] - src_y[j];
+                    BOOL ok;
+                    if (dw <= 0 || dh <= 0 || sw <= 0 || sh <= 0 || (i == 1 && j == 1 && borderonly)) continue;
+                    if (dw == sw && dh == sh)
+                        ok = UXTHEME_Blt(hdc, dst_x[i], dst_y[j], dw, dh, hdcSrc, rcSrc.left + src_x[i],
+                                         rcSrc.top + src_y[j], transparent, transparentcolor);
+                    else if ((i == 1 || j == 1) && !(shrink_x && i != 1) && !(shrink_y && j != 1))
+                        ok = UXTHEME_SizedBlt(hdc, dst_x[i], dst_y[j], dw, dh, hdcSrc, rcSrc.left + src_x[i],
+                                              rcSrc.top + src_y[j], sw, sh, sizingtype, transparent, transparentcolor);
+                    else
+                        ok = UXTHEME_StretchBlt(hdc, dst_x[i], dst_y[j], dw, dh, hdcSrc, rcSrc.left + src_x[i],
+                                                rcSrc.top + src_y[j], sw, sh, transparent, transparentcolor);
+                    if (!ok && SUCCEEDED(hr)) hr = HRESULT_FROM_WIN32(GetLastError());
+                }
+            SetViewportOrgEx(hdc, org.x, org.y, NULL);
+            goto done;
+        }
+
         /* Resize sizing margins if destination is smaller */
         if (sm.cyTopHeight + sm.cyBottomHeight > dstSize.y || sm.cxLeftWidth + sm.cxRightWidth > dstSize.x) {
             if (sm.cyTopHeight + sm.cyBottomHeight > dstSize.y) {
@@ -948,6 +1076,7 @@ static HRESULT UXTHEME_DrawImageBackground(HTHEME hTheme, HDC hdc, int iPartId,
 draw_error:
         SetViewportOrgEx (hdcDst, org.x, org.y, NULL);
     }
+done:
     SelectObject(hdcSrc, oldSrc);
     LeaveCriticalSection(&image_section);
     DeleteDC(hdcSrc);
