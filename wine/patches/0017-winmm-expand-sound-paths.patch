From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] winmm: expand environment variables in sound file paths

Purpose: XP's sounds play: Explorer's navigation click, balloons, errors,
logon and logoff (the sound scheme from the user's HIVEDEF.INF).
Windows behavior: the sound scheme stores REG_EXPAND_SZ paths such as
"%SystemRoot%\media\Windows XP Start.wav", and PlaySound opens them, from the
scheme (SND_ALIAS) or when the program passes the path itself (SND_FILENAME,
as XP's Explorer does for balloons).
Wine before: the path was opened as it is, so nothing played; the scheme's
paths were also read into 128 characters.
Change: a path with '%' is expanded with ExpandEnvironmentStrings when it
does not open as given; the scheme's paths go through the same function and
may have MAX_PATH characters.
Scope: PlaySound with paths containing '%'.
---
 dlls/winmm/playsound.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/dlls/winmm/playsound.c b/dlls/winmm/playsound.c
index bd26bf4..ba5269f 100644
--- a/dlls/winmm/playsound.c
+++ b/dlls/winmm/playsound.c
@@ -53,12 +53,17 @@ static BOOL bPlaySoundStop;
 static HMMIO	get_mmioFromFile(LPCWSTR lpszName)
 {
     HMMIO       ret;
-    WCHAR       buf[256];
+    WCHAR       buf[256], expanded[MAX_PATH];
     LPWSTR      dummy;
 
     ret = mmioOpenW((LPWSTR)lpszName, NULL,
                     MMIO_ALLOCBUF | MMIO_READ | MMIO_DENYWRITE);
     if (ret != 0) return ret;
+    /* As Windows: a path with environment variables, as XP's sound scheme has
+     * them ("%SystemRoot%\media\Windows XP Start.wav"). */
+    if (wcschr(lpszName, '%') && ExpandEnvironmentStringsW(lpszName, expanded, ARRAY_SIZE(expanded)) &&
+        (ret = mmioOpenW(expanded, NULL, MMIO_ALLOCBUF | MMIO_READ | MMIO_DENYWRITE)))
+        return ret;
     if (SearchPathW(NULL, lpszName, L".wav", ARRAY_SIZE(buf), buf, &dummy))
     {
         return mmioOpenW(buf, NULL,
@@ -69,7 +74,7 @@ static HMMIO	get_mmioFromFile(LPCWSTR lpszName)
 
 static HMMIO	get_mmioFromProfile(UINT uFlags, LPCWSTR lpszName)
 {
-    WCHAR	str[128];
+    WCHAR	str[MAX_PATH];
     LPWSTR	ptr;
     HMMIO  	hmmio;
     HKEY        hRegSnd, hRegApp, hScheme, hSnd;
@@ -134,7 +139,7 @@ static HMMIO	get_mmioFromProfile(UINT uFlags, LPCWSTR lpszName)
     err = RegQueryValueExW(hSnd, NULL, 0, &type, (LPBYTE)str, &count);
     RegCloseKey(hSnd);
     if (err != 0 || !*str) goto none;
-    hmmio = mmioOpenW(str, NULL, MMIO_ALLOCBUF | MMIO_READ | MMIO_DENYWRITE);
+    hmmio = get_mmioFromFile(str);
     if (hmmio) return hmmio;
  none:
     WARN("can't find SystemSound=%s !\n", debugstr_w(lpszName));
