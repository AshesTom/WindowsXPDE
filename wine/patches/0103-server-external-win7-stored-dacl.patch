From: Codex <codex@localhost>
Subject: [PATCH] server: keep the DACL of files for Windows 7's shell

Purpose: stop Windows 7's shell from reporting "C:\ のごみ箱が壊れています" at
every start.
Windows 7 behavior: shell32 creates C:\$RECYCLE.BIN\<user SID> with the
DACL D:P(A;CIOI;GA;;;BA)(A;CIOI;GA;;;SY)(A;CIOI;GA;;;<user SID>), and at
start it reads the folder's security (NtQuerySecurityObject) and compares
the DACL with that one. On a mismatch it asks to empty the broken recycle
bin.
Wine before: the server does not keep a file's security descriptor; it
builds one from the Unix mode (two ACEs), so the comparison always failed.
Change: when the server runs with WIN4WINE_SHELL=win7 and the
WIN4WINE_EXTERNAL_SHELL opt-in, the DACL given when
a file or directory is created (FILE_CREATE, FILE_SUPERSEDE,
FILE_OVERWRITE_IF) or set with DACL_SECURITY_INFORMATION is kept in the
user.wine.dacl extended attribute (the DACL control flags, then the ACL),
and reading the security returns it with the owner and group made from
the Unix owner as before. The Unix mode is still set from the DACL as
before.
Evidence: with WIN4WINE_SHELL=win7, a recreated recycle bin folder carries
the three ACEs and the message no longer appears.
Scope: only in the Windows 7 shell session; elsewhere nothing is stored or
read, and XP and ReactOS sessions behave as before.
---
 server/change.c | 12 +++++++++-
 server/fd.c     | 70 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 server/file.c   | 15 ++++++++++++-
 server/file.h   |  2 ++
 4 files changed, 97 insertions(+), 2 deletions(-)

diff --git a/server/change.c b/server/change.c
index 5bcd067..2e522e4 100644
--- a/server/change.c
+++ b/server/change.c
@@ -335,7 +335,7 @@ static struct security_descriptor *dir_get_sd( struct object *obj )
     struct dir *dir = (struct dir *)obj;
     int unix_fd;
     struct stat st;
-    struct security_descriptor *sd;
+    struct security_descriptor *sd, *stored;
     assert( obj->ops == &dir_ops );
 
     unix_fd = get_dir_unix_fd( dir );
@@ -353,6 +353,11 @@ static struct security_descriptor *dir_get_sd( struct object *obj )
                      security_unix_uid_to_sid( st.st_uid ),
                      token_get_primary_group( current->process->token ));
     if (!sd) return obj->sd;
+    if ((stored = get_stored_dacl_sd( unix_fd, sd )))
+    {
+        free( sd );
+        sd = stored;
+    }
 
     dir->mode = st.st_mode;
     dir->uid = st.st_uid;
@@ -405,6 +410,11 @@ static int dir_set_sd( struct object *obj, const struct security_descriptor *sd,
             file_set_error();
             return 0;
         }
+        if (store_dacl( unix_fd, sd ))
+        {
+            free( obj->sd );
+            obj->sd = NULL;
+        }
     }
     return 1;
 }
diff --git a/server/fd.c b/server/fd.c
index f70bec3..e2f9e65 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -101,6 +101,7 @@
 #include "handle.h"
 #include "process.h"
 #include "request.h"
+#include "security.h"
 
 #include "winternl.h"
 #include "winioctl.h"
@@ -2464,6 +2465,75 @@ static int xattr_fremove( int filedes, const char *name )
 #endif
 }
 
+#define XATTR_DACL XATTR_USER_PREFIX "wine.dacl"
+
+/* With the Windows 7 shell (WIN4WINE_SHELL=win7, with the WIN4WINE_EXTERNAL_SHELL
+ * opt-in), the DACL given to a file or directory is kept in an extended attribute
+ * and returned instead of the one made from the Unix mode: Windows 7's shell checks
+ * the DACL of the folders it creates, such as the recycle bin. */
+static int stored_dacl_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *shell = getenv( "WIN4WINE_SHELL" );
+        enabled = getenv( "WIN4WINE_EXTERNAL_SHELL" ) && shell && !strcasecmp( shell, "win7" );
+    }
+    return enabled;
+}
+
+int store_dacl( int unix_fd, const struct security_descriptor *sd )
+{
+    const struct acl *dacl;
+    unsigned int control;
+    char *buffer;
+    int present, ret;
+
+    if (!stored_dacl_enabled() || unix_fd == -1) return 0;
+    dacl = sd_get_dacl( sd, &present );
+    if (!present || !dacl || sd->dacl_len < sizeof(*dacl) || dacl->size > sd->dacl_len) return 0;
+    if (!(buffer = malloc( sizeof(control) + dacl->size ))) return 0;
+    control = sd->control & (SE_DACL_AUTO_INHERITED | SE_DACL_PROTECTED);
+    memcpy( buffer, &control, sizeof(control) );
+    memcpy( buffer + sizeof(control), dacl, dacl->size );
+    ret = !xattr_fset( unix_fd, XATTR_DACL, buffer, sizeof(control) + dacl->size );
+    free( buffer );
+    return ret;
+}
+
+/* returns a copy of mode_sd with the stored DACL, or NULL if there is none */
+struct security_descriptor *get_stored_dacl_sd( int unix_fd, const struct security_descriptor *mode_sd )
+{
+    char buffer[4096];
+    struct security_descriptor *sd;
+    const struct acl *dacl;
+    unsigned int control;
+    char *ptr;
+    int size;
+
+    if (!stored_dacl_enabled() || unix_fd == -1) return NULL;
+    size = xattr_fget( unix_fd, XATTR_DACL, buffer, sizeof(buffer) );
+    if (size < (int)(sizeof(control) + sizeof(*dacl))) return NULL;
+    memcpy( &control, buffer, sizeof(control) );
+    dacl = (const struct acl *)(buffer + sizeof(control));
+    if (dacl->size != size - sizeof(control)) return NULL;
+
+    if (!(sd = mem_alloc( sizeof(*sd) + mode_sd->owner_len + mode_sd->group_len + dacl->size ))) return NULL;
+    sd->control = SE_DACL_PRESENT | control;
+    sd->owner_len = mode_sd->owner_len;
+    sd->group_len = mode_sd->group_len;
+    sd->sacl_len = 0;
+    sd->dacl_len = dacl->size;
+    ptr = (char *)(sd + 1);
+    memcpy( ptr, sd_get_owner( mode_sd ), sd->owner_len );
+    ptr += sd->owner_len;
+    if (sd->group_len) memcpy( ptr, sd_get_group( mode_sd ), sd->group_len );
+    ptr += sd->group_len;
+    memcpy( ptr, dacl, dacl->size );
+    return sd;
+}
+
 static void set_reparse_point( struct fd *fd, struct async *async )
 {
     char *reparse_name;
diff --git a/server/file.c b/server/file.c
index cc5acc2..ec21973 100644
--- a/server/file.c
+++ b/server/file.c
@@ -270,6 +270,9 @@ static struct object *create_file( struct fd *root, const char *nameptr, data_si
     fd = open_fd( root, name, nt_name, flags | O_NONBLOCK, &mode, access, sharing, options );
     if (!fd) goto done;
 
+    if (sd && (create == FILE_CREATE || create == FILE_SUPERSEDE || create == FILE_OVERWRITE_IF))
+        store_dacl( get_unix_fd( fd ), sd );
+
     if (S_ISDIR(mode))
         obj = create_dir_obj( fd, access, mode );
     else if (S_ISCHR(mode) && is_serial_fd( fd ))
@@ -390,7 +393,7 @@ static struct security_descriptor *file_get_sd( struct object *obj )
     struct file *file = (struct file *)obj;
     struct stat st;
     int unix_fd;
-    struct security_descriptor *sd;
+    struct security_descriptor *sd, *stored;
 
     assert( obj->ops == &file_ops );
 
@@ -408,6 +411,11 @@ static struct security_descriptor *file_get_sd( struct object *obj )
                      security_unix_uid_to_sid( st.st_uid ),
                      token_get_primary_group( current->process->token ));
     if (!sd) return obj->sd;
+    if ((stored = get_stored_dacl_sd( unix_fd, sd )))
+    {
+        free( sd );
+        sd = stored;
+    }
 
     file->mode = st.st_mode;
     file->uid = st.st_uid;
@@ -541,6 +549,11 @@ static int file_set_sd( struct object *obj, const struct security_descriptor *sd
             file_set_error();
             return 0;
         }
+        if (store_dacl( unix_fd, sd ))
+        {
+            free( obj->sd );
+            obj->sd = NULL;
+        }
     }
     return 1;
 }
diff --git a/server/file.h b/server/file.h
index e1485e4..81fd4a6 100644
--- a/server/file.h
+++ b/server/file.h
@@ -170,6 +170,8 @@ extern struct file *create_file_for_fd_obj( struct fd *fd, unsigned int access,
 extern void file_set_error(void);
 extern struct security_descriptor *mode_to_sd( mode_t mode, const struct sid *user, const struct sid *group );
 extern mode_t sd_to_mode( const struct security_descriptor *sd, const struct sid *owner );
+extern int store_dacl( int unix_fd, const struct security_descriptor *sd );
+extern struct security_descriptor *get_stored_dacl_sd( int unix_fd, const struct security_descriptor *mode_sd );
 extern int is_file_executable( const char *name );
 
 /* file mapping functions */
