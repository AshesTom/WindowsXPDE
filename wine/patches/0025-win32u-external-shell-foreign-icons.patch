+/* Runtime snapshots contain client pixels/metadata, no shared GDI handles.
+ * The server verifies owner, generation, dimensions and memory budgets. */
+static size_t shared_icon_size( const struct shared_icon_data *data )
+{
+    size_t size;
+    if (!data->width || !data->height || data->width > SHARED_ICON_MAX_DIM ||
+        data->height > SHARED_ICON_MAX_DIM ||
+        (data->flags & ~(SHARED_ICON_COLOR | SHARED_ICON_ALPHA | SHARED_ICON_RESOURCE)) ||
+        ((data->flags & SHARED_ICON_ALPHA) && !(data->flags & SHARED_ICON_COLOR)) ||
+        data->module_bytes > SHARED_ICON_MAX_STRING || data->name_bytes > SHARED_ICON_MAX_STRING ||
+        ((data->module_bytes | data->name_bytes) & 1) || data->name_id > 0xffff ||
+        (data->name_id && data->name_bytes)) return 0;
+    size = sizeof(*data) + ((data->width + 31) / 32 * 4) * data->height *
+           (data->flags & SHARED_ICON_COLOR ? 1 : 2);
+    if (data->flags & SHARED_ICON_COLOR) size += data->width * data->height * 4;
+    if (data->flags & SHARED_ICON_ALPHA) size += data->width * data->height * 4;
+    return size + data->module_bytes + data->name_bytes;
+}
+
+static void init_icon_bitmap_info( BITMAPINFO *info, UINT width, UINT height, UINT bpp )
+{
+    memset( info, 0, sizeof(BITMAPINFOHEADER) + 2 * sizeof(RGBQUAD) );
+    info->bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    info->bmiHeader.biWidth = width;
+    info->bmiHeader.biHeight = -(LONG)height;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = bpp;
+    info->bmiHeader.biCompression = BI_RGB;
+    if (bpp == 1)
+        info->bmiColors[1].rgbRed = info->bmiColors[1].rgbGreen = info->bmiColors[1].rgbBlue = 255;
+}
+
+static BOOL export_icon_bitmap( HDC dc, HBITMAP bitmap, UINT width, UINT height, UINT bpp, void *bits )
+{
+    char buffer[sizeof(BITMAPINFOHEADER) + 2 * sizeof(RGBQUAD)];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    UINT size = ((width * bpp + 31) / 32 * 4) * height;
+    init_icon_bitmap_info( info, width, height, bpp );
+    return NtGdiGetDIBitsInternal( dc, bitmap, 0, height, bits, info,
+                                 DIB_RGB_COLORS, size, sizeof(buffer) ) == height;
+}
+
+static HBITMAP import_icon_bitmap( UINT width, UINT height, UINT bpp, const void *pixels )
+{
+    char buffer[sizeof(BITMAPINFOHEADER) + 2 * sizeof(RGBQUAD)];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    HBITMAP bitmap;
+    void *bits;
+    init_icon_bitmap_info( info, width, height, bpp );
+    bitmap = NtGdiCreateDIBSection( NULL, NULL, 0, info, DIB_RGB_COLORS, 0, 0, 0, &bits );
+    if (bitmap) memcpy( bits, pixels, ((width * bpp + 31) / 32 * 4) * height );
+    return bitmap;
+}
+
+static void publish_icon( struct cursoricon_object *obj )
+{
+    struct shared_icon_data header, *data;
+    size_t size, mask_size, color_size;
+    BYTE *pixels;
+    HDC dc;
+    BOOL ok;
+    if (!getenv( "WIN4WINE_EXTERNAL_SHELL" ) || !obj->is_icon || obj->is_ani) return;
+    memset( &header, 0, sizeof(header) );
+    header.width = obj->frame.width;
+    header.height = obj->frame.height;
+    header.hotspot_x = obj->frame.hotspot.x;
+    header.hotspot_y = obj->frame.hotspot.y;
+    header.flags = (obj->frame.color ? SHARED_ICON_COLOR : 0) |
+                   (obj->frame.alpha ? SHARED_ICON_ALPHA : 0) |
+                   (obj->is_shared ? SHARED_ICON_RESOURCE : 0);
+    header.module_bytes = obj->module.Length;
+    if (IS_INTRESOURCE( obj->resname )) header.name_id = LOWORD(obj->resname);
+    else header.name_bytes = lstrlenW( obj->resname ) * sizeof(WCHAR);
+    if (!(size = shared_icon_size( &header )) || size > SHARED_ICON_MAX_BYTES ||
+        !(data = malloc( size ))) return;
+    *data = header;
+    mask_size = ((header.width + 31) / 32 * 4) * header.height * (obj->frame.color ? 1 : 2);
+    color_size = header.width * header.height * 4;
+    pixels = (BYTE *)(data + 1);
+    dc = NtGdiCreateCompatibleDC( 0 );
+    ok = dc && export_icon_bitmap( dc, obj->frame.mask, header.width,
+                                  header.height * (obj->frame.color ? 1 : 2), 1, pixels );
+    pixels += mask_size;
+    if (ok && obj->frame.color)
+    {
+        ok = export_icon_bitmap( dc, obj->frame.color, header.width, header.height, 32, pixels );
+        pixels += color_size;
+    }
+    if (ok && obj->frame.alpha)
+    {
+        ok = export_icon_bitmap( dc, obj->frame.alpha, header.width, header.height, 32, pixels );
+        pixels += color_size;
+    }
+    if (dc) NtGdiDeleteObjectApp( dc );
+    if (ok)
+    {
+        if (header.module_bytes) memcpy( pixels, obj->module.Buffer, header.module_bytes );
+        pixels += header.module_bytes;
+        if (header.name_bytes) memcpy( pixels, obj->resname, header.name_bytes );
+        SERVER_START_REQ( set_shared_icon )
+        {
+            req->handle = wine_server_user_handle( obj->obj.handle );
+            wine_server_add_data( req, data, size );
+            wine_server_call( req );
+        }
+        SERVER_END_REQ;
+    }
+    free( data );
+}
+
+/* The regular owner object and USER table are never replaced with imported
+ * objects. All calls here hold user_lock; every borrowed pointer is pinned. */
+static void free_foreign_icon( struct cursoricon_object *obj )
+{
+    assert( obj->is_foreign && !obj->refs );
+    list_remove( &obj->foreign_entry );
+    --foreign_count;
+    if (obj->frame.color) NtGdiDeleteObjectApp( obj->frame.color );
+    if (obj->frame.alpha) NtGdiDeleteObjectApp( obj->frame.alpha );
+    if (obj->frame.mask) NtGdiDeleteObjectApp( obj->frame.mask );
+    free( obj->module.Buffer );
+    if (!IS_INTRESOURCE( obj->resname )) free( obj->resname );
+    free( obj );
+}
+
+void release_foreign_icon( void *ptr )
+{
+    struct cursoricon_object *obj = ptr;
+    if (!obj->is_foreign) return;
+    assert( obj->refs );
+    if (!--obj->refs && obj->retired) free_foreign_icon( obj );
+}
+
+static struct cursoricon_object *get_foreign_icon( HICON handle )
+{
+    struct cursoricon_object *obj, *next;
+    struct shared_icon_data *data;
+    HICON full = NULL;
+    unsigned int size = 0, received = 0;
+    BYTE *pixels;
+    size_t mask_size, color_size;
+    BOOL ok;
+
+    user_lock();
+    SERVER_START_REQ( get_shared_icon )
+    {
+        req->handle = wine_server_user_handle( handle );
+        if (!wine_server_call( req ))
+        { full = wine_server_ptr_handle( reply->handle ); size = reply->size; }
+    }
+    SERVER_END_REQ;
+    if (!full || size < sizeof(*data) || size > SHARED_ICON_MAX_BYTES)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( obj, next, &foreign_icons, struct cursoricon_object, foreign_entry )
+            if (obj->obj.handle == handle || (!HIWORD(handle) && LOWORD(obj->obj.handle) == LOWORD(handle)))
+            {
+                obj->retired = TRUE;
+                if (!obj->refs) free_foreign_icon( obj );
+            }
+        user_unlock();
+        return NULL;
+    }
+    LIST_FOR_EACH_ENTRY( obj, &foreign_icons, struct cursoricon_object, foreign_entry )
+        if (obj->obj.handle == full && !obj->retired)
+        {
+            ++obj->refs;
+            list_remove( &obj->foreign_entry );
+            list_add_head( &foreign_icons, &obj->foreign_entry );
+            return obj;
+        }
+    /* Eviction destroys only unpinned local bitmap copies. A later read of the
+     * same global HICON can rematerialize it while its owner remains alive. */
+    if (foreign_count >= 64)
+    {
+        LIST_FOR_EACH_ENTRY_REV( obj, &foreign_icons, struct cursoricon_object, foreign_entry )
+            if (!obj->refs) { free_foreign_icon( obj ); break; }
+        if (foreign_count >= 64) { user_unlock(); return NULL; }
+    }
+    if (!(data = malloc( size ))) { user_unlock(); return NULL; }
+    SERVER_START_REQ( get_shared_icon )
+    {
+        req->handle = wine_server_user_handle( full );
+        wine_server_set_reply( req, data, size );
+        ok = !wine_server_call( req );
+        if (ok) received = wine_server_reply_size( reply );
+    }
+    SERVER_END_REQ;
+    if (!ok || received != size || shared_icon_size( data ) != size ||
+        !(obj = calloc( 1, sizeof(*obj) )))
+    { free( data ); user_unlock(); return NULL; }
+    obj->obj.handle = full;
+    obj->obj.type = NTUSER_OBJ_ICON;
+    obj->is_foreign = obj->is_icon = TRUE;
+    obj->is_shared = !!(data->flags & SHARED_ICON_RESOURCE);
+    obj->frame.width = data->width;
+    obj->frame.height = data->height;
+    obj->frame.hotspot.x = data->hotspot_x;
+    obj->frame.hotspot.y = data->hotspot_y;
+    pixels = (BYTE *)(data + 1);
+    mask_size = ((data->width + 31) / 32 * 4) * data->height * (data->flags & SHARED_ICON_COLOR ? 1 : 2);
+    color_size = data->width * data->height * 4;
+    obj->frame.mask = import_icon_bitmap( data->width, data->height * (data->flags & SHARED_ICON_COLOR ? 1 : 2), 1, pixels );
+    ok = !!obj->frame.mask;
+    pixels += mask_size;
+    if (data->flags & SHARED_ICON_COLOR)
+    {
+        obj->frame.color = import_icon_bitmap( data->width, data->height, 32, pixels );
+        ok = ok && !!obj->frame.color;
+        pixels += color_size;
+    }
+    if (data->flags & SHARED_ICON_ALPHA)
+    {
+        obj->frame.alpha = import_icon_bitmap( data->width, data->height, 32, pixels );
+        ok = ok && !!obj->frame.alpha;
+        pixels += color_size;
+    }
+    if (data->module_bytes)
+    {
+        obj->module.Buffer = malloc( data->module_bytes );
+        if (obj->module.Buffer) { memcpy( obj->module.Buffer, pixels, data->module_bytes ); obj->module.Length = data->module_bytes; }
+        else ok = FALSE;
+        pixels += data->module_bytes;
+    }
+    if (data->name_bytes)
+    {
+        obj->resname = malloc( data->name_bytes + sizeof(WCHAR) );
+        if (obj->resname) { memcpy( obj->resname, pixels, data->name_bytes ); obj->resname[data->name_bytes / sizeof(WCHAR)] = 0; }
+        else ok = FALSE;
+    }
+    else obj->resname = MAKEINTRESOURCEW(data->name_id);
+    free( data );
+    list_add_head( &foreign_icons, &obj->foreign_entry );
+    ++foreign_count;
+    if (!ok) { free_foreign_icon( obj ); user_unlock(); return NULL; }
+    obj->refs = 1;
+    return obj;
+}
