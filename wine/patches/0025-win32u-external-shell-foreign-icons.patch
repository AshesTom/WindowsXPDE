+/* No window message, process memory pointer, or GDI handle crosses the server.
+ * Dimensions and all inferred bitmap sizes are checked before allocation. */
+static BOOL valid_icon_data( const struct shared_icon_data *data, data_size_t size )
+{
+    size_t expected;
+    if (size < sizeof(*data) || !data->width || !data->height ||
+        data->width > SHARED_ICON_MAX_DIM || data->height > SHARED_ICON_MAX_DIM ||
+        (data->flags & ~(SHARED_ICON_COLOR | SHARED_ICON_ALPHA | SHARED_ICON_RESOURCE)) ||
+        ((data->flags & SHARED_ICON_ALPHA) && !(data->flags & SHARED_ICON_COLOR)) ||
+        data->module_bytes > SHARED_ICON_MAX_STRING || data->name_bytes > SHARED_ICON_MAX_STRING ||
+        ((data->module_bytes | data->name_bytes) & 1) || data->name_id > 0xffff ||
+        (data->name_id && data->name_bytes)) return FALSE;
+    expected = sizeof(*data) + ((data->width + 31) / 32 * 4) * data->height *
+               (data->flags & SHARED_ICON_COLOR ? 1 : 2);
+    if (data->flags & SHARED_ICON_COLOR) expected += data->width * data->height * 4;
+    if (data->flags & SHARED_ICON_ALPHA) expected += data->width * data->height * 4;
+    expected += data->module_bytes + data->name_bytes;
+    return expected == size && expected <= SHARED_ICON_MAX_BYTES;
+}
