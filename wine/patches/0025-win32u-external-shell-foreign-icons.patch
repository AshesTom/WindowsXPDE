+DECL_HANDLER(set_shared_icon)
+{
+    struct user_handle *entry = handle_to_entry( req->handle );
+    const struct shared_icon_data *data = get_req_data();
+    data_size_t size = get_req_data_size();
+    size_t owner_bytes = 0;
+    unsigned int i;
+
+    if (!entry || entry->type != USER_CLIENT || entry->client_type != NTUSER_OBJ_ICON)
+    { set_error( STATUS_INVALID_HANDLE ); return; }
+    if (entry->ptr != current->process)
+    { set_error( STATUS_ACCESS_DENIED ); return; }
+    if (entry->icon_data || !valid_icon_data( data, size ))
+    { set_error( STATUS_INVALID_PARAMETER ); return; }
+    for (i = 0; i < nb_handles; ++i)
+        if (handles[i].type == USER_CLIENT && handles[i].ptr == current->process)
+            owner_bytes += handles[i].icon_size;
+    if (owner_bytes + size > 16 * 1024 * 1024 || icon_bytes + size > 64 * 1024 * 1024)
+    { set_error( STATUS_NO_MEMORY ); return; }
+    if (!(entry->icon_data = memdup( data, size ))) return;
+    entry->icon_size = size;
+    icon_bytes += size;
+}
+
+DECL_HANDLER(get_shared_icon)
+{
+    struct user_handle *entry = handle_to_entry( req->handle );
+    if (!entry || entry->type != USER_CLIENT || entry->client_type != NTUSER_OBJ_ICON || !entry->icon_data)
+    { set_error( STATUS_INVALID_HANDLE ); return; }
+    reply->handle = entry_to_handle( entry );
+    reply->size = entry->icon_size;
+    if (get_reply_max_size())
+    {
+        if (get_reply_max_size() < entry->icon_size) set_error( STATUS_BUFFER_TOO_SMALL );
+        else set_reply_data( entry->icon_data, entry->icon_size );
+    }
+}
