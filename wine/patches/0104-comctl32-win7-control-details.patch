     }
 }
 
+/* Whether the process runs in the Windows 7 shell session (win4wine): the
+ * controls then follow Windows 7's comctl32 where it differs from XP's. */
+BOOL COMCTL32_IsWin7Shell(void)
+{
+    static int win7 = -1;
+    if (win7 < 0)
+    {
+        WCHAR shell[16];
+        DWORD length = GetEnvironmentVariableW(L"WIN4WINE_SHELL", shell, ARRAY_SIZE(shell));
+        win7 = win4wine_external_shell() && length && length < ARRAY_SIZE(shell) && !wcscmp(shell, L"win7");
+    }
+    return win7;
+}
