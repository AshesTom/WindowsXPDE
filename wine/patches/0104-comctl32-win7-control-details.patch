+static void COMBO_ThemedPaintDropList(HTHEME theme, HEADCOMBO *lphc, HDC hdc)
+{
+    int state, id, size;
+    WCHAR *text = NULL;
+    RECT client, rect;
+    HFONT old_font = 0;
+
+    if (!IsWindowEnabled(lphc->self))
+        state = CBRO_DISABLED;
+    else if (lphc->wState & (CBF_BUTTONDOWN | CBF_DROPPED))
+        state = CBRO_PRESSED;
+    else if (lphc->wState & CBF_HOT)
+        state = CBRO_HOT;
+    else
+        state = CBRO_NORMAL;
+    GetClientRect(lphc->self, &client);
+    if (IsThemeBackgroundPartiallyTransparent(theme, CP_READONLY, state))
+        DrawThemeParentBackground(lphc->self, hdc, &client);
+    DrawThemeBackground(theme, hdc, CP_READONLY, state, &client, NULL);
+    /* the arrow stays as it is; its hot and pressed states are the button of an editable box */
+    DrawThemeBackground(theme, hdc, CP_DROPDOWNBUTTONRIGHT, state == CBRO_DISABLED ? CBXSR_DISABLED : CBXSR_NORMAL,
+                        &lphc->buttonRect, NULL);
+
+    SetRect(&rect, client.left + 3, client.top + 3, lphc->buttonRect.left - 3, client.bottom - 3);
+    if (CB_OWNERDRAWN(lphc))
+    {
+        CBPaintText(lphc, hdc);
+        return;
+    }
+    if ((id = SendMessageW(lphc->hWndLBox, LB_GETCURSEL, 0, 0)) != LB_ERR &&
+        (size = SendMessageW(lphc->hWndLBox, LB_GETTEXTLEN, id, 0)) != LB_ERR &&
+        (text = Alloc((size + 1) * sizeof(WCHAR))))
+    {
+        RECT text_rect = rect;
+
+        size = SendMessageW(lphc->hWndLBox, LB_GETTEXT, id, (LPARAM)text);
+        if (lphc->hFont) old_font = SelectObject(hdc, lphc->hFont);
+        SetBkMode(hdc, TRANSPARENT);
+        SetTextColor(hdc, GetSysColor(state == CBRO_DISABLED ? COLOR_GRAYTEXT : COLOR_WINDOWTEXT));
+        text_rect.left++;
+        DrawTextW(hdc, text, size, &text_rect, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX);
+        if (old_font) SelectObject(hdc, old_font);
+        Free(text);
+    }
+    if ((lphc->wState & CBF_FOCUSED) && !(lphc->wState & CBF_DROPPED) &&
+        !(SendMessageW(lphc->self, WM_QUERYUISTATE, 0, 0) & UISF_HIDEFOCUS))
+        DrawFocusRect(hdc, &rect);
+}
+
 static LRESULT COMBO_ThemedPaint(HTHEME theme, HEADCOMBO *lphc, HDC hdc)
 {
     int button_state;
     RECT frame;
 
+    if (is_themed_drop_list(lphc, theme))
+    {
+        COMBO_ThemedPaintDropList(theme, lphc, hdc);
+        return 0;
+    }
+
     /* paint border */
     if (CB_GETTYPE(lphc) != CBS_SIMPLE)
         GetClientRect(lphc->self, &frame);
@@ -1651,7 +1730,8 @@ static void COMBO_MouseMove( LPHEADCOMBO lphc, WPARAM wParam, LPARAM lParam )
