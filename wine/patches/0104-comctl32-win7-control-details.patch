         if (!IsRectEmpty(&lphc->buttonRect))
         {
             TRACKMOUSEEVENT event;
+            RECT hot = lphc->buttonRect;
             POINT pt;
 
             pt.x = (short)LOWORD(lParam);
             pt.y = (short)HIWORD(lParam);
+            if (is_themed_drop_list(lphc, GetWindowTheme(hwnd))) GetClientRect(hwnd, &hot);
 
-            if (PtInRect(&lphc->buttonRect, pt))
+            if (PtInRect(&hot, pt))
             {
                 if (!(lphc->wState & CBF_HOT))
                 {
                     lphc->wState |= CBF_HOT;
-                    RedrawWindow(hwnd, &lphc->buttonRect, 0, RDW_INVALIDATE | RDW_UPDATENOW);
+                    RedrawWindow(hwnd, &hot, 0, RDW_INVALIDATE | RDW_UPDATENOW);
 
                     event.cbSize = sizeof(TRACKMOUSEEVENT);
                     event.dwFlags = TME_QUERY;
@@ -1920,7 +2002,7 @@ static LRESULT CALLBACK COMBO_WindowProc( HWND hwnd, UINT message, WPARAM wParam
             else if (lphc->wState & CBF_HOT)
             {
                 lphc->wState &= ~CBF_HOT;
-                RedrawWindow(hwnd, &lphc->buttonRect, 0, RDW_INVALIDATE | RDW_UPDATENOW);
+                RedrawWindow(hwnd, &hot, 0, RDW_INVALIDATE | RDW_UPDATENOW);
             }
