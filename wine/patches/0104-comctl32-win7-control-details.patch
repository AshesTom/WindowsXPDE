 dlls/comctl32/commctrl.c   | 17 ++++++++-
 dlls/comctl32/status.c     |  9 +++++
 dlls/comctl32_v6/button.c  | 11 +++---
 dlls/comctl32_v6/combo.c   | 92 +++++++++++++++++++++++++++++++++++++++++++---
 dlls/comctl32_v6/listbox.c | 11 ++++--
 dlls/user32/uitools.c      | 56 ++++++++++++++++++++++++++++
 7 files changed, 182 insertions(+), 15 deletions(-)

