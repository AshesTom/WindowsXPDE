 {
     lphc->wState &= ~CBF_HOT;
-    RedrawWindow(lphc->self, &lphc->buttonRect, 0, RDW_INVALIDATE | RDW_UPDATENOW);
+    RedrawWindow(lphc->self, is_themed_drop_list(lphc, GetWindowTheme(lphc->self)) ? NULL : &lphc->buttonRect, 0,
+                 RDW_INVALIDATE | RDW_UPDATENOW);
     return 0;
 }
 
