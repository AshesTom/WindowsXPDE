+   }
    else if(!(lphc->wState & CBF_NOREDRAW) && IsWindowVisible( lphc->self ))
    {
      /* paint text field ourselves */
@@ -769,11 +793,66 @@ static void CBPaintBorder(const HEADCOMBO *lphc, HDC hdc)
   DrawEdge(hdc, &clientRect, EDGE_SUNKEN, BF_RECT);
