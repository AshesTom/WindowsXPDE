+/* Windows 7's (a version 4 style's) drop-down lists are drawn as a button
+ * with the arrow alone, the whole box hot under the mouse; the text sits in
+ * the box three pixels in, up to three pixels before the 17 pixel arrow,
+ * with the focus rectangle around it. Measured on Windows 7 SP1 against
+ * its comctl32 6. */
+static BOOL is_themed_drop_list(const HEADCOMBO *lphc, HTHEME theme)
+{
+    return theme && CB_GETTYPE(lphc) == CBS_DROPDOWNLIST && win4wine_external_shell() &&
+           IsThemePartDefined(theme, CP_READONLY, 0);
+}
+
 /***********************************************************************
  *           COMBO_Init
  *
@@ -346,7 +358,14 @@ static void CBCalcPlacement(HEADCOMBO *combo)
 
         /* XP's themed ComboBox insets its button only by the one pixel frame
          * and lets it fill the client height; measured on the folder address bar. */
-        if (is_external_alias(combo->self) && GetWindowTheme(combo->self))
+        if (is_themed_drop_list(combo, GetWindowTheme(combo->self)))
+        {
+            RECT client;
+            GetClientRect(combo->self, &client);
+            SetRect(&combo->buttonRect, client.right - GetSystemMetrics(SM_CXVSCROLL), client.top + 1,
+                    client.right, client.bottom - 1);
+        }
+        else if (is_external_alias(combo->self) && GetWindowTheme(combo->self))
         {
             RECT client;
             GetClientRect(combo->self, &client);
@@ -662,6 +681,11 @@ static void CBPaintText(HEADCOMBO *lphc, HDC hdc_paint)
 	if( lphc->wState & CBF_FOCUSED )
            SendMessageW(lphc->hWndEdit, EM_SETSEL, 0, MAXLONG);
    }
+   else if (!hdc_paint && !(lphc->wState & CBF_NOREDRAW) && !CB_OWNERDRAWN(lphc) &&
+            is_themed_drop_list(lphc, GetWindowTheme(lphc->self)))
