From: Codex <codex@localhost>
Subject: [PATCH] winex11: keep the screen under external shell popups that do not paint it

Purpose: show what XP shows under popups that are shown without painting.
XP behavior: a popup shown with SWP_SHOWWINDOW | SWP_NOREDRAW, or whose class
has no background brush, leaves the screen beneath visible until it paints.
XP's shut down screen relies on this: its full-screen DimmedWindow reads
its own window back strip by strip and turns it grey.
Wine before: a new surface started black, so the Start panel flashed a black
frame and the shut down screen stayed black.
Change: for non-layered popups, seed new buffered surfaces with the clipped
root window pixels of the same depth and keep the X background None while
mapping. Layered windows and ordinary painting are unchanged.
Evidence: tests/no-redraw.c (underlay, owner drawing, return to normal
painting, screen edges, layered exclusion).
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0042, 0055.
---
 dlls/winex11.drv/bitblt.c | 32 ++++++++++++++++++++++++++++++++
 dlls/winex11.drv/window.c | 13 ++++++++++++-
 dlls/winex11.drv/x11drv.h |  2 ++
 3 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/dlls/winex11.drv/bitblt.c b/dlls/winex11.drv/bitblt.c
index b6e08ea..3823d04 100644
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -1906,6 +1906,38 @@ static struct window_surface *create_surface( HWND hwnd, Window window, const XV
 
     if (!(image = x11drv_image_create( info, vis ))) return NULL;
 
+    /* Preserve the screen under a newly shown no-redraw popup before any
+     * shape/exposure flush transfers its otherwise uninitialized bitmap. */
+    {
+        struct x11drv_win_data *data = get_win_data( hwnd );
+        if (data)
+        {
+            if (data->preserve_no_redraw)
+            {
+                POINT origin = virtual_screen_to_root( 0, 0 );
+                LONGLONG x = (LONGLONG)origin.x + data->no_redraw_rect.left + rect->left;
+                LONGLONG y = (LONGLONG)origin.y + data->no_redraw_rect.top + rect->top;
+                XWindowAttributes attrs;
+                if (XGetWindowAttributes( gdi_display, root_window, &attrs ) && attrs.depth == vis->depth)
+                {
+                    LONGLONG left = max( x, 0 ), top = max( y, 0 );
+                    LONGLONG right = min( x + width, attrs.width );
+                    LONGLONG bottom = min( y + height, attrs.height );
+                    /* A nonempty intersection bounds source coordinates by the
+                     * root size and destination offsets by the image size. */
+                    if (right > left && bottom > top)
+                    {
+                        X11DRV_expect_error( gdi_display, XGetImage_handler, NULL );
+                        XGetSubImage( gdi_display, root_window, left, top, right-left, bottom-top,
+                                      AllPlanes, ZPixmap, image->ximage, left-x, top-y );
+                        if (X11DRV_check_error()) WARN( "Cannot preserve root pixels for hwnd %p\n", hwnd );
+                    }
+                }
+            }
+            release_win_data( data );
+        }
+    }
+
     /* wrap the XImage data in a HBITMAP if we can write to the surface pixels directly */
     if ((byteswap = image_needs_byteswap( image->ximage, is_r8g8b8( vis ), info->bmiHeader.biBitCount )) ||
         info->bmiHeader.biBitCount <= 8 || !(d3d_format = get_dib_d3dddifmt( info )))
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index c6a6fe9..6eb70e8 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -528,13 +528,15 @@ static int get_window_attributes( struct x11drv_win_data *data, XSetWindowAttrib
     attr->backing_store     = NotUseful;
     attr->border_pixel      = 0;
     attr->background_pixel  = 0;
+    if (data->preserve_no_redraw) attr->background_pixmap = None;
     attr->event_mask        = (ExposureMask | KeyPressMask | KeyReleaseMask |
                                FocusChangeMask | KeymapStateMask | StructureNotifyMask | PropertyChangeMask);
     /* for transparent windows, exclude mouse events to allow mouse pass-through */
     if (!(ex_style & WS_EX_TRANSPARENT)) attr->event_mask |= (PointerMotionMask | ButtonPressMask |
                                                               ButtonReleaseMask | EnterWindowMask);
 
-    return (CWSaveUnder | CWColormap | CWBorderPixel | CWBackPixel |
+    return (CWSaveUnder | CWColormap | CWBorderPixel |
+            (data->preserve_no_redraw ? CWBackPixmap : CWBackPixel) |
             CWEventMask | CWBitGravity | CWBackingStore);
 }
 
@@ -3196,6 +3198,15 @@ BOOL X11DRV_WindowPosChanging( HWND hwnd, UINT swp_flags, BOOL shaped, const str
 
     if (!data && !(data = X11DRV_create_win_data( hwnd, rects ))) return FALSE; /* use default surface */
     data->shaped = shaped;
+    data->no_redraw_rect = rects->visible;
+    if (!(NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_POPUP) ||
+        (NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_LAYERED))
+        data->preserve_no_redraw = FALSE;
+    else if (swp_flags & SWP_SHOWWINDOW)
+        /* A popup whose class has no background brush never erases what lies
+         * under it either; XP's shut down screen reads that back to dim it. */
+        data->preserve_no_redraw = win4wine_external_shell() &&
+            ((swp_flags & SWP_NOREDRAW) || !NtUserGetClassLongPtrW( hwnd, GCLP_HBRBACKGROUND ));
 
     ret = !!data->whole_window; /* use default surface if we don't have a window */
     release_win_data( data );
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 9232988..b6cb5d7 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -694,6 +694,8 @@ struct x11drv_win_data
     unsigned long wm_normal_hints_serial;/* serial of last pending WM_NORMAL_HINTS request */
     unsigned long configure_serial;    /* serial of last pending configure request */
     unsigned long net_wm_icon_serial;  /* serial of last pending _NET_WM_ICON request */
+    BOOL preserve_no_redraw;          /* opt-in popup shown without redrawing */
+    RECT no_redraw_rect;              /* pending raw visible rectangle */
 };
 
 extern struct x11drv_win_data *get_win_data( HWND hwnd );
