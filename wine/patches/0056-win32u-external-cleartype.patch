From: Codex <codex@localhost>
Subject: [PATCH] win32u: draw and measure ClearType text as XP does in the external shell

Purpose: let the XP shell's session use XP's ClearType (Display Properties,
Effects), drawn and laid out as on XP.
XP behavior: with FontSmoothingType 2, text is ClearType whatever the
font's gasp table says (Tahoma at 11 pixels too), except at the sizes a
font has embedded bitmaps for: MS UI Gothic, MS Gothic and MS PGothic stay
black and white bitmaps up to 22 pixels and become ClearType from 23 on.
Each subpixel has one of seven levels (a sixth of coverage each), blended
with a gamma of 2.2 at the default contrast of 1400: black on white gives
0, 114, 155, 186, 212, 234 and 255 only. Stems keep fractional widths
(Arial at 17 pixels: 8/6 pixel), so the outline is not hinted
horizontally, and it is sampled at six times the horizontal resolution
with a window of three subpixels. GetTextExtentPoint32 gives the same
widths as with standard smoothing (the black and white advances), and the
text is laid out with them.
Wine before: fontconfig's antialiasing setting of each font, and the X
resources, came before the registry, so FontSmoothingType 2 gave grey or
black and white text with Linux's usual settings. With subpixel rendering
forced (fontconfig rgba), MS UI Gothic's small sizes were drawn from the
outlines, FreeType's default LCD filter blurred stems over three pixels,
the coverage was blended linearly, and the text was laid out with
FreeType's LCD advances: Tahoma's menu text at 11 pixels 7 pixels wider
than XP's over 60 characters.
Change: when the registry selects ClearType, it applies to every font that
does not ask for NONANTIALIASED_QUALITY or ANTIALIASED_QUALITY. A size that
has an embedded bitmap strike follows the standard (gasp) rule. Other
glyphs are measured and laid out with the black and white advances; their
outline, hinted vertically only, is drawn black and white at six times the
horizontal resolution, and each subpixel counts the samples of its window.
The gamma is 2.2 at the default contrast and FontSmoothingGamma scales it
as before. Standard smoothing and Wine without the external shell are
unchanged.
Evidence: tests/cleartype.c on the Japanese and English XP references
against Wine: the same rows are ClearType, the same seven levels, every
GetTextExtentPoint32 width the same (Tahoma, Trebuchet MS, Franklin Gothic
Medium, Microsoft Sans Serif, Arial, MS UI Gothic, MS Gothic, MS PGothic);
glyph shapes match except that Tahoma and Microsoft Sans Serif at 11
pixels stay up to two subpixels right of XP's.
Scope: only with WIN4WINE_EXTERNAL_SHELL and FontSmoothingType 2.
---
 dlls/win32u/font.c          | 19 ++++++++-
 dlls/win32u/freetype.c      | 97 ++++++++++++++++++++++++++++++++++++++++++++-
 dlls/win32u/ntgdi_private.h |  1 +
 3 files changed, 114 insertions(+), 3 deletions(-)

diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index 37403eb..caf5918 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -195,6 +195,13 @@ static const WCHAR font_assoc_keyW[] =
 
 static UINT font_smoothing = GGO_BITMAP;
 static UINT subpixel_orientation = GGO_GRAY4_BITMAP;
+static BOOL external_cleartype;
+
+/* Whether XP's ClearType setting is on in the shell's session. */
+BOOL font_external_cleartype(void)
+{
+    return external_cleartype;
+}
 static BOOL antialias_fakes = TRUE;
 static struct font_gamma_ramp font_gamma_ramp;
 
@@ -4588,6 +4595,11 @@ static HFONT font_SelectFont( PHYSDEV dev, HFONT hfont, UINT *aa_flags )
 
         if (font)
         {
+            /* XP's ClearType setting applies to the shell's session, whatever
+               fontconfig and the X resources choose for Linux applications. */
+            if (external_cleartype && lf.lfQuality != NONANTIALIASED_QUALITY &&
+                lf.lfQuality != ANTIALIASED_QUALITY && *aa_flags != GGO_BITMAP)
+                *aa_flags = font_smoothing;
             if (!*aa_flags) *aa_flags = font->aa_flags;
             if (!*aa_flags)
             {
@@ -4748,7 +4760,10 @@ static UINT init_font_options(void)
         if (get_key_value( key, "FontSmoothing", &val ) && val /* enabled */)
         {
             if (get_key_value( key, "FontSmoothingType", &val ) && val == 2 /* FE_FONTSMOOTHINGCLEARTYPE */)
+            {
                 font_smoothing = subpixel_orientation;
+                external_cleartype = win4wine_external_shell() && font_smoothing != GGO_GRAY4_BITMAP;
+            }
             else
                 font_smoothing = GGO_GRAY4_BITMAP;
         }
@@ -4763,7 +4778,9 @@ static UINT init_font_options(void)
     /* Calibrating the difference between the registry value and the Wine gamma value.
        This looks roughly similar to Windows Native with the same registry value.
        MS GDI seems to be rasterizing the outline at a different rate than FreeType. */
-    gamma = 1000 * gamma / 1400;
+    /* XP's ClearType at its default contrast (1400) blends with a gamma of 2.2. */
+    if (external_cleartype) gamma = 2200 * gamma / 1400;
+    else gamma = 1000 * gamma / 1400;
     if (gamma != 1000)
     {
         for (i = 0; i < 256; i++)
diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
index b7bf79c..c6a501c 100644
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -2122,6 +2122,17 @@ static BOOL freetype_load_font( struct gdi_font *font )
 }
 
 
+static BOOL has_bitmap_strike( struct gdi_font *font )
+{
+    FT_Face ft_face = get_ft_face( font );
+    My_FT_Bitmap_Size *size = (My_FT_Bitmap_Size *)ft_face->available_sizes;
+
+    if (!FT_IS_SCALABLE( ft_face ) || !ft_face->size) return FALSE;
+    for (int i = 0; i < ft_face->num_fixed_sizes; i++)
+        if ((size[i].y_ppem + 32) >> 6 == ft_face->size->metrics.y_ppem) return TRUE;
+    return FALSE;
+}
+
 /*************************************************************
  * freetype_get_aa_flags
  */
@@ -2134,7 +2145,10 @@ static UINT freetype_get_aa_flags( struct gdi_font *font, UINT aa_flags, BOOL an
     case WINE_GGO_HBGR_BITMAP:
     case WINE_GGO_VRGB_BITMAP:
     case WINE_GGO_VBGR_BITMAP:
-        if (is_subpixel_rendering_enabled()) break;
+        /* XP draws the sizes that have embedded bitmaps, such as MS UI Gothic's
+           7 to 22 pixels, as without ClearType. */
+        if (is_subpixel_rendering_enabled() &&
+            (!font_external_cleartype() || !has_bitmap_strike( font ))) break;
         aa_flags = GGO_GRAY4_BITMAP;
         /* fall through */
     case GGO_GRAY2_BITMAP:
@@ -2865,6 +2879,77 @@ static DWORD get_subpixel_glyph_bitmap( FT_GlyphSlot glyph, FT_BBox bbox, UINT f
     return needed;
 }
 
+/* XP's ClearType: the outline, hinted vertically only, is drawn black and
+ * white at six times the horizontal resolution; each subpixel is as dark as
+ * the share of the six samples set around it (its own two and two on either
+ * side), so it has one of seven levels. */
+static DWORD get_xp_cleartype_bitmap( struct gdi_font *font, FT_Face ft_face, UINT glyph, UINT format,
+                                      const FT_Matrix *matrices, GLYPHMETRICS *gm, DWORD buflen, BYTE *buf )
+{
+    static const FT_Matrix six = {6 << 16, 0, 0, 1 << 16};
+    FT_Bitmap *bitmap;
+    int left, first, last, width, height, x, y, c, s;
+    DWORD pitch, needed;
+    BOOL bgr = format == WINE_GGO_HBGR_BITMAP;
+
+    /* Hinted vertically only, as FreeType does for LCD rendering. */
+    if (pFT_Load_Glyph( ft_face, glyph, FT_LOAD_TARGET_LCD | FT_LOAD_NO_BITMAP | FT_LOAD_IGNORE_GLOBAL_ADVANCE_WIDTH ))
+        return GDI_ERROR;
+    if (font->fake_bold)
+    {
+        FT_Glyph_Metrics metrics = ft_face->glyph->metrics;
+        get_bold_glyph_outline( ft_face->glyph, font->ppem, &metrics );
+    }
+    if (matrices) pFT_Outline_Transform( &ft_face->glyph->outline, &matrices[matrix_vert] );
+    pFT_Outline_Transform( &ft_face->glyph->outline, &six );
+    if (pFT_Render_Glyph( ft_face->glyph, FT_RENDER_MODE_MONO )) return GDI_ERROR;
+
+    bitmap = &ft_face->glyph->bitmap;
+    left = ft_face->glyph->bitmap_left;
+    height = bitmap->rows;
+    if (!bitmap->width || !height)
+    {
+        if (!buf || !buflen) return 0;
+        return GDI_ERROR;
+    }
+    /* Subpixel j covers samples 2j and 2j + 1 and sees 2j - 2 to 2j + 3. */
+    first = (left - 3) >> 1;
+    last = (left + (int)bitmap->width + 1) >> 1;
+    first = first >= 0 ? first / 3 : -((2 - first) / 3);
+    last = last >= 0 ? last / 3 : -((2 - last) / 3);
+    width = last - first + 1;
+    pitch = width * 4;
+    needed = pitch * height;
+    gm->gmBlackBoxX = width;
+    gm->gmBlackBoxY = height;
+    gm->gmptGlyphOrigin.x = first;
+    gm->gmptGlyphOrigin.y = ft_face->glyph->bitmap_top;
+    if (!buf || !buflen) return needed;
+    if (needed > buflen) return GDI_ERROR;
+
+    for (y = 0; y < height; y++)
+    {
+        const BYTE *src = bitmap->buffer + y * bitmap->pitch;
+        unsigned int *dst = (unsigned int *)(buf + y * pitch);
+
+        for (x = 0; x < width; x++)
+        {
+            unsigned int pixel = 0;
+
+            for (c = 0; c < 3; c++)
+            {
+                int j = 3 * (first + x) + c, count = 0;
+
+                for (s = 2 * j - 2 - left; s < 2 * j + 4 - left; s++)
+                    if (s >= 0 && s < (int)bitmap->width && (src[s >> 3] & (0x80 >> (s & 7)))) count++;
+                pixel |= (count * 255 + 3) / 6 << (bgr ? 8 * c : 16 - 8 * c);
+            }
+            dst[x] = pixel;
+        }
+    }
+    return needed;
+}
+
 static unsigned int get_native_glyph_outline(FT_Outline *outline, unsigned int buflen, char *buf)
 {
     TTPOLYGONHEADER *pph;
@@ -3107,7 +3192,7 @@ static UINT freetype_get_glyph_outline( struct gdi_font *font, UINT glyph, UINT
     FT_BBox bbox;
     FT_Int load_flags = get_load_flags(format);
     FT_Matrix transform_matrices[3], *matrices = NULL;
-    BOOL vertical_metrics;
+    BOOL vertical_metrics, xp_cleartype;
 
     TRACE("%p, %04x, %08x, %p, %08x, %p, %p\n", font, glyph, format, lpgm, buflen, buf, lpmat);
 
@@ -3121,6 +3206,13 @@ static UINT freetype_get_glyph_outline( struct gdi_font *font, UINT glyph, UINT
 
     vertical_metrics = (tategaki && FT_HAS_VERTICAL(ft_face));
 
+    /* XP measures and lays out ClearType text with the black and white
+     * advances, and draws it as get_xp_cleartype_bitmap does. */
+    xp_cleartype = font_external_cleartype() && !vertical_metrics && FT_IS_SCALABLE( ft_face ) &&
+                   (format == GGO_METRICS || format == WINE_GGO_HRGB_BITMAP || format == WINE_GGO_HBGR_BITMAP) &&
+                   !(load_flags & FT_LOAD_NO_HINTING) && !has_bitmap_strike( font );
+    if (xp_cleartype) load_flags = get_load_flags( GGO_BITMAP );
+
     if (matrices || format != GGO_BITMAP) load_flags |= FT_LOAD_NO_BITMAP;
     if (vertical_metrics) load_flags |= FT_LOAD_VERTICAL_LAYOUT;
 
@@ -3187,6 +3279,7 @@ static UINT freetype_get_glyph_outline( struct gdi_font *font, UINT glyph, UINT
     case WINE_GGO_HBGR_BITMAP:
     case WINE_GGO_VRGB_BITMAP:
     case WINE_GGO_VBGR_BITMAP:
+        if (xp_cleartype) return get_xp_cleartype_bitmap( font, ft_face, glyph, format, matrices, lpgm, buflen, buf );
         return get_subpixel_glyph_bitmap( ft_face->glyph, bbox, format, font->fake_bold,
                                           matrices, lpgm, buflen, buf );
 
diff --git a/dlls/win32u/ntgdi_private.h b/dlls/win32u/ntgdi_private.h
index 8354e49..0ef8ec0 100644
--- a/dlls/win32u/ntgdi_private.h
+++ b/dlls/win32u/ntgdi_private.h
@@ -346,6 +346,7 @@ extern int add_gdi_face( const WCHAR *family_name, const WCHAR *second_name,
                          DWORD ntmflags, DWORD weight, DWORD version, DWORD flags,
                          const struct bitmap_font_size *size );
 extern UINT font_init(void);
+extern BOOL font_external_cleartype(void);
 extern const struct font_backend_funcs *init_freetype_lib(void);
 
 /* opentype.c */
