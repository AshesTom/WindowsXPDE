From: win4wine
Subject: [PATCH] win32u: the external shell's input languages from Keyboard Layout\Preload

Purpose: XP's Text Services and Input Languages (input.dll, from Regional
and Language Options) shows and changes the user's input languages
(French, ...), and the session keeps them.
Windows behavior: the layouts loaded at logon are HKCU\Keyboard
Layout\Preload in order, with HKCU\Keyboard Layout\Substitutes for
variants; GetKeyboardLayoutList returns them and the first is the default.
input.dll writes these values.
Wine before: GetKeyboardLayoutList returned the user locale's layout and
every key of HKLM's Keyboard Layouts with the locale's language (input.dll
showed all of them as installed); every process start wrote the locale's
layout over Preload's first value; ActivateKeyboardLayout refused another
language than the locale's.
Change: with WIN4WINE_EXTERNAL_SHELL=1, the layout list and the default
layout come from Preload (a variant's HKL from its Layout Id), and other
languages can be activated. Preload's first value is written only when it
is missing (for every Wine application). The keys still follow the
session's XKB layout, which the session sets from the same values
(session/keyboard.py).
Scope: the external shell mode; the Preload write for every Wine application.
---
 dlls/win32u/input.c     |   69 ++++++++++++++++++++++++++++++++++++++++++++++-
 dlls/win32u/sysparams.c |    7 ++++-
 2 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -37,6 +37,7 @@
 #include "wine/server.h"
 #include "wine/debug.h"
 #include "kbd.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
 WINE_DECLARE_DEBUG_CHANNEL(keyboard);
@@ -953,11 +954,65 @@
 }
 
 /***********************************************************************
+ *           get_preload_layouts
+ *
+ * The external shell's input languages: HKCU\Keyboard Layout\Preload in
+ * order, with their substitutes, as Windows loads them at logon. The keys
+ * themselves follow the session's own keyboard (XKB).
+ */
+static UINT get_preload_layouts( HKL *layouts, UINT size )
+{
+    char buffer[4096];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    HKEY preload, substitutes, hkey, subkey;
+    UINT count = 0, i, id, lang, device, len;
+    WCHAR klid[KL_NAMELENGTH];
+    char name[12];
+
+    if (!win4wine_external_shell() || !(preload = reg_open_hkcu_key( "Keyboard Layout\\Preload" ))) return 0;
+    substitutes = reg_open_hkcu_key( "Keyboard Layout\\Substitutes" );
+    hkey = reg_open_key( NULL, keyboard_layouts_keyW, sizeof(keyboard_layouts_keyW) );
+    for (i = 1; count < size; i++)
+    {
+        snprintf( name, sizeof(name), "%u", i );
+        if (!(len = query_reg_ascii_value( preload, name, value, sizeof(buffer) )) || value->Type != REG_SZ) break;
+        len = min( len / sizeof(WCHAR), KL_NAMELENGTH - 1 );
+        memcpy( klid, value->Data, len * sizeof(WCHAR) );
+        klid[len] = 0;
+        lang = LOWORD( wcstoul( klid, NULL, 16 ) );
+        if (substitutes && (len = query_reg_value( substitutes, klid, value, sizeof(buffer) )) && value->Type == REG_SZ)
+        {
+            len = min( len / sizeof(WCHAR), KL_NAMELENGTH - 1 );
+            memcpy( klid, value->Data, len * sizeof(WCHAR) );
+            klid[len] = 0;
+        }
+        id = wcstoul( klid, NULL, 16 );
+        device = LOWORD( id );
+        /* A layout variant (00010409, US-Dvorak) is known by its layout id. */
+        if (HIWORD( id ) && hkey && (subkey = reg_open_key( hkey, klid, lstrlenW( klid ) * sizeof(WCHAR) )))
+        {
+            if (query_reg_ascii_value( subkey, "Layout Id", value, sizeof(buffer) ) && value->Type == REG_SZ)
+                device = 0xf000 | (wcstoul( (const WCHAR *)value->Data, NULL, 16 ) & 0xfff);
+            NtClose( subkey );
+        }
+        if (lang) layouts[count++] = UlongToHandle( MAKELONG( lang, device ) );
+    }
+    if (hkey) NtClose( hkey );
+    if (substitutes) NtClose( substitutes );
+    NtClose( preload );
+    return count;
+}
+
+/***********************************************************************
  *           get_locale_kbd_layout
  */
 static HKL get_locale_kbd_layout(void)
 {
     LCID layout;
+    HKL preload;
+
+    /* The external shell's first input language. */
+    if (get_preload_layouts( &preload, 1 )) return preload;
 
     /* FIXME:
      *
@@ -1325,7 +1380,8 @@
         return 0;
     }
 
-    if (LOWORD(layout) != MAKELANGID(LANG_INVARIANT, SUBLANG_DEFAULT) &&
+    /* The external shell switches between its input languages (Preload). */
+    if (!win4wine_external_shell() && LOWORD(layout) != MAKELANGID(LANG_INVARIANT, SUBLANG_DEFAULT) &&
         (NtQueryDefaultLocale( TRUE, &locale ) || LOWORD(layout) != locale))
     {
         RtlSetLastWin32Error( ERROR_CALL_NOT_IMPLEMENTED );
@@ -1386,6 +1442,17 @@
 
     if ((count = user_driver->pGetKeyboardLayoutList( size, layouts )) != ~0) return count;
 
+    {
+        HKL preload[32];
+        if ((count = get_preload_layouts( preload, ARRAY_SIZE(preload) )))
+        {
+            if (!size || !layouts) return count;
+            count = min( count, size );
+            memcpy( layouts, preload, count * sizeof(*layouts) );
+            return count;
+        }
+    }
+
     layout = get_locale_kbd_layout();
     count = 0;
 
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -5859,7 +5859,12 @@
 
     if ((hkey = reg_create_ascii_key( hkcu_key, "Keyboard Layout\\Preload", 0, NULL )))
     {
-        if (NtUserGetKeyboardLayoutName( layout ))
+        char buffer[sizeof(KEY_VALUE_PARTIAL_INFORMATION) + KL_NAMELENGTH * sizeof(WCHAR)];
+
+        /* The user's input languages, as XP's Regional and Language Options
+         * writes them, are kept; only a missing first one is filled in. */
+        if (!query_reg_ascii_value( hkey, "1", (KEY_VALUE_PARTIAL_INFORMATION *)buffer, sizeof(buffer) ) &&
+            NtUserGetKeyboardLayoutName( layout ))
             set_reg_value( hkey, oneW, REG_SZ, (const BYTE *)layout,
                            (lstrlenW(layout) + 1) * sizeof(WCHAR) );
         NtClose( hkey );
