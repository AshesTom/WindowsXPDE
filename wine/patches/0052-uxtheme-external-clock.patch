index 0000000..5646972
--- /dev/null
+++ b/dlls/uxtheme/clock.c
@@ -0,0 +1,153 @@
+/*
+ * Theme painting for the explicitly selected external XP tray clock.
+ *
+ * Copyright 2026 Win4Wine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "uxtheme.h"
+#include "vssym32.h"
+#include "uxthemedll.h"
+#include "wine/win4wine.h"
+
+static const WCHAR clock_property[] = L"Win4WineClockTheme";
+
+struct external_clock
+{
+    WNDPROC original;
+    HTHEME theme;
+    BOOL enabled;
+};
+
+static BOOL clock_theme(HWND hwnd, struct external_clock *clock)
+{
+    if (!clock->enabled || !IsThemeActive()) return FALSE;
+    if (!clock->theme)
+        clock->theme = OpenThemeDataForDpi(NULL, L"TrayNotify::Clock", GetDpiForWindow(hwnd));
+    return !!clock->theme;
+}
+
+static void clock_paint(HWND hwnd, HDC dc, struct external_clock *clock)
+{
+    WCHAR text[128];
+    HWND parent = GetParent(hwnd);
+    POINT origin = {0, 0};
+    RECT rect;
+    int saved = SaveDC(dc), parent_saved;
+
+    if (!saved) return;
+    GetClientRect(hwnd, &rect);
+    IntersectClipRect(dc, rect.left, rect.top, rect.right, rect.bottom);
+
+    /* The native notification area paints its actual oriented Luna panel.
+     * Keep its coordinates and the child's clip, including translated print DCs. */
+    MapWindowPoints(parent, hwnd, &origin, 1);
+    parent_saved = SaveDC(dc);
+    if (parent_saved)
+    {
+        OffsetViewportOrgEx(dc, origin.x, origin.y, NULL);
+        SendMessageW(parent, WM_PRINTCLIENT, (WPARAM)dc, PRF_CLIENT | PRF_ERASEBKGND);
+        RestoreDC(dc, parent_saved);
+    }
+
+    GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+    DrawThemeText(clock->theme, dc, CLP_TIME, CLS_NORMAL, text, -1,
+                  DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX, 0, &rect);
+    RestoreDC(dc, saved);
+}
+
+static LRESULT CALLBACK external_clock_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct external_clock *clock = (void *)GetPropW(hwnd, clock_property);
+    WNDPROC original = clock->original;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+        if (clock_theme(hwnd, clock))
+        {
+            /* The native paint handler also updates its formatted time and
+             * window text. Preserve that work before applying the theme. */
+            LRESULT result = CallWindowProcW(original, hwnd, msg, wparam, lparam);
+            HDC dc;
+            if (GetPropW(hwnd, clock_property) != (HANDLE)clock || !clock_theme(hwnd, clock)) return result;
+            dc = GetDC(hwnd);
+            if (dc)
+            {
+                clock_paint(hwnd, dc, clock);
+                ReleaseDC(hwnd, dc);
+            }
+            return result;
+        }
+        break;
+    case WM_PRINTCLIENT:
+        if (wparam && clock_theme(hwnd, clock))
+        {
+            clock_paint(hwnd, (HDC)wparam, clock);
+            return 0;
+        }
+        break;
+    case WM_ERASEBKGND:
+        if (clock_theme(hwnd, clock)) return 1;
+        break;
+    case WM_THEMECHANGED:
+        if (clock->theme) CloseThemeData(clock->theme);
+        clock->theme = NULL;
+        InvalidateRect(hwnd, NULL, TRUE);
+        break;
+    case WM_NCDESTROY:
+        SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)original);
+        RemovePropW(hwnd, clock_property);
+        if (clock->theme) CloseThemeData(clock->theme);
+        HeapFree(GetProcessHeap(), 0, clock);
+        break;
+    }
+    return CallWindowProcW(original, hwnd, msg, wparam, lparam);
+}
+
+void UXTHEME_InstallExternalClock(HWND hwnd, const WCHAR *app, const WCHAR *classes)
+{
+    struct external_clock *clock;
+    WCHAR name[64];
+    HWND parent = GetParent(hwnd);
+    DWORD process;
+    BOOL enabled = app && !lstrcmpiW(app, L"TrayNotify") && !classes;
+
+    GetWindowThreadProcessId(hwnd, &process);
+    if (process != GetCurrentProcessId()) return;
+    if ((clock = (void *)GetPropW(hwnd, clock_property)))
+    {
+        clock->enabled = enabled;
+        return;
+    }
+
+    if (!win4wine_external_shell() ||
+        !enabled ||
+        !GetClassNameW(hwnd, name, ARRAY_SIZE(name)) || lstrcmpW(name, L"TrayClockWClass") ||
+        !GetClassNameW(parent, name, ARRAY_SIZE(name)) || lstrcmpW(name, L"TrayNotifyWnd") ||
+        GetPropW(hwnd, clock_property)) return;
+
+    if (!(clock = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*clock)))) return;
+    clock->enabled = TRUE;
+    clock->original = (WNDPROC)GetWindowLongPtrW(hwnd, GWLP_WNDPROC);
+    if (!SetPropW(hwnd, clock_property, (HANDLE)clock))
+    {
+        HeapFree(GetProcessHeap(), 0, clock);
+        return;
+    }
+    SetLastError(0);
+    if (!SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)external_clock_proc) && GetLastError())
+    {
+        RemovePropW(hwnd, clock_property);
+        HeapFree(GetProcessHeap(), 0, clock);
+    }
+}
