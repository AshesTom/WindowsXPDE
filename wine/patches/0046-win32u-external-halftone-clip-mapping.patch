     src_width = src_rect->right - src_rect->left;
@@ -7479,6 +7486,56 @@ static void calc_halftone_params( const struct bitblt_coords *dst, const struct
     *src_start_y = mirrored_y ? src_rect->bottom - 1 : src_rect->top;
     *src_inc_x = mirrored_x ? -(float)src_width / dst_width : (float)src_width / dst_width;
     *src_inc_y = mirrored_y ? -(float)src_height / dst_height : (float)src_height / dst_height;
+    if (stable)
+    {
+        /* Clipping limits writes, not the original stretch mapping. Use an
+         * absolute destination sample index so partial repaints cannot reset
+         * the interpolation phase or accumulate a different rounding error. */
+        sample_offset->x = visible_dst.left - full_dst.left;
+        sample_offset->y = visible_dst.top - full_dst.top;
+        *src_start_x = mirrored_x ? full_src.right - 1 : full_src.left;
+        *src_start_y = mirrored_y ? full_src.bottom - 1 : full_src.top;
+        *src_inc_x = (float)src->width / dst->width;
+        *src_inc_y = (float)src->height / dst->height;
+    }
+    return stable;
+}
+
+/* The two source pixels along one axis for destination pixel INDEX, and the
+ * weight of the second: as Wine steps through the source (*POS), or, STABLE,
+ * from the index alone, so that the fractional phase does not depend on the
+ * integer source bitmap origin, which GetImage may rebase differently for a
+ * clipped blit. */
+static void halftone_sample( BOOL stable, float *pos, int start, int index, int source_size, int destination_size,
+                             int minimum, int maximum, int *lower, int *upper, float *fraction )
+{
+    LONGLONG numerator, position, remainder, denominator = destination_size;
+
+    if (!stable)
+    {
+        *pos = clampf( *pos, minimum, maximum );
+        *lower = *pos;
+        *upper = clamp( *lower + 1, minimum, maximum );
+        *fraction = *pos - *lower;
+        return;
+    }
+    numerator = (LONGLONG)index * source_size;
+    if (denominator < 0)
+    {
+        denominator = -denominator;
+        numerator = -numerator;
+    }
+    position = numerator / denominator;
+    remainder = numerator % denominator;
+    if (remainder < 0)
+    {
+        position--;
+        remainder += denominator;
+    }
+    position += start;
+    *lower = clamp( position, minimum, maximum );
+    *upper = min( *lower + 1, maximum );
+    *fraction = position < minimum || position >= maximum ? 0 : (float)remainder / denominator;
 }
 
