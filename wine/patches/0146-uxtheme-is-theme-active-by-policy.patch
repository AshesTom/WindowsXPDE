From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] uxtheme: export IsThemeActiveByPolicy as ordinal 73

Purpose: let XP's Display Properties choose a visual style (Windows Classic,
Windows XP style, third-party .msstyles).
XP behavior: themeui asks uxtheme ordinal 73, IsThemeActiveByPolicy, whether
a group policy imposes the visual style; only then is "Windows and buttons"
disabled and the style left alone on Apply.
Wine before: ordinal 73 was given to BufferedPaintClear, a stub returning
E_NOTIMPL, which themeui read as TRUE: the list stayed disabled and Apply
never changed the style.
Change: ordinal 73 is IsThemeActiveByPolicy, TRUE only when the SetVisualStyle
policy value is set (HKLM or HKCU ...\Policies\System).
Scope: callers of uxtheme ordinal 73; BufferedPaintClear keeps its name.
---
 dlls/uxtheme/system.c     | 23 +++++++++++++++++++++++
 dlls/uxtheme/uxtheme.spec |  1 +
 2 files changed, 24 insertions(+)

diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
index 2fafbe4..1f5501d 100644
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -1271,6 +1271,29 @@ HRESULT WINAPI DrawNCPreview(HDC hdc, DWORD flags, RECT *preview, LPCWSTR file,
     return S_OK;
 }
 
+/**********************************************************************
+ *      IsThemeActiveByPolicy                              (UXTHEME.73)
+ *
+ * Whether a group policy (SetVisualStyle) imposes the visual style, in which
+ * case Display Properties does not let the user choose one.
+ */
+BOOL WINAPI IsThemeActiveByPolicy(void)
+{
+    static const WCHAR policies[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\System";
+    HKEY roots[] = {HKEY_LOCAL_MACHINE, HKEY_CURRENT_USER};
+    WCHAR style[MAX_PATH];
+    DWORD size;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(roots); i++)
+    {
+        size = sizeof(style);
+        if (!RegGetValueW(roots[i], policies, L"SetVisualStyle", RRF_RT_REG_SZ, NULL, style, &size))
+            return TRUE;
+    }
+    return FALSE;
+}
+
 /**********************************************************************
  *      QueryThemeServices                                 (UXTHEME.1)
  *
diff --git a/dlls/uxtheme/uxtheme.spec b/dlls/uxtheme/uxtheme.spec
index 4ba8ac9..9eed477 100644
--- a/dlls/uxtheme/uxtheme.spec
+++ b/dlls/uxtheme/uxtheme.spec
@@ -44,6 +44,7 @@
 62 stub -noname ServerClearStockObjects
 63 stub -noname MarkSelection
 65 stdcall -noname SetSystemVisualStyle(wstr wstr wstr long)
+73 stdcall -noname IsThemeActiveByPolicy()
 104 stdcall -noname RefreshImmersiveColorPolicyState()
 132 stdcall -noname ShouldAppsUseDarkMode()
 133 stdcall -noname AllowDarkModeForWindow(ptr long)
