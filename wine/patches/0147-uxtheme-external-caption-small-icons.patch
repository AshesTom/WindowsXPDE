From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] win32u, uxtheme: draw 16x16 icons in captions

Purpose: title bars show each program's own 16x16 icon, as on XP, instead
of its big icon shrunk.
Windows behavior: when a window has only a big icon, the small icon
(WM_GETICON ICON_SMALL2) is that icon's 16x16 image from its resource; the
caption draws the small icon, then the class's small icon.
Wine before: the made-up small icon was the big image scaled down
(CopyImage without LR_COPYFROMRESOURCE), and the themed caption (win4wine patch 0069)
drew the big icon (ICON_BIG) before the class's small one.
Change: CopyImage with LR_COPYFROMRESOURCE, as for class icons; the themed
caption asks ICON_SMALL2, then GCLP_HICONSM, then the big icons.
Scope: windows with a big icon and no small one.
---
 dlls/uxtheme/window.c | 6 ++++--
 dlls/win32u/defwnd.c  | 4 ++--
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/dlls/uxtheme/window.c b/dlls/uxtheme/window.c
index 695ba82..a19e7f1 100644
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -553,9 +553,11 @@ static BOOL draw_non_client(HWND hwnd, HDC target, BOOL paint)
     text.left += border_x + 2;
     text.right -= border_x + 2;
     options = (DWORD)(DWORD_PTR)GetPropW(hwnd, L"Win4WineNonClientOptions");
-    icon = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_SMALL, 0);
-    if (!icon) icon = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_BIG, 0);
+    /* Small icons first, as the classic caption: the window's own or the one
+     * made from its big icon's 16x16 image, then the class's. */
+    icon = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_SMALL2, 0);
     if (!icon) icon = (HICON)GetClassLongPtrW(hwnd, GCLP_HICONSM);
+    if (!icon) icon = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_BIG, 0);
     if (!icon) icon = (HICON)GetClassLongPtrW(hwnd, GCLP_HICON);
     /* Match the classic caption's default icon, without adding one to modal dialogs. */
     if (!icon && !(exstyle & WS_EX_DLGMODALFRAME))
diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index a7511e1..5199124 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -392,7 +392,7 @@ static HICON set_window_icon( HWND hwnd, WPARAM type, HICON icon )
         {
             win->hIconSmall2 = CopyImage( win->hIcon, IMAGE_ICON,
                                           get_system_metrics( SM_CXSMICON ),
-                                          get_system_metrics( SM_CYSMICON ), 0 );
+                                          get_system_metrics( SM_CYSMICON ), LR_COPYFROMRESOURCE );
         }
         else if (icon && win->hIconSmall2)
         {
@@ -413,7 +413,7 @@ static HICON set_window_icon( HWND hwnd, WPARAM type, HICON icon )
         {
             win->hIconSmall2 = CopyImage( icon, IMAGE_ICON,
                                           get_system_metrics( SM_CXSMICON ),
-                                          get_system_metrics( SM_CYSMICON ), 0 );
+                                          get_system_metrics( SM_CYSMICON ), LR_COPYFROMRESOURCE );
         }
         win->hIcon = icon;
         break;
