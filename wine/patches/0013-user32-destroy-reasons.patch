From: Codex <codex@localhost>
Subject: [PATCH] user32: add DestroyReasons

Purpose: close XP's shut down dialog without aborting.
XP behavior: the dialog frees its shutdown reason list with DestroyReasons
when it closes, also when no list was built.
Change: export the function. Wine never builds a reason list, so there is
nothing to free.
Scope: every Wine application (the export was missing).
Old patches: 0053.
---
 dlls/user32/misc.c      | 12 ++++++++++++
 dlls/user32/user32.spec |  2 +-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/dlls/user32/misc.c b/dlls/user32/misc.c
index 6333fcb..7805333 100644
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -543,3 +543,15 @@ LRESULT WINAPI ImeWndProcW( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
     if (!imm_ime_wnd_proc) return DefWindowProcW(hwnd, msg, wParam, lParam);
     return imm_ime_wnd_proc( hwnd, msg, wParam, lParam, FALSE );
 }
+
+/***********************************************************************
+ *		DestroyReasons (USER32.@)
+ *
+ * Frees a shutdown reason list. The XP shutdown dialog calls this when it
+ * closes even when no reason list was built; Wine never builds one.
+ */
+BOOL WINAPI DestroyReasons( void *reasons )
+{
+    TRACE( "(%p)\n", reasons );
+    return TRUE;
+}
diff --git a/dlls/user32/user32.spec b/dlls/user32/user32.spec
index 0645792..647d298 100644
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -398,7 +398,7 @@
 # @ stub DestroyDCompositionHwndTarget
 @ stdcall DestroyIcon(long)
 @ stdcall DestroyMenu(long) NtUserDestroyMenu
-# @ stub DestroyReasons
+@ stdcall DestroyReasons(ptr)
 # @ stub DestroySyntheticPointerDevice
 @ stdcall DestroyWindow(long) NtUserDestroyWindow
 @ stdcall DialogBoxIndirectParamA(long ptr long ptr long)
