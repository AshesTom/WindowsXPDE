From: Codex <codex@localhost>
Subject: [PATCH] win32u: lay out and draw popup menus like XP in the external shell

Purpose: match XP's flat popup menus.
XP behavior: tests/menu-layout.c shows every popup menu four pixels wider
than Wine's at the same height: the arrow column is as wide as a check mark.
The submenu arrow is a 4x7 triangle three pixels from the item's right
edge, items start one pixel higher, and flat menus draw disabled text in
the grey text colour. Every separator reports MFS_GRAYED, whether it
came from a MENU or MENUEX resource, AppendMenu or InsertMenuItem
(tests/menu-separator.c).
Wine before: reserved the 9-pixel arrow bitmap and embossed disabled text
with a white copy under hard-coded 0x808080. Separators from MENUEX
resources and InsertMenuItem had state 0.
Change: the same as XP.
Evidence: the desktop's context menu equals XP's above its last separator,
apart from keyboard cue underlines. tests/menu-separator.c gives XP's
states for all eleven items.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0071.
---
 dlls/win32u/menu.c | 60 ++++++++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 51 insertions(+), 9 deletions(-)

diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
index 307932e..09e7984 100644
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -1021,6 +1021,10 @@ static BOOL set_menu_item_info( struct menu_item *menu, const MENUITEMINFOW *inf
 
     if (!menu->text && !(menu->fType & MFT_OWNERDRAW) && !menu->hbmpItem)
         menu->fType |= MFT_SEPARATOR;
+    /* XP reports every separator as grayed, also those from MENUEX resources
+     * and InsertMenuItem (tests/menu-separator.c). */
+    if ((menu->fType & MFT_SEPARATOR) && win4wine_external_shell())
+        menu->fState |= MFS_GRAYED;
 
     TRACE( "to: %s\n", debugstr_menuitem( menu ));
     return TRUE;
@@ -1990,6 +1994,31 @@ static HBITMAP get_arrow_bitmap(void)
     return arrow_bitmap;
 }
 
+/* XP's popup menus: the submenu arrow is a 4x7 triangle three pixels from the
+ * item's right edge, in an arrow column as wide as a check mark, and the items
+ * start one pixel higher; measured with tests/menu-layout.c and screenshots of
+ * the reference XP machine. */
+static BOOL xp_popup_menus(void)
+{
+    return win4wine_external_shell();
+}
+
+static HBITMAP get_xp_arrow_bitmap(void)
+{
+    static const BYTE bits[] = { 0x7f, 0xff, 0x3f, 0xff, 0x1f, 0xff, 0x0f, 0xff, 0x1f, 0xff, 0x3f, 0xff, 0x7f, 0xff };
+    static HBITMAP arrow;
+    if (!arrow) arrow = NtGdiCreateBitmap( 4, 7, 1, 1, bits );
+    return arrow;
+}
+
+static UINT popup_arrow_width(void)
+{
+    BITMAP bm;
+    if (xp_popup_menus()) return get_system_metrics( SM_CXMENUCHECK );
+    NtGdiExtGetObjectW( get_arrow_bitmap(), sizeof(bm), &bm );
+    return bm.bmWidth;
+}
+
 /* Get the size of a bitmap item */
 static void get_bitmap_item_size( struct menu_item *item, SIZE *size, HWND owner )
 {
@@ -2053,13 +2082,11 @@ static void calc_menu_item_size( HDC hdc, struct menu_item *item, HWND owner, IN
     UINT check_bitmap_width = get_system_metrics( SM_CXMENUCHECK );
     UINT arrow_bitmap_width;
     INT item_height;
-    BITMAP bm;
     WCHAR *p;
 
     TRACE( "dc=%p owner=%p (%d,%d) item %s\n", hdc, owner, org_x, org_y, debugstr_menuitem( item ));
 
-    NtGdiExtGetObjectW( get_arrow_bitmap(), sizeof(bm), &bm );
-    arrow_bitmap_width = bm.bmWidth;
+    arrow_bitmap_width = popup_arrow_width();
 
     if (!menucharsize.cx)
     {
@@ -2284,6 +2311,15 @@ static void draw_popup_arrow( HDC hdc, RECT rect, UINT arrow_width, UINT arrow_h
     HDC mem_hdc = NtGdiCreateCompatibleDC( hdc );
     HBITMAP prev_bitmap;
 
+    if (xp_popup_menus())
+    {
+        prev_bitmap = NtGdiSelectBitmap( mem_hdc, get_xp_arrow_bitmap() );
+        NtGdiBitBlt( hdc, rect.right - 7, rect.top + (rect.bottom - rect.top - 7) / 2,
+                     4, 7, mem_hdc, 0, 0, SRCCOPY, 0, 0 );
+        NtGdiSelectBitmap( mem_hdc, prev_bitmap );
+        NtGdiDeleteObjectApp( mem_hdc );
+        return;
+    }
     prev_bitmap = NtGdiSelectBitmap( mem_hdc, get_arrow_bitmap() );
     NtGdiBitBlt( hdc, rect.right - arrow_width - 1,
                  (rect.top + rect.bottom - arrow_height) / 2,
@@ -2445,7 +2481,7 @@ static void draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc,
     {
         BITMAP bmp;
         NtGdiExtGetObjectW( get_arrow_bitmap(), sizeof(bmp), &bmp );
-        arrow_width = bmp.bmWidth;
+        arrow_width = popup_arrow_width();
         arrow_height = bmp.bmHeight;
     }
 
@@ -2728,7 +2764,11 @@ static void draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc,
             if ((item->text[i] == '\t') || (item->text[i] == '\b'))
                 break;
 
-        if (item->fState & MF_GRAYED)
+        /* XP's flat menus draw disabled text in the gray text colour, without the
+         * classic embossing. */
+        if ((item->fState & MF_GRAYED) && flat_menu && xp_popup_menus())
+            NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, get_sys_color( COLOR_GRAYTEXT ), NULL );
+        else if (item->fState & MF_GRAYED)
         {
             if (!(item->fState & MF_HILITE) )
             {
@@ -2756,7 +2796,9 @@ static void draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc,
                 format = DT_RIGHT | DT_VCENTER | DT_SINGLELINE;
             }
 
-            if (item->fState & MF_GRAYED)
+            if ((item->fState & MF_GRAYED) && flat_menu && xp_popup_menus())
+                NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, get_sys_color( COLOR_GRAYTEXT ), NULL );
+            else if (item->fState & MF_GRAYED)
             {
                 if (!(item->fState & MF_HILITE) )
                 {
@@ -3086,8 +3128,8 @@ static void calc_popup_menu_size( struct menu *menu, UINT max_height )
     menu->nTotalHeight = menu->items_rect.bottom;
 
     /* space for the border */
-    OffsetRect( &menu->items_rect, MENU_MARGIN, MENU_MARGIN );
-    menu->Height = menu->items_rect.bottom + MENU_MARGIN;
+    OffsetRect( &menu->items_rect, MENU_MARGIN, MENU_MARGIN - (xp_popup_menus() ? 1 : 0) );
+    menu->Height = menu->items_rect.bottom + MENU_MARGIN + (xp_popup_menus() ? 1 : 0);
     menu->Width = menu->items_rect.right + MENU_MARGIN;
 
     /* Adjust popup height if it exceeds maximum */
@@ -3476,7 +3518,7 @@ static HMENU show_sub_popup( HWND owner, HMENU hmenu, BOOL select_first, UINT fl
                 rect.left += get_system_metrics( SM_CXBORDER );
             else
                 rect.left += item_rect.right - get_system_metrics( SM_CXBORDER );
-            rect.top += item_rect.top - MENU_MARGIN;
+            rect.top += item_rect.top - MENU_MARGIN + (xp_popup_menus() ? 1 : 0);
             rect.right = item_rect.left - item_rect.right + get_system_metrics( SM_CXBORDER );
             rect.bottom = item_rect.top - item_rect.bottom - 2 * MENU_MARGIN;
         }
