From: Codex <codex@localhost>
Subject: [PATCH] win32u: keep keyboard-cue UI state in the external shell

Purpose: hide focus rectangles and access-key underlines in native XP
controls until Alt is pressed, when keyboard cues are off.
XP behavior: measured with tests/ui-state.c with keyboard cues on and off:
windows start with every cue shown, WM_CHANGEUISTATE is forwarded to the
top-level window, which sends WM_UPDATEUISTATE to its tree only if its
state changes, and hiding requests are ignored while cues are on.
Wine before: DefWindowProc ignored WM_QUERYUISTATE, WM_CHANGEUISTATE and
WM_UPDATEUISTATE; WM_QUERYUISTATE always returned 0.
Change: keep the state per window and handle the three messages like XP.
Evidence: tests/ui-state.c passes on XP and patched Wine.
Reference: https://learn.microsoft.com/en-us/windows/win32/menurc/wm-changeuistate
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0050.
---
 dlls/win32u/defwnd.c | 89 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index 280f1f3..7b12d55 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -27,6 +27,7 @@
 #include "ntgdi_private.h"
 #include "ntuser_private.h"
 #include "wine/server.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
 
@@ -2491,6 +2492,79 @@ static LRESULT handle_nc_mouse_leave( HWND hwnd )
 }
 
 
+/* Keyboard-cue UI state for the opted-in external shell. XP's native controls
+ * ask WM_QUERYUISTATE before drawing focus rectangles and access-key
+ * underlines. Measured on XP with tests/ui-state.c: windows start with all
+ * cues shown, a top-level window propagates only real changes to its
+ * children, and hiding requests are ignored while keyboard cues are on. A
+ * window without its own state follows its parent. */
+static const WCHAR ui_state_prop[] = {'_','_','w','i','n','e','_','u','i','_','s','t','a','t','e',0};
+#define UI_STATE_SET 0x100
+#define UI_STATE_MASK (UISF_HIDEFOCUS | UISF_HIDEACCEL | UISF_ACTIVE)
+
+static BOOL keyboard_cues(void)
+{
+    BOOL cues = FALSE;
+    NtUserSystemParametersInfo( SPI_GETKEYBOARDCUES, 0, &cues, 0 );
+    return cues;
+}
+
+static UINT get_ui_state( HWND hwnd )
+{
+    UINT depth;
+
+    for (depth = 0; hwnd && depth < 64; depth++)
+    {
+        UINT state = HandleToUlong( NtUserGetProp( hwnd, ui_state_prop ));
+        if (state & UI_STATE_SET) return state & UI_STATE_MASK;
+        if (!(get_window_long( hwnd, GWL_STYLE ) & WS_CHILD)) break;
+        hwnd = NtUserGetAncestor( hwnd, GA_PARENT );
+    }
+    return 0;
+}
+
+static BOOL valid_ui_state_change( WPARAM wparam )
+{
+    UINT action = LOWORD( wparam ), flags = HIWORD( wparam );
+    return action >= UIS_SET && action <= UIS_INITIALIZE && flags && !(flags & ~UI_STATE_MASK);
+}
+
+/* Measured on XP: with keyboard cues on, requests to hide cues are ignored. */
+static UINT changed_ui_state( UINT state, WPARAM wparam )
+{
+    UINT action = LOWORD( wparam ), flags = HIWORD( wparam );
+    BOOL cues = keyboard_cues();
+
+    if (action == UIS_INITIALIZE) action = cues ? UIS_CLEAR : UIS_SET;
+    if (action == UIS_SET && cues) flags &= ~(UISF_HIDEFOCUS | UISF_HIDEACCEL);
+    return action == UIS_SET ? state | flags : state & ~flags;
+}
+
+static void update_ui_state( HWND hwnd, WPARAM wparam )
+{
+    UINT state;
+    HWND *list;
+    int i;
+
+    if (!valid_ui_state_change( wparam )) return;
+    state = changed_ui_state( get_ui_state( hwnd ), wparam );
+    NtUserSetProp( hwnd, ui_state_prop, ULongToHandle( state | UI_STATE_SET ));
+    if (!(list = list_window_children( hwnd ))) return;
+    for (i = 0; list[i]; i++) send_message( list[i], WM_UPDATEUISTATE, wparam, 0 );
+    free( list );
+}
+
+static void change_ui_state( HWND hwnd, WPARAM wparam, LPARAM lparam )
+{
+    HWND parent = NtUserGetAncestor( hwnd, GA_PARENT );
+
+    if (!valid_ui_state_change( wparam )) return;
+    if ((get_window_long( hwnd, GWL_STYLE ) & WS_CHILD) && parent && parent != get_desktop_window())
+        send_message( parent, WM_CHANGEUISTATE, wparam, lparam );
+    else if (changed_ui_state( get_ui_state( hwnd ), wparam ) != get_ui_state( hwnd ))
+        send_message( hwnd, WM_UPDATEUISTATE, wparam, 0 );
+}
+
 LRESULT default_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, BOOL ansi )
 {
     LRESULT result = 0;
@@ -2586,6 +2660,18 @@ LRESULT default_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam,
         }
         break;
 
+    case WM_QUERYUISTATE:
+        if (win4wine_external_shell()) result = get_ui_state( hwnd );
+        break;
+
+    case WM_CHANGEUISTATE:
+        if (win4wine_external_shell()) change_ui_state( hwnd, wparam, lparam );
+        break;
+
+    case WM_UPDATEUISTATE:
+        if (win4wine_external_shell()) update_ui_state( hwnd, wparam );
+        break;
+
     case WM_CONTEXTMENU:
         if (get_window_long( hwnd, GWL_STYLE ) & WS_CHILD)
             send_message( get_parent( hwnd ), msg, (WPARAM)hwnd, lparam );
@@ -2847,6 +2933,9 @@ LRESULT default_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam,
     case WM_SYSKEYDOWN:
         if (HIWORD( lparam ) & KEYDATA_ALT)
         {
+            if ((wparam == VK_MENU || wparam == VK_LMENU || wparam == VK_RMENU) && win4wine_external_shell() &&
+                !(HIWORD( lparam ) & KF_REPEAT))
+                send_message( hwnd, WM_CHANGEUISTATE, MAKEWPARAM( UIS_CLEAR, UISF_HIDEACCEL | UISF_HIDEFOCUS ), 0 );
             if ((wparam == VK_MENU || wparam == VK_LMENU || wparam == VK_RMENU) && !menu_sys_key)
                 menu_sys_key = 1;
             else
