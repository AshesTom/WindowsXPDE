From: Win4Wine contributors
Subject: [PATCH] winex11: refresh external-shell work areas without a mode change

Observe bounded public EWMH/GTK work-area properties on the desktop owner
thread. Deduplicate contents, refresh shared monitor data, and send a bounded
setting-change notification. Keep explicit process SPI work-area overrides
and all ordinary Wine behavior. Append the internal call number without
renumbering existing calls. No Microsoft code or resources are involved.

--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -992,6 +992,7 @@
     /* temporary exports */
     NtUserExitingThread,
     NtUserThreadDetach,
+    NtUserCallNoParam_WorkAreaChanged,
 };
 
 static inline BOOL NtUserDestroyCaret(void)
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -288,6 +288,7 @@
 
 static UINT system_dpi;
 static RECT work_area;
+static BOOL work_area_explicit;
 static DWORD process_layout = ~0u;
 
 static HDC display_dc;
@@ -5824,6 +5825,7 @@
         if (!ptr) return FALSE;
         spi_idx = SPI_SETWORKAREA_IDX;
         work_area = *(RECT*)ptr;
+        work_area_explicit = TRUE;
         spi_loaded[spi_idx] = TRUE;
         ret = TRUE;
         break;
@@ -5836,7 +5838,8 @@
         if (!ptr) return FALSE;
 
         spi_idx = SPI_SETWORKAREA_IDX;
-        if (!spi_loaded[spi_idx])
+        if (!spi_loaded[spi_idx] ||
+            (getenv( "WIN4WINE_EXTERNAL_SHELL" ) && !work_area_explicit))
         {
             struct monitor *monitor;
 
@@ -6966,6 +6969,18 @@
         display_mode_changed( FALSE );
         return TRUE;
 
+    case NtUserCallNoParam_WorkAreaChanged:
+    {
+        static const WCHAR emptyW[1];
+        if (!getenv( "WIN4WINE_EXTERNAL_SHELL" ) || !update_display_cache( TRUE )) return FALSE;
+        /* The screen mode is unchanged. Notify applications only after the
+         * shared monitor work areas have been refreshed. Keep pointer data
+         * in a bounded synchronous call, as for SPIF_SENDCHANGE above. */
+        send_message_timeout( HWND_BROADCAST, WM_SETTINGCHANGE, SPI_SETWORKAREA,
+                              (LPARAM)emptyW, SMTO_ABORTIFHUNG, 200, FALSE );
+        return TRUE;
+    }
+
     /* temporary exports */
     case NtUserExitingThread:
         exiting_thread_id = GetCurrentThreadId();
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -1262,6 +1262,61 @@
     if (event->state == PropertyNewValue) net_supported_init( data );
 }
 
+/* Only the desktop owner publishes shared monitor state. Deduplicate
+ * property contents rather than X event serials: WMs may repeatedly write
+ * identical reservations, and a single update may change both properties. */
+static void handle_work_area_notify( HWND hwnd, XPropertyEvent *event )
+{
+    static struct work_area_property
+    {
+        Atom type;
+        int format;
+        unsigned long count;
+        unsigned char *data;
+        BOOL initialized;
+    } cached[2];
+    Atom atoms[2] = {x11drv_atom(_NET_WORKAREA), x11drv_atom(_GTK_WORKAREAS_D0)};
+    BOOL changed = FALSE;
+    unsigned int i;
+
+    if (!getenv( "WIN4WINE_EXTERNAL_SHELL" ) || event->window != root_window ||
+        hwnd != NtUserGetDesktopWindow() || NtUserGetWindowThread( hwnd, NULL ) != GetCurrentThreadId()) return;
+    for (i = 0; i < ARRAY_SIZE(atoms); i++)
+    {
+        Atom type;
+        int format;
+        unsigned long count, remaining;
+        unsigned char *data = NULL;
+        SIZE_T size;
+
+        if (XGetWindowProperty( event->display, root_window, atoms[i], 0, 4096, False,
+                                AnyPropertyType, &type, &format, &count, &remaining, &data )) continue;
+        /* A work area is a bounded CARDINAL32 array of rectangle tuples.
+         * Property deletion is valid and restores the driver's fallback. */
+        if (remaining || count > 4096 ||
+            (type != None && (type != XA_CARDINAL || format != 32 || count < 4 || count % 4)))
+        {
+            XFree( data );
+            continue;
+        }
+        size = count * sizeof(long);
+        if (!cached[i].initialized || cached[i].type != type || cached[i].format != format ||
+            cached[i].count != count || (size && memcmp( cached[i].data, data, size )))
+        {
+            XFree( cached[i].data );
+            cached[i].type = type;
+            cached[i].format = format;
+            cached[i].count = count;
+            cached[i].data = data;
+            cached[i].initialized = TRUE;
+            changed = TRUE;
+        }
+        else XFree( data );
+    }
+    if (changed && !NtUserCallNoParam( NtUserCallNoParam_WorkAreaChanged ))
+        for (i = 0; i < ARRAY_SIZE(cached); i++) cached[i].initialized = FALSE;
+}
+
 /***********************************************************************
  *           X11DRV_PropertyNotify
  */
@@ -1274,6 +1329,8 @@
     if (event->atom == x11drv_atom(_XEMBED_INFO)) handle_xembed_info_notify( hwnd, event );
     if (event->atom == x11drv_atom(_NET_WM_STATE)) handle_net_wm_state_notify( hwnd, event );
     if (event->atom == x11drv_atom(_NET_SUPPORTED)) handle_net_supported_notify( event );
+    if (event->atom == x11drv_atom(_NET_WORKAREA) || event->atom == x11drv_atom(_GTK_WORKAREAS_D0))
+        handle_work_area_notify( hwnd, event );
 
     return TRUE;
 }
