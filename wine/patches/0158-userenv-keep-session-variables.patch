From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] userenv: keep win4wine's session variables in environment blocks

Purpose: programs that a service starts in the XP session (XP's Security
Center alerts, wscntfy.exe, which wscsvc starts with the user's token and
environment block) behave as the session's: their notification icon reaches
the XP taskbar in its format (0034).
Windows behavior: CreateEnvironmentBlock builds the block from the registry
and the user's profile.
Wine before: the same, so the session's WIN4WINE_* variables, which are not
in the registry, were lost between services.exe, svchost and the programs
they start.
Change: copy the caller's WIN4WINE_* variables into the block.
Scope: processes that have WIN4WINE_* variables (the session's).
---
diff --git a/dlls/userenv/userenv_main.c b/dlls/userenv/userenv_main.c
--- a/dlls/userenv/userenv_main.c
+++ b/dlls/userenv/userenv_main.c
@@ -169,6 +169,25 @@
     RegCloseKey(hkey);
 }
 
+/* win4wine's session variables (WIN4WINE_EXTERNAL_SHELL...) are not in the
+ * registry: keep the caller's, so that the programs a service starts in the
+ * session (XP's Security Center notification, wscntfy.exe, from wscsvc) run
+ * as the session's own. */
+static void set_win4wine_variables(WCHAR **env)
+{
+    WCHAR *strings = GetEnvironmentStringsW(), *var, *value;
+
+    if (!strings) return;
+    for (var = strings; *var; var += lstrlenW(var) + 1)
+    {
+        if (wcsnicmp(var, L"WIN4WINE_", 9) || !(value = wcschr(var, '='))) continue;
+        *value = 0;
+        set_env_var(env, var, value + 1);
+        *value = '=';
+    }
+    FreeEnvironmentStringsW(strings);
+}
+
 BOOL WINAPI CreateEnvironmentBlock( LPVOID* lpEnvironment,
                      HANDLE hToken, BOOL bInherit )
 {
@@ -261,6 +280,7 @@
         set_env_var(&env, L"COMPUTERNAME", buf);
 
     set_wow64_environment(&env);
+    set_win4wine_variables(&env);
 
     if (!hToken)
     {
