+/* Localized theme values. A localized msstyles keeps per-language
+ * overrides in its string table, written as "NormalBlue@[Section]Name=Value"
+ * for the color/size variant whose ini is NORMALBLUE_INI. The Japanese Luna
+ * uses them for its MS UI Gothic fonts. XP applies them over the ini; the
+ * public GetThemeFont results on the reference machine match these values. */
+struct localized_value
+{
+    struct localized_value *next;
+    WCHAR *section;
+    WCHAR *property;
+    WCHAR *value;
+    BOOL used;
+};
+
+struct localized_context
+{
+    PTHEME_FILE tf;
+    LPCWSTR prefix;
+    int prefix_len;
+};
+
+static WCHAR *dup_trimmed(LPCWSTR start, LPCWSTR end)
+{
+    WCHAR *copy;
+    while (start < end && (*start == ' ' || *start == '\t')) start++;
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t')) end--;
+    if (!(copy = malloc((end - start + 1) * sizeof(WCHAR)))) return NULL;
+    memcpy(copy, start, (end - start) * sizeof(WCHAR));
+    copy[end - start] = 0;
+    return copy;
+}
+
+static void free_localized_values(PTHEME_FILE tf)
+{
+    while (tf->localized)
+    {
+        struct localized_value *value = tf->localized;
+        tf->localized = value->next;
+        free(value->section);
+        free(value->property);
+        free(value->value);
+        free(value);
+    }
+}
+
+static BOOL CALLBACK collect_localized_block(HMODULE module, LPCWSTR type, LPWSTR name, LONG_PTR param)
+{
+    struct localized_context *ctx = (struct localized_context *)param;
+    WCHAR buffer[512];
+    UINT i;
+
+    if (!IS_INTRESOURCE(name) || !LOWORD(name)) return TRUE;
+    for (i = 0; i < 16; i++)
+    {
+        UINT id = (LOWORD(name) - 1) * 16 + i;
+        int len = LoadStringW(module, id, buffer, ARRAY_SIZE(buffer));
+        WCHAR *at, *close, *equal;
+        struct localized_value *value;
+
+        if (len <= 0 || len >= ARRAY_SIZE(buffer) - 1) continue;
+        if (!(at = wcschr(buffer, '@')) || at - buffer != ctx->prefix_len || at[1] != '[') continue;
+        if (CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, buffer, ctx->prefix_len,
+                           ctx->prefix, ctx->prefix_len) != CSTR_EQUAL) continue;
+        if (!(close = wcschr(at + 2, ']')) || !(equal = wcschr(close + 1, '='))) continue;
+        if (!(value = calloc(1, sizeof(*value)))) break;
+        value->section = dup_trimmed(at + 2, close);
+        value->property = dup_trimmed(close + 1, equal);
+        value->value = dup_trimmed(equal + 1, buffer + len);
+        if (!value->section || !value->property || !value->value)
+        {
+            free(value->section);
+            free(value->property);
+            free(value->value);
+            free(value);
+            continue;
+        }
+        value->next = ctx->tf->localized;
+        ctx->tf->localized = value;
+    }
+    return TRUE;
+}
+
+static void load_localized_values(PTHEME_FILE tf, LPCWSTR ini_name)
+{
+    struct localized_context ctx = {tf, ini_name, 0};
+    int len;
+
+    if (tf->localized_loaded) return;
+    tf->localized_loaded = TRUE;
+    if (!ini_name || !GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0)) return;
+    len = lstrlenW(ini_name);
+    if (len > 4 && !lstrcmpiW(ini_name + len - 4, L"_INI")) len -= 4;
+    ctx.prefix_len = len;
+    EnumResourceNamesW(tf->hTheme, (LPCWSTR)RT_STRING, collect_localized_block, (LONG_PTR)&ctx);
+}
+
+static struct localized_value *find_localized(PTHEME_FILE tf, LPCWSTR section, DWORD section_len, LPCWSTR property)
+{
+    struct localized_value *value;
+    for (value = tf->localized; value; value = value->next)
+        if (CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, value->section, -1, section, section_len) == CSTR_EQUAL &&
+            !lstrcmpiW(value->property, property))
+            return value;
+    return NULL;
+}
+
 /***********************************************************************
  *      MSSTYLES_ParseThemeIni
  *
@@ -936,10 +1045,17 @@ static void MSSTYLES_ParseThemeIni(PTHEME_FILE tf, BOOL setMetrics)
     LPCWSTR lpName;
     DWORD dwValueLen;
     LPCWSTR lpValue;
+    LPCWSTR ini_name = NULL, section;
+    DWORD section_len;
+    struct localized_value *localized;
 
-    ini = MSSTYLES_GetActiveThemeIni(tf);
+    ini = MSSTYLES_GetActiveThemeIni(tf, &ini_name);
+    load_localized_values(tf, ini_name);
+    for (localized = tf->localized; localized; localized = localized->next) localized->used = FALSE;
 
     while((lpName=UXINI_GetNextSection(ini, &dwLen))) {
+        section = lpName;
+        section_len = dwLen;
         if(CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, lpName, dwLen, L"SysMetrics", -1) == CSTR_EQUAL) {
             struct PARSECOLORSTATE colorState;
             struct PARSENONCLIENTSTATE nonClientState;
@@ -949,6 +1065,12 @@ static void MSSTYLES_ParseThemeIni(PTHEME_FILE tf, BOOL setMetrics)
 
             while((lpName=UXINI_GetNextValue(ini, &dwLen, &lpValue, &dwValueLen))) {
                 lstrcpynW(szPropertyName, lpName, min(dwLen+1, ARRAY_SIZE(szPropertyName)));
+                if ((localized = find_localized(tf, section, section_len, szPropertyName)))
+                {
+                    lpValue = localized->value;
+                    dwValueLen = lstrlenW(localized->value);
+                    localized->used = TRUE;
+                }
                 if(MSSTYLES_LookupProperty(szPropertyName, &iPropertyPrimitive, &iPropertyId)) {
                     if(iPropertyId >= TMT_FIRSTCOLOR && iPropertyId <= TMT_LASTCOLOR) {
                         if (!parse_handle_color_property (&colorState, iPropertyId, 
@@ -1000,6 +1122,12 @@ static void MSSTYLES_ParseThemeIni(PTHEME_FILE tf, BOOL setMetrics)
 
             while((lpName=UXINI_GetNextValue(ini, &dwLen, &lpValue, &dwValueLen))) {
                 lstrcpynW(szPropertyName, lpName, min(dwLen+1, ARRAY_SIZE(szPropertyName)));
+                if ((localized = find_localized(tf, section, section_len, szPropertyName)))
+                {
+                    lpValue = localized->value;
+                    dwValueLen = lstrlenW(localized->value);
+                    localized->used = TRUE;
+                }
                 if(MSSTYLES_LookupProperty(szPropertyName, &iPropertyPrimitive, &iPropertyId)) {
                     MSSTYLES_AddProperty(ps, iPropertyPrimitive, iPropertyId, lpValue, dwValueLen, isGlobal);
                 }
@@ -1010,6 +1138,19 @@ static void MSSTYLES_ParseThemeIni(PTHEME_FILE tf, BOOL setMetrics)
         }
     }
 
+    /* Localized values for properties or sections that the ini omits. */
+    for (localized = tf->localized; localized; localized = localized->next)
+    {
+        if (localized->used || !lstrcmpiW(localized->section, L"SysMetrics")) continue;
+        if (!MSSTYLES_ParseIniSectionName(localized->section, lstrlenW(localized->section),
+                                          szAppName, szClassName, &iPartId, &iStateId)) continue;
+        if (!MSSTYLES_LookupProperty(localized->property, &iPropertyPrimitive, &iPropertyId)) continue;
+        cls = MSSTYLES_AddClass(tf, szAppName, szClassName);
+        ps = MSSTYLES_AddPartState(cls, iPartId, iStateId);
+        MSSTYLES_AddProperty(ps, iPropertyPrimitive, iPropertyId, localized->value,
+                             lstrlenW(localized->value), !lstrcmpiW(szClassName, L"globals"));
+    }
+
     /* App/Class combos override values defined by the base class, map these overrides */
     globals = MSSTYLES_FindClass(tf, NULL, L"globals");
     cls = tf->classes;
