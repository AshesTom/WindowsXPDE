@@ -318,6 +320,7 @@ static PUXINI_FILE MSSTYLES_GetActiveThemeIni(PTHEME_FILE tf)
     for(i=0; i < dwResourceIndex; i++) {
         tmp += lstrlenW(tmp)+1;
     }
+    if (name) *name = tmp;
     return UXINI_LoadINI(tf->hTheme, tmp);
