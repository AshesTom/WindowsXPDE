From: Codex <codex@localhost>
Subject: [PATCH] comctl32, user32: draw the external shell's address ComboBox with the theme

Purpose: show the folder window's address bar like XP.
The native XP comctl32 is loaded without its SxS activation context, so
the ComboBox that its ComboBoxEx creates is user32's, which has no theme:
the address bar had a classic sunken edge and drop-down button. As for
the Start button, user32 now gives a ComboBox whose parent is a
ComboBoxEx32 in the opted-in external shell Wine's themed comctl32
implementation from the separately named controls module, with its own
list box class. That alias also follows what the reference XP machine
shows: its button fills the client height inside the one-pixel frame,
and CB_GETITEMHEIGHT(-1) returns the height set with CB_SETITEMHEIGHT
(Wine's tests mark this todo_wine), from which ComboBoxEx sizes itself,
so the address band is 22 pixels high instead of 24. tests/toolbar-layout.c
reports the same folder-window child layout as XP, and the drop-down
button's pixels equal XP's. Other ComboBoxes are unchanged.

diff --git a/dlls/comctl32/combo.c b/dlls/comctl32/combo.c
index 0957995..cff58ee 100644
--- a/dlls/comctl32/combo.c
+++ b/dlls/comctl32/combo.c
@@ -80,6 +80,12 @@ static UINT	CBitHeight, CBitWidth;
 static void CBCalcPlacement(HEADCOMBO *combo);
 static void CBResetPos(HEADCOMBO *combo);
 
+static BOOL is_external_alias(HWND hwnd)
+{
+    WCHAR name[32];
+    return GetClassNameW(hwnd, name, ARRAY_SIZE(name)) && !wcscmp(name, L"Win4WineComboBox");
+}
+
 /***********************************************************************
  *           COMBO_Init
  *
@@ -339,6 +345,16 @@ static void CBCalcPlacement(HEADCOMBO *combo)
          */
         combo->buttonRect.left = combo->buttonRect.right - GetSystemMetrics(SM_CXVSCROLL);
         combo->textRect.right = combo->buttonRect.left;
+
+        /* XP's themed ComboBox insets its button only by the one pixel frame
+         * and lets it fill the client height; measured on the folder address bar. */
+        if (is_external_alias(combo->self) && GetWindowTheme(combo->self))
+        {
+            RECT client;
+            GetClientRect(combo->self, &client);
+            SetRect(&combo->buttonRect, client.right - 1 - GetSystemMetrics(SM_CXVSCROLL), client.top + 1,
+                    client.right - 1, client.bottom - 1);
+        }
     }
 
     /* In the case of a dropdown, there is an additional spacing between the text area and the button. */
@@ -484,10 +500,13 @@ static LRESULT COMBO_Create( HWND hwnd, LPHEADCOMBO lphc, HWND hwndParent, LONG
         lbeExStyle |= (WS_EX_TOPMOST | WS_EX_TOOLWINDOW);
       }
 
-      lphc->hWndLBox = CreateWindowExW(lbeExStyle, L"ComboLBox", NULL, lbeStyle,
-              lphc->droppedRect.left, lphc->droppedRect.top, lphc->droppedRect.right - lphc->droppedRect.left,
-              lphc->droppedRect.bottom - lphc->droppedRect.top, hwnd, (HMENU)ID_CB_LISTBOX,
-              (HINSTANCE)GetWindowLongPtrW( hwnd, GWLP_HINSTANCE ), lphc );
+      {
+          const WCHAR *lbox_class = is_external_alias(hwnd) ? L"Win4WineComboLBox" : L"ComboLBox";
+          lphc->hWndLBox = CreateWindowExW(lbeExStyle, lbox_class, NULL, lbeStyle,
+                  lphc->droppedRect.left, lphc->droppedRect.top, lphc->droppedRect.right - lphc->droppedRect.left,
+                  lphc->droppedRect.bottom - lphc->droppedRect.top, hwnd, (HMENU)ID_CB_LISTBOX,
+                  (HINSTANCE)GetWindowLongPtrW( hwnd, GWLP_HINSTANCE ), lphc );
+      }
       if( lphc->hWndLBox )
       {
 	  BOOL	bEdit = TRUE;
@@ -1476,6 +1495,7 @@ static LRESULT COMBO_SetItemHeight( LPHEADCOMBO lphc, INT index, INT height )
        if( height < 32768 )
        {
            lphc->item_height = height + 2;  /* Is the 2 for 2*EDIT_CONTROL_PADDING? */
+           lphc->text_height_set = is_external_alias(lphc->self);
 
 	 /*
 	  * Redo the layout of the control.
@@ -1967,6 +1987,8 @@ static LRESULT CALLBACK COMBO_WindowProc( HWND hwnd, UINT message, WPARAM wParam
     case CB_GETITEMHEIGHT:
         if ((INT)wParam >= 0) /* listbox item */
             return SendMessageW(lphc->hWndLBox, LB_GETITEMHEIGHT, wParam, 0);
+        /* Windows returns the height that was set; ComboBoxEx sizes itself from it. */
+        if (lphc->text_height_set) return CBGetTextAreaHeight(lphc, FALSE) - 2;
         return CBGetTextAreaHeight(lphc, FALSE);
 
     case CB_RESETCONTENT:
@@ -2114,7 +2136,7 @@ static LRESULT CALLBACK COMBO_WindowProc( HWND hwnd, UINT message, WPARAM wParam
     return DefWindowProcW(hwnd, message, wParam, lParam);
 }
 
-void COMBO_Register(void)
+static void register_combo_class(const WCHAR *name)
 {
     WNDCLASSW wndClass;
 
@@ -2125,6 +2147,23 @@ void COMBO_Register(void)
     wndClass.cbWndExtra = sizeof(HEADCOMBO *);
     wndClass.hCursor = LoadCursorW(0, (LPWSTR)IDC_ARROW);
     wndClass.hbrBackground = NULL;
-    wndClass.lpszClassName = WC_COMBOBOXW;
+    wndClass.lpszClassName = name;
     RegisterClassW(&wndClass);
 }
+
+void COMBO_Register(void)
+{
+    register_combo_class(WC_COMBOBOXW);
+}
+
+/* For the opted-in external XP shell: native comctl32 v6 is loaded without its
+ * SxS activation context, so the address bar's ComboBoxEx would otherwise get
+ * user32's unthemed ComboBox. user32 redirects that one child to this alias. */
+BOOL WINAPI Win4WineRegisterComboBox(void)
+{
+    WNDCLASSW wc;
+    if (GetClassInfoW(COMCTL32_hModule, L"Win4WineComboBox", &wc)) return TRUE;
+    register_combo_class(L"Win4WineComboBox");
+    COMBOLBOX_RegisterAlias(L"Win4WineComboLBox");
+    return GetClassInfoW(COMCTL32_hModule, L"Win4WineComboBox", &wc);
+}
diff --git a/dlls/comctl32/comctl32.h b/dlls/comctl32/comctl32.h
index f44b4ae..5adf923 100644
--- a/dlls/comctl32/comctl32.h
+++ b/dlls/comctl32/comctl32.h
@@ -156,6 +156,7 @@ typedef struct
    INT            droppedWidth;   /* not used unless set explicitly */
    INT            item_height;
    INT            visibleItems;
+   BOOL           text_height_set; /* external shell alias: CB_SETITEMHEIGHT(-1) was used */
 } HEADCOMBO, *LPHEADCOMBO;
 
 extern BOOL COMBO_FlipListbox(HEADCOMBO *lphc, BOOL ok, BOOL bRedrawButton);
@@ -238,6 +239,7 @@ extern void COMBO_Register(void);
 extern void COMBOEX_Register(void);
 extern void COMBOEX_Unregister(void);
 extern void COMBOLBOX_Register(void);
+extern void COMBOLBOX_RegisterAlias(const WCHAR *name);
 extern void DATETIME_Register(void);
 extern void DATETIME_Unregister(void);
 extern void EDIT_Register(void);
diff --git a/dlls/comctl32/comctl32.spec b/dlls/comctl32/comctl32.spec
index 74ecd1f..39fdf50 100644
--- a/dlls/comctl32/comctl32.spec
+++ b/dlls/comctl32/comctl32.spec
@@ -199,3 +199,4 @@
 @ stdcall UninitializeFlatSB(long)
 @ stdcall _TrackMouseEvent(ptr)
 @ stdcall Win4WineRegisterStartButton()
+@ stdcall Win4WineRegisterComboBox()
diff --git a/dlls/comctl32/listbox.c b/dlls/comctl32/listbox.c
index 951b858..07fa64b 100644
--- a/dlls/comctl32/listbox.c
+++ b/dlls/comctl32/listbox.c
@@ -3163,7 +3163,7 @@ void LISTBOX_Register(void)
     RegisterClassW(&wndClass);
 }
 
-void COMBOLBOX_Register(void)
+void COMBOLBOX_RegisterAlias(const WCHAR *name)
 {
     WNDCLASSW wndClass;
 
@@ -3174,6 +3174,11 @@ void COMBOLBOX_Register(void)
     wndClass.cbWndExtra = sizeof(LB_DESCR *);
     wndClass.hCursor = LoadCursorW(0, (LPWSTR)IDC_ARROW);
     wndClass.hbrBackground = NULL;
-    wndClass.lpszClassName = L"ComboLBox";
+    wndClass.lpszClassName = name;
     RegisterClassW(&wndClass);
 }
+
+void COMBOLBOX_Register(void)
+{
+    COMBOLBOX_RegisterAlias(L"ComboLBox");
+}
diff --git a/dlls/user32/win.c b/dlls/user32/win.c
index 5db902d..cdaa264 100644
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -310,6 +310,22 @@ HWND WIN_CreateWindowEx( CREATESTRUCTW *cs, LPCWSTR className, HINSTANCE module,
                 className = L"Win4WineStartButton";
         }
     }
+    /* Likewise the folder window's address bar: XP draws its ComboBox with
+     * the theme, which the user32 ComboBox does not do. */
+    if (!IS_INTRESOURCE(className) && !wcsicmp(className, L"ComboBox") && cs->hwndParent
+        && GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0))
+    {
+        WCHAR parent_class[64];
+        if (GetClassNameW(cs->hwndParent, parent_class, ARRAY_SIZE(parent_class))
+            && !wcsicmp(parent_class, L"ComboBoxEx32"))
+        {
+            HMODULE controls = LoadLibraryW(L"win4wine-controls.dll");
+            BOOL (WINAPI *register_combo)(void) = controls
+                ? (void *)GetProcAddress(controls, "Win4WineRegisterComboBox") : NULL;
+            if (register_combo && register_combo())
+                className = L"Win4WineComboBox";
+        }
+    }
 
     if (!get_class_info( module, className, &info, &class, FALSE )) return FALSE;
 
