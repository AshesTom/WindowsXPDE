From: Codex <codex@localhost>
Subject: [PATCH] combase, explorer, shell32: open folders in Windows 7's explorer

Purpose: let "explorer C:\path", "start C:\path" and other Wine programs
open that folder in Windows 7's explorer, as programs that use Windows 7's
shell32 already do.
Windows behavior: a second explorer.exe asks for the class
{75dff2b7-6936-4c06-a8bb-676a7b00b24b}, whose LocalServer32 is
"%SystemRoot%\explorer.exe /factory,{...}" (REG_EXPAND_SZ); COM expands
it. Folder verbs on Windows 7 run a DelegateExecute object rather than
their command ("%SystemRoot%\Explorer.exe", no file) or their ddeexec.
Wine before: combase ran LocalServer32 unexpanded, which failed; and once
it ran, Wine's explorer.exe (which hands folder windows to the external
shell's explorer) exited at once, so COM gave the server up. Wine's
shell32 ran the folder verb's command without the folder and waited on a
DDE server nobody provides: Libraries opened instead of the folder.
Change: combase expands a REG_EXPAND_SZ LocalServer32. In the external
shell, explorer.exe waits for the shell's explorer when COM started it
(-Embedding), and shell32 gives a DelegateExecute verb's command the file
and skips its ddeexec.
Evidence: "explorer C:\cmp\folder" and "start C:\cmp" open those folders
in the session.
Scope: the expansion applies to all COM local servers (as on Windows);
the rest only to the opted-in external shell.
---
 dlls/combase/rpc.c           | 10 +++++++++-
 dlls/shell32/shlexec.c       | 15 ++++++++++++++-
 programs/explorer/explorer.c |  3 +++
 3 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/dlls/combase/rpc.c b/dlls/combase/rpc.c
index d42de29..bf42005 100644
--- a/dlls/combase/rpc.c
+++ b/dlls/combase/rpc.c
@@ -485,6 +485,7 @@ static HRESULT create_server(REFCLSID rclsid, HANDLE *process)
     DWORD               size = (MAX_PATH+1) * sizeof(WCHAR);
     STARTUPINFOW        sinfo;
     PROCESS_INFORMATION pinfo;
+    DWORD               type;
     LONG ret;
 
     TRACE("Attempting to start server for %s\n", debugstr_guid(rclsid));
@@ -501,13 +502,20 @@ static HRESULT create_server(REFCLSID rclsid, HANDLE *process)
         return hr;
     }
 
-    ret = RegQueryValueExW(key, NULL, NULL, NULL, (LPBYTE)command, &size);
+    ret = RegQueryValueExW(key, NULL, NULL, &type, (LPBYTE)command, &size);
     RegCloseKey(key);
     if (ret)
     {
         WARN("No default value for LocalServer32 key\n");
         return REGDB_E_CLASSNOTREG; /* FIXME: check retval */
     }
+    /* Windows 7's explorer registers %SystemRoot%\explorer.exe /factory,... */
+    if (type == REG_EXPAND_SZ)
+    {
+        WCHAR expanded[MAX_PATH];
+        if (ExpandEnvironmentStringsW(command, expanded, ARRAY_SIZE(expanded)) <= ARRAY_SIZE(expanded))
+            lstrcpyW(command, expanded);
+    }
 
     memset(&sinfo, 0, sizeof(sinfo));
     sinfo.cb = sizeof(sinfo);
diff --git a/dlls/shell32/shlexec.c b/dlls/shell32/shlexec.c
index d2a6d57..e484be8 100644
--- a/dlls/shell32/shlexec.c
+++ b/dlls/shell32/shlexec.c
@@ -41,6 +41,7 @@
 #include "shresdef.h"
 
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(exec);
 
@@ -1057,6 +1058,7 @@ static UINT_PTR execute_from_key(LPCWSTR key, LPCWSTR lpFile, WCHAR *env, LPCWST
     UINT_PTR retval = SE_ERR_NOASSOC;
     DWORD resultLen;
     LPWSTR tmp;
+    BOOL delegate = FALSE;
 
     TRACE("%s %s %s %s %s\n", debugstr_w(key), debugstr_w(lpFile), debugstr_w(env),
            debugstr_w(szCommandline), debugstr_w(executable_name));
@@ -1074,6 +1076,17 @@ static UINT_PTR execute_from_key(LPCWSTR key, LPCWSTR lpFile, WCHAR *env, LPCWST
         if (cmdlen >= ARRAY_SIZE(cmd))
             cmdlen = ARRAY_SIZE(cmd) - 1;
         cmd[cmdlen] = '\0';
+        /* Windows 7's folder verbs run a DelegateExecute object instead of
+         * their command, which names no file, or their ddeexec: in the
+         * external shell, the command gets the file and no DDE is tried. */
+        if (win4wine_external_shell() &&
+            !RegGetValueW(HKEY_CLASSES_ROOT, key, L"DelegateExecute", RRF_RT_REG_SZ, NULL, NULL, NULL))
+        {
+            if (!wcsstr(cmd, L"%1") && !wcsstr(cmd, L"%l") && !wcsstr(cmd, L"%L") &&
+                cmdlen + 5 < ARRAY_SIZE(cmd))
+                lstrcatW(cmd, L" \"%1\"");
+            delegate = TRUE;
+        }
         SHELL_ArgifyW(param, ARRAY_SIZE(parambuffer), cmd, lpFile, psei->lpIDList, szCommandline, &resultLen);
         if (resultLen > ARRAY_SIZE(parambuffer))
         {
@@ -1088,7 +1101,7 @@ static UINT_PTR execute_from_key(LPCWSTR key, LPCWSTR lpFile, WCHAR *env, LPCWST
     assert(tmp);
     lstrcpyW(tmp, L"ddeexec");
 
-    if (RegQueryValueW(HKEY_CLASSES_ROOT, key, ddeexec, &ddeexeclen) == ERROR_SUCCESS)
+    if (!delegate && RegQueryValueW(HKEY_CLASSES_ROOT, key, ddeexec, &ddeexeclen) == ERROR_SUCCESS)
     {
         TRACE("Got ddeexec %s => %s\n", debugstr_w(key), debugstr_w(ddeexec));
         if (!param[0]) lstrcpyW(param, executable_name);
diff --git a/programs/explorer/explorer.c b/programs/explorer/explorer.c
index 89a064b..9396b2a 100644
--- a/programs/explorer/explorer.c
+++ b/programs/explorer/explorer.c
@@ -932,6 +932,9 @@ static BOOL forward_to_folder_shell( const WCHAR *cmdline )
     ret = CreateProcessW( shell, line, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi );
     if (ret)
     {
+        /* COM started this process as a class's local server (Windows 7's
+         * explorer.exe /factory,...): it gives up once the process ends */
+        if (wcsstr( cmdline, L"-Embedding" )) WaitForSingleObject( pi.hProcess, INFINITE );
         CloseHandle( pi.hThread );
         CloseHandle( pi.hProcess );
     }
