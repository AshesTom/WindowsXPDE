From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: send a per-window theme change number from SetWindowTheme

Purpose: let XP's native controls reopen their theme after SetWindowTheme.
XP behavior: comctl32 v6 controls remember the change number in
WM_THEMECHANGED's wParam and reopen their theme only when it differs; -1
marks a per-window change.
Wine before: sent 0, the number the controls start with, so the folder
window's ReBar closed its theme after explorer's SetWindowTheme(rebar,
"ExplorerToolbar") and drew its band labels black on the classic face.
Change: send -1.
Evidence: the ReBar's labels and background match the reference XP machine.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0059.
---
 dlls/uxtheme/system.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
index e959a23..bc1fe5e 100644
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -34,6 +34,7 @@
 #include "msstyles.h"
 
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(uxtheme);
 
@@ -730,7 +731,12 @@ HRESULT WINAPI SetWindowTheme(HWND hwnd, LPCWSTR pszSubAppName,
     if(SUCCEEDED(hr))
         hr = UXTHEME_SetWindowProperty(hwnd, atSubIdList, pszSubIdList);
     if(SUCCEEDED(hr))
-        SendMessageW(hwnd, WM_THEMECHANGED, 0, 0);
+    {
+        /* XP's comctl32 v6 controls keep the change number from wParam and
+         * reopen their theme only when it differs; a per-window change sends -1. */
+        WPARAM change = win4wine_external_shell() ? (WPARAM)-1 : 0;
+        SendMessageW(hwnd, WM_THEMECHANGED, change, 0);
+    }
     return hr;
 }
 
