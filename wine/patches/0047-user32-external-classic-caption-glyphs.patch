From: Codex <codex@localhost>
Subject: [PATCH] user32: size and place classic caption glyphs like XP in the external shell

Purpose: draw the classic minimize, maximize, restore, close and help marks
with XP's size and position.
XP behavior: tests/frame-control.c on the reference machine shows, for 10 to
30 pixel high buttons, a Marlett em of the square's side minus 4 drawn 2
pixels inside it, 3 when pushed; inactive glyphs keep the +1 highlight.
Wine before: used an em of the side minus 2 and centred its text extent, so
on a 16x14 button the maximize box was 10 pixels wide, one pixel left and
touching the minimize button, and the close cross a row taller.
Change: the same as XP.
Evidence: tests/frame-control.c --verify passes on XP and patched Wine; the
classic caption buttons equal the reference screen.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0048.
---
 dlls/user32/uitools.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/dlls/user32/uitools.c b/dlls/user32/uitools.c
index d4b51a9..a219b95 100644
--- a/dlls/user32/uitools.c
+++ b/dlls/user32/uitools.c
@@ -943,6 +943,11 @@ static BOOL UITOOLS95_DrawFrameCaption(HDC dc, LPRECT r, UINT uFlags)
         return FALSE;
     }
     
+    /* XP measurements of public DrawFrameControl output for 10..30px high
+     * buttons: the Marlett em is the square side minus 4, drawn from 2px
+     * inside the square and moved by 1px when pushed. */
+    if (win4wine_external_shell() && SmallDiam > 2)
+        SmallDiam -= 2;
     hf = CreateFontW(-SmallDiam, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
                     SYMBOL_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                     DEFAULT_QUALITY, FIXED_PITCH|FF_DONTCARE, L"Marlett");
@@ -951,6 +956,13 @@ static BOOL UITOOLS95_DrawFrameCaption(HDC dc, LPRECT r, UINT uFlags)
     clrsave = GetTextColor(dc);
     hfsave = SelectObject(dc, hf);
     GetTextExtentPoint32W(dc, str, 1, &size);
+    if (win4wine_external_shell())
+    {
+        int offset = uFlags & DFCS_PUSHED ? 3 : 2;
+        size.cx = size.cy = 0;
+        xc = myr.left + offset;
+        yc = myr.top + offset;
+    }
 
     if(uFlags & DFCS_INACTIVE)
     {
