From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: DrawThemeTextEx's DTT_CALLBACK and DTT_COMPOSITED

Purpose: show the prompt of the Windows 7 Start menu's search box.
Windows behavior: with DTT_CALLBACK, DrawThemeTextEx calls the caller's
pfnDrawTextCallback (with lParam) instead of DrawText; with
DTT_COMPOSITED, the text is drawn opaque on a surface with alpha, such
as a buffered paint's. Windows 7's DirectUI draws the search box's
"Search programs and files" prompt with both, and an empty string.
Wine before: both flags were ignored, so the prompt was never drawn;
also the external shell's text shadow read options when it was NULL.
Change: call the callback; with DTT_COMPOSITED on a 32-bit DIB, make
the pixels the text changed opaque; check options for NULL.
Evidence: the Start menu shows the prompt as on Windows 7.
Scope: callers that pass these flags.
---
 dlls/uxtheme/draw.c | 68 ++++++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 65 insertions(+), 3 deletions(-)

diff --git a/dlls/uxtheme/draw.c b/dlls/uxtheme/draw.c
index e87bfcf..30d39ba 100644
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -2080,6 +2080,65 @@ static void draw_continuous_shadow(HDC hdc, LPCWSTR text, int count, DWORD flags
     if (shadow_dc) DeleteDC(shadow_dc);
 }
 
+/* DTT_COMPOSITED: text on a surface with alpha (a buffered paint's), which
+ * GDI's text leaves transparent: the pixels the text changed become opaque.
+ * DTT_CALLBACK: the caller's callback draws instead of DrawText (Windows 7's
+ * DirectUI draws the Start menu's search prompt so). */
+static void draw_text_or_callback(HDC hdc, const WCHAR *text, int count, DWORD flags, RECT *rect,
+                                  const DTTOPTS *options)
+{
+    if (options && (options->dwFlags & DTT_CALLBACK) && options->pfnDrawTextCallback)
+        options->pfnDrawTextCallback(hdc, (WCHAR *)text, count, rect, flags, options->lParam);
+    else
+        DrawTextW(hdc, text, count, rect, flags);
+}
+
+static DWORD *dib_row(const DIBSECTION *dib, int y)
+{
+    int row = dib->dsBmih.biHeight > 0 ? dib->dsBm.bmHeight - 1 - y : y;
+    return (DWORD *)((BYTE *)dib->dsBm.bmBits + row * dib->dsBm.bmWidthBytes);
+}
+
+static void draw_composited_text(HDC hdc, const WCHAR *text, int count, DWORD flags, RECT *rect,
+                                 const DTTOPTS *options)
+{
+    DIBSECTION dib;
+    RECT area = *rect;
+    DWORD *before;
+    int x, y, width, height;
+
+    if (GetObjectW(GetCurrentObject(hdc, OBJ_BITMAP), sizeof(dib), &dib) != sizeof(dib) ||
+        dib.dsBm.bmBitsPixel != 32 || !dib.dsBm.bmBits)
+    {
+        draw_text_or_callback(hdc, text, count, flags, rect, options);
+        return;
+    }
+    LPtoDP(hdc, (POINT *)&area, 2);
+    area.left = max(area.left, 0);
+    area.top = max(area.top, 0);
+    area.right = min(area.right, dib.dsBm.bmWidth);
+    area.bottom = min(area.bottom, dib.dsBm.bmHeight);
+    width = area.right - area.left;
+    height = area.bottom - area.top;
+    if (width <= 0 || height <= 0 || !(before = malloc(width * height * sizeof(DWORD))))
+    {
+        draw_text_or_callback(hdc, text, count, flags, rect, options);
+        return;
+    }
+    GdiFlush();
+    for (y = 0; y < height; y++)
+        memcpy(before + y * width, dib_row(&dib, area.top + y) + area.left, width * sizeof(DWORD));
+    draw_text_or_callback(hdc, text, count, flags, rect, options);
+    GdiFlush();
+    for (y = 0; y < height; y++)
+    {
+        DWORD *row = dib_row(&dib, area.top + y) + area.left;
+        for (x = 0; x < width; x++)
+            if ((row[x] & 0xffffff) != (before[y * width + x] & 0xffffff)) row[x] |= 0xff000000;
+    }
+    free(before);
+}
+
 /***********************************************************************
  *      DrawThemeTextEx                                     (UXTHEME.@)
  */
@@ -2102,7 +2161,7 @@ HRESULT WINAPI DrawThemeTextEx(HTHEME hTheme, HDC hdc, int iPartId, int iStateId
         return E_HANDLE;
 
     if(options) {
-        if(options->dwFlags & ~(DTT_TEXTCOLOR | DTT_FONTPROP))
+        if(options->dwFlags & ~(DTT_TEXTCOLOR | DTT_FONTPROP | DTT_CALLBACK | DTT_COMPOSITED))
             FIXME("unsupported flags 0x%08lx\n", options->dwFlags);
         if(options->dwFlags & DTT_FONTPROP)
             fontProp = options->iFontPropId;
@@ -2129,7 +2188,7 @@ HRESULT WINAPI DrawThemeTextEx(HTHEME hTheme, HDC hdc, int iPartId, int iStateId
     oldBkMode = SetBkMode(hdc, TRANSPARENT);
     if (win4wine_external_shell() &&
         !(flags & (DT_CALCRECT | DT_MODIFYSTRING)) &&
-        !(options->dwFlags & ~(DTT_TEXTCOLOR | DTT_FONTPROP)))
+        !(options && (options->dwFlags & ~(DTT_TEXTCOLOR | DTT_FONTPROP))))
     {
         int shadow_type;
         POINT offset;
@@ -2152,7 +2211,10 @@ HRESULT WINAPI DrawThemeTextEx(HTHEME hTheme, HDC hdc, int iPartId, int iStateId
                  SUCCEEDED(GetThemeColor(hTheme, iPartId, iStateId, TMT_TEXTSHADOWCOLOR, &shadow_color)))
             draw_continuous_shadow(hdc, pszText, iCharCount, flags, rect, offset, shadow_color);
     }
-    DrawTextW(hdc, pszText, iCharCount, rect, flags);
+    if (options && (options->dwFlags & DTT_COMPOSITED) && !(flags & DT_CALCRECT))
+        draw_composited_text(hdc, pszText, iCharCount, flags, rect, options);
+    else
+        draw_text_or_callback(hdc, pszText, iCharCount, flags, rect, options);
     SetBkMode(hdc, oldBkMode);
     SetTextColor(hdc, oldTextColor);
 
