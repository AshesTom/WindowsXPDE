From: Codex <codex@localhost>
Subject: [PATCH] explorer: leave the shell window and endpoints to an external shell

Purpose: let the native XP explorer be the shell while Wine's desktop
manager keeps the display and clipboard.
XP behavior: explorer checks for an existing shell window and exits
without creating Progman if one exists; it supplies its own Shell_TrayWnd,
folder DDE server and ShellWindows class factory.
Wine before: the builtin desktop manager registered its desktop as the
shell window, created a second hidden Shell_TrayWnd and started the DDE and
ShellWindows endpoints, so the native explorer exited and folder and
application commands went to the wrong owner.
Change: with the opt-in, do not call SetShellWindow and do not create the
taskbar, DDE server or ShellWindows factory.
Evidence: WINEDEBUG=+relay logs and window enumeration; no disassembly.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0003, 0009.
---
 programs/explorer/desktop.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/programs/explorer/desktop.c b/programs/explorer/desktop.c
index ce70c5d..e92187e 100644
--- a/programs/explorer/desktop.c
+++ b/programs/explorer/desktop.c
@@ -34,6 +34,7 @@
 #include "wine/debug.h"
 #include "explorer_private.h"
 #include "resource.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(explorer);
 
@@ -1176,6 +1177,9 @@ static void set_shell_window( HWND hwnd )
     HDESK desk;
     WCHAR desk_name[MAX_PATH];
 
+    /* Keep desktop management alive while a native shell owns the shell HWND. */
+    if (win4wine_external_shell()) return;
+
     if (!(winsta = GetProcessWindowStation()) ||
         !GetUserObjectInformationW( winsta, UOI_FLAGS, &flags, sizeof(flags), NULL ) ||
         !(flags.dwFlags & WSF_VISIBLE))
@@ -1290,10 +1294,12 @@ void manage_desktop( WCHAR *arg )
         initialize_display_settings( width, height );
         initialize_appbar();
 
-        initialize_systray( using_root, enable_shell, show_systray, no_tray_items );
+        if (!win4wine_external_shell())
+            initialize_systray( using_root, enable_shell, show_systray, no_tray_items );
         if (!using_root && enable_launchers) initialize_launchers( hwnd );
 
-        if ((shell32 = LoadLibraryW( L"shell32.dll" )) &&
+        if (!win4wine_external_shell()
+            && (shell32 = LoadLibraryW( L"shell32.dll" )) &&
             (pShellDDEInit = (void *)GetProcAddress( shell32, (LPCSTR)188)))
         {
             pShellDDEInit( TRUE );
@@ -1316,8 +1322,11 @@ void manage_desktop( WCHAR *arg )
         }
     }
 
-    desktopshellbrowserwindow_init();
-    shellwindows_init();
+    if (!win4wine_external_shell())
+    {
+        desktopshellbrowserwindow_init();
+        shellwindows_init();
+    }
 
     /* Ideally we would set the window of an IShellView here, but we never
        actually create one, so the desktop window itself will have to do. */
