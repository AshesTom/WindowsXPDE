From: Codex <codex@localhost>
Subject: [PATCH] explorer: hand folder windows to the external shell's explorer

Purpose: open folders in the ReactOS shell's own explorer.
ReactOS behavior: its shell opens Control Panel, Search, Win+E and
shortcut targets by running explorer.exe (shell32's CStartMenu,
shlexec.cpp and CShellLink.cpp, explorer's traywnd.cpp); the shell
process then shows the folder window.
Wine before: explorer.exe is Wine's desktop manager in the external
shell's prefix, so these commands opened Wine's own folder browser.
Change: with the opt-in and WIN4WINE_FOLDER_SHELL naming an executable,
explorer.exe started without /desktop runs that executable with the
same command line and exits. The desktop manager is unchanged, and the
XP shell's session does not set the variable.
Evidence: ReactOS 0.4.16 sources; session screenshots of the Start
menu's Control Panel and Search.
Scope: only with WIN4WINE_EXTERNAL_SHELL and WIN4WINE_FOLDER_SHELL.
---
 programs/explorer/explorer.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/programs/explorer/explorer.c b/programs/explorer/explorer.c
index 1854144..89a064b 100644
--- a/programs/explorer/explorer.c
+++ b/programs/explorer/explorer.c
@@ -25,6 +25,7 @@
 #include "wine/debug.h"
 #include "explorer_private.h"
 #include "resource.h"
+#include "wine/win4wine.h"
 
 #include <initguid.h>
 #include <windows.h>
@@ -911,6 +912,34 @@ static void parse_command_line(LPWSTR commandline,parameters_struct *parameters)
     }
 }
 
+/* With the external shell opt-in, WIN4WINE_FOLDER_SHELL names the external
+ * shell's own explorer: folder windows that programs open by running
+ * explorer.exe go to it, while this explorer stays the desktop manager. */
+static BOOL forward_to_folder_shell( const WCHAR *cmdline )
+{
+    STARTUPINFOW si = { .cb = sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR shell[MAX_PATH], *line;
+    DWORD len, size;
+    BOOL ret;
+
+    if (!win4wine_external_shell()) return FALSE;
+    len = GetEnvironmentVariableW( L"WIN4WINE_FOLDER_SHELL", shell, ARRAY_SIZE(shell) );
+    if (!len || len >= ARRAY_SIZE(shell)) return FALSE;
+    size = len + wcslen( cmdline ) + 4;
+    if (!(line = malloc( size * sizeof(WCHAR) ))) return FALSE;
+    swprintf( line, size, L"\"%s\" %s", shell, cmdline );
+    ret = CreateProcessW( shell, line, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi );
+    if (ret)
+    {
+        CloseHandle( pi.hThread );
+        CloseHandle( pi.hProcess );
+    }
+    else WARN( "could not start %s: %lu\n", debugstr_w(shell), GetLastError() );
+    free( line );
+    return ret;
+}
+
 int WINAPI wWinMain(HINSTANCE hinstance,
                     HINSTANCE previnstance,
                     LPWSTR cmdline,
@@ -924,6 +953,7 @@ int WINAPI wWinMain(HINSTANCE hinstance,
     memset(&parameters,0,sizeof(parameters));
     explorer_hInstance = hinstance;
     parse_command_line(cmdline,&parameters);
+    if (forward_to_folder_shell( cmdline )) return 0;
     hres = OleInitialize(NULL);
     if(FAILED(hres))
     {
