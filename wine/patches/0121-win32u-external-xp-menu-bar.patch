From: Codex <codex@localhost>
Subject: [PATCH] win32u: XP's menu bar layout, and a disabled window's grayed

Purpose: draw menu bars in the XP shell session as XP does.
Windows behavior: XP's menu bar items fill the bar from its top, 19
pixels at 96 dpi, and its last row is the menu colour (white with Luna);
the text sits a pixel higher than with a top border. A disabled window's
menu bar, such as a message box's owner's, is drawn grayed (xpcmp.exe on
the reference XP machine).
Wine before: a one pixel border at the top, the bottom row in the bar's
colour, and a disabled window's menu bar drawn as usual.
Change: in the XP shell session (flat or classic menus, not a version 4
style), the border row goes at the bottom in COLOR_MENU, and a disabled
window's menu bar items are drawn as grayed.
Evidence: xpcmp.exe's menu bar is pixel-identical to XP's, also with a
message box open.
Scope: the XP shell session (WIN4WINE_EXTERNAL_SHELL, no WIN4WINE_SHELL).
---
 dlls/win32u/menu.c | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
index d71fdb9..81167d4 100644
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -2047,6 +2047,15 @@ static BOOL themed_menus(void)
     return menu_theme_active;
 }
 
+/* XP's menu bar (the XP shell: no WIN4WINE_SHELL): the items fill the bar
+ * from its top, and its last row is the menu colour (white in Luna); text
+ * one pixel higher than with the border at the top. Measured with xpcmp.exe
+ * on the reference XP machine. */
+static BOOL xp_menu_bar(void)
+{
+    return win4wine_shell() == WIN4WINE_SHELL_XP && !themed_menus();
+}
+
 static void draw_menu_part( HWND hwnd, HDC hdc, int part, int state, const RECT *rect )
 {
     struct menu_theme_params params = { MENU_THEME_DRAW, hwnd, hdc, part, state, *rect };
@@ -2369,7 +2378,7 @@ static void calc_menu_bar_size( HDC hdc, RECT *rect, struct menu *menu, HWND own
        This corresponds to the difference between SM_CYMENU and SM_CYMENUSIZE.
        Themed menu bars have it at the bottom instead (see themed_menus). */
     update_menu_theme();
-    SetRect( &menu->items_rect, 0, 0, rect->right - rect->left, themed_menus() ? 0 : 1 );
+    SetRect( &menu->items_rect, 0, 0, rect->right - rect->left, themed_menus() || xp_menu_bar() ? 0 : 1 );
     start = 0;
     help_pos = ~0u;
     menu->textOffset = 0;
@@ -2404,7 +2413,7 @@ static void calc_menu_bar_size( HDC hdc, RECT *rect, struct menu *menu, HWND own
     OffsetRect( &menu->items_rect, rect->left, rect->top );
     menu->Width = menu->items_rect.right - menu->items_rect.left;
     menu->Height = menu->items_rect.bottom - menu->items_rect.top;
-    if (themed_menus()) menu->Height++;
+    if (themed_menus() || xp_menu_bar()) menu->Height++;
     rect->bottom = menu->items_rect.top + menu->Height;
 
     /* Flush right all items between the MF_RIGHTJUSTIFY and */
@@ -2761,6 +2770,7 @@ static void draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc,
     UINT arrow_width = 0, arrow_height = 0;
     HRGN old_clip = NULL, clip;
     BOOL flat_menu = FALSE;
+    struct menu_item disabled;
     RECT rect, bmprc;
     int bkgnd;
 
@@ -2781,6 +2791,15 @@ static void draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc,
         return;
     }
 
+    /* XP grays a disabled window's menu bar, such as the owner of a message
+     * box (xpcmp.exe on the reference XP machine) */
+    if (menu_bar && xp_menu_bar() && !(item->fState & MF_GRAYED) && !is_window_enabled( hwnd ))
+    {
+        disabled = *item;
+        disabled.fState |= MF_GRAYED;
+        item = &disabled;
+    }
+
     TRACE( "rect=%s\n", wine_dbgstr_rect( &item->rect ));
     rect = item->rect;
     adjust_menu_item_rect( menu, &rect );
@@ -3148,6 +3167,11 @@ DWORD WINAPI NtUserDrawMenuBarTemp( HWND hwnd, HDC hdc, RECT *rect, HMENU handle
         draw_menu_part( hwnd, hdc, MENU_BARBACKGROUND,
                         (win_get_flags( hwnd ) & WIN_NCACTIVATED) ? MB_ACTIVE : MB_INACTIVE, &menu->items_rect );
 
+    if (xp_menu_bar())
+    {
+        RECT line = { rect->left, rect->bottom - 1, rect->right, rect->bottom };
+        fill_rect( hdc, &line, get_sys_color_brush( COLOR_MENU ));
+    }
     NtGdiSelectPen( hdc, get_sys_color_pen( COLOR_3DFACE ));
     NtGdiMoveTo( hdc, rect->left, rect->bottom, NULL );
     NtGdiLineTo( hdc, rect->right, rect->bottom );
