From: Codex <codex@localhost>
Subject: [PATCH] win32u: map TransparentBlt's stretch like XP in the external shell

Purpose: give stretched colour-keyed blits XP's pixels.
XP behavior: TransparentBlt takes for each destination pixel the source
pixel floor((2 * d + 1) * src / (2 * dst)) in both directions, for every
size from 2 to 9 stretched into 1 to 12.
Wine before: went through StretchBlt, which differs at exact boundaries
(2 into 3 gave 0 0 1 instead of 0 1 1).
Change: copy whole source columns and rows with that rule. Empty rectangles
keep the generic path, which succeeds without copying: explorer stops
painting the Start panel when an empty nine-grid band fails.
Evidence: tests/stretch-map.c --verify checks all 96 cases.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0064.
---
 dlls/win32u/bitblt.c | 54 ++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/bitblt.c b/dlls/win32u/bitblt.c
index 95e6246..c495f39 100644
--- a/dlls/win32u/bitblt.c
+++ b/dlls/win32u/bitblt.c
@@ -842,6 +842,44 @@ BOOL WINAPI NtGdiMaskBlt( HDC hdcDest, INT nXDest, INT nYDest, INT nWidth, INT n
     return TRUE;
 }
 
+/* XP's TransparentBlt takes for each destination pixel the source pixel
+ * under its centre, floor((2 * d + 1) * src / (2 * dst)), measured on the
+ * reference XP machine for every size from 2 to 9 into 1 to 12. Copy whole
+ * columns and then whole rows, merging consecutive source pixels. */
+static BOOL transparent_stretch_xp( HDC work, int width, int height, HDC src, int x, int y,
+                                    int src_width, int src_height )
+{
+    HDC columns = NtGdiCreateCompatibleDC( work );
+    HBITMAP bitmap = NtGdiCreateCompatibleBitmap( work, width, src_height );
+    HGDIOBJ old;
+    BOOL ret = columns && bitmap;
+    int i, start;
+
+    if (!ret) goto done;
+    old = NtGdiSelectBitmap( columns, bitmap );
+    for (i = start = 0; ret && i < width; i++)
+    {
+        int first = (int)((2LL * start + 1) * src_width / (2LL * width));
+        if (i + 1 < width && (int)((2LL * (i + 1) + 1) * src_width / (2LL * width)) == first + i + 1 - start)
+            continue;
+        ret = NtGdiBitBlt( columns, start, 0, i + 1 - start, src_height, src, x + first, y, SRCCOPY, 0, 0 );
+        start = i + 1;
+    }
+    for (i = start = 0; ret && i < height; i++)
+    {
+        int first = (int)((2LL * start + 1) * src_height / (2LL * height));
+        if (i + 1 < height && (int)((2LL * (i + 1) + 1) * src_height / (2LL * height)) == first + i + 1 - start)
+            continue;
+        ret = NtGdiBitBlt( work, 0, start, width, i + 1 - start, columns, 0, first, SRCCOPY, 0, 0 );
+        start = i + 1;
+    }
+    NtGdiSelectBitmap( columns, old );
+done:
+    if (bitmap) NtGdiDeleteObjectApp( bitmap );
+    if (columns) NtGdiDeleteObjectApp( columns );
+    return ret;
+}
+
 /******************************************************************************
  *           NtGdiTransparentBlt    (win32u.@)
  */
@@ -900,8 +938,20 @@ BOOL WINAPI NtGdiTransparentBlt( HDC hdcDest, int xDest, int yDest, int widthDes
     dc_work->attr->stretch_blt_mode = COLORONCOLOR;
     release_dc_ptr( dc_work );
 
-    if (!NtGdiStretchBlt( hdcWork, 0, 0, widthDest, heightDest, hdcSrc, xSrc, ySrc,
-                          widthSrc, heightSrc, SRCCOPY, 0 ))
+    /* Empty rectangles take the generic path, which succeeds without copying;
+     * XP's explorer stops painting the Start panel when the empty bands of its
+     * nine-grid images fail. */
+    if (win4wine_external_shell() && widthDest && heightDest && widthSrc && heightSrc &&
+        (widthDest != widthSrc || heightDest != heightSrc))
+    {
+        if (!transparent_stretch_xp( hdcWork, widthDest, heightDest, hdcSrc, xSrc, ySrc, widthSrc, heightSrc ))
+        {
+            TRACE("Failed to stretch\n");
+            goto error;
+        }
+    }
+    else if (!NtGdiStretchBlt( hdcWork, 0, 0, widthDest, heightDest, hdcSrc, xSrc, ySrc,
+                               widthSrc, heightSrc, SRCCOPY, 0 ))
     {
         TRACE("Failed to stretch\n");
         goto error;
