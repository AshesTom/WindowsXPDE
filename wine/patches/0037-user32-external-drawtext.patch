From: Codex <codex@localhost>
Subject: [PATCH] user32: centre, break and underline DrawText like XP in the external shell

Purpose: place single-line text, wrap Japanese text and draw access key
underlines where XP does.
XP behavior: DT_VCENTER halves the remaining height once (tests/text-vcenter.c).
With the Japanese ANSI code page, DT_WORDBREAK breaks before or after a
double-byte character, and between single-byte ones at spaces and after
!%),.:;?]}; when the next line would start with one of XP's line-start
characters (、。」） and so on) the break moves back one character, except
when the moved character is one too and follows a double-byte character
that is not (tests/text-wrap.c). The access key underline spans the
underlined character's whole advance, from the extent before it to one
pixel before the extent through it, clipped at the rectangle's right edge
(tests/text-underline.c). A lone & at the end of the text is not drawn,
and with DT_EXPANDTABS the underline after a tab is under the character
that follows the &.
Wine before: rounded the vertical offset twice, and broke lines only at
spaces and where ScriptBreak marked the overflowing character, so Japanese
text without spaces ran past the right edge: the Run dialog's prompt lost
"ット" of "インターネット". Its underline stopped one pixel short, so every
menu's access key underline was 1px shorter than XP's. It drew a final
& as text, and after a tab it did not count the tab in the underline's
position, so the underline went under the next character or was lost.
Change: the same as XP; Japanese breaking only with code page 932.
Evidence: tests/text-wrap.c gives XP's wrap positions for four strings at
28 widths, and its character, triple and pair tests equal XP's.
tests/text-underline.c gives XP's underline for ten strings in five fonts
and five clipped or aligned cases, and four lone-& and five tab cases;
Wine now gives the same ends, apart from the cases whose fonts' advances
differ.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0031, 0066.
---
 dlls/user32/text.c | 69 ++++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 67 insertions(+), 2 deletions(-)

diff --git a/dlls/user32/text.c b/dlls/user32/text.c
index b757109..8b18023 100644
--- a/dlls/user32/text.c
+++ b/dlls/user32/text.c
@@ -37,6 +37,7 @@
 #include "usp10.h"
 #include "user_private.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(text);
 
@@ -347,6 +348,48 @@ static void TEXT_PathEllipsify (HDC hdc, WCHAR *str, unsigned int max_len,
  *     DT_PATH_ELLIPSIS is
  */
 
+/* Japanese XP breaks a line before or after any double-byte character and
+ * between single-byte ones at spaces and after closing punctuation. When the next line would start
+ * with one of these characters it moves the break back by one character,
+ * except when that character cannot start a line either and follows a
+ * double-byte one that can; no character is kept from ending a line.
+ * Measured on the reference XP machine with tests/text-wrap.c. */
+static const WCHAR xp_no_line_start[] =
+    L"\x3001\x3002\xff0c\xff0e\xff1a\xff1b\xff1f\xff01\x309b\x309c\x3005\x2015\xff5e\x2026\x2025"
+    L"\x2019\x201d\xff09\x3015\xff3d\xff5d\x3009\x300b\x300d\x300f\x3011\x2018\xff61\xff63\xff64"
+    L"\xff9e\xff9f!%),.:;?]}\xffe5\x2032\x2033\x2103\xff05\x00b0>";
+
+static BOOL xp_double_byte( WCHAR c )
+{
+    char bytes[2];
+    BOOL used_default = FALSE;
+    return WideCharToMultiByte( 932, 0, &c, 1, bytes, sizeof(bytes), NULL, &used_default ) == 2 && !used_default;
+}
+
+static BOOL xp_japanese_break( WCHAR *str, unsigned int *len_str, unsigned int chars_fit,
+                               unsigned int *chars_used )
+{
+    unsigned int b = chars_fit;
+
+    if (!chars_fit || GetACP() != 932 || !win4wine_external_shell())
+        return FALSE;
+    while (b > 0 && str[b] != SPACE && str[b - 1] != SPACE && !xp_double_byte( str[b - 1] ) &&
+           !xp_double_byte( str[b] ) && !wcschr( L"!%),.:;?]}", str[b - 1] ))
+        b--;
+    if (!b) return FALSE;
+    if (b > 1 && wcschr( xp_no_line_start, str[b] ))
+    {
+        if (!wcschr( xp_no_line_start, str[b - 1] ) || b < 2 || wcschr( xp_no_line_start, str[b - 2] ) ||
+            !xp_double_byte( str[b - 2] ))
+            b--;
+    }
+    *chars_used = b;
+    if (str[b] == SPACE) (*chars_used)++;
+    else if (str[b - 1] == SPACE) b--;
+    *len_str = b;
+    return TRUE;
+}
+
 static void TEXT_WordBreak (HDC hdc, WCHAR *str, unsigned int max_str,
                             unsigned int *len_str,
                             int width, int format, unsigned int chars_fit,
@@ -361,6 +404,12 @@ static void TEXT_WordBreak (HDC hdc, WCHAR *str, unsigned int max_str,
     assert (format & DT_WORDBREAK);
     assert (chars_fit < *len_str);
 
+    if (xp_japanese_break( str, len_str, chars_fit, chars_used ))
+    {
+        GetTextExtentExPointW( hdc, str, *len_str, 0, NULL, NULL, size );
+        return;
+    }
+
     sla = malloc(sizeof(SCRIPT_LOGATTR) * *len_str);
 
     memset(&sa, 0, sizeof(SCRIPT_ANALYSIS));
@@ -646,6 +695,12 @@ static const WCHAR *TEXT_NextLineW( HDC hdc, const WCHAR *str, int *count,
                (str[i] != TAB || !(format & DT_EXPANDTABS)) &&
                ((str[i] != CR && str[i] != LF) || (format & DT_SINGLELINE)))
         {
+            /* XP drops a lone prefix at the end of the text (tests/text-underline.c). */
+            if (!(format & DT_NOPREFIX) && *count == 1 && str[i] == PREFIX && win4wine_external_shell())
+            {
+                (*count)--, i++;
+                continue;
+            }
             if ((format & DT_NOPREFIX) || *count <= 1)
             {
                 (*count)--; if (j < maxl) dest[j++] = str[i++]; else i++;
@@ -832,6 +887,8 @@ static void TEXT_DrawUnderscore (HDC hdc, int x, int y, const WCHAR *str, int of
     prefix_x = x + size.cx;
     GetTextExtentPointW (hdc, str, offset+1, &size);
     prefix_end = x + size.cx - 1;
+    /* XP's underline covers the character's whole advance (tests/text-underline.c). */
+    if (win4wine_external_shell()) prefix_end++;
     /* The above method may eventually be slightly wrong due to kerning etc. */
 
     /* Check for clipping */
@@ -990,8 +1047,13 @@ INT WINAPI DrawTextExW( HDC hdc, LPWSTR str, INT i_count,
 
 	if (flags & DT_SINGLELINE)
 	{
-	    if (flags & DT_VCENTER) y = rect->top +
-	    	(rect->bottom - rect->top) / 2 - size.cy / 2;
+	    if (flags & DT_VCENTER)
+            {
+                if (win4wine_external_shell())
+                    y = rect->top + (rect->bottom - rect->top - size.cy) / 2;
+                else
+                    y = rect->top + (rect->bottom - rect->top) / 2 - size.cy / 2;
+            }
 	    else if (flags & DT_BOTTOM) y = rect->bottom - size.cy;
         }
 
@@ -1041,6 +1103,9 @@ INT WINAPI DrawTextExW( HDC hdc, LPWSTR str, INT i_count,
                              */
                             prefix_offset = -1;
                         }
+                        /* The tab is not drawn but is in the line too. */
+                        else if (win4wine_external_shell())
+                            prefix_offset -= len_seg + 1;
                         else
                             prefix_offset -= len_seg;
                     }
