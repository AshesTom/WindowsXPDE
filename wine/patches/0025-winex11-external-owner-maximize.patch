From: Codex <codex@localhost>
Subject: [PATCH] winex11: let the external shell's window owner compute maximized geometry

Purpose: maximize windows to the rectangle that the window and
WM_GETMINMAXINFO choose.
Wine before: a managed window's maximized size came from the WM; the
companion WM acknowledges EWMH maximize state but leaves the rectangle to
the owner, and asynchronous WM resizes could spoil a rapidly restored
normal rectangle.
Change: accept the owner's position and size for maximized windows.
Minimizing keeps the existing policy.
Evidence: tests/wine-maximize.c, including a custom WM_GETMINMAXINFO limit.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0041.
---
 dlls/winex11.drv/window.c | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 19dc408..cfe7e21 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -54,6 +54,7 @@
 #include "wine/debug.h"
 #include "wine/server.h"
 #include "mwm.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(x11drv);
 WINE_DECLARE_DEBUG_CHANNEL(systray);
@@ -1305,10 +1306,11 @@ static void window_set_config( struct x11drv_win_data *data, const RECT *new_rec
         return;
     }
 
-    /* resizing a managed maximized window is not allowed */
+    /* The companion WM delegates maximized geometry to the Wine owner thread.
+     * Other WMs retain the usual managed-window resize policy. */
     if ((old_rect->right - old_rect->left != new_rect->right - new_rect->left ||
          old_rect->bottom - old_rect->top != new_rect->bottom - new_rect->top) &&
-        (!(style & WS_MAXIMIZE) || !data->managed))
+        (!(style & WS_MAXIMIZE) || !data->managed || win4wine_external_shell()))
     {
         changes.width = new_rect->right - new_rect->left;
         changes.height = new_rect->bottom - new_rect->top;
@@ -2997,8 +2999,11 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
         }
     }
 
-    /* don't change position if we are about to minimize or maximize a managed window */
-    if (!(data->managed && (swp_flags & SWP_STATECHANGED) && (new_style & (WS_MINIMIZE|WS_MAXIMIZE))))
+    /* Minimize remains WM-managed. The external shell allows the owner thread's
+     * maximized position/size, including application WM_GETMINMAXINFO limits. */
+    if (!(data->managed && (swp_flags & SWP_STATECHANGED) &&
+          ((new_style & WS_MINIMIZE) ||
+           ((new_style & WS_MAXIMIZE) && !win4wine_external_shell()))))
     {
         sync_window_position( data, swp_flags, &old_rects );
 #ifdef HAVE_LIBXSHAPE
