From: Codex <codex@localhost>
Subject: [PATCH] win32u: open the external shell's task list for Ctrl+Esc and the Windows key

Purpose: open the XP Start menu with the Windows key and Ctrl+Esc.
XP behavior: Ctrl+Esc, and the Windows key pressed and released with no
other key, select the task list: the window that XP Explorer registered
with RegisterShellHookWindow (its task switcher) gets HSHELL_TASKMAN and
opens the Start menu. Hotkeys with the Windows key (Win+R, Win+E) do not.
Wine before: neither key did anything; the Windows key reached the
application, and Ctrl+Esc too.
Change: when a key message is removed from the queue, a Windows key
release after its press with no other key message in between, and with
no other key still down, and a Ctrl+Esc press (without Shift or Alt; the
press is not delivered) post HSHELL_TASKMAN to the windows with the
Win4WineShellHook property (0026), after handing the foreground to the
first one's top-level window: this process has the input, and XP's own
SetForegroundWindow for the Start menu is refused otherwise. A Windows key
press counts as new unless one came within the last second, because a
press that a window manager replays after its grab arrives with the key
already down in Wine's key state. Whether the Windows key was alone is
told by the desktop's key toggles, which the server flips at each press
as it gets it, a hotkey's press too: kept at a new Windows key press, a
key whose toggle changed by the release means it was not alone. (Win+R's
release of R goes to the thread with the keyboard, which may already be
the Run dialog's own and take it after the desktop's thread took the
Windows key's release; counting key messages in this process then posted
the task list and left the dialog inactive, about one time in two.)
Evidence: the XP Explorer receives HSHELL_TASKMAN and opens the Start menu
(public API call log with +relay, SendMessage of the SHELLHOOK message from
a probe); in the test VM the Windows key, Ctrl+Esc, Win+R and Win+E were
tried six times each from a Wine window and from a native one (bridge-wm
passes those keys through the proxy with SendInput); Win+R from the
desktop gave an active Run dialog 8 times in 8.
Scope: only with WIN4WINE_EXTERNAL_SHELL, in the process that gets the key.
---
 dlls/win32u/message.c | 119 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 119 insertions(+)

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 4cc7dd2..53a9794 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2474,6 +2474,119 @@ static BOOL process_pointer_message( MSG *msg, UINT hw_id, const struct hardware
     return TRUE;
 }
 
+/* XP opens the task list, its Start menu, for Ctrl+Esc and for a Windows key
+ * pressed and released alone: windows registered with RegisterShellHookWindow
+ * (the Win4WineShellHook property) get HSHELL_TASKMAN. A hotkey such as Win+R
+ * takes the other key's press away in the server, but its release still
+ * comes here, and a key still held is in the desktop's key state. */
+static BOOL win_key_down, win_key_alone;
+static DWORD win_key_time;
+/* The desktop's key toggles when the Windows key went down: a press flips a
+ * key's toggle when the server gets it, also for a hotkey's press, while the
+ * key messages may reach other threads of the process later than the
+ * Windows key's release (XP's Run dialog opening for Win+R). */
+static BYTE win_key_toggles[256];
+
+/* The windows with the shell hook property under PARENT, at most COUNT. */
+static unsigned int find_shell_hooks( HWND parent, HWND *found, unsigned int count )
+{
+    static const WCHAR propW[] = {'W','i','n','4','W','i','n','e','S','h','e','l','l','H','o','o','k',0};
+    unsigned int i, n = 0;
+    HWND *list;
+
+    if (!(list = list_window_children( parent ))) return 0;
+    for (i = 0; list[i] && n < count; i++)
+    {
+        if (NtUserGetProp( list[i], propW )) found[n++] = list[i];
+        /* XP registers its task switcher, a child of the taskbar. */
+        n += find_shell_hooks( list[i], found + n, count - n );
+    }
+    free( list );
+    return n;
+}
+
+static void post_task_list(void)
+{
+    static const WCHAR shellhookW[] = {'S','H','E','L','L','H','O','O','K',0};
+    UNICODE_STRING name = RTL_CONSTANT_STRING( shellhookW );
+    UINT message = NtUserRegisterWindowMessage( &name );
+    HWND hooks[8];
+    unsigned int i, count;
+
+    if (!message || !(count = find_shell_hooks( get_desktop_window(), hooks, ARRAY_SIZE(hooks) ))) return;
+    /* Windows lets the shell take the foreground for these keys. This process
+     * has the input, so it may hand the foreground over; the shell's own
+     * SetForegroundWindow for its Start menu would be refused otherwise. */
+    i = NtUserSetForegroundWindow( NtUserGetAncestor( hooks[0], GA_ROOT ));
+    TRACE_(key)( "task list for %u shell hook windows, foreground %u\n", count, i );
+    for (i = 0; i < count; i++) NtUserPostMessage( hooks[i], message, HSHELL_TASKMAN, 0 );
+}
+
+static void save_key_toggles(void)
+{
+    BYTE state[256];
+    unsigned int key;
+
+    if (!get_async_keyboard_state( state )) memset( state, 0, sizeof(state) );
+    for (key = 0; key < 256; key++) win_key_toggles[key] = state[key] & 0x01;
+}
+
+/* Whether another key is down, or was pressed since the Windows key went down. */
+static BOOL other_key_used(void)
+{
+    BYTE state[256];
+    unsigned int key;
+
+    if (!get_async_keyboard_state( state )) return FALSE;
+    for (key = VK_BACK; key < 256; key++)
+        if (key != VK_LWIN && key != VK_RWIN &&
+            ((state[key] & 0x80) || (state[key] & 0x01) != win_key_toggles[key])) return TRUE;
+    return FALSE;
+}
+
+/* Whether the key message is the shell's, and not to be delivered. */
+static BOOL task_list_key( const MSG *msg )
+{
+    BOOL win = msg->wParam == VK_LWIN || msg->wParam == VK_RWIN;
+
+    if (!win4wine_external_shell()) return FALSE;
+    switch (msg->message)
+    {
+    case WM_KEYDOWN:
+    case WM_SYSKEYDOWN:
+        if (win)
+        {
+            /* Not KF_REPEAT: a press that a window manager replays after its
+             * grab arrives with the key already down in Wine's state. A press
+             * long after the last one is new too: the release may have gone to
+             * another process, while auto-repeat comes at least every second. */
+            if (!win_key_down || msg->time - win_key_time > 1000)
+            {
+                win_key_down = win_key_alone = TRUE;
+                save_key_toggles();
+            }
+            win_key_time = msg->time;
+            return FALSE;
+        }
+        win_key_alone = FALSE;
+        /* The thread's key state is that of this message, also for keys that
+         * SendInput entered all at once. */
+        if (msg->wParam != VK_ESCAPE || !(NtUserGetKeyState( VK_CONTROL ) & 0x8000) ||
+            (NtUserGetKeyState( VK_SHIFT ) & 0x8000) || (NtUserGetKeyState( VK_MENU ) & 0x8000))
+            return FALSE;
+        post_task_list();
+        return TRUE;
+    case WM_KEYUP:
+    case WM_SYSKEYUP:
+        if (win) TRACE_(key)( "windows key up, alone %u\n", win_key_alone );
+        if (win && win_key_alone && !other_key_used()) post_task_list();
+        if (win) win_key_down = FALSE;
+        win_key_alone = FALSE;
+        return FALSE;
+    }
+    return FALSE;
+}
+
 /***********************************************************************
  *          process_keyboard_message
  *
@@ -2512,6 +2625,12 @@ static BOOL process_keyboard_message( MSG *msg, UINT hw_id, HWND hwnd_filter,
     if (msg->message < first || msg->message > last) return FALSE;
     if (!check_hwnd_filter( msg, hwnd_filter )) return FALSE;
 
+    if (remove && task_list_key( msg ))
+    {
+        accept_hardware_message( hw_id );
+        return FALSE;
+    }
+
     if (remove)
     {
         if((msg->message == WM_KEYDOWN) &&
