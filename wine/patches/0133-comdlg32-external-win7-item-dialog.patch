+    if(!fdimpl->win7 || FAILED(SHGetKnownFolderItem(&FOLDERID_Documents, 0, NULL, &IID_IShellItem,
+                                                    (void**)&fdimpl->psi_defaultfolder)))
+    {
+        SHGetDesktopFolder(&psf);
+        SHGetItemFromObject((IUnknown*)psf, &IID_IShellItem, (void**)&fdimpl->psi_defaultfolder);
+        IShellFolder_Release(psf);
+    }
 
     hr = init_custom_controls(fdimpl);
     if(FAILED(hr))
