+/* win4wine: Windows 7's dialog: its navigation bar, no Help button in the caption, and
+ * "Folder:" and Select Folder when folders are picked. */
+static void init_win7(FileDialogImpl *This)
+{
+    WCHAR text[64];
+    HWND hitem;
+    int width, height;
+    RECT rc;
+
+    SetWindowLongW(This->dlg_hwnd, GWL_EXSTYLE, GetWindowLongW(This->dlg_hwnd, GWL_EXSTYLE) & ~WS_EX_CONTEXTHELP);
+    SetWindowPos(This->dlg_hwnd, NULL, 0, 0, 0, 0,
+                 SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
+
+    /* Windows 7's dialog: the message font (Segoe UI or Meiryo UI 9pt), 640x478 */
+    if((This->hfont_win7 = navbar7_message_font(This->dpi_y)))
+    {
+        HWND child;
+        SendMessageW(This->dlg_hwnd, WM_SETFONT, (WPARAM)This->hfont_win7, FALSE);
+        for(child = GetWindow(This->dlg_hwnd, GW_CHILD); child; child = GetWindow(child, GW_HWNDNEXT))
+            if(child != This->cctrls_hwnd && GetParent(child) == This->dlg_hwnd)
+                SendMessageW(child, WM_SETFONT, (WPARAM)This->hfont_win7, FALSE);
+    }
+    GetWindowRect(This->dlg_hwnd, &rc);
+    width = MulDiv(640, This->dpi_x, USER_DEFAULT_SCREEN_DPI);
+    height = MulDiv(478, This->dpi_y, USER_DEFAULT_SCREEN_DPI);
+    SetWindowPos(This->dlg_hwnd, NULL, (rc.left + rc.right - width) / 2, (rc.top + rc.bottom - height) / 2,
+                 width, height, SWP_NOZORDER | SWP_NOACTIVATE);
+
+    if((hitem = GetDlgItem(This->dlg_hwnd, IDC_FILENAMESTATIC)))
+        SetWindowLongW(hitem, GWL_STYLE, GetWindowLongW(hitem, GWL_STYLE) | SS_CENTERIMAGE);
+    CreateWindowExW(0, L"ScrollBar", NULL, WS_CHILD | WS_VISIBLE | SBS_SIZEGRIP | SBS_SIZEBOXBOTTOMRIGHTALIGN,
+                    0, 0, GetSystemMetrics(SM_CXVSCROLL), GetSystemMetrics(SM_CYHSCROLL), This->dlg_hwnd,
+                    (HMENU)IDC_SIZEGRIP, COMDLG32_hInstance, NULL);
+
+    This->navbar = navbar7_create(This->dlg_hwnd, IDC_NAV_TOOLBAR, This->peb);
+    if(This->navbar && This->psi_folder)
+    {
+        PIDLIST_ABSOLUTE pidl;
+        if(SUCCEEDED(SHGetIDListFromObject((IUnknown*)This->psi_folder, &pidl)))
+        {
+            navbar7_set_folder(This->navbar, pidl);
+            ILFree(pidl);
+        }
+    }
+
+    if(!(This->options & FOS_PICKFOLDERS) || This->dlg_type != ITEMDLG_TYPE_OPEN)
+        return;
+    if(!This->custom_okbutton && LoadStringW(COMDLG32_hInstance, IDS_SELECT_FOLDER, text, ARRAY_SIZE(text)))
+        This->custom_okbutton = StrDupW(text);
+    if(!This->custom_filenamelabel && LoadStringW(COMDLG32_hInstance, IDS_FOLDER_LABEL, text, ARRAY_SIZE(text)))
+        This->custom_filenamelabel = StrDupW(text);
+}
