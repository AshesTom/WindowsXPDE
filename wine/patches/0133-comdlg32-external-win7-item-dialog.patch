+
+typedef struct IFolderFilterSite IFolderFilterSite;
+typedef struct IFolderFilterSiteVtbl
+{
+    HRESULT (WINAPI *QueryInterface)(IFolderFilterSite *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(IFolderFilterSite *);
+    ULONG (WINAPI *Release)(IFolderFilterSite *);
+    HRESULT (WINAPI *SetFilter)(IFolderFilterSite *, IUnknown *);
+} IFolderFilterSiteVtbl;
+struct IFolderFilterSite { const IFolderFilterSiteVtbl *lpVtbl; };
+
+static const IID IID_IFolderFilterSite = {0xc0a651f5, 0xb48b, 0x11d2, {0xb5, 0xed, 0x00, 0x60, 0x97, 0xc6, 0x86, 0xf6}};
+static const IID IID_IFolderFilter = {0x9cc22886, 0xdc8e, 0x11d2, {0xb1, 0xd0, 0x00, 0xc0, 0x4f, 0x8e, 0xeb, 0x3e}};
+
+/* explorerframe.dll's bitmaps and strings */
+#define EF_BMP_TRAVEL       0x0241  /* Back and Forward: normal, hot, disabled, pressed */
+#define EF_BMP_ICONS        0x0120  /* Go, Stop, Refresh, drop-down arrow: 16x16 each */
+#define EF_BMP_SEARCH       0x8700  /* the search box's magnifier, 16x16 */
+#define EF_BMP_CLEAR        0x8709  /* its clear button: normal, hot, pressed (0x8709, 0x870f, 0x8715) */
+#define EF_STR_SEARCHIN     13830   /* " %1の検索" / "Search %1" */
+#define EF_STR_NOTFOUND     724     /* "'%1!ws!' が見つかりません..." */
+
+enum element
+{
+    EL_NONE, EL_BACK, EL_FORWARD, EL_RECENT, EL_ADDRESS, EL_DROPDOWN, EL_REFRESH, EL_SEARCH, EL_CLEAR,
+    EL_CRUMB = 100  /* EL_CRUMB + 2 * i: the crumb's name, + 1: its arrow */
+};
+
+struct crumb
+{
+    PIDLIST_ABSOLUTE pidl;
+    WCHAR *name;
+    RECT text, arrow;
+    BOOL shown;
+};
