+#define S(v) MulDiv((v), This->dpi_x, USER_DEFAULT_SCREEN_DPI)
+    int height = S(30), right = dialog_rc->right - S(17), bottom = dialog_rc->bottom - S(14), width;
+    HWND hwnd;
+
+    width = (hwnd = GetDlgItem(This->dlg_hwnd, IDCANCEL)) ? max(S(86), text_width(hwnd) + S(34)) : S(86);
+    SetRect(cancel_rc, right - width, bottom - height, right, bottom);
+    if(show_dropdown)
+        SetRect(dropdown_rc, cancel_rc->left - S(15) - S(17), cancel_rc->top, cancel_rc->left - S(15), bottom);
+    else
+        SetRect(dropdown_rc, cancel_rc->left - S(15), cancel_rc->top, cancel_rc->left - S(15), bottom);
+    width = (hwnd = GetDlgItem(This->dlg_hwnd, IDOK)) ? max(S(86), text_width(hwnd) + S(42)) : S(86);
+    SetRect(open_rc, dropdown_rc->left - width, cancel_rc->top, dropdown_rc->left, bottom);
+
+    bottom = cancel_rc->top - S(7);
+    if(This->filterspec_count && (hwnd = GetDlgItem(This->dlg_hwnd, IDC_FILETYPE)))
+    {
+        RECT rc;
+        GetWindowRect(hwnd, &rc);
+        width = rc.right - rc.left;
+        SetRect(filetype_rc, right - width, bottom - (rc.bottom - rc.top), right, bottom);
+        right = filetype_rc->left - S(7);
+    }
+    else
+        SetRect(filetype_rc, right, bottom, right, bottom);
+    SetRect(label_rc, S(8), bottom - S(27), S(193), bottom);
+    SetRect(filename_rc, S(200), bottom - S(27), max(right, S(260)), bottom);
+#undef S
