+static void win7_bottom_layout(FileDialogImpl *This, const RECT *dialog_rc, BOOL show_dropdown, RECT *open_rc,
+                               RECT *dropdown_rc, RECT *cancel_rc, RECT *filetype_rc, RECT *filename_rc,
+                               RECT *label_rc)
