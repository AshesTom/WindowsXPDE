+struct navbar
+{
+    HWND hwnd, parent, edit, search;
+    IExplorerBrowser *browser;
+    HTHEME nav, bb, go, ab, sb, rebar;
+    HMODULE ef;
+    HBITMAP icons, magnifier, clear[3];
+    HFONT font, cue_font;
+    HBRUSH search_brush[4];
+    WCHAR *cue;
+    UINT dpi;
+    PIDLIST_ABSOLUTE current;
+    HICON current_icon;
+    PIDLIST_ABSOLUTE *history;
+    int history_count, history_pos, traveling;
+    struct crumb *crumbs;
+    int crumb_count;
+    BOOL overflow, editing;
+    RECT back, forward, recent, address, crumbs_rc, dropdown, refresh, searchbox, clearbtn;
+    int hot, pressed, menu_open;
+    WCHAR *filter;
+    IFolderFilter IFolderFilter_iface;
+};
+
+static int scale(const struct navbar *bar, int value)
+{
+    return MulDiv(value, bar->dpi, USER_DEFAULT_SCREEN_DPI);
+}
+
+/* explorerframe's 32-bit bitmaps are not premultiplied */
+static HBITMAP load_bitmap(HMODULE module, UINT id)
+{
+    HBITMAP bitmap;
+    DIBSECTION dib;
+    BYTE *bits;
+    int i;
+
+    if (!module) return NULL;
+    bitmap = LoadImageW(module, MAKEINTRESOURCEW(id), IMAGE_BITMAP, 0, 0, LR_CREATEDIBSECTION);
+    if (!bitmap) return NULL;
+    if (GetObjectW(bitmap, sizeof(dib), &dib) != sizeof(dib) || dib.dsBm.bmBitsPixel != 32 || !dib.dsBm.bmBits)
+        return bitmap;
+    bits = dib.dsBm.bmBits;
+    for (i = 0; i < dib.dsBm.bmWidth * abs(dib.dsBm.bmHeight); i++, bits += 4)
+    {
+        bits[0] = bits[0] * bits[3] / 255;
+        bits[1] = bits[1] * bits[3] / 255;
+        bits[2] = bits[2] * bits[3] / 255;
+    }
+    return bitmap;
+}
+
+/* cell INDEX of SIZE x SIZE in BITMAP, centred in RC */
+static void draw_cell(const struct navbar *bar, HDC hdc, HBITMAP bitmap, int index, int size, const RECT *rc)
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    int width = scale(bar, size);
+    HDC mem;
+    HGDIOBJ old;
+
+    if (!bitmap) return;
+    mem = CreateCompatibleDC(hdc);
+    old = SelectObject(mem, bitmap);
+    GdiAlphaBlend(hdc, (rc->left + rc->right - width) / 2, (rc->top + rc->bottom - width) / 2, width, width,
+                  mem, index * size, 0, size, size, blend);
+    SelectObject(mem, old);
+    DeleteDC(mem);
+}
+
+static WCHAR *ef_string(const struct navbar *bar, UINT id, const WCHAR *arg, const WCHAR *fallback)
+{
+    WCHAR format[256], *text = NULL;
+    DWORD_PTR args[1] = { (DWORD_PTR)arg };
+
+    if (!bar->ef || !LoadStringW(bar->ef, id, format, ARRAY_SIZE(format)))
+        lstrcpynW(format, fallback, ARRAY_SIZE(format));
+    if (!FormatMessageW(FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_ARGUMENT_ARRAY,
+                        format, 0, 0, (WCHAR *)&text, 0, (va_list *)args))
+        return NULL;
+    return text;
+}
+
+static void free_crumbs(struct navbar *bar)
+{
+    int i;
+    for (i = 0; i < bar->crumb_count; i++)
+    {
+        ILFree(bar->crumbs[i].pidl);
+        CoTaskMemFree(bar->crumbs[i].name);
+    }
+    free(bar->crumbs);
+    bar->crumbs = NULL;
+    bar->crumb_count = 0;
+}
+
+/* The crumbs of the current folder: the desktop (its arrow only), then each folder
+ * below it down to the current one. */
+static void build_crumbs(struct navbar *bar)
+{
+    PIDLIST_ABSOLUTE pidl;
+    int count = 1, i;
+    PCUIDLIST_RELATIVE item;
+
+    free_crumbs(bar);
+    if (!bar->current) return;
+    for (item = bar->current; item->mkid.cb; item = ILGetNext(item)) count++;
+    if (!(bar->crumbs = calloc(count, sizeof(*bar->crumbs)))) return;
+    pidl = ILClone(bar->current);
+    for (i = count - 1; i >= 0; i--)
+    {
+        struct crumb *crumb = &bar->crumbs[i];
+        crumb->pidl = ILClone(pidl);
+        if (i) SHGetNameFromIDList(crumb->pidl, SIGDN_NORMALDISPLAY, &crumb->name);
+        ILRemoveLastID(pidl);
+    }
+    ILFree(pidl);
+    bar->crumb_count = count;
+}
+
+static int text_width(const struct navbar *bar, HDC hdc, const WCHAR *text)
+{
+    SIZE size = {0};
+    HGDIOBJ old = SelectObject(hdc, bar->font);
+    GetTextExtentPoint32W(hdc, text, lstrlenW(text), &size);
+    SelectObject(hdc, old);
+    return size.cx;
+}
+
+static void layout(struct navbar *bar)
+{
+    RECT client;
+    int width, height, x, y, i, available, needed, first;
+    int travel = scale(bar, 30), button = scale(bar, 25), arrow = scale(bar, 16), pad = scale(bar, 6);
+    HDC hdc;
+
+    GetClientRect(bar->hwnd, &client);
+    width = client.right;
+    height = client.bottom;
+
+    /* Back and Forward overlap; the recent places' arrow follows */
+    y = (height - travel) / 2;
+    SetRect(&bar->back, 0, y, travel, y + travel);
+    SetRect(&bar->forward, scale(bar, 27), y, scale(bar, 27) + travel, y + travel);
+    y = (height - scale(bar, 27)) / 2;
+    SetRect(&bar->recent, scale(bar, 57), y, scale(bar, 70), y + scale(bar, 27));
+
+    /* the address and the search box, 26 high; the search box is 202 wide */
+    y = (height - scale(bar, 26)) / 2;
+    SetRect(&bar->searchbox, width - scale(bar, 204), y, width - scale(bar, 2), y + scale(bar, 26));
+    SetRect(&bar->address, scale(bar, 71), y, bar->searchbox.left - scale(bar, 6), y + scale(bar, 26));
+    SetRect(&bar->refresh, bar->address.right - 1 - button, y + 1, bar->address.right - 1, y + scale(bar, 25));
+    SetRect(&bar->dropdown, bar->refresh.left - scale(bar, 19), y + 1, bar->refresh.left, y + scale(bar, 25));
+    SetRect(&bar->crumbs_rc, bar->address.left + 1, y + 1, bar->dropdown.left, y + scale(bar, 25));
+    SetRect(&bar->clearbtn, bar->searchbox.right - scale(bar, 22), y + 1, bar->searchbox.right - 1, y + scale(bar, 25));
+
+    if (bar->edit)
+        SetWindowPos(bar->edit, NULL, bar->crumbs_rc.left + scale(bar, 26), y + scale(bar, 5),
+                     bar->crumbs_rc.right - bar->crumbs_rc.left - scale(bar, 28), scale(bar, 16),
+                     SWP_NOZORDER | SWP_NOACTIVATE);
+    if (bar->search)
+        SetWindowPos(bar->search, NULL, bar->searchbox.left + scale(bar, 6), y + scale(bar, 5),
+                     bar->clearbtn.left - bar->searchbox.left - scale(bar, 6), scale(bar, 16),
+                     SWP_NOZORDER | SWP_NOACTIVATE);
+
+    /* crumbs: the icon, the desktop's arrow, then name and arrow for each folder; the
+     * leading ones give way when they do not fit (the desktop's arrow shows "«" then) */
+    if (!bar->crumb_count) return;
+    hdc = GetDC(bar->hwnd);
+    available = bar->crumbs_rc.right - bar->crumbs_rc.left - scale(bar, 22) - arrow;
+    needed = 0;
+    first = bar->crumb_count;
+    for (i = bar->crumb_count - 1; i >= 1; i--)
+    {
+        int w = text_width(bar, hdc, bar->crumbs[i].name ? bar->crumbs[i].name : L"") + 2 * pad + arrow;
+        if (needed + w > available && i < bar->crumb_count - 1) break;
+        needed += w;
+        first = i;
+    }
+    ReleaseDC(bar->hwnd, hdc);
+    bar->overflow = first > 1;
+
+    x = bar->crumbs_rc.left + scale(bar, 22);
+    for (i = 0; i < bar->crumb_count; i++)
+    {
+        struct crumb *crumb = &bar->crumbs[i];
+        crumb->shown = !i || i >= first;
+        if (!crumb->shown) continue;
+        if (i)
+        {
+            hdc = GetDC(bar->hwnd);
+            SetRect(&crumb->text, x, bar->crumbs_rc.top,
+                    min(x + text_width(bar, hdc, crumb->name ? crumb->name : L"") + 2 * pad,
+                        bar->crumbs_rc.right - arrow), bar->crumbs_rc.bottom);
+            ReleaseDC(bar->hwnd, hdc);
+            x = crumb->text.right;
+        }
+        else SetRectEmpty(&crumb->text);
+        SetRect(&crumb->arrow, x, bar->crumbs_rc.top, x + arrow, bar->crumbs_rc.bottom);
+        x += arrow;
+    }
+}
+
+static BOOL can_go_back(const struct navbar *bar) { return bar->history_pos > 0; }
+static BOOL can_go_forward(const struct navbar *bar) { return bar->history_pos < bar->history_count - 1; }
+
+static int part_state(const struct navbar *bar, int element, BOOL enabled)
+{
+    if (!enabled) return 4;
+    if (bar->pressed == element || bar->menu_open == element) return 3;
+    if (bar->hot == element) return 2;
+    return 1;
+}
+
+static void paint(struct navbar *bar, HDC hdc)
+{
+    RECT client, rc;
+    int i, state;
+    HGDIOBJ old_font;
+
+    GetClientRect(bar->hwnd, &client);
+    if (bar->rebar) DrawThemeBackground(bar->rebar, hdc, RP_BACKGROUND, 0, &client, NULL);
+    else FillRect(hdc, &client, GetSysColorBrush(COLOR_BTNFACE));
+
+    /* travel buttons: Forward under Back */
+    if (bar->nav)
+    {
+        DrawThemeBackground(bar->nav, hdc, NAV_FORWARDBUTTON, part_state(bar, EL_FORWARD, can_go_forward(bar)),
+                            &bar->forward, NULL);
+        DrawThemeBackground(bar->nav, hdc, NAV_BACKBUTTON, part_state(bar, EL_BACK, can_go_back(bar)),
+                            &bar->back, NULL);
+        DrawThemeBackground(bar->nav, hdc, NAV_MENUBUTTON, part_state(bar, EL_RECENT, bar->history_count > 1),
+                            &bar->recent, NULL);
+    }
+
+    /* the address */
+    state = bar->editing ? 3 : (bar->hot >= EL_ADDRESS && bar->hot != EL_SEARCH && bar->hot != EL_CLEAR) ? 2 : 1;
+    if (bar->ab) DrawThemeBackground(bar->ab, hdc, 1, state, &bar->address, NULL);
+    else DrawEdge(hdc, &bar->address, EDGE_SUNKEN, BF_RECT | BF_ADJUST);
+    if (bar->current_icon)
+        DrawIconEx(hdc, bar->crumbs_rc.left + scale(bar, 4),
+                   (bar->crumbs_rc.top + bar->crumbs_rc.bottom - scale(bar, 16)) / 2,
+                   bar->current_icon, scale(bar, 16), scale(bar, 16), 0, NULL, DI_NORMAL);
+    if (!bar->editing)
+    {
+        old_font = SelectObject(hdc, bar->font);
+        SetBkMode(hdc, TRANSPARENT);
+        SetTextColor(hdc, GetSysColor(COLOR_WINDOWTEXT));
+        for (i = 0; i < bar->crumb_count; i++)
+        {
+            const struct crumb *crumb = &bar->crumbs[i];
+            int text = EL_CRUMB + 2 * i, arrow = text + 1;
+            BOOL hot = bar->hot == text || bar->hot == arrow || bar->menu_open == arrow;
+
+            if (!crumb->shown) continue;
+            if (i)
+            {
+                rc = crumb->text;
+                if (bar->bb && (hot || bar->pressed == text))
+                    DrawThemeBackground(bar->bb, hdc, TP_SPLITBUTTON, bar->pressed == text ? 3 : 2, &rc, NULL);
+                InflateRect(&rc, -scale(bar, 6), 0);
+                DrawTextW(hdc, crumb->name ? crumb->name : L"", -1, &rc,
+                          DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS);
+            }
+            if (bar->bb)
+            {
+                int arrow_state = bar->menu_open == arrow ? 3 : hot ? 2 : 1;
+                if (!i && bar->overflow)
+                {
+                    /* the folders that gave way: "«" */
+                    if (arrow_state > 1) DrawThemeBackground(bar->bb, hdc, TP_SPLITBUTTON, arrow_state, &crumb->arrow, NULL);
+                    DrawTextW(hdc, L"\x00ab", 1, (RECT *)&crumb->arrow, DT_SINGLELINE | DT_VCENTER | DT_CENTER);
+                }
+                else
+                    DrawThemeBackground(bar->bb, hdc, TP_SPLITBUTTONDROPDOWN, arrow_state, &crumb->arrow, NULL);
+            }
+        }
+        SelectObject(hdc, old_font);
+    }
+
+    /* the drop-down of recent places and Refresh (Go while the address is edited) */
+    if (bar->go)
+    {
+        DrawThemeBackground(bar->go, hdc, TP_SPLITBUTTONDROPDOWN, part_state(bar, EL_DROPDOWN, TRUE),
+                            &bar->dropdown, NULL);
+        state = part_state(bar, EL_REFRESH, TRUE);
+        if (state > 1) DrawThemeBackground(bar->go, hdc, TP_BUTTON, state, &bar->refresh, NULL);
+    }
+    draw_cell(bar, hdc, bar->icons, bar->editing ? 0 : 2, 16, &bar->refresh);
+
+    /* the search box */
+    state = GetFocus() == bar->search ? 3 : (bar->hot == EL_SEARCH || bar->hot == EL_CLEAR) ? 2 : 1;
+    if (bar->sb) DrawThemeBackground(bar->sb, hdc, 1, state, &bar->searchbox, NULL);
+    else DrawEdge(hdc, &bar->searchbox, EDGE_SUNKEN, BF_RECT);
+    if (bar->filter && *bar->filter)
+        draw_cell(bar, hdc, bar->clear[bar->pressed == EL_CLEAR ? 2 : bar->hot == EL_CLEAR ? 1 : 0], 0, 16,
+                  &bar->clearbtn);
+    else
+        draw_cell(bar, hdc, bar->magnifier, 0, 16, &bar->clearbtn);
+}
+
+/* the inside of the search box as its frame draws it over the bar (state 1 normal, 2 hot,
+ * 3 focused): the edit box shows it as its background */
+static void update_search_brushes(struct navbar *bar)
+{
+    RECT client, rc;
+    HDC screen, hdc;
+    HBITMAP bitmap;
+    HGDIOBJ old;
+    int state;
+
+    for (state = 1; state <= 3; state++)
+    {
+        if (bar->search_brush[state]) DeleteObject(bar->search_brush[state]);
+        bar->search_brush[state] = NULL;
+    }
+    if (!bar->sb || IsRectEmpty(&bar->searchbox)) return;
+    GetClientRect(bar->hwnd, &client);
+    screen = GetDC(NULL);
+    hdc = CreateCompatibleDC(screen);
+    bitmap = CreateCompatibleBitmap(screen, client.right, client.bottom);
+    old = SelectObject(hdc, bitmap);
+    for (state = 1; state <= 3; state++)
+    {
+        if (bar->rebar) DrawThemeBackground(bar->rebar, hdc, RP_BACKGROUND, 0, &client, NULL);
+        else FillRect(hdc, &client, GetSysColorBrush(COLOR_BTNFACE));
+        rc = bar->searchbox;
+        DrawThemeBackground(bar->sb, hdc, 1, state, &rc, NULL);
+        bar->search_brush[state] = CreateSolidBrush(GetPixel(hdc, (rc.left + rc.right) / 2, (rc.top + rc.bottom) / 2));
+    }
+    SelectObject(hdc, old);
+    DeleteObject(bitmap);
+    DeleteDC(hdc);
+    ReleaseDC(NULL, screen);
+}
+
+static int hit_test(const struct navbar *bar, POINT pt)
+{
+    int i;
+
+    if (PtInRect(&bar->back, pt)) return EL_BACK;
+    if (PtInRect(&bar->forward, pt)) return EL_FORWARD;
+    if (PtInRect(&bar->recent, pt)) return EL_RECENT;
+    if (PtInRect(&bar->refresh, pt)) return EL_REFRESH;
+    if (PtInRect(&bar->dropdown, pt)) return EL_DROPDOWN;
+    if (!bar->editing)
+        for (i = 0; i < bar->crumb_count; i++)
+        {
+            if (!bar->crumbs[i].shown) continue;
+            if (PtInRect(&bar->crumbs[i].text, pt)) return EL_CRUMB + 2 * i;
+            if (PtInRect(&bar->crumbs[i].arrow, pt)) return EL_CRUMB + 2 * i + 1;
+        }
+    if (PtInRect(&bar->address, pt)) return EL_ADDRESS;
+    if (PtInRect(&bar->clearbtn, pt) && bar->filter && *bar->filter) return EL_CLEAR;
+    if (PtInRect(&bar->searchbox, pt)) return EL_SEARCH;
+    return EL_NONE;
+}
+
+static void navigate(struct navbar *bar, PCIDLIST_ABSOLUTE pidl)
+{
+    if (bar->browser && pidl) IExplorerBrowser_BrowseToIDList(bar->browser, pidl, SBSP_ABSOLUTE);
+}
+
+static void travel(struct navbar *bar, int pos)
+{
+    if (pos < 0 || pos >= bar->history_count || pos == bar->history_pos) return;
+    bar->traveling = pos + 1;
+    navigate(bar, bar->history[pos]);
+}
+
+static void refresh_view(struct navbar *bar)
+{
+    IShellView *view;
+
+    if (bar->browser && SUCCEEDED(IExplorerBrowser_GetCurrentView(bar->browser, &IID_IShellView, (void **)&view)))
+    {
+        IShellView_Refresh(view);
+        IShellView_Release(view);
+    }
+}
+
+static void add_menu_item(HMENU menu, UINT id, PCIDLIST_ABSOLUTE pidl, BOOL bold)
+{
+    MENUITEMINFOW info = { sizeof(info) };
+    WCHAR *name;
+
+    if (FAILED(SHGetNameFromIDList(pidl, SIGDN_NORMALDISPLAY, &name))) return;
+    info.fMask = MIIM_ID | MIIM_STRING | MIIM_STATE;
+    info.wID = id;
+    info.dwTypeData = name;
+    info.fState = bold ? MFS_DEFAULT : 0;
+    InsertMenuItemW(menu, -1, TRUE, &info);
+    CoTaskMemFree(name);
+}
+
+static int compare_names(const void *a, const void *b)
+{
+    return CompareStringW(LOCALE_USER_DEFAULT, NORM_IGNORECASE | SORT_DIGITSASNUMBERS,
+                          *(const WCHAR **)a, -1, *(const WCHAR **)b, -1) - CSTR_EQUAL;
+}
+
+/* the folders in crumb INDEX (the hidden ones for the desktop's "«") */
+static PIDLIST_ABSOLUTE crumb_menu(struct navbar *bar, int index, const RECT *rc)
+{
+    struct crumb *crumb = &bar->crumbs[index];
+    PIDLIST_ABSOLUTE result = NULL, *pidls = NULL;
+    WCHAR **names = NULL;
+    HMENU menu = CreatePopupMenu();
+    int count = 0, capacity = 0, i, chosen;
+    POINT pt = { rc->left, rc->bottom };
+
+    if (!index && bar->overflow)
+    {
+        for (i = bar->crumb_count - 1; i >= 1; i--)
+            if (!bar->crumbs[i].shown) add_menu_item(menu, i + 1, bar->crumbs[i].pidl, FALSE);
+        MapWindowPoints(bar->hwnd, NULL, &pt, 1);
+        chosen = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_LEFTBUTTON, pt.x, pt.y, 0, bar->hwnd, NULL);
+        if (chosen > 0) result = ILClone(bar->crumbs[chosen - 1].pidl);
+    }
+    else
+    {
+        IShellFolder *folder;
+        IEnumIDList *items;
+        PITEMID_CHILD child;
+
+        if (SUCCEEDED(SHBindToObject(NULL, crumb->pidl, NULL, &IID_IShellFolder, (void **)&folder)))
+        {
+            if (IShellFolder_EnumObjects(folder, bar->hwnd, SHCONTF_FOLDERS, &items) == S_OK)
+            {
+                while (count < 1000 && IEnumIDList_Next(items, 1, &child, NULL) == S_OK)
+                {
+                    SFGAOF attr = SFGAO_FOLDER;
+                    STRRET str;
+                    WCHAR *name;
+
+                    if (FAILED(IShellFolder_GetAttributesOf(folder, 1, (PCUITEMID_CHILD_ARRAY)&child, &attr)) ||
+                        !(attr & SFGAO_FOLDER) ||
+                        FAILED(IShellFolder_GetDisplayNameOf(folder, child, SHGDN_INFOLDER, &str)) ||
+                        FAILED(StrRetToStrW(&str, child, &name)))
+                    {
+                        ILFree(child);
+                        continue;
+                    }
+                    if (count == capacity)
+                    {
+                        capacity = capacity ? capacity * 2 : 32;
+                        pidls = realloc(pidls, capacity * sizeof(*pidls));
+                        names = realloc(names, capacity * sizeof(*names));
+                    }
+                    names[count] = name;
+                    pidls[count] = ILCombine(crumb->pidl, child);
+                    ILFree(child);
+                    count++;
+                }
+                IEnumIDList_Release(items);
+            }
+            IShellFolder_Release(folder);
+        }
+        if (count)
+        {
+            /* sort the names, then find each one's ID list again */
+            WCHAR **sorted = malloc(count * sizeof(*sorted));
+            memcpy(sorted, names, count * sizeof(*sorted));
+            qsort(sorted, count, sizeof(*sorted), compare_names);
+            for (i = 0; i < count; i++)
+            {
+                int j;
+                for (j = 0; j < count; j++) if (names[j] == sorted[i]) break;
+                AppendMenuW(menu, MF_STRING, j + 1, sorted[i]);
+                if (index + 1 < bar->crumb_count && ILIsEqual(pidls[j], bar->crumbs[index + 1].pidl))
+                    SetMenuDefaultItem(menu, j + 1, FALSE);
+            }
+            free(sorted);
+            MapWindowPoints(bar->hwnd, NULL, &pt, 1);
+            chosen = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_LEFTBUTTON, pt.x, pt.y, 0, bar->hwnd, NULL);
+            if (chosen > 0) result = ILClone(pidls[chosen - 1]);
+            for (i = 0; i < count; i++)
+            {
+                CoTaskMemFree(names[i]);
+                ILFree(pidls[i]);
+            }
+        }
+        free(names);
+        free(pidls);
+    }
+    DestroyMenu(menu);
+    return result;
+}
+
+/* the recent places: forward ones above, the current one checked, back ones below */
+static void recent_menu(struct navbar *bar, const RECT *rc)
+{
+    HMENU menu = CreatePopupMenu();
+    POINT pt = { rc->left, rc->bottom };
+    int i, chosen;
+
+    for (i = bar->history_count - 1; i >= 0 && i > bar->history_count - 17; i--)
+    {
+        add_menu_item(menu, i + 1, bar->history[i], FALSE);
+        if (i == bar->history_pos) CheckMenuItem(menu, i + 1, MF_BYCOMMAND | MF_CHECKED);
+    }
+    MapWindowPoints(bar->hwnd, NULL, &pt, 1);
+    chosen = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_LEFTBUTTON, pt.x, pt.y, 0, bar->hwnd, NULL);
+    DestroyMenu(menu);
+    if (chosen > 0) travel(bar, chosen - 1);
+}
+
+static void show_menu(struct navbar *bar, int element)
+{
+    RECT rc;
+    PIDLIST_ABSOLUTE pidl = NULL;
+
+    bar->menu_open = element;
+    InvalidateRect(bar->hwnd, NULL, FALSE);
+    UpdateWindow(bar->hwnd);
+    if (element == EL_RECENT) recent_menu(bar, &bar->recent);
+    else if (element == EL_DROPDOWN)
+    {
+        rc = bar->address;
+        recent_menu(bar, &rc);
+    }
+    else if (element >= EL_CRUMB)
+    {
+        int index = (element - EL_CRUMB) / 2;
+        pidl = crumb_menu(bar, index, &bar->crumbs[index].arrow);
+    }
+    bar->menu_open = EL_NONE;
+    bar->pressed = EL_NONE;
+    InvalidateRect(bar->hwnd, NULL, FALSE);
+    if (pidl)
+    {
+        navigate(bar, pidl);
+        ILFree(pidl);
+    }
+}
+
+static void start_editing(struct navbar *bar)
+{
+    WCHAR *path = NULL;
+
+    if (bar->editing || !bar->edit) return;
+    bar->editing = TRUE;
+    if (bar->current && SUCCEEDED(SHGetNameFromIDList(bar->current, SIGDN_DESKTOPABSOLUTEEDITING, &path)))
+    {
+        SetWindowTextW(bar->edit, path);
+        CoTaskMemFree(path);
+    }
+    ShowWindow(bar->edit, SW_SHOW);
+    SetFocus(bar->edit);
+    SendMessageW(bar->edit, EM_SETSEL, 0, -1);
+    InvalidateRect(bar->hwnd, NULL, TRUE);
+}
+
+static void stop_editing(struct navbar *bar)
+{
+    if (!bar->editing) return;
+    bar->editing = FALSE;
+    ShowWindow(bar->edit, SW_HIDE);
+    InvalidateRect(bar->hwnd, NULL, TRUE);
+}
+
+/* the typed address: a path (with %VARIABLES%) or a shell name */
+static void go_to_typed(struct navbar *bar)
+{
+    WCHAR text[MAX_PATH * 2], expanded[MAX_PATH * 2];
+    PIDLIST_ABSOLUTE pidl = NULL;
+    WCHAR *message;
+
+    GetWindowTextW(bar->edit, text, ARRAY_SIZE(text));
+    StrTrimW(text, L" \t\"");
+    if (!*text) return;
+    if (!ExpandEnvironmentStringsW(text, expanded, ARRAY_SIZE(expanded))) lstrcpyW(expanded, text);
+    if (FAILED(SHParseDisplayName(expanded, NULL, &pidl, 0, NULL)) || !pidl)
+    {
+        WCHAR caption[256];
+        message = ef_string(bar, EF_STR_NOTFOUND, expanded, L"'%1!ws!' was not found.");
+        GetWindowTextW(GetAncestor(bar->hwnd, GA_ROOT), caption, ARRAY_SIZE(caption));
+        MessageBoxW(GetAncestor(bar->hwnd, GA_ROOT), message ? message : expanded, caption, MB_OK | MB_ICONERROR);
+        LocalFree(message);
+        SetFocus(bar->edit);
+        return;
+    }
+    stop_editing(bar);
+    navigate(bar, pidl);
+    ILFree(pidl);
+}
+
+static LRESULT CALLBACK edit_subclass(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, UINT_PTR id, DWORD_PTR data)
+{
+    struct navbar *bar = (struct navbar *)data;
+
+    switch (msg)
+    {
+    case WM_GETDLGCODE:
+        /* Enter and Esc are the address box's; Esc is the search box's while it has text */
+        if (hwnd == bar->edit || GetWindowTextLengthW(hwnd))
+            return DLGC_WANTALLKEYS | DefSubclassProc(hwnd, msg, wparam, lparam);
+        break;
+    case WM_KEYDOWN:
+        if (wparam == VK_RETURN && hwnd == bar->edit) { go_to_typed(bar); return 0; }
+        if (wparam == VK_ESCAPE && hwnd == bar->edit) { stop_editing(bar); return 0; }
+        if (wparam == VK_ESCAPE && hwnd == bar->search) { SetWindowTextW(hwnd, L""); return 0; }
+        break;
+    case WM_CHAR:
+        if (wparam == '\r' || wparam == 27) return 0;
+        break;
+    case WM_KILLFOCUS:
+        if (hwnd == bar->edit) PostMessageW(bar->hwnd, WM_USER, 0, 0);
+        InvalidateRect(bar->hwnd, NULL, FALSE);
+        InvalidateRect(hwnd, NULL, TRUE);
+        break;
+    case WM_SETFOCUS:
+        InvalidateRect(bar->hwnd, NULL, FALSE);
+        InvalidateRect(hwnd, NULL, TRUE);
+        break;
+    case WM_PAINT:
+        /* the search box's prompt, in italics as Windows 7 draws it, while it is empty */
+        if (hwnd == bar->search && bar->cue && !GetWindowTextLengthW(hwnd))
+        {
+            LRESULT ret = DefSubclassProc(hwnd, msg, wparam, lparam);
+            DWORD margins = SendMessageW(hwnd, EM_GETMARGINS, 0, 0);
+            HDC hdc = GetDC(hwnd);
+            HGDIOBJ old = SelectObject(hdc, bar->cue_font ? bar->cue_font : bar->font);
+            RECT rc;
+
+            GetClientRect(hwnd, &rc);
+            rc.left += LOWORD(margins) + 1;
+            SetBkMode(hdc, TRANSPARENT);
+            SetTextColor(hdc, GetSysColor(COLOR_GRAYTEXT));
+            DrawTextW(hdc, bar->cue, -1, &rc, DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
+            SelectObject(hdc, old);
+            ReleaseDC(hwnd, hdc);
+            return ret;
+        }
+        break;
+    }
+    return DefSubclassProc(hwnd, msg, wparam, lparam);
+}
+
+/* the search box filters the folder's items by name */
+static struct navbar *impl_from_IFolderFilter(IFolderFilter *iface)
+{
+    return CONTAINING_RECORD(iface, struct navbar, IFolderFilter_iface);
+}
+
+static HRESULT WINAPI filter_QueryInterface(IFolderFilter *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IFolderFilter))
+    {
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI filter_AddRef(IFolderFilter *iface) { return 2; }
+static ULONG WINAPI filter_Release(IFolderFilter *iface) { return 1; }
+
+static HRESULT WINAPI filter_ShouldShow(IFolderFilter *iface, IShellFolder *folder, PCIDLIST_ABSOLUTE parent,
+                                        PCUITEMID_CHILD item)
+{
+    struct navbar *bar = impl_from_IFolderFilter(iface);
+    STRRET str;
+    WCHAR *name;
+    HRESULT hr = S_OK;
+
+    if (!bar->filter || !*bar->filter) return S_OK;
+    if (SUCCEEDED(IShellFolder_GetDisplayNameOf(folder, item, SHGDN_INFOLDER, &str)) &&
+        SUCCEEDED(StrRetToStrW(&str, item, &name)))
+    {
+        hr = StrStrIW(name, bar->filter) ? S_OK : S_FALSE;
+        CoTaskMemFree(name);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI filter_GetEnumFlags(IFolderFilter *iface, IShellFolder *folder, PCIDLIST_ABSOLUTE parent,
+                                          HWND *hwnd, DWORD *flags)
+{
+    return S_OK;
+}
+
+static const IFolderFilterVtbl filter_vtbl =
+{
+    filter_QueryInterface, filter_AddRef, filter_Release, filter_ShouldShow, filter_GetEnumFlags
+};
+
+static void search_changed(struct navbar *bar)
+{
+    int length = GetWindowTextLengthW(bar->search);
+    IFolderFilterSite *site;
+
+    free(bar->filter);
+    bar->filter = malloc((length + 1) * sizeof(WCHAR));
+    if (bar->filter) GetWindowTextW(bar->search, bar->filter, length + 1);
+    if (bar->browser && SUCCEEDED(IExplorerBrowser_QueryInterface(bar->browser, &IID_IFolderFilterSite, (void **)&site)))
+    {
+        site->lpVtbl->SetFilter(site, bar->filter && *bar->filter ? (IUnknown *)&bar->IFolderFilter_iface : NULL);
+        site->lpVtbl->Release(site);
+    }
+    refresh_view(bar);
+    InvalidateRect(bar->hwnd, &bar->searchbox, FALSE);
+}
+
+static void update_cue(struct navbar *bar)
+{
+    WCHAR *name = NULL, *cue;
+
+    if (!bar->search) return;
+    if (bar->current) SHGetNameFromIDList(bar->current, SIGDN_NORMALDISPLAY, &name);
+    cue = ef_string(bar, EF_STR_SEARCHIN, name ? name : L"", L"Search %1");
+    if (cue)
+    {
+        WCHAR *text = cue;
+        while (*text == ' ') text++;
+        free(bar->cue);
+        bar->cue = wcsdup(text);
+        InvalidateRect(bar->search, NULL, TRUE);
+        LocalFree(cue);
+    }
+    CoTaskMemFree(name);
+}
+
+static void set_folder(struct navbar *bar, PCIDLIST_ABSOLUTE pidl)
+{
+    SHFILEINFOW info;
+    int i;
+
+    ILFree(bar->current);
+    bar->current = ILClone(pidl);
+    if (bar->current_icon) DestroyIcon(bar->current_icon);
+    bar->current_icon = NULL;
+    if (SHGetFileInfoW((const WCHAR *)pidl, 0, &info, sizeof(info), SHGFI_PIDL | SHGFI_ICON | SHGFI_SMALLICON))
+        bar->current_icon = info.hIcon;
+
+    /* history: a jump to a recent place keeps it, other navigation drops what is forward */
+    if (bar->traveling && bar->traveling - 1 < bar->history_count &&
+        ILIsEqual(bar->history[bar->traveling - 1], pidl))
+        bar->history_pos = bar->traveling - 1;
+    else if (!bar->history_count || !ILIsEqual(bar->history[bar->history_pos], pidl))
+    {
+        for (i = bar->history_pos + 1; i < bar->history_count; i++) ILFree(bar->history[i]);
+        bar->history_count = bar->history_count ? bar->history_pos + 1 : 0;
+        bar->history = realloc(bar->history, (bar->history_count + 1) * sizeof(*bar->history));
+        bar->history[bar->history_count] = ILClone(pidl);
+        bar->history_pos = bar->history_count++;
+    }
+    bar->traveling = 0;
+
+    stop_editing(bar);
+    build_crumbs(bar);
+    layout(bar);
+    update_cue(bar);
+    if (bar->filter && *bar->filter) SetWindowTextW(bar->search, L"");
+    InvalidateRect(bar->hwnd, NULL, TRUE);
+}
+
+static void set_hot(struct navbar *bar, int hot)
+{
+    if (bar->hot == hot) return;
+    bar->hot = hot;
+    InvalidateRect(bar->hwnd, NULL, FALSE);
+    if (bar->search) InvalidateRect(bar->search, NULL, TRUE);
+}
+
+static void click(struct navbar *bar, int element)
+{
+    switch (element)
+    {
+    case EL_BACK:     travel(bar, bar->history_pos - 1); break;
+    case EL_FORWARD:  travel(bar, bar->history_pos + 1); break;
+    case EL_REFRESH:  if (bar->editing) go_to_typed(bar); else refresh_view(bar); break;
+    case EL_ADDRESS:  start_editing(bar); break;
+    case EL_SEARCH:   SetFocus(bar->search); break;
+    case EL_CLEAR:    SetWindowTextW(bar->search, L""); SetFocus(bar->search); break;
+    default:
+        if (element >= EL_CRUMB && !((element - EL_CRUMB) & 1))
+            navigate(bar, bar->crumbs[(element - EL_CRUMB) / 2].pidl);
+    }
+}
+
+static BOOL is_menu_element(const struct navbar *bar, int element)
+{
+    return element == EL_RECENT || element == EL_DROPDOWN || (element >= EL_CRUMB && ((element - EL_CRUMB) & 1));
+}
+
+static LRESULT CALLBACK navbar_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct navbar *bar = (struct navbar *)GetWindowLongPtrW(hwnd, 0);
+    PAINTSTRUCT ps;
+    POINT pt;
+
+    switch (msg)
+    {
+    case WM_NCCREATE:
+        SetWindowLongPtrW(hwnd, 0, (LONG_PTR)((CREATESTRUCTW *)lparam)->lpCreateParams);
+        break;
+    case WM_PAINT:
+        BeginPaint(hwnd, &ps);
+        paint(bar, ps.hdc);
+        EndPaint(hwnd, &ps);
+        return 0;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_SIZE:
+        layout(bar);
+        update_search_brushes(bar);
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_MOUSEMOVE:
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd };
+        pt.x = (short)LOWORD(lparam);
+        pt.y = (short)HIWORD(lparam);
+        set_hot(bar, hit_test(bar, pt));
+        TrackMouseEvent(&tme);
+        return 0;
+    }
+    case WM_MOUSELEAVE:
+        set_hot(bar, EL_NONE);
+        return 0;
+    case WM_LBUTTONDOWN:
+        pt.x = (short)LOWORD(lparam);
+        pt.y = (short)HIWORD(lparam);
+        bar->pressed = hit_test(bar, pt);
+        if (bar->editing && bar->pressed != EL_REFRESH && bar->pressed != EL_DROPDOWN) stop_editing(bar);
+        if (is_menu_element(bar, bar->pressed))
+        {
+            show_menu(bar, bar->pressed);
+            return 0;
+        }
+        if (bar->pressed == EL_BACK && !can_go_back(bar)) bar->pressed = EL_NONE;
+        if (bar->pressed == EL_FORWARD && !can_go_forward(bar)) bar->pressed = EL_NONE;
+        if (bar->pressed == EL_ADDRESS || bar->pressed == EL_SEARCH)
+        {
+            click(bar, bar->pressed);
+            bar->pressed = EL_NONE;
+            return 0;
+        }
+        if (bar->pressed) SetCapture(hwnd);
+        InvalidateRect(hwnd, NULL, FALSE);
+        return 0;
+    case WM_LBUTTONUP:
+        if (bar->pressed)
+        {
+            int element = bar->pressed;
+            pt.x = (short)LOWORD(lparam);
+            pt.y = (short)HIWORD(lparam);
+            bar->pressed = EL_NONE;
+            ReleaseCapture();
+            InvalidateRect(hwnd, NULL, FALSE);
+            if (hit_test(bar, pt) == element) click(bar, element);
+        }
+        return 0;
+    case WM_CAPTURECHANGED:
+        if (bar->pressed)
+        {
+            bar->pressed = EL_NONE;
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        return 0;
+    case WM_COMMAND:
+        if ((HWND)lparam == bar->search && HIWORD(wparam) == EN_CHANGE) search_changed(bar);
+        return 0;
+    case WM_CTLCOLOREDIT:
+        if ((HWND)lparam == bar->search)
+        {
+            int state = GetFocus() == bar->search ? 3 : (bar->hot == EL_SEARCH || bar->hot == EL_CLEAR) ? 2 : 1;
+            HBRUSH brush = bar->search_brush[state];
+            LOGBRUSH lb;
+            if (brush && GetObjectW(brush, sizeof(lb), &lb))
+            {
+                SetBkColor((HDC)wparam, lb.lbColor);
+                return (LRESULT)brush;
+            }
+        }
+        SetBkMode((HDC)wparam, TRANSPARENT);
+        return (LRESULT)GetSysColorBrush(COLOR_WINDOW);
+    case WM_USER:  /* the address edit box lost the focus */
+        if (GetFocus() != bar->edit) stop_editing(bar);
+        return 0;
+    case WM_THEMECHANGED:
+        navbar7_reload_theme(hwnd);
+        return 0;
+    case WM_NCDESTROY:
+        if (bar)
+        {
+            int i;
+            CloseThemeData(bar->nav); CloseThemeData(bar->bb); CloseThemeData(bar->go);
+            CloseThemeData(bar->ab); CloseThemeData(bar->sb); CloseThemeData(bar->rebar);
+            DeleteObject(bar->icons); DeleteObject(bar->magnifier);
+            for (i = 0; i < 3; i++) DeleteObject(bar->clear[i]);
+            if (bar->current_icon) DestroyIcon(bar->current_icon);
+            free_crumbs(bar);
+            for (i = 0; i < bar->history_count; i++) ILFree(bar->history[i]);
+            free(bar->history);
+            ILFree(bar->current);
+            free(bar->filter);
+            if (bar->browser) IExplorerBrowser_Release(bar->browser);
+            if (bar->ef) FreeLibrary(bar->ef);
+            DeleteObject(bar->font);
+            DeleteObject(bar->cue_font);
+            for (i = 1; i <= 3; i++) DeleteObject(bar->search_brush[i]);
+            free(bar->cue);
+            free(bar);
+        }
+        break;
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+void navbar7_reload_theme(HWND hwnd)
+{
+    struct navbar *bar = (struct navbar *)GetWindowLongPtrW(hwnd, 0);
+
+    CloseThemeData(bar->nav); CloseThemeData(bar->bb); CloseThemeData(bar->go);
+    CloseThemeData(bar->ab); CloseThemeData(bar->sb); CloseThemeData(bar->rebar);
+    bar->nav = OpenThemeData(hwnd, L"Navigation");
+    bar->bb = OpenThemeData(NULL, L"BB::Toolbar");
+    bar->go = OpenThemeData(NULL, L"Go::Toolbar");
+    bar->ab = OpenThemeData(NULL, L"AB::AddressBand");
+    bar->sb = OpenThemeData(NULL, L"SearchBox");
+    bar->rebar = OpenThemeData(NULL, L"Navbar::Rebar");
+    update_search_brushes(bar);
+    InvalidateRect(hwnd, NULL, TRUE);
+}
+
+/* the message font, which Windows 7's dialogs and Explorer use */
+HFONT navbar7_message_font(UINT dpi)
+{
+    NONCLIENTMETRICSW metrics = { sizeof(metrics) };
+
+    if (!SystemParametersInfoForDpi(SPI_GETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0, dpi)) return NULL;
+    return CreateFontIndirectW(&metrics.lfMessageFont);
+}
+
+int navbar7_height(HWND parent)
+{
+    return MulDiv(35, GetDpiForWindow(parent), USER_DEFAULT_SCREEN_DPI);
+}
+
+HWND navbar7_create(HWND parent, UINT id, IExplorerBrowser *browser)
+{
+    static const WCHAR class_name[] = L"Win4WineNavigationBar";
+    WNDCLASSW wc = { CS_DBLCLKS, navbar_proc, 0, sizeof(void *), COMDLG32_hInstance, NULL, NULL, NULL, NULL, class_name };
+    struct navbar *bar;
+    int i;
+
+    RegisterClassW(&wc);
+    if (!(bar = calloc(1, sizeof(*bar)))) return NULL;
+    bar->parent = parent;
+    bar->dpi = GetDpiForWindow(parent);
+    bar->IFolderFilter_iface.lpVtbl = &filter_vtbl;
+    if ((bar->browser = browser)) IExplorerBrowser_AddRef(browser);
+    /* Windows 7's explorerframe.dll, when there is one, for its images and strings */
+    bar->ef = LoadLibraryExW(L"explorerframe.dll", NULL, 0);
+    bar->icons = load_bitmap(bar->ef, EF_BMP_ICONS);
+    bar->magnifier = load_bitmap(bar->ef, EF_BMP_SEARCH);
+    for (i = 0; i < 3; i++) bar->clear[i] = load_bitmap(bar->ef, EF_BMP_CLEAR + 6 * i);
+    bar->font = navbar7_message_font(bar->dpi);
+    {
+        LOGFONTW lf;
+        if (GetObjectW(bar->font, sizeof(lf), &lf))
+        {
+            lf.lfItalic = TRUE;
+            bar->cue_font = CreateFontIndirectW(&lf);
+        }
+    }
+
+    bar->hwnd = CreateWindowExW(0, class_name, NULL, WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN, 0, 0, 0, 0,
+                                parent, (HMENU)(UINT_PTR)id, COMDLG32_hInstance, bar);
+    if (!bar->hwnd) return NULL;
+    navbar7_reload_theme(bar->hwnd);
+    bar->edit = CreateWindowExW(0, WC_EDITW, NULL, WS_CHILD | ES_AUTOHSCROLL, 0, 0, 0, 0,
+                                bar->hwnd, NULL, COMDLG32_hInstance, NULL);
+    bar->search = CreateWindowExW(0, WC_EDITW, NULL, WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL,
+                                  0, 0, 0, 0, bar->hwnd, NULL, COMDLG32_hInstance, NULL);
+    for (i = 0; i < 2; i++)
+    {
+        HWND edit = i ? bar->search : bar->edit;
+        SendMessageW(edit, WM_SETFONT, (WPARAM)bar->font, FALSE);
+        SetWindowSubclass(edit, edit_subclass, 0, (DWORD_PTR)bar);
+    }
+    layout(bar);
+    return bar->hwnd;
+}
+
+void navbar7_set_folder(HWND hwnd, PCIDLIST_ABSOLUTE pidl)
+{
+    struct navbar *bar = (struct navbar *)GetWindowLongPtrW(hwnd, 0);
+    if (bar && pidl) set_folder(bar, pidl);
+}
