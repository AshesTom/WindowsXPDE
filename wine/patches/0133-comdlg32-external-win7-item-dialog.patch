+static int text_width(HWND hwnd)
+{
+    WCHAR text[256];
+    SIZE size = {0};
+    HFONT font;
+    HDC hdc;
+
+    GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+    hdc = GetDC(hwnd);
+    font = SelectObject(hdc, (HFONT)SendMessageW(hwnd, WM_GETFONT, 0, 0));
+    GetTextExtentPoint32W(hdc, text, lstrlenW(text), &size);
+    SelectObject(hdc, font);
+    ReleaseDC(hwnd, hdc);
+    return size.cx;
