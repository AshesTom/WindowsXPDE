+/* win4wine: Windows 7's dialog shows the navigation pane only (no details or preview pane,
+ * nor their buttons) */
+static HRESULT WINAPI pane_visibility_QueryInterface(IExplorerPaneVisibility *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IExplorerPaneVisibility))
+    {
+        *ppv = iface;
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pane_visibility_AddRef(IExplorerPaneVisibility *iface) { return 2; }
+static ULONG WINAPI pane_visibility_Release(IExplorerPaneVisibility *iface) { return 1; }
+
+static HRESULT WINAPI pane_visibility_GetPaneState(IExplorerPaneVisibility *iface, REFEXPLORERPANE pane,
+                                                   EXPLORERPANESTATE *state)
+{
+    if(IsEqualGUID(pane, &EP_DetailsPane) || IsEqualGUID(pane, &EP_PreviewPane))
+        *state = EPS_DEFAULT_OFF | EPS_FORCE;
+    else
+        *state = EPS_DONTCARE;
+    return S_OK;
+}
+
+static const IExplorerPaneVisibilityVtbl vt_pane_visibility = {
+    pane_visibility_QueryInterface,
+    pane_visibility_AddRef,
+    pane_visibility_Release,
+    pane_visibility_GetPaneState
+};
+
