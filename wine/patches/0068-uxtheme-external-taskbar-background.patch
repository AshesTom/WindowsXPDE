From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: paint themed backgrounds for the external taskbar's children

Purpose: show the Luna taskbar behind its native child windows, and the
notification area's background behind its icons.
XP behavior: the taskbar's descendants fill their buffers with
DrawThemeParentBackground. IsThemeBackgroundPartiallyTransparent is TRUE
for a part whose BgType is None, such as part 0 of the TrayNotify toolbar,
and the notification area's double-buffered toolbar then fills its buffer
from its parent.
Wine before: their custom parents erase with the classic face and give no
themed WM_PRINTCLIENT output, so grey covered the tray's background. Parts
of BgType None were reported opaque, so the notification toolbar skipped
its parent's background and showed black behind the icons.
Change: for descendants of Shell_TrayWnd with themes active, draw the
Taskbar part at the ancestor's coordinates, keeping the caller's clip and
viewport; for descendants of TrayNotifyWnd, draw its TrayNotify background
under the theme that window selected. Report BgType None as partially
transparent. Other windows keep the parent message painting.
Evidence: tests/taskbar-background.c compares translated child rendering
with a direct DrawThemeBackground of the user's theme. On XP and on Wine,
tests/theme-part-pixels.c prints partial=1 for Toolbar under TrayNotify,
part 0. tests/notify-icon.c compares a transparent notification icon's
button with the TrayNotify background.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0016.
---
 dlls/uxtheme/draw.c | 59 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 59 insertions(+)

diff --git a/dlls/uxtheme/draw.c b/dlls/uxtheme/draw.c
index c04f166..1645c5c 100644
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -95,6 +95,61 @@ BOOL WINAPI IsThemeDialogTextureEnabled(HWND hwnd)
     return dwDialogTextureFlags && !(dwDialogTextureFlags & ETDT_DISABLE);
 }
 
+/* Native XP taskbar descendants erase with the classic face colour even
+ * though the tray itself paints its active theme. Use the same Taskbar part
+ * at the ancestor's coordinates in this explicitly selected shell, and inside
+ * the notification area its own TrayNotify background. */
+static BOOL external_shell_taskbar_background(HWND hwnd, HDC dc, const RECT *clip)
+{
+    HWND tray = hwnd, notify = NULL;
+    WCHAR name[64];
+    RECT rect, screen;
+    HTHEME theme;
+    int part, saved;
+    HRESULT result;
+
+    if (!win4wine_external_shell() || !IsThemeActive()) return FALSE;
+    while (tray)
+    {
+        if (GetClassNameW(tray, name, ARRAY_SIZE(name)))
+        {
+            if (!wcsicmp(name, L"Shell_TrayWnd")) break;
+            if (!notify && !wcsicmp(name, L"TrayNotifyWnd")) notify = tray;
+        }
+        tray = GetParent(tray);
+    }
+    if (!tray) return FALSE;
+    if (notify)
+    {
+        /* Under the theme the notification area selected for itself
+         * (TrayNotifyHoriz or TrayNotifyVert). */
+        theme = OpenThemeDataForDpi(notify, L"TrayNotify", GetDpiForWindow(notify));
+        if (!theme) return FALSE;
+        part = TNP_BACKGROUND;
+        GetClientRect(notify, &rect);
+        MapWindowPoints(notify, hwnd, (POINT *)&rect, 2);
+    }
+    else
+    {
+        theme = OpenThemeDataForDpi(NULL, L"Taskbar", GetDpiForWindow(tray));
+        if (!theme) return FALSE;
+        GetWindowRect(tray, &screen);
+        if (screen.right - screen.left >= screen.bottom - screen.top)
+            part = screen.top < GetSystemMetrics(SM_CYSCREEN) / 2 ? TBP_BACKGROUNDTOP : TBP_BACKGROUNDBOTTOM;
+        else
+            part = screen.left < GetSystemMetrics(SM_CXSCREEN) / 2 ? TBP_BACKGROUNDLEFT : TBP_BACKGROUNDRIGHT;
+        GetClientRect(tray, &rect);
+        MapWindowPoints(tray, hwnd, (POINT *)&rect, 2);
+    }
+    saved = SaveDC(dc);
+    if (!saved) { CloseThemeData(theme); return FALSE; }
+    if (clip) IntersectClipRect(dc, clip->left, clip->top, clip->right, clip->bottom);
+    result = DrawThemeBackground(theme, dc, part, 0, &rect, NULL);
+    RestoreDC(dc, saved);
+    CloseThemeData(theme);
+    return SUCCEEDED(result);
+}
+
 /***********************************************************************
  *      DrawThemeParentBackground                           (UXTHEME.@)
  */
@@ -107,6 +162,7 @@ HRESULT WINAPI DrawThemeParentBackground(HWND hwnd, HDC hdc, RECT *prc)
     int hasClip = -1;
     
     TRACE("(%p,%p,%p)\n", hwnd, hdc, prc);
+    if (external_shell_taskbar_background(hwnd, hdc, prc)) return S_OK;
     hParent = GetParent(hwnd);
     if(!hParent)
         hParent = hwnd;
@@ -2482,6 +2538,9 @@ BOOL WINAPI IsThemeBackgroundPartiallyTransparent(HTHEME hTheme, int iPartId,
 
     GetThemeEnumValue(hTheme, iPartId, iStateId, TMT_BGTYPE, &bgtype);
 
+    /* XP reports a part that draws nothing as see-through, and the XP
+     * notification area's toolbar then fills its buffer from its parent. */
+    if (bgtype == BT_NONE && win4wine_external_shell()) return TRUE;
     if (bgtype != BT_IMAGEFILE) return FALSE;
 
     if (FAILED(UXTHEME_LoadImage(hTheme, iPartId, iStateId, &rect, FALSE, &bmpSrc, &rcSrc,
