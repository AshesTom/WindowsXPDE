From: Codex <codex@localhost>
Subject: [PATCH] ntdll: keep the read-only attribute of folders for Windows 7's shell

Purpose: keep the localized names of the profile folders' items (Links'
"Recent Places", the Start menu's "Startup") after the first session.
Windows 7 behavior: the known folders Links, Favorites and Desktop are
registered with Attributes 1 (FILE_ATTRIBUTE_READONLY); shell32 sets it
when it initializes them (SHGetKnownFolderPath with KF_FLAG_INIT, which
the shell does in the first session). The shell reads a folder's
desktop.ini, and with it the [LocalizedFileNames] of its items, only when
the folder is read-only or a system folder. A directory's read-only
attribute does not stop writing into it.
Wine before: FILE_ATTRIBUTE_READONLY is ignored for directories, and the
attributes stored in the user.DOSATTRIB extended attribute are only
HIDDEN and SYSTEM; the shell's SetFileAttributes therefore cleared the
system attribute that the prefix gave Links, and Links showed
"RecentPlaces".
Change: with WIN4WINE_SHELL=win7 and the WIN4WINE_EXTERNAL_SHELL opt-in,
a directory's FILE_ATTRIBUTE_READONLY is stored in user.DOSATTRIB (as
Samba stores it) and read back from it; the directory's Unix mode is not
changed, so it stays writable. Files keep their read-only attribute in the
Unix mode as before.
Evidence: SHGetKnownFolderPath(FOLDERID_Links, KF_FLAG_CREATE |
KF_FLAG_INIT) turned Links from 0x14 into 0x10 before; with the change
and 0011 (the shell sets the folder's times afterwards) it is 0x11, as on
Windows 7, and its desktop.ini is read ("Recent Places", "最近表示した場所").
Scope: only in the Windows 7 shell session; elsewhere directories ignore
the attribute as before, and XP and ReactOS sessions behave as before.
---
 dlls/ntdll/unix/file.c | 35 +++++++++++++++++++++++++----------
 1 file changed, 25 insertions(+), 10 deletions(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index e3aa066..ac9e247 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -121,6 +121,7 @@
 #include "wine/server.h"
 #include "wine/list.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 #include "unix_private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(file);
@@ -1639,8 +1640,19 @@ static inline ULONG get_file_attributes( const struct stat *st )
 }
 
 
+/* With the Windows 7 shell, directories keep FILE_ATTRIBUTE_READONLY in the
+ * xattr (as Samba stores it) and stay writable: Windows 7 marks its known
+ * folders read-only (Links, Favorites, Desktop), and its shell reads a
+ * folder's desktop.ini (localized names) only when the folder is read-only
+ * or a system folder. */
+static BOOL keep_directory_readonly( const struct stat *st )
+{
+    return S_ISDIR( st->st_mode ) && win4wine_shell() == WIN4WINE_SHELL_WIN7;
+}
+
+
 /* decode the xattr-stored DOS attributes */
-static int parse_samba_dos_attrib_data( char *data, int len )
+static int parse_samba_dos_attrib_data( char *data, int len, const struct stat *st )
 {
     char *end;
     int val;
@@ -1649,7 +1661,7 @@ static int parse_samba_dos_attrib_data( char *data, int len )
     {
         data[len] = 0;
         val = strtol( data, &end, 16 );
-        if (!*end) return val & XATTR_ATTRIBS_MASK;
+        if (!*end) return val & (XATTR_ATTRIBS_MASK | (keep_directory_readonly( st ) ? FILE_ATTRIBUTE_READONLY : 0));
     }
     else
     {
@@ -1703,7 +1715,7 @@ static int fd_get_file_info( HANDLE handle, int fd, unsigned int options,
 
     attr_len = xattr_fget( fd, SAMBA_XATTR_DOS_ATTRIB, attr_data, sizeof(attr_data)-1 );
     if (attr_len != -1)
-        *attr |= parse_samba_dos_attrib_data( attr_data, attr_len );
+        *attr |= parse_samba_dos_attrib_data( attr_data, attr_len, st );
     else
     {
         if (errno == ENOTSUP) return ret;
@@ -1720,10 +1732,10 @@ static int fd_get_file_info( HANDLE handle, int fd, unsigned int options,
 }
 
 
-static int fd_set_dos_attrib( int fd, UINT attr, BOOL force_set )
+static int fd_set_dos_attrib( int fd, UINT attr, BOOL force_set, BOOL readonly )
 {
-    /* we only store the HIDDEN and SYSTEM attributes */
-    attr &= XATTR_ATTRIBS_MASK;
+    /* we only store the HIDDEN and SYSTEM attributes (and READONLY, see keep_directory_readonly) */
+    attr &= XATTR_ATTRIBS_MASK | (readonly ? FILE_ATTRIBUTE_READONLY : 0);
     if (force_set || attr != 0)
     {
         /* encode the attributes in Samba 3 ASCII format. Samba 4 has extended
@@ -1746,7 +1758,10 @@ static NTSTATUS fd_set_file_info( int fd, UINT attr, BOOL force_set_xattr )
     if (attr & FILE_ATTRIBUTE_READONLY)
     {
         if (S_ISDIR( st.st_mode))
-            WARN("FILE_ATTRIBUTE_READONLY ignored for directory.\n");
+        {
+            if (!keep_directory_readonly( &st ))
+                WARN("FILE_ATTRIBUTE_READONLY ignored for directory.\n");
+        }
         else
             st.st_mode &= ~0222; /* clear write permission bits */
     }
@@ -1761,7 +1776,7 @@ static NTSTATUS fd_set_file_info( int fd, UINT attr, BOOL force_set_xattr )
        set the extended attribute, since any of the names could start with a dot */
     force_set_xattr = force_set_xattr || st.st_nlink > 1;
 
-    if (fd_set_dos_attrib( fd, attr, force_set_xattr ) == -1 && errno != ENOTSUP)
+    if (fd_set_dos_attrib( fd, attr, force_set_xattr, keep_directory_readonly( &st ) ) == -1 && errno != ENOTSUP)
         WARN( "Failed to set extended attribute " SAMBA_XATTR_DOS_ATTRIB ". errno %d (%s)\n",
               errno, strerror( errno ) );
 
@@ -1819,7 +1834,7 @@ static int get_file_info( const char *path, struct stat *st, ULONG *attr, ULONG
 
     attr_len = xattr_get( path, SAMBA_XATTR_DOS_ATTRIB, attr_data, sizeof(attr_data)-1 );
     if (attr_len != -1)
-        *attr |= parse_samba_dos_attrib_data( attr_data, attr_len );
+        *attr |= parse_samba_dos_attrib_data( attr_data, attr_len, st );
     else
     {
         if (is_hidden_file( path ))
@@ -4667,7 +4682,7 @@ NTSTATUS WINAPI NtCreateFile( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBU
             /* set any DOS extended attributes */
             if (!server_get_unix_fd( *handle, 0, &fd, &needs_close, NULL, NULL ))
             {
-                if (fd_set_dos_attrib( fd, attributes, TRUE ) == -1 && errno != ENOTSUP)
+                if (fd_set_dos_attrib( fd, attributes, TRUE, FALSE ) == -1 && errno != ENOTSUP)
                     WARN( "Failed to set extended attribute " SAMBA_XATTR_DOS_ATTRIB ". errno %d (%s)",
                           errno, strerror( errno ) );
                 if (needs_close) close( fd );
