+
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(samlib);
+
+/***********************************************************************
+ *           SamConnect   (SAMLIB.@)
+ */
+NTSTATUS WINAPI SamConnect( UNICODE_STRING *server, HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBUTES *attr )
+{
+    FIXME( "%s %p %#lx %p: no SAM\n", server ? debugstr_wn(server->Buffer, server->Length / sizeof(WCHAR)) : "(null)", handle, access, attr );
+    if (handle) *handle = NULL;
+    return STATUS_ACCESS_DENIED;
+}
+
+/***********************************************************************
+ *           SamCloseHandle   (SAMLIB.@)
+ */
+NTSTATUS WINAPI SamCloseHandle( HANDLE handle )
+{
+    TRACE( "%p\n", handle );
+    return handle ? STATUS_INVALID_HANDLE : STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           SamFreeMemory   (SAMLIB.@)
+ */
+NTSTATUS WINAPI SamFreeMemory( void *buffer )
+{
+    TRACE( "%p\n", buffer );
+    return STATUS_SUCCESS;
+}
