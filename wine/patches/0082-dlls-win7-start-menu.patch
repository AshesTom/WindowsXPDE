diff --git a/dlls/user32/message.c b/dlls/user32/message.c
index 205d3e0..e0b14c0 100644
--- a/dlls/user32/message.c
+++ b/dlls/user32/message.c
@@ -705,11 +705,77 @@ BOOL WINAPI PostThreadMessageA( DWORD thread, UINT msg, WPARAM wparam, LPARAM lp
 }
 
 
+/* Message pump hooks (Windows 7's DirectUser registers one). The hook receives the
+ * functions user32 would use and returns its own, which the message functions then
+ * call: DirectUser runs its deferred work (layout, painting) in them. */
+
+typedef struct
+{
+    DWORD cbSize;
+    BOOL  (WINAPI *internal_get_message)( MSG *msg, HWND hwnd, UINT first, UINT last, UINT flags, BOOL get );
+    BOOL  (WINAPI *wait_message_ex)( DWORD mask, UINT timeout );
+    DWORD (WINAPI *get_queue_status)( UINT flags );
+    DWORD (WINAPI *msg_wait_for_multiple_objects_ex)( DWORD count, const HANDLE *handles, DWORD timeout,
+                                                     DWORD mask, DWORD flags );
+} USER_MESSAGE_PUMP_ADDRESSES;
+
+typedef BOOL (WINAPI *MESSAGEPUMPHOOKPROC)( BOOL unregistering, USER_MESSAGE_PUMP_ADDRESSES *addresses );
+
+static BOOL WINAPI real_internal_get_message( MSG *msg, HWND hwnd, UINT first, UINT last, UINT flags, BOOL get )
+{
+    if (get) return NtUserGetMessage( msg, hwnd, first, last );
+    return NtUserPeekMessage( msg, hwnd, first, last, flags );
+}
+
+static BOOL WINAPI real_wait_message_ex( DWORD mask, UINT timeout )
+{
+    return NtUserMsgWaitForMultipleObjectsEx( 0, NULL, timeout, mask ? mask : QS_ALLINPUT, 0 ) != WAIT_FAILED;
+}
+
+static DWORD WINAPI real_get_queue_status( UINT flags )
+{
+    return NtUserGetQueueStatus( flags );
+}
+
+static DWORD WINAPI real_msg_wait_for_multiple_objects_ex( DWORD count, const HANDLE *handles, DWORD timeout,
+                                                           DWORD mask, DWORD flags )
+{
+    return NtUserMsgWaitForMultipleObjectsEx( count, handles, timeout, mask, flags );
+}
+
+static CRITICAL_SECTION pump_hook_section;
+static CRITICAL_SECTION_DEBUG pump_hook_section_debug =
+{
+    0, 0, &pump_hook_section,
+    { &pump_hook_section_debug.ProcessLocksList, &pump_hook_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": pump_hook_section") }
+};
+static CRITICAL_SECTION pump_hook_section = { &pump_hook_section_debug, -1, 0, 0, 0, 0 };
+static MESSAGEPUMPHOOKPROC pump_hook;
+static USER_MESSAGE_PUMP_ADDRESSES pump_addresses;
+static unsigned int pump_hook_count;
+/* the hook applies to the threads that registered it, once per registration */
+static DWORD pump_hook_tls = TLS_OUT_OF_INDEXES;
+
+static BOOL pump_hooked(void)
+{
+    DWORD error;
+    BOOL ret;
+
+    if (!pump_hook || pump_hook_tls == TLS_OUT_OF_INDEXES) return FALSE;
+    error = GetLastError();
+    ret = TlsGetValue( pump_hook_tls ) != NULL;
+    SetLastError( error );
+    return ret;
+}
+
+
 /***********************************************************************
  *		PeekMessageW  (USER32.@)
  */
 BOOL WINAPI DECLSPEC_HOTPATCH PeekMessageW( MSG *msg_out, HWND hwnd, UINT first, UINT last, UINT flags )
 {
+    if (pump_hooked()) return pump_addresses.internal_get_message( msg_out, hwnd, first, last, flags, FALSE );
     return NtUserPeekMessage( msg_out, hwnd, first, last, flags );
 }
 
@@ -731,10 +797,42 @@ BOOL WINAPI DECLSPEC_HOTPATCH PeekMessageA( MSG *msg, HWND hwnd, UINT first, UIN
  */
 BOOL WINAPI DECLSPEC_HOTPATCH GetMessageW( MSG *msg, HWND hwnd, UINT first, UINT last )
 {
+    if (pump_hooked()) return pump_addresses.internal_get_message( msg, hwnd, first, last, PM_REMOVE, TRUE );
     return NtUserGetMessage( msg, hwnd, first, last );
 }
 
 
+/***********************************************************************
+ *		WaitMessage  (USER32.@)
+ */
+BOOL WINAPI WaitMessage(void)
+{
+    if (pump_hooked()) return pump_addresses.wait_message_ex( QS_ALLINPUT, INFINITE );
+    return NtUserWaitMessage();
+}
+
+
+/***********************************************************************
+ *		GetQueueStatus  (USER32.@)
+ */
+DWORD WINAPI GetQueueStatus( UINT flags )
+{
+    if (pump_hooked()) return pump_addresses.get_queue_status( flags );
+    return NtUserGetQueueStatus( flags );
+}
+
+
+/***********************************************************************
+ *		MsgWaitForMultipleObjectsEx  (USER32.@)
+ */
+DWORD WINAPI MsgWaitForMultipleObjectsEx( DWORD count, const HANDLE *handles, DWORD timeout,
+                                          DWORD mask, DWORD flags )
+{
+    if (pump_hooked()) return pump_addresses.msg_wait_for_multiple_objects_ex( count, handles, timeout, mask, flags );
+    return NtUserMsgWaitForMultipleObjectsEx( count, handles, timeout, mask, flags );
+}
+
+
 /***********************************************************************
  *		GetMessageA  (USER32.@)
  */
@@ -971,8 +1069,7 @@ LPARAM WINAPI SetMessageExtraInfo(LPARAM lParam)
 DWORD WINAPI MsgWaitForMultipleObjects( DWORD count, const HANDLE *handles,
                                         BOOL wait_all, DWORD timeout, DWORD mask )
 {
-    return NtUserMsgWaitForMultipleObjectsEx( count, handles, timeout, mask,
-                                              wait_all ? MWMO_WAITALL : 0 );
+    return MsgWaitForMultipleObjectsEx( count, handles, timeout, mask, wait_all ? MWMO_WAITALL : 0 );
 }
 
 
@@ -1258,3 +1355,96 @@ BOOL WINAPI ChangeWindowMessageFilterEx( HWND hwnd, UINT message, DWORD action,
     FIXME( "%p %x %ld %p\n", hwnd, message, action, changefilter );
     return TRUE;
 }
+
+
+
+static void reset_pump_addresses( USER_MESSAGE_PUMP_ADDRESSES *addresses )
+{
+    addresses->cbSize = sizeof(*addresses);
+    addresses->internal_get_message = real_internal_get_message;
+    addresses->wait_message_ex = real_wait_message_ex;
+    addresses->get_queue_status = real_get_queue_status;
+    addresses->msg_wait_for_multiple_objects_ex = real_msg_wait_for_multiple_objects_ex;
+}
+
+/***********************************************************************
+ *		RegisterMessagePumpHook (USER32.@)
+ */
+BOOL WINAPI RegisterMessagePumpHook( MESSAGEPUMPHOOKPROC hook )
+{
+    BOOL ret = FALSE;
+
+    TRACE( "%p\n", hook );
+
+    if (!hook)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    EnterCriticalSection( &pump_hook_section );
+    if (!pump_hook_count)
+    {
+        USER_MESSAGE_PUMP_ADDRESSES addresses;
+
+        reset_pump_addresses( &addresses );
+        if (hook( FALSE, &addresses ) && addresses.cbSize)
+        {
+            USER_MESSAGE_PUMP_ADDRESSES real;
+
+            reset_pump_addresses( &real );
+            TRACE( "size %lu, get %p, wait %p, status %p, wait objects %p\n", addresses.cbSize,
+                   addresses.internal_get_message, addresses.wait_message_ex, addresses.get_queue_status,
+                   addresses.msg_wait_for_multiple_objects_ex );
+            /* the hook leaves the functions it does not replace empty */
+            pump_addresses = real;
+            if (addresses.internal_get_message) pump_addresses.internal_get_message = addresses.internal_get_message;
+            if (addresses.wait_message_ex) pump_addresses.wait_message_ex = addresses.wait_message_ex;
+            if (addresses.get_queue_status) pump_addresses.get_queue_status = addresses.get_queue_status;
+            if (addresses.msg_wait_for_multiple_objects_ex)
+                pump_addresses.msg_wait_for_multiple_objects_ex = addresses.msg_wait_for_multiple_objects_ex;
+            pump_hook = hook;
+            pump_hook_count = 1;
+            ret = TRUE;
+        }
+    }
+    else if (pump_hook == hook)
+    {
+        pump_hook_count++;
+        ret = TRUE;
+    }
+    if (ret)
+    {
+        if (pump_hook_tls == TLS_OUT_OF_INDEXES) pump_hook_tls = TlsAlloc();
+        if (pump_hook_tls != TLS_OUT_OF_INDEXES)
+            TlsSetValue( pump_hook_tls, (void *)((UINT_PTR)TlsGetValue( pump_hook_tls ) + 1) );
+    }
+    LeaveCriticalSection( &pump_hook_section );
+    return ret;
+}
+
+/***********************************************************************
+ *		UnregisterMessagePumpHook (USER32.@)
+ */
+BOOL WINAPI UnregisterMessagePumpHook(void)
+{
+    BOOL ret = FALSE;
+
+    TRACE( "\n" );
+
+    EnterCriticalSection( &pump_hook_section );
+    if (pump_hook_count)
+    {
+        UINT_PTR count = pump_hook_tls != TLS_OUT_OF_INDEXES ? (UINT_PTR)TlsGetValue( pump_hook_tls ) : 0;
+
+        if (count) TlsSetValue( pump_hook_tls, (void *)(count - 1) );
+        if (!--pump_hook_count)
+        {
+            pump_hook( TRUE, NULL );
+            reset_pump_addresses( &pump_addresses );
+            pump_hook = NULL;
+        }
+        ret = TRUE;
+    }
+    LeaveCriticalSection( &pump_hook_section );
+    return ret;
+}
