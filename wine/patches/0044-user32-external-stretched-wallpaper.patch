From: Codex <codex@localhost>
Subject: [PATCH] user32: paint the external shell's stretched wallpaper

Purpose: show XP's default desktop, Bliss stretched over the screen, and
ReactOS's, its wallpaper filling the screen.
XP behavior: explorer paints its desktop with PaintDesktop in its own
process; WallpaperStyle 2 stretches the picture. ReactOS's PaintDesktop
(win32ss/user/ntuser/desktop.c) also fits (6) and fills (10, its default):
scaled by the width or the height, centred, and cropped for fill.
Wine before: the wallpaper bitmap was loaded only in the desktop thread's
process, so the XP desktop showed the plain background colour.
Change: load the configured wallpaper in the painting process when the
setting changes, and stretch it with HALFTONE for WallpaperStyle 2, 6 and
10 as above. Tiled and centred wallpapers keep the existing code. The JPEG is converted to
Wallpaper1.bmp beforehand, as XP does, by prefix/wallpaper-convert.c.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0056.
---
 dlls/user32/desktop.c | 64 ++++++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 61 insertions(+), 3 deletions(-)

diff --git a/dlls/user32/desktop.c b/dlls/user32/desktop.c
index 35cf39b..c7ebad1 100644
--- a/dlls/user32/desktop.c
+++ b/dlls/user32/desktop.c
@@ -27,11 +27,14 @@
 #include "wingdi.h"
 #include "winnls.h"
 #include "controls.h"
+#include "wine/win4wine.h"
 
 static HBRUSH hbrushPattern;
 static HBITMAP hbitmapWallPaper;
 static SIZE bitmapSize;
 static BOOL fTileWallPaper;
+static int scaled_wallpaper;
+static WCHAR loaded_wallpaper[MAX_PATH];
 
 
 /***********************************************************************
@@ -70,7 +73,17 @@ static void init_wallpaper( const WCHAR *wallpaper )
 	bitmapSize.cx = (bmp.bmWidth != 0) ? bmp.bmWidth : 1;
 	bitmapSize.cy = (bmp.bmHeight != 0) ? bmp.bmHeight : 1;
         fTileWallPaper = GetProfileIntA( "desktop", "TileWallPaper", 0 );
+        /* WallpaperStyle 2 stretches the picture over the whole desktop,
+         * XP's setting for its default wallpaper; 6 fits it in and 10 fills
+         * the desktop with it, cropped (ReactOS's default). */
+        scaled_wallpaper = 0;
+        if (win4wine_external_shell() && !fTileWallPaper)
+        {
+            int style = GetProfileIntA( "desktop", "WallpaperStyle", 0 );
+            if (style == 2 || style == 6 || style == 10) scaled_wallpaper = style;
+        }
     }
+    lstrcpynW( loaded_wallpaper, wallpaper, MAX_PATH );
 }
 
 /***********************************************************************
@@ -126,12 +139,23 @@ BOOL WINAPI PaintDesktop(HDC hdc)
     {
         RECT rect;
 
+        /* The XP shell paints its desktop in its own process, where the
+         * desktop thread's wallpaper bitmap is not loaded. */
+        if (win4wine_external_shell())
+        {
+            WCHAR wallpaper[MAX_PATH];
+            if (SystemParametersInfoW( SPI_GETDESKWALLPAPER, MAX_PATH, wallpaper, 0 ) &&
+                wcscmp( wallpaper, loaded_wallpaper ))
+                init_wallpaper( wallpaper );
+        }
+
         GetClientRect( hwnd, &rect );
 
         /* Paint desktop pattern (only if wall paper does not cover everything) */
 
-        if (!hbitmapWallPaper ||
-            (!fTileWallPaper && ((bitmapSize.cx < rect.right) || (bitmapSize.cy < rect.bottom))))
+        if (!hbitmapWallPaper || scaled_wallpaper == 6 ||
+            (!fTileWallPaper && !scaled_wallpaper &&
+             ((bitmapSize.cx < rect.right) || (bitmapSize.cy < rect.bottom))))
         {
             HBRUSH brush = hbrushPattern;
             if (!brush) brush = (HBRUSH)GetClassLongPtrW( hwnd, GCLP_HBRBACKGROUND );
@@ -150,7 +174,41 @@ BOOL WINAPI PaintDesktop(HDC hdc)
 
             SelectObject( hMemDC, hbitmapWallPaper );
 
-            if (fTileWallPaper)
+            if (scaled_wallpaper)
+            {
+                int mode = SetStretchBltMode( hdc, HALFTONE );
+                int dst_x = 0, dst_y = 0, dst_cx = rect.right, dst_cy = rect.bottom;
+                int src_x = 0, src_y = 0, src_cx = bitmapSize.cx, src_cy = bitmapSize.cy;
+                POINT origin;
+                if (scaled_wallpaper != 2 && rect.right && rect.bottom)
+                {
+                    /* Scale by the width when the desktop is relatively wider,
+                     * for fill, or narrower, for fit (as ReactOS does). */
+                    BOOL wider = (LONGLONG)rect.right * bitmapSize.cy > (LONGLONG)rect.bottom * bitmapSize.cx;
+                    BOOL by_width = (scaled_wallpaper == 10) == wider;
+                    int num = by_width ? rect.right : rect.bottom, den = by_width ? bitmapSize.cx : bitmapSize.cy;
+                    int width = MulDiv( bitmapSize.cx, num, den ), height = MulDiv( bitmapSize.cy, num, den );
+                    if (scaled_wallpaper == 6)
+                    {
+                        dst_x = (rect.right - width) / 2;
+                        dst_y = (rect.bottom - height) / 2;
+                        dst_cx = width;
+                        dst_cy = height;
+                    }
+                    else
+                    {
+                        src_x = (width - rect.right) * bitmapSize.cx / (2 * width);
+                        src_y = (height - rect.bottom) * bitmapSize.cy / (2 * height);
+                        src_cx = rect.right * bitmapSize.cx / width;
+                        src_cy = rect.bottom * bitmapSize.cy / height;
+                    }
+                }
+                SetBrushOrgEx( hdc, 0, 0, &origin );
+                StretchBlt( hdc, dst_x, dst_y, dst_cx, dst_cy, hMemDC, src_x, src_y, src_cx, src_cy, SRCCOPY );
+                SetBrushOrgEx( hdc, origin.x, origin.y, NULL );
+                SetStretchBltMode( hdc, mode );
+            }
+            else if (fTileWallPaper)
             {
                 for (y = 0; y < rect.bottom; y += bitmapSize.cy)
                     for (x = 0; x < rect.right; x += bitmapSize.cx)
