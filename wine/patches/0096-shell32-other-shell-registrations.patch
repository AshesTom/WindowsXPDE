From: Codex <codex@localhost>
Subject: [PATCH] shell32: leave out what only another shell's registrations name

Purpose: keep Wine's shell views and file dialogs tidy in a prefix that
also holds Windows 7's shell registrations (32-bit and 64-bit programs
keep Wine's shell32 there).
Windows behavior: the desktop folder lists the namespace extensions of
Explorer\Desktop\NameSpace whose classes it can create; an item is named
by its class's LocalizedString, a string of the shell's own DLL.
Wine before: every registered extension was listed, also Windows 7's
libraries, user folders, Control Panel and its command object, whose
classes Wine's shell32 does not have (they could not be opened, and
showed their untranslated registry names: "UsersLibraries"). When a
LocalizedString named a string that Wine's shell32 lacks (Windows 7's
shell32.dll,-9216 for Computer, -9227 for Documents), the untranslated
default value ("My Documents") was shown instead of Wine's own name.
Change: a namespace extension is listed only when its server DLL exists
and, for one served by shell32.dll or by no DLL, when this shell32 can
create its class. Desktop, Computer, Documents and the Recycle Bin fall
back to shell32's own translated names when their LocalizedString cannot
be loaded.
Evidence: in a Windows 7 shell prefix, the open dialogs of 32-bit and
64-bit programs list /, マイ コンピューター and ごみ箱 on the desktop, as
in an XP prefix, instead of eleven items; Notepad's places bar shows
Wine's "Documents".
Scope: shell32's desktop enumeration and class names; prefixes without
other registrations list the same items as before.
---
 dlls/shell32/classes.c        | 38 ++++++++++++++++++++++----------------
 dlls/shell32/shfldr_desktop.c | 32 +++++++++++++++++++++++++++++++-
 2 files changed, 53 insertions(+), 17 deletions(-)

diff --git a/dlls/shell32/classes.c b/dlls/shell32/classes.c
index 399dbf5..31ea5b2 100644
--- a/dlls/shell32/classes.c
+++ b/dlls/shell32/classes.c
@@ -307,6 +307,16 @@ BOOL HCR_GetDefaultIconA(LPCSTR szClass, LPSTR szDest, DWORD len, int* picon_idx
 	return ret;
 }
 
+/* The string of this shell32 that names a shell item of its own, or 0 */
+static UINT own_name_id(REFIID riid)
+{
+    if (IsEqualIID(riid, &CLSID_ShellDesktop)) return IDS_DESKTOP;
+    if (IsEqualIID(riid, &CLSID_MyComputer)) return IDS_MYCOMPUTER;
+    if (IsEqualIID(riid, &CLSID_MyDocuments)) return IDS_PERSONAL;
+    if (IsEqualIID(riid, &CLSID_RecycleBin)) return IDS_RECYCLEBIN_FOLDER_NAME;
+    return 0;
+}
+
 /***************************************************************************************
 *	HCR_GetClassName	[internal]
 *
@@ -321,26 +331,22 @@ BOOL HCR_GetClassNameW(REFIID riid, LPWSTR szDest, DWORD len)
  	szDest[0] = 0;
 	if (HCR_RegOpenClassIDKey(riid, &hkey))
 	{
-          if (!RegLoadMUIStringW(hkey, L"LocalizedString", szDest, buflen, NULL, 0, NULL) ||
-              !RegQueryValueExW(hkey, L"", 0, NULL, (LPBYTE)szDest, &buflen))
-          {
-	    ret = TRUE;
-	  }
+          if (!RegLoadMUIStringW(hkey, L"LocalizedString", szDest, buflen, NULL, 0, NULL))
+            ret = TRUE;
+          /* A name that only another shell's DLL has (Windows 7's shell32.dll,-9216
+           * for Computer, in a prefix for that shell) gives way to this shell32's
+           * own translated name below, not to the untranslated default value. */
+          else if (own_name_id(riid) && !RegQueryValueExW(hkey, L"LocalizedString", 0, NULL, NULL, NULL))
+            szDest[0] = 0;
+          else if (!RegQueryValueExW(hkey, L"", 0, NULL, (LPBYTE)szDest, &buflen))
+            ret = TRUE;
 	  RegCloseKey(hkey);
 	}
 
-	if (!ret || !szDest[0])
+	if ((!ret || !szDest[0]) && own_name_id(riid))
 	{
-	  if(IsEqualIID(riid, &CLSID_ShellDesktop))
-	  {
-	    if (LoadStringW(shell32_hInstance, IDS_DESKTOP, szDest, len))
-	      ret = TRUE;
-	  }
-	  else if (IsEqualIID(riid, &CLSID_MyComputer))
-	  {
-	    if(LoadStringW(shell32_hInstance, IDS_MYCOMPUTER, szDest, len))
-	      ret = TRUE;
-	  }
+	  if (LoadStringW(shell32_hInstance, own_name_id(riid), szDest, len))
+	    ret = TRUE;
 	}
 	TRACE("-- %s\n", debugstr_w(szDest));
 	return ret;
diff --git a/dlls/shell32/shfldr_desktop.c b/dlls/shell32/shfldr_desktop.c
index 49de36a..7d26f3f 100644
--- a/dlls/shell32/shfldr_desktop.c
+++ b/dlls/shell32/shfldr_desktop.c
@@ -275,6 +275,36 @@ static HRESULT WINAPI ISF_Desktop_fnParseDisplayName (IShellFolder2 * iface,
     return hr;
 }
 
+/* Whether the class of a namespace extension can be created: its server DLL
+ * exists, and a class served by shell32.dll (or without a server, as command
+ * objects are) is one that this shell32 has. Another shell's registrations
+ * (Windows 7's libraries, user folders or Control Panel command object, kept
+ * in a prefix for that shell) would otherwise list items that cannot open. */
+static BOOL namespace_class_available(const WCHAR *guid)
+{
+    WCHAR key[80], server[MAX_PATH], path[MAX_PATH];
+    DWORD size = sizeof(server);
+    IClassFactory *factory;
+    CLSID clsid;
+    const WCHAR *name;
+
+    swprintf(key, ARRAY_SIZE(key), L"CLSID\\%s\\InprocServer32", guid);
+    if (RegGetValueW(HKEY_CLASSES_ROOT, key, NULL, RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, NULL,
+                     server, &size))
+        server[0] = 0;
+    name = PathFindFileNameW(server);
+    if (!server[0] || !wcsicmp(name, L"shell32.dll") || !wcsicmp(name, L"shell32"))
+    {
+        if (FAILED(CLSIDFromString(guid, &clsid)) ||
+            FAILED(DllGetClassObject(&clsid, &IID_IClassFactory, (void **)&factory)))
+            return FALSE;
+        IClassFactory_Release(factory);
+        return TRUE;
+    }
+    if (!ExpandEnvironmentStringsW(server, path, ARRAY_SIZE(path))) return TRUE;
+    return SearchPathW(NULL, path, L".dll", ARRAY_SIZE(server), server, NULL) != 0;
+}
+
 static void add_shell_namespace_extensions(IEnumIDListImpl *list, HKEY root)
 {
     WCHAR guid[39], clsidkeyW[60];
@@ -294,7 +324,7 @@ static void add_shell_namespace_extensions(IEnumIDListImpl *list, HKEY root)
         RegGetValueW(HKEY_CLASSES_ROOT, clsidkeyW, L"Attributes", RRF_RT_REG_DWORD | RRF_ZEROONFAILURE,
             NULL, &attributes, &value_size);
 
-        if (!(attributes & SFGAO_NONENUMERATED))
+        if (!(attributes & SFGAO_NONENUMERATED) && namespace_class_available(guid))
             AddToEnumList(list, _ILCreateGuidFromStrW(guid));
         size = ARRAY_SIZE(guid);
     }
