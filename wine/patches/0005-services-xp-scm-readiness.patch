From: Codex <codex@localhost>
Subject: [PATCH] services: signal the SCM readiness event awaited by XP explorer

Purpose: publish SCM readiness after the Wine service database and RPC start.
XP behavior: native explorer waits for Global\ScmCreatedEvent before desktop creation.
Observed with WINEDEBUG=+relay: explorer creates an unsignaled event and waits
for 60000 ms although the Wine service manager is already running.
Retain the event until services exit so later explorer restarts see readiness.
Derived from public API execution logs and Wine source, without disassembly.

diff --git a/programs/services/services.c b/programs/services/services.c
index d686dd3..71d21ea 100644
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -1277,7 +1277,7 @@ int __cdecl main(int argc, char *argv[])
     static const WCHAR svcctl_started_event[] = SVCCTL_STARTED_EVENT;
     JOBOBJECT_EXTENDED_LIMIT_INFORMATION job_limit;
     JOBOBJECT_ASSOCIATE_COMPLETION_PORT port_info;
-    HANDLE started_event, process_monitor_thread;
+    HANDLE started_event, process_monitor_thread, scm_created_event = NULL;
     DWORD err;
 
     job_object = CreateJobObjectW(NULL, NULL);
@@ -1316,6 +1316,9 @@ int __cdecl main(int argc, char *argv[])
         scmdatabase_autostart_services(active_database);
         process_monitor_thread = CreateThread(NULL, 0, process_monitor_thread_proc, NULL, 0, NULL);
         SetEvent(started_event);
+        /* Native XP explorer waits for SCM readiness before creating its desktop. */
+        scm_created_event = CreateEventW(NULL, TRUE, TRUE, L"Global\\ScmCreatedEvent");
+        if (scm_created_event) SetEvent(scm_created_event);
         WaitForSingleObject(exit_event, INFINITE);
         PostQueuedCompletionStatus(job_completion_port, 0, 0, NULL);
         WaitForSingleObject(process_monitor_thread, INFINITE);
@@ -1327,6 +1330,7 @@ int __cdecl main(int argc, char *argv[])
         }
         RPC_Stop();
     }
+    if (scm_created_event) CloseHandle(scm_created_event);
     scmdatabase_destroy(active_database);
     if (environment)
         DestroyEnvironmentBlock(environment);
