diff --git a/dlls/uxtheme/window.c b/dlls/uxtheme/window.c
index d059a85..15af1cd 100644
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -26,6 +26,29 @@
 #include "winuser.h"
 #include "uxthemedll.h"
 #include "vssym32.h"
+#include "wine/win4wine.h"
+
+static void themed_caption_geometry(HWND hwnd, HTHEME theme, RECT *caption, RECT buttons[3]);
+
+/* Whether the caption is drawn active: as WM_NCACTIVATE last set it, as for
+ * the classic caption (DefWindowProc's WM_ISACTIVEICON reports that state).
+ * A window may look active without being the foreground window, such as a
+ * native client's frame, whose client has the keyboard instead. */
+static BOOL caption_active(HWND hwnd)
+{
+    return DefWindowProcW(hwnd, WM_ISACTIVEICON, 0, 0) != 0;
+}
+
+static int caption_button_state(HWND hwnd, HTHEME theme, int part, int state)
+{
+    int count;
+    /* Luna supplies an inactive group after its four standard button images.
+     * Leave themes with only the documented normal/hot/pressed/disabled group alone. */
+    if (!caption_active(hwnd) &&
+        SUCCEEDED(GetThemeInt(theme, part, state, TMT_IMAGECOUNT, &count)) && count >= 8)
+        state += 4;
+    return state;
+}
 
 static void uxtheme_draw_menu_button(HTHEME theme, HWND hwnd, HDC hdc, enum NONCLIENT_BUTTON_TYPE type,
                                      RECT rect, BOOL down, BOOL grayed)
@@ -78,6 +101,35 @@ void WINAPI UXTHEME_NonClientButtonDraw(HWND hwnd, HDC hdc, enum NONCLIENT_BUTTO
 
     switch (type)
     {
+    case CAPTION_CLOSE_BUTTON:
+    case CAPTION_MIN_BUTTON:
+    case CAPTION_MAX_BUTTON:
+    case CAPTION_RESTORE_BUTTON:
+    {
+        RECT caption, buttons[3];
+        POINT cursor;
+        int part, hit, expected, index, state;
+        if (!win4wine_external_shell())
+        {
+            user_api.pNonClientButtonDraw(hwnd, hdc, type, rect, down, grayed);
+            break;
+        }
+        themed_caption_geometry(hwnd, theme, &caption, buttons);
+        if (type == CAPTION_CLOSE_BUTTON) { part = WP_CLOSEBUTTON; expected = HTCLOSE; index = 0; }
+        else if (type == CAPTION_MIN_BUTTON) { part = WP_MINBUTTON; expected = HTMINBUTTON; index = 2; }
+        else
+        {
+            part = type == CAPTION_RESTORE_BUTTON || GetPropW(hwnd, L"Win4WineMaximized")
+                ? WP_RESTOREBUTTON : WP_MAXBUTTON;
+            expected = HTMAXBUTTON; index = 1;
+        }
+        GetCursorPos(&cursor);
+        hit = SendMessageW(hwnd, WM_NCHITTEST, 0, MAKELPARAM(cursor.x, cursor.y));
+        state = grayed ? CBS_DISABLED : down ? CBS_PUSHED : hit == expected ? CBS_HOT : CBS_NORMAL;
+        state = caption_button_state(hwnd, theme, part, state);
+        DrawThemeBackground(theme, hdc, part, state, &buttons[index], NULL);
+        break;
+    }
     case MENU_CLOSE_BUTTON:
     case MENU_MIN_BUTTON:
     case MENU_MAX_BUTTON:
@@ -89,3 +141,235 @@ void WINAPI UXTHEME_NonClientButtonDraw(HWND hwnd, HDC hdc, enum NONCLIENT_BUTTO
 
     CloseThemeData(theme);
 }
+
+/* Caption button assets are independent of the classic SM_CXSIZE values.
+ * Share their true geometry between painting and hit testing. */
+static void themed_caption_geometry(HWND hwnd, HTHEME theme, RECT *caption, RECT buttons[3])
+{
+    RECT window;
+    SIZE image;
+    UINT dpi = GetDpiForWindow(hwnd);
+    DWORD style = GetWindowLongW(hwnd, GWL_STYLE);
+    int border_x = GetSystemMetrics(style & WS_THICKFRAME ? SM_CXFRAME : SM_CXDLGFRAME);
+    /* XP keeps 2px between the buttons and to the frame at every DPI. */
+    int gap = 2, padding = 2;
+    int width = GetSystemMetrics(SM_CXSIZE), height = GetSystemMetrics(SM_CYSIZE) - 2;
+    int i;
+    GetWindowRect(hwnd, &window);
+    OffsetRect(&window, -window.left, -window.top);
+    *caption = window;
+    caption->bottom = GetSystemMetrics(style & WS_THICKFRAME ? SM_CYFRAME : SM_CYDLGFRAME)
+        + GetSystemMetrics(SM_CYCAPTION) - 1;
+    if (SUCCEEDED(GetThemePartSize(theme, NULL, WP_CAPTION, CS_ACTIVE, NULL, TS_TRUE, &image)))
+        caption->bottom = min(caption->bottom, MulDiv(image.cy, dpi, 96));
+    /* The buttons are square, 4px less than SM_CYSIZE: the assets' 21x21 at
+     * 96 DPI, 27x27 at 120 DPI (measured on XP). */
+    if (SUCCEEDED(GetThemePartSize(theme, NULL, WP_CLOSEBUTTON, CBS_NORMAL, NULL, TS_TRUE, &image)))
+        width = height = GetSystemMetrics(SM_CYSIZE) - 4;
+    buttons[0].right = window.right - border_x - 2;
+    buttons[0].left = buttons[0].right - width;
+    buttons[0].bottom = caption->bottom - padding;
+    buttons[0].top = buttons[0].bottom - height;
+    for (i = 1; i < 3; i++)
+    {
+        buttons[i] = buttons[i - 1];
+        OffsetRect(&buttons[i], -width - gap, 0);
+    }
+}
+
+LRESULT WINAPI Win4WineNcHitTest(HWND hwnd, LPARAM coordinates, LRESULT original)
+{
+    DWORD style = GetWindowLongW(hwnd, GWL_STYLE), exstyle = GetWindowLongW(hwnd, GWL_EXSTYLE);
+    RECT window, caption, buttons[3];
+    POINT point = {(short)LOWORD(coordinates), (short)HIWORD(coordinates)};
+    HTHEME theme;
+    int border_x, border_y, left, margin;
+    if (!win4wine_external_shell() || !IsThemeActive()
+        || (style & WS_CAPTION) != WS_CAPTION || !(style & WS_SYSMENU)
+        || (style & WS_CHILD) || (exstyle & WS_EX_TOOLWINDOW)) return original;
+    theme = OpenThemeDataForDpi(NULL, L"Window", GetDpiForWindow(hwnd));
+    if (!theme) return original;
+    themed_caption_geometry(hwnd, theme, &caption, buttons);
+    CloseThemeData(theme);
+    GetWindowRect(hwnd, &window);
+    point.x -= window.left; point.y -= window.top;
+    border_x = GetSystemMetrics(style & WS_THICKFRAME ? SM_CXFRAME : SM_CXDLGFRAME);
+    border_y = GetSystemMetrics(style & WS_THICKFRAME ? SM_CYFRAME : SM_CYDLGFRAME);
+    if (original == HTSYSMENU && point.x >= border_x + GetSystemMetrics(SM_CXSMICON)
+        + MulDiv(3, GetDpiForWindow(hwnd), 96)) return HTCAPTION;
+    /* XP's public NC hit regions include caption padding around the images.
+     * The close/max slots touch; the min/max slots retain their two-pixel gap. */
+    margin = MulDiv(1, GetDpiForWindow(hwnd), 96);
+    buttons[0].left -= margin;
+    buttons[0].right = window.right - window.left - border_x;
+    buttons[1].right = buttons[0].left;
+    buttons[2].left -= margin;
+    buttons[0].top = buttons[1].top = buttons[2].top = border_y;
+    buttons[0].bottom = buttons[1].bottom = buttons[2].bottom = caption.bottom;
+    left = style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX) ? buttons[2].left : buttons[0].left;
+    if (point.x < left || point.x >= window.right - window.left - border_x
+        || point.y < border_y || point.y >= border_y + GetSystemMetrics(SM_CYCAPTION)) return original;
+    if (PtInRect(&buttons[0], point)) return HTCLOSE;
+    if (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX))
+    {
+        if ((style & WS_MAXIMIZEBOX) && PtInRect(&buttons[1], point)) return HTMAXBUTTON;
+        if ((style & WS_MINIMIZEBOX) && PtInRect(&buttons[2], point)) return HTMINBUTTON;
+    }
+    return HTCAPTION;
+}
+
+/* Render the user's active Window theme while retaining user32's non-client
+ * geometry and hit testing. This is only enabled for the external XP shell. */
+BOOL WINAPI Win4WineDrawNonClient(HWND hwnd, HDC target)
+{
+    HTHEME theme;
+    HDC dc;
+    DWORD style = GetWindowLongW(hwnd, GWL_STYLE), exstyle = GetWindowLongW(hwnd, GWL_EXSTYLE);
+    RECT window, client, caption, part, text, buttons[3];
+    POINT origin;
+    BOOL active, maximized;
+    int saved, border_x, border_y, caption_height, state;
+    LOGFONTW lf;
+    HFONT font = NULL;
+    WCHAR title[512];
+    HICON icon;
+
+    if (!win4wine_external_shell()
+        || (style & WS_CAPTION) != WS_CAPTION || (style & WS_CHILD)
+        || (exstyle & WS_EX_TOOLWINDOW)) return FALSE;
+    if (!IsThemeActive())
+    {
+        UINT flags = DFCS_CAPTIONRESTORE;
+        POINT cursor;
+        int hit;
+        if (!GetPropW(hwnd, L"Win4WineMaximized") || !(style & WS_MAXIMIZEBOX)) return FALSE;
+        dc = target ? target : GetWindowDC(hwnd);
+        if (!dc) return FALSE;
+        saved = SaveDC(dc);
+        GetWindowRect(hwnd, &part);
+        OffsetRect(&part, -part.left, -part.top);
+        border_x = GetSystemMetrics(style & WS_THICKFRAME ? SM_CXFRAME : SM_CXDLGFRAME);
+        border_y = GetSystemMetrics(style & WS_THICKFRAME ? SM_CYFRAME : SM_CYDLGFRAME);
+        part.right -= border_x + GetSystemMetrics(SM_CXSIZE);
+        part.left = part.right - GetSystemMetrics(SM_CXSIZE);
+        part.top = border_y + 2;
+        part.bottom = border_y + GetSystemMetrics(SM_CYSIZE) - 2;
+        part.right -= 2;
+        GetCursorPos(&cursor);
+        hit = SendMessageW(hwnd, WM_NCHITTEST, 0, MAKELPARAM(cursor.x, cursor.y));
+        if (hit == HTMAXBUTTON && GetKeyState(VK_LBUTTON) < 0) flags |= DFCS_PUSHED;
+        DrawFrameControl(dc, &part, DFC_CAPTION, flags);
+        if (saved) RestoreDC(dc, saved);
+        if (!target) ReleaseDC(hwnd, dc);
+        return TRUE;
+    }
+    theme = OpenThemeDataForDpi(NULL, L"Window", GetDpiForWindow(hwnd));
+    if (!theme) return FALSE;
+    dc = target ? target : GetWindowDC(hwnd);
+    if (!dc) { CloseThemeData(theme); return FALSE; }
+    saved = SaveDC(dc);
+    if (!saved)
+    {
+        if (!target) ReleaseDC(hwnd, dc);
+        CloseThemeData(theme);
+        return FALSE;
+    }
+    GetWindowRect(hwnd, &window);
+    GetClientRect(hwnd, &client);
+    origin.x = origin.y = 0;
+    ClientToScreen(hwnd, &origin);
+    OffsetRect(&client, origin.x - window.left, origin.y - window.top);
+    OffsetRect(&window, -window.left, -window.top);
+    ExcludeClipRect(dc, client.left, client.top, client.right, client.bottom);
+    active = caption_active(hwnd);
+    maximized = IsZoomed(hwnd) || !!GetPropW(hwnd, L"Win4WineMaximized");
+    state = active ? CS_ACTIVE : CS_INACTIVE;
+    border_x = GetSystemMetrics(style & WS_THICKFRAME ? SM_CXFRAME : SM_CXDLGFRAME);
+    border_y = GetSystemMetrics(style & WS_THICKFRAME ? SM_CYFRAME : SM_CYDLGFRAME);
+    caption_height = GetSystemMetrics(SM_CYCAPTION) - 1;
+    themed_caption_geometry(hwnd, theme, &caption, buttons);
+    /* The buttons and title are placed against the raw caption height, but XP
+     * stretches the caption image over the whole SM_CYCAPTION, including the
+     * row that would otherwise stay in the window colour above the client. */
+    caption.bottom = max(caption.bottom, min(border_y + GetSystemMetrics(SM_CYCAPTION), client.top));
+    DrawThemeBackground(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, &caption, NULL);
+    part = window; part.top = caption.bottom; part.right = border_x;
+    DrawThemeBackground(theme, dc, WP_FRAMELEFT, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
+    part = window; part.top = caption.bottom; part.left = window.right - border_x;
+    DrawThemeBackground(theme, dc, WP_FRAMERIGHT, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
+    part = window; part.top = window.bottom - border_y;
+    DrawThemeBackground(theme, dc, WP_FRAMEBOTTOM, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
+
+    text = caption;
+    text.top = border_y;
+    text.left += border_x + 2;
+    text.right -= border_x + 2;
+    icon = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_SMALL, 0);
+    if (!icon) icon = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_BIG, 0);
+    if (!icon) icon = (HICON)GetClassLongPtrW(hwnd, GCLP_HICONSM);
+    if (!icon) icon = (HICON)GetClassLongPtrW(hwnd, GCLP_HICON);
+    /* Match the classic caption's default icon, without adding one to modal dialogs. */
+    if (!icon && !(exstyle & WS_EX_DLGMODALFRAME))
+        icon = LoadImageW(NULL, (LPCWSTR)IDI_WINLOGO, IMAGE_ICON,
+                         GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON),
+                         LR_DEFAULTCOLOR | LR_SHARED);
+    if (icon && (style & WS_SYSMENU))
+    {
+        int width = GetSystemMetrics(SM_CXSMICON), height = GetSystemMetrics(SM_CYSMICON);
+        DrawIconEx(dc, text.left, text.top + (caption_height - height) / 2,
+                   icon, width, height, 0, NULL, DI_NORMAL);
+        text.left += width + 4;
+    }
+    if (style & WS_SYSMENU)
+    {
+        POINT cursor;
+        int hit = HTNOWHERE, button_state;
+        HMENU menu = GetSystemMenu(hwnd, FALSE);
+        UINT close_state = GetMenuState(menu, SC_CLOSE, MF_BYCOMMAND);
+        GetCursorPos(&cursor);
+        if (cursor.x >= 0 && cursor.y >= 0)
+            hit = SendMessageW(hwnd, WM_NCHITTEST, 0, MAKELPARAM(cursor.x, cursor.y));
+        part = buttons[0];
+        button_state = (close_state == (UINT)-1 || (close_state & (MF_DISABLED | MF_GRAYED)))
+            ? CBS_DISABLED : hit == HTCLOSE ? (GetKeyState(VK_LBUTTON) < 0 ? CBS_PUSHED : CBS_HOT) : CBS_NORMAL;
+        button_state = caption_button_state(hwnd, theme, WP_CLOSEBUTTON, button_state);
+        DrawThemeBackground(theme, dc, WP_CLOSEBUTTON, button_state, &part, NULL);
+        text.right = part.left - 2;
+        if (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX))
+        {
+            part = buttons[1];
+            button_state = !(style & WS_MAXIMIZEBOX) ? MAXBS_DISABLED
+                : hit == HTMAXBUTTON ? (GetKeyState(VK_LBUTTON) < 0 ? MAXBS_PUSHED : MAXBS_HOT) : MAXBS_NORMAL;
+            button_state = caption_button_state(hwnd, theme, maximized ? WP_RESTOREBUTTON : WP_MAXBUTTON, button_state);
+            DrawThemeBackground(theme, dc, maximized ? WP_RESTOREBUTTON : WP_MAXBUTTON, button_state, &part, NULL);
+            part = buttons[2];
+            button_state = !(style & WS_MINIMIZEBOX) ? MINBS_DISABLED
+                : hit == HTMINBUTTON ? (GetKeyState(VK_LBUTTON) < 0 ? MINBS_PUSHED : MINBS_HOT) : MINBS_NORMAL;
+            button_state = caption_button_state(hwnd, theme, WP_MINBUTTON, button_state);
+            DrawThemeBackground(theme, dc, WP_MINBUTTON, button_state, &part, NULL);
+            text.right = part.left - 2;
+        }
+    }
+    /* The caption font of SPI_GETNONCLIENTMETRICS, which applying the theme
+     * set: above 96 DPI the theme's point size converted again would be a
+     * pixel larger than XP's (10pt is 17 pixels at 120 DPI, XP's caption 16). */
+    {
+        NONCLIENTMETRICSW ncm = {sizeof(ncm)};
+        if (SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0))
+            font = CreateFontIndirectW(&ncm.lfCaptionFont);
+        else if (SUCCEEDED(GetThemeSysFont(theme, TMT_CAPTIONFONT, &lf)))
+            font = CreateFontIndirectW(&lf);
+    }
+    if (font) SelectObject(dc, font);
+    SetBkMode(dc, TRANSPARENT);
+    GetWindowTextW(hwnd, title, ARRAY_SIZE(title));
+    SetTextColor(dc, GetThemeSysColor(theme, active ? COLOR_CAPTIONTEXT : COLOR_INACTIVECAPTIONTEXT));
+    text.bottom = text.top + GetSystemMetrics(SM_CYCAPTION);
+    DrawThemeText(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, title, -1,
+                  DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS, 0, &text);
+    RestoreDC(dc, saved);
+    if (font) DeleteObject(font);
+    if (!target) ReleaseDC(hwnd, dc);
+    CloseThemeData(theme);
+    return TRUE;
+}
