+static void draw_caption_button( HWND hwnd, HDC dc, RECT *rect, UINT flags )
+{
+    enum NONCLIENT_BUTTON_TYPE type;
+    if (!win4wine_external_shell())
+    {
+        draw_frame_caption(dc, rect, flags);
+        return;
+    }
+    switch (flags & 0xf)
+    {
+    case DFCS_CAPTIONCLOSE: type = CAPTION_CLOSE_BUTTON; break;
+    case DFCS_CAPTIONMIN: type = CAPTION_MIN_BUTTON; break;
+    case DFCS_CAPTIONMAX: type = CAPTION_MAX_BUTTON; break;
+    case DFCS_CAPTIONRESTORE: type = CAPTION_RESTORE_BUTTON; break;
+    default: draw_frame_caption(dc, rect, flags); return;
+    }
+    draw_menu_button(hwnd, dc, rect, type, !!(flags & DFCS_PUSHED), !!(flags & DFCS_INACTIVE));
+}
