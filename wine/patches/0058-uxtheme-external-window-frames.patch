From: Codex <codex@localhost>
Subject: [PATCH] uxtheme, user32: draw themed window frames for the external shell

Purpose: draw Luna captions, borders and caption buttons on the XP shell's
and its applications' windows, with XP's geometry.
XP behavior: measured with public DrawThemeBackground, WM_NCHITTEST and
synthetic-icon probes on the user's XP:
- caption buttons are squares of SM_CYSIZE less four (the assets' 21 at
  96 DPI, 27 at 120, 34 at 144), two pixels apart and two pixels from the
  frame at every DPI; input slots are padded beyond the images;
- in an inactive caption, Luna's second group of four button images
  (TMT_IMAGECOUNT 8) is used;
- the 16 pixel icon sits at y8 (SM_CYCAPTION includes a one-pixel
  boundary) and its system menu input spans x4..23, the rest of the caption
  drags;
- the icon falls back like the classic caption's: window small, window
  big, class small, class big, then IDI_WINLOGO at small-icon size, except
  for WS_EX_DLGMODALFRAME windows;
- the title, in SPI_GETNONCLIENTMETRICS' caption font (16 pixels at 120
  DPI; the theme's 10 points would be 17), has the theme's single text
  shadow, one pixel right and down at every DPI;
- the caption image covers the whole SM_CYCAPTION height, without a row of
  window colour above the client;
- the caption is drawn active or inactive as WM_NCACTIVATE last set it, as
  the classic caption is, also for a window that is not the foreground
  window (bridge-wm's frames of Linux windows set it from the X focus).
Wine before: the opted-in shell's windows had classic frames.
Change: uxtheme exports Win4WineDrawNonClient and Win4WineNcHitTest. user32
keeps Wine's geometry and calls them after its own painting (WM_NCPAINT,
WM_NCACTIVATE, WM_SETTEXT, WM_SETICON) and for hit testing; the pressed and
hot states of caption buttons are drawn through the user API hook, and
virtual maximization by the bridge is marked with Win4WineMaximized
(classic restore glyphs follow it). DrawThemeText draws single shadows.
Evidence: tests/nonclient-caption.c, tests/caption-icons.c,
tests/caption-text.c, tests/nonclient-theme.c; a restored folder window's
caption equals the reference XP machine's in its unstretched part.
Scope: only with WIN4WINE_EXTERNAL_SHELL; classic sessions and ordinary
Wine keep their frames.
Old patches: 0014 (except metric.c), 0022, 0027, 0028, 0032, 0034, 0062, 0065.
---
 dlls/user32/defwnd.c      |  76 +++++++++++++
 dlls/user32/nonclient.c   |   8 ++
 dlls/uxtheme/draw.c       |  22 ++++
 dlls/uxtheme/uxtheme.spec |   3 +
 dlls/uxtheme/window.c     | 284 ++++++++++++++++++++++++++++++++++++++++++++++
 dlls/win32u/defwnd.c      |  25 +++-
 include/winuser.h         |   4 +
 7 files changed, 419 insertions(+), 3 deletions(-)

diff --git a/dlls/user32/defwnd.c b/dlls/user32/defwnd.c
index 6069166..0c303a0 100644
--- a/dlls/user32/defwnd.c
+++ b/dlls/user32/defwnd.c
@@ -80,6 +80,50 @@ static void default_ime_compositionA( HWND hwnd, WPARAM wparam, LPARAM lparam )
     HeapFree( GetProcessHeap(), 0, buf );
 }
 
+/* Optional Window-part renderer provided by Wine's own uxtheme. */
+static void external_shell_draw_nonclient( HWND hwnd, HDC dc )
+{
+    HMODULE theme;
+    BOOL (WINAPI *draw)(HWND, HDC);
+    if (!win4wine_external_shell()) return;
+    theme = GetModuleHandleW( L"uxtheme.dll" );
+    if (!theme) theme = LoadLibraryW( L"uxtheme.dll" );
+    draw = theme ? (void *)GetProcAddress( theme, "Win4WineDrawNonClient" ) : NULL;
+    if (draw) draw( hwnd, dc );
+}
+
+static LRESULT external_shell_nonclient_hit( HWND hwnd, LPARAM point, LRESULT original )
+{
+    HMODULE theme;
+    LRESULT (WINAPI *hit)(HWND, LPARAM, LRESULT);
+    if (!win4wine_external_shell()) return original;
+    theme = GetModuleHandleW( L"uxtheme.dll" );
+    hit = theme ? (void *)GetProcAddress( theme, "Win4WineNcHitTest" ) : NULL;
+    return hit ? hit( hwnd, point, original ) : original;
+}
+
+static void external_shell_nonclient_mouse( HWND hwnd, UINT msg )
+{
+    POINT point;
+    int hit = 0, previous;
+    TRACKMOUSEEVENT track = {sizeof(track), TME_NONCLIENT | TME_LEAVE, hwnd, 0};
+    if (!win4wine_external_shell()) return;
+    previous = HandleToLong(GetPropW(hwnd, L"Win4WineNcHot"));
+    if (msg == WM_NCMOUSEMOVE)
+    {
+        GetCursorPos(&point);
+        hit = SendMessageW(hwnd, WM_NCHITTEST, 0, MAKELPARAM(point.x, point.y));
+        if (hit != HTCLOSE && hit != HTMINBUTTON && hit != HTMAXBUTTON) hit = 0;
+        NtUserTrackMouseEvent(&track);
+    }
+    if (hit != previous)
+    {
+        if (hit) SetPropW(hwnd, L"Win4WineNcHot", LongToHandle(hit));
+        else RemovePropW(hwnd, L"Win4WineNcHot");
+        external_shell_draw_nonclient(hwnd, NULL);
+    }
+}
+
 /* XP captures the Start panel through WM_PRINT before its show animation.
  * The win32u default only prints the parent; include visible descendants in
  * the caller's DC for the explicitly selected external shell. */
@@ -96,6 +140,7 @@ static LRESULT external_shell_print( HWND hwnd, HDC dc, LPARAM flags )
     if (flags & PRF_NONCLIENT)
     {
         NtUserMessageCall( hwnd, WM_PRINT, (WPARAM)dc, PRF_NONCLIENT, 0, NtUserDefWindowProc, FALSE );
+        external_shell_draw_nonclient( hwnd, dc );
         GetWindowRect( hwnd, &window );
         MapWindowPoints( hwnd, NULL, &origin, 1 );
         OffsetViewportOrgEx( dc, origin.x - window.left, origin.y - window.top, NULL );
@@ -163,6 +208,33 @@ static LRESULT external_shell_print( HWND hwnd, HDC dc, LPARAM flags )
     return 0;
 }
 
+/* The external shell's frames after DefWindowProc's own handling of MSG. */
+static LRESULT external_shell_defwnd( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, LRESULT result )
+{
+    switch (msg)
+    {
+    case WM_NCPAINT:
+    case WM_NCACTIVATE:
+    case WM_SETTEXT:
+    /* WM_SETICON repaints the caption with the classic code too, as when a
+     * folder window shows the icon of the folder it navigated to. */
+    case WM_SETICON:
+        external_shell_draw_nonclient( hwnd, NULL );
+        break;
+    case WM_PRINT:
+        if ((lparam & PRF_NONCLIENT) && !(lparam & (PRF_CHILDREN | PRF_OWNED)))
+            external_shell_draw_nonclient( hwnd, (HDC)wparam );
+        break;
+    case WM_NCHITTEST:
+        return external_shell_nonclient_hit( hwnd, lparam, result );
+    case WM_NCMOUSEMOVE:
+    case WM_NCMOUSELEAVE:
+        external_shell_nonclient_mouse( hwnd, msg );
+        break;
+    }
+    return result;
+}
+
 /***********************************************************************
  *              DefWindowProcA (USER32.@)
  *
@@ -223,6 +295,8 @@ LRESULT WINAPI DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam
         break;
     }
 
+    result = external_shell_defwnd( hwnd, msg, wParam, lParam, result );
+
     SPY_ExitMessage( SPY_RESULT_DEFWND, hwnd, msg, result, wParam, lParam );
     return result;
 }
@@ -293,6 +367,8 @@ LRESULT WINAPI DefWindowProcW(
         result = NtUserMessageCall( hwnd, msg, wParam, lParam, 0, NtUserDefWindowProc, FALSE );
         break;
     }
+    result = external_shell_defwnd( hwnd, msg, wParam, lParam, result );
+
     SPY_ExitMessage( SPY_RESULT_DEFWND, hwnd, msg, result, wParam, lParam );
     return result;
 }
