diff --git a/dlls/comctl32/progress.c b/dlls/comctl32/progress.c
index bcffd20..eab59d3 100644
--- a/dlls/comctl32/progress.c
+++ b/dlls/comctl32/progress.c
@@ -36,6 +36,7 @@
 #include "commctrl.h"
 #include "comctl32.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(progress);
 
@@ -289,6 +290,65 @@ static void draw_theme_bar_V (const ProgressDrawInfo* di, int start, int end)
     DrawThemeBackground (theme, di->hdc, PP_FILLVERT, di->infoPtr->State, &r, NULL);
 }
 
+static void draw_theme_bkg_H (const ProgressDrawInfo* di, int start, int end);
+static void draw_theme_bkg_V (const ProgressDrawInfo* di, int start, int end);
+
+/* XP's styles (format 3) have no fill part: the bar is the chunk part,
+ * repeated with the style's chunk and space sizes, over the bar's content.
+ * In the XP shell session, as XP draws it (xpcmp.exe on the reference XP
+ * machine); Wine drew one band, as ReactOS does. */
+static BOOL use_theme_chunks (HTHEME theme)
+{
+    return COMCTL32_IsXPShell() && !IsThemePartDefined (theme, PP_FILL, 0) &&
+           IsThemePartDefined (theme, PP_CHUNK, 0);
+}
+
+/* draw themed horizontal chunks from 'start' to 'end' */
+static void draw_theme_chunk_bar_H (const ProgressDrawInfo* di, int start, int end)
+{
+    HTHEME theme = GetWindowTheme (di->infoPtr->Self);
+    RECT r;
+    int x;
+
+    if (!use_theme_chunks (theme))
+    {
+        draw_theme_bar_H (di, start, end);
+        return;
+    }
+    r.top = di->rect.top;
+    r.bottom = di->rect.bottom;
+    for (x = start; x < end; x += di->ledW + di->ledGap)
+    {
+        r.left = di->rect.left + x;
+        r.right = di->rect.left + min (x + di->ledW, end);
+        DrawThemeBackground (theme, di->hdc, PP_CHUNK, 0, &r, NULL);
+        if (x + di->ledW < end) draw_theme_bkg_H (di, x + di->ledW, min (x + di->ledW + di->ledGap, end));
+    }
+}
+
+/* draw themed vertical chunks from 'start' to 'end' */
+static void draw_theme_chunk_bar_V (const ProgressDrawInfo* di, int start, int end)
+{
+    HTHEME theme = GetWindowTheme (di->infoPtr->Self);
+    RECT r;
+    int y;
+
+    if (!IsThemePartDefined (theme, PP_CHUNKVERT, 0) || !use_theme_chunks (theme))
+    {
+        draw_theme_bar_V (di, start, end);
+        return;
+    }
+    r.left = di->rect.left;
+    r.right = di->rect.right;
+    for (y = start; y < end; y += di->ledW + di->ledGap)
+    {
+        r.bottom = di->rect.bottom - y;
+        r.top = di->rect.bottom - min (y + di->ledW, end);
+        DrawThemeBackground (theme, di->hdc, PP_CHUNKVERT, 0, &r, NULL);
+        if (y + di->ledW < end) draw_theme_bkg_V (di, y + di->ledW, min (y + di->ledW + di->ledGap, end));
+    }
+}
+
 /* draw themed horizontal background from 'start' to 'end' */
 static void draw_theme_bkg_H (const ProgressDrawInfo* di, int start, int end)
 {
@@ -330,9 +390,9 @@ static const ProgressDrawProc drawProcThemed[8] = {
     draw_theme_bar_V, draw_theme_bkg_V,
   /* Chunky */
     /* Horizontal */
-    draw_theme_bar_H, draw_theme_bkg_H,
+    draw_theme_chunk_bar_H, draw_theme_bkg_H,
     /* Vertical */
-    draw_theme_bar_V, draw_theme_bkg_V,
+    draw_theme_chunk_bar_V, draw_theme_bkg_V,
 };
 #endif /* __WINE_COMCTL32_VERSION == 6 */
 
