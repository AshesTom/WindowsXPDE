+/* XP's comctl32 6 in the XP shell session, with a visual style */
+static BOOL xp_themed_tab(const TAB_INFO *infoPtr)
+{
+#if __WINE_COMCTL32_VERSION == 6
+    return COMCTL32_IsXPShell() && GetWindowTheme(infoPtr->hwnd);
+#else
+    return FALSE;
+#endif
+}
+
 /******************************************************************************
  * Positioning constants
  */
@@ -1861,6 +1871,10 @@ TAB_DrawItemInterior(const TAB_INFO *infoPtr, HDC hdc, INT iItem, RECT *drawRect
           INT padding = infoPtr->uHItemPadding + (iItem == infoPtr->iSelected ? SELECTED_TAB_OFFSET : 0);
           center_offset_h = min(center_offset_h, padding);
         }
+        /* XP's themed tabs: a pixel further left (xpcmp.exe on the reference
+         * XP machine) */
+        else if (xp_themed_tab(infoPtr))
+          center_offset_h--;
       }
 
     if(infoPtr->dwStyle & TCS_VERTICAL)
@@ -1880,7 +1894,14 @@ TAB_DrawItemInterior(const TAB_INFO *infoPtr, HDC hdc, INT iItem, RECT *drawRect
 
     /* if an item is selected, the text is shifted up instead of down
      * (a pixel further down on Windows 7 SP1) */
-    if (iItem == infoPtr->iSelected)
+    if (xp_themed_tab(infoPtr) && !(infoPtr->dwStyle & TCS_VERTICAL))
+    {
+        /* XP's themed tabs: the selected text centred, the others the
+         * padding down */
+        if (iItem != infoPtr->iSelected)
+            center_offset_v += infoPtr->uVItemPadding;
+    }
+    else if (iItem == infoPtr->iSelected)
         center_offset_v -= infoPtr->uVItemPadding / 2;
     else
         center_offset_v += (infoPtr->uVItemPadding + (COMCTL32_IsWin7Shell() ? 1 : 0)) / 2;
@@ -2009,8 +2030,16 @@ static void TAB_DrawItemThemeBackground(const TAB_INFO *infoPtr, HDC hdc, INT iI
             TAB_GetItem(infoPtr, iItem + 1)->rect.top != TAB_GetItem(infoPtr, iItem)->rect.top)
             contentRect->right -= 2;
     }
-    else if (TAB_GetItem(infoPtr, iItem)->rect.top == infoPtr->uNumRows - 1)
+    /* XP SP3 draws unselected tabs as tall as the item (xpcmp.exe on the
+     * reference XP machine) */
+    else if (TAB_GetItem(infoPtr, iItem)->rect.top == infoPtr->uNumRows - 1 &&
+             !(xp_themed_tab(infoPtr) && iItem != infoPtr->iSelected))
         contentRect->bottom += 3;
+    /* and the last of a row a pixel narrower */
+    if (xp_themed_tab(infoPtr) && iItem != infoPtr->iSelected &&
+        (iItem + 1 == infoPtr->uNumItem ||
+         TAB_GetItem(infoPtr, iItem + 1)->rect.top != TAB_GetItem(infoPtr, iItem)->rect.top))
+        contentRect->right -= 1;
 
     DrawThemeBackground(theme, hdc, partIds[partIndex], stateId, contentRect, NULL);
     GetThemeBackgroundContentRect(theme, hdc, partIds[partIndex], stateId, contentRect, contentRect);
diff --git a/dlls/comctl32/trackbar.c b/dlls/comctl32/trackbar.c
