         COMCTL32_GetFontMetrics(infoPtr->hDefaultFont, &tm);
         return max(tm.tmHeight + 2 * GetSystemMetrics(SM_CYBORDER), infoPtr->minHeight) + 2 * infoPtr->verticalBorder;
     }
+    /* XP's (SP3, with sh.exe): 24 pixels at 96 dpi for any font, MS UI
+     * Gothic -12 to Arial -20 */
+    if (COMCTL32_IsXPShell())
+    {
+        COMCTL32_GetFontMetrics(infoPtr->hDefaultFont, &tm);
