 /* Windows 7 SP1 (tests/trackbar-size.c, themed): a thumb pointing to one
  * side is as wide as its 11x19 part scaled to its length (up to 19), and the
  * channel ends half a thumb plus three pixels from the edges */
+static BOOL xp_trackbar(const TRACKBAR_INFO *infoPtr)
+{
+#if __WINE_COMCTL32_VERSION == 6
+    return COMCTL32_IsXPShell() && GetWindowTheme(infoPtr->hwndSelf);
+#else
+    return FALSE;
+#endif
+}
+
 static BOOL win7_trackbar(const TRACKBAR_INFO *infoPtr)
 {
 #if __WINE_COMCTL32_VERSION == 6
@@ -333,6 +342,10 @@ TRACKBAR_CalcChannel (TRACKBAR_INFO *infoPtr)
             channel->top = lpRect.top + ((infoPtr->uThumbLen - cyChannel + 2) / 2);
         else
             channel->top = lpRect.top + (infoPtr->uThumbLen / 2) - 1;
+        /* XP's themed channel is a pixel lower (xpcmp.exe on the reference XP
+         * machine: 10 pixels down with the 21 pixel thumb) */
+        if (xp_trackbar(infoPtr) && !(infoPtr->dwStyle & TBS_ENABLESELRANGE))
+            channel->top++;
         if (infoPtr->dwStyle & TBS_BOTH) {
             if (infoPtr->dwStyle & TBS_NOTICKS)
                 channel->top += 1;
