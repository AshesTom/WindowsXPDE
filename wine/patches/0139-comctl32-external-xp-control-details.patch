diff --git a/dlls/comctl32/commctrl.c b/dlls/comctl32/commctrl.c
index c6fdc16..35d487e 100644
--- a/dlls/comctl32/commctrl.c
+++ b/dlls/comctl32/commctrl.c
@@ -176,6 +176,16 @@ BOOL COMCTL32_IsWin7Shell(void)
     return win7;
 }
 
+/* Whether the process runs in the XP shell session (win4wine: an external
+ * shell without WIN4WINE_SHELL): the controls then follow XP's comctl32 6
+ * where Wine's differs (measured with xpcmp.exe on the reference XP machine). */
+BOOL COMCTL32_IsXPShell(void)
+{
+    static int xp = -1;
+    if (xp < 0) xp = win4wine_shell() == WIN4WINE_SHELL_XP;
+    return xp;
+}
+
 #if __WINE_COMCTL32_VERSION == 6
 /* For the opted-in external XP shell, whose native comctl32 runs without its
  * SxS activation context: register Wine's themed version of a user control as
@@ -543,8 +553,8 @@ void COMCTL32_DrawStatusText(HDC hdc, LPCRECT lprc, LPCWSTR text, UINT style, BO
         oldtextcolor = SetTextColor (hdc, comctl32_color.clrBtnText);
         if (style & SBT_RTLREADING)
             FIXME("Unsupported RTL style!\n");
-        /* a pixel less on Windows 7 SP1 */
-        r.left += COMCTL32_IsWin7Shell() ? 2 : 3;
+        /* a pixel less on Windows 7 SP1 and XP SP3 */
+        r.left += COMCTL32_IsWin7Shell() || COMCTL32_IsXPShell() ? 2 : 3;
         do {
             if (*text == '\t') {
                 if (strCnt) {
