From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: load and blit shared theme images one thread at a time

Purpose: stop window captions from being drawn black when two threads
paint themed parts at once.
Wine before: theme images are bitmaps loaded once per theme file and
shared by every thread of the process, but a bitmap can be selected into
only one DC at a time. XP Explorer paints each folder window on its own
thread; when two windows painted together, as on Alt+Tab between them, the
second SelectObject failed and the part was stretched from the DC's empty
bitmap. Logging showed 2 to 11 failed selections per Alt+Tab, and the
caption stayed black when the failed draw was the last one. The list of
loaded images was also extended without a lock, so two threads loading
the same image could load it twice and lose one entry.
XP behavior: themed parts always show their image.
Change: serialize the selection and blit of theme images with one
critical section, and look up and add loaded images under another.
Scope: every Wine application. Drawing on Windows is thread safe; the lock
is held only around the blit, never while calling back into the
application.
Old patches: 0076 (made unconditional, and extended to image loading).
---
 dlls/uxtheme/draw.c     | 18 ++++++++++++++++++
 dlls/uxtheme/msstyles.c | 16 +++++++++++++++-
 2 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/dlls/uxtheme/draw.c b/dlls/uxtheme/draw.c
index aa6a9f3..5416676 100644
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -557,6 +557,20 @@ static void reset_dc_alpha_values(HTHEME htheme, HDC hdc, int part_id, int state
                   DIB_RGB_COLORS, SRCPAINT);
 }
 
+/* Theme images are bitmaps shared by every thread of the process, and a
+ * bitmap can be selected into only one DC at a time. XP Explorer paints each
+ * folder window on its own thread; when two windows painted their captions at
+ * once, one selection failed and that caption was drawn from an empty DC,
+ * leaving it black. Blit one theme image at a time. */
+static CRITICAL_SECTION image_section;
+static CRITICAL_SECTION_DEBUG image_section_debug =
+{
+    0, 0, &image_section,
+    { &image_section_debug.ProcessLocksList, &image_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": image_section") }
+};
+static CRITICAL_SECTION image_section = { &image_section_debug, -1, 0, 0, 0, 0 };
+
 /***********************************************************************
  *      UXTHEME_DrawImageGlyph
  *
@@ -588,6 +602,7 @@ static HRESULT UXTHEME_DrawImageGlyph(HTHEME hTheme, HDC hdc, int iPartId,
         hr = HRESULT_FROM_WIN32(GetLastError());
         return hr;
     }
+    EnterCriticalSection(&image_section);
     oldSrc = SelectObject(hdcSrc, bmpSrc);
 
     dstSize.x = pRect->right-pRect->left;
@@ -614,6 +629,7 @@ static HRESULT UXTHEME_DrawImageGlyph(HTHEME hTheme, HDC hdc, int iPartId,
     }
 
     SelectObject(hdcSrc, oldSrc);
+    LeaveCriticalSection(&image_section);
     DeleteDC(hdcSrc);
 
     /* Don't transfer alpha values from the glyph when drawing opaque background */
@@ -772,6 +788,7 @@ static HRESULT UXTHEME_DrawImageBackground(HTHEME hTheme, HDC hdc, int iPartId,
         hr = HRESULT_FROM_WIN32(GetLastError());
         return hr;
     }
+    EnterCriticalSection(&image_section);
     oldSrc = SelectObject(hdcSrc, bmpSrc);
 
     rcDst = *pRect;
@@ -931,6 +948,7 @@ draw_error:
         SetViewportOrgEx (hdcDst, org.x, org.y, NULL);
     }
     SelectObject(hdcSrc, oldSrc);
+    LeaveCriticalSection(&image_section);
     DeleteDC(hdcSrc);
     *pRect = rcDst;
     return hr;
diff --git a/dlls/uxtheme/msstyles.c b/dlls/uxtheme/msstyles.c
index 018b3fb..9b81064 100644
--- a/dlls/uxtheme/msstyles.c
+++ b/dlls/uxtheme/msstyles.c
@@ -1310,6 +1310,15 @@ static BOOL prepare_alpha (HBITMAP bmp, BOOL* hasAlpha, BOOL *hasDefaultTranspar
     return TRUE;
 }
 
+static CRITICAL_SECTION images_section;
+static CRITICAL_SECTION_DEBUG images_section_debug =
+{
+    0, 0, &images_section,
+    { &images_section_debug.ProcessLocksList, &images_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": images_section") }
+};
+static CRITICAL_SECTION images_section = { &images_section_debug, -1, 0, 0, 0, 0 };
+
 HBITMAP MSSTYLES_LoadBitmap (PTHEME_CLASS tc, LPCWSTR lpFilename, BOOL* hasAlpha, BOOL *hasDefaultTransparentColour)
 {
     WCHAR szFile[MAX_PATH];
@@ -1325,7 +1334,10 @@ HBITMAP MSSTYLES_LoadBitmap (PTHEME_CLASS tc, LPCWSTR lpFilename, BOOL* hasAlpha
         if(*tmp == '.') *tmp = '_';
     } while(*tmp++);
 
-    /* Try to locate in list of loaded images */
+    /* Try to locate in list of loaded images. Every thread of the process
+     * shares the list; two threads loading the same image at once would load
+     * it twice and could lose one of the entries. */
+    EnterCriticalSection(&images_section);
     img = tc->tf->images;
     while (img)
     {
@@ -1335,6 +1347,7 @@ HBITMAP MSSTYLES_LoadBitmap (PTHEME_CLASS tc, LPCWSTR lpFilename, BOOL* hasAlpha
             *hasAlpha = img->hasAlpha;
             if (hasDefaultTransparentColour)
                 *hasDefaultTransparentColour = img->hasDefaultTransparentColour;
+            LeaveCriticalSection(&images_section);
             return img->image;
         }
         img = img->next;
@@ -1351,6 +1364,7 @@ HBITMAP MSSTYLES_LoadBitmap (PTHEME_CLASS tc, LPCWSTR lpFilename, BOOL* hasAlpha
     lstrcpyW (img->name, szFile);
     img->next = tc->tf->images;
     tc->tf->images = img;
+    LeaveCriticalSection(&images_section);
     TRACE ("new %p %s: %p\n", img, debugstr_w (img->name), img->image);
     return img->image;
 }
