From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] apphelp, advapi32: answer the checks XP's shell32 makes before running a program

Purpose: let XP's shell32 start programs and Control Panel items (Display
Properties through rundll32) without raising on unimplemented stubs.
Change: ApphelpCheckExe allows every program; SaferGetLevelInformation
reports every level as fully trusted; SaferRecordEventLogEntry is a stub.
SaferiIsExecutableFileType comes from win4wine (patch 0098), which reports
the executable types, so XP's shell32 now asks for the level.
Scope: every Wine application (these were stubs or missing exports).
---
 dlls/advapi32/advapi32.spec |  4 ++--
 dlls/advapi32/security.c    | 35 +++++++++++++++++++++++++++++++++++
 dlls/apphelp/apphelp.c      |  8 ++++++++
 dlls/apphelp/apphelp.spec   |  2 +-
 4 files changed, 46 insertions(+), 3 deletions(-)

diff --git a/dlls/advapi32/advapi32.spec b/dlls/advapi32/advapi32.spec
index d8b67d6..9cc720a 100644
--- a/dlls/advapi32/advapi32.spec
+++ b/dlls/advapi32/advapi32.spec
@@ -717,10 +717,10 @@
 @ stdcall SaferCloseLevel(ptr)
 @ stdcall SaferComputeTokenFromLevel(ptr ptr ptr long ptr)
 @ stdcall SaferCreateLevel(long long long ptr ptr)
-# @ stub SaferGetLevelInformation
+@ stdcall SaferGetLevelInformation(ptr long ptr long ptr)
 @ stdcall SaferGetPolicyInformation(long long long ptr ptr ptr)
 @ stdcall SaferIdentifyLevel(long ptr ptr ptr)
-# @ stub SaferRecordEventLogEntry
+@ stdcall SaferRecordEventLogEntry(ptr wstr ptr)
 @ stdcall SaferSetLevelInformation(ptr long ptr long)
 # @ stub SaferSetPolicyInformation
 # @ stub SaferiChangeRegistryScope
diff --git a/dlls/advapi32/security.c b/dlls/advapi32/security.c
index b6dca4b..3cde335 100644
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -3207,6 +3207,41 @@ BOOL WINAPI SaferIdentifyLevel(DWORD count, SAFER_CODE_PROPERTIES *properties, S
     return TRUE;
 }
 
+/******************************************************************************
+ * SaferGetLevelInformation   [ADVAPI32.@]
+ *
+ * No Software Restriction Policies levels exist here: every level is fully
+ * trusted (SaferiIsExecutableFileType now reports executable types, so XP's
+ * shell32 asks for the level before it runs a program).
+ */
+BOOL WINAPI SaferGetLevelInformation(SAFER_LEVEL_HANDLE handle, SAFER_OBJECT_INFO_CLASS infotype,
+                                     LPVOID buffer, DWORD size, LPDWORD needed)
+{
+    FIXME("(%p %u %p %lu %p) semi-stub\n", handle, infotype, buffer, size, needed);
+    if (infotype == SaferObjectLevelId)
+    {
+        if (needed) *needed = sizeof(DWORD);
+        if (!buffer || size < sizeof(DWORD))
+        {
+            SetLastError(ERROR_INSUFFICIENT_BUFFER);
+            return FALSE;
+        }
+        *(DWORD *)buffer = SAFER_LEVELID_FULLYTRUSTED;
+        return TRUE;
+    }
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+/******************************************************************************
+ * SaferRecordEventLogEntry   [ADVAPI32.@]
+ */
+BOOL WINAPI SaferRecordEventLogEntry(SAFER_LEVEL_HANDLE handle, LPCWSTR target, LPVOID reserved)
+{
+    FIXME("(%p %s %p) stub\n", handle, debugstr_w(target), reserved);
+    return TRUE;
+}
+
 /******************************************************************************
  * SaferSetLevelInformation   [ADVAPI32.@]
  */
diff --git a/dlls/apphelp/apphelp.c b/dlls/apphelp/apphelp.c
index 9100aff..a9deaf5 100644
--- a/dlls/apphelp/apphelp.c
+++ b/dlls/apphelp/apphelp.c
@@ -45,6 +45,14 @@ BOOL WINAPI ApphelpCheckInstallShieldPackage( void* ptr, LPCWSTR path )
     return TRUE;
 }
 
+/* XP's shell32 asks this before it runs a program from Explorer; there is no
+ * application compatibility database here, so every program may run. */
+BOOL WINAPI ApphelpCheckExe( LPCWSTR path, BOOL apphelp, BOOL shim, BOOL use_module )
+{
+    TRACE("(%s, %d, %d, %d)\n", debugstr_w(path), apphelp, shim, use_module);
+    return TRUE;
+}
+
 BOOL WINAPI ApphelpCheckMsiPackage( void* ptr, LPCWSTR path )
 {
     FIXME("stub: %p %s\n", ptr, debugstr_w(path));
diff --git a/dlls/apphelp/apphelp.spec b/dlls/apphelp/apphelp.spec
index 3609c13..992bbec 100644
--- a/dlls/apphelp/apphelp.spec
+++ b/dlls/apphelp/apphelp.spec
@@ -1,5 +1,5 @@
 @ stdcall AllowPermLayer(wstr)
-@ stub ApphelpCheckExe
+@ stdcall ApphelpCheckExe(wstr long long long)
 @ stdcall ApphelpCheckInstallShieldPackage(ptr wstr)
 @ stdcall ApphelpCheckMsiPackage(ptr wstr)
 @ stub ApphelpCheckRunApp
