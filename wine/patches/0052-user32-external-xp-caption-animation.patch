From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] user32, win32u: XP's caption animation when minimizing, maximizing and restoring

Purpose: windows minimize to the taskbar, maximize and restore with XP's
animation (Display Properties, Effects: "Animate windows when minimizing and
maximizing", on by default).
Windows behavior: minimizing draws the window's caption flying to its
taskbar button (DrawAnimatedRects, IDANI_CAPTION), and restoring or
maximizing draws it flying back before the window appears.
SPI_GETANIMATION/SPI_SETANIMATION read and write WindowMetrics\MinAnimate.
Wine before: DrawAnimatedRects was a stub, SPI_GETANIMATION always answered
"disabled" and SPI_SETANIMATION was ignored.
Change: SPI_[GS]ETANIMATION use WindowMetrics\MinAnimate (default on, as
Windows). In the XP shell's session, DrawAnimatedRects(IDANI_CAPTION)
moves a caption (the visual style's, or the classic gradient) with the
window's icon and title from one rectangle to the other in 200 ms, and
DefWindowProc's SC_MINIMIZE, SC_MAXIMIZE and SC_RESTORE call it, between the
window's caption and its place on XP's task band.
Scope: the XP shell's session (measured on XP; the Windows 7 and ReactOS
sessions are not animated); elsewhere DrawAnimatedRects does nothing, as
before. SPI_GETANIMATION answers from the registry everywhere.
---
 dlls/user32/nonclient.c |  76 +++++++++++++++++++++++++++++++++
 dlls/user32/uitools.c   | 109 +++++++++++++++++++++++++++++++++++++++++++++++-
 dlls/win32u/sysparams.c |  20 ++++++---
 3 files changed, 198 insertions(+), 7 deletions(-)

diff --git a/dlls/user32/nonclient.c b/dlls/user32/nonclient.c
index d65e7c9..473c0bc 100644
--- a/dlls/user32/nonclient.c
+++ b/dlls/user32/nonclient.c
@@ -21,6 +21,11 @@
 #include "user_private.h"
 #include "controls.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
+
+#ifndef IDANI_CAPTION
+#define IDANI_CAPTION 3
+#endif
 
 
 #define SC_ABOUTWINE            (SC_SCREENSAVE+1)
@@ -63,10 +68,81 @@ BOOL WINAPI DrawCaptionTempA (HWND hwnd, HDC hdc, const RECT *rect, HFONT hFont,
  *
  * Handle a WM_SYSCOMMAND message. Called from DefWindowProc().
  */
+/* The caption's rectangle in a window rectangle. */
+static RECT caption_rect( const RECT *window )
+{
+    RECT rect = *window;
+    rect.bottom = rect.top + GetSystemMetrics( SM_CYCAPTION ) + GetSystemMetrics( SM_CYFRAME );
+    return rect;
+}
+
+/* Where XP's caption animation starts and ends for a minimize, maximize or
+ * restore of HWND, in the XP shell's session: its caption and its place on the
+ * taskbar (the task band; XP's shell is not asked for the button itself). */
+static BOOL min_max_animation( HWND hwnd, UINT command, RECT *from, RECT *to )
+{
+    WINDOWPLACEMENT placement = {.length = sizeof(placement)};
+    HWND tray, band;
+    RECT window, task, work;
+    DWORD style = GetWindowLongW( hwnd, GWL_STYLE );
+
+    if (win4wine_shell() != WIN4WINE_SHELL_XP || (style & WS_CHILD) || (style & WS_CAPTION) != WS_CAPTION ||
+        !(style & WS_VISIBLE) || !GetWindowRect( hwnd, &window ) || !NtUserGetWindowPlacement( hwnd, &placement ))
+        return FALSE;
+    if (!(tray = FindWindowW( L"Shell_TrayWnd", NULL )) ||
+        !(band = FindWindowExW( tray, NULL, L"ReBarWindow32", NULL )) ||
+        !(band = FindWindowExW( band, NULL, L"MSTaskSwWClass", NULL )) || !GetWindowRect( band, &task ))
+        return FALSE;
+    task.right = min( task.right, task.left + 160 );
+    InflateRect( &task, 0, -2 );
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+    InflateRect( &work, GetSystemMetrics( SM_CXFRAME ), GetSystemMetrics( SM_CYFRAME ) );
+    OffsetRect( &placement.rcNormalPosition, work.left + GetSystemMetrics( SM_CXFRAME ),
+                work.top + GetSystemMetrics( SM_CYFRAME ) );
+
+    switch (command)
+    {
+    case SC_MINIMIZE:
+        if (style & WS_MINIMIZE) return FALSE;
+        *from = caption_rect( &window );
+        *to = task;
+        return TRUE;
+    case SC_MAXIMIZE:
+        if (style & WS_MAXIMIZE) return FALSE;
+        *from = (style & WS_MINIMIZE) ? task : caption_rect( &window );
+        *to = caption_rect( &work );
+        return TRUE;
+    case SC_RESTORE:
+        if (style & WS_MINIMIZE)
+        {
+            *from = task;
+            *to = caption_rect( (placement.flags & WPF_RESTORETOMAXIMIZED) ? &work : &placement.rcNormalPosition );
+            return TRUE;
+        }
+        if (!(style & WS_MAXIMIZE)) return FALSE;
+        *from = caption_rect( &window );
+        *to = caption_rect( &placement.rcNormalPosition );
+        return TRUE;
+    }
+    return FALSE;
+}
+
 LRESULT NC_HandleSysCommand( HWND hwnd, WPARAM wParam, LPARAM lParam )
 {
+    UINT command = wParam & 0xfff0;
+    RECT from, to;
+    BOOL animate = min_max_animation( hwnd, command, &from, &to );
+
+    /* As on XP: the caption flies to the taskbar once the window is gone,
+     * and from where it was before the window appears again. */
+    if (animate && command != SC_MINIMIZE) DrawAnimatedRects( hwnd, IDANI_CAPTION, &from, &to );
     if (!NtUserMessageCall( hwnd, WM_SYSCOMMAND, wParam, lParam, 0, NtUserDefWindowProc, FALSE ))
+    {
+        if (animate && command == SC_MINIMIZE && IsIconic( hwnd ))
+            DrawAnimatedRects( hwnd, IDANI_CAPTION, &from, &to );
         return 0;
+    }
+    if (animate && command == SC_MINIMIZE && IsIconic( hwnd )) DrawAnimatedRects( hwnd, IDANI_CAPTION, &from, &to );
 
     switch (wParam & 0xfff0)
     {
diff --git a/dlls/user32/uitools.c b/dlls/user32/uitools.c
index d4b51a9..79ceaf8 100644
--- a/dlls/user32/uitools.c
+++ b/dlls/user32/uitools.c
@@ -27,10 +27,15 @@
 #include "wingdi.h"
 #include "winuser.h"
 #include "user_private.h"
+#include "uxtheme.h"
 #include "controls.h"
 #include "wine/debug.h"
 #include "wine/win4wine.h"
 
+#ifndef IDANI_CAPTION
+#define IDANI_CAPTION 3
+#endif
+
 WINE_DEFAULT_DEBUG_CHANNEL(graphics);
 
 /* These tables are used in:
@@ -1518,9 +1523,111 @@ BOOL WINAPI DrawFocusRect( HDC hdc, const RECT* rc )
 /**********************************************************************
  *		DrawAnimatedRects (USER32.@)
  */
+static LRESULT CALLBACK animation_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_NCHITTEST) return HTTRANSPARENT;
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+/* Draws one frame of the caption that flies between two rectangles: the
+ * window's own caption (Luna's when a visual style is active), icon and title. */
+static void draw_animation_frame( HWND window, HWND popup, const RECT *rect )
+{
+    HTHEME (WINAPI *open_theme)( HWND, LPCWSTR );
+    HRESULT (WINAPI *draw_theme)( HTHEME, HDC, int, int, const RECT *, const RECT * );
+    HRESULT (WINAPI *close_theme)( HTHEME );
+    HMODULE uxtheme = GetModuleHandleW( L"uxtheme.dll" );
+    HTHEME theme = NULL;
+    RECT client = {0, 0, rect->right - rect->left, rect->bottom - rect->top};
+    NONCLIENTMETRICSW metrics = {.cbSize = sizeof(metrics)};
+    WCHAR title[256];
+    HFONT font = NULL, old_font;
+    HICON icon;
+    HDC dc;
+
+    NtUserSetWindowPos( popup, HWND_TOPMOST, rect->left, rect->top, client.right, client.bottom,
+                  SWP_NOACTIVATE | SWP_SHOWWINDOW );
+    if (!(dc = NtUserGetDCEx( popup, 0, DCX_WINDOW | DCX_CACHE ))) return;
+    if (uxtheme && (open_theme = (void *)GetProcAddress( uxtheme, "OpenThemeData" )) &&
+        (draw_theme = (void *)GetProcAddress( uxtheme, "DrawThemeBackground" )) &&
+        (close_theme = (void *)GetProcAddress( uxtheme, "CloseThemeData" )))
+        theme = open_theme( window, L"WINDOW" );
+    if (theme)
+    {
+        draw_theme( theme, dc, 1 /* WP_CAPTION */, 1 /* CS_ACTIVE */, &client, NULL );
+        close_theme( theme );
+    }
+    else
+    {
+        TRIVERTEX vertices[2] = {{0, 0}, {client.right, client.bottom}};
+        GRADIENT_RECT gradient = {0, 1};
+        COLORREF left = GetSysColor( COLOR_ACTIVECAPTION ), right = GetSysColor( COLOR_GRADIENTACTIVECAPTION );
+        vertices[0].Red = GetRValue( left ) << 8; vertices[0].Green = GetGValue( left ) << 8;
+        vertices[0].Blue = GetBValue( left ) << 8; vertices[1].Red = GetRValue( right ) << 8;
+        vertices[1].Green = GetGValue( right ) << 8; vertices[1].Blue = GetBValue( right ) << 8;
+        GdiGradientFill( dc, vertices, 2, &gradient, 1, GRADIENT_FILL_RECT_H );
+    }
+    client.left += 4;
+    if ((icon = (HICON)SendMessageW( window, WM_GETICON, ICON_SMALL2, 0 )) ||
+        (icon = (HICON)GetClassLongPtrW( window, GCLP_HICONSM )))
+    {
+        int size = GetSystemMetrics( SM_CXSMICON );
+        if (client.bottom >= size)
+            NtUserDrawIconEx( dc, client.left, (client.bottom - size) / 2, icon, size, size, 0, NULL, DI_NORMAL );
+        client.left += size + 4;
+    }
+    if (GetWindowTextW( window, title, ARRAY_SIZE(title) ) &&
+        SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0 ) &&
+        (font = CreateFontIndirectW( &metrics.lfCaptionFont )))
+    {
+        old_font = SelectObject( dc, font );
+        SetBkMode( dc, TRANSPARENT );
+        SetTextColor( dc, GetSysColor( COLOR_CAPTIONTEXT ) );
+        DrawTextW( dc, title, -1, &client, DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS | DT_NOPREFIX );
+        SelectObject( dc, old_font );
+        DeleteObject( font );
+    }
+    NtUserReleaseDC( popup, dc );
+    GdiFlush();
+}
+
 BOOL WINAPI DrawAnimatedRects( HWND hwnd, INT idAni, const RECT* lprcFrom, const RECT* lprcTo )
 {
-    FIXME("(%p,%d,%p,%p): stub\n",hwnd,idAni,lprcFrom,lprcTo);
+    static const WCHAR class_name[] = L"Win4WineCaptionAnimation";
+    static const int duration = 200, frames = 12;
+    /* The caption colour behind the first frame, rather than black. */
+    WNDCLASSW wc = {.lpfnWndProc = animation_proc, .lpszClassName = class_name,
+                    .hbrBackground = (HBRUSH)(COLOR_ACTIVECAPTION + 1)};
+    ANIMATIONINFO info = {.cbSize = sizeof(info)};
+    DWORD start;
+    HWND popup;
+
+    TRACE("(%p,%d,%p,%p)\n",hwnd,idAni,lprcFrom,lprcTo);
+    /* The caption animation of XP's minimize, maximize and restore, for the
+     * XP shell's session; Wine has none otherwise. */
+    if (win4wine_shell() != WIN4WINE_SHELL_XP || idAni != IDANI_CAPTION || !lprcFrom || !lprcTo) return TRUE;
+    if (!SystemParametersInfoW( SPI_GETANIMATION, sizeof(info), &info, 0 ) || !info.iMinAnimate) return TRUE;
+    /* In the program's module: user32's own is reserved for system classes. */
+    wc.hInstance = GetModuleHandleW( NULL );
+    RegisterClassW( &wc );
+    if (!(popup = CreateWindowExW( WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_TRANSPARENT,
+                                   class_name, L"", WS_POPUP, lprcFrom->left, lprcFrom->top, 1, 1,
+                                   NULL, NULL, wc.hInstance, NULL )))
+        return TRUE;
+    start = GetTickCount();
+    for (int i = 0; i <= frames; i++)
+    {
+        RECT rect;
+        int wait;
+        rect.left = lprcFrom->left + MulDiv( lprcTo->left - lprcFrom->left, i, frames );
+        rect.top = lprcFrom->top + MulDiv( lprcTo->top - lprcFrom->top, i, frames );
+        rect.right = lprcFrom->right + MulDiv( lprcTo->right - lprcFrom->right, i, frames );
+        rect.bottom = lprcFrom->bottom + MulDiv( lprcTo->bottom - lprcFrom->bottom, i, frames );
+        draw_animation_frame( hwnd, popup, &rect );
+        wait = (int)(start + MulDiv( duration, i + 1, frames + 1 ) - GetTickCount());
+        if (wait > 0) Sleep( wait );
+    }
+    NtUserDestroyWindow( popup );
     return TRUE;
 }
 
