From: Codex <codex@localhost>
Subject: [PATCH] user32: repaint the external shell's themed frame after WM_SETICON

Purpose: keep the Luna frame when a window changes its icon.
DefWindowProc repaints the caption with the classic code for WM_SETICON as
for WM_SETTEXT, but only the latter was followed by the themed frame of the
opted-in external shell. A folder window that navigated to another folder
sets that folder's icon, so its caption and borders turned into the classic
ones until the next activation change. Repaint the themed frame after
WM_SETICON too.

diff --git a/dlls/user32/defwnd.c b/dlls/user32/defwnd.c
index 8010c8d..840a734 100644
--- a/dlls/user32/defwnd.c
+++ b/dlls/user32/defwnd.c
@@ -270,7 +270,9 @@ LRESULT WINAPI DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam
         break;
     }
 
-    if (msg == WM_NCPAINT || msg == WM_NCACTIVATE || msg == WM_SETTEXT)
+    /* WM_SETICON repaints the caption with the classic code too, as when a
+     * folder window shows the icon of the folder it navigated to. */
+    if (msg == WM_NCPAINT || msg == WM_NCACTIVATE || msg == WM_SETTEXT || msg == WM_SETICON)
         external_shell_draw_nonclient( hwnd, NULL );
     else if (msg == WM_PRINT && (lParam & PRF_NONCLIENT) && !(lParam & (PRF_CHILDREN | PRF_OWNED)))
         external_shell_draw_nonclient( hwnd, (HDC)wParam );
@@ -348,7 +350,9 @@ LRESULT WINAPI DefWindowProcW(
         result = NtUserMessageCall( hwnd, msg, wParam, lParam, 0, NtUserDefWindowProc, FALSE );
         break;
     }
-    if (msg == WM_NCPAINT || msg == WM_NCACTIVATE || msg == WM_SETTEXT)
+    /* WM_SETICON repaints the caption with the classic code too, as when a
+     * folder window shows the icon of the folder it navigated to. */
+    if (msg == WM_NCPAINT || msg == WM_NCACTIVATE || msg == WM_SETTEXT || msg == WM_SETICON)
         external_shell_draw_nonclient( hwnd, NULL );
     else if (msg == WM_PRINT && (lParam & PRF_NONCLIENT) && !(lParam & (PRF_CHILDREN | PRF_OWNED)))
         external_shell_draw_nonclient( hwnd, (HDC)wParam );
