From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] kernelbase: GetGeoInfo GEO_FRIENDLYNAME and GEO_OFFICIALNAME

Purpose: XP's Regional and Language Options (intl.cpl) open on their
Regional Options page.
Windows behavior: GetGeoInfo(id, GEO_FRIENDLYNAME) gives the name of the
nation ("France"), which intl.cpl lists in Location (EnumSystemGeoID).
Wine before: an unimplemented type (0). The list stayed empty, and
intl.cpl looped forever looking for the current location in it.
Change: the English country name of a locale of that nation (its
LOCALE_SENGCOUNTRY), or the ISO code when no locale has it; official names
are the same names.
Scope: every Wine application (the types were unimplemented).
---
 dlls/kernelbase/locale.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/dlls/kernelbase/locale.c b/dlls/kernelbase/locale.c
index 651f45b..75f018d 100644
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -1774,6 +1774,21 @@ invalid:
 
 
 /* get geo information from the locale.nls file */
+/* the English name of a nation, from a locale of its country */
+static const WCHAR *get_geo_name( const struct geo_id *geo )
+{
+    UINT i;
+
+    for (i = 0; i < locale_table->nb_lcnames; i++)
+    {
+        const NLS_LOCALE_DATA *locale = get_locale_data( lcnames_index[i].idx );
+        if (!wcsicmp( locale_strings + locale->siso3166ctryname + 1, geo->iso2 ))
+            return locale_strings + locale->sengcountry + 1;
+    }
+    return NULL;
+}
+
+
 static int get_geo_info( const struct geo_id *geo, enum SYSGEOTYPE type,
                          WCHAR *buffer, int len, LANGID lang )
 {
@@ -1816,10 +1831,13 @@ static int get_geo_info( const struct geo_id *geo, enum SYSGEOTYPE type,
     case GEO_CURRENCYSYMBOL:
         str = geo->currsymbol;
         break;
-    case GEO_RFC1766:
-    case GEO_LCID:
     case GEO_FRIENDLYNAME:
     case GEO_OFFICIALNAME:
+        /* FIXME: localization, and official names */
+        if (!(str = get_geo_name( geo ))) str = geo->iso2;
+        break;
+    case GEO_RFC1766:
+    case GEO_LCID:
     case GEO_TIMEZONES:
     case GEO_OFFICIALLANGUAGES:
     case GEO_NAME:
