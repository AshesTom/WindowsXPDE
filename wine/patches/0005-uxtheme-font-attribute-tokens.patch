From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: parse theme font attributes separated by spaces

Purpose: read the bold and italic attributes of Luna's fonts.
Wine before: MSSTYLES_GetNextToken trimmed trailing spaces by reading the
character after the token, possibly beyond a length-delimited value, and
kept them otherwise; the font parser compared the whole field with "bold"
or "italic", so "Bold Italic" in one field was ignored. Luna's caption font
came out with weight 400 instead of 700 and Start::Button not italic.
Change: trim inside the token, and split the attribute field at commas and
spaces; spaces inside the face name are kept.
Evidence: tests/font_parser.py runs Wine's parser on self-authored strings,
including a bounded token followed by an inaccessible page.
Scope: every Wine application that uses themes.
Old patches: 0024.
---
 dlls/uxtheme/msstyles.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/dlls/uxtheme/msstyles.c b/dlls/uxtheme/msstyles.c
index ad09829..018b3fb 100644
--- a/dlls/uxtheme/msstyles.c
+++ b/dlls/uxtheme/msstyles.c
@@ -1401,7 +1401,7 @@ static BOOL MSSTYLES_GetNextToken(LPCWSTR lpStringStart, LPCWSTR lpStringEnd, LP
     start = cur;
     while(cur < lpStringEnd && *cur != ',') cur++;
     end = cur;
-    while(isSpace(*end)) end--;
+    while(end > start && isSpace(end[-1])) end--;
 
     lstrcpynW(lpBuff, start, min(buffSize, end-start+1));
 
@@ -1476,7 +1476,17 @@ static HRESULT MSSTYLES_GetFont (LPCWSTR lpCur, LPCWSTR lpEnd,
     pFont->lfHeight = pointSize;
     pFont->lfWeight = FW_REGULAR;
     pFont->lfCharSet = DEFAULT_CHARSET;
-    while(MSSTYLES_GetNextToken(lpCur, lpEnd, &lpCur, attr, ARRAY_SIZE(attr))) {
+    /* Font attributes may share a comma-delimited field ("Bold Italic").
+     * Keep the face-name tokenizer separate, since names contain spaces. */
+    while(lpCur < lpEnd) {
+        LPCWSTR start;
+        unsigned int length;
+        while(lpCur < lpEnd && (isSpace(*lpCur) || *lpCur == ',')) lpCur++;
+        start = lpCur;
+        while(lpCur < lpEnd && !isSpace(*lpCur) && *lpCur != ',') lpCur++;
+        length = min(lpCur - start, ARRAY_SIZE(attr) - 1);
+        memcpy(attr, start, length * sizeof(WCHAR));
+        attr[length] = 0;
         if(!lstrcmpiW(L"bold", attr)) pFont->lfWeight = FW_BOLD;
         else if(!lstrcmpiW(L"italic", attr)) pFont->lfItalic = TRUE;
         else if(!lstrcmpiW(L"underline", attr)) pFont->lfUnderline = TRUE;
