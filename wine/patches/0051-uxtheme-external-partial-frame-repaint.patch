From: Codex <codex@localhost>
Subject: [PATCH] uxtheme, user32: repaint the external shell's Luna frame only where needed

Purpose: let a Luna frame follow its window, and the bridge's frames their
native clients, without repainting all of it.
XP behavior: moving a window keeps its region and non-client pixels; only a
size, frame or visibility change rebuilds them, and WM_NCPAINT repaints the
update region it receives.
Wine before: the caption was repainted and its region rebuilt on every
WM_WINDOWPOSCHANGED (about 10 ms per move of a bridge frame, before Wine
sent the move to X), and every WM_NCPAINT repainted the whole caption (about
9 ms), also when only borders or client pixels were exposed.
Change: skip the repaint when WM_WINDOWPOSCHANGED has SWP_NOSIZE without
SWP_FRAMECHANGED, SWP_SHOWWINDOW or SWP_HIDEWINDOW. When a WM_NCPAINT update
region does not reach the caption band, draw into a window DC clipped to it,
and draw only the borders when the clip excludes the caption.
Evidence: tests/wm_latency.py: a native client's frame follows a move in
11 ms instead of 148 ms on the Debian VM, together with the event-driven
bridge.
Scope: only with WIN4WINE_EXTERNAL_SHELL and themed frames.
Old patches: 0074, 0075.
---
 dlls/user32/defwnd.c  | 38 ++++++++++++++++++++++++++++++++++++--
 dlls/uxtheme/window.c | 20 +++++++++++++++++---
 2 files changed, 53 insertions(+), 5 deletions(-)

diff --git a/dlls/user32/defwnd.c b/dlls/user32/defwnd.c
index 2b30c16..b9aa343 100644
--- a/dlls/user32/defwnd.c
+++ b/dlls/user32/defwnd.c
@@ -92,6 +92,36 @@ static void external_shell_draw_nonclient( HWND hwnd, HDC dc )
     if (draw) draw( hwnd, dc );
 }
 
+/* RDW_FRAME sends WM_NCPAINT even when only client pixels or the side and
+ * bottom borders were exposed, as when a bridged native window moves off its
+ * frame. Repaint just that part unless the update reaches the caption. */
+static void external_shell_paint_nonclient( HWND hwnd, HRGN update )
+{
+    RECT window, caption;
+    POINT origin = {0, 0};
+    HRGN clip;
+    HDC dc;
+
+    GetWindowRect( hwnd, &window );
+    ClientToScreen( hwnd, &origin );
+    SetRect( &caption, window.left, window.top, window.right, origin.y );
+    if ((UINT_PTR)update <= 1 || RectInRegion( update, &caption ) ||
+        !(clip = CreateRectRgn( 0, 0, 0, 0 )))
+    {
+        external_shell_draw_nonclient( hwnd, NULL );
+        return;
+    }
+    CombineRgn( clip, update, NULL, RGN_COPY );
+    /* The DC owns the clip region from here on. */
+    if (!(dc = NtUserGetDCEx( hwnd, clip, DCX_USESTYLE | DCX_WINDOW | DCX_INTERSECTRGN )))
+    {
+        DeleteObject( clip );
+        return;
+    }
+    external_shell_draw_nonclient( hwnd, dc );
+    NtUserReleaseDC( hwnd, dc );
+}
+
 static LRESULT external_shell_nonclient_hit( HWND hwnd, LPARAM point, LRESULT original )
 {
     HMODULE theme;
@@ -273,7 +303,9 @@ LRESULT WINAPI DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam
 
     /* WM_SETICON repaints the caption with the classic code too, as when a
      * folder window shows the icon of the folder it navigated to. */
-    if (msg == WM_NCPAINT || msg == WM_NCACTIVATE || msg == WM_SETTEXT || msg == WM_SETICON)
+    if (msg == WM_NCPAINT)
+        external_shell_paint_nonclient( hwnd, (HRGN)wParam );
+    else if (msg == WM_NCACTIVATE || msg == WM_SETTEXT || msg == WM_SETICON)
         external_shell_draw_nonclient( hwnd, NULL );
     else if (msg == WM_PRINT && (lParam & PRF_NONCLIENT) && !(lParam & (PRF_CHILDREN | PRF_OWNED)))
         external_shell_draw_nonclient( hwnd, (HDC)wParam );
@@ -353,7 +385,9 @@ LRESULT WINAPI DefWindowProcW(
     }
     /* WM_SETICON repaints the caption with the classic code too, as when a
      * folder window shows the icon of the folder it navigated to. */
-    if (msg == WM_NCPAINT || msg == WM_NCACTIVATE || msg == WM_SETTEXT || msg == WM_SETICON)
+    if (msg == WM_NCPAINT)
+        external_shell_paint_nonclient( hwnd, (HRGN)wParam );
+    else if (msg == WM_NCACTIVATE || msg == WM_SETTEXT || msg == WM_SETICON)
         external_shell_draw_nonclient( hwnd, NULL );
     else if (msg == WM_PRINT && (lParam & PRF_NONCLIENT) && !(lParam & (PRF_CHILDREN | PRF_OWNED)))
         external_shell_draw_nonclient( hwnd, (HDC)wParam );
diff --git a/dlls/uxtheme/window.c b/dlls/uxtheme/window.c
index a3ad02a..15b311e 100644
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -40,6 +40,14 @@ struct caption_region
     BOOL updating, abandoned;
 };
 
+/* A move keeps the window's size, so its region and caption pixels stay. */
+static BOOL moved_only(UINT msg, LPARAM lparam)
+{
+    const WINDOWPOS *pos = (const WINDOWPOS *)lparam;
+    return msg == WM_WINDOWPOSCHANGED && (pos->flags & SWP_NOSIZE) &&
+           !(pos->flags & (SWP_FRAMECHANGED | SWP_SHOWWINDOW | SWP_HIDEWINDOW));
+}
+
 static LRESULT CALLBACK caption_region_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
 {
     struct caption_region *region = (void *)GetPropW(hwnd, region_property);
@@ -58,7 +66,8 @@ static LRESULT CALLBACK caption_region_proc(HWND hwnd, UINT msg, WPARAM wparam,
 
     result = CallWindowProcW(original, hwnd, msg, wparam, lparam);
     if ((msg == WM_WINDOWPOSCHANGED || msg == WM_STYLECHANGED || msg == WM_DPICHANGED ||
-         msg == WM_THEMECHANGED) && GetPropW(hwnd, region_property) == (HANDLE)region && !region->updating)
+         msg == WM_THEMECHANGED) && GetPropW(hwnd, region_property) == (HANDLE)region && !region->updating &&
+        !moved_only(msg, lparam))
         Win4WineDrawNonClient(hwnd, NULL);
     return result;
 }
@@ -356,7 +365,7 @@ BOOL WINAPI Win4WineDrawNonClient(HWND hwnd, HDC target)
     DWORD style = GetWindowLongW(hwnd, GWL_STYLE), exstyle = GetWindowLongW(hwnd, GWL_EXSTYLE);
     RECT window, client, caption, part, text, buttons[3];
     POINT origin;
-    BOOL active, maximized;
+    BOOL active, maximized, caption_visible;
     int saved, border_x, border_y, caption_height, state;
     LOGFONTW lf;
     HFONT font = NULL;
@@ -427,13 +436,17 @@ BOOL WINAPI Win4WineDrawNonClient(HWND hwnd, HDC target)
      * row that would otherwise stay in the window colour above the client. */
     caption.bottom = max(caption.bottom, min(border_y + GetSystemMetrics(SM_CYCAPTION), client.top));
     if (!target) caption_region_update(hwnd, theme, &caption, maximized);
-    DrawThemeBackground(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, &caption, NULL);
+    /* A target clipped to the borders skips the caption, the costly part. */
+    caption_visible = RectVisible(dc, &caption);
+    if (caption_visible)
+        DrawThemeBackground(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, &caption, NULL);
     part = window; part.top = caption.bottom; part.right = border_x;
     DrawThemeBackground(theme, dc, WP_FRAMELEFT, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
     part = window; part.top = caption.bottom; part.left = window.right - border_x;
     DrawThemeBackground(theme, dc, WP_FRAMERIGHT, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
     part = window; part.top = window.bottom - border_y;
     DrawThemeBackground(theme, dc, WP_FRAMEBOTTOM, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
+    if (!caption_visible) goto done;
 
     text = caption;
     text.top = border_y;
@@ -502,6 +515,7 @@ BOOL WINAPI Win4WineDrawNonClient(HWND hwnd, HDC target)
     text.bottom = text.top + GetSystemMetrics(SM_CYCAPTION);
     DrawThemeText(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, title, -1,
                   DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS, 0, &text);
+done:
     RestoreDC(dc, saved);
     if (font) DeleteObject(font);
     if (!target) ReleaseDC(hwnd, dc);
