From: Codex <codex@localhost>
Subject: [PATCH] user32: make external shell rebar default alignment explicit

Purpose: prevent the XP folder rebar from starting below its parent client.
A public CreateWindowExW/GetWindowRect/MapWindowPoints probe with the user's
native SP3 v6 control reproduces a 36px offset for alignment bits zero, while
explicit CCS_TOP starts at y=0. Native browseui then resizes with SWP_NOMOVE,
retaining that offset and clipping its bottom (address) band.
Normalize the documented default to explicit CCS_TOP before construction,
only for named child ReBarWindow32 controls and external-shell opt-in. Keep
explicit alignment styles unchanged. This does not patch Microsoft binaries.

diff --git a/dlls/user32/win.c b/dlls/user32/win.c
index 99f681a..f0032c6 100644
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -22,6 +22,7 @@
 #define WIN32_NO_STATUS
 #include "user_private.h"
 #include "controls.h"
+#include "commctrl.h"
 #include "winver.h"
 #include "wine/asm.h"
 #include "wine/exception.h"
@@ -302,6 +303,14 @@ HWND WIN_CreateWindowEx( CREATESTRUCTW *cs, LPCWSTR className, HINSTANCE module,
           cs->hwndParent, cs->hMenu, cs->hInstance, cs->lpCreateParams );
     if(TRACE_ON(win)) dump_window_styles( cs->style, cs->dwExStyle );
 
+    /* Native XP rebar initialization with unspecified alignment can move the
+     * control to its original bottom edge before adding CCS_TOP. Give it the
+     * documented default up front in the opt-in external shell. */
+    if (!IS_INTRESOURCE(className) && !wcsicmp(className, L"ReBarWindow32")
+        && (cs->style & WS_CHILD) && !(cs->style & (CCS_TOP | CCS_NOMOVEY))
+        && GetEnvironmentVariableW( L"WIN4WINE_EXTERNAL_SHELL", NULL, 0 ))
+        cs->style |= CCS_TOP;
+
     /* Fix the styles for MDI children */
     if (cs->dwExStyle & WS_EX_MDICHILD)
     {
