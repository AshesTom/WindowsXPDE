From: Codex <codex@localhost>
Subject: [PATCH] win32u: report window drags to the bridge, which snaps windows

Purpose: window snapping (opt-in, session.json "window_snap"; bridge-wm's
proxy does it): a caption dragged to an edge of the screen snaps the window
to half of it or maximizes it, a snapped window dragged away gets its size
back, and a maximized window dragged by its caption is restored, as on
Windows 7.
Windows behavior: the move and size loop sends EVENT_SYSTEM_MOVESIZESTART
and EVENT_SYSTEM_MOVESIZEEND. XP itself has no snapping.
Wine before: the loop sent neither, and another process could not tell a
drag of a caption from a resize or a click, nor change a dragged window's
size: the loop moves it with SWP_NOSIZE from the rectangle it started with.
Change: for top-level windows, the loop sends the two WinEvents and keeps
the hit test in the "Win4WineSizeMove" property while it runs, then the hit
test with 0x1000 (ended), 0x100 (moved) and 0x200 (cancelled). At the first
mouse move of a caption drag, a window with "Win4WineSnapRestore" (width in
the low word, height in the high word; the proxy sets it when it snaps the
window) gets that size, the pointer keeping its place along the caption,
and the property is removed. With WIN4WINE_WINDOW_SNAP=1 the loop also
runs for a maximized window's caption: once the pointer leaves the drag
rectangle, it sends SC_RESTORE, gives the restored size the same way and
keeps where the window was restored to in "Win4WineSizeMoveRestored" (left
and top plus 0x8000), since GetWindowPlacement gives other processes no
normal position.
Evidence: tests/size-move-snap.c (a click: 2, then 1002; a drag: 2, then
1102, the snapped 400x300 window became 200x150 under the pointer; before:
no events and the size kept; a maximized window dragged: restored to its
320x240 under the pointer with WIN4WINE_WINDOW_SNAP=1, still maximized
without it). In the test VM with window_snap, Notepad and
Mousepad's frame snap by dragging to the left, right and top edges, under
the XP shell (Luna) and the ReactOS shell, and maximized ones come out of
maximization by a drag, on X11 and Wayland.
Scope: only with WIN4WINE_EXTERNAL_SHELL; restoring a maximized window only
with WIN4WINE_WINDOW_SNAP=1 too. The Wayland session's labwc moves restored
Wine windows itself (_NET_WM_MOVERESIZE) and snaps them with its own
snapping; maximized ones, which winex11 does not hand to the window
manager, go through this loop there too.
---
 dlls/win32u/defwnd.c | 95 ++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 93 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index 58c7004..280f1f3 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -667,6 +667,68 @@ static BOOL on_bottom_border( int hit )
     return hit == HTBOTTOM || hit == HTBOTTOMLEFT || hit == HTBOTTOMRIGHT;
 }
 
+/* win4wine: with WIN4WINE_EXTERNAL_SHELL, the bridge's proxy snaps windows
+ * to half of the screen (an opt-in, like Windows 7's Aero Snap). It reads
+ * "Win4WineSizeMove" (the hit test while a move or size runs; after it, the
+ * hit test with SIZE_MOVE_ENDED, SIZE_MOVE_MOVED and SIZE_MOVE_CANCELLED)
+ * when EVENT_SYSTEM_MOVESIZESTART and EVENT_SYSTEM_MOVESIZEEND arrive, as on
+ * Windows. A window it snapped has "Win4WineSnapRestore" (width in the low
+ * word, height in the high word): dragging its caption away gives that size
+ * back, the pointer staying at the same place along the caption. With
+ * WIN4WINE_WINDOW_SNAP=1 (the session's window_snap), a maximized window
+ * can be dragged by its caption too: past the drag rectangle it is restored
+ * (SC_RESTORE) and moves on in its restored size, as on Windows 7; where it
+ * was restored to is in "Win4WineSizeMoveRestored" (left and top plus 0x8000
+ * in the low and high word), as other processes get no normal position. */
+#define SIZE_MOVE_ENDED     0x1000
+#define SIZE_MOVE_MOVED     0x0100
+#define SIZE_MOVE_CANCELLED 0x0200
+static const WCHAR size_moveW[] = {'W','i','n','4','W','i','n','e','S','i','z','e','M','o','v','e',0};
+static const WCHAR snap_restoreW[] =
+    {'W','i','n','4','W','i','n','e','S','n','a','p','R','e','s','t','o','r','e',0};
+static const WCHAR size_move_restoredW[] =
+    {'W','i','n','4','W','i','n','e','S','i','z','e','M','o','v','e','R','e','s','t','o','r','e','d',0};
+
+static BOOL window_snap(void)
+{
+    const char *value = getenv( "WIN4WINE_WINDOW_SNAP" );
+    return value && !strcmp( value, "1" );
+}
+
+/* Give the window being dragged this size, the pointer on its caption. */
+static void resize_moving_window( HWND hwnd, RECT *sizing_rect, POINT capture_point, int width, int height )
+{
+    int old_width = sizing_rect->right - sizing_rect->left;
+
+    if (width <= 0 || height <= 0 || old_width <= 0) return;
+    sizing_rect->left = capture_point.x - (LONGLONG)(capture_point.x - sizing_rect->left) * width / old_width;
+    sizing_rect->right = sizing_rect->left + width;
+    sizing_rect->bottom = sizing_rect->top + height;
+    NtUserSetWindowPos( hwnd, 0, sizing_rect->left, sizing_rect->top, width, height,
+                        SWP_NOACTIVATE | SWP_NOZORDER );
+}
+
+static void unsnap_moving_window( HWND hwnd, RECT *sizing_rect, POINT capture_point )
+{
+    UINT_PTR size = (UINT_PTR)NtUserRemoveProp( hwnd, snap_restoreW );
+
+    if (size) resize_moving_window( hwnd, sizing_rect, capture_point, LOWORD( size ), HIWORD( size ) );
+}
+
+/* A maximized window dragged by its caption: restore it, then size it as such. */
+static BOOL restore_moving_window( HWND hwnd, RECT *sizing_rect, POINT capture_point )
+{
+    RECT rect;
+
+    send_message( hwnd, WM_SYSCOMMAND, SC_RESTORE, MAKELONG( capture_point.x, capture_point.y ) );
+    if (is_zoomed( hwnd )) return FALSE;
+    get_window_rect( hwnd, &rect, get_thread_dpi() );
+    NtUserSetProp( hwnd, size_move_restoredW,
+                   UlongToHandle( MAKELONG( rect.left + 0x8000, rect.top + 0x8000 ) ) );
+    resize_moving_window( hwnd, sizing_rect, capture_point, rect.right - rect.left, rect.bottom - rect.top );
+    return TRUE;
+}
+
 /***********************************************************************
  *           sys_command_size_move
  *
@@ -675,7 +737,7 @@ static BOOL on_bottom_border( int hit )
 static void sys_command_size_move( HWND hwnd, WPARAM wparam )
 {
     DWORD msg_pos = NtUserGetThreadInfo()->message_pos;
-    BOOL thickframe, drag_full_windows = TRUE, moved = FALSE;
+    BOOL thickframe, drag_full_windows = TRUE, moved = FALSE, snap, zoomed;
     RECT sizing_rect, mouse_rect, orig_rect;
     UINT hittest = wparam & 0x0f;
     UINT syscommand = wparam & 0xfff0;
@@ -687,7 +749,10 @@ static void sys_command_size_move( HWND hwnd, WPARAM wparam )
     HDC hdc;
     MSG msg;
 
-    if (is_zoomed( hwnd ) || !is_window_visible( hwnd )) return;
+    zoomed = is_zoomed( hwnd );
+    if ((zoomed && !(syscommand == SC_MOVE && hittest == HTCAPTION && !(style & WS_CHILD) &&
+                     win4wine_external_shell() && window_snap())) || !is_window_visible( hwnd ))
+        return;
 
     thickframe = (style & WS_THICKFRAME) && !((style & (WS_DLGFRAME | WS_BORDER)) == WS_DLGFRAME);
 
@@ -779,6 +844,13 @@ static void sys_command_size_move( HWND hwnd, WPARAM wparam )
     send_message( hwnd, WM_ENTERSIZEMOVE, 0, 0 );
     set_capture_window( hwnd, GUI_INMOVESIZE, NULL );
 
+    snap = !parent && win4wine_external_shell();
+    if (snap)
+    {
+        NtUserSetProp( hwnd, size_moveW, UlongToHandle( hittest ) );
+        NtUserNotifyWinEvent( EVENT_SYSTEM_MOVESIZESTART, hwnd, OBJID_WINDOW, CHILDID_SELF );
+    }
+
     for (;;)
     {
         int dx = 0, dy = 0;
@@ -843,11 +915,22 @@ static void sys_command_size_move( HWND hwnd, WPARAM wparam )
         dx = pt.x - capture_point.x;
         dy = pt.y - capture_point.y;
 
+        if (zoomed && (dx || dy))
+        {
+            /* Still maximized: not before the pointer leaves the drag rectangle */
+            if (abs( dx ) <= get_system_metrics( SM_CXDRAG ) && abs( dy ) <= get_system_metrics( SM_CYDRAG ))
+                continue;
+            if (!restore_moving_window( hwnd, &sizing_rect, capture_point )) continue;
+            zoomed = FALSE;
+        }
+
         if (dx || dy)
         {
             if (!moved)
             {
                 moved = TRUE;
+                if (snap && hittest == HTCAPTION && msg.message == WM_MOUSEMOVE)
+                    unsnap_moving_window( hwnd, &sizing_rect, capture_point );
                 if (!drag_full_windows)
                     draw_moving_frame( parent, hdc, &sizing_rect, thickframe );
             }
@@ -928,6 +1011,14 @@ static void sys_command_size_move( HWND hwnd, WPARAM wparam )
         }
     }
 
+    if (snap)
+    {
+        BOOL cancelled = msg.message == WM_KEYDOWN && msg.wParam == VK_ESCAPE;
+        NtUserSetProp( hwnd, size_moveW, UlongToHandle( hittest | SIZE_MOVE_ENDED |
+                       (moved ? SIZE_MOVE_MOVED : 0) | (cancelled ? SIZE_MOVE_CANCELLED : 0) ) );
+        NtUserNotifyWinEvent( EVENT_SYSTEM_MOVESIZEEND, hwnd, OBJID_WINDOW, CHILDID_SELF );
+    }
+
     if (is_iconic(hwnd) && !moved && (style & WS_SYSMENU))
     {
         /* Single click brings up the system menu when iconized */
