 dlls/uxtheme/font-profile.c | 172 ++++++++++++++++++++++++++++++++++++++++++++
 dlls/uxtheme/metric.c       |   1 +
 dlls/uxtheme/msstyles.c     |  11 +++
 dlls/uxtheme/msstyles.h     |   4 ++
 dlls/uxtheme/property.c     |   1 +
 dlls/uxtheme/system.c       |   1 +
 7 files changed, 191 insertions(+)

