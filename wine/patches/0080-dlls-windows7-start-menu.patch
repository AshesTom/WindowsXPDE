diff --git a/dlls/user32/message.c b/dlls/user32/message.c
index 205d3e0..f77916c 100644
--- a/dlls/user32/message.c
+++ b/dlls/user32/message.c
@@ -1258,3 +1258,124 @@ BOOL WINAPI ChangeWindowMessageFilterEx( HWND hwnd, UINT message, DWORD action,
     FIXME( "%p %x %ld %p\n", hwnd, message, action, changefilter );
     return TRUE;
 }
+
+
+/* Message pump hooks (Windows 7's DirectUser registers one). The hook receives the
+ * functions user32 would use and may return its own; as in ReactOS, the hook is
+ * only registered here and the message functions are not routed through it. */
+
+typedef struct
+{
+    DWORD cbSize;
+    BOOL  (WINAPI *internal_get_message)( MSG *msg, HWND hwnd, UINT first, UINT last, UINT flags, BOOL get );
+    BOOL  (WINAPI *wait_message_ex)( DWORD mask, UINT timeout );
+    DWORD (WINAPI *get_queue_status)( UINT flags );
+    DWORD (WINAPI *msg_wait_for_multiple_objects_ex)( DWORD count, const HANDLE *handles, DWORD timeout,
+                                                     DWORD mask, DWORD flags );
+} USER_MESSAGE_PUMP_ADDRESSES;
+
+typedef BOOL (WINAPI *MESSAGEPUMPHOOKPROC)( BOOL unregistering, USER_MESSAGE_PUMP_ADDRESSES *addresses );
+
+static BOOL WINAPI real_internal_get_message( MSG *msg, HWND hwnd, UINT first, UINT last, UINT flags, BOOL get )
+{
+    if (get) return GetMessageW( msg, hwnd, first, last );
+    return PeekMessageW( msg, hwnd, first, last, flags );
+}
+
+static BOOL WINAPI real_wait_message_ex( DWORD mask, UINT timeout )
+{
+    return NtUserMsgWaitForMultipleObjectsEx( 0, NULL, timeout, mask, 0 ) != WAIT_FAILED;
+}
+
+static DWORD WINAPI real_get_queue_status( UINT flags )
+{
+    return NtUserGetQueueStatus( flags );
+}
+
+static DWORD WINAPI real_msg_wait_for_multiple_objects_ex( DWORD count, const HANDLE *handles, DWORD timeout,
+                                                           DWORD mask, DWORD flags )
+{
+    return NtUserMsgWaitForMultipleObjectsEx( count, handles, timeout, mask, flags );
+}
+
+static CRITICAL_SECTION pump_hook_section;
+static CRITICAL_SECTION_DEBUG pump_hook_section_debug =
+{
+    0, 0, &pump_hook_section,
+    { &pump_hook_section_debug.ProcessLocksList, &pump_hook_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": pump_hook_section") }
+};
+static CRITICAL_SECTION pump_hook_section = { &pump_hook_section_debug, -1, 0, 0, 0, 0 };
+static MESSAGEPUMPHOOKPROC pump_hook;
+static USER_MESSAGE_PUMP_ADDRESSES pump_addresses;
+static unsigned int pump_hook_count;
+
+static void reset_pump_addresses( USER_MESSAGE_PUMP_ADDRESSES *addresses )
+{
+    addresses->cbSize = sizeof(*addresses);
+    addresses->internal_get_message = real_internal_get_message;
+    addresses->wait_message_ex = real_wait_message_ex;
+    addresses->get_queue_status = real_get_queue_status;
+    addresses->msg_wait_for_multiple_objects_ex = real_msg_wait_for_multiple_objects_ex;
+}
+
+/***********************************************************************
+ *		RegisterMessagePumpHook (USER32.@)
+ */
+BOOL WINAPI RegisterMessagePumpHook( MESSAGEPUMPHOOKPROC hook )
+{
+    BOOL ret = FALSE;
+
+    TRACE( "%p\n", hook );
+
+    if (!hook)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    EnterCriticalSection( &pump_hook_section );
+    if (!pump_hook_count)
+    {
+        USER_MESSAGE_PUMP_ADDRESSES addresses;
+
+        reset_pump_addresses( &addresses );
+        if (hook( FALSE, &addresses ) && addresses.cbSize)
+        {
+            memcpy( &pump_addresses, &addresses, min( addresses.cbSize, sizeof(pump_addresses) ));
+            pump_hook = hook;
+            pump_hook_count = 1;
+            ret = TRUE;
+        }
+    }
+    else if (pump_hook == hook)
+    {
+        pump_hook_count++;
+        ret = TRUE;
+    }
+    LeaveCriticalSection( &pump_hook_section );
+    return ret;
+}
+
+/***********************************************************************
+ *		UnregisterMessagePumpHook (USER32.@)
+ */
+BOOL WINAPI UnregisterMessagePumpHook(void)
+{
+    BOOL ret = FALSE;
+
+    TRACE( "\n" );
+
+    EnterCriticalSection( &pump_hook_section );
+    if (pump_hook_count)
+    {
+        if (!--pump_hook_count)
+        {
+            pump_hook( TRUE, NULL );
+            reset_pump_addresses( &pump_addresses );
+            pump_hook = NULL;
+        }
+        ret = TRUE;
+    }
+    LeaveCriticalSection( &pump_hook_section );
+    return ret;
+}
