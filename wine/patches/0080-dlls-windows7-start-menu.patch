new file mode 100644
index 0000000..baf0392
--- /dev/null
+++ b/dlls/samlib/main.c
@@ -0,0 +1,59 @@
+/*
+ * Security Accounts Manager client
+ *
+ * There is no SAM here: connecting fails, so callers take their error path
+ * instead of hitting unimplemented functions (Windows 7's shacct.dll).
