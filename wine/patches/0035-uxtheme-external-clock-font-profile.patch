From: Win4Wine contributors
Subject: [PATCH] uxtheme: read the external Japanese Luna clock font profile

Extend the existing validated opt-in part-font profile to TrayNotify Clock,
CLP_TIME/CLS_NORMAL/TMT_FONT only. ClockFont is a user-owned LOGFONT at base
96 DPI; missing or invalid values retain the original successful theme API
result. Active theme identity, path/color/size, and external-shell guards
remain shared with the existing Start/system profiles. No font literals,
resources, or Microsoft implementation are embedded in the DLL.

--- a/dlls/uxtheme/font-profile.c
+++ b/dlls/uxtheme/font-profile.c
@@ -122,14 +122,18 @@
     return cls && profile_font(cls->tf, dc, font_name(id), font);
 }
 
-BOOL UXTHEME_GetExternalStartFont(HTHEME theme, HDC dc, int part, int state,
+BOOL UXTHEME_GetExternalPartFont(HTHEME theme, HDC dc, int part, int state,
                                 int property, LOGFONTW *font)
 {
     PTHEME_CLASS cls = MSSTYLES_GetActiveThemeClass(theme);
-    if (!cls || lstrcmpiW(cls->szAppName, L"Start") || lstrcmpiW(cls->szClassName, L"Button")
-        || part != BP_PUSHBUTTON || state < 0 || state > PBS_DEFAULTED
-        || property != TMT_FONT) return FALSE;
-    return profile_font(cls->tf, dc, L"StartFont", font);
+    if (!cls || property != TMT_FONT) return FALSE;
+    if (!lstrcmpiW(cls->szAppName, L"Start") && !lstrcmpiW(cls->szClassName, L"Button")
+        && part == BP_PUSHBUTTON && state >= 0 && state <= PBS_DEFAULTED)
+        return profile_font(cls->tf, dc, L"StartFont", font);
+    if (!lstrcmpiW(cls->szAppName, L"TrayNotify") && !lstrcmpiW(cls->szClassName, L"Clock")
+        && part == CLP_TIME && state == CLS_NORMAL)
+        return profile_font(cls->tf, dc, L"ClockFont", font);
+    return FALSE;
 }
 
 void UXTHEME_ApplyExternalFonts(PTHEME_FILE file)
--- a/dlls/uxtheme/property.c
+++ b/dlls/uxtheme/property.c
@@ -131,7 +131,7 @@
      * logical screen DPI, as in GetThemeSysFont. */
     if (!hdc) hdc = screen_dc = GetDC(NULL);
     hr = MSSTYLES_GetPropertyFont(tp, hdc, pFont);
-    if (SUCCEEDED(hr)) UXTHEME_GetExternalStartFont(hTheme, hdc, iPartId, iStateId, iPropId, pFont);
+    if (SUCCEEDED(hr)) UXTHEME_GetExternalPartFont(hTheme, hdc, iPartId, iStateId, iPropId, pFont);
     if (screen_dc) ReleaseDC(NULL, screen_dc);
     return hr;
 }
--- a/dlls/uxtheme/msstyles.h
+++ b/dlls/uxtheme/msstyles.h
@@ -102,7 +102,7 @@
 UINT MSSTYLES_GetThemeDPI(PTHEME_CLASS tc);
 PTHEME_CLASS MSSTYLES_GetActiveThemeClass(HTHEME theme);
 BOOL UXTHEME_GetExternalFont(HTHEME theme, HDC dc, int id, LOGFONTW *font);
-BOOL UXTHEME_GetExternalStartFont(HTHEME theme, HDC dc, int part, int state, int property, LOGFONTW *font);
+BOOL UXTHEME_GetExternalPartFont(HTHEME theme, HDC dc, int part, int state, int property, LOGFONTW *font);
 void UXTHEME_ApplyExternalFonts(PTHEME_FILE file);
 PTHEME_PARTSTATE MSSTYLES_FindPart(PTHEME_CLASS tc, int iPartId);
 PTHEME_PARTSTATE MSSTYLES_FindPartState(PTHEME_CLASS tc, int iPartId, int iStateId, PTHEME_CLASS *tcNext);
