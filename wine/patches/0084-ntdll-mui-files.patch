From: Codex <codex@localhost>
Subject: [PATCH] ntdll: find resources in MUI files

Purpose: run Windows 7's shell with its DLLs and their MUI files as they
are on the media, instead of copies with the MUI resources written into
them.
Windows behavior: since Vista a DLL or executable that has an RT_MUI
resource ("MUI") is language neutral: the resources of each language (its
strings, menus and dialogs) are in <dir>\<language>\<file name>.mui. The
loader finds a resource that the module lacks in the MUI file of the
user's UI language, falling back to English (United States); this also
holds for a module loaded as a data file. LoadResource then returns the
MUI file's data.
Wine before: Wine read no MUI files, so Windows 7's explorer.exe and
shell32.dll had no strings and the shell ended at once, unless their
resources were written into copies of them.
Change: when LdrFindResource_U or LdrFindResourceDirectory_U do not find
a resource in a language neutral module, the module's MUI file (found
from its mapped file name, without WoW64 file system redirection: a
32-bit process that maps a 64-bit system32 DLL through sysnative finds the
MUI file beside it) is mapped read-only as a data file, once per module, and the resource is looked up there; LdrAccessResource returns
data of the MUI file for entries found in it. Modules without an RT_MUI
resource, among them Wine's own, are unchanged.
Evidence: Windows 7 SP1 x64 explorer.exe, shell32.dll, explorerframe.dll
and the other shell DLLs with system32\ja-JP\*.mui: the Start menu, the
taskbar and the folder windows show their Japanese strings, as with the
merged copies before. A 32-bit program that loads sysnative\shell32.dll as
a data file gets string 4162 ("デスクトップ") from system32\ja-JP.
Scope: language neutral modules with a MUI file beside them.
---
 dlls/ntdll/resource.c | 200 +++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 198 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/resource.c b/dlls/ntdll/resource.c
index 3de932e..3bae45b 100644
--- a/dlls/ntdll/resource.c
+++ b/dlls/ntdll/resource.c
@@ -251,6 +251,200 @@ done:
 }
 
 
+/**********************************************************************
+ *  MUI files
+ *
+ * A language neutral module (one with an RT_MUI resource, "MUI") keeps the
+ * resources of each language in <dir>\<language>\<file name>.mui. Those
+ * not found in the module are looked up there, in the user's UI language,
+ * then in English (United States).
+ */
+struct mui_file
+{
+    const void *module;  /* module base (without the data file bits) */
+    HMODULE     handle;  /* the MUI file mapped as data, or 0 */
+    SIZE_T      size;
+};
+
+static struct mui_file *mui_files;
+static unsigned int mui_count, mui_capacity;
+static RTL_CRITICAL_SECTION mui_section;
+static RTL_CRITICAL_SECTION_DEBUG mui_section_debug =
+{
+    0, 0, &mui_section,
+    { &mui_section_debug.ProcessLocksList, &mui_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": mui_section") }
+};
+static RTL_CRITICAL_SECTION mui_section = { &mui_section_debug, -1, 0, 0, 0, 0 };
+
+static BOOL is_language_neutral( HMODULE hmod )
+{
+    LDR_RESOURCE_INFO info = { .Type = (ULONG_PTR)L"MUI", .Name = 1 };
+    const void *res;
+
+    return !find_entry( hmod, &info, 2, &res, TRUE );
+}
+
+static HMODULE map_mui_file( const UNICODE_STRING *path, SIZE_T *size )
+{
+    OBJECT_ATTRIBUTES attr;
+    IO_STATUS_BLOCK io;
+    HANDLE file, section;
+    void *base = NULL;
+    NTSTATUS status;
+
+    ULONG redirect = 0;
+
+    /* PATH is beside the module's own file, whose name is already the real one:
+     * a 32-bit process that maps a 64-bit system32 DLL (through sysnative) must
+     * not be sent to syswow64 for its MUI file. */
+    InitializeObjectAttributes( &attr, (UNICODE_STRING *)path, OBJ_CASE_INSENSITIVE, 0, NULL );
+    RtlWow64EnableFsRedirectionEx( TRUE, &redirect );
+    status = NtOpenFile( &file, GENERIC_READ | SYNCHRONIZE, &attr, &io, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                         FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE );
+    RtlWow64EnableFsRedirectionEx( redirect, &redirect );
+    if (status) return 0;
+    status = NtCreateSection( &section, SECTION_MAP_READ | SECTION_QUERY, NULL, NULL, PAGE_READONLY, SEC_COMMIT, file );
+    NtClose( file );
+    if (status) return 0;
+    *size = 0;
+    status = NtMapViewOfSection( section, NtCurrentProcess(), &base, 0, 0, NULL, size, ViewShare, 0, PAGE_READONLY );
+    NtClose( section );
+    if (status) return 0;
+    if (!RtlImageNtHeader( base ))
+    {
+        NtUnmapViewOfSection( NtCurrentProcess(), base );
+        return 0;
+    }
+    return (HMODULE)((ULONG_PTR)base | 1);
+}
+
+/* the MUI file of the module at BASE, whose file is NAME (an NT path) */
+static HMODULE open_mui_file( const UNICODE_STRING *name, SIZE_T *size )
+{
+    WCHAR *path, *file;
+    UNICODE_STRING language, str;
+    LANGID lang;
+    HMODULE handle = 0;
+    unsigned int i, dir;
+
+    for (dir = name->Length / sizeof(WCHAR); dir && name->Buffer[dir - 1] != '\\'; dir--);
+    if (!dir) return 0;
+    file = name->Buffer + dir;
+    if (!(path = RtlAllocateHeap( GetProcessHeap(), 0, name->Length + (LOCALE_NAME_MAX_LENGTH + 8) * sizeof(WCHAR) )))
+        return 0;
+    for (i = 0; i < 2 && !handle; i++)
+    {
+        WCHAR buffer[LOCALE_NAME_MAX_LENGTH];
+
+        if (i == 0)
+        {
+            NtQueryDefaultUILanguage( &lang );
+            language.Buffer = buffer;
+            language.MaximumLength = sizeof(buffer);
+            if (RtlLcidToLocaleName( lang, &language, 0, FALSE )) continue;
+        }
+        else RtlInitUnicodeString( &language, L"en-US" );
+        memcpy( path, name->Buffer, dir * sizeof(WCHAR) );
+        memcpy( path + dir, language.Buffer, language.Length );
+        swprintf( path + dir + language.Length / sizeof(WCHAR), name->Length / sizeof(WCHAR) - dir + 6,
+                  L"\\%.*s.mui", (int)(name->Length / sizeof(WCHAR) - dir), file );
+        RtlInitUnicodeString( &str, path );
+        if ((handle = map_mui_file( &str, size ))) TRACE( "%s\n", debugstr_us( &str ));
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, path );
+    return handle;
+}
+
+/* the module's NT file name */
+static BOOL get_module_file_name( HMODULE hmod, UNICODE_STRING *name, BYTE *buffer, SIZE_T len )
+{
+    MEMORY_SECTION_NAME *info = (MEMORY_SECTION_NAME *)buffer;
+
+    if (NtQueryVirtualMemory( NtCurrentProcess(), (void *)((ULONG_PTR)hmod & ~3), MemoryMappedFilenameInformation,
+                              info, len, NULL )) return FALSE;
+    *name = info->SectionFileName;
+    return TRUE;
+}
+
+static HMODULE find_mui_file( HMODULE hmod )
+{
+    const void *base = (const void *)((ULONG_PTR)hmod & ~3);
+    BYTE buffer[sizeof(MEMORY_SECTION_NAME) + MAX_PATH * 2 * sizeof(WCHAR)];
+    UNICODE_STRING name;
+    HMODULE handle = 0;
+    SIZE_T size = 0;
+    unsigned int i;
+
+    RtlEnterCriticalSection( &mui_section );
+    for (i = 0; i < mui_count; i++)
+        if (mui_files[i].module == base) break;
+    if (i < mui_count) handle = mui_files[i].handle;
+    else
+    {
+        if (is_language_neutral( hmod ) && get_module_file_name( hmod, &name, buffer, sizeof(buffer) ))
+            handle = open_mui_file( &name, &size );
+        if (mui_count == mui_capacity)
+        {
+            unsigned int capacity = max( 16, mui_capacity * 2 );
+            struct mui_file *files = RtlReAllocateHeap( GetProcessHeap(), 0, mui_files, capacity * sizeof(*files) );
+            if (!mui_files) files = RtlAllocateHeap( GetProcessHeap(), 0, capacity * sizeof(*files) );
+            if (files)
+            {
+                mui_files = files;
+                mui_capacity = capacity;
+            }
+        }
+        if (mui_count < mui_capacity)
+        {
+            mui_files[mui_count].module = base;
+            mui_files[mui_count].handle = handle;
+            mui_files[mui_count].size = size;
+            mui_count++;
+        }
+    }
+    RtlLeaveCriticalSection( &mui_section );
+    return handle;
+}
+
+/* the MUI file that holds ENTRY, a resource found for HMOD, or 0 */
+static HMODULE mui_file_of_entry( HMODULE hmod, const void *entry )
+{
+    const void *base = (const void *)((ULONG_PTR)hmod & ~3);
+    HMODULE handle = 0;
+    unsigned int i;
+
+    RtlEnterCriticalSection( &mui_section );
+    for (i = 0; i < mui_count; i++)
+    {
+        const char *start = (const char *)((ULONG_PTR)mui_files[i].handle & ~3);
+        if (mui_files[i].module == base && mui_files[i].handle &&
+            (const char *)entry >= start && (const char *)entry < start + mui_files[i].size)
+        {
+            handle = mui_files[i].handle;
+            break;
+        }
+    }
+    RtlLeaveCriticalSection( &mui_section );
+    return handle;
+}
+
+static NTSTATUS find_entry_mui( HMODULE hmod, const LDR_RESOURCE_INFO *info,
+                                ULONG level, const void **ret, int want_dir )
+{
+    NTSTATUS status = find_entry( hmod, info, level, ret, want_dir );
+    HMODULE mui;
+
+    if ((status == STATUS_RESOURCE_TYPE_NOT_FOUND || status == STATUS_RESOURCE_NAME_NOT_FOUND ||
+         status == STATUS_RESOURCE_LANG_NOT_FOUND) && (mui = find_mui_file( hmod )))
+    {
+        NTSTATUS mui_status = find_entry( mui, info, level, ret, want_dir );
+        if (!mui_status) status = mui_status;
+    }
+    return status;
+}
+
+
 /**********************************************************************
  *	LdrFindResourceDirectory_U  (NTDLL.@)
  */
@@ -267,7 +461,7 @@ NTSTATUS WINAPI DECLSPEC_HOTPATCH LdrFindResourceDirectory_U( HMODULE hmod, cons
                      level > 1 ? debugstr_w((LPCWSTR)info->Name) : "",
                      level > 2 ? info->Language : 0, level );
 
-        status = find_entry( hmod, info, level, &res, TRUE );
+        status = find_entry_mui( hmod, info, level, &res, TRUE );
         if (status == STATUS_SUCCESS) *dir = res;
     }
     __EXCEPT_PAGE_FAULT
@@ -295,7 +489,7 @@ NTSTATUS WINAPI DECLSPEC_HOTPATCH LdrFindResource_U( HMODULE hmod, const LDR_RES
                      level > 1 ? debugstr_w((LPCWSTR)info->Name) : "",
                      level > 2 ? info->Language : 0, level );
 
-        status = find_entry( hmod, info, level, &res, FALSE );
+        status = find_entry_mui( hmod, info, level, &res, FALSE );
         if (status == STATUS_SUCCESS) *entry = res;
     }
     __EXCEPT_PAGE_FAULT
@@ -317,7 +511,9 @@ static inline NTSTATUS access_resource( HMODULE hmod, const IMAGE_RESOURCE_DATA_
 #endif
 {
     NTSTATUS status;
+    HMODULE mui = mui_count ? mui_file_of_entry( hmod, entry ) : 0;
 
+    if (mui) hmod = mui;
     __TRY
     {
         ULONG dirsize;
