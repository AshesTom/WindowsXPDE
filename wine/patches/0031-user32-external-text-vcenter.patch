From: win4wine maintainers
Subject: [PATCH] user32: round external single-line vertical centering once

Public XP GDI/theme measurements provide the geometry reference.
Keep ordinary Wine behavior outside the external shell opt-in.

--- a/dlls/user32/text.c
+++ b/dlls/user32/text.c
@@ -987,8 +987,13 @@
 
 	if (flags & DT_SINGLELINE)
 	{
-	    if (flags & DT_VCENTER) y = rect->top +
-	    	(rect->bottom - rect->top) / 2 - size.cy / 2;
+	    if (flags & DT_VCENTER)
+            {
+                if (GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0))
+                    y = rect->top + (rect->bottom - rect->top - size.cy) / 2;
+                else
+                    y = rect->top + (rect->bottom - rect->top) / 2 - size.cy / 2;
+            }
 	    else if (flags & DT_BOTTOM) y = rect->bottom - size.cy;
         }
 
