+#if __WINE_COMCTL32_VERSION == 6
+/* Windows 7 SP1 draws its bars with the style's translucent bar, whose
+ * content (the fill) is the whole client area, under the fill as well */
+static BOOL use_transparent_bar (HTHEME theme)
+{
+    return COMCTL32_IsWin7Shell() && IsThemePartDefined (theme, PP_TRANSPARENTBAR, 0);
+}
+
+static int get_bar_part (HTHEME theme, DWORD style)
+{
+    if (use_transparent_bar (theme))
+        return (style & PBS_VERTICAL) ? PP_TRANSPARENTBARVERT : PP_TRANSPARENTBAR;
+    return (style & PBS_VERTICAL) ? PP_BARVERT : PP_BAR;
+}
+#endif
