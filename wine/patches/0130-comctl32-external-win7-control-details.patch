diff --git a/dlls/comctl32/status.c b/dlls/comctl32/status.c
index f27453a..b98c049 100644
--- a/dlls/comctl32/status.c
+++ b/dlls/comctl32/status.c
@@ -102,6 +102,15 @@ STATUSBAR_ComputeHeight(STATUS_INFO *infoPtr)
     TEXTMETRICW tm;
     int margin;
 
+    /* Windows 7's comctl32 (measured on SP1 with tests/status-height.c): the
+     * default font's height, the borders and the vertical border on both
+     * sides, whatever font WM_SETFONT gave */
+    if (COMCTL32_IsWin7Shell())
+    {
+        COMCTL32_GetFontMetrics(infoPtr->hDefaultFont, &tm);
+        return max(tm.tmHeight + 2 * GetSystemMetrics(SM_CYBORDER), infoPtr->minHeight) + 2 * infoPtr->verticalBorder;
+    }
+
     COMCTL32_GetFontMetrics(infoPtr->hFont ? infoPtr->hFont : infoPtr->hDefaultFont, &tm);
     margin = (tm.tmInternalLeading ? tm.tmInternalLeading : 2);
     height = max(tm.tmHeight + margin + 2*GetSystemMetrics(SM_CYBORDER), infoPtr->minHeight) + infoPtr->verticalBorder;
