diff --git a/dlls/comctl32/trackbar.c b/dlls/comctl32/trackbar.c
index b0b5d24..0dddad2 100644
--- a/dlls/comctl32/trackbar.c
+++ b/dlls/comctl32/trackbar.c
@@ -269,20 +269,46 @@ static inline void TRACKBAR_LineDown(TRACKBAR_INFO *infoPtr)
     notify_with_scroll (infoPtr, TB_LINEDOWN);
 }
 
+
+/* Windows 7 SP1 (tests/trackbar-size.c, themed): a thumb pointing to one
+ * side is as wide as its 11x19 part scaled to its length (up to 19), and the
+ * channel ends half a thumb plus three pixels from the edges */
+static BOOL win7_trackbar(const TRACKBAR_INFO *infoPtr)
+{
+#if __WINE_COMCTL32_VERSION == 6
+    return COMCTL32_IsWin7Shell() && GetWindowTheme(infoPtr->hwndSelf);
+#else
+    return FALSE;
+#endif
+}
+
+static int thumb_width(const TRACKBAR_INFO *infoPtr)
+{
+    if (win7_trackbar(infoPtr) && !(infoPtr->dwStyle & TBS_BOTH))
+        return min(infoPtr->uThumbLen, 19) * 11 / 19;
+    return (infoPtr->uThumbLen / 2) | 1;
+}
+
 static void
 TRACKBAR_CalcChannel (TRACKBAR_INFO *infoPtr)
 {
-    INT cyChannel, offsetthumb, offsetedge;
+    INT cyChannel, offsetthumb, offsetedge, offsetend;
     RECT lpRect, *channel = & infoPtr->rcChannel;
 
     GetClientRect (infoPtr->hwndSelf, &lpRect);
 
     offsetthumb = infoPtr->uThumbLen / 4;
     offsetedge  = offsetthumb + 3;
+    offsetend   = offsetedge;
+    if (win7_trackbar(infoPtr))
+    {
+        offsetedge = (thumb_width(infoPtr) - 1) / 2 + 3;
+        offsetend = thumb_width(infoPtr) / 2 + 3;
+    }
     cyChannel   = (infoPtr->dwStyle & TBS_ENABLESELRANGE) ? offsetthumb*3 : 4;
     if (infoPtr->dwStyle & TBS_VERT) {
         channel->top    = lpRect.top + offsetedge;
-        channel->bottom = lpRect.bottom - offsetedge;
+        channel->bottom = lpRect.bottom - offsetend;
         if (infoPtr->dwStyle & TBS_ENABLESELRANGE)
             channel->left = lpRect.left + ((infoPtr->uThumbLen - cyChannel + 2) / 2);
         else
@@ -302,7 +328,7 @@ TRACKBAR_CalcChannel (TRACKBAR_INFO *infoPtr)
         channel->right = channel->left + cyChannel;
     } else {
         channel->left = lpRect.left + offsetedge;
-        channel->right = lpRect.right - offsetedge;
+        channel->right = lpRect.right - offsetend;
         if (infoPtr->dwStyle & TBS_ENABLESELRANGE)
             channel->top = lpRect.top + ((infoPtr->uThumbLen - cyChannel + 2) / 2);
         else
@@ -330,7 +356,7 @@ TRACKBAR_CalcThumb (const TRACKBAR_INFO *infoPtr, LONG lPos, RECT *thumb)
     RECT lpRect;
 
     range = infoPtr->lRangeMax - infoPtr->lRangeMin;
-    thumbwidth = (infoPtr->uThumbLen / 2) | 1;
+    thumbwidth = thumb_width(infoPtr);
 
     if (!range) range = 1;
 
@@ -485,17 +511,19 @@ static void
 TRACKBAR_DrawOneTic (const TRACKBAR_INFO *infoPtr, HDC hdc, LONG ticPos, int flags)
 {
     int x, y, ox, oy, range, side, indent = 0, len = 3;
-    int offsetthumb;
+    int offsetthumb, gap;
     RECT rcTics;
 
+    /* Windows 7 SP1 starts the ticks a pixel nearer the thumb */
+    gap = win7_trackbar(infoPtr) ? 1 : 2;
     if (flags & TBS_VERT) {
         offsetthumb = (infoPtr->rcThumb.bottom - infoPtr->rcThumb.top)/2;
-        SetRect(&rcTics, infoPtr->rcThumb.left - 2, infoPtr->rcChannel.top + offsetthumb,
-                infoPtr->rcThumb.right + 2, infoPtr->rcChannel.bottom - offsetthumb - 1);
+        SetRect(&rcTics, infoPtr->rcThumb.left - gap, infoPtr->rcChannel.top + offsetthumb,
+                infoPtr->rcThumb.right + gap, infoPtr->rcChannel.bottom - offsetthumb - 1);
     } else {
         offsetthumb = (infoPtr->rcThumb.right - infoPtr->rcThumb.left)/2;
-        SetRect(&rcTics, infoPtr->rcChannel.left + offsetthumb, infoPtr->rcThumb.top - 2,
-                infoPtr->rcChannel.right - offsetthumb - 1, infoPtr->rcThumb.bottom + 2);
+        SetRect(&rcTics, infoPtr->rcChannel.left + offsetthumb, infoPtr->rcThumb.top - gap,
+                infoPtr->rcChannel.right - offsetthumb - 1, infoPtr->rcThumb.bottom + gap);
     }
 
     if (flags & (TBS_TOP | TBS_LEFT)) {
@@ -1496,6 +1524,13 @@ TRACKBAR_InitializeThumb (TRACKBAR_INFO *infoPtr)
     RECT rect;
 
     infoPtr->uThumbLen = get_scaled_metric(infoPtr, infoPtr->dwStyle & TBS_ENABLESELRANGE ? 23 : 21);
+#if __WINE_COMCTL32_VERSION == 6
+    /* Windows 7 SP1 (tests/trackbar-size.c): 19 pixels, three more with
+     * ticks on both sides and two more again with a selection range */
+    if (COMCTL32_IsWin7Shell() && GetWindowTheme(infoPtr->hwndSelf))
+        infoPtr->uThumbLen = get_scaled_metric(infoPtr, !(infoPtr->dwStyle & TBS_BOTH) ? 19 :
+                                               infoPtr->dwStyle & TBS_ENABLESELRANGE ? 24 : 22);
+#endif
 
     if (!(infoPtr->dwStyle & TBS_FIXEDLENGTH))
     {
@@ -1505,7 +1540,20 @@ TRACKBAR_InitializeThumb (TRACKBAR_INFO *infoPtr)
         else
             client_size = rect.bottom - rect.top;
 
-        if (client_size < infoPtr->uThumbLen)
+        if (win7_trackbar(infoPtr) && (infoPtr->dwStyle & TBS_BOTH))
+        {
+            /* Windows 7 SP1: six pixels less than the client when it is shorter */
+            if (client_size < infoPtr->uThumbLen)
+                infoPtr->uThumbLen = max(client_size - get_scaled_metric(infoPtr, 6), get_scaled_metric(infoPtr, 4));
+        }
+        else if (win7_trackbar(infoPtr) && !(infoPtr->dwStyle & TBS_NOTICKS))
+        {
+            /* seven less with the ticks on one side, down to four pixels */
+            if (client_size < infoPtr->uThumbLen + get_scaled_metric(infoPtr, 7) &&
+                client_size > get_scaled_metric(infoPtr, 10))
+                infoPtr->uThumbLen = client_size - get_scaled_metric(infoPtr, 7);
+        }
+        else if (client_size < infoPtr->uThumbLen)
             infoPtr->uThumbLen = client_size > get_scaled_metric(infoPtr, 9) ?
                 client_size - get_scaled_metric(infoPtr, 5) : get_scaled_metric(infoPtr, 4);
     }
