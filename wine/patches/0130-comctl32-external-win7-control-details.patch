+        DrawThemeParentBackground(lphc->self, hdc, &client);
+    DrawThemeBackground(theme, hdc, CP_READONLY, state, &client, NULL);
+    /* the arrow stays as it is; its hot and pressed states are the button of an editable box */
+    DrawThemeBackground(theme, hdc, CP_DROPDOWNBUTTONRIGHT, state == CBRO_DISABLED ? CBXSR_DISABLED : CBXSR_NORMAL,
