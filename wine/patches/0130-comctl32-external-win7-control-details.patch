@@ -340,8 +360,9 @@ static void PROGRESS_DrawBackground (const PROGRESS_INFO *infoPtr, HDC hdc, Prog
 static BOOL PROGRESS_IsSmooth(HWND hwnd)
 {
 #if __WINE_COMCTL32_VERSION == 6
