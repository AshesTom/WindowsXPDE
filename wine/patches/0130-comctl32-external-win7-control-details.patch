+/* Windows 7 SP1 frames a themed edit control with the style's edit border
+ * for its scroll bars, blue under the mouse and when focused */
+static int win7_edit_border(HWND hwnd, HTHEME theme, int *state)
+{
+    DWORD style = GetWindowLongW(hwnd, GWL_STYLE);
+    EDITSTATE *es = (EDITSTATE *)GetWindowLongPtrW(hwnd, 0);
+
+    if (!COMCTL32_IsWin7Shell() || !IsThemePartDefined(theme, EP_EDITBORDER_NOSCROLL, 0)) return 0;
+    if (!IsWindowEnabled(hwnd)) *state = EPSN_DISABLED;
+    else if (GetFocus() == hwnd) *state = EPSN_FOCUSED;
+    else if (es && es->hot) *state = EPSN_HOT;
+    else *state = EPSN_NORMAL;
+    if ((style & (WS_HSCROLL | WS_VSCROLL)) == (WS_HSCROLL | WS_VSCROLL)) return EP_EDITBORDER_HVSCROLL;
+    if (style & WS_VSCROLL) return EP_EDITBORDER_VSCROLL;
+    if (style & WS_HSCROLL) return EP_EDITBORDER_HSCROLL;
+    return EP_EDITBORDER_NOSCROLL;
+}
+
+/* the border's hot state follows the mouse */
+static void EDIT_TrackHot(EDITSTATE *es, BOOL hot)
+{
+    HTHEME theme = GetWindowTheme(es->hwndSelf);
+    int state;
+
+    if (es->hot == hot || !theme || !win7_edit_border(es->hwndSelf, theme, &state)) return;
+    es->hot = hot;
+    if (hot)
+    {
+        TRACKMOUSEEVENT event = { sizeof(event), TME_LEAVE, es->hwndSelf, 0 };
+        TrackMouseEvent(&event);
+    }
+    RedrawWindow(es->hwndSelf, NULL, NULL, RDW_FRAME | RDW_INVALIDATE | RDW_NOCHILDREN);
+}
