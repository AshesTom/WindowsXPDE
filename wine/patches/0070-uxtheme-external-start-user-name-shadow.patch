From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: draw the Start panel user name's continuous shadow

Purpose: match the shadow under the user name on XP's Start panel.
XP behavior: the user pane's text has a continuous (blurred) shadow, which
DrawThemeTextEx ignored.
Change: draw the text coverage blurred with a 5x5 tent kernel, one pixel
before the theme's offset, in the shadow colour at 94% opacity, as fitted
to the reference screen.
Evidence: tests/theme-text-shadow.c.
Scope: only with WIN4WINE_EXTERNAL_SHELL and continuous text shadows.
Old patches: 0057 (its draw.c part).
---
 dlls/uxtheme/draw.c | 66 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/dlls/uxtheme/draw.c b/dlls/uxtheme/draw.c
index 40c4480..c04f166 100644
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -1917,6 +1917,68 @@ HRESULT WINAPI DrawThemeText(HTHEME hTheme, HDC hdc, int iPartId, int iStateId,
     return DrawThemeTextEx(hTheme, hdc, iPartId, iStateId, pszText, iCharCount, flags, &rt, &opts);
 }
 
+/* A soft text shadow (TST_CONTINUOUS), as on the Luna Start panel's user
+ * name. Fitted to the reference XP pixels: the text coverage blurred with a
+ * 5x5 tent kernel, centred one pixel before the theme's shadow offset, and
+ * blended in the shadow colour at 94% opacity. */
+static void draw_continuous_shadow(HDC hdc, LPCWSTR text, int count, DWORD flags, const RECT *rect,
+                                   POINT offset, COLORREF color)
+{
+    static const int weights[5] = {1, 2, 3, 2, 1};
+    const int margin = 2;
+    BITMAPINFO info = {{sizeof(info.bmiHeader)}};
+    BLENDFUNCTION blend = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+    int width = rect->right - rect->left + 2 * margin, height = rect->bottom - rect->top + 2 * margin;
+    DWORD *mask, *shadow;
+    HBITMAP mask_bitmap, shadow_bitmap;
+    HDC mask_dc, shadow_dc;
+    RECT local;
+    int x, y, i, j;
+
+    if (width <= 2 * margin || height <= 2 * margin || width > 4096 || height > 4096 ||
+        GetMapMode(hdc) != MM_TEXT) return;
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    mask_dc = CreateCompatibleDC(hdc);
+    shadow_dc = CreateCompatibleDC(hdc);
+    mask_bitmap = CreateDIBSection(mask_dc, &info, DIB_RGB_COLORS, (void **)&mask, NULL, 0);
+    shadow_bitmap = CreateDIBSection(shadow_dc, &info, DIB_RGB_COLORS, (void **)&shadow, NULL, 0);
+    if (mask_dc && shadow_dc && mask_bitmap && shadow_bitmap)
+    {
+        HGDIOBJ old_mask = SelectObject(mask_dc, mask_bitmap), old_shadow = SelectObject(shadow_dc, shadow_bitmap);
+        HGDIOBJ old_font = SelectObject(mask_dc, GetCurrentObject(hdc, OBJ_FONT));
+        memset(mask, 0, width * height * 4);
+        SetBkMode(mask_dc, TRANSPARENT);
+        SetTextColor(mask_dc, RGB(255, 255, 255));
+        SetRect(&local, margin, margin, width - margin, height - margin);
+        DrawTextW(mask_dc, text, count, &local, flags);
+        GdiFlush();
+        for (y = 0; y < height; y++)
+            for (x = 0; x < width; x++)
+            {
+                unsigned int sum = 0, alpha;
+                for (j = -2; j <= 2; j++)
+                    for (i = -2; i <= 2; i++)
+                        if (y + j >= 0 && y + j < height && x + i >= 0 && x + i < width)
+                            sum += (mask[(y + j) * width + x + i] & 0xff) * weights[i + 2] * weights[j + 2];
+                alpha = sum / 81 * 240 / 255;
+                shadow[y * width + x] = alpha << 24 | (GetRValue(color) * alpha / 255) << 16 |
+                                        (GetGValue(color) * alpha / 255) << 8 | GetBValue(color) * alpha / 255;
+            }
+        GdiAlphaBlend(hdc, rect->left - margin + offset.x - 1, rect->top - margin + offset.y - 1, width, height,
+                      shadow_dc, 0, 0, width, height, blend);
+        SelectObject(mask_dc, old_font);
+        SelectObject(mask_dc, old_mask);
+        SelectObject(shadow_dc, old_shadow);
+    }
+    if (mask_bitmap) DeleteObject(mask_bitmap);
+    if (shadow_bitmap) DeleteObject(shadow_bitmap);
+    if (mask_dc) DeleteDC(mask_dc);
+    if (shadow_dc) DeleteDC(shadow_dc);
+}
+
 /***********************************************************************
  *      DrawThemeTextEx                                     (UXTHEME.@)
  */
@@ -1984,6 +2046,10 @@ HRESULT WINAPI DrawThemeTextEx(HTHEME hTheme, HDC hdc, int iPartId, int iStateId
             DrawTextW(hdc, pszText, iCharCount, &shadow, flags);
             SetTextColor(hdc, textColor);
         }
+        else if (shadow_type == TST_CONTINUOUS &&
+                 SUCCEEDED(GetThemePosition(hTheme, iPartId, iStateId, TMT_TEXTSHADOWOFFSET, &offset)) &&
+                 SUCCEEDED(GetThemeColor(hTheme, iPartId, iStateId, TMT_TEXTSHADOWCOLOR, &shadow_color)))
+            draw_continuous_shadow(hdc, pszText, iCharCount, flags, rect, offset, shadow_color);
     }
     DrawTextW(hdc, pszText, iCharCount, rect, flags);
     SetBkMode(hdc, oldBkMode);
