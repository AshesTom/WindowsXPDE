+
+/**********************************************************************
+ *      MSSTYLES_LookupEnumName
+ *
+ * The name of an enumeration's value, as a theme ini gives it.
+ */
+LPCWSTR MSSTYLES_LookupEnumName(int dwEnum, int dwValue)
+{
+    DWORD item = 0;
+    while(*mapEnum[item].szValueName && mapEnum[item].dwEnum != dwEnum) item++;
+    while(*mapEnum[item].szValueName && mapEnum[item].dwEnum == dwEnum) {
+        if(mapEnum[item].dwValue == dwValue) return mapEnum[item].szValueName;
+        item++;
+    }
+    return NULL;
+}
