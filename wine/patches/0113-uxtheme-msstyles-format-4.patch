+/***********************************************************************
+ * Format 4 themes (Windows Vista and 7)
+ *
+ * VMAP names the variants (resource name, size name, color name). A VARIANT
+ * resource holds the properties of a variant as records: property id,
+ * primitive type, class (index into the class names of CMAP), part, state,
+ * a resource id and the size of the data that follows, padded to eight
+ * bytes. With a resource id, nothing follows: the value is a string of the
+ * theme's string table (fonts, some rectangles) or, for file names, an
+ * IMAGE resource (PNG). Values are kept as the text a format 3 theme's ini
+ * would have, so the property getters read both formats.
+ */
+struct v4_record
+{
+    int id;
+    int type;
+    int class;
+    int part;
+    int state;
+    int resource;
+    int reserved;
+    int size;
+};
+
+static const void *find_v4_resource(HMODULE module, LPCWSTR type, LPCWSTR name, DWORD *size)
+{
+    HRSRC res = FindResourceW(module, name, type);
+    if (!res) return NULL;
+    *size = SizeofResource(module, res);
+    return LoadResource(module, res);
+}
+
+/* The theme's strings are in its MUI file: <dir>\<language>\<name>.mui. */
+static HMODULE load_v4_strings(LPCWSTR file)
+{
+    WCHAR path[MAX_PATH], locale[LOCALE_NAME_MAX_LENGTH];
+    const WCHAR *languages[2] = {locale, L"en-US"}, *name;
+    HMODULE module;
+    int i;
+
+    if (!(name = wcsrchr(file, '\\'))) return NULL;
+    if (!LCIDToLocaleName(MAKELCID(GetUserDefaultUILanguage(), SORT_DEFAULT), locale, ARRAY_SIZE(locale), 0))
+        lstrcpyW(locale, L"en-US");
+    for (i = 0; i < ARRAY_SIZE(languages); i++)
+    {
+        if (swprintf(path, ARRAY_SIZE(path), L"%.*s\\%s%s.mui", (int)(name - file), file, languages[i], name) < 0)
+            continue;
+        if ((module = LoadLibraryExW(path, NULL, LOAD_LIBRARY_AS_DATAFILE))) return module;
+    }
+    return NULL;
+}
+
+static HRESULT open_theme_v4(HMODULE module, LPCWSTR file, LPCWSTR color, LPCWSTR size, PTHEME_FILE *ret)
+{
+    const BYTE *vmap, *p, *end;
+    WCHAR *colors, *sizes, *c, *s;
+    const WCHAR *names[3];
+    WCHAR variant[MAX_THEME_CLASS_NAME] = {0};
+    PTHEME_FILE tf;
+    DWORD len;
+    int i;
+
+    if (!(vmap = find_v4_resource(module, L"VMAP", L"VMAP", &len))) return HRESULT_FROM_WIN32(ERROR_BAD_FORMAT);
+    end = vmap + len;
+    colors = calloc(len + 2, sizeof(WCHAR));
+    sizes = calloc(len + 2, sizeof(WCHAR));
+    if (!colors || !sizes)
+    {
+        free(colors);
+        free(sizes);
+        return E_OUTOFMEMORY;
+    }
+    c = colors;
+    s = sizes;
+    for (p = vmap; p + 4 <= end;)
+    {
+        /* Each string: a count of characters with the terminator, the
+         * characters, aligned to four bytes. */
+        for (i = 0; i < 3 && p + 4 <= end; i++)
+        {
+            DWORD count = *(const DWORD *)p;
+            names[i] = (const WCHAR *)(p + 4);
+            if (!count || p + 4 + count * sizeof(WCHAR) > end) break;
+            p += (4 + count * sizeof(WCHAR) + 3) & ~3;
+        }
+        if (i < 3) break;
+        if ((!color || !lstrcmpiW(color, names[2])) && (!size || !lstrcmpiW(size, names[1])) && !variant[0])
+            lstrcpynW(variant, names[0], ARRAY_SIZE(variant));
+        lstrcpyW(c, names[2]);
+        c += lstrlenW(c) + 1;
+        lstrcpyW(s, names[1]);
+        s += lstrlenW(s) + 1;
+    }
+    if (!variant[0])
+    {
+        TRACE("Requested color/size (%s/%s) not found in theme\n", debugstr_w(color), debugstr_w(size));
+        free(colors);
+        free(sizes);
+        return E_PROP_ID_UNSUPPORTED;
+    }
+    tf = calloc(1, sizeof(*tf));
+    tf->hTheme = module;
+    GetFullPathNameW(file, MAX_PATH, tf->szThemeFile, NULL);
+    tf->version = MSSTYLES_VERSION_V4;
+    tf->pszAvailColors = colors;
+    tf->pszAvailSizes = sizes;
+    tf->pszSelectedColor = colors;
+    tf->pszSelectedSize = sizes;
+    for (c = colors, s = sizes; *c; c += lstrlenW(c) + 1, s += lstrlenW(s) + 1)
+        if ((!color || !lstrcmpiW(color, c)) && (!size || !lstrcmpiW(size, s)))
+        {
+            tf->pszSelectedColor = c;
+            tf->pszSelectedSize = s;
+            break;
+        }
+    lstrcpyW(tf->variant, variant);
+    tf->strings = load_v4_strings(tf->szThemeFile);
+    tf->refcount = 1;
+    TRACE("format 4 theme %s, variant %s, strings %p\n", debugstr_w(file), debugstr_w(variant), tf->strings);
+    *ret = tf;
+    return S_OK;
+}
+
+static const WCHAR *add_v4_text(PTHEME_FILE tf, const WCHAR *text)
+{
+    DWORD len = lstrlenW(text);
+    struct v4_text *entry = malloc(offsetof(struct v4_text, text[len + 1]));
+
+    if (!entry) return NULL;
+    memcpy(entry->text, text, (len + 1) * sizeof(WCHAR));
+    entry->next = tf->texts;
+    tf->texts = entry;
+    return entry->text;
+}
+
+/* The ini text of a record's value; FALSE for values this reader skips. */
+static BOOL format_v4_value(PTHEME_FILE tf, const struct v4_record *rec, const BYTE *data, WCHAR *buffer, DWORD count)
+{
+    const int *v = (const int *)data;
+    const WCHAR *name;
+    int i, n;
+
+    if (rec->resource)
+    {
+        if (rec->type == TMT_FILENAME)
+        {
+            swprintf(buffer, count, L"IMAGE#%d", rec->resource);
+            return TRUE;
+        }
+        if (rec->type == TMT_DISKSTREAM) return FALSE;
+        if (tf->strings && LoadStringW(tf->strings, rec->resource, buffer, count) > 0) return TRUE;
+        return LoadStringW(tf->hTheme, rec->resource, buffer, count) > 0;
+    }
+    switch (rec->type)
+    {
+    case TMT_ENUM:
+        if (rec->size < 4) return FALSE;
+        if ((name = MSSTYLES_LookupEnumName(rec->id, v[0]))) lstrcpynW(buffer, name, count);
+        else swprintf(buffer, count, L"%d", v[0]);
+        return TRUE;
+    case TMT_INT:
+    case TMT_SIZE:
+        if (rec->size < 4) return FALSE;
+        swprintf(buffer, count, L"%d", v[0]);
+        return TRUE;
+    case TMT_BOOL:
+        if (rec->size < 4) return FALSE;
+        lstrcpynW(buffer, v[0] ? L"TRUE" : L"FALSE", count);
+        return TRUE;
+    case TMT_COLOR:
+        if (rec->size < 4) return FALSE;
+        swprintf(buffer, count, L"%d %d %d", data[0], data[1], data[2]);
+        return TRUE;
+    case TMT_MARGINS:
+    case TMT_RECT:
+        if (rec->size < 16) return FALSE;
+        swprintf(buffer, count, L"%d, %d, %d, %d", v[0], v[1], v[2], v[3]);
+        return TRUE;
+    case TMT_POSITION:
+        if (rec->size < 8) return FALSE;
+        swprintf(buffer, count, L"%d, %d", v[0], v[1]);
+        return TRUE;
+    case TMT_STRING:
+        lstrcpynW(buffer, (const WCHAR *)data, min(count, rec->size / sizeof(WCHAR) + 1));
+        return TRUE;
+    case TMT_INTLIST:
+        if (rec->size < 4) return FALSE;
+        n = min(v[0], (rec->size - 4) / 4);
+        buffer[0] = 0;
+        for (i = 0; i < n && lstrlenW(buffer) + 13 < count; i++)
+            swprintf(buffer + lstrlenW(buffer), count - lstrlenW(buffer), i ? L", %d" : L"%d", v[i + 1]);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void MSSTYLES_ParseThemeV4(PTHEME_FILE tf, BOOL setMetrics)
+{
+    const BYTE *cmap, *variant, *bcmap, *p, *end;
+    const WCHAR **names;
+    struct PARSECOLORSTATE colorState;
+    struct PARSENONCLIENTSTATE nonClientState;
+    WCHAR app[MAX_THEME_APP_NAME], name[MAX_THEME_CLASS_NAME], text[512];
+    DWORD len, size, count = 0, first, i;
+    PTHEME_CLASS cls, globals;
+    PTHEME_PARTSTATE ps;
+    const WCHAR *value;
+
+    if (!(cmap = find_v4_resource(tf->hTheme, L"CMAP", L"CMAP", &len)) ||
+        !(variant = find_v4_resource(tf->hTheme, L"VARIANT", tf->variant, &size)))
+    {
+        ERR("Missing class map or variant %s\n", debugstr_w(tf->variant));
+        return;
+    }
+    end = variant + size;
+    /* Class names: strings padded with zeros; a class index counts the strings. */
+    if (!(names = calloc(len / sizeof(WCHAR) + 1, sizeof(*names)))) return;
+    for (i = 0; i < len / sizeof(WCHAR);)
+    {
+        const WCHAR *str = (const WCHAR *)cmap + i;
+        if (!*str)
+        {
+            i++;
+            continue;
+        }
+        names[count++] = str;
+        i += wcsnlen(str, len / sizeof(WCHAR) - i) + 1;
+    }
+
+    parse_init_color(&colorState);
+    parse_init_nonclient(&nonClientState);
+    for (p = variant; p + sizeof(struct v4_record) <= end;)
+    {
+        const struct v4_record *rec = (const struct v4_record *)p;
+        const BYTE *data = p + sizeof(*rec);
+
+        p += sizeof(*rec);
+        if (!rec->resource) p += (rec->size + 7) & ~7;
+        if (p > end) break;
+        if (rec->class < 0 || rec->class >= count) continue;
+        if (!format_v4_value(tf, rec, data, text, ARRAY_SIZE(text))) continue;
+        if (!(value = add_v4_text(tf, text))) break;
+
+        if (!lstrcmpiW(names[rec->class], L"sysmetrics"))
+        {
+            if (rec->id >= TMT_FIRSTCOLOR && rec->id <= TMT_LASTCOLOR)
+                parse_handle_color_property(&colorState, rec->id, value, lstrlenW(value));
+            else if (setMetrics && rec->id == TMT_FLATMENUS)
+                SystemParametersInfoW(SPI_SETFLATMENU, 0, (PVOID)(INT_PTR)(*value == 'T'), 0);
+            else if (rec->id >= TMT_FIRSTFONT && rec->id <= TMT_LASTFONT)
+                parse_handle_nonclient_font(&nonClientState, rec->id, value, lstrlenW(value));
+            else if (rec->id >= TMT_FIRSTSIZE && rec->id <= TMT_LASTSIZE)
+                parse_handle_nonclient_size(&nonClientState, rec->id, value, lstrlenW(value));
+            MSSTYLES_AddMetric(tf, rec->type, rec->id, value, lstrlenW(value));
+            continue;
+        }
+        if (!wcsncmp(names[rec->class], L"sizevariant.", 12) || !wcsncmp(names[rec->class], L"colorvariant.", 13) ||
+            !lstrcmpiW(names[rec->class], L"documentation"))
+            continue;
+        parse_app_class_name(names[rec->class], app, name);
+        cls = MSSTYLES_AddClass(tf, app, name);
+        ps = MSSTYLES_AddPartState(cls, rec->part, rec->state);
+        MSSTYLES_AddProperty(ps, rec->type, rec->id, value, lstrlenW(value), !lstrcmpiW(name, L"globals"));
+    }
+    if (setMetrics)
+    {
+        parse_apply_color(&colorState);
+        parse_apply_nonclient(&nonClientState);
+    }
+
+    /* An application's class takes what it lacks from the class of the same
+     * name, and every class from globals. */
+    globals = MSSTYLES_FindClass(tf, NULL, L"globals");
+    for (cls = tf->classes; cls; cls = cls->next)
+    {
+        if (cls == globals) continue;
+        cls->overrides = *cls->szAppName ? MSSTYLES_FindClass(tf, NULL, cls->szClassName) : NULL;
+        if (!cls->overrides) cls->overrides = globals;
+    }
+
+    /* A class takes what it lacks from its base class: BCMAP holds the base
+     * of each class, as indexes counted from globals, or -1. */
+    for (first = 0; first < count && lstrcmpiW(names[first], L"globals"); first++);
+    if ((bcmap = find_v4_resource(tf->hTheme, L"BCMAP", L"BCMAP", &len)) && len >= sizeof(DWORD))
+    {
+        const INT *bases = (const INT *)bcmap + 1;
+        DWORD total = min(*(const DWORD *)bcmap, len / sizeof(DWORD) - 1);
+
+        for (i = 0; i < total && first + i < count; i++)
+        {
+            PTHEME_CLASS base, c;
+
+            if (bases[i] < 0 || bases[i] == i || first + bases[i] >= count) continue;
+            parse_app_class_name(names[first + i], app, name);
+            cls = MSSTYLES_AddClass(tf, app, name);
+            parse_app_class_name(names[first + bases[i]], app, name);
+            base = MSSTYLES_AddClass(tf, app, name);
+            if (!base->overrides && base != globals) base->overrides = globals;
+            for (c = base; c && c != cls; c = c->overrides);
+            if (!c) cls->overrides = base;
+        }
+    }
+    free(names);
+    if (!tf->classes) ERR("Failed to parse format 4 theme\n");
+}
+
+extern HRESULT WINAPI WICCreateImagingFactory_Proxy(UINT version, IWICImagingFactory **factory);
+
+/* A PNG image of a format 4 theme ("IMAGE#<id>") as a 32 bpp DIB section. */
+static HBITMAP load_png_image(HMODULE module, LPCWSTR name)
+{
+    IWICImagingFactory *factory = NULL;
+    IWICStream *stream = NULL;
+    IWICBitmapDecoder *decoder = NULL;
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICBitmapSource *source = NULL;
+    BITMAPINFO info = {{sizeof(info.bmiHeader)}};
+    HBITMAP bitmap = NULL;
+    const void *data;
+    void *bits;
+    UINT width, height;
+    DWORD size;
+    int id;
+
+    if (wcsncmp(name, L"IMAGE#", 6) || !(id = wcstol(name + 6, NULL, 10))) return NULL;
+    if (!(data = find_v4_resource(module, L"IMAGE", MAKEINTRESOURCEW(id), &size))) return NULL;
+    if (FAILED(WICCreateImagingFactory_Proxy(WINCODEC_SDK_VERSION, &factory))) return NULL;
+    if (SUCCEEDED(IWICImagingFactory_CreateStream(factory, &stream)) &&
+        SUCCEEDED(IWICStream_InitializeFromMemory(stream, (BYTE *)data, size)) &&
+        SUCCEEDED(IWICImagingFactory_CreateDecoderFromStream(factory, (IStream *)stream, NULL,
+                                                             WICDecodeMetadataCacheOnDemand, &decoder)) &&
+        SUCCEEDED(IWICBitmapDecoder_GetFrame(decoder, 0, &frame)) &&
+        SUCCEEDED(WICConvertBitmapSource(&GUID_WICPixelFormat32bppBGRA, (IWICBitmapSource *)frame, &source)) &&
+        SUCCEEDED(IWICBitmapSource_GetSize(source, &width, &height)))
+    {
+        info.bmiHeader.biWidth = width;
+        info.bmiHeader.biHeight = -(int)height;
+        info.bmiHeader.biPlanes = 1;
+        info.bmiHeader.biBitCount = 32;
+        info.bmiHeader.biCompression = BI_RGB;
+        if ((bitmap = CreateDIBSection(NULL, &info, DIB_RGB_COLORS, &bits, NULL, 0)) &&
+            FAILED(IWICBitmapSource_CopyPixels(source, NULL, width * 4, width * height * 4, bits)))
+        {
+            DeleteObject(bitmap);
+            bitmap = NULL;
+        }
+    }
+    if (source) IWICBitmapSource_Release(source);
+    if (frame) IWICBitmapFrameDecode_Release(frame);
+    if (decoder) IWICBitmapDecoder_Release(decoder);
+    if (stream) IWICStream_Release(stream);
+    IWICImagingFactory_Release(factory);
+    if (!bitmap) WARN("Failed to load image %s\n", debugstr_w(name));
+    return bitmap;
+}
