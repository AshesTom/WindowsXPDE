From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] svchost: give service DLLs svchost's globals (SvchostPushServiceGlobals)

Purpose: run XP's Security Center service (wscsvc.dll) in Wine's svchost.
Windows behavior: svchost calls a service DLL's SvchostPushServiceGlobals
export with SVCHOST_GLOBAL_DATA (svcs.h of the Windows 2003 DDK): the
well-known SIDs, StartRpcServer and StopRpcServer(Ex) on the process' RPC
server, the NetBIOS helpers, and since XP SP2 RegisterStopCallback, a wait
on the thread pool for the service's stop event.
Wine before: a FIXME, and no globals; wscsvc calls RegisterStopCallback
through the NULL pointer, catches the fault and stops.
Change: call SvchostPushServiceGlobals with the SIDs, the RPC helpers
(ncacn_np \pipe\NAME, listening once), empty NetBIOS helpers and
RegisterStopCallback (RegisterWaitForSingleObject, once).
Scope: service DLLs that export SvchostPushServiceGlobals.
---
diff --git a/programs/svchost/svchost.c b/programs/svchost/svchost.c
--- a/programs/svchost/svchost.c
+++ b/programs/svchost/svchost.c
@@ -30,6 +30,7 @@
 #include "winbase.h"
 #include "winreg.h"
 #include "winsvc.h"
+#include "rpc.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(svchost);
@@ -102,6 +103,102 @@
     return expanded_string;
 }
 
+/* What Windows' svchost gives the service DLLs that export
+ * SvchostPushServiceGlobals (svcs.h of the Windows 2003 DDK; the stop
+ * callback since XP SP2): well-known SIDs and helpers that share the
+ * process' RPC server and thread pool. XP's Security Center (wscsvc.dll)
+ * registers its stop event with RegisterStopCallback. */
+typedef struct
+{
+    PSID NullSid, WorldSid, LocalSid, NetworkSid, LocalSystemSid, LocalServiceSid, NetworkServiceSid,
+         BuiltinDomainSid, AuthenticatedUserSid, AnonymousLogonSid, AliasAdminsSid, AliasUsersSid,
+         AliasGuestsSid, AliasPowerUsersSid, AliasAccountOpsSid, AliasSystemOpsSid, AliasPrintOpsSid,
+         AliasBackupOpsSid;
+    LONG (WINAPI *StartRpcServer)(const WCHAR *pipe, RPC_IF_HANDLE interface);
+    LONG (WINAPI *StopRpcServer)(RPC_IF_HANDLE interface);
+    LONG (WINAPI *StopRpcServerEx)(RPC_IF_HANDLE interface);
+    void (WINAPI *NetBiosOpen)(void);
+    void (WINAPI *NetBiosClose)(void);
+    DWORD (WINAPI *NetBiosReset)(UCHAR adapter);
+    DWORD (WINAPI *RegisterStopCallback)(HANDLE *wait, const WCHAR *service, HANDLE object,
+                                         WAITORTIMERCALLBACK callback, void *context, DWORD flags);
+} SVCHOST_GLOBAL_DATA;
+
+static LONG WINAPI start_rpc_server(const WCHAR *pipe, RPC_IF_HANDLE interface)
+{
+    WCHAR endpoint[MAX_PATH];
+    RPC_STATUS status;
+
+    swprintf(endpoint, ARRAY_SIZE(endpoint), L"\\pipe\\%s", pipe);
+    status = RpcServerUseProtseqEpW((RPC_WSTR)L"ncacn_np", RPC_C_PROTSEQ_MAX_REQS_DEFAULT, (RPC_WSTR)endpoint, NULL);
+    if (status == RPC_S_DUPLICATE_ENDPOINT) status = RPC_S_OK;
+    if (!status) status = RpcServerRegisterIf(interface, NULL, NULL);
+    if (!status) status = RpcServerListen(1, RPC_C_LISTEN_MAX_CALLS_DEFAULT, TRUE);
+    if (status == RPC_S_ALREADY_LISTENING) status = RPC_S_OK;
+    return status;
+}
+
+static LONG WINAPI stop_rpc_server(RPC_IF_HANDLE interface)
+{
+    return RpcServerUnregisterIf(interface, NULL, TRUE);
+}
+
+static void WINAPI netbios_open(void) {}
+static void WINAPI netbios_close(void) {}
+static DWORD WINAPI netbios_reset(UCHAR adapter) { return ERROR_SUCCESS; }
+
+static DWORD WINAPI register_stop_callback(HANDLE *wait, const WCHAR *service, HANDLE object,
+                                           WAITORTIMERCALLBACK callback, void *context, DWORD flags)
+{
+    WINE_TRACE("%s %p %p %p %#lx\n", wine_dbgstr_w(service), object, callback, context, flags);
+    if (!RegisterWaitForSingleObject(wait, object, callback, context, INFINITE, flags | WT_EXECUTEONLYONCE))
+        return GetLastError();
+    return ERROR_SUCCESS;
+}
+
+static SVCHOST_GLOBAL_DATA *svchost_globals(void)
+{
+    static SVCHOST_GLOBAL_DATA globals;
+    static BOOL done;
+    static const struct { SID_IDENTIFIER_AUTHORITY authority; BYTE count; DWORD sub[2]; } sids[] =
+    {
+        {{SECURITY_NULL_SID_AUTHORITY}, 1, {SECURITY_NULL_RID}},
+        {{SECURITY_WORLD_SID_AUTHORITY}, 1, {SECURITY_WORLD_RID}},
+        {{SECURITY_LOCAL_SID_AUTHORITY}, 1, {SECURITY_LOCAL_RID}},
+        {{SECURITY_NT_AUTHORITY}, 1, {SECURITY_NETWORK_RID}},
+        {{SECURITY_NT_AUTHORITY}, 1, {SECURITY_LOCAL_SYSTEM_RID}},
+        {{SECURITY_NT_AUTHORITY}, 1, {SECURITY_LOCAL_SERVICE_RID}},
+        {{SECURITY_NT_AUTHORITY}, 1, {SECURITY_NETWORK_SERVICE_RID}},
+        {{SECURITY_NT_AUTHORITY}, 1, {SECURITY_BUILTIN_DOMAIN_RID}},
+        {{SECURITY_NT_AUTHORITY}, 1, {SECURITY_AUTHENTICATED_USER_RID}},
+        {{SECURITY_NT_AUTHORITY}, 1, {SECURITY_ANONYMOUS_LOGON_RID}},
+        {{SECURITY_NT_AUTHORITY}, 2, {SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS}},
+        {{SECURITY_NT_AUTHORITY}, 2, {SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_USERS}},
+        {{SECURITY_NT_AUTHORITY}, 2, {SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_GUESTS}},
+        {{SECURITY_NT_AUTHORITY}, 2, {SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_POWER_USERS}},
+        {{SECURITY_NT_AUTHORITY}, 2, {SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ACCOUNT_OPS}},
+        {{SECURITY_NT_AUTHORITY}, 2, {SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_SYSTEM_OPS}},
+        {{SECURITY_NT_AUTHORITY}, 2, {SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_PRINT_OPS}},
+        {{SECURITY_NT_AUTHORITY}, 2, {SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_BACKUP_OPS}},
+    };
+    PSID *sid = &globals.NullSid;
+    unsigned int i;
+
+    if (done) return &globals;
+    for (i = 0; i < ARRAY_SIZE(sids); i++)
+        AllocateAndInitializeSid((SID_IDENTIFIER_AUTHORITY *)&sids[i].authority, sids[i].count,
+                                 sids[i].sub[0], sids[i].sub[1], 0, 0, 0, 0, 0, 0, &sid[i]);
+    globals.StartRpcServer = start_rpc_server;
+    globals.StopRpcServer = stop_rpc_server;
+    globals.StopRpcServerEx = stop_rpc_server;
+    globals.NetBiosOpen = netbios_open;
+    globals.NetBiosClose = netbios_close;
+    globals.NetBiosReset = netbios_reset;
+    globals.RegisterStopCallback = register_stop_callback;
+    done = TRUE;
+    return &globals;
+}
+
 /* Fill in service table entry for a specified service */
 static BOOL AddServiceElem(LPWSTR service_name,
         SERVICE_TABLE_ENTRYW *service_table_entry)
@@ -114,6 +211,7 @@
     LPSTR dll_service_main = NULL;
     HMODULE library = NULL;
     LPSERVICE_MAIN_FUNCTIONW service_main_func = NULL;
+    void (WINAPI *push_globals)(SVCHOST_GLOBAL_DATA *);
     BOOL success = FALSE;
     DWORD reg_size;
     DWORD size;
@@ -204,11 +302,8 @@
         goto cleanup;
     }
 
-    if (GetProcAddress(library, "SvchostPushServiceGlobals"))
-    {
-        WINE_FIXME("library %s expects undocumented SvchostPushServiceGlobals function to be called\n",
-                   wine_dbgstr_w(dll_name_long));
-    }
+    if ((push_globals = (void *)GetProcAddress(library, "SvchostPushServiceGlobals")))
+        push_globals(svchost_globals());
 
     /* Fill in the service table entry */
     service_table_entry->lpServiceName = service_name;
diff --git a/programs/svchost/Makefile.in b/programs/svchost/Makefile.in
--- a/programs/svchost/Makefile.in
+++ b/programs/svchost/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = svchost.exe
-IMPORTS   = advapi32
+IMPORTS   = advapi32 rpcrt4
 
 EXTRADLLFLAGS = -mwindows -municode
 
