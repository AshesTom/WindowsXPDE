From: Codex <codex@localhost>
Subject: [PATCH] windowscodecs: the scaler's Fant mode

Purpose: scale icons and thumbnails in Windows 7's shell as Windows 7
does (the folder window's details pane, other icon sizes than the icon's
own).
Windows behavior: WICBitmapInterpolationModeFant averages the source
area each destination pixel covers. Windows 7's shell scales its item
images with it (IShellItemImageFactory at 40 or 96 px from the 256 px
icon).
Wine before: every mode but nearest neighbor fell back to it.
Change: Fant for pixel formats of 8 bits a channel (BGRA, PBGRA, BGR,
RGBA, PRGBA, 24-bit BGR/RGB, 8-bit gray): area-weighted average, rounded.
Other formats keep nearest neighbor.
Evidence: tests/shell-item-images.c on Windows 7 and in the session: at
96 px the differing pixels drop from 4016 (up to 190 apart) to 1115 (up
to 18), at 40 px from 804 (221) to 654 (50); 16, 32, 48 and 256 stay
identical.
Scope: all WIC users (as on Windows).
---
 dlls/windowscodecs/scaler.c | 62 ++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 61 insertions(+), 1 deletion(-)

diff --git a/dlls/windowscodecs/scaler.c b/dlls/windowscodecs/scaler.c
index 3710944..6572c40 100644
--- a/dlls/windowscodecs/scaler.c
+++ b/dlls/windowscodecs/scaler.c
@@ -203,6 +203,48 @@ static void NearestNeighbor_CopyScanline(BitmapScaler *This,
     }
 }
 
+/* Fant: each destination pixel is the average of the source area it covers
+ * (Windows 7's shell scales icons and thumbnails with it) */
+static void Fant_GetRequiredSourceRect(BitmapScaler *This,
+    UINT x, UINT y, WICRect *src_rect)
+{
+    src_rect->X = (UINT64)x * This->src_width / This->width;
+    src_rect->Y = (UINT64)y * This->src_height / This->height;
+    src_rect->Width = ((UINT64)(x + 1) * This->src_width + This->width - 1) / This->width - src_rect->X;
+    src_rect->Height = ((UINT64)(y + 1) * This->src_height + This->height - 1) / This->height - src_rect->Y;
+}
+
+static void Fant_CopyScanline(BitmapScaler *This,
+    UINT dst_x, UINT dst_y, UINT dst_width,
+    BYTE **src_data, UINT src_data_x, UINT src_data_y, BYTE *pbBuffer)
+{
+    UINT channels = This->bpp / 8, i, c, sx, sy;
+    double y0 = (double)dst_y * This->src_height / This->height;
+    double y1 = (double)(dst_y + 1) * This->src_height / This->height;
+
+    for (i = 0; i < dst_width; i++)
+    {
+        double x0 = (double)(dst_x + i) * This->src_width / This->width;
+        double x1 = (double)(dst_x + i + 1) * This->src_width / This->width;
+        double sum[4] = {0}, area = (x1 - x0) * (y1 - y0);
+
+        for (sy = (UINT)y0; sy < y1 && sy < This->src_height; sy++)
+        {
+            double wy = min(y1, sy + 1) - max(y0, sy);
+            const BYTE *row = src_data[sy - src_data_y];
+
+            for (sx = (UINT)x0; sx < x1 && sx < This->src_width; sx++)
+            {
+                double w = wy * (min(x1, sx + 1) - max(x0, sx));
+                const BYTE *pixel = row + (sx - src_data_x) * channels;
+                for (c = 0; c < channels; c++) sum[c] += w * pixel[c];
+            }
+        }
+        for (c = 0; c < channels; c++)
+            pbBuffer[i * channels + c] = min(255, (int)(sum[c] / area + 0.5));
+    }
+}
+
 static HRESULT WINAPI BitmapScaler_CopyPixels(IWICBitmapScaler *iface,
     const WICRect *prc, UINT cbStride, UINT cbBufferSize, BYTE *pbBuffer)
 {
@@ -351,8 +393,26 @@ static HRESULT WINAPI BitmapScaler_Initialize(IWICBitmapScaler *iface,
     {
         switch (mode)
