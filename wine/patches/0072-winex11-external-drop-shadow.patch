From: Codex <codex@localhost>
Subject: [PATCH] winex11: draw XP's drop shadow under CS_DROPSHADOW windows in the external shell

Purpose: show the soft shadow that XP draws under menus and drop-down lists.
With SPI_GETDROPSHADOW, XP shows a five-pixel shadow right of and below a
CS_DROPSHADOW window by compositing a layered window. Wine drew nothing.
For an unmanaged top-level window of the opted-in external shell, copy the
screen beneath the shadow strips when the window is mapped, darken it with
XP's profile and show it in two input-transparent override-redirect
windows mapped just before the window itself; they go away when it is
unmapped, moved or destroyed. The profile was measured on the reference XP
machine as the ratio between its desktop with and without a context menu:
0.558, 0.672, 0.832, 0.945, 0.988 across the edge, fading in from five
pixels after the window's start and out past its end. The ratios of the
desktop's context menu equal XP's within 0.005.

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 022776c..4542ab2 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1284,6 +1284,108 @@ static void window_set_net_wm_state( struct x11drv_win_data *data, UINT new_stat
     XFlush( data->display );
 }
 
+/* XP's drop shadow under menus and tooltips (CS_DROPSHADOW), measured on the
+ * reference XP machine: how much of the background it removes across its
+ * five pixels outward from the window edge, how it fades in along the edge
+ * from five pixels after the window's start, and how it fades out past the
+ * window's end. XP composites a layered window; without a compositor the
+ * opted-in external shell darkens a copy of what lies under it when the
+ * window is shown. */
+static const float shadow_edge[5] = { 0.442f, 0.328f, 0.168f, 0.055f, 0.012f };
+static const float shadow_fade[6] = { 0.113f, 0.339f, 0.663f, 0.885f, 0.975f, 1.0f };
+static const float shadow_corner[5] = { 0.882f, 0.665f, 0.337f, 0.118f, 0.018f };
+
+static BOOL wants_drop_shadow( struct x11drv_win_data *data )
+{
+    BOOL enabled = FALSE;
+
+    if (data->managed || data->embedded || !getenv( "WIN4WINE_EXTERNAL_SHELL" )) return FALSE;
+    if (NtUserGetWindowLongW( data->hwnd, GWL_STYLE ) & WS_CHILD) return FALSE;
+    if (!(NtUserGetClassLongW( data->hwnd, GCL_STYLE ) & CS_DROPSHADOW)) return FALSE;
+    NtUserSystemParametersInfo( SPI_GETDROPSHADOW, 0, &enabled, 0 );
+    return enabled;
+}
+
+/* darkness at (i, k) of the right (part 0) or bottom (part 1) shadow, whose
+ * pixel (0, 0) lies at offset 'along' from the start of the shadow strip */
+static float shadow_darkness( int part, int i, int k, int length )
+{
+    int across = part ? k : i, along = part ? i : k;
+    float fade = along < 6 ? shadow_fade[along] : 1.0f;
+
+    if (part == 0 && along >= length - 5) fade = min( fade, shadow_corner[along - (length - 5)] );
+    return shadow_edge[across] * fade;
+}
+
+static Window create_shadow( Display *display, int part, int x, int y, int width, int height )
+{
+    Window root = DefaultRootWindow( display ), window;
+    int screen = DefaultScreen( display ), cx, cy, left = x, top = y;
+    XSetWindowAttributes attr;
+    XImage *image;
+    Pixmap pixmap;
+    GC gc;
+
+    /* only the part on the screen can be read back */
+    cx = min( x + width, DisplayWidth( display, screen ) ) - max( x, 0 );
+    cy = min( y + height, DisplayHeight( display, screen ) ) - max( y, 0 );
+    if (cx <= 0 || cy <= 0) return 0;
+    x = max( x, 0 );
+    y = max( y, 0 );
+    if (!(image = XGetImage( display, root, x, y, cx, cy, AllPlanes, ZPixmap ))) return 0;
+    if (image->bits_per_pixel != 32 || image->red_mask != 0xff0000 || image->green_mask != 0xff00 ||
+        image->blue_mask != 0xff)
+    {
+        XDestroyImage( image );
+        return 0;
+    }
+    for (int k = 0; k < cy; k++)
+        for (int i = 0; i < cx; i++)
+        {
+            unsigned long pixel = XGetPixel( image, i, k );
+            float keep = 1.0f - shadow_darkness( part, i + x - left, k + y - top, part ? width : height );
+            unsigned int r = ((pixel >> 16) & 0xff) * keep, g = ((pixel >> 8) & 0xff) * keep, b = (pixel & 0xff) * keep;
+            XPutPixel( image, i, k, (pixel & ~0xffffffUL) | (r << 16) | (g << 8) | b );
+        }
+    pixmap = XCreatePixmap( display, root, cx, cy, image->depth );
+    gc = XCreateGC( display, pixmap, 0, NULL );
+    XPutImage( display, pixmap, gc, image, 0, 0, 0, 0, cx, cy );
+    XFreeGC( display, gc );
+    XDestroyImage( image );
+    attr.override_redirect = True;
+    attr.background_pixmap = pixmap;
+    window = XCreateWindow( display, root, x, y, cx, cy, 0, DefaultDepth( display, screen ), InputOutput,
+                            DefaultVisual( display, screen ), CWOverrideRedirect | CWBackPixmap, &attr );
+    XFreePixmap( display, pixmap );
+#ifdef HAVE_LIBXSHAPE
+    XShapeCombineRectangles( display, window, ShapeInput, 0, 0, NULL, 0, ShapeSet, YXBanded );
+#endif
+    XMapWindow( display, window );
+    return window;
+}
+
+static void destroy_drop_shadow( struct x11drv_win_data *data )
+{
+    for (int i = 0; i < 2; i++)
+    {
+        if (data->shadows[i]) XDestroyWindow( data->display, data->shadows[i] );
+        data->shadows[i] = 0;
+    }
+}
+
+static void create_drop_shadow( struct x11drv_win_data *data )
+{
+    RECT rect = data->rects.visible;
+    POINT pos;
+
+    destroy_drop_shadow( data );
+    if (!wants_drop_shadow( data )) return;
+    pos = virtual_screen_to_root( rect.left, rect.top );
+    OffsetRect( &rect, pos.x - rect.left, pos.y - rect.top );
+    data->shadows[0] = create_shadow( data->display, 0, rect.right, rect.top + 5, 5, rect.bottom - rect.top );
+    data->shadows[1] = create_shadow( data->display, 1, rect.left + 5, rect.bottom, rect.right - rect.left - 5, 5 );
+}
+
 static void window_set_config( struct x11drv_win_data *data, const RECT *new_rect, BOOL above )
 {
     static const UINT fullscreen_mask = (1 << NET_WM_STATE_MAXIMIZED) | (1 << NET_WM_STATE_FULLSCREEN);
@@ -1294,6 +1396,8 @@ static void window_set_config( struct x11drv_win_data *data, const RECT *new_rec
     data->desired_state.rect = *new_rect;
     if (!data->whole_window) return; /* no window, nothing to update */
     if (EqualRect( old_rect, new_rect ) && !above) return; /* rects are the same, no need to be raised, nothing to update */
+    /* a shadow copies what was under the window where it was shown */
+    if (!EqualRect( old_rect, new_rect )) destroy_drop_shadow( data );
 
     if (data->pending_state.wm_state == NormalState && data->net_wm_state_serial &&
         !(data->pending_state.net_wm_state & fullscreen_mask) &&
@@ -1476,11 +1580,13 @@ static void window_set_wm_state( struct x11drv_win_data *data, UINT new_state )
     case MAKELONG(WithdrawnState, IconicState):
     case MAKELONG(WithdrawnState, NormalState):
     case MAKELONG(IconicState, NormalState):
+        if (new_state == NormalState) create_drop_shadow( data );
         if (data->embedded) set_xembed_flags( data, XEMBED_MAPPED );
         else XMapWindow( data->display, data->whole_window );
         break;
     case MAKELONG(NormalState, WithdrawnState):
     case MAKELONG(IconicState, WithdrawnState):
+        destroy_drop_shadow( data );
         if (data->embedded) set_xembed_flags( data, 0 );
         else if (!data->managed) XUnmapWindow( data->display, data->whole_window );
         else XWithdrawWindow( data->display, data->whole_window, data->vis.screen );
@@ -2312,6 +2418,7 @@ void X11DRV_DestroyWindow( HWND hwnd )
 
     if (!(data = get_win_data( hwnd ))) return;
 
+    destroy_drop_shadow( data );
     destroy_whole_window( data, FALSE );
     if (thread_data->last_focus == hwnd) thread_data->last_focus = 0;
     if (thread_data->last_xic_hwnd == hwnd) thread_data->last_xic_hwnd = 0;
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index ea29ea9..b3a9c4b 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -649,6 +649,7 @@ struct x11drv_win_data
     unsigned long net_wm_state_serial; /* serial of last pending _NET_WM_STATE request */
     unsigned long configure_serial;    /* serial of last pending configure request */
     BOOL preserve_no_redraw;          /* opt-in popup shown without redrawing */
+    Window shadows[2];                /* opt-in drop shadow windows, right and bottom */
     RECT no_redraw_rect;              /* pending raw visible rectangle */
 };
 
