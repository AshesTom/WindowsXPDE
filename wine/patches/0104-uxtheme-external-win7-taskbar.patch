From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: draw Windows 7's taskbar background and clock

Purpose: let Windows 7's taskbar draw its notification area and clock
itself, on its own background.
Windows 7 behavior: the clock (TrayClockWClass) paints into a buffer: the
notification area's background through DrawThemeParentBackground, which
asks the parents to paint, the Clock part, then the time and the date on
two lines. Windows 7's TrayNotify background image is translucent, so the
taskbar's background must be under it. The taskbar also uses buffered
painting with BP_PAINTPARAMS (BeginBufferedPaint).
Wine before: two XP shell changes applied to Windows 7's taskbar too.
0068 made DrawThemeParentBackground under the taskbar draw only the
TrayNotify background (opaque on XP), so the notification area was black;
0069 subclassed the clock and drew one line of time over it, so the time
appeared twice. BeginBufferedPaint ignored BP_PAINTPARAMS, and
BufferedPaintClear and BufferedPaintSetAlpha were stubs.
Change: with WIN4WINE_SHELL=win7 neither XP change applies. As documented
for BeginBufferedPaint: BPPF_ERASE starts the buffer as ARGB 0, prcExclude
is excluded from the buffer's clip, and with pBlendFunction
EndBufferedPaint alpha blends the buffer onto the target instead of
copying it. BufferedPaintClear sets ARGB 0 and BufferedPaintSetAlpha sets
the alpha of the rectangle (the whole buffer when it is NULL). The BPPF_*
values are added to uxtheme.h.
Evidence: Windows 7 SP1 x64 explorer.exe shows the taskbar background
under the notification area and the time and date once.
Scope: the XP changes are only left out with WIN4WINE_SHELL=win7. The
buffered paint functions apply to all programs; neither Wine nor the XP
and ReactOS shell modules call them.
---
 dlls/uxtheme/buffer.c | 106 +++++++++++++++++++++++++++++++++++++++++++-------
 dlls/uxtheme/clock.c  |   2 +-
 dlls/uxtheme/draw.c   |   4 +-
 include/uxtheme.h     |   4 ++
 4 files changed, 101 insertions(+), 15 deletions(-)

diff --git a/dlls/uxtheme/buffer.c b/dlls/uxtheme/buffer.c
index 7003d3d..59e7244 100644
--- a/dlls/uxtheme/buffer.c
+++ b/dlls/uxtheme/buffer.c
@@ -40,6 +40,9 @@ struct paintbuffer
     HBITMAP bitmap;
     RECT rect;
     void *bits;
+    BP_BUFFERFORMAT format;
+    BOOL blend;
+    BLENDFUNCTION blendfunc;
 };
 
 static void free_paintbuffer(struct paintbuffer *buffer)
@@ -91,13 +94,19 @@ HPAINTBUFFER WINAPI BeginBufferedPaint(HDC targetdc, const RECT *rect,
     if (!targetdc || IsRectEmpty(rect))
         return NULL;
 
-    if (params)
-        FIXME("painting parameters are ignored\n");
+    if (params && (params->dwFlags & BPPF_NONCLIENT))
+        FIXME("BPPF_NONCLIENT is ignored\n");
 
-    buffer = malloc(sizeof(*buffer));
+    buffer = calloc(1, sizeof(*buffer));
     buffer->targetdc = targetdc;
     buffer->rect = *rect;
+    buffer->format = format;
     buffer->memorydc = CreateCompatibleDC(targetdc);
+    if (params && params->pBlendFunction)
+    {
+        buffer->blend = TRUE;
+        buffer->blendfunc = *params->pBlendFunction;
+    }
 
     switch (format)
     {
@@ -137,6 +146,14 @@ HPAINTBUFFER WINAPI BeginBufferedPaint(HDC targetdc, const RECT *rect,
     IntersectClipRect(buffer->memorydc, rect->left, rect->top, rect->right, rect->bottom);
     DeleteObject(SelectObject(buffer->memorydc, buffer->bitmap));
 
+    if (params && params->prcExclude)
+        ExcludeClipRect(buffer->memorydc, params->prcExclude->left, params->prcExclude->top,
+                        params->prcExclude->right, params->prcExclude->bottom);
+
+    /* BPPF_ERASE: the buffer starts as ARGB = 0. */
+    if (params && (params->dwFlags & BPPF_ERASE))
+        BufferedPaintClear((HPAINTBUFFER)buffer, NULL);
+
     *retdc = buffer->memorydc;
 
     return (HPAINTBUFFER)buffer;
@@ -156,34 +173,97 @@ HRESULT WINAPI EndBufferedPaint(HPAINTBUFFER bufferhandle, BOOL update)
 
     if (update)
     {
-        if (!BitBlt(buffer->targetdc, buffer->rect.left, buffer->rect.top,
-                buffer->rect.right - buffer->rect.left, buffer->rect.bottom - buffer->rect.top,
-                buffer->memorydc, buffer->rect.left, buffer->rect.top, SRCCOPY))
-        {
-            WARN("BitBlt() failed\n");
-        }
+        int width = buffer->rect.right - buffer->rect.left, height = buffer->rect.bottom - buffer->rect.top;
+        BOOL ret;
+
+        /* With a blend function the buffer is alpha blended onto the target. */
+        if (buffer->blend)
+            ret = GdiAlphaBlend(buffer->targetdc, buffer->rect.left, buffer->rect.top, width, height,
+                                buffer->memorydc, buffer->rect.left, buffer->rect.top, width, height,
+                                buffer->blendfunc);
+        else
+            ret = BitBlt(buffer->targetdc, buffer->rect.left, buffer->rect.top, width, height,
+                         buffer->memorydc, buffer->rect.left, buffer->rect.top, SRCCOPY);
+        if (!ret) WARN("drawing the buffer failed\n");
     }
 
     free_paintbuffer(buffer);
     return S_OK;
 }
 
+/* the part of the buffer that rect (in the buffer DC's logical coordinates, NULL for all)
+ * covers, as rows and columns of the bitmap */
+static BOOL get_buffer_area(const struct paintbuffer *buffer, const RECT *rect, RECT *area)
+{
+    RECT all = buffer->rect;
+
+    if (rect && !IntersectRect(&all, &all, rect)) return FALSE;
+    OffsetRect(&all, -buffer->rect.left, -buffer->rect.top);
+    *area = all;
+    return TRUE;
+}
+
+static RGBQUAD *get_buffer_row(const struct paintbuffer *buffer, int y)
+{
+    int width = buffer->rect.right - buffer->rect.left, height = buffer->rect.bottom - buffer->rect.top;
+
+    if (buffer->format == BPBF_DIB) y = height - 1 - y;
+    return (RGBQUAD *)buffer->bits + (size_t)y * width;
+}
+
 /***********************************************************************
  *      BufferedPaintClear                                 (UXTHEME.@)
+ *
+ * Sets the pixels of the rectangle (all of the buffer when NULL) to ARGB = 0.
  */
 HRESULT WINAPI BufferedPaintClear(HPAINTBUFFER hBufferedPaint, const RECT *prc)
 {
-    FIXME("Stub (%p %p)\n", hBufferedPaint, prc);
-    return E_NOTIMPL;
+    struct paintbuffer *buffer = get_buffer_obj(hBufferedPaint);
+    RECT area;
+    int y;
+
+    TRACE("(%p %s)\n", hBufferedPaint, wine_dbgstr_rect(prc));
+
+    if (!buffer) return E_INVALIDARG;
+    if (!get_buffer_area(buffer, prc, &area)) return S_OK;
+
+    if (!buffer->bits || buffer->format == BPBF_TOPDOWNMONODIB)
+    {
+        RECT fill = area;
+        OffsetRect(&fill, buffer->rect.left, buffer->rect.top);
+        PatBlt(buffer->memorydc, fill.left, fill.top, fill.right - fill.left, fill.bottom - fill.top, BLACKNESS);
+        return S_OK;
+    }
+    GdiFlush();
+    for (y = area.top; y < area.bottom; y++)
+        memset(get_buffer_row(buffer, y) + area.left, 0, (area.right - area.left) * sizeof(RGBQUAD));
+    return S_OK;
 }
 
 /***********************************************************************
  *      BufferedPaintSetAlpha                              (UXTHEME.@)
+ *
+ * Sets the alpha of the pixels of the rectangle (all of the buffer when NULL).
  */
 HRESULT WINAPI BufferedPaintSetAlpha(HPAINTBUFFER hBufferedPaint, const RECT *prc, BYTE alpha)
 {
-    FIXME("Stub (%p %p %u)\n", hBufferedPaint, prc, alpha);
-    return E_NOTIMPL;
+    struct paintbuffer *buffer = get_buffer_obj(hBufferedPaint);
+    RECT area;
+    int x, y;
+
+    TRACE("(%p %s %u)\n", hBufferedPaint, wine_dbgstr_rect(prc), alpha);
+
+    if (!buffer) return E_INVALIDARG;
+    if (!buffer->bits || buffer->format == BPBF_TOPDOWNMONODIB) return E_FAIL;
+    if (!get_buffer_area(buffer, prc, &area)) return S_OK;
+
+    GdiFlush();
+    for (y = area.top; y < area.bottom; y++)
+    {
+        RGBQUAD *row = get_buffer_row(buffer, y);
+        for (x = area.left; x < area.right; x++) row[x].rgbReserved = alpha;
+    }
+    return S_OK;
 }
 
 /***********************************************************************
