--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -108,7 +108,9 @@ static BOOL external_shell_taskbar_background(HWND hwnd, HDC dc, const RECT *cli
     int part, saved;
     HRESULT result;
 
-    if (!win4wine_external_shell() || !IsThemeActive()) return FALSE;
