+    if (!win4wine_shell() || !IsThemeActive() || win4wine_shell() == WIN4WINE_SHELL_WIN7) return FALSE;
     while (tray)
     {
         if (GetClassNameW(tray, name, ARRAY_SIZE(name)))
diff --git a/include/uxtheme.h b/include/uxtheme.h
index 508362b..ff8cd3a 100644
--- a/include/uxtheme.h
+++ b/include/uxtheme.h
@@ -259,6 +259,10 @@ typedef enum _BP_BUFFERFORMAT
 	BPBF_TOPDOWNMONODIB
 } BP_BUFFERFORMAT;
 
+#define BPPF_ERASE     0x0001
+#define BPPF_NOCLIP    0x0002
+#define BPPF_NONCLIENT 0x0004
+
 typedef struct _BP_PAINTPARAMS
 {
 	DWORD cbSize;
