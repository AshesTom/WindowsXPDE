From: Codex <codex@localhost>
Subject: [PATCH] win32u: show the screen through top-level windows not painted yet

Purpose: give XP's log-off dialog its dimmed picture of the screen.
XP behavior: a top-level window without a class background brush shows
what was on the screen under it until it paints, and BitBlt from its DC
reads those pixels; BitBlt from the DC of a top-level window not shown
yet reads the screen too (drawing into it changes nothing). XP's shell32
shows its full-screen DimmedWindowClass window (no brush) behind the
"Log Off Windows" dialog and fades it to grey band by band, reading each
band back from the window's own DC. Reading the screen leaves layered
windows out (unless with CAPTUREBLT), so the Start menu's fading item
(shell32's SysFader, still shown when the dialog opens) is not in the
grey picture.
Wine before: a newly shown window's surface started white, and a hidden
window's DC read its unmapped X window (black); the dialog stood on a
white screen.
Change: when such a window is shown, the screen under it is copied into
its surface before the X window is mapped; where a shown layered window
is, the copy is redrawn from the surfaces of this process's windows under
it (left as read when a window of another process shows there). A DC of a top-level window
without WS_VISIBLE takes the screen drawable at the window's position,
with its empty visible region (drawing stays clipped away).
Evidence: a probe reading GetDC/GetWindowDC of a hidden full-screen popup
(in WM_CREATE and after CreateWindow) and of the same popup just shown
gives the screen's pixels on the reference XP; Wine gave 000000 and
ffffff, and now the screen's pixels. XP shell32's log-off dialog in the
test VM fades the desktop to grey.
Scope: external shell opt-in only; top-level, non-layered windows whose
class has no background brush (the copy) and top-level windows without
WS_VISIBLE (the DC).
---
 dlls/win32u/dce.c    | 17 +++++++++
 dlls/win32u/window.c | 98 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 115 insertions(+)

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 5d6cbb7..38fe9dd 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -32,6 +32,7 @@
 #include "wine/opengl_driver.h"
 #include "wine/server.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
 
@@ -857,6 +858,22 @@ static void update_visible_region( struct dce *dce )
 
     if (status || !vis_rgn) return;
 
+    /* Windows reads the screen through the DC of a top-level window that is not shown
+     * yet, while its empty visible region keeps drawing out. Wine read the window's own
+     * unmapped X window (black). See also copy_screen_to_new_surface. */
+    if (win4wine_external_shell() && top_win && top_win != get_desktop_window() &&
+        !(get_window_long( top_win, GWL_STYLE ) & (WS_VISIBLE | WS_CHILD)))
+    {
+        RECT screen = get_virtual_screen_rect( 0, MDT_DEFAULT ), empty;
+
+        user_driver->pGetDC( dce->hdc, dce->hwnd, get_desktop_window(), &win_rect, &screen, flags );
+        if (dce->clip_rgn) NtGdiCombineRgn( vis_rgn, vis_rgn, dce->clip_rgn,
+                                            (flags & DCX_INTERSECTRGN) ? RGN_AND : RGN_DIFF );
+        SetRectEmpty( &empty );
+        set_visible_region( dce->hdc, vis_rgn, &win_rect, &empty, NULL );
+        return;
+    }
+
     user_driver->pGetDC( dce->hdc, dce->hwnd, top_win, &win_rect, &top_rect, flags );
 
     if (dce->clip_rgn) NtGdiCombineRgn( vis_rgn, vis_rgn, dce->clip_rgn,
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 51d5084..7c55d5b 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2167,6 +2167,100 @@ static BOOL is_fullscreen( const MONITORINFO *info, const RECT *rect )
            rect->top <= info->rcMonitor.top && rect->bottom >= info->rcMonitor.bottom;
 }
 
+/* Redraw RECT (screen coordinates) of DC, which shows WINDOW_RECT, as the screen would be
+ * without the layered window LIST[LAYERED]: from the surfaces of the windows under it, bottom
+ * up. Leaves DC as it is when a window above covers part of RECT, or when a window of another
+ * process (whose pixels this process does not have) shows there. */
+static void draw_without_layered( HWND hwnd, HDC dc, const RECT *window_rect, const RECT *rect,
+                                  HWND *list, int layered )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *surfaces[32];
+    RECT visible[32], part;
+    BOOL covered = FALSE;
+    int count = 0, i;
+
+    for (i = 0; list[i]; i++)
+    {
+        struct window_rects rects;
+        WND *win;
+
+        if (i == layered || list[i] == hwnd || !(get_window_long( list[i], GWL_STYLE ) & WS_VISIBLE) ||
+            (get_window_long( list[i], GWL_EXSTYLE ) & WS_EX_LAYERED)) continue;
+        if (!get_window_rects( list[i], COORDS_SCREEN, &rects, get_thread_dpi() ) ||
+            !intersect_rect( &part, &rects.visible, rect )) continue;
+        if (i < layered || count == ARRAY_SIZE(surfaces)) break;
+        if (!(win = get_win_ptr( list[i] )) || win == WND_OTHER_PROCESS || win == WND_DESKTOP) break;
+        if ((surfaces[count] = win->surface)) window_surface_add_ref( surfaces[count] );
+        release_win_ptr( win );
+        if (!surfaces[count]) break;
+        visible[count++] = rects.visible;
+        /* Nothing under a window that covers all of RECT shows. */
+        if ((covered = EqualRect( &part, rect ))) break;
+    }
+    while (count--)
+    {
+        struct window_surface *surface = surfaces[count];
+        RECT src, dst;
+        void *bits;
+
+        if (covered)
+        {
+            intersect_rect( &src, &visible[count], rect );
+            dst = src;
+            OffsetRect( &src, -visible[count].left, -visible[count].top );
+            OffsetRect( &dst, -window_rect->left, -window_rect->top );
+            window_surface_lock( surface );
+            if ((bits = window_surface_get_color( surface, info )))
+                NtGdiSetDIBitsToDeviceInternal( dc, dst.left, dst.top, dst.right - dst.left, dst.bottom - dst.top,
+                                                src.left - surface->rect.left, surface->rect.bottom - src.bottom,
+                                                0, surface->rect.bottom - surface->rect.top,
+                                                bits, info, DIB_RGB_COLORS, 0, 0, FALSE, NULL );
+            window_surface_unlock( surface );
+        }
+        window_surface_release( surface );
+    }
+}
+
+/* Windows shows the screen under a top-level window that has no background brush until the
+ * window paints there; XP's shell32 reads those pixels back to fade its log-off background to
+ * grey. Give such a window's new surface what is on the screen there, before it is mapped. */
+static void copy_screen_to_new_surface( HWND hwnd, const RECT *window_rect )
+{
+    HDC screen, dc;
+    HWND *list;
+    int i;
+
+    if (!(screen = NtUserGetDCEx( 0, 0, DCX_CACHE | DCX_WINDOW ))) return;
+    if ((dc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_WINDOW )))
+    {
+        NtGdiBitBlt( dc, 0, 0, window_rect->right - window_rect->left, window_rect->bottom - window_rect->top,
+                     screen, window_rect->left, window_rect->top, SRCCOPY, 0, 0 );
+        /* Windows reads the screen without layered windows (unless with CAPTUREBLT): the
+         * Start menu's fading item (shell32's SysFader) must not stay in XP's dimmed log-off
+         * and turn-off backgrounds. X has their pixels on the screen; redraw those parts from
+         * the surfaces of the windows under them, from the top-level list's bottom up. */
+        if ((list = list_window_children( 0 )))
+        {
+            for (i = 0; list[i]; i++)
+            {
+                struct window_rects rects;
+                RECT part;
+
+                if (list[i] == hwnd || !(get_window_long( list[i], GWL_STYLE ) & WS_VISIBLE) ||
+                    !(get_window_long( list[i], GWL_EXSTYLE ) & WS_EX_LAYERED)) continue;
+                if (get_window_rects( list[i], COORDS_SCREEN, &rects, get_thread_dpi() ) &&
+                    intersect_rect( &part, &rects.window, window_rect ))
+                    draw_without_layered( hwnd, dc, window_rect, &part, list, i );
+            }
+            free( list );
+        }
+        NtUserReleaseDC( hwnd, dc );
+    }
+    NtUserReleaseDC( 0, screen );
+}
+
 /***********************************************************************
  *           apply_window_pos
  *
@@ -2294,6 +2388,10 @@ static BOOL apply_window_pos( HWND hwnd, HWND insert_after, UINT swp_flags, stru
     {
         TRACE( "win %p surface %p -> %p\n", hwnd, old_surface, new_surface );
         register_window_surface( old_surface, new_surface );
+        if (win4wine_external_shell() && !is_child && new_surface &&
+            new_surface != &dummy_surface && !is_layered && (swp_flags & SWP_SHOWWINDOW) &&
+            !get_class_long_ptr( hwnd, GCLP_HBRBACKGROUND, FALSE ))
+            copy_screen_to_new_surface( hwnd, &new_rects->window );
         if (old_surface)
         {
             if (valid_rects)
