From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] uxtheme: refresh active styles across shell processes

Purpose: make XP's Display Properties update the external shell's taskbar,
folder controls and non-client window frames after applying a visual style.
Wine before: ApplyTheme changes uxtheme's process-local theme state and posts
WM_THEMECHANGED, but the other processes keep drawing their previously loaded
style. Wine also does not repaint external-shell frames on WM_THEMECHANGED.
Change: watch the ThemeManager registry key in external-shell processes. When
its setting changes, reload the theme before IsThemeActive or OpenThemeData
uses the process-local state. Broadcast a new theme-change number so XP's
common controls discard their cached styles, then redraw non-client frames.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
---
 dlls/user32/defwnd.c  |  19 +++++++++
 dlls/uxtheme/system.c | 115 +++++++++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 132 insertions(+), 2 deletions(-)

diff --git a/dlls/user32/defwnd.c b/dlls/user32/defwnd.c
index 9095c57..b1204db 100644
--- a/dlls/user32/defwnd.c
+++ b/dlls/user32/defwnd.c
@@ -80,6 +80,19 @@ static void default_ime_compositionA( HWND hwnd, WPARAM wparam, LPARAM lparam )
     HeapFree( GetProcessHeap(), 0, buf );
 }
 
+/* Refresh Wine's process-local theme state before repainting a broadcast
+ * WM_THEMECHANGED. The registry watcher consumes the change notification. */
+static void external_shell_refresh_theme(void)
+{
+    HMODULE theme;
+    BOOL (WINAPI *is_active)(void);
+    if (!win4wine_external_shell()) return;
+    theme = GetModuleHandleW(L"uxtheme.dll");
+    if (!theme) theme = LoadLibraryW(L"uxtheme.dll");
+    is_active = theme ? (void *)GetProcAddress(theme, "IsThemeActive") : NULL;
+    if (is_active) is_active();
+}
+
 /* Optional Window-part renderer provided by Wine's own uxtheme. */
 static void external_shell_draw_nonclient( HWND hwnd, HDC dc )
 {
@@ -358,6 +371,12 @@ static LRESULT external_shell_defwnd( HWND hwnd, UINT msg, WPARAM wparam, LPARAM
 {
     switch (msg)
     {
+    case WM_THEMECHANGED:
+        if (!win4wine_external_shell()) break;
+        external_shell_refresh_theme();
+        if (!(GetWindowLongW( hwnd, GWL_STYLE ) & WS_CHILD))
+            NtUserRedrawWindow( hwnd, NULL, 0, RDW_FRAME | RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN | RDW_UPDATENOW );
+        break;
     case WM_NCPAINT:
         external_shell_paint_nonclient( hwnd, (HRGN)wparam );
         break;
diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
index efaeca3..5344272 100644
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -55,6 +55,9 @@ static BOOL bThemeActive = FALSE;
 static WCHAR szCurrentTheme[MAX_PATH];
 static WCHAR szCurrentColor[64];
 static WCHAR szCurrentSize[64];
+static HKEY theme_manager_watch_key;
+static HANDLE theme_change_event;
+static WPARAM theme_change_number;
 
 struct user_api_hook user_api = {0};
 
@@ -62,7 +65,8 @@ struct user_api_hook user_api = {0};
 
 static BOOL CALLBACK UXTHEME_broadcast_msg_enumchild (HWND hWnd, LPARAM msg)
 {
-    PostMessageW(hWnd, msg, 0, 0);
+    WPARAM change = msg == WM_THEMECHANGED && win4wine_external_shell() ? theme_change_number : 0;
+    PostMessageW(hWnd, msg, change, 0);
     return TRUE;
 }
 
@@ -71,11 +75,19 @@ static BOOL CALLBACK UXTHEME_broadcast_msg (HWND hWnd, LPARAM msg)
 {
     if (hWnd == NULL)
     {
+	if (msg == WM_THEMECHANGED && win4wine_external_shell())
+	{
+	    WPARAM change = GetTickCount();
+	    if (!change || change == theme_change_number) change = theme_change_number + 1;
+	    if (!change) change = 1;
+	    theme_change_number = change;
+	}
 	EnumWindows (UXTHEME_broadcast_msg, msg);
     }
     else
     {
-	PostMessageW(hWnd, msg, 0, 0);
+	WPARAM change = msg == WM_THEMECHANGED && win4wine_external_shell() ? theme_change_number : 0;
+	PostMessageW(hWnd, msg, change, 0);
 	EnumChildWindows (hWnd, UXTHEME_broadcast_msg_enumchild, msg);
     }
     return TRUE;
@@ -197,6 +209,97 @@ static void UXTHEME_LoadTheme(void)
     }
 }
 
+/* Theme state is process-local, but XP's ApplyTheme broadcasts
+ * WM_THEMECHANGED to every process. Watch the registry key so a process can
+ * reload the newly selected style before repainting its windows. */
+static BOOL UXTHEME_ThemeConfigChanged(void)
+{
+    HKEY key;
+    DWORD size;
+    WCHAR active[10] = L"0";
+    WCHAR theme[MAX_PATH] = L"";
+    WCHAR color[ARRAY_SIZE(szCurrentColor)] = L"";
+    WCHAR style_size[ARRAY_SIZE(szCurrentSize)] = L"";
+    BOOL enabled;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, szThemeManager, 0, KEY_QUERY_VALUE, &key))
+        return bThemeActive;
+
+    size = sizeof(active);
+    if (RegQueryValueExW(key, L"ThemeActive", NULL, NULL, (BYTE *)active, &size))
+        enabled = FALSE;
+    else
+        enabled = active[0] != '0';
+
+    if (enabled)
+    {
+        size = sizeof(color);
+        if (RegQueryValueExW(key, L"ColorName", NULL, NULL, (BYTE *)color, &size)) color[0] = 0;
+        size = sizeof(style_size);
+        if (RegQueryValueExW(key, L"SizeName", NULL, NULL, (BYTE *)style_size, &size)) style_size[0] = 0;
+        if (query_reg_path(key, L"DllName", theme)) theme[0] = 0;
+    }
+    RegCloseKey(key);
+
+    return enabled != bThemeActive || (enabled &&
+        (lstrcmpiW(theme, szCurrentTheme) || lstrcmpiW(color, szCurrentColor) ||
+         lstrcmpiW(style_size, szCurrentSize)));
+}
+
+static void UXTHEME_ArmThemeChangeWatch(void)
+{
+    LSTATUS status;
+
+    if (theme_manager_watch_key && theme_change_event &&
+        (status = RegNotifyChangeKeyValue(theme_manager_watch_key, FALSE, REG_NOTIFY_CHANGE_LAST_SET,
+                                          theme_change_event, TRUE)))
+        WARN("Failed to watch theme registry key: %ld\n", status);
+}
+
+static BOOL CALLBACK UXTHEME_post_own_theme_changed(HWND hwnd, LPARAM unused)
+{
+    DWORD pid;
+    if (GetWindowThreadProcessId(hwnd, &pid) && pid == GetCurrentProcessId())
+        UXTHEME_broadcast_msg(hwnd, WM_THEMECHANGED);
+    return TRUE;
+}
+
+static void UXTHEME_RefreshTheme(void)
+{
+    if (!theme_change_event || WaitForSingleObject(theme_change_event, 0) != WAIT_OBJECT_0)
+        return;
+
+    if (UXTHEME_ThemeConfigChanged())
+    {
+        UXTHEME_LoadTheme();
+        /* The broadcast WM_THEMECHANGED may have come before the registry
+         * named the new style, and the windows laid themselves out for the
+         * old one (XP's taskbar sizes its Start button then): once more, now
+         * that this process has the new style. */
+        EnumWindows(UXTHEME_post_own_theme_changed, 0);
+    }
+    UXTHEME_ArmThemeChangeWatch();
+}
+
+static void UXTHEME_InitThemeChangeWatch(void)
+{
+    DWORD disposition;
+
+    if (!win4wine_external_shell()) return;
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, szThemeManager, 0, NULL, 0,
+                        KEY_QUERY_VALUE | KEY_NOTIFY, NULL, &theme_manager_watch_key,
+                        &disposition))
+        return;
+    theme_change_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if (!theme_change_event)
+    {
+        RegCloseKey(theme_manager_watch_key);
+        theme_manager_watch_key = NULL;
+        return;
+    }
+    UXTHEME_ArmThemeChangeWatch();
+}
+
 /***********************************************************************/
 
 static const WCHAR * const SysColorsNames[] =
@@ -513,12 +616,17 @@ void UXTHEME_InitSystem(HINSTANCE hInst)
     atDialogThemeEnabled = GlobalAddAtomW(L"ux_dialogtheme");
 
     UXTHEME_LoadTheme();
+    UXTHEME_InitThemeChangeWatch();
     ThemeHooksInstall();
 }
 
 void UXTHEME_UninitSystem(void)
 {
     ThemeHooksRemove();
+    if (theme_change_event) CloseHandle(theme_change_event);
+    if (theme_manager_watch_key) RegCloseKey(theme_manager_watch_key);
+    theme_change_event = NULL;
+    theme_manager_watch_key = NULL;
     MSSTYLES_SetActiveTheme(NULL, FALSE);
 
     GlobalDeleteAtom(atWindowTheme);
@@ -540,6 +648,7 @@ BOOL WINAPI IsAppThemed(void)
  */
 BOOL WINAPI IsThemeActive(void)
 {
+    UXTHEME_RefreshTheme();
     TRACE("\n");
     SetLastError(ERROR_SUCCESS);
     return bThemeActive;
@@ -629,6 +738,7 @@ static HTHEME open_theme_data(HWND hwnd, LPCWSTR pszClassList, DWORD flags, UINT
     LPCWSTR pszAppName;
     LPCWSTR pszUseClassList;
     HTHEME hTheme = NULL;
+    UXTHEME_RefreshTheme();
     TRACE("(%p,%s, %lx)\n", hwnd, debugstr_w(pszClassList), flags);
 
     if(!pszClassList)
@@ -1217,6 +1327,7 @@ HRESULT WINAPI ApplyTheme(HTHEMEFILE hThemeFile, char *unknown, HWND hWnd)
     HRESULT hr;
     TRACE("(%p,%s,%p)\n", hThemeFile, unknown, hWnd);
     hr = UXTHEME_SetActiveTheme(hThemeFile);
+    UXTHEME_RefreshTheme();
     UXTHEME_broadcast_msg (NULL, WM_THEMECHANGED);
     return hr;
 }
