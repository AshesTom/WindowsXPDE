From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] uxtheme: draw XP's Display Properties samples as XP

Purpose: the samples of XP's Display Properties look like XP's: on the
Themes page an active window alone over the wallpaper, on the Appearance
page the inactive window, the active window and the message box.
XP behavior (measured on XP SP3, Luna, 96 DPI): themeui passes which
windows to draw (1 the inactive, 2 the active, 4 the message box; the
Themes page 2, the Appearance page 7) and the rectangle they are laid out
in. The inactive window ends 17 pixels short of its right and 20 of its
bottom; the active window starts 10 pixels in and 22 down and reaches the
corner, with "Window Text" at its client's corner and a scroll bar (up
arrow, thumb at the top, down arrow); the message box is 150 by 101 in the
middle, 27 pixels below the active window's top, with a default OK button
of 80 by 30. The windows have a dialog's 3-pixel frame and XP's caption
(frame and SM_CYCAPTION, buttons SM_CYSIZE - 4 square 2 pixels apart, the
inactive window's in Luna's inactive images), and the scheme's fonts and
colours that themeui passes.
Wine before (win4wine patch 0086): all three windows at fixed fractions of
the rectangle whatever the flags (the Themes page showed the Appearance
page's sample), no scroll bar, the style's sizing border, and the system's
fonts and colours.
Change: draw only the requested windows at XP's places, with a scroll bar
in the active window, the dialog frame and the caption geometry of the
themed caption (window.c), and themeui's NONCLIENTMETRICS and colours.
Scope: DrawNCPreview (ordinal 13), which only Display Properties calls.
---
---
diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -1085,57 +1085,136 @@
     return E_NOTIMPL;
 }
 
-/* One window of the Display Properties preview, drawn with the theme's
- * WINDOW class (or the classic look without one). CLIENT receives the
- * client area. */
-static void preview_window(HDC hdc, HTHEME theme, const RECT *window, const WCHAR *title, BOOL active,
-                           BOOL dialog, int client_color, RECT *client)
+/* What the preview draws with: the visual style's classes, or the classic
+ * look without them, and the scheme's fonts and colours that themeui.dll
+ * passes (the system's without them). */
+struct preview
+{
+    HDC hdc;
+    HTHEME window, button, scrollbar;
+    const NONCLIENTMETRICSW *metrics;
+    const COLORREF *colors;
+    int dpi;
+};
+
+static COLORREF preview_color(const struct preview *preview, int index)
+{
+    if (preview->colors) return preview->colors[index];
+    return preview->window ? GetThemeSysColor(preview->window, index) : GetSysColor(index);
+}
+
+static int preview_size(const struct preview *preview, int index)
+{
+    return preview->window ? GetThemeSysSize(preview->window, index) : GetSystemMetrics(index);
+}
+
+static HFONT preview_font(const struct preview *preview, BOOL caption)
 {
-    int caption = GetSystemMetrics(SM_CYCAPTION), border = GetSystemMetrics(SM_CXFRAME), button;
-    RECT rect, text;
     LOGFONTW font;
-    HFONT hfont = NULL, old_font = NULL;
-    HBRUSH brush;
 
-    if (theme)
+    if (preview->metrics) font = caption ? preview->metrics->lfCaptionFont : preview->metrics->lfMessageFont;
+    else if (!preview->window || FAILED(GetThemeSysFont(preview->window, caption ? TMT_CAPTIONFONT : TMT_MSGBOXFONT, &font)))
     {
-        SIZE part;
-        if (SUCCEEDED(GetThemePartSize(theme, hdc, WP_FRAMELEFT, FS_ACTIVE, NULL, TS_TRUE, &part)) && part.cx > 0)
-            border = part.cx;
-        caption = GetThemeSysSize(theme, SM_CYSIZE) + border + 1;
-        if (caption < border + 8) caption = GetSystemMetrics(SM_CYCAPTION) + border;
+        NONCLIENTMETRICSW metrics = {sizeof(metrics)};
+        if (!SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0)) return NULL;
+        font = caption ? metrics.lfCaptionFont : metrics.lfMessageFont;
     }
-    else caption += border;
-    button = caption - border - 5;
+    return CreateFontIndirectW(&font);
+}
+
+/* The vertical scroll bar of the active window, against the right of CLIENT:
+ * the up arrow, the thumb at the top, the track and the down arrow. */
+static void preview_scrollbar(const struct preview *preview, RECT *client)
+{
+    int width = preview_size(preview, SM_CXVSCROLL), height = width;
+    RECT bar, rect;
+    SIZE gripper;
+
+    SetRect(&bar, client->right - width, client->top, client->right, client->bottom);
+    client->right = bar.left;
+    if (bar.bottom - bar.top < 3 * height) return;
+    if (preview->scrollbar)
+    {
+        DrawThemeBackground(preview->scrollbar, preview->hdc, SBP_LOWERTRACKVERT, SCRBS_NORMAL, &bar, NULL);
+        SetRect(&rect, bar.left, bar.top, bar.right, bar.top + height);
+        DrawThemeBackground(preview->scrollbar, preview->hdc, SBP_ARROWBTN, ABS_UPNORMAL, &rect, NULL);
+        OffsetRect(&rect, 0, height);
+        DrawThemeBackground(preview->scrollbar, preview->hdc, SBP_THUMBBTNVERT, SCRBS_NORMAL, &rect, NULL);
+        if (SUCCEEDED(GetThemePartSize(preview->scrollbar, preview->hdc, SBP_GRIPPERVERT, SCRBS_NORMAL,
+                                       NULL, TS_TRUE, &gripper)))
+        {
+            RECT grip;
+            SetRect(&grip, (rect.left + rect.right - gripper.cx) / 2, (rect.top + rect.bottom - gripper.cy) / 2, 0, 0);
+            grip.right = grip.left + gripper.cx;
+            grip.bottom = grip.top + gripper.cy;
+            DrawThemeBackground(preview->scrollbar, preview->hdc, SBP_GRIPPERVERT, SCRBS_NORMAL, &grip, NULL);
+        }
+        SetRect(&rect, bar.left, bar.bottom - height, bar.right, bar.bottom);
+        DrawThemeBackground(preview->scrollbar, preview->hdc, SBP_ARROWBTN, ABS_DOWNNORMAL, &rect, NULL);
+    }
+    else
+    {
+        HBRUSH brush = CreateSolidBrush(preview_color(preview, COLOR_SCROLLBAR));
+        FillRect(preview->hdc, &bar, brush);
+        DeleteObject(brush);
+        SetRect(&rect, bar.left, bar.top, bar.right, bar.top + height);
+        DrawFrameControl(preview->hdc, &rect, DFC_SCROLL, DFCS_SCROLLUP);
+        OffsetRect(&rect, 0, height);
+        DrawEdge(preview->hdc, &rect, EDGE_RAISED, BF_RECT | BF_MIDDLE);
+        SetRect(&rect, bar.left, bar.bottom - height, bar.right, bar.bottom);
+        DrawFrameControl(preview->hdc, &rect, DFC_SCROLL, DFCS_SCROLLDOWN);
+    }
+}
+
+/* One window of the preview, laid out as XP's themed caption (uxtheme's
+ * window.c): the caption over the top frame and SM_CYCAPTION, the buttons
+ * SM_CYSIZE - 4 square, 2 pixels apart and from the frame, the title 2
+ * pixels further in without an icon. CLIENT receives the client area. */
+static void preview_window(const struct preview *preview, const RECT *window, const WCHAR *title, BOOL active,
+                           BOOL dialog, int client_color, RECT *client)
+{
+    HDC hdc = preview->hdc;
+    HTHEME theme = preview->window;
+    /* XP's samples have the frame of a dialog (3 pixels), not the wider
+     * sizing border of the style's windows. */
+    int border = GetSystemMetrics(SM_CXDLGFRAME), bottom = GetSystemMetrics(SM_CYDLGFRAME), caption, button, state, count;
+    RECT rect, text;
+    HFONT font, old_font = NULL;
+    HBRUSH brush;
+    /* SM_CYCAPTION is the caption bar's height and its line. */
+    caption = border + preview_size(preview, SM_CYSIZE) + 1;
+    button = preview_size(preview, SM_CYSIZE) - 4;
 
     /* Caption, frame and client area. */
     SetRect(&rect, window->left, window->top, window->right, window->top + caption);
     if (theme)
     {
-        int state = active ? FS_ACTIVE : FS_INACTIVE;
+        state = active ? FS_ACTIVE : FS_INACTIVE;
         DrawThemeBackground(theme, hdc, WP_CAPTION, active ? CS_ACTIVE : CS_INACTIVE, &rect, NULL);
-        SetRect(&rect, window->left, window->top + caption, window->left + border, window->bottom - border);
+        SetRect(&rect, window->left, window->top + caption, window->left + border, window->bottom - bottom);
         DrawThemeBackground(theme, hdc, WP_FRAMELEFT, state, &rect, NULL);
-        SetRect(&rect, window->right - border, window->top + caption, window->right, window->bottom - border);
+        SetRect(&rect, window->right - border, window->top + caption, window->right, window->bottom - bottom);
         DrawThemeBackground(theme, hdc, WP_FRAMERIGHT, state, &rect, NULL);
-        SetRect(&rect, window->left, window->bottom - border, window->right, window->bottom);
+        SetRect(&rect, window->left, window->bottom - bottom, window->right, window->bottom);
         DrawThemeBackground(theme, hdc, WP_FRAMEBOTTOM, state, &rect, NULL);
     }
     else
     {
         rect = *window;
         DrawEdge(hdc, &rect, EDGE_RAISED, BF_RECT | BF_ADJUST | BF_MIDDLE);
-        SetRect(&text, rect.left, rect.top, rect.right, rect.top + caption - border);
-        DrawCaptionTempW(NULL, hdc, &text, NULL, NULL, NULL,
-                         DC_GRADIENT | (active ? DC_ACTIVE : 0));
+        SetRect(&text, rect.left, rect.top, rect.right, window->top + caption - 1);
+        DrawCaptionTempW(NULL, hdc, &text, NULL, NULL, NULL, DC_GRADIENT | (active ? DC_ACTIVE : 0));
     }
 
     /* Caption buttons: close, and maximize and minimize for a window. */
-    SetRect(&rect, window->right - border - 2 - button, window->top + (caption - button) / 2 + 1,
-            window->right - border - 2, window->top + (caption - button) / 2 + 1 + button);
+    SetRect(&rect, window->right - border - 2 - button, window->top + caption - 3 - button,
+            window->right - border - 2, window->top + caption - 3);
     if (theme)
     {
-        int state = active ? 1 : 4; /* normal, or the inactive look */
+        /* Luna's inactive images follow its four standard ones. */
+        state = 1;
+        if (!active && SUCCEEDED(GetThemeInt(theme, WP_CLOSEBUTTON, 1, TMT_IMAGECOUNT, &count)) && count >= 8)
+            state += 4;
         DrawThemeBackground(theme, hdc, WP_CLOSEBUTTON, state, &rect, NULL);
         if (!dialog)
         {
@@ -1158,35 +1237,25 @@
     }
 
     /* Title. */
-    SetRect(&text, window->left + border + 4, window->top, rect.left - 4, window->top + caption);
-    if ((theme && SUCCEEDED(GetThemeSysFont(theme, TMT_CAPTIONFONT, &font)))
-        || SystemParametersInfoW(SPI_GETICONTITLELOGFONT, sizeof(font), &font, 0))
-    {
-        if (!theme) font.lfWeight = FW_BOLD;
-        hfont = CreateFontIndirectW(&font);
-        old_font = SelectObject(hdc, hfont);
-    }
+    SetRect(&text, window->left + border + 4, window->top + border, rect.left - 2,
+            window->top + border + preview_size(preview, SM_CYSIZE) + 1);
+    if ((font = preview_font(preview, TRUE))) old_font = SelectObject(hdc, font);
     SetBkMode(hdc, TRANSPARENT);
+    SetTextColor(hdc, preview_color(preview, active ? COLOR_CAPTIONTEXT : COLOR_INACTIVECAPTIONTEXT));
     if (theme)
-    {
-        /* The caption part has no text color of its own: the style's caption text colors. */
-        SetTextColor(hdc, GetThemeSysColor(theme, active ? COLOR_CAPTIONTEXT : COLOR_INACTIVECAPTIONTEXT));
         DrawThemeText(theme, hdc, WP_CAPTION, active ? CS_ACTIVE : CS_INACTIVE, title, -1,
-                      DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS, 0, &text);
-    }
+                      DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS, 0, &text);
     else
-    {
-        SetTextColor(hdc, GetSysColor(active ? COLOR_CAPTIONTEXT : COLOR_INACTIVECAPTIONTEXT));
-        DrawTextW(hdc, title, -1, &text, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS);
-    }
-    if (hfont)
+        DrawTextW(hdc, title, -1, &text, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
+    if (font)
     {
         SelectObject(hdc, old_font);
-        DeleteObject(hfont);
+        DeleteObject(font);
     }
 
-    SetRect(client, window->left + border, window->top + caption, window->right - border, window->bottom - border);
-    brush = CreateSolidBrush(theme ? GetThemeSysColor(theme, client_color) : GetSysColor(client_color));
+    if (theme) SetRect(client, window->left + border, window->top + caption, window->right - border, window->bottom - bottom);
+    else SetRect(client, window->left + 2, window->top + caption + 1, window->right - 2, window->bottom - 2);
+    brush = CreateSolidBrush(preview_color(preview, client_color));
     FillRect(hdc, client, brush);
     DeleteObject(brush);
 }
@@ -1200,73 +1269,112 @@
     return fallback;
 }
 
+#define NCPREV_INACTIVEWINDOW 0x1
+#define NCPREV_ACTIVEWINDOW   0x2
+#define NCPREV_MESSAGEBOX     0x4
+
 /***********************************************************************
  *      DrawNCPreview                                       (UXTHEME.13)
  *
- * The sample of XP's Display Properties (Themes and Appearance pages): an
- * inactive window, an active window with text, and a message box, drawn
- * with the given visual style, or the classic look without one.
+ * The samples of XP's Display Properties, drawn with the given visual style
+ * (or the classic look without one), and the scheme's fonts and colours:
+ * the Themes page asks for the active window alone, over its wallpaper,
+ * the Appearance page for an inactive window, the active window and a
+ * message box. Every window keeps its place in PREVIEW, whichever are drawn.
+ * The places are XP's, measured at 96 DPI: the inactive window 17 pixels
+ * short of the right and 20 of the bottom, the active window 10 pixels in
+ * and 22 down to the corner, with "Window Text" and a scroll bar, and the
+ * message box 150 by 101 in the middle, 27 pixels below the active window's
+ * top, with its default OK button (80 by 30).
  */
-HRESULT WINAPI DrawNCPreview(HDC hdc, DWORD flags, RECT *preview, LPCWSTR file, LPCWSTR color,
+HRESULT WINAPI DrawNCPreview(HDC hdc, DWORD flags, RECT *rect, LPCWSTR file, LPCWSTR color,
                              LPCWSTR size, NONCLIENTMETRICSW *metrics, COLORREF *colors)
 {
+    struct preview preview = {hdc, NULL, NULL, NULL, metrics, colors};
     HTHEMEFILE theme_file = NULL;
-    HTHEME window = NULL, button = NULL;
-    RECT rect, client;
-    int width, height, saved;
-    LOGFONTW font;
-    HFONT hfont = NULL, old_font = NULL;
+    RECT window, client, active;
+    int saved, width;
+    HFONT font, old_font = NULL;
     WCHAR text[64];
 
-    TRACE("(%p,%#lx,%s,%s,%s,%s,%p,%p)\n", hdc, flags, wine_dbgstr_rect(preview), debugstr_w(file),
+    TRACE("(%p,%#lx,%s,%s,%s,%s,%p,%p)\n", hdc, flags, wine_dbgstr_rect(rect), debugstr_w(file),
           debugstr_w(color), debugstr_w(size), metrics, colors);
-    if (!hdc || !preview) return E_INVALIDARG;
+    if (!hdc || !rect) return E_INVALIDARG;
+    if (!(flags & (NCPREV_INACTIVEWINDOW | NCPREV_ACTIVEWINDOW | NCPREV_MESSAGEBOX)))
+        flags |= NCPREV_INACTIVEWINDOW | NCPREV_ACTIVEWINDOW | NCPREV_MESSAGEBOX;
     if (file && *file && SUCCEEDED(OpenThemeFile(file, color && *color ? color : NULL,
                                                   size && *size ? size : NULL, &theme_file, 0)))
     {
-        window = OpenThemeDataFromFile(theme_file, NULL, L"WINDOW", 0);
-        button = OpenThemeDataFromFile(theme_file, NULL, L"BUTTON", 0);
+        preview.window = OpenThemeDataFromFile(theme_file, NULL, L"WINDOW", 0);
+        preview.button = OpenThemeDataFromFile(theme_file, NULL, L"BUTTON", 0);
+        preview.scrollbar = OpenThemeDataFromFile(theme_file, NULL, L"SCROLLBAR", 0);
     }
+    preview.dpi = GetDeviceCaps(hdc, LOGPIXELSY);
+    if (preview.dpi <= 0) preview.dpi = 96;
     saved = SaveDC(hdc);
-    width = preview->right - preview->left;
-    height = preview->bottom - preview->top;
-
-    /* Inactive window, then the active one over it. */
-    SetRect(&rect, preview->left, preview->top, preview->right - width / 12, preview->bottom - height / 6);
-    preview_window(hdc, window, &rect, preview_text(1451, L"Inactive Window", text, ARRAY_SIZE(text)), FALSE, FALSE, COLOR_WINDOW, &client);
-    SetRect(&rect, preview->left + width / 24, preview->top + height / 6, preview->right, preview->bottom);
-    preview_window(hdc, window, &rect, preview_text(1450, L"Active Window", text, ARRAY_SIZE(text)), TRUE, FALSE, COLOR_WINDOW, &client);
 
-    if ((window && SUCCEEDED(GetThemeSysFont(window, TMT_MSGBOXFONT, &font)))
-        || SystemParametersInfoW(SPI_GETICONTITLELOGFONT, sizeof(font), &font, 0))
+    if (flags & NCPREV_INACTIVEWINDOW)
     {
-        hfont = CreateFontIndirectW(&font);
-        old_font = SelectObject(hdc, hfont);
+        SetRect(&window, rect->left, rect->top, rect->right - MulDiv(17, preview.dpi, 96),
+                rect->bottom - MulDiv(20, preview.dpi, 96));
+        preview_window(&preview, &window, preview_text(1451, L"Inactive Window", text, ARRAY_SIZE(text)),
+                       FALSE, FALSE, COLOR_WINDOW, &client);
+    }
+
+    SetRect(&active, rect->left + MulDiv(10, preview.dpi, 96), rect->top + MulDiv(22, preview.dpi, 96),
+            rect->right, rect->bottom);
+    if (flags & NCPREV_ACTIVEWINDOW)
+    {
+        preview_window(&preview, &active, preview_text(1450, L"Active Window", text, ARRAY_SIZE(text)),
+                       TRUE, FALSE, COLOR_WINDOW, &client);
+        preview_scrollbar(&preview, &client);
+        if ((font = preview_font(&preview, FALSE))) old_font = SelectObject(hdc, font);
+        SetBkMode(hdc, TRANSPARENT);
+        SetTextColor(hdc, preview_color(&preview, COLOR_WINDOWTEXT));
+        DrawTextW(hdc, preview_text(1460, L"Window Text", text, ARRAY_SIZE(text)), -1, &client,
+                  DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX);
+        if (font)
+        {
+            SelectObject(hdc, old_font);
+            DeleteObject(font);
+        }
     }
-    SetBkMode(hdc, TRANSPARENT);
-    SetTextColor(hdc, window ? GetThemeSysColor(window, COLOR_WINDOWTEXT) : GetSysColor(COLOR_WINDOWTEXT));
-    InflateRect(&client, -6, -4);
-    DrawTextW(hdc, preview_text(1460, L"Window Text", text, ARRAY_SIZE(text)), -1, &client, DT_LEFT | DT_TOP | DT_SINGLELINE);
-
-    /* Message box with its OK button, in the middle. */
-    SetRect(&rect, preview->left + width / 2 - width / 4, preview->top + height / 2,
-            preview->left + width / 2 + width / 4, preview->top + height / 2 + height / 3);
-    preview_window(hdc, window, &rect, preview_text(1457, L"Message Box", text, ARRAY_SIZE(text)), TRUE, TRUE, COLOR_BTNFACE, &client);
-    SetRect(&rect, (client.left + client.right) / 2 - 38, (client.top + client.bottom) / 2 - 12,
-            (client.left + client.right) / 2 + 38, (client.top + client.bottom) / 2 + 11);
-    if (button) DrawThemeBackground(button, hdc, BP_PUSHBUTTON, PBS_DEFAULTED, &rect, NULL);
-    else DrawFrameControl(hdc, &rect, DFC_BUTTON, DFCS_BUTTONPUSH);
-    SetTextColor(hdc, window ? GetThemeSysColor(window, COLOR_BTNTEXT) : GetSysColor(COLOR_BTNTEXT));
-    DrawTextW(hdc, preview_text(1458, L"OK", text, ARRAY_SIZE(text)), -1, &rect, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
 
-    if (hfont)
+    if (flags & NCPREV_MESSAGEBOX)
     {
-        SelectObject(hdc, old_font);
-        DeleteObject(hfont);
+        width = MulDiv(150, preview.dpi, 96);
+        window.left = rect->left + (rect->right - rect->left - width) / 2;
+        window.right = window.left + width;
+        window.top = active.top + MulDiv(27, preview.dpi, 96);
+        window.bottom = min(window.top + MulDiv(101, preview.dpi, 96), rect->bottom);
+        preview_window(&preview, &window, preview_text(1457, L"Message Box", text, ARRAY_SIZE(text)),
+                       TRUE, TRUE, COLOR_BTNFACE, &client);
+        width = MulDiv(40, preview.dpi, 96);
+        SetRect(&window, (client.left + client.right) / 2 - width, (client.top + client.bottom) / 2 - MulDiv(15, preview.dpi, 96),
+                (client.left + client.right) / 2 + width, (client.top + client.bottom) / 2 + MulDiv(15, preview.dpi, 96));
+        if (preview.button) DrawThemeBackground(preview.button, hdc, BP_PUSHBUTTON, PBS_DEFAULTED, &window, NULL);
+        else
+        {
+            FrameRect(hdc, &window, GetStockObject(BLACK_BRUSH));
+            InflateRect(&window, -1, -1);
+            DrawFrameControl(hdc, &window, DFC_BUTTON, DFCS_BUTTONPUSH);
+        }
+        if ((font = preview_font(&preview, FALSE))) old_font = SelectObject(hdc, font);
+        SetBkMode(hdc, TRANSPARENT);
+        SetTextColor(hdc, preview_color(&preview, COLOR_BTNTEXT));
+        DrawTextW(hdc, preview_text(1458, L"OK", text, ARRAY_SIZE(text)), -1, &window,
+                  DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
+        if (font)
+        {
+            SelectObject(hdc, old_font);
+            DeleteObject(font);
+        }
     }
+
     RestoreDC(hdc, saved);
-    if (button) CloseThemeData(button);
-    if (window) CloseThemeData(window);
+    if (preview.scrollbar) CloseThemeData(preview.scrollbar);
+    if (preview.button) CloseThemeData(preview.button);
+    if (preview.window) CloseThemeData(preview.window);
     if (theme_file) CloseThemeFile(theme_file);
     return S_OK;
 }
