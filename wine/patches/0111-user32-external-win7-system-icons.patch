From: Codex <codex@localhost>
Subject: [PATCH] user32: Windows 7's system icons

Purpose: show Windows 7's application, error, warning, question,
information and shield icons in the Windows 7 shell session.
Windows behavior: Windows 7's user32.dll holds the system icons
(IDI_APPLICATION to IDI_SHIELD) as icon groups 100 to 106 (application,
warning, question, error, information, Windows logo, shield). A
class's small icon made from IDI_APPLICATION is its 32x32 image scaled
down by picking pixels, rows counted from the bottom (compared with a
screenshot of a test window's caption on Windows 7 SP1).
Wine before: Wine's own system icons; scaled icons blended pixels.
Change: for WIN4WINE_SHELL=win7, LoadImage of a system icon reads
Windows 7's user32.dll, which the prefix keeps as data in
C:\w7\res\user32-w7.dll (renamed so that it is not taken for the
loaded user32), and keeps the shared icons itself; icons are scaled
down with COLORONCOLOR at Windows 7's sampling phase.
Evidence: the test window's caption icon is pixel-identical to
Windows 7's; message boxes show Windows 7's icons.
Scope: Windows 7 shell session only.
---
 dlls/user32/cursoricon.c   | 67 +++++++++++++++++++++++++++++++++++++++++++++-
 dlls/user32/uitools.c      |  5 ++--
 dlls/user32/user_private.h |  1 +
 3 files changed, 70 insertions(+), 3 deletions(-)

diff --git a/dlls/user32/cursoricon.c b/dlls/user32/cursoricon.c
index 1a94b51..b8672c7 100644
--- a/dlls/user32/cursoricon.c
+++ b/dlls/user32/cursoricon.c
@@ -1370,6 +1370,59 @@ end:
  *
  * Load a cursor or icon from resource or file.
  */
+static HICON CURSORICON_Load(HINSTANCE hInstance, LPCWSTR name,
+                             INT width, INT height, INT depth,
+                             BOOL fCursor, UINT loadflags);
+
+/* The Windows 7 shell session's system icons (IDI_APPLICATION to IDI_SHIELD)
+ * are Windows 7's: its user32.dll, which the prefix keeps as data in
+ * C:\w7\res\user32-w7.dll (a data file named user32.dll would be taken for
+ * the loaded user32), holds them as icons 100 to 106. Shared ones are kept
+ * here, as Wine cannot name a data file's module for its own cache (so
+ * LR_COPYFROMRESOURCE scales them, as Windows 7 does for a class's small
+ * icon). */
+static struct { WORD id; INT width, height, depth; HICON icon; } win7_icons[32];
+static unsigned int win7_icon_count;
+static HMODULE win7_icon_module;
+
+static HICON win7_system_icon( LPCWSTR name, INT width, INT height, INT depth, UINT loadflags )
+{
+    /* IDI_APPLICATION, IDI_HAND, IDI_QUESTION, IDI_EXCLAMATION, IDI_ASTERISK, IDI_WINLOGO, IDI_SHIELD */
+    static const WORD ids[] = { 100, 103, 102, 101, 104, 105, 106 };
+    static BOOL tried;
+    unsigned int i;
+    HICON icon;
+    WORD id;
+
+    if (!IS_INTRESOURCE( name ) || LOWORD( name ) < LOWORD( IDI_APPLICATION ) || LOWORD( name ) > LOWORD( IDI_SHIELD ))
+        return 0;
+    if (!win4wine_win7_shell()) return 0;
+    if (!tried)
+    {
+        tried = TRUE;
+        win7_icon_module = LoadLibraryExW( L"C:\\w7\\res\\user32-w7.dll", NULL,
+                                           LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE );
+    }
+    if (!win7_icon_module) return 0;
+    id = ids[LOWORD( name ) - LOWORD( IDI_APPLICATION )];
+    if (loadflags & LR_SHARED)
+        for (i = 0; i < win7_icon_count; i++)
+            if (win7_icons[i].id == id && win7_icons[i].width == width && win7_icons[i].height == height &&
+                win7_icons[i].depth == depth)
+                return win7_icons[i].icon;
+    if (!(icon = CURSORICON_Load( win7_icon_module, MAKEINTRESOURCEW( id ), width, height, depth, FALSE, loadflags )))
+        return 0;
+    if ((loadflags & LR_SHARED) && win7_icon_count < ARRAY_SIZE(win7_icons))
+    {
+        win7_icons[win7_icon_count].id = id;
+        win7_icons[win7_icon_count].width = width;
+        win7_icons[win7_icon_count].height = height;
+        win7_icons[win7_icon_count].depth = depth;
+        win7_icons[win7_icon_count++].icon = icon;
+    }
+    return icon;
+}
+
 static HICON CURSORICON_Load(HINSTANCE hInstance, LPCWSTR name,
                              INT width, INT height, INT depth,
                              BOOL fCursor, UINT loadflags)
@@ -1390,6 +1443,8 @@ static HICON CURSORICON_Load(HINSTANCE hInstance, LPCWSTR name,
     if ((loadflags & LR_LOADFROMFILE) && get_app_version() >= 0x4000)    /* Load from file */
         return CURSORICON_LoadFromFile( name, width, height, depth, fCursor, loadflags );
 
+    if (!hInstance && !fCursor && (hIcon = win7_system_icon( name, width, height, depth, loadflags )))
+        return hIcon;
     if (!hInstance) hInstance = user32_module;  /* Load OEM cursor/icon */
 
     /* don't cache 16-bit instances (FIXME: should never get 16-bit instances in the first place) */
@@ -2208,7 +2263,17 @@ static void stretch_bitmap( HBITMAP dst, HBITMAP src, int dst_width, int dst_hei
 
     SelectObject( src_dc, src );
     SelectObject( dst_dc, dst );
-    StretchBlt( dst_dc, 0, 0, dst_width, dst_height, src_dc, 0, 0, src_width, src_height, SRCCOPY );
+    /* Windows 7 SP1 picks pixels when it scales an icon down, counting rows
+     * from the bottom (a class's small icon from IDI_APPLICATION, compared
+     * with a screenshot) */
+    if (win4wine_win7_shell() && src_width >= dst_width && src_height >= dst_height)
+    {
+        SetStretchBltMode( dst_dc, COLORONCOLOR );
+        StretchBlt( dst_dc, 0, 0, dst_width, dst_height, src_dc, 0, src_height / dst_height - 1,
+                    src_width, src_height, SRCCOPY );
+    }
+    else
+        StretchBlt( dst_dc, 0, 0, dst_width, dst_height, src_dc, 0, 0, src_width, src_height, SRCCOPY );
 
     DeleteDC( src_dc );
     DeleteDC( dst_dc );
diff --git a/dlls/user32/uitools.c b/dlls/user32/uitools.c
index 4cd7e24..27b6485 100644
--- a/dlls/user32/uitools.c
+++ b/dlls/user32/uitools.c
@@ -1538,7 +1538,8 @@ static void draw_focus_pattern( HDC hdc, const RECT *rc )
     DeleteObject( bitmap );
 }
 
-static BOOL win7_shell(void)
+/* the Windows 7 shell session (WIN4WINE_SHELL=win7) */
+BOOL win4wine_win7_shell(void)
 {
     static int win7 = -1;
     if (win7 < 0)
@@ -1557,7 +1558,7 @@ BOOL WINAPI DrawFocusRect( HDC hdc, const RECT* rc )
     INT oldDrawMode, oldBkMode;
     LOGBRUSH lb;
 
-    if (win7_shell())
+    if (win4wine_win7_shell())
     {
         draw_focus_pattern( hdc, rc );
         return TRUE;
diff --git a/dlls/user32/user_private.h b/dlls/user32/user_private.h
index 3513e50..f9a9267 100644
--- a/dlls/user32/user_private.h
+++ b/dlls/user32/user_private.h
@@ -161,6 +161,7 @@ typedef struct
 extern int bitmap_info_size( const BITMAPINFO * info, WORD coloruse );
 extern BOOL get_icon_size( HICON handle, SIZE *size );
 
+extern BOOL win4wine_win7_shell(void);
 extern struct user_api_hook *user_api;
 LRESULT WINAPI USER_DefDlgProc(HWND, UINT, WPARAM, LPARAM, BOOL);
 LRESULT WINAPI USER_ScrollBarProc(HWND, UINT, WPARAM, LPARAM, BOOL);
