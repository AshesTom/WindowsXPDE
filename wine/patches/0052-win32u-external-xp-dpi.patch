From: Codex <codex@localhost>
Subject: [PATCH] win32u: draw the external shell at the system DPI with XP's icon sizes

Purpose: run the XP shell and its applications at other DPI settings
(LogPixels) the way XP does.
XP behavior: XP has no DPI virtualization; every program draws at the
system DPI itself. Measured with GetSystemMetrics on the reference XP at
96, 108, 120, 132, 144, 168, 192 and 216 DPI: SM_CXICON stays 32 (the
shell's system image lists stay 32x32 and 16x16); SM_CXSMICON is the menu
button's width (iMenuWidth) less two, rounded down to even (16, 18, 20,
24, 26, 30, 36, 40 for a menu width of 18 at 96 DPI); SM_CXCURSOR is 32
up to 144 DPI and 64 above.
Wine before: programs without a DPI-aware manifest were laid out at 96
DPI and their windows stretched as bitmaps (blurred); SM_CXICON was 40 at
120 DPI, SM_CXSMICON 24 and SM_CXCURSOR 48 at 168 DPI.
Change: opted-in processes are system DPI aware unless an AppCompatFlags
layer says otherwise (manifests do not matter, as on XP);
GetSystemMetrics and GetSystemMetricsForDpi return XP's icon, small icon
and cursor sizes.
Evidence: tests/dpi-metrics.c on the reference XP and in the test VM at
96, 120 and 144 DPI; the Start menu's windows have XP's positions and
sizes at 120 DPI and its right column equals XP's pixels.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
---
 dlls/win32u/sysparams.c | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index d8e988a..804fcce 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -5953,6 +5953,10 @@ void sysparams_init(void)
         if (strstr( app_compat_flags, "DPIUNAWARE" )) NtUserSetProcessDpiAwarenessContext( NTUSER_DPI_UNAWARE, 0 );
     }
     free( app_compat_flags );
+
+    /* XP has no DPI virtualization: every program draws at the system DPI
+     * itself. Keep an explicit AppCompatFlags layer, ignore manifests. */
+    if (win4wine_external_shell()) NtUserSetProcessDpiAwarenessContext( NTUSER_DPI_SYSTEM_AWARE, 0 );
 }
 
 static BOOL update_desktop_wallpaper(void)
@@ -6889,6 +6893,35 @@ BOOL WINAPI NtUserSystemParametersInfo( UINT action, UINT val, void *ptr, UINT w
 #undef WINE_SPI_WARN
 }
 
+/* Icon and cursor sizes of XP for the external shell, measured on XP with
+ * GetSystemMetrics at 96, 108, 120, 132, 144, 168, 192 and 216 DPI: XP keeps
+ * 32x32 icons at every DPI, its small icons are the menu button's width less
+ * two, rounded down to even, and its cursors double above 144 DPI. */
+static BOOL xp_dpi_metric( int index, UINT dpi, int *ret )
+{
+    if (!win4wine_external_shell()) return FALSE;
+    switch (index)
+    {
+    case SM_CXICON:
+    case SM_CYICON:
+        *ret = 32;
+        return TRUE;
+    case SM_CXSMICON:
+    case SM_CYSMICON:
+    {
+        UINT width;
+        get_entry_dpi( &entry_MENUWIDTH, 0, &width, dpi );
+        *ret = max( (int)width - 2, 2 ) & ~1;
+        return TRUE;
+    }
+    case SM_CXCURSOR:
+    case SM_CYCURSOR:
+        *ret = dpi > 144 ? 64 : 32;
+        return TRUE;
+    }
+    return FALSE;
+}
+
 int get_system_metrics( int index )
 {
     NONCLIENTMETRICSW ncm;
@@ -6897,6 +6930,9 @@ int get_system_metrics( int index )
     RECT rect;
     UINT ret;
     HDC hdc;
+    int xp;
+
+    if (xp_dpi_metric( index, get_system_dpi(), &xp )) return xp;
 
     /* some metrics are dynamic */
     switch (index)
@@ -7141,6 +7177,9 @@ static int get_system_metrics_for_dpi( int index, unsigned int dpi )
     ICONMETRICSW im;
     UINT ret;
     HDC hdc;
+    int xp;
+
+    if (xp_dpi_metric( index, dpi, &xp )) return xp;
 
     /* some metrics are dynamic */
     switch (index)
