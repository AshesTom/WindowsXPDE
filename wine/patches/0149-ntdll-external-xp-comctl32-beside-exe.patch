From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] ntdll: let a shell process's own comctl32 stand in for SxS redirection

Purpose: run XP's Display Properties (rundll32 with desk.cpl and
themeui.dll) on XP's common controls 6 alone, as XP Explorer runs, so that
its property sheet, buttons and combo boxes are themed.
Wine before (with patch 0022): XP's comctl32 beside the executable was
loaded, but the modules' manifests also loaded Wine's common controls 6,
which created the property sheet with classic buttons.
Change: with the opt-in, when the executable's folder has a comctl32.dll,
skip the SxS redirection for comctl32; the normal search finds that copy.
Scope: only in the XP shell's session (WIN4WINE_EXTERNAL_SHELL without
WIN4WINE_SHELL; 0143 serves ReactOS's shell) and with a comctl32.dll beside
the executable (C:\xp\xp-explorer.exe and C:\windows\rundll32.exe here).
---
 dlls/ntdll/loader.c | 36 +++++++++++++++++++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 76276c7..d3c9b2d 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3349,6 +3349,39 @@ static WCHAR *shell_comctl32(void)
     return NULL;
 }
 
+/* In the XP shell's session, XP's comctl32.dll beside the executable
+ * (XP's common controls 6, as for XP Explorer and the rundll32 of XP's
+ * Display Properties) also stands in for the SxS redirection: otherwise a
+ * module's manifest loads Wine's common controls 6 beside XP's, and the
+ * shell's dialogs mix the two. Programs in the system directories are not
+ * beside it: their comctl32.dll is Wine's, or XP's version 5. */
+static BOOL shell_comctl32_beside_exe( const WCHAR *libname )
+{
+    static int beside = -1;
+    if (wcsicmp( libname, L"comctl32.dll" ) || win4wine_shell() != WIN4WINE_SHELL_XP) return FALSE;
+    if (beside == -1)
+    {
+        const UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+        WCHAR path[MAX_PATH];
+        const WCHAR *slash;
+        size_t length = image->Length / sizeof(WCHAR);
+        beside = 0;
+        if (length && length < MAX_PATH - 13)
+        {
+            memcpy( path, image->Buffer, length * sizeof(WCHAR) );
+            path[length] = 0;
+            if ((slash = wcsrchr( path, '\\' )) &&
+                (slash - path != 19 || (wcsnicmp( path, L"C:\\windows\\system32", 19 ) &&
+                                        wcsnicmp( path, L"C:\\windows\\syswow64", 19 ))))
+            {
+                wcscpy( (WCHAR *)slash + 1, L"comctl32.dll" );
+                beside = native_pe_file( path ) ? 1 : 0;
+            }
+        }
+    }
+    return beside == 1;
+}
+
 /***********************************************************************
  *	find_dll_file
  *
@@ -3371,7 +3404,8 @@ static NTSTATUS find_dll_file( const WCHAR *load_path, const WCHAR *libname, UNI
         status = find_apiset_dll( libname, &fullname );
         if (status == STATUS_DLL_NOT_FOUND) return status;
 
-        if (status)
+        if (status && shell_comctl32_beside_exe( libname )) status = STATUS_SXS_KEY_NOT_FOUND;
+        else if (status)
         {
             status = find_actctx_dll( libname, &fullname );
             if (status == STATUS_SUCCESS) *redirected = TRUE;
