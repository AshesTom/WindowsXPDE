From: Codex <codex@localhost>
Subject: [PATCH] shell32: send notification icons to Windows 7's taskbar in its format

Purpose: show Wine applications' notification icons, and the bridge's
icons for Linux tray items, in Windows 7's notification area.
Windows 7 behavior: Shell_NotifyIconW sends Shell_TrayWnd a WM_COPYDATA
with dwData 1 and 1484 bytes: the signature 0x34753423, the message, a
NOTIFYICONDATAW with 32-bit handles and cbSize 956 (XP's 952 bytes and
the balloon icon), then the caller's module file name (MAX_PATH
characters). Measured with Windows 7 SP1 x64 shell32 and a decoy taskbar
window, for callers' sizes 976 and 956 alike.
Wine before: with the external shell, 0028 sends XP's 960 bytes, which
Windows 7's taskbar refuses (the bridge's "Shell_NotifyIcon 0 for tray
icon 1 failed").
Change: with WIN4WINE_SHELL=win7, send Windows 7's layout, with the fields
that the caller's size has and the process's module file name; the icon
stays the caller's handle, as in 0028.
Evidence: a Linux tray icon (GTK StatusIcon) appears in Windows 7's
notification area, and in its overflow window before "always show all
icons" is set.
Scope: only with WIN4WINE_EXTERNAL_SHELL and WIN4WINE_SHELL=win7.
---
 dlls/shell32/systray.c | 55 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/dlls/shell32/systray.c b/dlls/shell32/systray.c
index 38e9c70..a5d82c9 100644
--- a/dlls/shell32/systray.c
+++ b/dlls/shell32/systray.c
@@ -198,12 +198,67 @@ struct external_shell_notify
 };
 C_ASSERT( sizeof(struct external_shell_notify) == 960 );
 
+/* Windows 7's taskbar (WIN4WINE_SHELL is win7) takes 1484 bytes, as measured with
+ * a decoy taskbar window and Windows 7's shell32: the XP layout, the balloon icon
+ * as a 32-bit handle (cbSize 956), then the caller's module file name. */
+struct windows7_shell_notify
+{
+    struct external_shell_notify xp;
+    DWORD hBalloonIcon;
+    WCHAR module[MAX_PATH];
+};
+C_ASSERT( sizeof(struct windows7_shell_notify) == 1484 );
+
+static BOOL windows7_shell(void)
+{
+    WCHAR value[8];
+    DWORD len = GetEnvironmentVariableW( L"WIN4WINE_SHELL", value, ARRAY_SIZE(value) );
+    return len && len < ARRAY_SIZE(value) && !wcsicmp( value, L"win7" );
+}
+
+static BOOL windows7_shell_notify_icon(HWND tray, DWORD message, const NOTIFYICONDATAW *nid)
+{
+    struct windows7_shell_notify data = {{0}};
+    COPYDATASTRUCT cds = {1, sizeof(data), &data};
+    BOOL ret;
+
+    data.xp.signature = 0x34753423;
+    data.xp.message = message;
+    data.xp.cbSize = FIELD_OFFSET( struct windows7_shell_notify, module ) - FIELD_OFFSET( struct external_shell_notify, cbSize );
+    data.xp.hWnd = HandleToLong( nid->hWnd );
+    data.xp.uID = nid->uID;
+    data.xp.uFlags = nid->uFlags;
+    data.xp.uCallbackMessage = nid->uCallbackMessage;
+    data.xp.hIcon = HandleToLong( nid->hIcon );
+    /* the fields that the caller's size has */
+    if (nid->cbSize >= NOTIFYICONDATAW_V2_SIZE)
+    {
+        lstrcpynW( data.xp.szTip, nid->szTip, ARRAY_SIZE(data.xp.szTip) );
+        data.xp.dwState = nid->dwState;
+        data.xp.dwStateMask = nid->dwStateMask;
+        lstrcpynW( data.xp.szInfo, nid->szInfo, ARRAY_SIZE(data.xp.szInfo) );
+        data.xp.uTimeout = nid->uTimeout;
+        lstrcpynW( data.xp.szInfoTitle, nid->szInfoTitle, ARRAY_SIZE(data.xp.szInfoTitle) );
+        data.xp.dwInfoFlags = nid->dwInfoFlags;
+    }
+    else lstrcpynW( data.xp.szTip, nid->szTip, 64 );
+    if (nid->cbSize >= NOTIFYICONDATAW_V3_SIZE) data.xp.guidItem = nid->guidItem;
+    if (nid->cbSize >= sizeof(NOTIFYICONDATAW)) data.hBalloonIcon = HandleToLong( nid->hBalloonIcon );
+    GetModuleFileNameW( NULL, data.module, ARRAY_SIZE(data.module) );
+
+    ret = SendMessageW( tray, WM_COPYDATA, (WPARAM)nid->hWnd, (LPARAM)&cds );
+    SetLastError( ret ? S_OK : E_FAIL );
+    return ret;
+}
+
 static BOOL external_shell_notify_icon(HWND tray, DWORD message, const NOTIFYICONDATAW *nid)
 {
     struct external_shell_notify data = {0};
     COPYDATASTRUCT cds = {1, sizeof(data), &data};
     BOOL ret;
 
+    if (windows7_shell()) return windows7_shell_notify_icon( tray, message, nid );
+
     data.signature = 0x34753423;
     data.message = message;
     /* The XP size, also in a 64-bit process. */
