From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: repaint the external-shell Luna frame only where needed

Purpose: let a Luna frame follow its window without repainting all of it.
XP behavior: moving a window keeps its window region and nonclient pixels;
only a size, frame or visibility change rebuilds them, and a partial
nonclient update repaints only that part.
Patch 0023 repainted the whole themed caption and rebuilt its region on
every WM_WINDOWPOSCHANGED. For the bridge's native-window frames each move
cost about 10 ms before Wine sent the move to X, and the frame lagged
behind the native client it surrounds.
- Skip the repaint when WM_WINDOWPOSCHANGED has SWP_NOSIZE and no
  SWP_FRAMECHANGED, SWP_SHOWWINDOW or SWP_HIDEWINDOW.
- When the target DC's clip excludes the caption (patch 0075 passes one
  for border-only updates), draw only the borders.
Applies only to windows that patch 0023 manages or to drawing requested by
the external shell, which requires WIN4WINE_EXTERNAL_SHELL.
Derived from public Win32 API behavior; no Microsoft disassembly used.

--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -39,6 +39,14 @@
     BOOL updating, abandoned;
 };
 
+/* A move keeps the window's size, so its region and caption pixels stay. */
+static BOOL moved_only(UINT msg, LPARAM lparam)
+{
+    const WINDOWPOS *pos = (const WINDOWPOS *)lparam;
+    return msg == WM_WINDOWPOSCHANGED && (pos->flags & SWP_NOSIZE) &&
+           !(pos->flags & (SWP_FRAMECHANGED | SWP_SHOWWINDOW | SWP_HIDEWINDOW));
+}
+
 static LRESULT CALLBACK caption_region_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
 {
     struct caption_region *region = (void *)GetPropW(hwnd, region_property);
@@ -57,7 +65,8 @@
 
     result = CallWindowProcW(original, hwnd, msg, wparam, lparam);
     if ((msg == WM_WINDOWPOSCHANGED || msg == WM_STYLECHANGED || msg == WM_DPICHANGED ||
-         msg == WM_THEMECHANGED) && GetPropW(hwnd, region_property) == (HANDLE)region && !region->updating)
+         msg == WM_THEMECHANGED) && GetPropW(hwnd, region_property) == (HANDLE)region && !region->updating &&
+        !moved_only(msg, lparam))
         Win4WineDrawNonClient(hwnd, NULL);
     return result;
 }
@@ -358,7 +367,7 @@
     DWORD style = GetWindowLongW(hwnd, GWL_STYLE), exstyle = GetWindowLongW(hwnd, GWL_EXSTYLE);
     RECT window, client, caption, part, text, buttons[3];
     POINT origin;
-    BOOL active, maximized;
+    BOOL active, maximized, caption_visible;
     int saved, border_x, border_y, caption_height, state;
     LOGFONTW lf;
     HFONT font = NULL;
@@ -429,13 +438,17 @@
      * row that would otherwise stay in the window colour above the client. */
     caption.bottom = max(caption.bottom, min(border_y + GetSystemMetrics(SM_CYCAPTION), client.top));
     if (!target) caption_region_update(hwnd, theme, &caption, maximized);
-    DrawThemeBackground(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, &caption, NULL);
+    /* A target clipped to the borders skips the caption, the costly part. */
+    caption_visible = RectVisible(dc, &caption);
+    if (caption_visible)
+        DrawThemeBackground(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, &caption, NULL);
     part = window; part.top = caption.bottom; part.right = border_x;
     DrawThemeBackground(theme, dc, WP_FRAMELEFT, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
     part = window; part.top = caption.bottom; part.left = window.right - border_x;
     DrawThemeBackground(theme, dc, WP_FRAMERIGHT, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
     part = window; part.top = window.bottom - border_y;
     DrawThemeBackground(theme, dc, WP_FRAMEBOTTOM, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
+    if (!caption_visible) goto done;
 
     text = caption;
     text.top = border_y;
@@ -504,6 +517,7 @@
     text.bottom = text.top + GetSystemMetrics(SM_CYCAPTION);
     DrawThemeText(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, title, -1,
                   DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS, 0, &text);
+done:
     RestoreDC(dc, saved);
     if (font) DeleteObject(font);
     if (!target) ReleaseDC(hwnd, dc);
