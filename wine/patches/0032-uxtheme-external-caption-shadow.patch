From: win4wine maintainers
Subject: [PATCH] uxtheme: draw external caption single shadows

Public XP GDI/theme measurements provide the geometry reference.
Keep ordinary Wine behavior outside the external shell opt-in.

--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -1854,6 +1854,26 @@
     }
     oldTextColor = SetTextColor(hdc, textColor);
     oldBkMode = SetBkMode(hdc, TRANSPARENT);
+    if (GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0) &&
+        !(flags & (DT_CALCRECT | DT_MODIFYSTRING)) &&
+        !(options->dwFlags & ~(DTT_TEXTCOLOR | DTT_FONTPROP)))
+    {
+        int shadow_type;
+        POINT offset;
+        COLORREF shadow_color;
+        if (SUCCEEDED(GetThemeEnumValue(hTheme, iPartId, iStateId, TMT_TEXTSHADOWTYPE, &shadow_type)) &&
+            shadow_type == TST_SINGLE &&
+            SUCCEEDED(GetThemePosition(hTheme, iPartId, iStateId, TMT_TEXTSHADOWOFFSET, &offset)) &&
+            SUCCEEDED(GetThemeColor(hTheme, iPartId, iStateId, TMT_TEXTSHADOWCOLOR, &shadow_color)))
+        {
+            RECT shadow = *rect;
+            shadow.left += offset.x;
+            shadow.top += offset.y;
+            SetTextColor(hdc, shadow_color);
+            DrawTextW(hdc, pszText, iCharCount, &shadow, flags);
+            SetTextColor(hdc, textColor);
+        }
+    }
     DrawTextW(hdc, pszText, iCharCount, rect, flags);
     SetBkMode(hdc, oldBkMode);
     SetTextColor(hdc, oldTextColor);
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -460,7 +460,9 @@
     SetBkMode(dc, TRANSPARENT);
     GetWindowTextW(hwnd, title, ARRAY_SIZE(title));
     SetTextColor(dc, GetThemeSysColor(theme, active ? COLOR_CAPTIONTEXT : COLOR_INACTIVECAPTIONTEXT));
-    DrawTextW(dc, title, -1, &text, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS);
+    text.bottom = text.top + GetSystemMetrics(SM_CYCAPTION);
+    DrawThemeText(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, title, -1,
+                  DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS, 0, &text);
     RestoreDC(dc, saved);
     if (font) DeleteObject(font);
     if (!target) ReleaseDC(hwnd, dc);
