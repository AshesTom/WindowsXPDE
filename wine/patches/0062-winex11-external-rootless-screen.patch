From: Codex <codex@localhost>
Subject: [PATCH] winex11: read the screen from the windows on a rootless X server in the external shell

Purpose: show XP's grey log-off and shut-down screens in win4wine's Wayland
session.
XP behavior: the dialogs' background is the screen as it was, read with a
screen DC and drawn in grey.
Change: a rootless X server (Xwayland) keeps no picture of the screen in its
root window, so a read of it came back black. When the screen DC's read hits
the X error path on a server with the XWAYLAND extension, compose the area
from the mapped top-level windows' own contents, bottom to top, over black.
Windows of another depth (32-bit shadows) are left out, and so are Wayland
clients, which are not X windows: the windows beneath them show instead.
Scope: only with WIN4WINE_EXTERNAL_SHELL; an X server with a real root window
takes the existing path.
---
 dlls/winex11.drv/bitblt.c | 56 +++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 54 insertions(+), 2 deletions(-)

diff --git a/dlls/winex11.drv/bitblt.c b/dlls/winex11.drv/bitblt.c
index 3823d04..63fcbdc 100644
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -49,6 +49,7 @@
 #include "x11drv.h"
 #include "winternl.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(bitblt);
 
@@ -604,6 +605,53 @@ static int XGetImage_handler( Display *dpy, XErrorEvent *event, void *arg )
     return (event->request_code == X_GetImage && event->error_code == BadMatch);
 }
 
+/* A rootless X server (Xwayland) keeps no picture of the screen in its root
+ * window: compose one from the top-level windows' own contents instead. */
+static BOOL is_rootless_screen( Drawable drawable )
+{
+    static int rootless = -1;
+    int opcode, event, error;
+
+    if (drawable != root_window || !win4wine_external_shell()) return FALSE;
+    if (rootless == -1)
+        rootless = XQueryExtension( gdi_display, "XWAYLAND", &opcode, &event, &error );
+    return rootless;
+}
+
+static int compose_screen_handler( Display *dpy, XErrorEvent *event, void *arg )
+{
+    return 1;  /* a window that went away meanwhile */
+}
+
+static void compose_screen( Pixmap pixmap, GC gc, int x, int y, int width, int height, int depth )
+{
+    Window root, parent, *children;
+    unsigned int count, i;
+
+    XSetForeground( gdi_display, gc, 0 );
+    XFillRectangle( gdi_display, pixmap, gc, 0, 0, width, height );
+    if (!XQueryTree( gdi_display, root_window, &root, &parent, &children, &count )) return;
+    X11DRV_expect_error( gdi_display, compose_screen_handler, NULL );
+    for (i = 0; i < count; i++)  /* bottom to top */
+    {
+        XWindowAttributes attr;
+        int left, top, right, bottom;
+
+        if (!XGetWindowAttributes( gdi_display, children[i], &attr )) continue;
+        if (attr.map_state != IsViewable || attr.class != InputOutput || attr.depth != depth) continue;
+        left = max( x, attr.x + attr.border_width );
+        top = max( y, attr.y + attr.border_width );
+        right = min( x + width, attr.x + attr.border_width + attr.width );
+        bottom = min( y + height, attr.y + attr.border_width + attr.height );
+        if (left >= right || top >= bottom) continue;
+        XCopyArea( gdi_display, children[i], pixmap, gc,
+                   left - attr.x - attr.border_width, top - attr.y - attr.border_width,
+                   right - left, bottom - top, left - x, top - y );
+    }
+    X11DRV_check_error();
+    XFree( children );
+}
+
 /***********************************************************************
  *           BITBLT_GetDstArea
  *
@@ -1378,8 +1426,12 @@ DWORD X11DRV_GetImage( PHYSDEV dev, BITMAPINFO *info,
         GC gc = XCreateGC( gdi_display, pixmap, 0, NULL );
 
         XSetGraphicsExposures( gdi_display, gc, False );
-        XCopyArea( gdi_display, physdev->drawable, pixmap, gc,
-                   physdev->dc_rect.left + x, physdev->dc_rect.top + y, width, height, 0, 0 );
+        if (is_rootless_screen( physdev->drawable ))
+            compose_screen( pixmap, gc, physdev->dc_rect.left + x, physdev->dc_rect.top + y,
+                            width, height, vis.depth );
+        else
+            XCopyArea( gdi_display, physdev->drawable, pixmap, gc,
+                       physdev->dc_rect.left + x, physdev->dc_rect.top + y, width, height, 0, 0 );
         image = XGetImage( gdi_display, pixmap, 0, 0, width, height, AllPlanes, ZPixmap );
         XFreePixmap( gdi_display, pixmap );
         XFreeGC( gdi_display, gc );
