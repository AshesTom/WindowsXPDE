From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: support optional NULL DC in GetThemeFont

Purpose: return usable Luna fonts when XP shell calls the public GetThemeFont
API without a DC. NULL is explicitly allowed by the API contract. Passing it
to GetDeviceCaps returned zero DPI, silently producing zero font heights.
Use a temporary display DC in the same way as GetThemeSysFont already does.
Keep explicit DC scaling unchanged. This fixes Wine source only; no Microsoft
binary or theme file is changed. The public tests/theme-font.c regression
compares StartPanel font metrics with an explicit display DC and NULL.
Reference: https://learn.microsoft.com/en-us/windows/win32/api/uxtheme/nf-uxtheme-getthemefont

diff --git a/dlls/uxtheme/property.c b/dlls/uxtheme/property.c
index 188f138..5edf563 100644
--- a/dlls/uxtheme/property.c
+++ b/dlls/uxtheme/property.c
@@ -118,6 +118,8 @@ HRESULT WINAPI GetThemeFont(HTHEME hTheme, HDC hdc, int iPartId,
                             int iStateId, int iPropId, LOGFONTW *pFont)
 {
     PTHEME_PROPERTY tp;
+    HDC screen_dc = NULL;
+    HRESULT hr;
 
     TRACE("(%d, %d, %d)\n", iPartId, iStateId, iPropId);
     if(!hTheme)
@@ -125,7 +127,12 @@ HRESULT WINAPI GetThemeFont(HTHEME hTheme, HDC hdc, int iPartId,
 
     if(!(tp = MSSTYLES_FindProperty(hTheme, iPartId, iStateId, TMT_FONT, iPropId)))
         return E_PROP_ID_UNSUPPORTED;
-    return MSSTYLES_GetPropertyFont(tp, hdc, pFont);
+    /* The public API accepts NULL for the DC; font points still need the
+     * logical screen DPI, as in GetThemeSysFont. */
+    if (!hdc) hdc = screen_dc = GetDC(NULL);
+    hr = MSSTYLES_GetPropertyFont(tp, hdc, pFont);
+    if (screen_dc) ReleaseDC(NULL, screen_dc);
+    return hr;
 }
 
 /***********************************************************************
