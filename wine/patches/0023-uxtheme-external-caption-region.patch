From: Win4Wine contributors
Subject: [PATCH 23] uxtheme: apply the opt-in caption asset region

Transparent Luna caption corners must reveal the desktop instead of the
classic nonclient paint behind them. Use GetThemeBackgroundRegion for the
caption and a rectangular body, tracking an exact private region copy.
Keep custom application regions, release only our own shape on theme-off,
and handle resizing, maximization, DPI and destruction without recursion.

diff --git a/dlls/uxtheme/window.c b/dlls/uxtheme/window.c
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -28,6 +28,126 @@
 #include "vssym32.h"
 
 static void themed_caption_geometry(HWND hwnd, HTHEME theme, RECT *caption, RECT buttons[3]);
+BOOL WINAPI Win4WineDrawNonClient(HWND hwnd, HDC target);
+
+static const WCHAR region_property[] = L"Win4WineCaptionRegion";
+
+struct caption_region
+{
+    WNDPROC original;
+    HRGN managed;
+    BOOL updating, abandoned;
+};
+
+static LRESULT CALLBACK caption_region_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct caption_region *region = (void *)GetPropW(hwnd, region_property);
+    WNDPROC original = region->original;
+    LRESULT result;
+
+    if (msg == WM_NCDESTROY)
+    {
+        if ((WNDPROC)GetWindowLongPtrW(hwnd, GWLP_WNDPROC) == caption_region_proc)
+            SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)original);
+        RemovePropW(hwnd, region_property);
+        if (region->managed) DeleteObject(region->managed);
+        HeapFree(GetProcessHeap(), 0, region);
+        return CallWindowProcW(original, hwnd, msg, wparam, lparam);
+    }
+
+    result = CallWindowProcW(original, hwnd, msg, wparam, lparam);
+    if ((msg == WM_WINDOWPOSCHANGED || msg == WM_STYLECHANGED || msg == WM_DPICHANGED ||
+         msg == WM_THEMECHANGED) && GetPropW(hwnd, region_property) == (HANDLE)region && !region->updating)
+        Win4WineDrawNonClient(hwnd, NULL);
+    return result;
+}
+
+static void caption_region_update(HWND hwnd, HTHEME theme, const RECT *caption, BOOL maximized)
+{
+    struct caption_region *region;
+    HRGN current, shape = NULL, body = NULL, copy = NULL;
+    RECT window;
+    DWORD process;
+    int kind;
+    BOOL applied;
+
+    GetWindowThreadProcessId(hwnd, &process);
+    if (process != GetCurrentProcessId()) return;
+    region = (void *)GetPropW(hwnd, region_property);
+    if (region && (region->updating || region->abandoned)) return;
+    if (!theme && (!region || !region->managed)) return;
+    if (!(current = CreateRectRgn(0, 0, 0, 0))) return;
+    kind = GetWindowRgn(hwnd, current);
+
+    /* An application region always wins, including one installed after ours. */
+    if (region && region->managed && (kind == ERROR || !EqualRgn(current, region->managed)))
+    {
+        DeleteObject(region->managed);
+        region->managed = NULL;
+        region->abandoned = TRUE;
+        goto done;
+    }
+    if (!region && kind != ERROR) goto done;
+
+    if (!theme)
+    {
+        region->updating = TRUE;
+        applied = SetWindowRgn(hwnd, NULL, FALSE);
+        if (GetPropW(hwnd, region_property) != (HANDLE)region) goto done;
+        region->updating = FALSE;
+        if (applied)
+        {
+            DeleteObject(region->managed);
+            region->managed = NULL;
+        }
+        goto done;
+    }
+
+    GetWindowRect(hwnd, &window);
+    if (FAILED(GetThemeBackgroundRegion(theme, NULL, maximized ? WP_MAXCAPTION : WP_CAPTION,
+                                        CS_ACTIVE, caption, &shape))) goto done;
+    body = CreateRectRgn(0, caption->bottom, window.right - window.left, window.bottom - window.top);
+    if (!body || CombineRgn(shape, shape, body, RGN_OR) == ERROR) goto done;
+    if (region && region->managed && EqualRgn(current, shape)) goto done;
+    copy = CreateRectRgn(0, 0, 0, 0);
+    if (!copy || CombineRgn(copy, shape, NULL, RGN_COPY) == ERROR) goto done;
+
+    if (!region)
+    {
+        if (!(region = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*region)))) goto done;
+        region->original = (WNDPROC)GetWindowLongPtrW(hwnd, GWLP_WNDPROC);
+        if (!SetPropW(hwnd, region_property, (HANDLE)region))
+        {
+            HeapFree(GetProcessHeap(), 0, region);
+            goto done;
+        }
+        SetLastError(0);
+        if (!SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)caption_region_proc) && GetLastError())
+        {
+            RemovePropW(hwnd, region_property);
+            HeapFree(GetProcessHeap(), 0, region);
+            goto done;
+        }
+    }
+
+    region->updating = TRUE;
+    applied = SetWindowRgn(hwnd, shape, FALSE);
+    if (applied) shape = NULL; /* The window now owns this handle. */
+    if (GetPropW(hwnd, region_property) != (HANDLE)region) goto done;
+    region->updating = FALSE;
+    if (applied)
+    {
+        if (region->managed) DeleteObject(region->managed);
+        region->managed = copy;
+        copy = NULL;
+    }
+
+done:
+    if (copy) DeleteObject(copy);
+    if (body) DeleteObject(body);
+    if (shape) DeleteObject(shape);
+    DeleteObject(current);
+}
 
 static int caption_button_state(HWND hwnd, HTHEME theme, int part, int state)
 {
@@ -215,12 +335,17 @@
 
     if (!GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0)
         || (style & WS_CAPTION) != WS_CAPTION || (style & WS_CHILD)
-        || (exstyle & WS_EX_TOOLWINDOW)) return FALSE;
+        || (exstyle & WS_EX_TOOLWINDOW))
+    {
+        if (!target) caption_region_update(hwnd, NULL, NULL, FALSE);
+        return FALSE;
+    }
     if (!IsThemeActive())
     {
         UINT flags = DFCS_CAPTIONRESTORE;
         POINT cursor;
         int hit;
+        if (!target) caption_region_update(hwnd, NULL, NULL, FALSE);
         if (!GetPropW(hwnd, L"Win4WineMaximized") || !(style & WS_MAXIMIZEBOX)) return FALSE;
         dc = target ? target : GetWindowDC(hwnd);
         if (!dc) return FALSE;
@@ -267,6 +392,7 @@
     border_y = GetSystemMetrics(style & WS_THICKFRAME ? SM_CYFRAME : SM_CYDLGFRAME);
     caption_height = GetSystemMetrics(SM_CYCAPTION);
     themed_caption_geometry(hwnd, theme, &caption, buttons);
+    if (!target) caption_region_update(hwnd, theme, &caption, maximized);
     DrawThemeBackground(theme, dc, maximized ? WP_MAXCAPTION : WP_CAPTION, state, &caption, NULL);
     part = window; part.top = caption.bottom; part.right = border_x;
     DrawThemeBackground(theme, dc, WP_FRAMELEFT, active ? FS_ACTIVE : FS_INACTIVE, &part, NULL);
