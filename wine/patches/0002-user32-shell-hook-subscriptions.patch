From: Codex <codex@localhost>
Subject: [PATCH] user32: store shell hook subscriptions for companion dispatcher

Purpose: make RegisterShellHookWindow subscriptions visible to the bridge.
XP behavior: taskbars receive SHELLHOOK messages about application HWNDs.
The companion proxy dispatches create/destroy/activate/redraw notifications.
This is an integration shim, not a complete upstream implementation:
notifications require the bridge, which sends them when WinEvents or its
IPC files report a change.
Derived from public Win32 API behavior; no Microsoft disassembly used.

diff --git a/dlls/user32/misc.c b/dlls/user32/misc.c
index 6333fcb..2ce35e4 100644
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -243,8 +243,12 @@ void WINAPI RegisterSystemThread(DWORD flags, DWORD reserved)
  */
 BOOL WINAPI RegisterShellHookWindow(HWND hWnd)
 {
-    FIXME("(%p): stub\n", hWnd);
-    return FALSE;
+    if (!IsWindow(hWnd))
+    {
+        SetLastError(ERROR_INVALID_WINDOW_HANDLE);
+        return FALSE;
+    }
+    return SetPropW(hWnd, L"Win4WineShellHook", (HANDLE)1);
 }
 
 
@@ -253,8 +257,12 @@ BOOL WINAPI RegisterShellHookWindow(HWND hWnd)
  */
 BOOL WINAPI DeregisterShellHookWindow(HWND hWnd)
 {
-    FIXME("(%p): stub\n", hWnd);
-    return FALSE;
+    if (!IsWindow(hWnd))
+    {
+        SetLastError(ERROR_INVALID_WINDOW_HANDLE);
+        return FALSE;
+    }
+    return RemovePropW(hWnd, L"Win4WineShellHook") != NULL;
 }
 
 
