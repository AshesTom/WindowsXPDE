From: Codex <codex@localhost>
Subject: [PATCH] wuaueng: report no pending updates at shutdown

Purpose: let XP's own shut down dialog (msgina) open under Wine.
XP behavior: before offering its choices, the dialog asks the Automatic
Updates engine with WUCheckForUpdatesAtShutdown whether updates wait to be
installed.
Wine before: the export was an unimplemented stub, so Explorer aborted when
Start > Shut Down was chosen; declared without its one 32-bit argument, it
also left the caller's stack unbalanced.
Change: report that nothing is pending; Wine has no Automatic Updates.
Evidence: the public export and Wine's own traces; no disassembly.
Scope: every Wine application (the function was a stub).
Old patches: 0052.
---
 dlls/wuaueng/Makefile.in  |  1 +
 dlls/wuaueng/main.c       | 34 ++++++++++++++++++++++++++++++++++
 dlls/wuaueng/wuaueng.spec |  2 +-
 3 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/dlls/wuaueng/Makefile.in b/dlls/wuaueng/Makefile.in
index 03325f5..8622bb4 100644
--- a/dlls/wuaueng/Makefile.in
+++ b/dlls/wuaueng/Makefile.in
@@ -3,4 +3,5 @@ MODULE    = wuaueng.dll
 EXTRADLLFLAGS = -Wb,--prefer-native
 
 SOURCES = \
+	main.c \
 	version.rc
diff --git a/dlls/wuaueng/main.c b/dlls/wuaueng/main.c
new file mode 100644
index 0000000..9783fe0
--- /dev/null
+++ b/dlls/wuaueng/main.c
@@ -0,0 +1,34 @@
+/*
+ * Automatic Updates engine
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wuaueng);
+
+/* The XP shutdown dialog asks whether updates wait to be installed before
+ * it offers its normal choices. Wine has no Automatic Updates service, so
+ * report that nothing is pending. */
+BOOL WINAPI WUCheckForUpdatesAtShutdown(DWORD flags)
+{
+    TRACE("(%#lx)\n", flags);
+    return FALSE;
+}
diff --git a/dlls/wuaueng/wuaueng.spec b/dlls/wuaueng/wuaueng.spec
index d21d8d4..dea3ee9 100644
--- a/dlls/wuaueng/wuaueng.spec
+++ b/dlls/wuaueng/wuaueng.spec
@@ -1,7 +1,7 @@
 1 stub GetAUOptionsEx
 2 stub DSRunStoreAsComServer
 3 stub UHRunRemoteHandlerServer
-4 stub WUCheckForUpdatesAtShutdown
+4 stdcall WUCheckForUpdatesAtShutdown(long)
 5 stub WUAutoUpdateAtShutdown
 
 @ stub GeneralizeForImaging
