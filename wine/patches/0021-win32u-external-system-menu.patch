From: Codex <codex@localhost>
Subject: [PATCH] win32u: provide foreign default system menus to the external taskbar

Purpose: let the XP taskbar check SC_MINIMIZE before minimizing the active
task on a click.
Wine before: Wine's menus are process-local and GetSystemMenu returned NULL
for another process's window, so the taskbar never sent the minimize.
Change: give the caller a cached default system menu for a foreign window,
with minimize and maximize enabled from its style. The cache is bounded,
owned by the caller, serialized with the user lock and freed for destroyed
windows. Owner-defined entries and disabled commands are not mirrored, and
reverting only discards the caller's copy.
Evidence: tests/system-menu.c.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0010.
---
 dlls/win32u/menu.c | 54 ++++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
index dda7d11..307932e 100644
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -28,6 +28,7 @@
 #include "ntuser_private.h"
 #include "wine/server.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(menu);
 WINE_DECLARE_DEBUG_CHANNEL(accel);
@@ -1580,6 +1581,48 @@ INT WINAPI NtUserMenuItemFromPoint( HWND hwnd, HMENU handle, int x, int y )
     return pos;
 }
 
+/* Default foreign-menu snapshots for the external XP taskbar. Menus are
+ * process-local in Wine; custom owner changes are not mirrored. The caller
+ * holds the user lock to serialize this bounded cache. */
+static HMENU get_foreign_sys_menu( HWND hwnd, BOOL revert )
+{
+    static struct { HWND hwnd; HMENU menu; } copies[2048];
+    unsigned int i, free_slot = ARRAY_SIZE(copies);
+    DWORD style;
+
+    style = get_window_long( hwnd, GWL_STYLE );
+    if (!(style & WS_SYSMENU)) return 0;
+    for (i = 0; i < ARRAY_SIZE(copies); ++i)
+    {
+        if (copies[i].hwnd == hwnd) break;
+        if (copies[i].hwnd && !is_window(copies[i].hwnd))
+        {
+            NtUserDestroyMenu(copies[i].menu);
+            copies[i].hwnd = 0;
+        }
+        if (!copies[i].hwnd) free_slot = i;
+    }
+    if (i == ARRAY_SIZE(copies))
+    {
+        if (revert || free_slot == ARRAY_SIZE(copies)) return 0;
+        i = free_slot;
+        copies[i].menu = copy_sys_popup(FALSE);
+        if (!copies[i].menu) return 0;
+        copies[i].hwnd = hwnd;
+    }
+    if (revert)
+    {
+        NtUserDestroyMenu(copies[i].menu);
+        copies[i].hwnd = 0;
+        return 0;
+    }
+    NtUserEnableMenuItem(copies[i].menu, SC_MINIMIZE, MF_BYCOMMAND |
+                        ((style & WS_MINIMIZEBOX) ? MF_ENABLED : MF_GRAYED));
+    NtUserEnableMenuItem(copies[i].menu, SC_MAXIMIZE, MF_BYCOMMAND |
+                        ((style & WS_MAXIMIZEBOX) ? MF_ENABLED : MF_GRAYED));
+    return copies[i].menu;
+}
+
 /**********************************************************************
  *           NtUserGetSystemMenu    (win32u.@)
  */
@@ -1591,8 +1634,15 @@ HMENU WINAPI NtUserGetSystemMenu( HWND hwnd, BOOL revert )
     if (win == WND_DESKTOP || !win) return 0;
     if (win == WND_OTHER_PROCESS)
     {
-        if (is_window( hwnd )) FIXME( "not supported on other process window %p\n", hwnd );
-        return 0;
+        if (!win4wine_external_shell())
+        {
+            if (is_window( hwnd )) FIXME( "not supported on other process window %p\n", hwnd );
+            return 0;
+        }
+        user_lock();
+        retvalue = get_foreign_sys_menu( hwnd, revert );
+        user_unlock();
+        return retvalue;
     }
 
     if (win->hSysMenu && revert)
