From: Codex <codex@localhost>
Subject: [PATCH] user32, comctl32: draw and size the external shell's Start button like XP

Purpose: show XP's themed and classic Start button.
XP behavior: the shell sets the Start button's theme, which user32's classic
Button never opens; Japanese XP's BCM_GETIDEALSIZE is 112x26 in Luna (51x16
label in the theme font, 2 pixels of text margin, the 25x20 image, 34x6 of
theme padding), and in Classic 5 pixels wider and 7 higher than Wine's
label calculation (seven fixtures). The image's rounded corners show the
taskbar behind them. Above 96 DPI XP's Button draws the image list scaled
to the DPI (ILD_DPISCALE), rounding down: 31x25 at 120 DPI, 37x30 at 144.
Change: for Shell_TrayWnd's children, create Button from Wine's themed
implementation registered as Win4WineStartButton in win4wine-controls.dll,
a copy of Wine's comctl32_v6 (since Wine 11 the module with Wine's v6
controls) that leaves the native XP controls and their activation context
alone. Native image lists stay opaque: size, count and drawing go
through their owner's public API. The ideal size uses the theme's
text extent, background extent and true image size, or the measured Classic
bounds when themes are off, with XP's one-pixel default text margin. Do not
refill the background with the WM_CTLCOLORBTN brush after
DrawThemeParentBackground. Keep logical clip rectangles logical in
translated MM_TEXT print DCs. The Start image list is drawn with
ILD_DPISCALE and counted at its scaled size.
Evidence: tests/start-button.c, tests/start-sizing.c,
tests/classic-start-sizing.c; the taskbar's pixels equal the reference XP
machine's.
Scope: only with WIN4WINE_EXTERNAL_SHELL and the Start button class.
Old patches: 0013, 0033, 0037, 0044.
---
 dlls/comctl32_v6/button.c         | 131 ++++++++++++++++++++++++++++++++++----
 dlls/comctl32_v6/comctl32_v6.spec |   1 +
 dlls/user32/win.c                 |  18 ++++++
 3 files changed, 137 insertions(+), 13 deletions(-)

diff --git a/dlls/comctl32_v6/button.c b/dlls/comctl32_v6/button.c
index 9128e52..f4feec0 100644
--- a/dlls/comctl32_v6/button.c
+++ b/dlls/comctl32_v6/button.c
@@ -55,6 +55,7 @@
 
 #include "comctl32.h"
 #include "uiautomationclient.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(button);
 
@@ -94,6 +95,7 @@ typedef struct _BUTTON_INFO
         HBITMAP bitmap;
         HANDLE  image; /* Duplicated handle used for drawing. */
     } u;
+    BOOL             start_button; /* the external taskbar's Start button (Win4WineStartButton) */
 } BUTTON_INFO;
 
 static UINT BUTTON_CalcLayoutRects( const BUTTON_INFO *infoPtr, HDC hdc, RECT *labelRc, RECT *imageRc, RECT *textRc );
@@ -194,6 +196,7 @@ static const pfThemedPaint btnThemedPaintFunc[MAX_BTN_TYPE] =
 
 typedef BOOL (*pfGetIdealSize)(BUTTON_INFO *infoPtr, SIZE *size);
 
+static HTHEME start_button_theme(const BUTTON_INFO *info);
 static BOOL PB_GetIdealSize(BUTTON_INFO *infoPtr, SIZE *size);
 static BOOL CB_GetIdealSize(BUTTON_INFO *infoPtr, SIZE *size);
 static BOOL GB_GetIdealSize(BUTTON_INFO *infoPtr, SIZE *size);
@@ -319,7 +322,8 @@ HRGN set_control_clipping( HDC hdc, const RECT *rect )
         DeleteObject( hrgn );
         hrgn = 0;
     }
-    DPtoLP( hdc, (POINT *)&rc, 2 );
+    if (!win4wine_external_shell() || GetMapMode(hdc) != MM_TEXT)
+        DPtoLP( hdc, (POINT *)&rc, 2 );
     if (GetLayout( hdc ) & LAYOUT_RTL)  /* compensate for the shifting done by IntersectClipRect */
     {
         rc.left++;
@@ -506,6 +510,12 @@ static LRESULT CALLBACK BUTTON_WindowProc(HWND hWnd, UINT uMsg, WPARAM wParam, L
         infoPtr->hwnd = hWnd;
         infoPtr->parent = cs->hwndParent;
         infoPtr->style = cs->style;
+        {
+            WCHAR name[64];
+            infoPtr->start_button = win4wine_external_shell() &&
+                GetClassNameW(hWnd, name, ARRAY_SIZE(name)) && !wcscmp(name, L"Win4WineStartButton");
+            if (infoPtr->start_button) SetRect(&infoPtr->text_margin, 1, 1, 1, 1);
+        }
         infoPtr->split_style = BCSS_STRETCH;
         infoPtr->glyph = (HIMAGELIST)0x36;  /* Marlett down arrow char code */
         infoPtr->glyph_size.cx = get_default_glyph_size(infoPtr);
@@ -1079,7 +1089,21 @@ static LRESULT CALLBACK BUTTON_WindowProc(HWND hWnd, UINT uMsg, WPARAM wParam, L
 
         if (!size) return FALSE;
 
-        return btnGetIdealSizeFunc[btn_type](infoPtr, size);
+        {
+            BOOL result = btnGetIdealSizeFunc[btn_type](infoPtr, size);
+            HTHEME theme = start_button_theme(infoPtr);
+            RECT content = {0, 0, size->cx, size->cy}, background;
+            /* A stretchable Start image is not its minimum window size.
+             * Add the active theme's content padding to the measured label. */
+            if (result && theme && GetWindowTextLengthW(hWnd) &&
+                SUCCEEDED(GetThemeBackgroundExtent(theme, NULL, BP_PUSHBUTTON,
+                                                    PBS_NORMAL, &content, &background)))
+            {
+                size->cx = background.right - background.left;
+                size->cy = background.bottom - background.top;
+            }
+            return result;
+        }
     }
 
     case WM_NCHITTEST:
@@ -1092,18 +1116,34 @@ static LRESULT CALLBACK BUTTON_WindowProc(HWND hWnd, UINT uMsg, WPARAM wParam, L
 }
 
 /* If maxWidth is zero, rectangle width is unlimited */
+/* This independently registered control is selected only by the opted-in
+ * external taskbar. Ordinary Buttons retain their own font and sizing. */
+static BOOL external_start_button(const BUTTON_INFO *info)
+{
+    return info->start_button;
+}
+
+static HTHEME start_button_theme(const BUTTON_INFO *info)
+{
+    if (!IsThemeActive() || !external_start_button(info)) return NULL;
+    return GetWindowTheme(info->hwnd);
+}
+
 static RECT BUTTON_GetTextRect(const BUTTON_INFO *infoPtr, HDC hdc, const WCHAR *text, LONG maxWidth)
 {
     LONG style = GetWindowLongW(infoPtr->hwnd, GWL_STYLE);
     LONG exStyle = GetWindowLongW(infoPtr->hwnd, GWL_EXSTYLE);
     UINT dtStyle = BUTTON_BStoDT(style, exStyle);
     HFONT hPrevFont;
+    HTHEME theme = start_button_theme(infoPtr);
     RECT rect = {0};
 
     rect.right = maxWidth;
     hPrevFont = SelectObject(hdc, infoPtr->font);
     /* Calculate height without DT_VCENTER and DT_BOTTOM to get the correct height */
-    DrawTextW(hdc, text, -1, &rect, (dtStyle & ~(DT_VCENTER | DT_BOTTOM)) | DT_CALCRECT);
+    if (!theme || FAILED(GetThemeTextExtent(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, text, -1,
+                                            dtStyle & ~(DT_VCENTER | DT_BOTTOM), &rect, &rect)))
+        DrawTextW(hdc, text, -1, &rect, (dtStyle & ~(DT_VCENTER | DT_BOTTOM)) | DT_CALCRECT);
     if (hPrevFont) SelectObject(hdc, hPrevFont);
 
     return rect;
@@ -1240,6 +1280,13 @@ static UINT BUTTON_ILStoBS(UINT align)
     }
 }
 
+/* The XP taskbar owns this image list in its native common-control module.
+ * HIMAGELIST is opaque; use that module's public API for its handles. */
+static HMODULE start_button_image_module(const BUTTON_INFO *info)
+{
+    return info->start_button ? GetModuleHandleW(L"comctl32.dll") : NULL;
+}
+
 static SIZE BUTTON_GetImageSize(const BUTTON_INFO *infoPtr)
 {
     ICONINFO iconInfo;
@@ -1249,10 +1296,22 @@ static SIZE BUTTON_GetImageSize(const BUTTON_INFO *infoPtr)
     /* ImageList has priority over image */
     if (infoPtr->imagelist.himl)
     {
-        int scx, scy;
-        ImageList_GetIconSize(infoPtr->imagelist.himl, &scx, &scy);
+        int scx = 0, scy = 0;
+        HMODULE module = start_button_image_module(infoPtr);
+        BOOL (WINAPI *get_size)(HIMAGELIST, int *, int *) = module
+            ? (void *)GetProcAddress(module, "ImageList_GetIconSize") : ImageList_GetIconSize;
+        if (get_size) get_size(infoPtr->imagelist.himl, &scx, &scy);
         size.cx = scx;
         size.cy = scy;
+        if (module)
+        {
+            /* XP's Button draws the Start image list scaled to the DPI
+             * (ILD_DPISCALE), rounding down: 25x20 at 96 DPI is 31x25 at
+             * 120 DPI and 37x30 at 144 DPI. */
+            UINT dpi = GetDpiForWindow(infoPtr->hwnd);
+            size.cx = scx * dpi / 96;
+            size.cy = scy * dpi / 96;
+        }
     }
     else if (infoPtr->u.image)
     {
@@ -1426,6 +1485,17 @@ static BOOL PB_GetIdealSize(BUTTON_INFO *infoPtr, SIZE *size)
 
         size->cx = labelSize.cx;
         size->cy = labelSize.cy;
+        if (!IsThemeActive() && external_start_button(infoPtr))
+        {
+            SIZE textSize;
+            UINT dpi = GetDpiForWindow(infoPtr->hwnd);
+            /* Public Japanese XP Classic measurements: five outer horizontal
+             * pixels, seven additional text vertical pixels at 96 DPI. Keep
+             * tall image lists at their actual height instead of padding them. */
+            BUTTON_GetTextIdealSize(infoPtr, 0, &textSize);
+            size->cx += MulDiv(5, dpi, 96);
+            size->cy = max(size->cy, textSize.cy + MulDiv(7, dpi, 96));
+        }
     }
     return TRUE;
 }
@@ -1737,9 +1807,27 @@ static void BUTTON_DrawImage(const BUTTON_INFO *infoPtr, HDC hdc, HBRUSH hbr, UI
 {
     if (infoPtr->imagelist.himl)
     {
-        int i = (ImageList_GetImageCount(infoPtr->imagelist.himl) == 1) ? 0 : get_draw_state(infoPtr) - 1;
-
-        ImageList_Draw(infoPtr->imagelist.himl, i, hdc, rect->left, rect->top, ILD_NORMAL);
+        HMODULE module = start_button_image_module(infoPtr);
+        int (WINAPI *get_count)(HIMAGELIST) = module
+            ? (void *)GetProcAddress(module, "ImageList_GetImageCount") : ImageList_GetImageCount;
+        BOOL (WINAPI *draw)(HIMAGELIST, int, HDC, int, int, UINT) = module
+            ? (void *)GetProcAddress(module, "ImageList_Draw") : ImageList_Draw;
+        int i = (get_count && get_count(infoPtr->imagelist.himl) == 1) ? 0 : get_draw_state(infoPtr) - 1;
+        if (module)
+        {
+            BOOL (WINAPI *draw_indirect)(IMAGELISTDRAWPARAMS *) = (void *)GetProcAddress(module, "ImageList_DrawIndirect");
+            IMAGELISTDRAWPARAMS params = {sizeof(params)};
+            params.himl = infoPtr->imagelist.himl;
+            params.i = i;
+            params.hdcDst = hdc;
+            params.x = rect->left;
+            params.y = rect->top;
+            params.rgbBk = CLR_DEFAULT;
+            params.rgbFg = CLR_DEFAULT;
+            params.fStyle = ILD_NORMAL | ILD_DPISCALE;
+            if (draw_indirect && draw_indirect(&params)) return;
+        }
+        if (draw) draw(infoPtr->imagelist.himl, i, hdc, rect->left, rect->top, ILD_NORMAL);
     }
     else
     {
@@ -2771,9 +2859,13 @@ static void PB_ThemedPaint(HTHEME theme, const BUTTON_INFO *infoPtr, HDC hDC, in
     {
         DrawThemeParentBackground(infoPtr->hwnd, hDC, NULL);
         /* Tests show that the brush from WM_CTLCOLORBTN is used for filling background after a
-         * DrawThemeParentBackground() call */
-        brush = (HBRUSH)SendMessageW(parent, WM_CTLCOLORBTN, (WPARAM)hDC, (LPARAM)infoPtr->hwnd);
-        FillRect(hDC, &bgRect, brush ? brush : GetSysColorBrush(COLOR_BTNFACE));
+         * DrawThemeParentBackground() call. The XP taskbar answers with the classic face
+         * brush, while XP keeps its themed background in the Start image's rounded corners. */
+        if (!external_start_button(infoPtr))
+        {
+            brush = (HBRUSH)SendMessageW(parent, WM_CTLCOLORBTN, (WPARAM)hDC, (LPARAM)infoPtr->hwnd);
+            FillRect(hDC, &bgRect, brush ? brush : GetSysColorBrush(COLOR_BTNFACE));
+        }
     }
     DrawThemeBackground(theme, hDC, BP_PUSHBUTTON, state, &bgRect, NULL);
 
@@ -3225,7 +3317,7 @@ static void CL_ThemedPaint(HTHEME theme, const BUTTON_INFO *infoPtr, HDC hDC, in
     }
 }
 
-void BUTTON_Register(void)
+static void register_button_class(const WCHAR *name)
 {
     WNDCLASSW wndClass;
 
@@ -3236,6 +3328,19 @@ void BUTTON_Register(void)
     wndClass.cbWndExtra = sizeof(BUTTON_INFO *);
     wndClass.hCursor = LoadCursorW(0, (LPWSTR)IDC_ARROW);
     wndClass.hbrBackground = NULL;
-    wndClass.lpszClassName = WC_BUTTONW;
+    wndClass.lpszClassName = name;
     RegisterClassW(&wndClass);
 }
+
+void BUTTON_Register(void)
+{
+    register_button_class(WC_BUTTONW);
+}
+
+BOOL WINAPI Win4WineRegisterStartButton(void)
+{
+    WNDCLASSW wc;
+    if (GetClassInfoW(COMCTL32_hModule, L"Win4WineStartButton", &wc)) return TRUE;
+    register_button_class(L"Win4WineStartButton");
+    return GetClassInfoW(COMCTL32_hModule, L"Win4WineStartButton", &wc);
+}
diff --git a/dlls/comctl32_v6/comctl32_v6.spec b/dlls/comctl32_v6/comctl32_v6.spec
index 73f2590..74ecd1f 100644
--- a/dlls/comctl32_v6/comctl32_v6.spec
+++ b/dlls/comctl32_v6/comctl32_v6.spec
@@ -198,3 +198,4 @@
 @ stdcall RegisterClassNameW(wstr)
 @ stdcall UninitializeFlatSB(long)
 @ stdcall _TrackMouseEvent(ptr)
+@ stdcall Win4WineRegisterStartButton()
diff --git a/dlls/user32/win.c b/dlls/user32/win.c
index fa43b4e..86b0fff 100644
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -292,6 +292,24 @@ HWND WIN_CreateWindowEx( CREATESTRUCTW *cs, LPCWSTR className, HINSTANCE module,
     WCHAR name_buf[8];
     HMENU menu;
 
+    /* Keep native XP controls and their activation context unchanged. Only
+     * the taskbar Start button uses Wine's independently registered themed
+     * Button implementation. */
+    if (!IS_INTRESOURCE(className) && !wcsicmp(className, L"Button") && cs->hwndParent
+        && win4wine_external_shell())
+    {
+        WCHAR parent_class[64];
+        if (GetClassNameW(cs->hwndParent, parent_class, ARRAY_SIZE(parent_class))
+            && !wcsicmp(parent_class, L"Shell_TrayWnd"))
+        {
+            HMODULE controls = LoadLibraryW(L"win4wine-controls.dll");
+            BOOL (WINAPI *register_button)(void) = controls
+                ? (void *)GetProcAddress(controls, "Win4WineRegisterStartButton") : NULL;
+            if (register_button && register_button())
+                className = L"Win4WineStartButton";
+        }
+    }
+
     init_class_name( &class, className );
     get_class_version( &class, &version, TRUE );
 
