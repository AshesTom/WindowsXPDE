diff --git a/dlls/uxtheme/property.c b/dlls/uxtheme/property.c
--- a/dlls/uxtheme/property.c
+++ b/dlls/uxtheme/property.c
@@ -131,6 +131,7 @@
      * logical screen DPI, as in GetThemeSysFont. */
     if (!hdc) hdc = screen_dc = GetDC(NULL);
     hr = MSSTYLES_GetPropertyFont(tp, hdc, pFont);
+    if (SUCCEEDED(hr)) UXTHEME_GetExternalStartFont(hTheme, hdc, iPartId, iStateId, iPropId, pFont);
     if (screen_dc) ReleaseDC(NULL, screen_dc);
     return hr;
 }
diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -489,6 +489,7 @@
     hr = MSSTYLES_SetActiveTheme(tf, TRUE);
     if (bThemeActive)
