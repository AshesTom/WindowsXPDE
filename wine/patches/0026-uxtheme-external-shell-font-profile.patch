From: Win4Wine contributors
Subject: [PATCH] uxtheme: honor an explicit local XP Luna font profile

Use user-owned LOGFONT settings only for the opted-in external shell and
matching active theme. Keep ordinary themes and original API failures,
and apply the six system fonts through the existing theme metrics save
and classic restore lifecycle. No Microsoft resources are changed.

diff --git a/dlls/uxtheme/Makefile.in b/dlls/uxtheme/Makefile.in
--- a/dlls/uxtheme/Makefile.in
+++ b/dlls/uxtheme/Makefile.in
@@ -9,6 +9,7 @@
 	clock.c \
 	dialog.c \
 	draw.c \
+	font-profile.c \
 	main.c \
 	metric.c \
 	msstyles.c \
diff --git a/dlls/uxtheme/msstyles.h b/dlls/uxtheme/msstyles.h
--- a/dlls/uxtheme/msstyles.h
+++ b/dlls/uxtheme/msstyles.h
@@ -100,6 +100,10 @@
 BOOL MSSTYLES_LookupPartState(LPCWSTR pszClass, LPCWSTR pszPart, LPCWSTR pszState, int *iPartId, int *iStateId);
 PUXINI_FILE MSSTYLES_GetThemeIni(PTHEME_FILE tf);
 UINT MSSTYLES_GetThemeDPI(PTHEME_CLASS tc);
+PTHEME_CLASS MSSTYLES_GetActiveThemeClass(HTHEME theme);
+BOOL UXTHEME_GetExternalFont(HTHEME theme, HDC dc, int id, LOGFONTW *font);
+BOOL UXTHEME_GetExternalStartFont(HTHEME theme, HDC dc, int part, int state, int property, LOGFONTW *font);
+void UXTHEME_ApplyExternalFonts(PTHEME_FILE file);
 PTHEME_PARTSTATE MSSTYLES_FindPart(PTHEME_CLASS tc, int iPartId);
 PTHEME_PARTSTATE MSSTYLES_FindPartState(PTHEME_CLASS tc, int iPartId, int iStateId, PTHEME_CLASS *tcNext);
 PTHEME_PROPERTY MSSTYLES_FindProperty(PTHEME_CLASS tc, int iPartId, int iStateId, int iPropertyPrimitive, int iPropertyId);
diff --git a/dlls/uxtheme/msstyles.c b/dlls/uxtheme/msstyles.c
--- a/dlls/uxtheme/msstyles.c
+++ b/dlls/uxtheme/msstyles.c
@@ -262,6 +262,17 @@
 UINT MSSTYLES_GetThemeDPI(PTHEME_CLASS tc)
 {
     return tc->dpi;
+}
+
+/* Compare identities before dereferencing a caller-supplied handle. Old theme
+ * handles and already closed classes must not activate the external profile. */
+PTHEME_CLASS MSSTYLES_GetActiveThemeClass(HTHEME theme)
+{
+    PTHEME_CLASS cls;
+    if (!tfActiveTheme || !theme) return NULL;
+    for (cls = tfActiveTheme->classes; cls; cls = cls->next)
+        if (cls == theme && cls->refcount > 0) return cls;
+    return NULL;
 }
 
 /***********************************************************************
