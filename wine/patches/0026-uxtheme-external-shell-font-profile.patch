diff --git a/dlls/uxtheme/font-profile.c b/dlls/uxtheme/font-profile.c
new file mode 100644
--- /dev/null
+++ b/dlls/uxtheme/font-profile.c
@@ -0,0 +1,158 @@
+/* Explicit external-shell font profiles, supplied by the local prefix owner.
+ *
+ * Copyright 2026 Win4Wine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "uxtheme.h"
+#include "vssym32.h"
+#include "msstyles.h"
+
+static BOOL read_dword(HKEY key, const WCHAR *name, DWORD *value)
+{
+    DWORD type, size = sizeof(*value);
+    return !RegQueryValueExW(key, name, NULL, &type, (BYTE *)value, &size)
+        && type == REG_DWORD && size == sizeof(*value);
+}
+
+static BOOL match_string(HKEY key, const WCHAR *name, const WCHAR *expected)
+{
+    WCHAR value[MAX_PATH];
+    DWORD type, size = sizeof(value);
+    if (RegQueryValueExW(key, name, NULL, &type, (BYTE *)value, &size)
+        || type != REG_SZ || size < sizeof(WCHAR) || size > sizeof(value)
+        || size % sizeof(WCHAR) || value[size / sizeof(WCHAR) - 1]) return FALSE;
+    return !lstrcmpiW(value, expected);
+}
+
+static HKEY open_profile(PTHEME_FILE file)
+{
+    static const WCHAR path[] = L"Software\\Win4Wine\\ThemeProfiles\\JapaneseXPLuna";
+    WCHAR enabled[2];
+    DWORD value;
+    HKEY key;
+
+    if (!file || !IsThemeActive()
+        || GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", enabled, ARRAY_SIZE(enabled)) != 1
+        || enabled[0] != '1') return NULL;
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, KEY_QUERY_VALUE, &key)) return NULL;
+    if (!read_dword(key, L"Enabled", &value) || value != 1
+        || !read_dword(key, L"Version", &value) || value != 1
+        || !match_string(key, L"ThemePath", file->szThemeFile)
+        || !match_string(key, L"ColorName", file->pszSelectedColor)
+        || !match_string(key, L"SizeName", file->pszSelectedSize))
+    {
+        RegCloseKey(key);
+        return NULL;
+    }
+    return key;
+}
+
+/* Stored LOGFONTs contain measured character pixel heights at 96 DPI. They
+ * are ordinary user configuration, not theme resources or embedded defaults.
+ * Use the same base-pixel scaling as SPI's stored NONCLIENTMETRICS. */
+static BOOL read_font(HKEY key, const WCHAR *name, UINT dpi, LOGFONTW *font)
+{
+    LOGFONTW value;
+    DWORD type, size = sizeof(value);
+    unsigned int i;
+    if (RegQueryValueExW(key, name, NULL, &type, (BYTE *)&value, &size)
+        || type != REG_BINARY || size != sizeof(value)) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(value.lfFaceName); i++) if (!value.lfFaceName[i]) break;
+    if (!i || i == ARRAY_SIZE(value.lfFaceName)
+        || value.lfHeight >= 0 || value.lfHeight < -4096
+        || value.lfWidth < 0 || value.lfWidth > 4096
+        || value.lfEscapement < -3600 || value.lfEscapement > 3600
+        || value.lfOrientation < -3600 || value.lfOrientation > 3600
+        || value.lfWeight < 0 || value.lfWeight > 1000
+        || value.lfItalic > 1 || value.lfUnderline > 1 || value.lfStrikeOut > 1
+        || value.lfQuality > CLEARTYPE_NATURAL_QUALITY
+        || value.lfOutPrecision > OUT_PS_ONLY_PRECIS
+        || (value.lfClipPrecision & CLIP_MASK) > CLIP_STROKE_PRECIS
+        || (value.lfPitchAndFamily & 0x0f) > VARIABLE_PITCH
+        || (value.lfPitchAndFamily & 0xf0) > FF_DECORATIVE) return FALSE;
+    if (!dpi || dpi > 9600) return FALSE;
+    value.lfHeight = MulDiv(value.lfHeight, dpi, 96);
+    value.lfWidth = MulDiv(value.lfWidth, dpi, 96);
+    if (!value.lfHeight) value.lfHeight = -1;
+    *font = value;
+    return TRUE;
+}
+
+static const WCHAR *font_name(int id)
+{
+    switch (id)
+    {
+    case TMT_CAPTIONFONT: return L"CaptionFont";
+    case TMT_SMALLCAPTIONFONT: return L"SmallCaptionFont";
+    case TMT_MENUFONT: return L"MenuFont";
+    case TMT_STATUSFONT: return L"StatusFont";
+    case TMT_MSGBOXFONT: return L"MessageFont";
+    case TMT_ICONTITLEFONT: return L"IconFont";
+    default: return NULL;
+    }
+}
+
+static BOOL profile_font(PTHEME_FILE file, HDC dc, const WCHAR *name, LOGFONTW *font)
+{
+    HKEY key;
+    HDC screen = NULL;
+    BOOL ret;
+    if (!name || !(key = open_profile(file))) return FALSE;
+    if (!dc) dc = screen = GetDC(NULL);
+    ret = dc && read_font(key, name, GetDeviceCaps(dc, LOGPIXELSY), font);
+    if (screen) ReleaseDC(NULL, screen);
+    RegCloseKey(key);
+    return ret;
+}
+
+BOOL UXTHEME_GetExternalFont(HTHEME theme, HDC dc, int id, LOGFONTW *font)
+{
+    PTHEME_CLASS cls = MSSTYLES_GetActiveThemeClass(theme);
+    return cls && profile_font(cls->tf, dc, font_name(id), font);
+}
+
+BOOL UXTHEME_GetExternalStartFont(HTHEME theme, HDC dc, int part, int state,
+                                int property, LOGFONTW *font)
+{
+    PTHEME_CLASS cls = MSSTYLES_GetActiveThemeClass(theme);
+    if (!cls || lstrcmpiW(cls->szAppName, L"Start") || lstrcmpiW(cls->szClassName, L"Button")
+        || part != BP_PUSHBUTTON || state < 0 || state > PBS_DEFAULTED
+        || property != TMT_FONT) return FALSE;
+    return profile_font(cls->tf, dc, L"StartFont", font);
+}
+
+void UXTHEME_ApplyExternalFonts(PTHEME_FILE file)
+{
+    NONCLIENTMETRICSW metrics;
+    LOGFONTW icon;
+    DPI_AWARENESS_CONTEXT previous;
+    HKEY key;
+    BOOL dirty = FALSE;
+    if (!(key = open_profile(file))) return;
+    previous = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_UNAWARE);
+    metrics.cbSize = sizeof(metrics);
+    if (SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0))
+    {
+        dirty |= read_font(key, L"CaptionFont", 96, &metrics.lfCaptionFont);
+        dirty |= read_font(key, L"SmallCaptionFont", 96, &metrics.lfSmCaptionFont);
+        dirty |= read_font(key, L"MenuFont", 96, &metrics.lfMenuFont);
+        dirty |= read_font(key, L"StatusFont", 96, &metrics.lfStatusFont);
+        dirty |= read_font(key, L"MessageFont", 96, &metrics.lfMessageFont);
+        if (dirty) SystemParametersInfoW(SPI_SETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0);
+    }
+    if (read_font(key, L"IconFont", 96, &icon))
+        SystemParametersInfoW(SPI_SETICONTITLELOGFONT, sizeof(icon), &icon, 0);
+    SetThreadDpiAwarenessContext(previous);
+    RegCloseKey(key);
+}
