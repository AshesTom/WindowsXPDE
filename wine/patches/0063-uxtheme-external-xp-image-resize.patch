From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: resize theme images and shrink sizing margins like XP

Purpose: match XP's pixels wherever the external shell resizes a theme image.
XP's theme manager resizes images itself, taking for each destination pixel
the source pixel under its centre and the lower one when the centre falls
on a boundary. GDI's stretches choose differently: XP's Start button keeps
rows 0, 2 and 4 of its six middle rows shrunk to three, which neither
StretchBlt nor TransparentBlt does on XP. When a destination is smaller
than both sizing margins, XP shrinks them in proportion to each other and
scales the source margins into them; Wine divided by the whole image width
and cropped the corners, so a toolbar separator drawn 6 pixels wide had its
line one pixel right of XP's, and narrower ones lost it. For the opted-in
external shell, resize with that rule before the usual blit and shrink
margins like XP; this replaces the COLORONCOLOR stretch mode from the
previous patch. tests/margin-shrink.c prints the same pixels as the
reference XP machine for Luna's separators and gripper at widths 1 to 12;
the folder window's separators, the Start button background and the address
bar's drop-down button equal XP's on screen.

diff --git a/dlls/uxtheme/draw.c b/dlls/uxtheme/draw.c
index 11b7126..eba21e5 100644
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -373,14 +373,75 @@ static HRESULT UXTHEME_LoadImage(HTHEME hTheme, int iPartId, int iStateId, const
     return S_OK;
 }
 
+static BOOL UXTHEME_StretchBlt(HDC hdcDst, int nXOriginDst, int nYOriginDst, int nWidthDst, int nHeightDst,
+                               HDC hdcSrc, int nXOriginSrc, int nYOriginSrc, int nWidthSrc, int nHeightSrc,
+                               INT transparent, COLORREF transcolor);
+
+/* XP's theme manager resizes images itself: each destination pixel takes the
+ * source pixel under its centre, the lower one when the centre falls on a
+ * boundary. That keeps rows 0, 2 and 4 of six shrunk to three, as XP's Start
+ * button shows, where GDI's colour-keyed stretch keeps rows 1, 3 and 5. */
+static int xp_stretch_source(int d, int src, int dst)
+{
+    return (int)(((2LL * d + 1) * src + 2LL * dst - 1) / (2LL * dst)) - 1;
+}
+
+static BOOL xp_stretch(HDC hdcDst, int x, int y, int width, int height, HDC hdcSrc, int xs, int ys,
+                       int src_width, int src_height, INT transparent, COLORREF transcolor)
+{
+    BITMAPINFO info = {{sizeof(BITMAPINFOHEADER)}};
+    HDC columns = CreateCompatibleDC(hdcSrc), rows = CreateCompatibleDC(hdcSrc);
+    HBITMAP column_bitmap = NULL, row_bitmap = NULL;
+    HGDIOBJ old_columns = NULL, old_rows = NULL;
+    void *bits;
+    BOOL ret = FALSE;
+    int i, start;
+
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -src_height;
+    if (!columns || !rows || !(column_bitmap = CreateDIBSection(columns, &info, DIB_RGB_COLORS, &bits, NULL, 0)))
+        goto done;
+    info.bmiHeader.biHeight = -height;
+    if (!(row_bitmap = CreateDIBSection(rows, &info, DIB_RGB_COLORS, &bits, NULL, 0))) goto done;
+    old_columns = SelectObject(columns, column_bitmap);
+    old_rows = SelectObject(rows, row_bitmap);
+    ret = TRUE;
+    for (i = start = 0; ret && i < width; i++)
+    {
+        int first = xp_stretch_source(start, src_width, width);
+        if (i + 1 < width && xp_stretch_source(i + 1, src_width, width) == first + i + 1 - start) continue;
+        ret = BitBlt(columns, start, 0, i + 1 - start, src_height, hdcSrc, xs + first, ys, SRCCOPY);
+        start = i + 1;
+    }
+    for (i = start = 0; ret && i < height; i++)
+    {
+        int first = xp_stretch_source(start, src_height, height);
+        if (i + 1 < height && xp_stretch_source(i + 1, src_height, height) == first + i + 1 - start) continue;
+        ret = BitBlt(rows, 0, start, width, i + 1 - start, columns, 0, first, SRCCOPY);
+        start = i + 1;
+    }
+    if (ret)
+        ret = UXTHEME_StretchBlt(hdcDst, x, y, width, height, rows, 0, 0, width, height, transparent, transcolor);
+done:
+    if (old_columns) SelectObject(columns, old_columns);
+    if (old_rows) SelectObject(rows, old_rows);
+    if (column_bitmap) DeleteObject(column_bitmap);
+    if (row_bitmap) DeleteObject(row_bitmap);
+    if (columns) DeleteDC(columns);
+    if (rows) DeleteDC(rows);
+    return ret;
+}
+
 /***********************************************************************
  *      UXTHEME_StretchBlt
  *
  * Pseudo TransparentBlt/StretchBlt
  */
-static inline BOOL UXTHEME_StretchBlt(HDC hdcDst, int nXOriginDst, int nYOriginDst, int nWidthDst, int nHeightDst,
-                                      HDC hdcSrc, int nXOriginSrc, int nYOriginSrc, int nWidthSrc, int nHeightSrc,
-                                      INT transparent, COLORREF transcolor)
+static BOOL UXTHEME_StretchBlt(HDC hdcDst, int nXOriginDst, int nYOriginDst, int nWidthDst, int nHeightDst,
+                               HDC hdcSrc, int nXOriginSrc, int nYOriginSrc, int nWidthSrc, int nHeightSrc,
+                               INT transparent, COLORREF transcolor)
 {
     static const BLENDFUNCTION blendFunc = 
     {
@@ -394,10 +455,12 @@ static inline BOOL UXTHEME_StretchBlt(HDC hdcDst, int nXOriginDst, int nYOriginD
     int old_stretch_mode;
     POINT old_brush_org;
 
-    /* XP stretches theme images by repeating source pixels; the opted-in
-     * external shell matches that instead of Wine's halftone smoothing. */
-    old_stretch_mode = SetStretchBltMode(hdcDst, GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0)
-                                                 ? COLORONCOLOR : HALFTONE);
+    if ((nWidthDst != nWidthSrc || nHeightDst != nHeightSrc) && nWidthDst > 0 && nHeightDst > 0
+        && nWidthSrc > 0 && nHeightSrc > 0 && GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0))
+        return xp_stretch(hdcDst, nXOriginDst, nYOriginDst, nWidthDst, nHeightDst, hdcSrc, nXOriginSrc,
+                          nYOriginSrc, nWidthSrc, nHeightSrc, transparent, transcolor);
+
+    old_stretch_mode = SetStretchBltMode(hdcDst, HALFTONE);
     SetBrushOrgEx(hdcDst, nXOriginDst, nYOriginDst, &old_brush_org);
 
     if (transparent == ALPHABLEND_BINARY) {
@@ -880,6 +943,49 @@ static HRESULT UXTHEME_DrawImageBackground(HTHEME hTheme, HDC hdc, int iPartId,
 
         GetThemeMargins(hTheme, hdc, iPartId, iStateId, TMT_SIZINGMARGINS, NULL, &sm);
 
+        /* XP shrinks the margins in proportion to each other when the destination
+         * is smaller than both of them, and scales the source margins into them;
+         * measured with Luna's toolbar separator, which XP draws narrower than 7. */
+        if ((sm.cyTopHeight + sm.cyBottomHeight > dstSize.y || sm.cxLeftWidth + sm.cxRightWidth > dstSize.x)
+            && GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0)) {
+            BOOL shrink_x = sm.cxLeftWidth + sm.cxRightWidth > dstSize.x;
+            BOOL shrink_y = sm.cyTopHeight + sm.cyBottomHeight > dstSize.y;
+            BOOL borderonly = FALSE;
+            int src_x[4], src_y[4], dst_x[4], dst_y[4], i, j;
+
+            src_x[0] = 0; src_x[1] = sm.cxLeftWidth; src_x[2] = srcSize.x - sm.cxRightWidth; src_x[3] = srcSize.x;
+            src_y[0] = 0; src_y[1] = sm.cyTopHeight; src_y[2] = srcSize.y - sm.cyBottomHeight; src_y[3] = srcSize.y;
+            dst_x[0] = 0; dst_x[3] = dstSize.x;
+            dst_y[0] = 0; dst_y[3] = dstSize.y;
+            dst_x[1] = shrink_x ? sm.cxLeftWidth * dstSize.x / (sm.cxLeftWidth + sm.cxRightWidth) : sm.cxLeftWidth;
+            dst_x[2] = shrink_x ? dst_x[1] : dstSize.x - sm.cxRightWidth;
+            dst_y[1] = shrink_y ? sm.cyTopHeight * dstSize.y / (sm.cyTopHeight + sm.cyBottomHeight) : sm.cyTopHeight;
+            dst_y[2] = shrink_y ? dst_y[1] : dstSize.y - sm.cyBottomHeight;
+            GetThemeBool(hTheme, iPartId, iStateId, TMT_BORDERONLY, &borderonly);
+
+            OffsetViewportOrgEx(hdc, rcDst.left, rcDst.top, &org);
+            for (j = 0; j < 3; j++)
+                for (i = 0; i < 3; i++)
+                {
+                    int dw = dst_x[i + 1] - dst_x[i], dh = dst_y[j + 1] - dst_y[j];
+                    int sw = src_x[i + 1] - src_x[i], sh = src_y[j + 1] - src_y[j];
+                    BOOL ok;
+                    if (dw <= 0 || dh <= 0 || sw <= 0 || sh <= 0 || (i == 1 && j == 1 && borderonly)) continue;
+                    if (dw == sw && dh == sh)
+                        ok = UXTHEME_Blt(hdc, dst_x[i], dst_y[j], dw, dh, hdcSrc, rcSrc.left + src_x[i],
+                                         rcSrc.top + src_y[j], transparent, transparentcolor);
+                    else if ((i == 1 || j == 1) && !(shrink_x && i != 1) && !(shrink_y && j != 1))
+                        ok = UXTHEME_SizedBlt(hdc, dst_x[i], dst_y[j], dw, dh, hdcSrc, rcSrc.left + src_x[i],
+                                              rcSrc.top + src_y[j], sw, sh, sizingtype, transparent, transparentcolor);
+                    else
+                        ok = UXTHEME_StretchBlt(hdc, dst_x[i], dst_y[j], dw, dh, hdcSrc, rcSrc.left + src_x[i],
+                                                rcSrc.top + src_y[j], sw, sh, transparent, transparentcolor);
+                    if (!ok && SUCCEEDED(hr)) hr = HRESULT_FROM_WIN32(GetLastError());
+                }
+            SetViewportOrgEx(hdc, org.x, org.y, NULL);
+            goto done;
+        }
+
         /* Resize sizing margins if destination is smaller */
         if (sm.cyTopHeight + sm.cyBottomHeight > dstSize.y || sm.cxLeftWidth + sm.cxRightWidth > dstSize.x) {
             if (sm.cyTopHeight + sm.cyBottomHeight > dstSize.y) {
@@ -993,6 +1099,7 @@ static HRESULT UXTHEME_DrawImageBackground(HTHEME hTheme, HDC hdc, int iPartId,
 draw_error:
         SetViewportOrgEx (hdcDst, org.x, org.y, NULL);
     }
+done:
     SelectObject(hdcSrc, oldSrc);
     DeleteDC(hdcSrc);
     *pRect = rcDst;
