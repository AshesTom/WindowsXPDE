From: Codex <codex@localhost>
Subject: [PATCH] riched20: show an IME's composition string underlined, as Windows does

Purpose: show the text being converted in rich edit controls (Windows 7's
search boxes) as Windows does.
Windows behavior: Windows 7's search box draws the composition string in
the text, underlined: input not yet converted with a wavy line (every
other pixel below the baseline, every fourth one in the row below), the
clause being converted with a thick line (two pixels, from the baseline),
other converted clauses with a thin one. The caret is at the end of the
clause being converted.
Wine before: the composition string was inserted and selected, so it was
shown in the selection's colours, with no caret.
Change: with an external shell, the composition string is inserted with
underline styles from GCS_COMPATTR (CFU_UNDERLINEWAVE, CFU_UNDERLINETHICK,
CFU_UNDERLINE), its length is kept instead of a selection, the caret goes
to GCS_CURSORPOS or after the target clause, and the result string
replaces it. A cancelled composition is removed. The thick and wavy
underlines are drawn as Windows 7 draws them.
Evidence: the Start menu's search box on Windows 7 SP1 with Microsoft
IME ("kouho", then converted): in the session with Mozc the underline
rows are the same pixels as Windows 7's. Committing, cancelling and
typing after a composition work.
Scope: external shells (WIN4WINE_EXTERNAL_SHELL).
---
 dlls/riched20/editor.c  | 103 +++++++++++++++++++++++++++++++++++++++++++++++-
 dlls/riched20/editstr.h |   1 +
 dlls/riched20/paint.c   |  31 +++++++++++++++
 3 files changed, 134 insertions(+), 1 deletion(-)

diff --git a/dlls/riched20/editor.c b/dlls/riched20/editor.c
index 1a0c444..f39f07b 100644
--- a/dlls/riched20/editor.c
+++ b/dlls/riched20/editor.c
@@ -232,6 +232,7 @@
 #include "rtf.h"
 #include "imm.h"
 #include "res.h"
+#include "wine/win4wine.h"
 
 #define STACK_SIZE_DEFAULT  100
 #define STACK_SIZE_MAX     1000
@@ -2993,6 +2994,8 @@ ME_TextEditor *ME_MakeEditor(ITextHost *texthost, BOOL bEmulateVersion10)
   ed->richole = NULL;
   ed->lpOleCallback = NULL;
   ed->mode = TM_MULTILEVELUNDO | TM_MULTICODEPAGE;
+  ed->imeStartIndex = -1;
+  ed->imeLength = 0;
   ed->mode |= (ed->props & TXTBIT_RICHTEXT) ? TM_RICHTEXT : TM_PLAINTEXT;
   ed->AutoURLDetect_bEnable = FALSE;
   ed->bHaveFocus = FALSE;
@@ -3255,6 +3258,91 @@ static LRESULT handle_EM_SETCHARFORMAT( ME_TextEditor *editor, WPARAM flags, con
  * The LRESULT that is returned is a return value for window procs,
  * and the phresult parameter is the COM return code needed by the
  * text services interface. */
+/* win4wine: with an external shell the composition string is shown as in
+ * Windows: underlined in the text (dotted while not converted, thick in the
+ * clause being converted, thin in the other clauses), with the caret at the
+ * IME's cursor, instead of selected. */
+static void ime_remove_composition( ME_TextEditor *editor )
+{
+    if (editor->imeStartIndex < 0 || !editor->imeLength) return;
+    set_selection_cursors( editor, editor->imeStartIndex, editor->imeStartIndex + editor->imeLength );
+    ME_DeleteSelection( editor );
+    editor->imeLength = 0;
+}
+
+static BYTE ime_underline( BYTE attr )
+{
+    switch (attr)
+    {
+    case ATTR_TARGET_CONVERTED:
+    case ATTR_TARGET_NOTCONVERTED: return CFU_UNDERLINETHICK;
+    case ATTR_CONVERTED: return CFU_UNDERLINE;
+    default: return CFU_UNDERLINEWAVE;
+    }
+}
+
+static void ime_composition( ME_TextEditor *editor, LPARAM lparam )
+{
+    HIMC himc = ITextHost_TxImmGetContext( editor->texthost );
+    ME_Style *style;
+    WCHAR *str;
+    BYTE *attrs;
+    LONG len, count, cursor, i, j;
+
+    if (editor->imeStartIndex < 0) editor->imeStartIndex = ME_GetCursorOfs( &editor->pCursors[0] );
+    ime_remove_composition( editor );
+    ME_DeleteSelection( editor );
+    style = style_get_insert_style( editor, editor->pCursors );
+    if ((lparam & GCS_RESULTSTR) && (len = ImmGetCompositionStringW( himc, GCS_RESULTSTR, NULL, 0 )) > 0 &&
+        (str = malloc( len )))
+    {
+        len = ImmGetCompositionStringW( himc, GCS_RESULTSTR, str, len ) / sizeof(WCHAR);
+        ME_InsertTextFromCursor( editor, 0, str, len, style );
+        free( str );
+    }
+    editor->imeStartIndex = ME_GetCursorOfs( &editor->pCursors[0] );
+    if ((lparam & GCS_COMPSTR) && (len = ImmGetCompositionStringW( himc, GCS_COMPSTR, NULL, 0 )) > 0 &&
+        (str = malloc( len )))
+    {
+        len = ImmGetCompositionStringW( himc, GCS_COMPSTR, str, len ) / sizeof(WCHAR);
+        count = ImmGetCompositionStringW( himc, GCS_COMPATTR, NULL, 0 );
+        attrs = count > 0 ? calloc( 1, max( count, len ) ) : NULL;
+        if (attrs) ImmGetCompositionStringW( himc, GCS_COMPATTR, attrs, count );
+        for (i = 0; i < len; i = j)
+        {
+            CHARFORMAT2W fmt = { sizeof(fmt) };
+            ME_Style *underlined;
+            BYTE attr = attrs ? attrs[i] : ATTR_INPUT;
+
+            for (j = i + 1; j < len && (attrs ? attrs[j] : ATTR_INPUT) == attr; j++) ;
+            fmt.dwMask = CFM_UNDERLINE | CFM_UNDERLINETYPE;
+            fmt.dwEffects = CFE_UNDERLINE;
+            fmt.bUnderlineType = ime_underline( attr );
+            underlined = ME_ApplyStyle( editor, style, &fmt );
+            ME_InsertTextFromCursor( editor, 0, str + i, j - i, underlined );
+            ME_ReleaseStyle( underlined );
+        }
+        editor->imeLength = len;
+        cursor = ImmGetCompositionStringW( himc, GCS_CURSORPOS, NULL, 0 );
+        if (cursor < 0 || cursor > len) cursor = len;
+        /* while converting, after the clause being converted, as Windows 7 shows it */
+        for (i = len; attrs && i > 0; i--)
+            if (attrs[i - 1] == ATTR_TARGET_CONVERTED || attrs[i - 1] == ATTR_TARGET_NOTCONVERTED)
+            {
+                cursor = i;
+                break;
+            }
+        free( attrs );
+        free( str );
+        set_selection_cursors( editor, editor->imeStartIndex + cursor, editor->imeStartIndex + cursor );
+    }
+    ME_SaveTempStyle( editor, style );
+    ME_ReleaseStyle( style );
+    ITextHost_TxImmReleaseContext( editor->texthost, himc );
+    ME_CommitUndo( editor );
+    ME_UpdateRepaint( editor, FALSE );
+}
+
 LRESULT editor_handle_message( ME_TextEditor *editor, UINT msg, WPARAM wParam,
                                LPARAM lParam, HRESULT* phresult )
 {
@@ -4115,11 +4203,17 @@ LRESULT editor_handle_message( ME_TextEditor *editor, UINT msg, WPARAM wParam,
   {
     ME_DeleteSelection(editor);
     editor->imeStartIndex = ME_GetCursorOfs(&editor->pCursors[0]);
+    editor->imeLength = 0;
     ME_CommitUndo(editor);
     ME_UpdateRepaint(editor, FALSE);
     return 0;
   }
   case WM_IME_COMPOSITION:
+    if (win4wine_external_shell())
+    {
+      ime_composition( editor, lParam );
+      return 0;
+    }
   {
     HIMC hIMC;
 
@@ -4156,7 +4250,14 @@ LRESULT editor_handle_message( ME_TextEditor *editor, UINT msg, WPARAM wParam,
   }
   case WM_IME_ENDCOMPOSITION:
   {
-    ME_DeleteSelection(editor);
+    if (win4wine_external_shell())
+    {
+      /* a composition that was cancelled */
+      ime_remove_composition( editor );
+      ME_UpdateRepaint( editor, FALSE );
+    }
+    else
+      ME_DeleteSelection(editor);
     editor->imeStartIndex=-1;
     return 0;
   }
