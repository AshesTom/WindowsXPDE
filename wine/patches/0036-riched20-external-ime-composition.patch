 WINE_DEFAULT_DEBUG_CHANNEL(richedit);
 
@@ -261,10 +262,40 @@ static HPEN get_underline_pen( ME_Style *style, COLORREF color )
     return NULL;
 }
 
+/* win4wine: an IME's composition string (editor.c) with an external shell,
+ * as Windows 7 draws it: thick, two pixels from the baseline, and wavy,
+ * every other pixel below the baseline and every fourth one in the row
+ * below that. */
+static BOOL draw_ime_underline( ME_Context *c, ME_Run *run, int x, int y, COLORREF color )
+{
+    int i;
+
+    if (!(run->style->fmt.dwEffects & CFE_UNDERLINE) || !win4wine_external_shell()) return FALSE;
+    switch (run->style->fmt.bUnderlineType)
+    {
+    case CFU_UNDERLINETHICK:
+    {
+        HBRUSH brush = CreateSolidBrush( color ), old = SelectObject( c->hDC, brush );
+        PatBlt( c->hDC, x, y, run->nWidth, 2, PATCOPY );
+        DeleteObject( SelectObject( c->hDC, old ) );
+        return TRUE;
+    }
+    case CFU_UNDERLINEWAVE:
+        for (i = 0; i < run->nWidth; i += 2)
+        {
+            SetPixelV( c->hDC, x + i, y + 1, color );
+            if (i % 4 == 0) SetPixelV( c->hDC, x + i + 1, y + 2, color );
+        }
+        return TRUE;
+    }
+    return FALSE;
+}
+
 static void draw_underline( ME_Context *c, ME_Run *run, int x, int y, COLORREF color )
 {
     HPEN pen;
 
+    if (draw_ime_underline( c, run, x, y, color )) return;
     pen = get_underline_pen( run->style, color );
     if (pen)
     {
