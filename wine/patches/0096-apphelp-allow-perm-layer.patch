From: Codex <codex@localhost>
Subject: [PATCH] apphelp: implement AllowPermLayer

Purpose: let Windows 7's shell start programs from the Start menu.
Windows 7 behavior: when shell32 starts a program (a shortcut of the
Start menu), it asks apphelp.AllowPermLayer whether compatibility layers
may apply to the program's file.
Wine before: AllowPermLayer was a stub, and the shell ended with
"unimplemented function apphelp.dll.AllowPermLayer" when a Linux
application was started from Windows 7's Start menu.
Change: AllowPermLayer returns FALSE for a network path, a path that is
not a full path with a drive letter, or a path on a remote drive, TRUE
otherwise, as ReactOS's apphelp (dll/appcompat/apphelp/layer.c) does;
its signature follows ReactOS's spec.
Evidence: with the change Windows 7's Start menu starts LXTerminal (a
Linux application's shortcut).
Scope: a new export; Wine's own callers do not use it.
---
 dlls/apphelp/apphelp.c    | 19 +++++++++++++++++++
 dlls/apphelp/apphelp.spec |  2 +-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/dlls/apphelp/apphelp.c b/dlls/apphelp/apphelp.c
index 66e59d7..9100aff 100644
--- a/dlls/apphelp/apphelp.c
+++ b/dlls/apphelp/apphelp.c
@@ -123,3 +123,22 @@ BOOL WINAPI SdbGetPermLayerKeys( PCWSTR path, PWSTR layers, PDWORD size, DWORD f
     SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
     return TRUE;
 }
+
+/***********************************************************************
+ *              AllowPermLayer (APPHELP.@)
+ *
+ * Whether compatibility layers may apply to the file PATH: not on a network
+ * path or a remote drive (as ReactOS's apphelp decides).
+ */
+BOOL WINAPI AllowPermLayer( const WCHAR *path )
+{
+    WCHAR root[] = L"A:\\";
+
+    TRACE( "%s\n", debugstr_w(path) );
+
+    if (!path) return FALSE;
+    if (path[0] && path[1] == '\\') return FALSE;
+    if (!path[0] || path[1] != ':') return FALSE;
+    root[0] = path[0];
+    return GetDriveTypeW( root ) != DRIVE_REMOTE;
+}
diff --git a/dlls/apphelp/apphelp.spec b/dlls/apphelp/apphelp.spec
index 979781d..3609c13 100644
--- a/dlls/apphelp/apphelp.spec
+++ b/dlls/apphelp/apphelp.spec
@@ -1,4 +1,4 @@
-@ stub AllowPermLayer
+@ stdcall AllowPermLayer(wstr)
 @ stub ApphelpCheckExe
 @ stdcall ApphelpCheckInstallShieldPackage(ptr wstr)
 @ stdcall ApphelpCheckMsiPackage(ptr wstr)
