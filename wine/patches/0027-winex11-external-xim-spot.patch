From: Codex <codex@localhost>
Subject: [PATCH] winex11: keep the composition spot asked for before the XIC exists

Purpose: show an input method's composition at the caret from the first
conversion in a window.
Wine before: the XIC is created at the first key press or focus, and
composition positions set earlier were dropped, so the first composition
of a window was shown at its top left corner (seen with fcitx5 and Mozc in
Wine notepad). Later ones followed the caret.
Change: remember the spot while the window has no XIC and give it to the
XIC when it is created.
Evidence: with fcitx5 5.1.12 and Mozc in the test VM, the first
composition in Wine notepad appears at the caret.
Scope: only with WIN4WINE_EXTERNAL_SHELL, for the over-the-spot style.
---
 dlls/winex11.drv/x11drv.h |  2 ++
 dlls/winex11.drv/xim.c    | 27 +++++++++++++++++++--------
 2 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index d7cfed8..2440dfe 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -665,6 +665,8 @@ struct x11drv_win_data
     struct window_rects rects;  /* window rects in monitor DPI, relative to parent client area */
     struct host_window *parent; /* the host window parent, frame or embedder, NULL if root_window */
     XIC         xic;            /* X input context */
+    XPoint      xim_spot;       /* composition spot set before the XIC existed */
+    BOOL        has_xim_spot;   /* whether xim_spot is to be given to a new XIC */
     UINT        managed : 1;    /* is window managed? */
     UINT        embedded : 1;   /* is window an XEMBED client? */
     UINT        shaped : 1;     /* is window using a custom region shape? */
diff --git a/dlls/winex11.drv/xim.c b/dlls/winex11.drv/xim.c
index 05ef786..bb227dc 100644
--- a/dlls/winex11.drv/xim.c
+++ b/dlls/winex11.drv/xim.c
@@ -36,6 +36,7 @@
 #include "x11drv.h"
 #include "imm.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(xim);
 
@@ -463,7 +464,7 @@ static BOOL xic_destroy( XIC xic, XPointer user, XPointer arg )
     return TRUE;
 }
 
-static XIC xic_create( XIM xim, HWND hwnd, Window win )
+static XIC xic_create( XIM xim, HWND hwnd, Window win, const XPoint *initial_spot )
 {
     XICCallback destroy = {.callback = xic_destroy, .client_data = (XPointer)hwnd};
     XICCallback preedit_caret = {.callback = xic_preedit_caret, .client_data = (XPointer)hwnd};
@@ -474,7 +475,7 @@ static XIC xic_create( XIM xim, HWND hwnd, Window win )
     XICCallback status_done = {.callback = xic_status_done, .client_data = (XPointer)hwnd};
     XICCallback status_draw = {.callback = xic_status_draw, .client_data = (XPointer)hwnd};
     XICCallback status_start = {.callback = xic_status_start, .client_data = (XPointer)hwnd};
-    XPoint spot = {0};
+    XPoint spot = initial_spot ? *initial_spot : (XPoint){0};
     XVaNestedList preedit, status;
     XIC xic;
     XFontSet fontSet = x11drv_thread_data()->font_set;
@@ -512,7 +513,8 @@ XIC X11DRV_get_ic( HWND hwnd )
     if (!(data = get_win_data( hwnd ))) return 0;
     x11drv_thread_data()->last_xic_hwnd = hwnd;
     if (!(ret = data->xic) && (xim = x11drv_thread_data()->xim))
-        ret = data->xic = xic_create( xim, hwnd, data->whole_window );
+        ret = data->xic = xic_create( xim, hwnd, data->whole_window,
+                                      data->has_xim_spot ? &data->xim_spot : NULL );
     release_win_data( data );
 
     return ret;
@@ -538,14 +540,23 @@ BOOL X11DRV_SetIMECompositionRect( HWND hwnd, RECT rect )
     if (!(input_style & XIMPreeditPosition))
         return FALSE;
 
-    if (!(data = get_win_data( hwnd )) || !data->xic)
-    {
-        if (data) release_win_data( data );
-        return FALSE;
-    }
+    if (!(data = get_win_data( hwnd ))) return FALSE;
 
     xpoint.x = rect.left - data->rects.visible.left;
     xpoint.y = rect.top - data->rects.visible.top;
+    if (!data->xic)
+    {
+        /* The XIC is made at the first key press or focus, often after the
+         * application placed its composition window. Keep the place for it,
+         * or the first composition shows at the window's corner. */
+        if (win4wine_external_shell())
+        {
+            data->xim_spot = xpoint;
+            data->has_xim_spot = TRUE;
+        }
+        release_win_data( data );
+        return FALSE;
+    }
     attr = XVaCreateNestedList( 0, XNSpotLocation, &xpoint, NULL );
     if (attr)
     {
