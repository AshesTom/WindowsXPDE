         for (j = ctx->update_begin; j <= ctx->update_end; j++)
@@ -1250,7 +1293,7 @@ static void update_read_output( struct console *console, BOOL newline )
             else
             {
                 write_char( screen_buffer, ctx->buf[j], &update_rect, &ctx->home_y );
-                offset++;
