+/* With an external shell and a DBCS output code page, a character that the
+ * code page encodes in two bytes takes two half-width cells, as in the
+ * Windows console: both hold it, marked COMMON_LVB_LEADING_BYTE and
+ * COMMON_LVB_TRAILING_BYTE, and one that does not fit at the end of a line
+ * goes to the next one. Wine otherwise makes every cell as wide as the widest
+ * character. Only for the console window; the Unix terminal keeps its cells. */
+BOOL wide_cells( struct console *console )
+{
+    static int enabled = -1;
+    static unsigned int last_cp;
+    static BOOL last_dbcs;
+    CPINFO info;
+
+    if (enabled < 0) enabled = win4wine_external_shell();
+    if (!enabled || !console->window || console->tty_output) return FALSE;
+    if (console->output_cp != last_cp)
+    {
+        last_cp = console->output_cp;
+        last_dbcs = GetCPInfo( last_cp, &info ) && info.MaxCharSize == 2;
+    }
+    return last_dbcs;
+}
+
+unsigned int char_cells( struct console *console, WCHAR ch )
+{
+    char bytes[2];
+
+    if (ch < 0x80 || !wide_cells( console )) return 1;
+    return WideCharToMultiByte( console->output_cp, 0, &ch, 1, bytes, sizeof(bytes), NULL, NULL ) == 2 ? 2 : 1;
+}
+
 static void write_char( struct screen_buffer *screen_buffer, WCHAR ch, RECT *update_rect, unsigned int *home_y )
 {
+    unsigned int cells = char_cells( screen_buffer->console, ch ), pos;
+
+    if (cells == 2 && screen_buffer->cursor_x == screen_buffer->width - 1)
+        write_char( screen_buffer, ' ', update_rect, home_y );
     if (screen_buffer->cursor_x == screen_buffer->width)
     {
         screen_buffer->cursor_x = 0;
@@ -451,13 +487,20 @@ static void write_char( struct screen_buffer *screen_buffer, WCHAR ch, RECT *upd
         new_line( screen_buffer, update_rect );
     }
 
-    screen_buffer->data[screen_buffer->cursor_y * screen_buffer->width + screen_buffer->cursor_x].ch = ch;
-    screen_buffer->data[screen_buffer->cursor_y * screen_buffer->width + screen_buffer->cursor_x].attr = screen_buffer->attr;
+    pos = screen_buffer->cursor_y * screen_buffer->width + screen_buffer->cursor_x;
+    screen_buffer->data[pos].ch = ch;
+    screen_buffer->data[pos].attr = screen_buffer->attr;
+    if (cells == 2)
+    {
+        screen_buffer->data[pos].attr |= COMMON_LVB_LEADING_BYTE;
+        screen_buffer->data[pos + 1].ch = ch;
+        screen_buffer->data[pos + 1].attr = screen_buffer->attr | COMMON_LVB_TRAILING_BYTE;
+    }
     update_rect->left   = min( update_rect->left,   screen_buffer->cursor_x );
     update_rect->top    = min( update_rect->top,    screen_buffer->cursor_y );
-    update_rect->right  = max( update_rect->right,  screen_buffer->cursor_x );
+    update_rect->right  = max( update_rect->right,  screen_buffer->cursor_x + cells - 1 );
     update_rect->bottom = max( update_rect->bottom, screen_buffer->cursor_y );
-    screen_buffer->cursor_x++;
+    screen_buffer->cursor_x += cells;
 }
 
