+/* With an external shell, give the class icons to the server, so that the
+ * XP taskbar in another process reads them with GetClassLongPtr as on
+ * Windows; it otherwise finds an application's file through its PEB, which
+ * a 32-bit taskbar cannot read in a 64-bit process. CLASS is the window's
+ * local class, or NULL to look it up. Called without the user lock. */
+void share_class_icons( HWND hwnd, CLASS *class )
+{
+    HICON icon, small_icon;
+    ULONG_PTR old;
+
+    if (!win4wine_external_shell()) return;
+    if (class) user_lock();
+    else if (!(class = get_class_ptr( hwnd, FALSE )) || class == OBJ_OTHER_PROCESS) return;
+    icon = class->hIcon;
+    small_icon = class->hIconSm ? class->hIconSm : class->hIconSmIntern;
+    if (icon == class->shared_icon && small_icon == class->shared_icon_sm)
+    {
+        release_class_ptr( class );
+        return;
+    }
+    class->shared_icon = icon;
+    class->shared_icon_sm = small_icon;
+    release_class_ptr( class );
+    set_server_info( hwnd, GCLP_HICON, HandleToUlong( icon ), sizeof(LONG_PTR), &old );
+    set_server_info( hwnd, GCLP_HICONSM, HandleToUlong( small_icon ), sizeof(LONG_PTR), &old );
+}
