     if (!obj->is_ani) return obj;
     if (step >= obj->ani.num_steps)
     {
@@ -342,6 +631,7 @@ BOOL WINAPI NtUserSetCursorIconData( HCURSOR cursor, UNICODE_STRING *module, UNI
         }
     }
 
+    publish_icon( obj );
     release_user_handle_ptr( obj );
     return TRUE;
 }
