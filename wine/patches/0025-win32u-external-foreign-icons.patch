+    }
     else
         set_error( STATUS_INVALID_HANDLE );
 }
+
+/* No window message, process memory pointer, or GDI handle crosses the server.
+ * Dimensions and all inferred bitmap sizes are checked before allocation. */
+static BOOL valid_icon_data( const struct shared_icon_data *data, data_size_t size )
+{
+    size_t expected;
+    if (size < sizeof(*data) || !data->width || !data->height ||
+        data->width > SHARED_ICON_MAX_DIM || data->height > SHARED_ICON_MAX_DIM ||
+        (data->flags & ~(SHARED_ICON_COLOR | SHARED_ICON_ALPHA | SHARED_ICON_RESOURCE)) ||
+        ((data->flags & SHARED_ICON_ALPHA) && !(data->flags & SHARED_ICON_COLOR)) ||
+        data->module_bytes > SHARED_ICON_MAX_STRING || data->name_bytes > SHARED_ICON_MAX_STRING ||
+        ((data->module_bytes | data->name_bytes) & 1) || data->name_id > 0xffff ||
+        (data->name_id && data->name_bytes)) return FALSE;
+    expected = sizeof(*data) + ((data->width + 31) / 32 * 4) * data->height *
+               (data->flags & SHARED_ICON_COLOR ? 1 : 2);
+    if (data->flags & SHARED_ICON_COLOR) expected += data->width * data->height * 4;
+    if (data->flags & SHARED_ICON_ALPHA) expected += data->width * data->height * 4;
+    expected += data->module_bytes + data->name_bytes;
+    return expected == size && expected <= SHARED_ICON_MAX_BYTES;
+}
+
+DECL_HANDLER(set_shared_icon)
+{
+    const user_entry_t *handles = shared_session->user_entries;
+    user_entry_t *entry = handle_to_entry( req->handle );
+    const struct shared_icon_data *data = get_req_data();
+    data_size_t size = get_req_data_size();
+    unsigned int i, pid = get_process_id( current->process );
+    struct shared_icon *icon;
+    size_t owner_bytes = 0;
+
+    if (!entry || entry->type != NTUSER_OBJ_ICON)
+    { set_error( STATUS_INVALID_HANDLE ); return; }
+    if (entry->pid != pid)
+    { set_error( STATUS_ACCESS_DENIED ); return; }
+    icon = shared_icons + (entry - handles);
+    if (icon->data || !valid_icon_data( data, size ))
+    { set_error( STATUS_INVALID_PARAMETER ); return; }
+    for (i = 0; i < nb_handles; ++i)
+        if (handles[i].type == NTUSER_OBJ_ICON && handles[i].pid == pid)
+            owner_bytes += shared_icons[i].size;
+    if (owner_bytes + size > 16 * 1024 * 1024 || icon_bytes + size > 64 * 1024 * 1024)
+    { set_error( STATUS_NO_MEMORY ); return; }
+    if (!(icon->data = memdup( data, size ))) return;
+    icon->size = size;
+    icon_bytes += size;
+}
+
+DECL_HANDLER(get_shared_icon)
+{
+    const user_entry_t *handles = shared_session->user_entries;
+    user_entry_t *entry = handle_to_entry( req->handle );
+    const struct shared_icon *icon;
+
+    if (!entry || entry->type != NTUSER_OBJ_ICON || !(icon = shared_icons + (entry - handles))->data)
+    { set_error( STATUS_INVALID_HANDLE ); return; }
+    reply->handle = entry_to_handle( entry );
+    reply->size = icon->size;
+    if (get_reply_max_size())
+    {
+        if (get_reply_max_size() < icon->size) set_error( STATUS_BUFFER_TOO_SMALL );
+        else set_reply_data( icon->data, icon->size );
+    }
+}
