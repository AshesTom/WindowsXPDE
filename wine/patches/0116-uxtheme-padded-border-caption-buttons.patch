From: Codex <codex@localhost>
Subject: [PATCH] win32u, uxtheme: padded border and Aero caption button sizes

Purpose: give windows of the Windows 7 shell session Windows 7's frame
thickness and caption button sizes.
Windows behavior (measured on Windows 7 SP1 with a probe, through
public APIs): SM_CXFRAME is SM_CXDLGFRAME + BorderWidth +
PaddedBorderWidth (8 with Aero's 1 and 4).  SPI_SETNONCLIENTMETRICS
with the full structure stores iPaddedBorderWidth; with the older size
it keeps the current padded border and stores iBorderWidth minus it.
A version 4 visual style's caption width follows its close button's
aspect ratio: MulDiv(caption height, close cx, close cy), 35 with
Aero; the caption buttons are (SM_CXSIZE - 4) x (SM_CYSIZE - 4).
Wine before: no padded border; the caption width was the height, so
the frame was 4 pixels and the buttons square.
Change: win32u adds the padded border to SM_CXFRAME/SM_CYFRAME and
stores it from the full structure; uxtheme reads PaddedBorderWidth
from the style's SysMetrics, sets caption widths from the close
buttons' sizes, keeps the padded border when it saves the metrics, and
draws version 4 caption buttons SM_CXSIZE - 4 wide.
Evidence: Notepad's frame and caption buttons are pixel-identical to
Windows 7's at the same position and size.
Scope: SM_CXFRAME changes only when PaddedBorderWidth is set (the
Windows 7 style); XP and ReactOS styles have none.
---
 dlls/uxtheme/font-profile.c |  7 +++--
 dlls/uxtheme/msstyles.c     | 67 +++++++++++++++++++++++++++++++++++++++++----
 dlls/uxtheme/system.c       | 20 ++++++++++++--
 dlls/uxtheme/uxthemedll.h   |  3 ++
 dlls/uxtheme/window.c       |  8 +++++-
 dlls/win32u/sysparams.c     | 34 +++++++++++++++--------
 6 files changed, 116 insertions(+), 23 deletions(-)

diff --git a/dlls/uxtheme/font-profile.c b/dlls/uxtheme/font-profile.c
index 7a20762..8b0d896 100644
--- a/dlls/uxtheme/font-profile.c
+++ b/dlls/uxtheme/font-profile.c
@@ -155,15 +155,16 @@ void UXTHEME_ApplyExternalFonts(PTHEME_FILE file)
     BOOL dirty = FALSE;
     if (!(key = open_profile(file))) return;
     previous = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_UNAWARE);
-    metrics.cbSize = sizeof(metrics);
-    if (SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0))
+    /* The structure without iPaddedBorderWidth keeps the padded border on SET */
+    metrics.cbSize = FIELD_OFFSET(NONCLIENTMETRICSW, iPaddedBorderWidth);
+    if (SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, metrics.cbSize, &metrics, 0))
     {
         dirty |= read_font(key, L"CaptionFont", 96, &metrics.lfCaptionFont);
         dirty |= read_font(key, L"SmallCaptionFont", 96, &metrics.lfSmCaptionFont);
         dirty |= read_font(key, L"MenuFont", 96, &metrics.lfMenuFont);
         dirty |= read_font(key, L"StatusFont", 96, &metrics.lfStatusFont);
         dirty |= read_font(key, L"MessageFont", 96, &metrics.lfMessageFont);
-        if (dirty) SystemParametersInfoW(SPI_SETNONCLIENTMETRICS, sizeof(metrics), &metrics, 0);
+        if (dirty) SystemParametersInfoW(SPI_SETNONCLIENTMETRICS, metrics.cbSize, &metrics, 0);
     }
     if (read_font(key, L"IconFont", 96, &icon))
         SystemParametersInfoW(SPI_SETICONTITLELOGFONT, sizeof(icon), &icon, 0);
diff --git a/dlls/uxtheme/msstyles.c b/dlls/uxtheme/msstyles.c
index 078cf64..99caa0c 100644
--- a/dlls/uxtheme/msstyles.c
+++ b/dlls/uxtheme/msstyles.c
@@ -252,6 +252,20 @@ void MSSTYLES_CloseThemeFile(PTHEME_FILE tf)
     }
 }
 
+/* The padded border that the active visual style set, or -1 */
+static int applied_padded_border = -1;
+
+int MSSTYLES_AppliedPaddedBorder(void)
+{
+    return applied_padded_border;
+}
+
+/* Whether the active visual style is Vista's and Windows 7's (format 4) */
+BOOL MSSTYLES_ActiveThemeFormat4(void)
+{
+    return tfActiveTheme && tfActiveTheme->version == MSSTYLES_VERSION_V4;
+}
+
 /***********************************************************************
  *      MSSTYLES_SetActiveTheme
  *
@@ -813,6 +827,7 @@ struct PARSENONCLIENTSTATE
     NONCLIENTMETRICSW metrics;
     BOOL metricsDirty;
     LOGFONTW iconTitleFont;
+    SIZE captionButton, smallCaptionButton;   /* format 4: the close buttons' image sizes */
 };
 
 static inline void parse_init_nonclient (struct PARSENONCLIENTSTATE* state)
@@ -928,6 +943,10 @@ static BOOL parse_handle_nonclient_size (struct PARSENONCLIENTSTATE* state,
                 state->metrics.iMenuHeight = size;
                 state->metricsDirty = TRUE;
                 break;
+            case TMT_PADDEDBORDERWIDTH:
+                state->metrics.iPaddedBorderWidth = size;
+                state->metricsDirty = TRUE;
+                break;
         }
         return TRUE;
     }
@@ -935,6 +954,27 @@ static BOOL parse_handle_nonclient_size (struct PARSENONCLIENTSTATE* state,
         return FALSE;
 }
 
+/* Windows 7 sizes the caption buttons by its visual style: a button is as
+ * high as the caption and as wide as the close button's image is for that
+ * height (Aero's 28x17 gives 35 for the 21 pixel caption, its small close
+ * button 13x13 a square), whatever width the metrics give (measured with
+ * SPI_SETNONCLIENTMETRICS and GetSystemMetrics on Windows 7 SP1). */
+static void caption_button_widths(struct PARSENONCLIENTSTATE *state)
+{
+    PTHEME_CLASS window;
+    SIZE size;
+
+    if (!(window = MSSTYLES_OpenThemeClass(NULL, L"Window", 96))) return;
+    if (SUCCEEDED(GetThemePartSize((HTHEME)window, NULL, WP_CLOSEBUTTON, CBS_NORMAL, NULL, TS_TRUE, &size)) &&
+        size.cy > 0)
+        state->captionButton = size;
+    if (SUCCEEDED(GetThemePartSize((HTHEME)window, NULL, WP_SMALLCLOSEBUTTON, CBS_NORMAL, NULL, TS_TRUE, &size)) &&
+        size.cy > 0)
+        state->smallCaptionButton = size;
+    if (state->captionButton.cy || state->smallCaptionButton.cy) state->metricsDirty = TRUE;
+    MSSTYLES_CloseThemeClass(window);
+}
+
 static void parse_apply_nonclient (struct PARSENONCLIENTSTATE* state)
 {
     DPI_AWARENESS_CONTEXT old_context;
@@ -944,6 +984,20 @@ static void parse_apply_nonclient (struct PARSENONCLIENTSTATE* state)
         old_context = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_UNAWARE);
         SystemParametersInfoW (SPI_SETNONCLIENTMETRICS, sizeof (state->metrics),
             &state->metrics, 0);
+        applied_padded_border = state->metrics.iPaddedBorderWidth;
+        if (state->captionButton.cy || state->smallCaptionButton.cy)
+        {
+            /* the caption heights as the fonts raised them (Meiryo's small caption is 20, not 17) */
+            NONCLIENTMETRICSW metrics = {sizeof(metrics)};
+            SystemParametersInfoW (SPI_GETNONCLIENTMETRICS, sizeof (metrics), &metrics, 0);
+            if (state->captionButton.cy)
+                state->metrics.iCaptionWidth = MulDiv (metrics.iCaptionHeight, state->captionButton.cx,
+                                                       state->captionButton.cy);
+            if (state->smallCaptionButton.cy)
+                state->metrics.iSmCaptionWidth = MulDiv (metrics.iSmCaptionHeight, state->smallCaptionButton.cx,
+                                                         state->smallCaptionButton.cy);
+            SystemParametersInfoW (SPI_SETNONCLIENTMETRICS, sizeof (state->metrics), &state->metrics, 0);
+        }
         SystemParametersInfoW (SPI_SETICONTITLELOGFONT, sizeof (state->iconTitleFont),
             &state->iconTitleFont, 0);
         SetThreadDpiAwarenessContext(old_context);
@@ -2159,7 +2213,7 @@ static void MSSTYLES_ParseThemeV4(PTHEME_FILE tf, BOOL setMetrics)
                 SystemParametersInfoW(SPI_SETFLATMENU, 0, (PVOID)(INT_PTR)(*value == 'T'), 0);
             else if (rec->id >= TMT_FIRSTFONT && rec->id <= TMT_LASTFONT)
                 parse_handle_nonclient_font(&nonClientState, rec->id, value, lstrlenW(value));
-            else if (rec->id >= TMT_FIRSTSIZE && rec->id <= TMT_LASTSIZE)
+            else if ((rec->id >= TMT_FIRSTSIZE && rec->id <= TMT_LASTSIZE) || rec->id == TMT_PADDEDBORDERWIDTH)
                 parse_handle_nonclient_size(&nonClientState, rec->id, value, lstrlenW(value));
             MSSTYLES_AddMetric(tf, rec->type, rec->id, value, lstrlenW(value));
             continue;
@@ -2172,11 +2226,7 @@ static void MSSTYLES_ParseThemeV4(PTHEME_FILE tf, BOOL setMetrics)
         ps = MSSTYLES_AddPartState(cls, rec->part, rec->state);
         MSSTYLES_AddProperty(ps, rec->type, rec->id, value, lstrlenW(value), !lstrcmpiW(name, L"globals"));
     }
-    if (setMetrics)
-    {
-        parse_apply_color(&colorState);
-        parse_apply_nonclient(&nonClientState);
-    }
+    if (setMetrics) parse_apply_color(&colorState);
 
     /* An application's class takes what it lacks from the class of the same
      * name, and every class from globals. */
@@ -2212,6 +2262,11 @@ static void MSSTYLES_ParseThemeV4(PTHEME_FILE tf, BOOL setMetrics)
     }
     free(names);
     if (!tf->classes) ERR("Failed to parse format 4 theme\n");
+    if (setMetrics)
+    {
+        caption_button_widths(&nonClientState);
+        parse_apply_nonclient(&nonClientState);
+    }
 }
 
 extern HRESULT WINAPI WICCreateImagingFactory_Proxy(UINT version, IWICImagingFactory **factory);
diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
index 92779f2..2fafbe4 100644
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -505,8 +505,24 @@ static void UXTHEME_SaveSystemMetrics(struct system_metrics *metrics, BOOL send_
 
     old_context = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_UNAWARE);
 
-    SystemParametersInfoW(SPI_SETNONCLIENTMETRICS, sizeof(metrics->non_client_metrics),
-                          &metrics->non_client_metrics, SPIF_UPDATEINIFILE);
+    if (bThemeActive && MSSTYLES_AppliedPaddedBorder() >= 0)
+    {
+        /* SPI_GETNONCLIENTMETRICS counts the padded border in the border; the
+         * whole structure stores them apart (the style's 1 and 4 on Windows 7) */
+        NONCLIENTMETRICSW nm = metrics->non_client_metrics;
+        nm.iPaddedBorderWidth = MSSTYLES_AppliedPaddedBorder();
+        nm.iBorderWidth -= nm.iPaddedBorderWidth;
+        SystemParametersInfoW(SPI_SETNONCLIENTMETRICS, sizeof(nm), &nm, SPIF_UPDATEINIFILE);
+    }
+    else
+    {
+        /* Without iPaddedBorderWidth: the saved border includes the padded
+         * border, which stays as it is (as on Windows 7). */
+        metrics->non_client_metrics.cbSize = FIELD_OFFSET(NONCLIENTMETRICSW, iPaddedBorderWidth);
+        SystemParametersInfoW(SPI_SETNONCLIENTMETRICS, metrics->non_client_metrics.cbSize,
+                              &metrics->non_client_metrics, SPIF_UPDATEINIFILE);
+        metrics->non_client_metrics.cbSize = sizeof(metrics->non_client_metrics);
+    }
     SystemParametersInfoW(SPI_SETICONTITLELOGFONT, sizeof(metrics->icon_title_font),
                           &metrics->icon_title_font, SPIF_UPDATEINIFILE);
     SystemParametersInfoW(SPI_SETGRADIENTCAPTIONS, 0, (void *)(INT_PTR)metrics->gradient_caption,
diff --git a/dlls/uxtheme/uxthemedll.h b/dlls/uxtheme/uxthemedll.h
index 7b13893..e10a34a 100644
--- a/dlls/uxtheme/uxthemedll.h
+++ b/dlls/uxtheme/uxthemedll.h
@@ -126,4 +126,7 @@ LRESULT WINAPI UXTHEME_ScrollbarWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPAR
 /* Full alpha blending */
 #define ALPHABLEND_FULL             2
 
+BOOL MSSTYLES_ActiveThemeFormat4(void);
+int MSSTYLES_AppliedPaddedBorder(void);
+
 #endif /* __WINE_UXTHEMEDLL_H */
diff --git a/dlls/uxtheme/window.c b/dlls/uxtheme/window.c
index e7fea6b..914cb80 100644
--- a/dlls/uxtheme/window.c
+++ b/dlls/uxtheme/window.c
@@ -356,9 +356,15 @@ static void themed_caption_geometry(HWND hwnd, HTHEME theme, RECT *caption, RECT
     if (SUCCEEDED(GetThemePartSize(theme, NULL, WP_CAPTION, CS_ACTIVE, NULL, TS_TRUE, &image)))
         caption->bottom = min(caption->bottom, MulDiv(image.cy, dpi, 96));
     /* The buttons are square, 4px less than SM_CYSIZE: the assets' 21x21 at
-     * 96 DPI, 27x27 at 120 DPI (measured on XP). */
+     * 96 DPI, 27x27 at 120 DPI (measured on XP). Windows 7's are 4px less
+     * than SM_CXSIZE by SM_CYSIZE, which its visual style makes as wide as
+     * the close button's image (31x17 for its 35x21; TITLEBARINFOEX and the
+     * pixels on Windows 7 SP1). */
     if (SUCCEEDED(GetThemePartSize(theme, NULL, WP_CLOSEBUTTON, CBS_NORMAL, NULL, TS_TRUE, &image)))
+    {
         width = height = GetSystemMetrics(SM_CYSIZE) - 4;
+        if (MSSTYLES_ActiveThemeFormat4()) width = GetSystemMetrics(SM_CXSIZE) - 4;
+    }
     buttons[0].right = window.right - border_x - 2;
     buttons[0].left = buttons[0].right - width;
     buttons[0].bottom = caption->bottom - padding;
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 182cfb3..dc54436 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -6246,7 +6246,16 @@ BOOL WINAPI NtUserSystemParametersInfo( UINT action, UINT val, void *ptr, UINT w
         {
             get_entry( &entry_PADDEDBORDERWIDTH, 0, &padded_border );
 
-            ret = set_entry( &entry_BORDER, nm->iBorderWidth - padded_border, NULL, winini ) &&
+            /* The full structure stores both widths as given (Windows 7: a
+             * border of 1 and a padded border of 4 give SM_CXFRAME 8); the
+             * older one keeps the padded border and takes it from the border. */
+            if (nm->cbSize == sizeof(NONCLIENTMETRICSW))
+            {
+                ret = set_entry( &entry_PADDEDBORDERWIDTH, nm->iPaddedBorderWidth, NULL, winini );
+                padded_border = 0;
+            }
+            else ret = TRUE;
+            ret = ret && set_entry( &entry_BORDER, nm->iBorderWidth - padded_border, NULL, winini ) &&
                   set_entry( &entry_SCROLLWIDTH, nm->iScrollWidth, NULL, winini ) &&
                   set_entry( &entry_SCROLLHEIGHT, nm->iScrollHeight, NULL, winini ) &&
                   set_entry( &entry_CAPTIONWIDTH, nm->iCaptionWidth, NULL, winini ) &&
@@ -7023,13 +7032,15 @@ int get_system_metrics( int index )
         NtUserSystemParametersInfo( SPI_GETNONCLIENTMETRICS, 0, &ncm, 0 );
         return ncm.iCaptionHeight;
     case SM_CXFRAME:
-        get_entry( &entry_BORDER, 0, &ret );
-        ret = max( ret, 1 );
-        return get_system_metrics( SM_CXDLGFRAME ) + ret;
     case SM_CYFRAME:
+    {
+        int padded = 0;
+        /* the padded border is part of the sizing frame (Windows Vista and later) */
         get_entry( &entry_BORDER, 0, &ret );
-        ret = max( ret, 1 );
-        return get_system_metrics( SM_CYDLGFRAME ) + ret;
+        get_entry( &entry_PADDEDBORDERWIDTH, 0, &padded );
+        ret = max( ret, 1 ) + max( padded, 0 );
+        return get_system_metrics( index == SM_CXFRAME ? SM_CXDLGFRAME : SM_CYDLGFRAME ) + ret;
+    }
     case SM_CXMINTRACK:
         return get_system_metrics( SM_CXMIN );
     case SM_CYMINTRACK:
@@ -7232,13 +7243,14 @@ static int get_system_metrics_for_dpi( int index, unsigned int dpi )
         NtUserSystemParametersInfoForDpi( SPI_GETNONCLIENTMETRICS, 0, &ncm, 0, dpi );
         return ncm.iCaptionHeight;
     case SM_CXFRAME:
-        get_entry_dpi( &entry_BORDER, 0, &ret, dpi );
-        ret = max( ret, 1 );
-        return get_system_metrics_for_dpi( SM_CXDLGFRAME, dpi ) + ret;
     case SM_CYFRAME:
+    {
+        int padded = 0;
         get_entry_dpi( &entry_BORDER, 0, &ret, dpi );
-        ret = max( ret, 1 );
-        return get_system_metrics_for_dpi( SM_CYDLGFRAME, dpi ) + ret;
+        get_entry_dpi( &entry_PADDEDBORDERWIDTH, 0, &padded, dpi );
+        ret = max( ret, 1 ) + max( padded, 0 );
+        return get_system_metrics_for_dpi( index == SM_CXFRAME ? SM_CXDLGFRAME : SM_CYDLGFRAME, dpi ) + ret;
+    }
     case SM_CXICONSPACING:
         im.cbSize = sizeof(im);
         NtUserSystemParametersInfoForDpi( SPI_GETICONMETRICS, sizeof(im), &im, 0, dpi );
