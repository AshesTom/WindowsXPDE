+            infoPtr->pulse_start = 0;
+        }
+        InvalidateRect(hWnd, NULL, FALSE);
+        return 0;
+
     case WM_NCDESTROY:
         SetWindowLongPtrW( hWnd, 0, 0 );
         if (infoPtr->image_type == IMAGE_BITMAP)
@@ -611,6 +626,12 @@ static LRESULT CALLBACK BUTTON_WindowProc(HWND hWnd, UINT uMsg, WPARAM wParam, L
             int drawState = get_draw_state(infoPtr);
             UINT dtflags = BUTTON_BStoDT(style, GetWindowLongW(hWnd, GWL_EXSTYLE));
 
+            if (!infoPtr->pulse_start && (btn_type == BS_PUSHBUTTON || btn_type == BS_DEFPUSHBUTTON) &&
+                win7_pulse(infoPtr, drawState))
+            {
+                infoPtr->pulse_start = GetTickCount() | 1;
+                SetTimer(hWnd, PULSE_TIMER, 30, NULL);
+            }
             btnThemedPaintFunc[btn_type](theme, infoPtr, hdc, drawState, dtflags, infoPtr->state & BST_FOCUS);
         }
         else if (btnPaintFunc[btn_type])
@@ -2851,6 +2872,23 @@ cleanup:
 /**********************************************************************
  *       Themed Paint Functions
  */
+/* Windows 7's default button pulses while its window is active: measured on
+ * SP1, its defaulted look fades linearly into the animating one and back in
+ * PULSE_PERIOD milliseconds. */
+static BOOL win7_pulse(const BUTTON_INFO *infoPtr, int state)
+{
+    return state == PBS_DEFAULTED && COMCTL32_IsWin7Shell() && IsWindowEnabled(infoPtr->hwnd) &&
+           GetActiveWindow() == GetAncestor(infoPtr->hwnd, GA_ROOT);
+}
+
+static BYTE pulse_alpha(const BUTTON_INFO *infoPtr)
+{
+    DWORD phase = (GetTickCount() - infoPtr->pulse_start) % PULSE_PERIOD;
+
+    if (phase >= PULSE_PERIOD / 2) phase = PULSE_PERIOD - phase;
+    return phase * 255 / (PULSE_PERIOD / 2);
+}
+
 static void PB_ThemedPaint(HTHEME theme, const BUTTON_INFO *infoPtr, HDC hDC, int state, UINT dtFlags, BOOL focused)
 {
     RECT bgRect, labelRect, imageRect, textRect, focusRect;
@@ -2886,7 +2924,25 @@ static void PB_ThemedPaint(HTHEME theme, const BUTTON_INFO *infoPtr, HDC hDC, in
             FillRect(hDC, &bgRect, brush ? brush : GetSysColorBrush(COLOR_BTNFACE));
         }
     }
-    DrawThemeBackground(theme, hDC, BP_PUSHBUTTON, state, &bgRect, NULL);
+    if (infoPtr->pulse_start && win7_pulse(infoPtr, state) && pulse_alpha(infoPtr))
+    {
+        /* the animating look over the background, blended over the defaulted one */
+        int width = bgRect.right - bgRect.left, height = bgRect.bottom - bgRect.top;
+        BLENDFUNCTION blend = { AC_SRC_OVER, 0, pulse_alpha(infoPtr), 0 };
+        HDC mem = CreateCompatibleDC(hDC);
+        HBITMAP bitmap = CreateCompatibleBitmap(hDC, width, height), old = SelectObject(mem, bitmap);
+        RECT rect = { 0, 0, width, height };
+
+        BitBlt(mem, 0, 0, width, height, hDC, bgRect.left, bgRect.top, SRCCOPY);
+        DrawThemeBackground(theme, mem, BP_PUSHBUTTON, PBS_DEFAULTED_ANIMATING, &rect, NULL);
+        DrawThemeBackground(theme, hDC, BP_PUSHBUTTON, state, &bgRect, NULL);
+        GdiAlphaBlend(hDC, bgRect.left, bgRect.top, width, height, mem, 0, 0, width, height, blend);
+        SelectObject(mem, old);
+        DeleteObject(bitmap);
+        DeleteDC(mem);
+    }
+    else
+        DrawThemeBackground(theme, hDC, BP_PUSHBUTTON, state, &bgRect, NULL);
 
     if (cdrf & CDRF_NOTIFYPOSTERASE)
     {
diff --git a/dlls/user32/msgbox.c b/dlls/user32/msgbox.c
index 009f385..5e0a2de 100644
--- a/dlls/user32/msgbox.c
+++ b/dlls/user32/msgbox.c
@@ -28,6 +28,7 @@
 #include "winternl.h"
 #include "dlgs.h"
 #include "user_private.h"
+#include "wine/win4wine.h"
 #include "resources.h"
 #include "wine/debug.h"
 
@@ -58,6 +59,139 @@ static BOOL CALLBACK MSGBOX_EnumProc(HWND hwnd, LPARAM lParam)
    return TRUE;
 }
 
+/* Index the order the buttons need to appear to an ID* constant */
+static const int buttonOrder[10] = { IDYES, IDNO, IDOK, IDABORT, IDRETRY,
+                                     IDCANCEL, IDIGNORE, IDTRYAGAIN,
+                                     IDCONTINUE, IDHELP };
+
+/* The shell sessions' layouts (win4wine): the shown buttons in their order;
+ * WIDTH grows to the widest caption and PADDING. */
+static unsigned int MSGBOX_GetButtons( HWND hwnd, HDC hdc, HWND buttons[10], int padding, int *width )
+{
+    unsigned int i, count = 0;
+    WCHAR caption[256];
+    RECT rc;
+
+    for (i = 0; i < ARRAY_SIZE(buttonOrder); i++)
+    {
+        HWND item = GetDlgItem( hwnd, buttonOrder[i] );
+
+        if (!(GetWindowLongW( item, GWL_STYLE ) & WS_VISIBLE)) continue;
+        buttons[count++] = item;
+        if (!GetWindowTextW( item, caption, ARRAY_SIZE(caption) )) continue;
+        SetRectEmpty( &rc );
+        DrawTextW( hdc, caption, -1, &rc, DT_SINGLELINE | DT_CALCRECT );
+        *width = max( *width, rc.right + padding );
+    }
+    return count;
+}
+
+/* the monitor of the box's owner */
+static void MSGBOX_GetMonitorInfo( const MSGBOXPARAMSW *lpmb, MONITORINFO *info )
+{
+    HMONITOR monitor = MonitorFromWindow( lpmb->hwndOwner ? lpmb->hwndOwner : GetActiveWindow(),
+                                          MONITOR_DEFAULTTOPRIMARY );
+
+    info->cbSize = sizeof(*info);
+    GetMonitorInfoW( monitor, info );
+}
+
+/* the box, WIDTH by HEIGHT in client pixels, in the middle of the work area */
+static void MSGBOX_Center( HWND hwnd, const RECT *work, int width, int height )
+{
+    RECT rc = { 0, 0, width, height };
+
+    AdjustWindowRectEx( &rc, GetWindowLongW( hwnd, GWL_STYLE ), FALSE, GetWindowLongW( hwnd, GWL_EXSTYLE ));
+    NtUserSetWindowPos( hwnd, 0, (work->left + work->right - (rc.right - rc.left)) / 2,
+                        (work->top + work->bottom - (rc.bottom - rc.top)) / 2,
+                        rc.right - rc.left, rc.bottom - rc.top, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOREDRAW );
+}
+
+static void MSGBOX_Move( HWND item, int x, int y, int cx, int cy )
+{
+    NtUserSetWindowPos( item, 0, x, y, cx, cy, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOREDRAW );
+}
+
+/* the INDEX-th button, the default one focused */
+static void MSGBOX_PlaceButton( const MSGBOXPARAMSW *lpmb, HWND item, unsigned int index, int x, int y, int cx, int cy )
+{
+    if (index == ((lpmb->dwStyle & MB_DEFMASK) >> 8))
+    {
+        NtUserSetFocus( item );
+        SendMessageW( item, BM_SETSTYLE, BS_DEFPUSHBUTTON, TRUE );
+    }
+    MSGBOX_Move( item, x, y, cx, cy );
+}
+
+#define WIN7_BAND_PROP L"Win4WineMessageBoxBand"
+
+/* Windows 7's message boxes, for the Windows 7 shell session (measured on
+ * SP1 with tests/msgbox-layout.c): the icon at 25,32; the text 8 pixels
+ * after it (12 from the edge without one), two pixels taller than its lines,
+ * centered on the icon when shorter, wrapped at about 3/8 of the screen; the
+ * box 37 pixels wider than the text, its width rounded to dialog units;
+ * 88x32 buttons right-aligned, the last 55 units from the right, the others
+ * 8, 10 and 9 pixels apart, 43 pixels below the text (44 below the icon) and
+ * 13 above the bottom, on a band of the face color from 12 pixels above
+ * them, the rest white. */
+static void MSGBOX_Win7Layout( HWND hwnd, const MSGBOXPARAMSW *lpmb, const WCHAR *text )
+{
+    static const int gaps[] = { 8, 10, 9 };
+    HWND label = GetDlgItem( hwnd, MSGBOX_IDTEXT ), buttons[10];
+    BOOL has_icon = (lpmb->dwStyle & MB_ICONMASK) != 0;
+    int bw = 88, bh, text_left, wrap, tw, th, text_top, bottom, top, span, units, width, height, last_left, x;
+    unsigned int i, count;
+    LONG cx, cy;
+    MONITORINFO info;
+    HFONT old_font;
+    RECT rc;
+    HDC hdc;
+
+    hdc = NtUserGetDC( hwnd );
+    old_font = SelectObject( hdc, (HFONT)SendMessageW( hwnd, WM_GETFONT, 0, 0 ));
+    cx = GdiGetCharDimensions( hdc, NULL, &cy );
+    if (!cx) cx = 7;
+
+    bh = (14 * cy + 4) / 8;
+    count = MSGBOX_GetButtons( hwnd, hdc, buttons, 24, &bw );
+    MSGBOX_GetMonitorInfo( lpmb, &info );
+
+    text_left = has_icon ? 65 : 12;
+    wrap = (info.rcMonitor.right - info.rcMonitor.left) * 3 / 8 - 35 - text_left;
+    SetRect( &rc, 0, 0, wrap, 0 );
+    DrawTextW( hdc, text, -1, &rc, DT_LEFT | DT_EXPANDTABS | DT_WORDBREAK | DT_EDITCONTROL | DT_CALCRECT | DT_NOPREFIX );
+    tw = rc.right;
+    th = rc.bottom + 2;
+    SelectObject( hdc, old_font );
+    NtUserReleaseDC( hwnd, hdc );
+
+    text_top = 32;
+    if (has_icon && th < 32) text_top += (32 - th) / 2;
+    bottom = text_top + th;
+    if (has_icon) bottom = max( bottom, 32 + 32 + 1 );
+    top = bottom + 43;
+    height = top + bh + 13;
+
+    /* the width in dialog units: the text's, or the buttons' */
+    for (i = 1, span = 0; i < count; i++) span += bw + gaps[min( i - 1, ARRAY_SIZE(gaps) - 1 )];
+    units = ((text_left + tw + 37) * 4 + cx / 2) / cx;
+    while (((units - 55) * cx + 2) / 4 - span < 42) units++;
+    width = (units * cx + 2) / 4;
+    last_left = ((units - 55) * cx + 2) / 4;
+
+    MSGBOX_Center( hwnd, &info.rcWork, width, height );
+    MSGBOX_Move( GetDlgItem( hwnd, MSGBOX_IDICON ), 25, 32, 32, 32 );
+    SetWindowLongW( label, GWL_STYLE, GetWindowLongW( label, GWL_STYLE ) | SS_EDITCONTROL );
+    /* the text's control reaches 37 pixels before the right edge */
+    MSGBOX_Move( label, text_left, text_top, max( tw, width - 37 - text_left ), th );
+    for (i = 0, x = last_left - span; i < count; i++)
+    {
+        MSGBOX_PlaceButton( lpmb, buttons[i], i, x, top, bw, bh );
+        x += bw + gaps[min( i, ARRAY_SIZE(gaps) - 1 )];
+    }
+    SetPropW( hwnd, WIN7_BAND_PROP, ULongToHandle( top - 12 ));
+}
+
