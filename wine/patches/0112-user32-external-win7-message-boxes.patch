@@ -213,6 +342,13 @@ static void MSGBOX_OnInit(HWND hwnd, LPMSGBOXPARAMSW lpmb)
         NtUserDestroyWindow(GetDlgItem(hwnd, IDHELP));
     }
 
+    if (win4wine_shell() == WIN4WINE_SHELL_WIN7)
