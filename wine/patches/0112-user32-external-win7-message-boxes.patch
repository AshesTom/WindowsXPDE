     /* Position everything */
     GetWindowRect(hwnd, &rect);
     borheight = rect.bottom - rect.top;
@@ -339,6 +475,28 @@ static INT_PTR CALLBACK MSGBOX_DlgProc( HWND hwnd, UINT message,
        break;
    }
 
+   case WM_ERASEBKGND:
+   {
+       /* Windows 7: white, the buttons on a band of the face color */
+       UINT band = HandleToUlong( GetPropW( hwnd, WIN7_BAND_PROP ));
+       RECT rect;
+
+       if (!band) break;
+       GetClientRect( hwnd, &rect );
+       rect.bottom = band;
+       FillRect( (HDC)wParam, &rect, GetSysColorBrush( COLOR_WINDOW ));
+       GetClientRect( hwnd, &rect );
+       rect.top = band;
+       FillRect( (HDC)wParam, &rect, GetSysColorBrush( COLOR_3DFACE ));
+       SetWindowLongPtrW( hwnd, DWLP_MSGRESULT, TRUE );
+       return TRUE;
+   }
+
+   case WM_CTLCOLORSTATIC:
+       if (!GetPropW( hwnd, WIN7_BAND_PROP )) break;
+       SetBkColor( (HDC)wParam, GetSysColor( COLOR_WINDOW ));
+       return (INT_PTR)GetSysColorBrush( COLOR_WINDOW );
+
    case WM_COMMAND:
     switch (LOWORD(wParam))
     {
