From: Codex <codex@localhost>
Subject: [PATCH] shell32: send notification icons to the external XP taskbar in its format

Purpose: show Wine applications' notification icons, and the bridge's
icons for Linux tray items, in the XP shell's notification area.
XP behavior: Shell_NotifyIconW sends Shell_TrayWnd a WM_COPYDATA with
dwData 1 and 960 bytes: the signature 0x34753423, the message, and a
NOTIFYICONDATAW of the XP size (952) with 32-bit handles. All fields are
copied for the version 2 and 3 sizes whatever the flags, and only the
first version's fields for other sizes, including the later 956-byte one.
wParam is the caller's window. Measured by a decoy taskbar window on XP.
Wine before: Wine's own layout, with the icon's bitmaps instead of the
handle, which the XP taskbar rejects, so every icon was refused.
Change: with the external shell, send the XP layout and keep the caller's
icon handle; the taskbar reads it as another process's icon (0028).
Evidence: tests/notify-icon.c adds, checks and removes an icon on XP and
on Wine.
Scope: only with WIN4WINE_EXTERNAL_SHELL. The layout has 32-bit handles and
the XP size in 32-bit and 64-bit processes alike.
---
 dlls/shell32/systray.c | 62 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/dlls/shell32/systray.c b/dlls/shell32/systray.c
index c74d017..38e9c70 100644
--- a/dlls/shell32/systray.c
+++ b/dlls/shell32/systray.c
@@ -31,6 +31,7 @@
 #include "shell32_main.h"
 
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(systray);
 
@@ -173,6 +174,65 @@ static void fill_icon_info( const BITMAP *mask, const BITMAP *color, LONG mask_b
     DeleteObject( icon_info->hbmMask );
 }
 
+/* What the XP shell's taskbar takes in WM_COPYDATA (dwData 1), as measured
+ * on XP: a signature, the message and an XP-sized NOTIFYICONDATAW with
+ * 32-bit handles. The icon stays the caller's handle; the taskbar reads it. */
+struct external_shell_notify
+{
+    DWORD signature;
+    DWORD message;
+    DWORD cbSize;
+    DWORD hWnd;
+    UINT uID;
+    UINT uFlags;
+    UINT uCallbackMessage;
+    DWORD hIcon;
+    WCHAR szTip[128];
+    DWORD dwState;
+    DWORD dwStateMask;
+    WCHAR szInfo[256];
+    UINT uTimeout;
+    WCHAR szInfoTitle[64];
+    DWORD dwInfoFlags;
+    GUID guidItem;
+};
+C_ASSERT( sizeof(struct external_shell_notify) == 960 );
+
+static BOOL external_shell_notify_icon(HWND tray, DWORD message, const NOTIFYICONDATAW *nid)
+{
+    struct external_shell_notify data = {0};
+    COPYDATASTRUCT cds = {1, sizeof(data), &data};
+    BOOL ret;
+
+    data.signature = 0x34753423;
+    data.message = message;
+    /* The XP size, also in a 64-bit process. */
+    data.cbSize = sizeof(data) - FIELD_OFFSET( struct external_shell_notify, cbSize );
+    data.hWnd = HandleToLong( nid->hWnd );
+    data.uID = nid->uID;
+    data.uFlags = nid->uFlags;
+    data.uCallbackMessage = nid->uCallbackMessage;
+    data.hIcon = HandleToLong( nid->hIcon );
+    /* XP copies all fields of the version 2 and 3 sizes whatever the flags,
+     * and only the first version's fields for other sizes. */
+    if (nid->cbSize == NOTIFYICONDATAW_V2_SIZE || nid->cbSize == NOTIFYICONDATAW_V3_SIZE)
+    {
+        lstrcpynW( data.szTip, nid->szTip, ARRAY_SIZE(data.szTip) );
+        data.dwState = nid->dwState;
+        data.dwStateMask = nid->dwStateMask;
+        lstrcpynW( data.szInfo, nid->szInfo, ARRAY_SIZE(data.szInfo) );
+        data.uTimeout = nid->uTimeout;
+        lstrcpynW( data.szInfoTitle, nid->szInfoTitle, ARRAY_SIZE(data.szInfoTitle) );
+        data.dwInfoFlags = nid->dwInfoFlags;
+        if (nid->cbSize == NOTIFYICONDATAW_V3_SIZE) data.guidItem = nid->guidItem;
+    }
+    else lstrcpynW( data.szTip, nid->szTip, 64 );
+
+    ret = SendMessageW( tray, WM_COPYDATA, (WPARAM)nid->hWnd, (LPARAM)&cds );
+    SetLastError( ret ? S_OK : E_FAIL );
+    return ret;
+}
+
 /*************************************************************************
  * Shell_NotifyIconW			[SHELL32.298]
  */
@@ -211,6 +271,8 @@ BOOL WINAPI Shell_NotifyIconW(DWORD dwMessage, PNOTIFYICONDATAW nid)
         return FALSE;
     }
 
+    if (win4wine_external_shell()) return external_shell_notify_icon( tray, dwMessage, nid );
+
     cds.dwData = dwMessage;
     cds.cbData = sizeof(*data);
     memset( data, 0, sizeof(*data) );
