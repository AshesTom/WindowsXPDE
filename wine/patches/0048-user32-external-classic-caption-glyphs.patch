From: Codex <codex@localhost>
Subject: [PATCH] user32: size and place classic caption glyphs like XP

Purpose: draw the classic minimize, maximize, restore, close and help
marks with XP's size and position. Wine used a Marlett em of the square
side minus 2 and centred the reported text extent, so on a 16x14 button
the maximize box was 10 pixels wide and one pixel left, touching the
minimize button, and the close cross was a row taller. A self-authored
public-API probe (tests/frame-control.c) on the reference XP machine
showed, for 10..30 pixel high buttons, an em of the side minus 4 drawn
2 pixels inside the square, 3 pixels when pushed; inactive glyphs keep
the existing +1 highlight. Its --verify mode passes on XP and on patched
Wine and fails on unpatched Wine. Limited to the opted-in external shell.
The classic caption buttons now match the reference XP screen exactly.
No Microsoft binary or font is changed and no glyph data is stored.

diff --git a/dlls/user32/uitools.c b/dlls/user32/uitools.c
index 7b42f01..dca71b0 100644
--- a/dlls/user32/uitools.c
+++ b/dlls/user32/uitools.c
@@ -942,6 +942,11 @@ static BOOL UITOOLS95_DrawFrameCaption(HDC dc, LPRECT r, UINT uFlags)
         return FALSE;
     }
     
+    /* XP measurements of public DrawFrameControl output for 10..30px high
+     * buttons: the Marlett em is the square side minus 4, drawn from 2px
+     * inside the square and moved by 1px when pushed. */
+    if (GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0) && SmallDiam > 2)
+        SmallDiam -= 2;
     hf = CreateFontW(-SmallDiam, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
                     SYMBOL_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                     DEFAULT_QUALITY, FIXED_PITCH|FF_DONTCARE, L"Marlett");
@@ -950,6 +955,13 @@ static BOOL UITOOLS95_DrawFrameCaption(HDC dc, LPRECT r, UINT uFlags)
     clrsave = GetTextColor(dc);
     hfsave = SelectObject(dc, hf);
     GetTextExtentPoint32W(dc, str, 1, &size);
+    if (GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0))
+    {
+        int offset = uFlags & DFCS_PUSHED ? 3 : 2;
+        size.cx = size.cy = 0;
+        xc = myr.left + offset;
+        yc = myr.top + offset;
+    }
 
     if(uFlags & DFCS_INACTIVE)
     {
