From: Win4Wine contributors
Subject: [PATCH] comctl32: measure external Start label with its theme font and padding

For the opted-in external Start alias, use GetThemeTextExtent for label
layout and add GetThemeBackgroundExtent around the existing image/alignment
and standard text margins. A stretchable background's TS_TRUE bitmap size
is not a minimum control size. Preserve ordinary Buttons, Classic sizing
and non-opt-in behavior. Initialize themed Start's public text margin to
the measured XP default. No Microsoft artwork or implementation is embedded.

Japanese XP public API reference: 51x16 themed label + two standard text
margin pixels + 25x20 opaque native image gives 78x20 content; public theme
padding adds 34x6, producing the measured BCM_GETIDEALSIZE 112x26. Actual
Start HWND height/layout is separate from this ideal-size contract.

--- a/dlls/comctl32/button.c
+++ b/dlls/comctl32/button.c
@@ -196,6 +196,7 @@
 
 typedef BOOL (*pfGetIdealSize)(BUTTON_INFO *infoPtr, SIZE *size);
 
+static HTHEME start_button_theme(const BUTTON_INFO *info);
 static BOOL PB_GetIdealSize(BUTTON_INFO *infoPtr, SIZE *size);
 static BOOL CB_GetIdealSize(BUTTON_INFO *infoPtr, SIZE *size);
 static BOOL GB_GetIdealSize(BUTTON_INFO *infoPtr, SIZE *size);
@@ -509,6 +510,12 @@
         infoPtr->hwnd = hWnd;
         infoPtr->parent = cs->hwndParent;
         infoPtr->style = cs->style;
+        {
+            WCHAR name[64];
+            if (IsThemeActive() && GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0) &&
+                GetClassNameW(hWnd, name, ARRAY_SIZE(name)) && !wcscmp(name, L"Win4WineStartButton"))
+                SetRect(&infoPtr->text_margin, 1, 1, 1, 1);
+        }
         infoPtr->split_style = BCSS_STRETCH;
         infoPtr->glyph = (HIMAGELIST)0x36;  /* Marlett down arrow char code */
         infoPtr->glyph_size.cx = get_default_glyph_size(infoPtr);
@@ -1089,16 +1096,16 @@
 
         {
             BOOL result = btnGetIdealSizeFunc[btn_type](infoPtr, size);
-            WCHAR class_name[64];
-            HTHEME theme = GetWindowTheme(hWnd);
-            SIZE image_size;
-            if (result && theme && GetClassNameW(hWnd, class_name, ARRAY_SIZE(class_name))
-                && !wcscmp(class_name, L"Win4WineStartButton")
-                && SUCCEEDED(GetThemePartSize(theme, NULL, BP_PUSHBUTTON, PBS_NORMAL,
-                                              NULL, TS_TRUE, &image_size)))
+            HTHEME theme = start_button_theme(infoPtr);
+            RECT content = {0, 0, size->cx, size->cy}, background;
+            /* A stretchable Start image is not its minimum window size.
+             * Add the active theme's content padding to the measured label. */
+            if (result && theme && GetWindowTextLengthW(hWnd) &&
+                SUCCEEDED(GetThemeBackgroundExtent(theme, NULL, BP_PUSHBUTTON,
+                                                    PBS_NORMAL, &content, &background)))
             {
-                size->cx = max(size->cx, image_size.cx);
-                size->cy = max(size->cy, image_size.cy);
+                size->cx = background.right - background.left;
+                size->cy = background.bottom - background.top;
             }
             return result;
         }
@@ -1114,18 +1121,32 @@
 }
 
 /* If maxWidth is zero, rectangle width is unlimited */
+/* This independently registered control is selected only by the opted-in
+ * external taskbar. Ordinary Buttons retain their own font and sizing. */
+static HTHEME start_button_theme(const BUTTON_INFO *info)
+{
+    WCHAR name[64];
+    if (!IsThemeActive() || !GetEnvironmentVariableW(L"WIN4WINE_EXTERNAL_SHELL", NULL, 0) ||
+        !GetClassNameW(info->hwnd, name, ARRAY_SIZE(name)) ||
+        wcscmp(name, L"Win4WineStartButton")) return NULL;
+    return GetWindowTheme(info->hwnd);
+}
+
 static RECT BUTTON_GetTextRect(const BUTTON_INFO *infoPtr, HDC hdc, const WCHAR *text, LONG maxWidth)
 {
     LONG style = GetWindowLongW(infoPtr->hwnd, GWL_STYLE);
     LONG exStyle = GetWindowLongW(infoPtr->hwnd, GWL_EXSTYLE);
     UINT dtStyle = BUTTON_BStoDT(style, exStyle);
     HFONT hPrevFont;
+    HTHEME theme = start_button_theme(infoPtr);
     RECT rect = {0};
 
     rect.right = maxWidth;
     hPrevFont = SelectObject(hdc, infoPtr->font);
     /* Calculate height without DT_VCENTER and DT_BOTTOM to get the correct height */
-    DrawTextW(hdc, text, -1, &rect, (dtStyle & ~(DT_VCENTER | DT_BOTTOM)) | DT_CALCRECT);
+    if (!theme || FAILED(GetThemeTextExtent(theme, hdc, BP_PUSHBUTTON, PBS_NORMAL, text, -1,
+                                            dtStyle & ~(DT_VCENTER | DT_BOTTOM), &rect, &rect)))
+        DrawTextW(hdc, text, -1, &rect, (dtStyle & ~(DT_VCENTER | DT_BOTTOM)) | DT_CALCRECT);
     if (hPrevFont) SelectObject(hdc, hPrevFont);
 
     return rect;
