+/* Localized theme values. A localized msstyles keeps per-language
+ * overrides in its string table, written as "NormalBlue@[Section]Name=Value"
+ * for the color/size variant whose ini is NORMALBLUE_INI. The Japanese Luna
+ * uses them for its MS UI Gothic fonts. XP applies them over the ini; the
+ * public GetThemeFont results on the reference machine match these values. */
+struct localized_value
+{
+    struct localized_value *next;
+    WCHAR *section;
+    WCHAR *property;
+    WCHAR *value;
+    BOOL used;
+};
+
+struct localized_context
+{
+    PTHEME_FILE tf;
+    LPCWSTR prefix;
+    int prefix_len;
+};
+
+static WCHAR *dup_trimmed(LPCWSTR start, LPCWSTR end)
+{
+    WCHAR *copy;
+    while (start < end && (*start == ' ' || *start == '\t')) start++;
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t')) end--;
+    if (!(copy = malloc((end - start + 1) * sizeof(WCHAR)))) return NULL;
+    memcpy(copy, start, (end - start) * sizeof(WCHAR));
+    copy[end - start] = 0;
+    return copy;
+}
+
+static void free_localized_values(PTHEME_FILE tf)
+{
+    while (tf->localized)
+    {
+        struct localized_value *value = tf->localized;
+        tf->localized = value->next;
+        free(value->section);
+        free(value->property);
+        free(value->value);
+        free(value);
+    }
+}
+
+static BOOL CALLBACK collect_localized_block(HMODULE module, LPCWSTR type, LPWSTR name, LONG_PTR param)
+{
+    struct localized_context *ctx = (struct localized_context *)param;
+    WCHAR buffer[512];
+    UINT i;
+
+    if (!IS_INTRESOURCE(name) || !LOWORD(name)) return TRUE;
+    for (i = 0; i < 16; i++)
+    {
+        UINT id = (LOWORD(name) - 1) * 16 + i;
+        int len = LoadStringW(module, id, buffer, ARRAY_SIZE(buffer));
+        WCHAR *at, *close, *equal;
+        struct localized_value *value;
+
+        if (len <= 0 || len >= ARRAY_SIZE(buffer) - 1) continue;
+        if (!(at = wcschr(buffer, '@')) || at - buffer != ctx->prefix_len || at[1] != '[') continue;
+        if (CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, buffer, ctx->prefix_len,
+                           ctx->prefix, ctx->prefix_len) != CSTR_EQUAL) continue;
+        if (!(close = wcschr(at + 2, ']')) || !(equal = wcschr(close + 1, '='))) continue;
+        if (!(value = calloc(1, sizeof(*value)))) break;
+        value->section = dup_trimmed(at + 2, close);
+        value->property = dup_trimmed(close + 1, equal);
+        value->value = dup_trimmed(equal + 1, buffer + len);
+        if (!value->section || !value->property || !value->value)
+        {
+            free(value->section);
+            free(value->property);
+            free(value->value);
+            free(value);
+            continue;
+        }
+        value->next = ctx->tf->localized;
+        ctx->tf->localized = value;
+    }
+    return TRUE;
+}
+
+static void load_localized_values(PTHEME_FILE tf, LPCWSTR ini_name)
+{
+    struct localized_context ctx = {tf, ini_name, 0};
+    int len;
+
+    if (tf->localized_loaded) return;
+    tf->localized_loaded = TRUE;
+    if (!ini_name || !win4wine_external_shell()) return;
+    len = lstrlenW(ini_name);
+    if (len > 4 && !lstrcmpiW(ini_name + len - 4, L"_INI")) len -= 4;
+    ctx.prefix_len = len;
+    EnumResourceNamesW(tf->hTheme, (LPCWSTR)RT_STRING, collect_localized_block, (LONG_PTR)&ctx);
+}
+
+static struct localized_value *find_localized(PTHEME_FILE tf, LPCWSTR section, DWORD section_len, LPCWSTR property)
+{
+    struct localized_value *value;
+    for (value = tf->localized; value; value = value->next)
+        if (CompareStringW(LOCALE_SYSTEM_DEFAULT, NORM_IGNORECASE, value->section, -1, section, section_len) == CSTR_EQUAL &&
+            !lstrcmpiW(value->property, property))
+            return value;
+    return NULL;
+}
+
 /***********************************************************************
  *      MSSTYLES_ParseThemeIni
  *
@@ -937,10 +1046,17 @@ static void MSSTYLES_ParseThemeIni(PTHEME_FILE tf, BOOL setMetrics)
     LPCWSTR lpName;
     DWORD dwValueLen;
     LPCWSTR lpValue;
+    LPCWSTR ini_name = NULL, section;
