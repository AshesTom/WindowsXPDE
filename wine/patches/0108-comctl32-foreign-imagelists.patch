From: Codex <codex@localhost>
Subject: [PATCH] comctl32: draw image lists of another comctl32 through IImageList

Purpose: let Wine's controls draw the image lists that Windows 7's shell32
gives (the system image list), when a program has both Wine's and
Windows 7's comctl32 (the Windows 7 shell session's file dialogs).
Windows behavior: an HIMAGELIST is the image list's IUnknown; the image
list functions of one comctl32 work on another's lists through
IImageList (HIMAGELIST_QueryInterface).
Wine before: functions given a list that is not Wine's failed, so the
"Look in" box of the open dialog showed no icons with Windows 7's
shell32.
Change: ImageList_DrawIndirect (and so ImageList_Draw and _DrawEx),
ImageList_GetIconSize, ImageList_GetImageCount and ImageList_GetIcon
call IImageList for a list that is not Wine's but answers
QueryInterface(IID_IImageList).
Evidence: Notepad's Open dialog shows the folder icons in its "Look in"
box with Windows 7's system image list.
Scope: image lists that are not Wine's; Wine's own lists are unchanged.
---
 dlls/comctl32/imagelist.c | 73 +++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 70 insertions(+), 3 deletions(-)

diff --git a/dlls/comctl32/imagelist.c b/dlls/comctl32/imagelist.c
index 93c502e..eca8cb4 100644
--- a/dlls/comctl32/imagelist.c
+++ b/dlls/comctl32/imagelist.c
@@ -129,6 +129,7 @@ static inline HIMAGELIST impl_from_IImageList2(IImageList2 *iface)
 static HBITMAP ImageList_CreateImage(HDC hdc, HIMAGELIST himl, UINT count);
 static HRESULT ImageListImpl_CreateInstance(const IUnknown *pUnkOuter, REFIID iid, void** ppv);
 static BOOL is_valid(HIMAGELIST himl);
+static IImageList *foreign_imagelist(HIMAGELIST himl);
 
 /*
  * An imagelist with N images is tiled like this:
@@ -1316,7 +1317,16 @@ ImageList_DrawIndirect (IMAGELISTDRAWPARAMS *pimldp)
     BOOL has_alpha;
 
     if (!pimldp || !(himl = pimldp->himl)) return FALSE;
-    if (!is_valid(himl)) return FALSE;
+    if (!is_valid(himl))
+    {
+        IImageList *list = foreign_imagelist(himl);
+        HRESULT hr;
+
+        if (!list) return FALSE;
+        hr = IImageList_Draw(list, pimldp);
+        IImageList_Release(list);
+        return SUCCEEDED(hr);
+    }
     if ((pimldp->i < 0) || (pimldp->i >= himl->cCurImage)) return FALSE;
 
     imagelist_point_from_index( himl, pimldp->i, &pt );
@@ -1695,7 +1705,17 @@ ImageList_GetIcon (HIMAGELIST himl, INT i, UINT fStyle)
     POINT pt;
 
     TRACE("%p %d %d\n", himl, i, fStyle);
-    if (!is_valid(himl) || (i < 0) || (i >= himl->cCurImage)) return NULL;
+    if (!is_valid(himl))
+    {
+        IImageList *list = foreign_imagelist(himl);
+
+        hIcon = NULL;
+        if (!list) return NULL;
+        IImageList_GetIcon(list, i, fStyle, &hIcon);
+        IImageList_Release(list);
+        return hIcon;
+    }
+    if ((i < 0) || (i >= himl->cCurImage)) return NULL;
 
     ii.fIcon = TRUE;
     ii.xHotspot = 0;
@@ -1762,6 +1782,16 @@ ImageList_GetIcon (HIMAGELIST himl, INT i, UINT fStyle)
 BOOL WINAPI
 ImageList_GetIconSize (HIMAGELIST himl, INT *cx, INT *cy)
 {
+    if (!is_valid(himl) && cx && cy)
+    {
+        IImageList *list = foreign_imagelist(himl);
+        HRESULT hr;
+
+        if (!list) return FALSE;
+        hr = IImageList_GetIconSize(list, cx, cy);
+        IImageList_Release(list);
+        return SUCCEEDED(hr);
+    }
     if (!is_valid(himl) || !cx || !cy)
 	return FALSE;
 
@@ -1789,7 +1819,15 @@ INT WINAPI
 ImageList_GetImageCount (HIMAGELIST himl)
 {
     if (!is_valid(himl))
-	return 0;
+    {
+        IImageList *list = foreign_imagelist(himl);
+        int count = 0;
+
+        if (!list) return 0;
+        IImageList_GetImageCount(list, &count);
+        IImageList_Release(list);
+        return count;
+    }
 
     return himl->cCurImage;
 }
@@ -3794,6 +3832,35 @@ static const IImageList2Vtbl ImageListImpl_Vtbl = {
     ImageListImpl_ReplaceFromImageList
 };
 
+/* An image list of another comctl32 in the process (Windows 7's, which
+ * Windows 7's shell32 uses): on Windows an HIMAGELIST is the list's IUnknown,
+ * so the image list functions of one comctl32 draw another's lists through
+ * IImageList. */
+static IImageList *foreign_imagelist(HIMAGELIST himl)
+{
+    IImageList *list = NULL;
+
+    if (!himl) return NULL;
+    __TRY
+    {
+        IUnknown *unknown = (IUnknown *)himl;
+        if (FAILED(unknown->lpVtbl->QueryInterface(unknown, &IID_IImageList, (void **)&list)))
+            list = NULL;
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        list = NULL;
+    }
+    __ENDTRY
+    if (list && is_valid((HIMAGELIST)list))
+    {
+        /* it was one of ours after all */
+        IImageList_Release(list);
+        return NULL;
+    }
+    return list;
+}
+
 static BOOL is_valid(HIMAGELIST himl)
 {
     BOOL valid;
