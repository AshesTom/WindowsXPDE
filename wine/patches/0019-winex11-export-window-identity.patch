From: Codex <codex@localhost>
Subject: [PATCH] winex11: expose Win32 window identities to the companion WM

Purpose: let the X11 window manager tell the desktop, the taskbar and the
proxy windows apart.
XP behavior: Progman stays below applications and Shell_TrayWnd reserves
the work area; titles and process names cannot identify them.
Change: set the private _WIN4WINE_CLASS (class name, ASCII) and
_WIN4WINE_HWND properties on every whole window.
Scope: every Wine window gets the two properties; window managers other
than the bridge ignore them, so behaviour is unchanged.
Old patches: 0001.
---
 dlls/winex11.drv/window.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 7ff9b88..308a76b 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2443,6 +2443,25 @@ static void create_whole_window( struct x11drv_win_data *data )
 
     x11drv_xinput2_enable( data->display, data->whole_window );
     set_initial_wm_hints( data->display, data->whole_window );
+    /* Expose Win32 identity to the companion WM without depending on titles. */
+    {
+        WCHAR buffer[256];
+        char class_name[256];
+        UNICODE_STRING name = { 0, sizeof(buffer), buffer };
+        unsigned int length, i;
+        unsigned long hwnd = HandleToULong( data->hwnd );
+
+        length = NtUserGetClassName( data->hwnd, FALSE, &name );
+        for (i = 0; i < length && i < sizeof(class_name) - 1; i++)
+            class_name[i] = buffer[i] < 128 ? buffer[i] : '?';
+        class_name[i] = 0;
+        XChangeProperty( data->display, data->whole_window,
+                         XInternAtom( data->display, "_WIN4WINE_CLASS", False ),
+                         XA_STRING, 8, PropModeReplace, (unsigned char *)class_name, i );
+        XChangeProperty( data->display, data->whole_window,
+                         XInternAtom( data->display, "_WIN4WINE_HWND", False ),
+                         XA_CARDINAL, 32, PropModeReplace, (unsigned char *)&hwnd, 1 );
+    }
     set_wm_hints( data );
 
     XSaveContext( data->display, data->whole_window, winContext, (char *)data->hwnd );
