From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] user32: show a new wallpaper on an external shell's desktop at once

Purpose: choosing a wallpaper in XP's Display Properties changes the
desktop when it is applied, as on XP.
XP behavior: Display Properties converts a JPEG wallpaper to the same
Wallpaper1.bmp each time, sets it (SPI_SETDESKWALLPAPER) and the desktop
shows it.
Wine before (win4wine patch 0049): the shell's process reloaded its
wallpaper only when its file name changed, so a new picture under the same
Wallpaper1.bmp, or another position, kept the old one; and only the desktop
window was repainted, which the shell's desktop (Progman) covers.
Change: the shell's process also reloads it when the file's time, the
WallpaperStyle or TileWallpaper change, and setting the wallpaper repaints
Progman and its children.
Scope: processes with WIN4WINE_EXTERNAL_SHELL.
---
diff --git a/dlls/user32/desktop.c b/dlls/user32/desktop.c
--- a/dlls/user32/desktop.c
+++ b/dlls/user32/desktop.c
@@ -35,6 +35,13 @@
 static BOOL fTileWallPaper;
 static int scaled_wallpaper;
 static WCHAR loaded_wallpaper[MAX_PATH];
+/* What the loaded wallpaper was made from, besides its file name. */
+struct wallpaper_source
+{
+    FILETIME written;
+    int style, tile;
+};
+static struct wallpaper_source loaded_source;
 
 
 /***********************************************************************
@@ -143,13 +150,28 @@
         int width = rect.right - rect.left, height = rect.bottom - rect.top;
 
         /* The XP shell paints its desktop in its own process, where the
-         * desktop thread's wallpaper bitmap is not loaded. */
+         * desktop thread's wallpaper bitmap is not loaded. XP's Display
+         * Properties converts every JPEG wallpaper to the same Wallpaper1.bmp:
+         * the file's time and the style tell a new one too. */
         if (win4wine_external_shell())
         {
             WCHAR wallpaper[MAX_PATH];
-            if (SystemParametersInfoW( SPI_GETDESKWALLPAPER, MAX_PATH, wallpaper, 0 ) &&
-                wcscmp( wallpaper, loaded_wallpaper ))
-                init_wallpaper( wallpaper );
+            if (SystemParametersInfoW( SPI_GETDESKWALLPAPER, MAX_PATH, wallpaper, 0 ))
+            {
+                WIN32_FILE_ATTRIBUTE_DATA info;
+                struct wallpaper_source source = {{0}};
+
+                if (wallpaper[0] && GetFileAttributesExW( wallpaper, GetFileExInfoStandard, &info ))
+                    source.written = info.ftLastWriteTime;
+                source.style = GetProfileIntA( "desktop", "WallpaperStyle", 0 );
+                source.tile = GetProfileIntA( "desktop", "TileWallPaper", 0 );
+                if (wcscmp( wallpaper, loaded_wallpaper ) || CompareFileTime( &source.written, &loaded_source.written ) ||
+                    source.style != loaded_source.style || source.tile != loaded_source.tile)
+                {
+                    init_wallpaper( wallpaper );
+                    loaded_source = source;
+                }
+            }
         }
 
         /* Paint desktop pattern (only if wall paper does not cover everything) */
diff --git a/dlls/user32/sysparams.c b/dlls/user32/sysparams.c
--- a/dlls/user32/sysparams.c
+++ b/dlls/user32/sysparams.c
@@ -24,6 +24,7 @@
 #include "controls.h"
 #include "wine/asm.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(system);
 
@@ -227,6 +228,13 @@
         }
     }
     else SendMessageW( GetDesktopWindow(), WM_SETTINGCHANGE, SPI_SETDESKWALLPAPER, 0 );
+    /* An external shell's desktop (Progman) covers the desktop window and
+     * paints the wallpaper itself, in its own process: it paints again. */
+    if (win4wine_external_shell())
+    {
+        HWND progman = FindWindowW( L"Progman", NULL );
+        if (progman) NtUserRedrawWindow( progman, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN );
+    }
     return TRUE;
 }
 
