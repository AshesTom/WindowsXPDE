From: Codex <codex@localhost>
Subject: [PATCH] winex11: refresh the external shell's work area without a mode change

Purpose: follow the work area that the companion WM publishes for the
shell's taskbar, and keep maximized windows inside it when the taskbar
changes its size (the Windows 7 taskbar's small and large icons).
Windows behavior: a maximized window is resized to the new work area at
once (Windows 7 SP1: a maximized Notepad followed the taskbar from 40
to 30 pixels high).
Wine before: the work area was read only on display mode changes, and
maximized windows kept their size.
Change: on the desktop owner thread, watch the EWMH and GTK work-area
properties of the root window, ignore unchanged contents, refresh the
monitor data, post an internal message to each maximized top-level
window (its thread moves it to the position and size of
WM_GETMINMAXINFO for the new work area) and send a bounded
setting-change notification. A work area set explicitly with
SPI_SETWORKAREA is kept. The new internal call and message are appended
without renumbering existing ones.
Evidence: tests/workarea.py on its own Xvfb display and prefix; a
maximized Notepad and Mousepad follow the Windows 7 taskbar between 30
and 40 pixels.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0039.
---
 dlls/win32u/message.c        |  3 +++
 dlls/win32u/sysparams.c      | 29 +++++++++++++++++++++-
 dlls/win32u/win32u_private.h |  1 +
 dlls/win32u/window.c         | 26 ++++++++++++++++++++
 dlls/winex11.drv/event.c     | 58 ++++++++++++++++++++++++++++++++++++++++++++
 include/ntuser.h             |  2 ++
 6 files changed, 118 insertions(+), 1 deletion(-)

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 53a9794..00cceac 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2258,6 +2258,9 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
     case WM_WINE_UPDATEWINDOWSTATE:
         update_window_state( hwnd );
         return 0;
+    case WM_WINE_REFIT_MAXIMIZED:
+        refit_maximized_window( hwnd );
+        return 0;
     case WM_WINE_SETPIXELFORMAT:
         set_window_pixel_format( hwnd, wparam, lparam );
         return 0;
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index eee8149..3d85f0f 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -36,6 +36,7 @@
 #include "d3dkmdt.h"
 #include "wine/wingdi16.h"
 #include "wine/server.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(system);
 
@@ -295,6 +296,7 @@ union sysparam_all_entry
 
 static UINT system_dpi;
 static RECT work_area;
+static BOOL work_area_explicit;
 static DWORD process_layout = ~0u;
 
 static HDC display_dc;
@@ -6302,6 +6304,7 @@ BOOL WINAPI NtUserSystemParametersInfo( UINT action, UINT val, void *ptr, UINT w
         if (!ptr) return FALSE;
         spi_idx = SPI_SETWORKAREA_IDX;
         work_area = *(RECT*)ptr;
+        work_area_explicit = TRUE;
         spi_loaded[spi_idx] = TRUE;
         ret = TRUE;
         break;
@@ -6314,7 +6317,8 @@ BOOL WINAPI NtUserSystemParametersInfo( UINT action, UINT val, void *ptr, UINT w
         if (!ptr) return FALSE;
 
         spi_idx = SPI_SETWORKAREA_IDX;
-        if (!spi_loaded[spi_idx])
+        if (!spi_loaded[spi_idx] ||
+            (win4wine_external_shell() && !work_area_explicit))
         {
             struct monitor *monitor;
 
@@ -7470,6 +7474,29 @@ ULONG_PTR WINAPI NtUserCallNoParam( ULONG code )
         display_mode_changed( FALSE );
         return TRUE;
 
+    case NtUserCallNoParam_WorkAreaChanged:
+    {
+        static const WCHAR emptyW[1];
+        HWND *list;
+
+        if (!win4wine_external_shell() || !update_display_cache( TRUE )) return FALSE;
+        /* Each maximized window refits itself on its own thread. */
+        if ((list = list_window_children( 0 )))
+        {
+            int i;
+            for (i = 0; list[i]; i++)
+                if ((get_window_long( list[i], GWL_STYLE ) & (WS_MAXIMIZE | WS_MINIMIZE)) == WS_MAXIMIZE)
+                    NtUserPostMessage( list[i], WM_WINE_REFIT_MAXIMIZED, 0, 0 );
+            free( list );
+        }
+        /* The screen mode is unchanged. Notify applications only after the
+         * shared monitor work areas have been refreshed. Keep pointer data
+         * in a bounded synchronous call, as for SPIF_SENDCHANGE above. */
+        send_message_timeout( HWND_BROADCAST, WM_SETTINGCHANGE, SPI_SETWORKAREA,
+                              (LPARAM)emptyW, SMTO_ABORTIFHUNG, 200, FALSE );
+        return TRUE;
+    }
+
     /* temporary exports */
     case NtUserExitingThread:
         exiting_thread_id = GetCurrentThreadId();
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index 71b4976..39d9c00 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -296,6 +296,7 @@ extern LONG_PTR set_window_long( HWND hwnd, INT offset, UINT size, LONG_PTR newv
 extern BOOL set_window_pos( WINDOWPOS *winpos, int parent_x, int parent_y );
 extern UINT set_window_style_bits( HWND hwnd, UINT set_bits, UINT clear_bits );
 extern void update_window_state( HWND hwnd );
+extern void refit_maximized_window( HWND hwnd );
 extern HWND window_from_point( HWND hwnd, POINT pt, INT *hittest, BOOL send_nchittest );
 extern HWND get_shell_window(void);
 extern HWND get_progman_window(void);
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 16a82a2..44ed14d 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -4725,6 +4725,32 @@ void update_window_state( HWND hwnd )
     set_thread_dpi_awareness_context( context );
 }
 
+/***********************************************************************
+ *              refit_maximized_window
+ *
+ * A maximized window follows a changed work area, as on Windows (a
+ * taskbar that grows or shrinks resizes the maximized windows).
+ */
+void refit_maximized_window( HWND hwnd )
+{
+    MINMAXINFO minmax;
+    UINT context;
+    RECT rect;
+
+    if (!is_current_thread_window( hwnd )) return;
+    if ((get_window_long( hwnd, GWL_STYLE ) & (WS_MAXIMIZE | WS_MINIMIZE | WS_CHILD)) != WS_MAXIMIZE) return;
+
+    context = set_thread_dpi_awareness_context( get_window_dpi_awareness_context( hwnd ));
+    minmax = get_min_max_info( hwnd );
+    if (get_window_rect( hwnd, &rect, get_thread_dpi() ) &&
+        (rect.left != minmax.ptMaxPosition.x || rect.top != minmax.ptMaxPosition.y ||
+         rect.right - rect.left != minmax.ptMaxSize.x || rect.bottom - rect.top != minmax.ptMaxSize.y))
+        NtUserSetWindowPos( hwnd, 0, minmax.ptMaxPosition.x, minmax.ptMaxPosition.y,
+                            minmax.ptMaxSize.x, minmax.ptMaxSize.y,
+                            SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_NOACTIVATE );
+    set_thread_dpi_awareness_context( context );
+}
+
 /***********************************************************************
  *              show_window
  *
diff --git a/dlls/winex11.drv/event.c b/dlls/winex11.drv/event.c
index fdb6b63..195f2f0 100644
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -44,6 +44,7 @@
 
 #include "wine/server.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(event);
 WINE_DECLARE_DEBUG_CHANNEL(xdnd);
@@ -1332,6 +1333,61 @@ static void handle_net_active_window( XPropertyEvent *event )
     net_active_window_notify( event->serial, window, event->time );
 }
 
+/* Only the desktop owner publishes shared monitor state. Deduplicate
+ * property contents rather than X event serials: WMs may repeatedly write
+ * identical reservations, and a single update may change both properties. */
+static void handle_work_area_notify( HWND hwnd, XPropertyEvent *event )
+{
+    static struct work_area_property
+    {
+        Atom type;
+        int format;
+        unsigned long count;
+        unsigned char *data;
+        BOOL initialized;
+    } cached[2];
+    Atom atoms[2] = {x11drv_atom(_NET_WORKAREA), x11drv_atom(_GTK_WORKAREAS_D0)};
+    BOOL changed = FALSE;
+    unsigned int i;
+
+    if (!win4wine_external_shell() || event->window != root_window ||
+        hwnd != NtUserGetDesktopWindow() || NtUserGetWindowThread( hwnd, NULL ) != GetCurrentThreadId()) return;
+    for (i = 0; i < ARRAY_SIZE(atoms); i++)
+    {
+        Atom type;
+        int format;
+        unsigned long count, remaining;
+        unsigned char *data = NULL;
+        SIZE_T size;
+
+        if (XGetWindowProperty( event->display, root_window, atoms[i], 0, 4096, False,
+                                AnyPropertyType, &type, &format, &count, &remaining, &data )) continue;
+        /* A work area is a bounded CARDINAL32 array of rectangle tuples.
+         * Property deletion is valid and restores the driver's fallback. */
+        if (remaining || count > 4096 ||
+            (type != None && (type != XA_CARDINAL || format != 32 || count < 4 || count % 4)))
+        {
+            XFree( data );
+            continue;
+        }
+        size = count * sizeof(long);
+        if (!cached[i].initialized || cached[i].type != type || cached[i].format != format ||
+            cached[i].count != count || (size && memcmp( cached[i].data, data, size )))
+        {
+            XFree( cached[i].data );
+            cached[i].type = type;
+            cached[i].format = format;
+            cached[i].count = count;
+            cached[i].data = data;
+            cached[i].initialized = TRUE;
+            changed = TRUE;
+        }
+        else XFree( data );
+    }
+    if (changed && !NtUserCallNoParam( NtUserCallNoParam_WorkAreaChanged ))
+        for (i = 0; i < ARRAY_SIZE(cached); i++) cached[i].initialized = FALSE;
+}
+
 /***********************************************************************
  *           X11DRV_PropertyNotify
  */
@@ -1348,6 +1404,8 @@ static BOOL X11DRV_PropertyNotify( HWND hwnd, XEvent *xev )
     if (event->atom == x11drv_atom(WM_NORMAL_HINTS)) handle_wm_normal_hints_notify( hwnd, event );
     if (event->atom == x11drv_atom(_NET_SUPPORTED)) handle_net_supported_notify( event );
     if (event->atom == x11drv_atom(_NET_ACTIVE_WINDOW)) handle_net_active_window( event );
+    if (event->atom == x11drv_atom(_NET_WORKAREA) || event->atom == x11drv_atom(_GTK_WORKAREAS_D0))
+        handle_work_area_notify( hwnd, event );
 
     return TRUE;
 }
diff --git a/include/ntuser.h b/include/ntuser.h
index ce1b18f..aed152e 100644
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -650,6 +650,7 @@ enum wine_internal_message
     WM_WINE_UPDATEWINDOWSTATE,
     WM_WINE_TRACKMOUSEEVENT,
     WM_WINE_SETPIXELFORMAT,
+    WM_WINE_REFIT_MAXIMIZED,
     WM_WINE_FIRST_DRIVER_MSG = 0x80001000,  /* range of messages reserved for the USER driver */
     WM_WINE_CLIPCURSOR = 0x80001ff0, /* internal driver notification messages */
     WM_WINE_SETCURSOR,
@@ -1077,6 +1078,7 @@ enum
     /* temporary exports */
     NtUserExitingThread,
     NtUserThreadDetach,
+    NtUserCallNoParam_WorkAreaChanged,
 };
 
 static inline HWND NtUserGetDesktopWindow(void)
