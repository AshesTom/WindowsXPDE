From: Codex <codex@localhost>
Subject: [PATCH] comctl32: the hot item of Windows 7's Explorer-themed list views

Purpose: light the item under the mouse in report list views with the
Explorer theme, as Windows 7 does.
Windows behavior: an Explorer-themed report list view draws the item
under the mouse with LVP_LISTITEM's hot state, with or without
LVS_EX_TRACKSELECT; a selected item under the mouse uses the hot
selected state, also when the list view has no focus.
Wine before: the hot item was only tracked for the hot-tracking styles
and never drawn.
Change: for the Windows 7 shell's Explorer-themed report views, follow
the item under the mouse (TME_LEAVE clears it) and draw LISS_HOT or
LISS_HOTSELECTED. An item's invalidation reaches the row's left edge,
where the themed row starts.
Evidence: lvsel.exe (four list views) on Windows 7 and in the session,
the mouse over an item, a selected item and an unfocused selected item:
the backgrounds are identical; only the known glyph differences remain.
Scope: the Windows 7 shell (COMCTL32_IsWin7Shell), comctl32 v6.
---
 dlls/comctl32/listview.c | 44 ++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 42 insertions(+), 2 deletions(-)

diff --git a/dlls/comctl32/listview.c b/dlls/comctl32/listview.c
index 730db52..5c061bf 100644
--- a/dlls/comctl32/listview.c
+++ b/dlls/comctl32/listview.c
@@ -1793,6 +1793,8 @@ static inline void LISTVIEW_InvalidateItem(const LISTVIEW_INFO *infoPtr, INT nIt
         return;
 
     LISTVIEW_GetItemBox(infoPtr, nItem, &rcBox);
+    /* the themed row starts left of the item box */
+    if (explorer_theme(infoPtr) && infoPtr->uView == LV_VIEW_DETAILS) rcBox.left = infoPtr->rcList.left;
     LISTVIEW_InvalidateRect(infoPtr, &rcBox);
 }
 
@@ -4084,6 +4086,35 @@ static VOID CALLBACK LISTVIEW_ScrollTimer(HWND hWnd, UINT uMsg, UINT_PTR idEvent
  * RETURN:
  *   0 if the message is processed, non-zero if there was an error
  */
+/* Windows 7's Explorer-themed list views light the item under the mouse;
+ * pt is NULL when the mouse leaves */
+static void LISTVIEW_TrackHotItem(LISTVIEW_INFO *infoPtr, const POINT *pt)
+{
+    INT item = -1, old = infoPtr->nHotItem;
+
+    if (!explorer_theme(infoPtr) || infoPtr->uView != LV_VIEW_DETAILS) return;
+    if (pt)
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_QUERY };
+        LVHITTESTINFO ht;
+
+        ht.pt = *pt;
+        item = LISTVIEW_HitTest(infoPtr, &ht, FALSE, TRUE);
+        _TrackMouseEvent(&tme);
+        if (!(tme.dwFlags & TME_LEAVE) || tme.hwndTrack != infoPtr->hwndSelf)
+        {
+            tme.dwFlags = TME_LEAVE | (tme.hwndTrack == infoPtr->hwndSelf ? tme.dwFlags : 0);
+            tme.hwndTrack = infoPtr->hwndSelf;
+            tme.dwHoverTime = infoPtr->dwHoverTime;
+            _TrackMouseEvent(&tme);
+        }
+    }
+    if (item == old) return;
+    infoPtr->nHotItem = item;
+    if (old != -1) LISTVIEW_InvalidateItem(infoPtr, old);
+    if (item != -1) LISTVIEW_InvalidateItem(infoPtr, item);
+}
+
 static LRESULT LISTVIEW_MouseMove(LISTVIEW_INFO *infoPtr, WORD fwKeys, INT x, INT y)
 {
     LVHITTESTINFO ht;
@@ -4093,6 +4124,8 @@ static LRESULT LISTVIEW_MouseMove(LISTVIEW_INFO *infoPtr, WORD fwKeys, INT x, IN
     pt.x = x;
     pt.y = y;
 
+    LISTVIEW_TrackHotItem(infoPtr, infoPtr->bMarqueeSelect ? NULL : &pt);
+
     if (!(fwKeys & MK_LBUTTON))
         infoPtr->bLButtonDown = FALSE;
 
@@ -4885,10 +4918,13 @@ static BOOL LISTVIEW_DrawItem(LISTVIEW_INFO *infoPtr, HDC hdc, INT nItem, ITERAT
     if (cdsubitemmode & CDRF_SKIPDEFAULT) goto postpaint;
 
 #if __WINE_COMCTL32_VERSION == 6
-    if (explorer_theme(infoPtr) && infoPtr->uView == LV_VIEW_DETAILS && (lvItem.state & LVIS_SELECTED))
+    if (explorer_theme(infoPtr) && infoPtr->uView == LV_VIEW_DETAILS &&
+        ((lvItem.state & LVIS_SELECTED) || lvItem.iItem == infoPtr->nHotItem))
     {
         RECT row = rcBox;
-        int state = infoPtr->bFocus || !(infoPtr->dwStyle & LVS_SHOWSELALWAYS) ? LISS_SELECTED : LISS_SELECTEDNOTFOCUS;
+        int state = !(lvItem.state & LVIS_SELECTED) ? LISS_HOT :
+                    lvItem.iItem == infoPtr->nHotItem ? LISS_HOTSELECTED :
+                    infoPtr->bFocus || !(infoPtr->dwStyle & LVS_SHOWSELALWAYS) ? LISS_SELECTED : LISS_SELECTEDNOTFOCUS;
 
         if (!(infoPtr->dwLvExStyle & LVS_EX_FULLROWSELECT) && DPA_GetPtrCount(infoPtr->hdpaColumns) > 0)
             row.right = row.left + LISTVIEW_GetColumnInfo(infoPtr, 0)->rcHeader.right -
@@ -11956,6 +11992,10 @@ LISTVIEW_WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
   case WM_MOUSEHOVER:
     return LISTVIEW_MouseHover(infoPtr, (SHORT)LOWORD(lParam), (SHORT)HIWORD(lParam));
 
+  case WM_MOUSELEAVE:
+    LISTVIEW_TrackHotItem(infoPtr, NULL);
+    return 0;
+
   case WM_NCDESTROY:
     return LISTVIEW_NCDestroy(infoPtr);
 
