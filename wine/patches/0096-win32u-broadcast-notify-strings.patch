From: Codex <codex@localhost>
Subject: [PATCH] win32u: SendNotifyMessage broadcasts WM_SETTINGCHANGE with its string

Purpose: let the Windows 7 taskbar's properties change the taskbar at
once (small icons, combining buttons), as on Windows 7.
Windows behavior: SendNotifyMessage to HWND_BROADCAST takes
WM_SETTINGCHANGE (also with a NULL string) and WM_DEVMODECHANGE, W and
A, and each receiving thread gets a copy of the string; an ANSI string
arrives as its bytes, unconverted, even in a Unicode window. For one
window, these and other messages with pointers fail with
ERROR_MESSAGE_SYNC_ONLY, as do SendMessageCallback and PostMessage to
HWND_BROADCAST (tests/notify-broadcast.c on Windows 7 SP1). The
taskbar's properties broadcast WM_SETTINGCHANGE "TraySettings" this way
after writing the settings, and the taskbar then reads them again (a
WH_CALLWNDPROC hook in Windows 7's explorer).
Wine before: refused the broadcast, so the taskbar kept its size and
buttons until the shell started again.
Change: SendNotifyMessage to HWND_BROADCAST packs these two messages'
strings for the receiving threads (an ANSI string is sent converted to
Unicode, which the receivers can read); the broadcast to each window no
longer goes through the per-window check; a notify message's string is
copied for the window procedure as one from another process (a 32-bit
window procedure could not reach Wine's buffer and got an empty string).
Evidence: tests/notify-broadcast.c gives Windows 7's results (but the
converted ANSI string); Apply in the taskbar's properties switches
between small and large icons and between combined and labelled
buttons at once.
Scope: all processes (Windows behavior).
---
 dlls/win32u/message.c | 36 ++++++++++++++++++++++++++++++++----
 1 file changed, 32 insertions(+), 4 deletions(-)

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 00cceac..a95aa3f 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2351,7 +2351,10 @@ static LRESULT call_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lpar
 
     if (!is_current_thread_window( hwnd )) return 0;
 
-    packed_size = user_message_size( hwnd, msg, wparam, lparam, type == MSG_OTHER_PROCESS, ansi, &reply_size );
+    /* A notify message's string (a broadcast WM_SETTINGCHANGE) was unpacked into a buffer of
+     * ours, which a 32-bit window procedure cannot reach: copy it as from another process. */
+    packed_size = user_message_size( hwnd, msg, wparam, lparam,
+                                     type == MSG_OTHER_PROCESS || type == MSG_NOTIFY, ansi, &reply_size );
 
     /* first the WH_CALLWNDPROC hook */
     cwp.lParam  = lparam;
@@ -4103,6 +4106,8 @@ static BOOL is_message_broadcastable( UINT msg )
     return msg < WM_USER || msg >= 0xc000;
 }
 
+static BOOL process_message( struct send_message_info *info, DWORD_PTR *res_ptr, BOOL ansi );
+
 /***********************************************************************
  *           broadcast_message
  */
@@ -4133,9 +4138,13 @@ static BOOL broadcast_message( struct send_message_info *info, DWORD_PTR *res_pt
                                       info->flags, info->timeout, TRUE );
                 break;
             case MSG_NOTIFY:
-                NtUserMessageCall( list[i], info->msg, info->wparam, info->lparam,
-                                   0, NtUserSendNotifyMessage, FALSE );
+            {
+                /* not through send_notify_message, which refuses pointers for one window */
+                struct send_message_info notify = *info;
+                notify.hwnd = list[i];
+                process_message( &notify, NULL, FALSE );
                 break;
+            }
             case MSG_CALLBACK:
                 {
                     struct send_message_callback_params params =
@@ -4651,16 +4660,35 @@ LRESULT send_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
     return send_message_timeout( hwnd, msg, wparam, lparam, SMTO_NORMAL, 0, FALSE );
 }
 
+/* Windows 7 takes these with their string in SendNotifyMessage to HWND_BROADCAST (each
+ * receiving thread gets a copy), but not for one window. The Windows 7 taskbar's properties
+ * tell the taskbar to read its settings again this way ("TraySettings"). */
+static BOOL is_broadcast_string_message( HWND hwnd, UINT msg )
+{
+    return is_broadcast( hwnd ) && (msg == WM_SETTINGCHANGE || msg == WM_DEVMODECHANGE);
+}
+
 /* see SendNotifyMessageW */
 BOOL send_notify_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, BOOL ansi )
 {
     struct send_message_info info;
 
-    if (is_pointer_message( msg, wparam ))
+    if (is_pointer_message( msg, wparam ) && !is_broadcast_string_message( hwnd, msg ))
     {
         RtlSetLastWin32Error( ERROR_MESSAGE_SYNC_ONLY );
         return FALSE;
     }
+    if (ansi && lparam && is_broadcast_string_message( hwnd, msg ))
+    {
+        /* the copies for other threads are packed as Unicode */
+        WCHAR *str = towstr( (const char *)lparam );
+        BOOL ret;
+
+        if (!str) return FALSE;
+        ret = send_notify_message( hwnd, msg, wparam, (LPARAM)str, FALSE );
+        free( str );
+        return ret;
+    }
 
     info.type    = MSG_NOTIFY;
     info.hwnd    = hwnd;
