From: Codex <codex@localhost>
Subject: [PATCH] winex11: draw XP's drop shadow under CS_DROPSHADOW windows in the external shell

Purpose: show the soft shadow that XP draws under menus, drop-down lists
and the Start panel.
XP behavior: with SPI_GETDROPSHADOW, a five-pixel shadow right of and below a
CS_DROPSHADOW window, composited with a layered window. Its profile,
measured as the ratio between XP's desktop with and without a context menu,
is 0.558, 0.672, 0.832, 0.945, 0.988 across the edge, fading in from five
pixels after the window's start and out past its end. XP's explorer clears
CS_DROPSHADOW on the Start panel's class while showing it and sets it again
right after.
Change: for a top-level popup (no caption, no sizing frame), copy the screen
beneath the shadow strips when the window is mapped, darken it with that
profile and show it in two input-transparent override-redirect windows
mapped just before the window; they go when it is unmapped, moved or
destroyed. A popup mapped while its class lacked the style gets its shadow,
stacked under it, when its position next changes. The darkening is computed
in double so that the 32-bit (x87) and 64-bit (SSE) builds round alike.
A rootless X server (Xwayland in win4wine's Wayland session) cannot read
the root window back; the shadow is then a translucent black 32-bit window
with the same profile as its alpha, which the compositor blends.
Evidence: the ratios under the desktop's context menu equal XP's within 0.005.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0072.
---
 dlls/winex11.drv/window.c | 194 ++++++++++++++++++++++++++++++++++++++++++++++
 dlls/winex11.drv/x11drv.h |   2 +
 2 files changed, 196 insertions(+)

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 6eb70e8..9ad98c8 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1400,6 +1400,192 @@ static void window_set_net_wm_state( struct x11drv_win_data *data, UINT new_stat
     }
 }
 
+/* XP's drop shadow under menus and tooltips (CS_DROPSHADOW), measured on the
+ * reference XP machine: how much of the background it removes across its
+ * five pixels outward from the window edge, how it fades in along the edge
+ * from five pixels after the window's start, and how it fades out past the
+ * window's end. XP composites a layered window; without a compositor the
+ * opted-in external shell darkens a copy of what lies under it when the
+ * window is shown. */
+static const float shadow_edge[5] = { 0.442f, 0.328f, 0.168f, 0.055f, 0.012f };
+static const float shadow_fade[6] = { 0.113f, 0.339f, 0.663f, 0.885f, 0.975f, 1.0f };
+static const float shadow_corner[5] = { 0.882f, 0.665f, 0.337f, 0.118f, 0.018f };
+
+/* popups such as menus, lists and the Start panel; the Start panel is
+ * activated and so managed, but stays where it is put */
+static BOOL may_drop_shadow( struct x11drv_win_data *data )
+{
+    DWORD style = NtUserGetWindowLongW( data->hwnd, GWL_STYLE );
+
+    if (data->embedded || !win4wine_external_shell()) return FALSE;
+    return !(style & (WS_CHILD | WS_THICKFRAME)) && (style & WS_CAPTION) != WS_CAPTION;
+}
+
+static BOOL wants_drop_shadow( struct x11drv_win_data *data )
+{
+    BOOL enabled = FALSE;
+
+    if (!(NtUserGetClassLongW( data->hwnd, GCL_STYLE ) & CS_DROPSHADOW)) return FALSE;
+    NtUserSystemParametersInfo( SPI_GETDROPSHADOW, 0, &enabled, 0 );
+    return enabled;
+}
+
+/* darkness at (i, k) of the right (part 0) or bottom (part 1) shadow, whose
+ * pixel (0, 0) lies at offset 'along' from the start of the shadow strip */
+static double shadow_darkness( int part, int i, int k, int length )
+{
+    int across = part ? k : i, along = part ? i : k;
+    float fade = along < 6 ? shadow_fade[along] : 1.0f;
+
+    if (part == 0 && along >= length - 5) fade = min( fade, shadow_corner[along - (length - 5)] );
+    return (double)shadow_edge[across] * fade;
+}
+
+static int shadow_image_error( Display *display, XErrorEvent *event, void *arg )
+{
+    return 1;
+}
+
+static void stack_and_map_shadow( Display *display, Window window, Window above )
+{
+#ifdef HAVE_LIBXSHAPE
+    XShapeCombineRectangles( display, window, ShapeInput, 0, 0, NULL, 0, ShapeSet, YXBanded );
+#endif
+    if (above)
+    {
+        XWindowChanges changes;
+        changes.sibling = above;
+        changes.stack_mode = Below;
+        XConfigureWindow( display, window, CWSibling | CWStackMode, &changes );
+    }
+    XMapWindow( display, window );
+}
+
+/* A rootless X server (Xwayland) cannot read the root window back; its
+ * compositor blends a translucent black shadow instead. */
+static Window create_alpha_shadow( Display *display, Window above, int part, int x, int y, int width, int height )
+{
+    Window root = DefaultRootWindow( display ), window;
+    XSetWindowAttributes attr;
+    XImage *image;
+    Pixmap pixmap;
+    char *bits;
+    GC gc;
+
+    if (!argb_visual.visualid || width <= 0 || height <= 0) return 0;
+    if (!(bits = malloc( width * height * 4 ))) return 0;
+    image = XCreateImage( display, argb_visual.visual, 32, ZPixmap, 0, bits, width, height, 32, 0 );
+    if (!image)
+    {
+        free( bits );
+        return 0;
+    }
+    for (int k = 0; k < height; k++)
+        for (int i = 0; i < width; i++)
+        {
+            double darkness = shadow_darkness( part, i, k, part ? width : height );
+            XPutPixel( image, i, k, (unsigned long)(darkness * 255 + 0.5) << 24 );
+        }
+    pixmap = XCreatePixmap( display, root, width, height, 32 );
+    gc = XCreateGC( display, pixmap, 0, NULL );
+    XPutImage( display, pixmap, gc, image, 0, 0, 0, 0, width, height );
+    XFreeGC( display, gc );
+    XDestroyImage( image );
+    attr.override_redirect = True;
+    attr.background_pixmap = pixmap;
+    attr.border_pixel = 0;
+    attr.colormap = XCreateColormap( display, root, argb_visual.visual, AllocNone );
+    window = XCreateWindow( display, root, x, y, width, height, 0, 32, InputOutput, argb_visual.visual,
+                            CWOverrideRedirect | CWBackPixmap | CWBorderPixel | CWColormap, &attr );
+    XFreeColormap( display, attr.colormap );
+    XFreePixmap( display, pixmap );
+    stack_and_map_shadow( display, window, above );
+    return window;
+}
+
+static Window create_shadow( Display *display, Window above, int part, int x, int y, int width, int height )
+{
+    Window root = DefaultRootWindow( display ), window;
+    int screen = DefaultScreen( display ), cx, cy, left = x, top = y;
+    XSetWindowAttributes attr;
+    XImage *image;
+    Pixmap pixmap;
+    GC gc;
+
+    /* only the part on the screen can be read back */
+    cx = min( x + width, DisplayWidth( display, screen ) ) - max( x, 0 );
+    cy = min( y + height, DisplayHeight( display, screen ) ) - max( y, 0 );
+    if (cx <= 0 || cy <= 0) return 0;
+    x = max( x, 0 );
+    y = max( y, 0 );
+    X11DRV_expect_error( display, shadow_image_error, NULL );
+    image = XGetImage( display, root, x, y, cx, cy, AllPlanes, ZPixmap );
+    if (X11DRV_check_error() || !image)
+    {
+        if (image) XDestroyImage( image );
+        return create_alpha_shadow( display, above, part, left, top, width, height );
+    }
+    if (image->bits_per_pixel != 32 || image->red_mask != 0xff0000 || image->green_mask != 0xff00 ||
+        image->blue_mask != 0xff)
+    {
+        XDestroyImage( image );
+        return 0;
+    }
+    for (int k = 0; k < cy; k++)
+        for (int i = 0; i < cx; i++)
+        {
+            unsigned long pixel = XGetPixel( image, i, k );
+            /* in double: 32-bit (x87) and 64-bit builds then round alike */
+            double keep = 1.0 - shadow_darkness( part, i + x - left, k + y - top, part ? width : height );
+            unsigned int r = ((pixel >> 16) & 0xff) * keep, g = ((pixel >> 8) & 0xff) * keep, b = (pixel & 0xff) * keep;
+            XPutPixel( image, i, k, (pixel & ~0xffffffUL) | (r << 16) | (g << 8) | b );
+        }
+    pixmap = XCreatePixmap( display, root, cx, cy, image->depth );
+    gc = XCreateGC( display, pixmap, 0, NULL );
+    XPutImage( display, pixmap, gc, image, 0, 0, 0, 0, cx, cy );
+    XFreeGC( display, gc );
+    XDestroyImage( image );
+    attr.override_redirect = True;
+    attr.background_pixmap = pixmap;
+    window = XCreateWindow( display, root, x, y, cx, cy, 0, DefaultDepth( display, screen ), InputOutput,
+                            DefaultVisual( display, screen ), CWOverrideRedirect | CWBackPixmap, &attr );
+    XFreePixmap( display, pixmap );
+    stack_and_map_shadow( display, window, above );
+    return window;
+}
+
+static void destroy_drop_shadow( struct x11drv_win_data *data )
+{
+    for (int i = 0; i < 2; i++)
+    {
+        if (data->shadows[i]) XDestroyWindow( data->display, data->shadows[i] );
+        data->shadows[i] = 0;
+    }
+    data->shadow_pending = FALSE;
+}
+
+/* 'above' is the already mapped window to stack the shadow under, if any */
+static void create_drop_shadow( struct x11drv_win_data *data, Window above )
+{
+    RECT rect = data->rects.visible;
+    POINT pos;
+
+    destroy_drop_shadow( data );
+    if (!may_drop_shadow( data )) return;
+    if (!wants_drop_shadow( data ))
+    {
+        /* XP's Start panel clears CS_DROPSHADOW while it is shown and sets it
+         * again right after; the shadow then follows, unless it moves first */
+        data->shadow_pending = TRUE;
+        return;
+    }
+    pos = virtual_screen_to_root( rect.left, rect.top );
+    OffsetRect( &rect, pos.x - rect.left, pos.y - rect.top );
+    data->shadows[0] = create_shadow( data->display, above, 0, rect.right, rect.top + 5, 5, rect.bottom - rect.top );
+    data->shadows[1] = create_shadow( data->display, above, 1, rect.left + 5, rect.bottom,
+                                      rect.right - rect.left - 5, 5 );
+}
+
 static void window_set_config( struct x11drv_win_data *data, RECT rect, BOOL above )
 {
     UINT style = NtUserGetWindowLongW( data->hwnd, GWL_STYLE ), mask = 0;
@@ -1425,6 +1611,8 @@ static void window_set_config( struct x11drv_win_data *data, RECT rect, BOOL abo
     data->desired_state.above = above;
     if (!data->whole_window) return; /* no window, nothing to update */
     if (EqualRect( old_rect, new_rect ) && (old_above || !above || data->managed)) return; /* rects are the same, no need to be raised, nothing to update */
+    /* a shadow copies what was under the window where it was shown */
+    if (!EqualRect( old_rect, new_rect )) destroy_drop_shadow( data );
     if (window_needs_config_change_delay( data ))
     {
         TRACE( "window %p/%lx is updating _NET_WM_STATE/_MOTIF_WM_HINTS, delaying request\n", data->hwnd, data->whole_window );
@@ -1630,11 +1818,13 @@ static void window_set_wm_state( struct x11drv_win_data *data, UINT new_state, B
     case MAKELONG(WithdrawnState, IconicState):
     case MAKELONG(WithdrawnState, NormalState):
     case MAKELONG(IconicState, NormalState):
+        if (new_state == NormalState) create_drop_shadow( data, 0 );
         if (data->embedded) set_xembed_flags( data, XEMBED_MAPPED );
         else XMapWindow( data->display, data->whole_window );
         break;
     case MAKELONG(NormalState, WithdrawnState):
     case MAKELONG(IconicState, WithdrawnState):
+        destroy_drop_shadow( data );
         if (data->embedded) set_xembed_flags( data, 0 );
         else if (!data->managed) XUnmapWindow( data->display, data->whole_window );
         else XWithdrawWindow( data->display, data->whole_window, data->vis.screen );
@@ -2645,6 +2835,7 @@ void X11DRV_DestroyWindow( HWND hwnd )
 
     if (!(data = get_win_data( hwnd ))) return;
 
+    destroy_drop_shadow( data );
     destroy_whole_window( data, FALSE );
     if (thread_data->last_focus == hwnd) thread_data->last_focus = 0;
     if (thread_data->last_xic_hwnd == hwnd) thread_data->last_xic_hwnd = 0;
@@ -3356,6 +3547,9 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
         update_net_wm_states( data );
     }
 
+    if (data->shadow_pending && (new_style & WS_VISIBLE) && data->whole_window)
+        create_drop_shadow( data, data->whole_window );
+
     /* if window was fullscreen and is being hidden, release cursor clipping */
     was_fullscreen &= data->desired_state.wm_state != NormalState;
 
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index b6cb5d7..d7cfed8 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -695,6 +695,8 @@ struct x11drv_win_data
     unsigned long configure_serial;    /* serial of last pending configure request */
     unsigned long net_wm_icon_serial;  /* serial of last pending _NET_WM_ICON request */
     BOOL preserve_no_redraw;          /* opt-in popup shown without redrawing */
+    Window shadows[2];                /* opt-in drop shadow windows, right and bottom */
+    BOOL shadow_pending;              /* mapped before its class asked for the shadow */
     RECT no_redraw_rect;              /* pending raw visible rectangle */
 };
 
