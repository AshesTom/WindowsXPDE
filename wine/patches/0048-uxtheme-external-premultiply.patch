From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: premultiply theme images like XP in the external shell

Purpose: give theme images with alpha XP's exact colours.
XP behavior: colour * alpha / 255, truncated; AlphaBlend itself gives XP's
results in Wine (tests/alpha-blend.c).
Wine before: colour * (alpha + 1) >> 8, one higher for some pixels: drawn
onto black, 90 of 1331 pixels of Luna's radio button, check box, push button
and close button differed by one (tests/part-black.c), as did the soft
corners of caption buttons on screen.
Change: XP's rounding.
Evidence: tests/part-black.c equals the reference XP machine's output.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0070.
---
 dlls/uxtheme/msstyles.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/dlls/uxtheme/msstyles.c b/dlls/uxtheme/msstyles.c
index 9b81064..0726c68 100644
--- a/dlls/uxtheme/msstyles.c
+++ b/dlls/uxtheme/msstyles.c
@@ -34,6 +34,7 @@
 
 #include "wine/exception.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(uxtheme);
 
@@ -1297,7 +1298,19 @@ static BOOL prepare_alpha (HBITMAP bmp, BOOL* hasAlpha, BOOL *hasDefaultTranspar
 
     p = dib.dsBm.bmBits;
     n = dib.dsBmih.biHeight * dib.dsBmih.biWidth;
-    /* AlphaBlend() wants premultiplied alpha, so do that now */
+    /* AlphaBlend() wants premultiplied alpha, so do that now. XP truncates
+     * colour * alpha / 255; the external shell matches its pixels. */
+    if (win4wine_external_shell())
+    {
+        while (n-- > 0)
+        {
+            p[0] = p[0] * p[3] / 255;
+            p[1] = p[1] * p[3] / 255;
+            p[2] = p[2] * p[3] / 255;
+            p += 4;
+        }
+        return TRUE;
+    }
     while (n-- > 0)
     {
         int a = p[3]+1;
