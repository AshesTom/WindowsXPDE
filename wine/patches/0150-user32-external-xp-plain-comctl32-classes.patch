From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] user32: keep plain common control class names for XP's comctl32 beside the program

Purpose: Internet Explorer 6 (iexplore.exe with XP's comctl32 beside it)
gets its menu bar, toolbars, address bar and status bar.
Windows behavior: a module's manifest redirects common control class names
to the version of comctl32 it names, which registers them under that name.
Wine before: browseui's manifest made it create "6.0.2600.2982!ReBarWindow32"
(Wine's assembly) while the comctl32 in use was XP's, loaded from beside the
program (win4wine patch 0022 and
0149): it registers plain names and has no
RegisterClassNameW, so the rebar and status bar could not be created and IE's
window was empty.
Change: in the XP shell's session, with a comctl32.dll beside the
program, common control class names are not redirected.
Scope: processes of the XP shell's session with comctl32 beside their exe
(ReactOS's beside ros-explorer.exe is left to 0143).
---
 dlls/user32/class.c | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/dlls/user32/class.c b/dlls/user32/class.c
index 910fb33..710f628 100644
--- a/dlls/user32/class.c
+++ b/dlls/user32/class.c
@@ -189,6 +189,42 @@ static ULONG_PTR set_menu_nameA( HWND hwnd, INT offset, ULONG_PTR newval )
     return 0;
 }
 
+/* XP's comctl32 loaded from beside the program (Wine patch 0149) registers its
+ * classes without a version and has no RegisterClassNameW. As there, programs
+ * in the system directories are not beside it, nor is Wine's own file. */
+static BOOL shell_comctl32_beside_exe(void)
+{
+    static int beside = -1;
+    if (beside == -1)
+    {
+        static const char signature[] = "Wine builtin DLL";
+        WCHAR path[MAX_PATH], system[MAX_PATH], *slash;
+        DWORD length = GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) - 13 );
+        beside = 0;
+        if (win4wine_shell() == WIN4WINE_SHELL_XP && length && length < ARRAY_SIZE(path) - 13 &&
+            (slash = wcsrchr( path, '\\' )))
+        {
+            char header[0x40 + sizeof(signature)];
+            DWORD read;
+            HANDLE file;
+            *slash = 0;
+            if ((GetSystemDirectoryW( system, ARRAY_SIZE(system) ) && !wcsicmp( path, system )) ||
+                (GetSystemWow64DirectoryW( system, ARRAY_SIZE(system) ) && !wcsicmp( path, system )))
+                return FALSE;
+            lstrcpyW( slash, L"\\comctl32.dll" );
+            file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, 0 );
+            if (file != INVALID_HANDLE_VALUE)
+            {
+                if (ReadFile( file, header, sizeof(header), &read, NULL ) && read == sizeof(header) &&
+                    header[0] == 'M' && header[1] == 'Z')
+                    beside = memcmp( header + 0x40, signature, sizeof(signature) - 1 ) != 0;
+                CloseHandle( file );
+            }
+        }
+    }
+    return beside;
+}
+
 void get_class_version( UNICODE_STRING *name, UNICODE_STRING *version, BOOL load )
 {
     ACTCTX_SECTION_KEYED_DATA data = {.cbSize = sizeof(data)};
@@ -198,6 +234,9 @@ void get_class_version( UNICODE_STRING *name, UNICODE_STRING *version, BOOL load
     memset( version, 0, sizeof(*version) );
 
     if (IS_INTRESOURCE( name->Buffer ) || is_builtin_class( name->Buffer )) return;
+    /* A module's manifest would name Wine's versioned common controls, which
+     * XP's copy beside the program does not register: keep the plain name. */
+    if (is_comctl32_class( name->Buffer ) && shell_comctl32_beside_exe()) return;
 
     if (!RtlFindActivationContextSectionString( 0, NULL, ACTIVATION_CONTEXT_SECTION_WINDOW_CLASS_REDIRECTION, name, &data ))
     {
