From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: add DrawThemeParentBackgroundEx

Purpose: let Windows 7's comctl32 draw its controls' backgrounds.
Windows behavior: DrawThemeParentBackgroundEx(hwnd, hdc, flags, rect)
has the parent paint the child's background as DrawThemeParentBackground
does; with DTPB_USECTLCOLORSTATIC it fills with the parent's
WM_CTLCOLORSTATIC brush.
Wine before: missing; Windows 7's comctl32 called it in programs of the
Windows 7 shell session and the process ended.
Change: implement it on top of DrawThemeParentBackground; add the DTPB_
flags and the declaration to uxtheme.h.
Evidence: the folder window and the file dialogs of the Windows 7 shell
session no longer end at it.
Scope: a new export.
---
 dlls/uxtheme/draw.c       | 28 ++++++++++++++++++++++++++++
 dlls/uxtheme/uxtheme.spec |  1 +
 include/uxtheme.h         |  6 ++++++
 3 files changed, 35 insertions(+)

diff --git a/dlls/uxtheme/draw.c b/dlls/uxtheme/draw.c
index 5551cce..e87bfcf 100644
--- a/dlls/uxtheme/draw.c
+++ b/dlls/uxtheme/draw.c
@@ -194,6 +194,34 @@ HRESULT WINAPI DrawThemeParentBackground(HWND hwnd, HDC hdc, RECT *prc)
 }
 
 
+/***********************************************************************
+ *      DrawThemeParentBackgroundEx                         (UXTHEME.@)
+ *
+ * Windows 7's comctl32 calls it. DTPB_USECTLCOLORSTATIC fills with the brush
+ * that the parent gives for WM_CTLCOLORSTATIC; otherwise the parent paints as
+ * for DrawThemeParentBackground (DTPB_WINDOWDC and DTPB_USEERASEBKGND are the
+ * ways it already uses).
+ */
+HRESULT WINAPI DrawThemeParentBackgroundEx(HWND hwnd, HDC hdc, DWORD flags, const RECT *prc)
+{
+    RECT rect;
+    HBRUSH brush;
+
+    TRACE("(%p,%p,%#lx,%p)\n", hwnd, hdc, flags, prc);
+    if (flags & DTPB_USECTLCOLORSTATIC)
+    {
+        HWND parent = GetParent(hwnd) ? GetParent(hwnd) : hwnd;
+        if ((brush = (HBRUSH)SendMessageW(parent, WM_CTLCOLORSTATIC, (WPARAM)hdc, (LPARAM)hwnd)))
+        {
+            if (prc) rect = *prc;
+            else GetClientRect(hwnd, &rect);
+            FillRect(hdc, &rect, brush);
+            return S_OK;
+        }
+    }
+    return DrawThemeParentBackground(hwnd, hdc, (RECT *)prc);
+}
+
 /***********************************************************************
  *      DrawThemeBackground                                 (UXTHEME.@)
  */
diff --git a/dlls/uxtheme/uxtheme.spec b/dlls/uxtheme/uxtheme.spec
index 7a56efb..4a24104 100644
--- a/dlls/uxtheme/uxtheme.spec
+++ b/dlls/uxtheme/uxtheme.spec
@@ -66,6 +66,7 @@
 @ stdcall DrawThemeEdge(ptr ptr long long ptr long long ptr)
 @ stdcall DrawThemeIcon(ptr ptr long long ptr ptr long)
 @ stdcall DrawThemeParentBackground(ptr ptr ptr)
+@ stdcall DrawThemeParentBackgroundEx(ptr ptr long ptr)
 @ stdcall DrawThemeText(ptr ptr long long wstr long long long ptr)
 @ stdcall DrawThemeTextEx(ptr ptr long long wstr long long ptr ptr)
 @ stdcall EnableThemeDialogTexture(ptr long)
diff --git a/include/uxtheme.h b/include/uxtheme.h
index 2df94e9..508362b 100644
--- a/include/uxtheme.h
+++ b/include/uxtheme.h
@@ -55,6 +55,12 @@ THEMEAPI DrawThemeBackgroundEx(HTHEME,HDC,int,int,const RECT*, const DTBGOPTS*);
 THEMEAPI DrawThemeEdge(HTHEME,HDC,int,int,const RECT*,UINT,UINT, RECT*);
 THEMEAPI DrawThemeIcon(HTHEME,HDC,int,int,const RECT*,HIMAGELIST,int);
 THEMEAPI DrawThemeParentBackground(HWND,HDC,RECT*);
+
+#define DTPB_WINDOWDC           0x00000001
+#define DTPB_USECTLCOLORSTATIC  0x00000002
+#define DTPB_USEERASEBKGND      0x00000004
+
+THEMEAPI DrawThemeParentBackgroundEx(HWND,HDC,DWORD,const RECT*);
 THEMEAPI DrawThemeText(HTHEME,HDC,int,int,LPCWSTR,int,DWORD,DWORD, const RECT*);
 
 #define DTT_GRAYED      0x1
