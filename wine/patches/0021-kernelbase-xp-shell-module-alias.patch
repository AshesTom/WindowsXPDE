From: Codex <codex@localhost>
Subject: [PATCH] kernelbase: resolve explorer.exe to the renamed XP shell module

Purpose: let the renamed XP shell find its own executable module.
XP behavior: shell components call GetModuleHandleW("explorer.exe") to get
the shell module. Our executable is named xp-explorer.exe so that its native
DLL overrides stay apart from Wine's desktop manager and recovery shell, and
execution logs showed the original name failing with DLL_NOT_FOUND.
Change: in a process with the opt-in, resolve the bare name explorer.exe to
the main module, keeping the normal reference count and flags.
Scope: only with WIN4WINE_EXTERNAL_SHELL; project-specific, not a general
Wine fix.
Old patches: 0007.
---
 dlls/kernelbase/loader.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dlls/kernelbase/loader.c b/dlls/kernelbase/loader.c
index f6347c1..d00acff 100644
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -34,6 +34,7 @@
 #include "wine/asm.h"
 #include "wine/debug.h"
 #include "wine/exception.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(module);
 
@@ -395,6 +396,19 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetModuleHandleExW( DWORD flags, LPCWSTR name, HMO
         return FALSE;
     }
 
+    /* The opt-in XP shell is renamed to isolate its native DLL overrides. */
+    if (name && !(flags & GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS)
+        && !wcsicmp( name, L"explorer.exe" )
+        && win4wine_external_shell())
+    {
+        WCHAR path[MAX_PATH], *basename;
+
+        if (GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) )
+            && (basename = wcsrchr( path, '\\' ))
+            && !wcsicmp( basename + 1, L"xp-explorer.exe" ))
+            name = NULL;
+    }
+
     if (name && !(flags & GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS))
     {
         UNICODE_STRING wstr;
