From: Codex <codex@localhost>
Subject: [PATCH] uxtheme: keep the sign of negative theme margins

Purpose: size and draw ReactOS's themed Start button as ReactOS does.
ReactOS behavior: Lautus, Lunar and Mizu give the Start button negative
content margins (Lautus: ContentMargins = -82, 95, 1, 1); ReactOS's
GetThemeMargins returns -82, and the button's BCM_GETIDEALSIZE is 38x20
with explorer's 16x16 image (a probe on ReactOS 0.4.16).
Wine before: MSSTYLES_GetNextLong skips the minus sign along with the
other separators, so every theme number was read as positive: the margins
became 82, 95, the ideal size 202x20, and the Start button showed its
image twice over a 200-pixel area.
Change: read margins properties with their sign. Other properties keep the
existing parsing, so XP's Luna (whose negative numbers are caption button
offsets, read elsewhere) is unchanged; Luna has no negative margins.
Evidence: the same probe under Wine returns ReactOS's values.
Scope: all processes; only themes with negative margins are affected.
---
 dlls/uxtheme/msstyles.c | 28 ++++++++++++++++++++++++----
 1 file changed, 24 insertions(+), 4 deletions(-)

diff --git a/dlls/uxtheme/msstyles.c b/dlls/uxtheme/msstyles.c
index 1b469c2..d58e93e 100644
--- a/dlls/uxtheme/msstyles.c
+++ b/dlls/uxtheme/msstyles.c
@@ -1832,6 +1832,26 @@ HRESULT MSSTYLES_GetPropertyRect(PTHEME_PROPERTY tp, RECT *pRect)
     return S_OK;
 }
 
+/* Like MSSTYLES_GetNextInteger, but keeps a minus sign: margins may be
+ * negative (ReactOS's Lautus, Lunar and Mizu use negative content margins). */
+static BOOL MSSTYLES_GetNextSignedInteger(LPCWSTR lpStringStart, LPCWSTR lpStringEnd, LPCWSTR *lpValEnd, int *value)
+{
+    LPCWSTR cur = lpStringStart;
+    BOOL negative = FALSE;
+    int total = 0;
+
+    while(cur < lpStringEnd && (*cur < '0' || *cur > '9') && *cur != '-') cur++;
+    if(cur < lpStringEnd && *cur == '-') {
+        negative = TRUE;
+        cur++;
+    }
+    if(cur >= lpStringEnd || *cur < '0' || *cur > '9') return FALSE;
+    while(cur < lpStringEnd && *cur >= '0' && *cur <= '9') total = total * 10 + (*cur++ - '0');
+    *value = negative ? -total : total;
+    if(lpValEnd) *lpValEnd = cur;
+    return TRUE;
+}
+
 /***********************************************************************
  *      MSSTYLES_GetPropertyMargins
  *
@@ -1842,10 +1862,10 @@ HRESULT MSSTYLES_GetPropertyMargins(PTHEME_PROPERTY tp, RECT *prc, MARGINS *pMar
     LPCWSTR lpCur = tp->lpValue;
     LPCWSTR lpEnd = tp->lpValue + tp->dwValueLen;
 
-    MSSTYLES_GetNextInteger(lpCur, lpEnd, &lpCur, &pMargins->cxLeftWidth);
-    MSSTYLES_GetNextInteger(lpCur, lpEnd, &lpCur, &pMargins->cxRightWidth);
-    MSSTYLES_GetNextInteger(lpCur, lpEnd, &lpCur, &pMargins->cyTopHeight);
-    if(!MSSTYLES_GetNextInteger(lpCur, lpEnd, &lpCur, &pMargins->cyBottomHeight)) {
+    MSSTYLES_GetNextSignedInteger(lpCur, lpEnd, &lpCur, &pMargins->cxLeftWidth);
+    MSSTYLES_GetNextSignedInteger(lpCur, lpEnd, &lpCur, &pMargins->cxRightWidth);
+    MSSTYLES_GetNextSignedInteger(lpCur, lpEnd, &lpCur, &pMargins->cyTopHeight);
+    if(!MSSTYLES_GetNextSignedInteger(lpCur, lpEnd, &lpCur, &pMargins->cyBottomHeight)) {
         TRACE("Could not parse margins property\n");
         return E_PROP_ID_UNSUPPORTED;
     }
