From: Codex <codex@localhost>
Subject: [PATCH] user32: measure classic push buttons for the external shell

Purpose: give the classic XP Start button a non-zero preferred size.
XP behavior: explorer subclasses the unversioned Button class and sends
BCM_GETIDEALSIZE.
Wine before: user32's Button returned FALSE and left the SIZE at zero, which
collapsed the taskbar.
Change: for push buttons, return the text size in the selected font with
DPI-scaled padding.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0008.
---
 dlls/user32/button.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/dlls/user32/button.c b/dlls/user32/button.c
index f4dbec7..acda183 100644
--- a/dlls/user32/button.c
+++ b/dlls/user32/button.c
@@ -41,7 +41,9 @@
 
 #include "user_private.h"
 #include "controls.h"
+#include "commctrl.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(button);
 
@@ -174,6 +176,33 @@ LRESULT ButtonWndProc_common(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam,
 
     switch (uMsg)
     {
+    case BCM_GETIDEALSIZE:
+    {
+        SIZE *size = (SIZE *)lParam;
+        WCHAR *text;
+        HFONT old_font, font;
+        HDC dc;
+        RECT bounds = {0};
+        UINT dpi;
+
+        /* XP's classic shell uses this on the unversioned Button class. */
+        if (!win4wine_external_shell()
+            || !size || (btn_type != BS_PUSHBUTTON && btn_type != BS_DEFPUSHBUTTON))
+            return FALSE;
+        if (!(text = get_button_text( hWnd ))) return FALSE;
+        dc = NtUserGetDC( hWnd );
+        font = get_button_font( hWnd );
+        old_font = font ? SelectObject( dc, font ) : NULL;
+        DrawTextW( dc, text, -1, &bounds, DT_CALCRECT | DT_SINGLELINE );
+        dpi = GetDeviceCaps( dc, LOGPIXELSX );
+        size->cx = bounds.right + MulDiv( 12, dpi, 96 );
+        size->cy = bounds.bottom + MulDiv( 8, dpi, 96 );
+        if (old_font) SelectObject( dc, old_font );
+        NtUserReleaseDC( hWnd, dc );
+        HeapFree( GetProcessHeap(), 0, text );
+        return TRUE;
+    }
+
     case WM_GETDLGCODE:
         switch(btn_type)
         {
