From: Codex <codex@localhost>
Subject: [PATCH] user32: XP's system icons in the XP shell session

Purpose: show XP's application, error, warning, question and information
icons in the XP shell session, as patch 0132 does for Windows 7.
Windows behavior: XP's user32.dll holds them as icon groups 100 to 105; a
class's small icon made from IDI_APPLICATION is its 32x32 image scaled
down by picking pixels (compared with xpcmp.exe's caption on the reference
XP machine).
Wine before: Wine's own icons, scaled down by blending.
Change: in the XP shell session, the system icons come from XP's
user32.dll, which the prefix keeps as data in C:\xp\res\user32-xp.dll
(prefix/stage.py), and icons are scaled down as 0132 does.
Evidence: xpcmp.exe's caption icon is pixel-identical to XP's; message
boxes show XP's icons.
Scope: the XP shell session (WIN4WINE_EXTERNAL_SHELL, no WIN4WINE_SHELL).
---
 dlls/user32/cursoricon.c | 68 +++++++++++++++++++++++++-----------------------
 1 file changed, 36 insertions(+), 32 deletions(-)

diff --git a/dlls/user32/cursoricon.c b/dlls/user32/cursoricon.c
index 7ee1c47..6ffa92d 100644
--- a/dlls/user32/cursoricon.c
+++ b/dlls/user32/cursoricon.c
@@ -1369,18 +1369,18 @@ static HICON CURSORICON_Load(HINSTANCE hInstance, LPCWSTR name,
                              INT width, INT height, INT depth,
                              BOOL fCursor, UINT loadflags);
 
-/* The Windows 7 shell session's system icons (IDI_APPLICATION to IDI_SHIELD)
- * are Windows 7's: its user32.dll, which the prefix keeps as data in
- * C:\w7\res\user32-w7.dll (a data file named user32.dll would be taken for
- * the loaded user32), holds them as icons 100 to 106. Shared ones are kept
- * here, as Wine cannot name a data file's module for its own cache (so
- * LR_COPYFROMRESOURCE scales them, as Windows 7 does for a class's small
- * icon). */
-static struct { WORD id; INT width, height, depth; HICON icon; } win7_icons[32];
-static unsigned int win7_icon_count;
-static HMODULE win7_icon_module;
-
-static HICON win7_system_icon( LPCWSTR name, INT width, INT height, INT depth, UINT loadflags )
+/* The system icons (IDI_APPLICATION to IDI_SHIELD) of the Windows 7 and XP
+ * shell sessions are those of their user32.dll, which the prefix keeps as
+ * data in C:\w7\res\user32-w7.dll and C:\xp\res\user32-xp.dll (a data file
+ * named user32.dll would be taken for the loaded user32), as icons 100 to 106
+ * (XP's to 105). Shared ones are kept here, as Wine cannot name a data file's
+ * module for its own cache (so LR_COPYFROMRESOURCE scales them, as Windows
+ * does for a class's small icon). */
+static struct { WORD id; INT width, height, depth; HICON icon; } shell_icons[32];
+static unsigned int shell_icon_count;
+static HMODULE shell_icon_module;
+
+static HICON shell_system_icon( LPCWSTR name, INT width, INT height, INT depth, UINT loadflags )
 {
     /* IDI_APPLICATION, IDI_HAND, IDI_QUESTION, IDI_EXCLAMATION, IDI_ASTERISK, IDI_WINLOGO, IDI_SHIELD */
     static const WORD ids[] = { 100, 103, 102, 101, 104, 105, 106 };
@@ -1391,29 +1391,31 @@ static HICON win7_system_icon( LPCWSTR name, INT width, INT height, INT depth, U
 
     if (!IS_INTRESOURCE( name ) || LOWORD( name ) < LOWORD( IDI_APPLICATION ) || LOWORD( name ) > LOWORD( IDI_SHIELD ))
         return 0;
-    if (win4wine_shell() != WIN4WINE_SHELL_WIN7) return 0;
     if (!tried)
     {
+        const WCHAR *path = NULL;
         tried = TRUE;
-        win7_icon_module = LoadLibraryExW( L"C:\\w7\\res\\user32-w7.dll", NULL,
-                                           LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE );
+        if (win4wine_shell() == WIN4WINE_SHELL_WIN7) path = L"C:\\w7\\res\\user32-w7.dll";
+        else if (win4wine_shell() == WIN4WINE_SHELL_XP) path = L"C:\\xp\\res\\user32-xp.dll";
+        if (path)
+            shell_icon_module = LoadLibraryExW( path, NULL, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE );
     }
-    if (!win7_icon_module) return 0;
+    if (!shell_icon_module) return 0;
     id = ids[LOWORD( name ) - LOWORD( IDI_APPLICATION )];
     if (loadflags & LR_SHARED)
-        for (i = 0; i < win7_icon_count; i++)
-            if (win7_icons[i].id == id && win7_icons[i].width == width && win7_icons[i].height == height &&
-                win7_icons[i].depth == depth)
-                return win7_icons[i].icon;
-    if (!(icon = CURSORICON_Load( win7_icon_module, MAKEINTRESOURCEW( id ), width, height, depth, FALSE, loadflags )))
+        for (i = 0; i < shell_icon_count; i++)
+            if (shell_icons[i].id == id && shell_icons[i].width == width && shell_icons[i].height == height &&
+                shell_icons[i].depth == depth)
+                return shell_icons[i].icon;
+    if (!(icon = CURSORICON_Load( shell_icon_module, MAKEINTRESOURCEW( id ), width, height, depth, FALSE, loadflags )))
         return 0;
-    if ((loadflags & LR_SHARED) && win7_icon_count < ARRAY_SIZE(win7_icons))
+    if ((loadflags & LR_SHARED) && shell_icon_count < ARRAY_SIZE(shell_icons))
     {
-        win7_icons[win7_icon_count].id = id;
-        win7_icons[win7_icon_count].width = width;
-        win7_icons[win7_icon_count].height = height;
-        win7_icons[win7_icon_count].depth = depth;
-        win7_icons[win7_icon_count++].icon = icon;
+        shell_icons[shell_icon_count].id = id;
+        shell_icons[shell_icon_count].width = width;
+        shell_icons[shell_icon_count].height = height;
+        shell_icons[shell_icon_count].depth = depth;
+        shell_icons[shell_icon_count++].icon = icon;
     }
     return icon;
 }
@@ -1443,7 +1445,7 @@ static HICON CURSORICON_Load(HINSTANCE hInstance, LPCWSTR name,
     if ((loadflags & LR_LOADFROMFILE) && get_app_version() >= 0x4000)    /* Load from file */
         return CURSORICON_LoadFromFile( name, width, height, depth, fCursor, loadflags );
 
-    if (!hInstance && !fCursor && (hIcon = win7_system_icon( name, width, height, depth, loadflags )))
+    if (!hInstance && !fCursor && (hIcon = shell_system_icon( name, width, height, depth, loadflags )))
         return hIcon;
     if (!hInstance) hInstance = user32_module;  /* Load OEM cursor/icon */
 
@@ -2260,13 +2262,15 @@ HANDLE WINAPI LoadImageW( HINSTANCE hinst, LPCWSTR name, UINT type,
 static void stretch_bitmap( HBITMAP dst, HBITMAP src, int dst_width, int dst_height, int src_width, int src_height )
 {
     HDC src_dc = CreateCompatibleDC( 0 ), dst_dc = CreateCompatibleDC( 0 );
+    enum win4wine_shell shell = win4wine_shell();
 
     SelectObject( src_dc, src );
     SelectObject( dst_dc, dst );
-    /* Windows 7 SP1 picks pixels when it scales an icon down, counting rows
-     * from the bottom (a class's small icon from IDI_APPLICATION, compared
-     * with a screenshot) */
-    if (win4wine_shell() == WIN4WINE_SHELL_WIN7 && src_width >= dst_width && src_height >= dst_height)
+    /* Windows 7 SP1 and XP SP3 pick pixels when they scale an icon down,
+     * counting rows from the bottom (a class's small icon from
+     * IDI_APPLICATION, compared with screenshots) */
+    if ((shell == WIN4WINE_SHELL_WIN7 || shell == WIN4WINE_SHELL_XP) &&
+        src_width >= dst_width && src_height >= dst_height)
     {
         SetStretchBltMode( dst_dc, COLORONCOLOR );
         StretchBlt( dst_dc, 0, 0, dst_width, dst_height, src_dc, 0, src_height / dst_height - 1,
