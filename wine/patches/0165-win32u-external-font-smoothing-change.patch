From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] win32u: apply a new font smoothing setting at once in the external shell

Purpose: choosing ClearType (or standard smoothing, or none) in Display
Properties, Appearance, Effects changes the text of the session's windows
when it is applied, as on XP.
XP behavior: SystemParametersInfo with SPI_SETFONTSMOOTHING,
SPI_SETFONTSMOOTHINGTYPE, SPI_SETFONTSMOOTHINGCONTRAST or
SPI_SETFONTSMOOTHINGORIENTATION applies to every program at once: the
windows are drawn again with the new setting.
Wine before: each process reads the font smoothing settings once, when
its first font is selected (init_font_options). The new setting reached
only the programs started after it: the desktop, the taskbar and the open
windows kept their text until the next logon, and ClearType seemed not to
work.
Change: with the opt-in, a window procedure's WM_SETTINGCHANGE for one of
these settings (the broadcast that SPIF_SENDCHANGE sends) makes its process
read them again; once the broadcast is over, the program that changed them
redraws every top-level window and its children (the server leaves the
desktop's children out of RDW_ALLCHILDREN).
Evidence: in the nested X11 session, tests/cleartype.c "set cleartype"
turned the desktop icons' labels from black and white to ClearType at
once; "set standard" turned them back.
Scope: WIN4WINE_EXTERNAL_SHELL.
---
diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -4743,21 +4743,14 @@
     return !!count;
 }
 
-static UINT init_font_options(void)
+/* The font smoothing settings of Display Properties (Effects), and the
+ * screen's LogPixels from the same key, or 0. */
+static UINT init_font_smoothing(void)
 {
-    char value_buffer[FIELD_OFFSET(KEY_VALUE_PARTIAL_INFORMATION, Data[20 * sizeof(WCHAR)])];
-    KEY_VALUE_PARTIAL_INFORMATION *info = (void *)value_buffer;
     HKEY key;
     DWORD i, val, gamma = 1400;
     UINT dpi = 0;
 
-    if (query_reg_ascii_value( wine_fonts_key, "AntialiasFakeBoldOrItalic",
-                               info, sizeof(value_buffer) ) && info->Type == REG_SZ)
-    {
-        static const WCHAR valsW[] = {'y','Y','t','T','1',0};
-        antialias_fakes = (wcschr( valsW, *(const WCHAR *)info->Data ) != NULL);
-    }
-
     if ((key = reg_open_hkcu_key( "Control Panel\\Desktop" )))
     {
         /* FIXME: handle vertical orientations even though Windows doesn't */
@@ -4808,6 +4801,35 @@
         }
     }
 
+    font_gamma_ramp.gamma = gamma;
+    return dpi;
+}
+
+/* XP applies a new font smoothing setting to every program at once, and
+ * Display Properties broadcasts WM_SETTINGCHANGE for it: read it again. */
+void font_smoothing_changed(void)
+{
+    font_smoothing = GGO_BITMAP;
+    external_cleartype = FALSE;
+    init_font_smoothing();
+}
+
+static UINT init_font_options(void)
+{
+    char value_buffer[FIELD_OFFSET(KEY_VALUE_PARTIAL_INFORMATION, Data[20 * sizeof(WCHAR)])];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (void *)value_buffer;
+    HKEY key;
+    DWORD val;
+    UINT dpi;
+
+    if (query_reg_ascii_value( wine_fonts_key, "AntialiasFakeBoldOrItalic",
+                               info, sizeof(value_buffer) ) && info->Type == REG_SZ)
+    {
+        static const WCHAR valsW[] = {'y','Y','t','T','1',0};
+        antialias_fakes = (wcschr( valsW, *(const WCHAR *)info->Data ) != NULL);
+    }
+
+    dpi = init_font_smoothing();
     if (!dpi && (key = reg_open_key( NULL, fonts_config_keyW, sizeof(fonts_config_keyW) )))
     {
         if (get_key_value( key, "LogPixels", &val )) dpi = val;
@@ -4815,7 +4837,6 @@
     }
     if (!dpi) dpi = 96;
 
-    font_gamma_ramp.gamma = gamma;
     TRACE( "gamma %d screen dpi %u\n", font_gamma_ramp.gamma, dpi );
     return dpi;
 }
diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2380,6 +2380,13 @@
 
     if (!is_current_thread_window( hwnd )) return 0;
 
+    /* Display Properties changed the font smoothing: XP draws every program's
+     * text with the new setting at once. */
+    if (msg == WM_SETTINGCHANGE && win4wine_external_shell() &&
+        (wparam == SPI_SETFONTSMOOTHING || wparam == SPI_SETFONTSMOOTHINGTYPE ||
+         wparam == SPI_SETFONTSMOOTHINGCONTRAST || wparam == SPI_SETFONTSMOOTHINGORIENTATION))
+        font_smoothing_changed();
+
     /* A notify message's string (a broadcast WM_SETTINGCHANGE) was unpacked into a buffer of
      * ours, which a 32-bit window procedure cannot reach: copy it as from another process. */
     packed_size = user_message_size( hwnd, msg, wparam, lparam,
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -6905,8 +6905,26 @@
     {
         static const WCHAR emptyW[1];
         if (winini & (SPIF_SENDWININICHANGE | SPIF_SENDCHANGE))
+        {
             send_message_timeout( HWND_BROADCAST, WM_SETTINGCHANGE, action, (LPARAM) emptyW,
                                   SMTO_ABORTIFHUNG, 2000, FALSE );
+            /* Every window has read the new font smoothing (call_window_proc):
+             * draw them again with it, as XP does when it is applied. The
+             * server leaves the desktop's children out of RDW_ALLCHILDREN. */
+            if (win4wine_external_shell() &&
+                (action == SPI_SETFONTSMOOTHING || action == SPI_SETFONTSMOOTHINGTYPE ||
+                 action == SPI_SETFONTSMOOTHINGCONTRAST || action == SPI_SETFONTSMOOTHINGORIENTATION))
+            {
+                HWND *list;
+                if ((list = list_window_children( 0 )))
+                {
+                    for (int i = 0; list[i]; i++)
+                        NtUserRedrawWindow( list[i], NULL, 0,
+                                            RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+                    free( list );
+                }
+            }
+        }
     }
     TRACE( "(%u, %u, %p, %u) ret %d\n", action, val, ptr, winini, ret );
     return ret;
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -42,6 +42,9 @@
 extern ULONG_PTR get_icon_param( HICON handle );
 extern ULONG_PTR set_icon_param( HICON handle, const struct free_icon_params *params );
 
+/* font.c */
+extern void font_smoothing_changed(void);
+
 /* dce.c */
 extern struct window_surface dummy_surface;
 extern void create_window_surface( HWND hwnd, BOOL create_layered, const RECT *surface_rect, UINT monitor_dpi,
