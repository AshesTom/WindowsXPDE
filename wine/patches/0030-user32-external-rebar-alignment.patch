From: Codex <codex@localhost>
Subject: [PATCH] user32: make the external shell's default ReBar alignment explicit

Purpose: stop the XP folder window's ReBar from starting below its parent's
client area.
Wine before: with the user's native v6 ReBar, alignment bits of zero gave a
36 pixel offset that browseui kept when it resized with SWP_NOMOVE,
clipping the address band; an explicit CCS_TOP starts at y=0
(CreateWindowExW, GetWindowRect and MapWindowPoints probe).
Change: add the documented default CCS_TOP before creating a named child
ReBarWindow32 whose style has no alignment; explicit styles are kept.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0011.
---
 dlls/user32/win.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/dlls/user32/win.c b/dlls/user32/win.c
index cef0bee..fa43b4e 100644
--- a/dlls/user32/win.c
+++ b/dlls/user32/win.c
@@ -22,10 +22,12 @@
 #define WIN32_NO_STATUS
 #include "user_private.h"
 #include "controls.h"
+#include "commctrl.h"
 #include "winver.h"
 #include "wine/asm.h"
 #include "wine/exception.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
 
@@ -308,6 +310,14 @@ HWND WIN_CreateWindowEx( CREATESTRUCTW *cs, LPCWSTR className, HINSTANCE module,
           cs->hwndParent, cs->hMenu, cs->hInstance, cs->lpCreateParams );
     if(TRACE_ON(win)) dump_window_styles( cs->style, cs->dwExStyle );
 
+    /* Native XP rebar initialization with unspecified alignment can move the
+     * control to its original bottom edge before adding CCS_TOP. Give it the
+     * documented default up front in the opt-in external shell. */
+    if (!IS_INTRESOURCE(className) && !wcsicmp(className, L"ReBarWindow32")
+        && (cs->style & WS_CHILD) && !(cs->style & (CCS_TOP | CCS_NOMOVEY))
+        && win4wine_external_shell())
+        cs->style |= CCS_TOP;
+
     /* Fix the styles for MDI children */
     if (cs->dwExStyle & WS_EX_MDICHILD)
     {
