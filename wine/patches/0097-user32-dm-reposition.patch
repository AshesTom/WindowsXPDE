From: Codex <codex@localhost>
Subject: [PATCH] user32: DM_REPOSITION

Purpose: keep dialogs that grow after they are created inside the
work area, such as the Windows 7 taskbar's properties, whose buttons
were under the taskbar.
Windows behavior: DefDlgProc moves a top-level dialog into its
monitor's work area on DM_REPOSITION: the right edge at most at the
work area's right, the bottom at most 4 pixels above its bottom, then
the left and top at least at the work area's, so the top wins when the
dialog is taller (tests/dm-reposition.c on Windows 7 SP1: bottoms 2,
54 and 104 pixels below that limit moved to it, 5 pixels above the work
area's bottom stayed). ReactOS does the same.
Wine before: ignored DM_REPOSITION.
Change: DefDlgProc handles DM_REPOSITION as measured.
Evidence: tests/dm-reposition.c gives Windows 7's results; the
taskbar's properties open above the taskbar, as on Windows 7.
Scope: all processes (Windows behavior).
---
 dlls/user32/defdlg.c | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/dlls/user32/defdlg.c b/dlls/user32/defdlg.c
index 1b50893..fd1a8d1 100644
--- a/dlls/user32/defdlg.c
+++ b/dlls/user32/defdlg.c
@@ -180,6 +180,35 @@ static BOOL DEFDLG_SetDefButton( HWND hwndDlg, DIALOGINFO *dlgInfo, HWND hwndNew
 }
 
 
+/***********************************************************************
+ *           DEFDLG_Reposition
+ *
+ * DM_REPOSITION: move a top-level dialog into its monitor's work area, as
+ * measured on Windows 7: the right edge at most at the work area's right,
+ * the bottom at most 4 pixels above its bottom, then the left and top edges
+ * at least at the work area's (the top wins over the bottom).
+ */
+static void DEFDLG_Reposition( HWND hwnd )
+{
+    MONITORINFO info = { sizeof(info) };
+    RECT rect;
+    int x, y;
+
+    if (GetWindowLongW( hwnd, GWL_STYLE ) & WS_CHILD || IsIconic( hwnd )) return;
+    if (!GetWindowRect( hwnd, &rect ) ||
+        !GetMonitorInfoW( MonitorFromWindow( hwnd, MONITOR_DEFAULTTONEAREST ), &info )) return;
+
+    x = rect.left;
+    y = rect.top;
+    if (rect.right > info.rcWork.right) x = info.rcWork.right - (rect.right - rect.left);
+    if (rect.bottom > info.rcWork.bottom - 4) y = info.rcWork.bottom - 4 - (rect.bottom - rect.top);
+    x = max( x, info.rcWork.left );
+    y = max( y, info.rcWork.top );
+    if (x != rect.left || y != rect.top)
+        NtUserSetWindowPos( hwnd, 0, x, y, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_NOACTIVATE );
+}
+
+
 /***********************************************************************
  *           DEFDLG_Proc
  *
@@ -246,6 +275,10 @@ static LRESULT DEFDLG_Proc( HWND hwnd, UINT msg, WPARAM wParam,
             }
             return 0;
 
+        case DM_REPOSITION:
+            DEFDLG_Reposition( hwnd );
+            return 0;
+
         case WM_NEXTDLGCTL:
             if (dlgInfo)
             {
@@ -335,6 +368,7 @@ static LRESULT USER_DefDlgProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lPar
             case WM_SETFOCUS:
             case DM_SETDEFID:
             case DM_GETDEFID:
+            case DM_REPOSITION:
             case WM_NEXTDLGCTL:
             case WM_GETFONT:
             case WM_CLOSE:
@@ -386,6 +420,7 @@ static LRESULT USER_DefDlgProcW( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lPar
             case WM_SETFOCUS:
             case DM_SETDEFID:
             case DM_GETDEFID:
+            case DM_REPOSITION:
             case WM_NEXTDLGCTL:
             case WM_GETFONT:
             case WM_CLOSE:
