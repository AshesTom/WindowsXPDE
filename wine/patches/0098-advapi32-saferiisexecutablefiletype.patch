From: Codex <codex@localhost>
Subject: [PATCH] advapi32: add SaferiIsExecutableFileType

Purpose: let Windows 7's shell32 open files (ShellExecute).
Windows behavior: SaferiIsExecutableFileType(path, from_shell_execute)
tells whether the file's extension is one of the executable types of the
software restriction policies (HKLM\System\CurrentControlSet\Control\
Srp\GP\CodeIdentifiers ExecutableTypes, else Windows' defaults).
Wine before: missing; Windows 7's ShellExecute called it and the process
ended (the shell's Run box opening H:\plain.txt ended the shell).
Change: implement it with the policy's list, else Windows' default list.
Evidence: Windows 7's Run box opens H:\plain.txt in Notepad.
Scope: a new export.
---
 dlls/advapi32/advapi32.spec |  2 +-
 dlls/advapi32/security.c    | 28 ++++++++++++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/dlls/advapi32/advapi32.spec b/dlls/advapi32/advapi32.spec
index 4a9db82..d8b67d6 100644
--- a/dlls/advapi32/advapi32.spec
+++ b/dlls/advapi32/advapi32.spec
@@ -726,7 +726,7 @@
 # @ stub SaferiChangeRegistryScope
 # @ stub SaferiCompareTokenLevels
 # @ stub SaferiIsDllAllowed
-# @ stub SaferiIsExecutableFileType
+@ stdcall SaferiIsExecutableFileType(wstr long)
 # @ stub SaferiPopulateDefaultsInRegistry
 # @ stub SaferiRecordEventLogEntry
 # @ stub SaferiReplaceProcessThreadTokens
diff --git a/dlls/advapi32/security.c b/dlls/advapi32/security.c
index d9a8b68..b6dca4b 100644
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -3120,6 +3120,34 @@ BOOL WINAPI SaferComputeTokenFromLevel(SAFER_LEVEL_HANDLE handle, HANDLE token,
     return TRUE;
 }
 
+/******************************************************************************
+ * SaferiIsExecutableFileType [ADVAPI32.@]
+ *
+ * Whether PATH names a file of a type that runs code (Windows 7's
+ * ShellExecute asks before it runs a file). The types are those of the
+ * software restriction policies' ExecutableTypes when the registry has
+ * them, else Windows' default list.
+ */
+BOOL WINAPI SaferiIsExecutableFileType(const WCHAR *path, BOOLEAN shell_execute)
+{
+    static const WCHAR defaults[] =
+        L"ADE\0ADP\0BAS\0BAT\0CHM\0CMD\0COM\0CPL\0CRT\0EXE\0HLP\0HTA\0INF\0INS\0ISP\0LNK\0MDB\0"
+        L"MDE\0MSC\0MSI\0MSP\0MST\0OCX\0PCD\0PIF\0REG\0SCR\0SHS\0URL\0VB\0WSC\0";
+    WCHAR types[2048];
+    const WCHAR *ext, *type;
+    DWORD size = sizeof(types);
+
+    TRACE("(%s, %d)\n", debugstr_w(path), shell_execute);
+    if (!path || !(ext = wcsrchr(path, '.')) || wcschr(ext, '\\')) return FALSE;
+    ext++;
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\Srp\\GP\\CodeIdentifiers",
+                     L"ExecutableTypes", RRF_RT_REG_MULTI_SZ, NULL, types, &size))
+        memcpy(types, defaults, sizeof(defaults));
+    for (type = types; *type; type += wcslen(type) + 1)
+        if (!wcsicmp(type, ext)) return TRUE;
+    return FALSE;
+}
+
 /******************************************************************************
  * SaferCloseLevel   [ADVAPI32.@]
  */
