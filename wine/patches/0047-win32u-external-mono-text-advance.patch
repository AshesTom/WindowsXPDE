From: Codex <codex@localhost>
Subject: [PATCH] win32u: use measured advances for external monochrome text

Purpose: lay out non-antialiased text with the same advances as XP.
XP behavior: DrawText, GetTextExtent and ExtTextOut with explicit advances
give matching layouts. A glyph's scaled advance is rounded once: MS UI
Gothic's 'A', 'E', 'V' and 'Z' at 15 pixels (9.49, 8.50) are 9 and 8.
Wine before: embedded monochrome glyph advances could differ from the
outline metrics used for measuring; FreeType rounds the scaled advance to
26.6 first and then to pixels (607.5/64 becomes 10).
Change: reuse the existing delta generation path for monochrome text; text
with explicit or PDY advances and antialiased text are unchanged. Where
hinting left the advance alone, it is the linear advance rounded once.
Evidence: tests/mono-advance.c; tests/char-widths-dpi.c gives XP's widths
of MS UI Gothic's ASCII characters at 12 to 24 pixels, regular and bold.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
Old patches: 0030.
---
 dlls/win32u/font.c     | 7 ++++++-
 dlls/win32u/freetype.c | 7 +++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index ed2ef52..37403eb 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -44,6 +44,7 @@
 #include "wine/unixlib.h"
 #include "wine/rbtree.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(font);
 
@@ -5896,7 +5897,11 @@ BOOL WINAPI NtGdiExtTextOutW( HDC hdc, INT x, INT y, UINT flags, const RECT *lpr
     if (char_extra && lpDx && NtGdiGetDeviceCaps( hdc, TECHNOLOGY ) == DT_RASPRINTER)
         char_extra = 0; /* Printer drivers don't add char_extra if lpDx is supplied */
 
-    if(char_extra || dc->breakExtra || breakRem || lpDx || lf.lfEscapement != 0)
+    /* Embedded monochrome bitmaps may have different advances from the
+     * outline metrics used for layout. Keep external-shell text placement
+     * consistent with GetTextExtent, while preserving explicit distances. */
+    if(char_extra || dc->breakExtra || breakRem || lpDx || lf.lfEscapement != 0 ||
+       (dc->aa_flags == GGO_BITMAP && win4wine_external_shell()))
     {
         UINT i;
         POINT total = {0, 0}, desired[2];
diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
index aeae190..b7bf79c 100644
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -69,6 +69,7 @@
 #include "wingdi.h"
 #include "ntgdi_private.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 #include "wine/list.h"
 
 #ifdef SONAME_LIBFREETYPE
@@ -3137,6 +3138,12 @@ static UINT freetype_get_glyph_outline( struct gdi_font *font, UINT glyph, UINT
     }
 
     metrics = ft_face->glyph->metrics;
+    /* XP rounds a glyph's scaled advance once; FreeType rounds it to 26.6
+     * first and then to pixels, so 9.492 becomes 10 (MS UI Gothic's 'A' at
+     * 15 pixels). Where hinting left the advance alone, round it as XP does. */
+    if (win4wine_external_shell() && !matrices && !vertical_metrics && FT_IS_SCALABLE( ft_face ) &&
+        metrics.horiAdvance == ((((ft_face->glyph->linearHoriAdvance + 512) >> 10) + 32) & -64))
+        metrics.horiAdvance = ((ft_face->glyph->linearHoriAdvance + 0x8000) >> 16) << 6;
     if(font->fake_bold) {
         if (!get_bold_glyph_outline(ft_face->glyph, font->ppem, &metrics) && metrics.width)
             metrics.width += 1 << 6;
