+/* Windows 7's Start button is a layered window that explorer draws with
+ * UpdateLayeredWindow; drawing on its DC would overwrite that image (on Windows
+ * it has no effect). */
+static BOOL layered_start_button( const BUTTON_INFO *info )
+{
+    return info->start_button && (GetWindowLongW( info->hwnd, GWL_EXSTYLE ) & WS_EX_LAYERED);
+}
