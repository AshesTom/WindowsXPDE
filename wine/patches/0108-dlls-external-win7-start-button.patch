+/* Windows 7's Start button and Start menu user picture (WIN4WINE_SHELL is win7) are
+ * layered windows with per-pixel alpha, owned by the taskbar or the Start menu and
+ * drawn over it. Without a compositing manager their surface shows the premultiplied
+ * colours over black, so the partly transparent edges are dark. Blend those pixels
+ * with what the owner shows under the window. A compositor (win4wine's Wayland
+ * session, WIN4WINE_COMPOSITED) blends the premultiplied image itself. */
+static HWND get_tray_owner( HWND hwnd )
+{
+    static const WCHAR trayW[] = {'S','h','e','l','l','_','T','r','a','y','W','n','d'};
+    static const WCHAR menuW[] = {'D','V','2','C','o','n','t','r','o','l','H','o','s','t'};
+    WCHAR nameW[MAX_ATOM_LEN + 1];
+    UNICODE_STRING name = RTL_CONSTANT_STRING(nameW);
+    HWND owner;
+
+    if (win4wine_shell() != WIN4WINE_SHELL_WIN7 || getenv( "WIN4WINE_COMPOSITED" )) return 0;
+    if (!(owner = get_window_relative( hwnd, GW_OWNER ))) return 0;
+    name.Length = NtUserGetClassName( owner, FALSE, &name ) * sizeof(WCHAR);
+    /* the taskbar (Start button) or the Start menu (user picture) */
+    if (name.Length == sizeof(trayW) && !memcmp( name.Buffer, trayW, sizeof(trayW) )) return owner;
+    if (name.Length == sizeof(menuW) && !memcmp( name.Buffer, menuW, sizeof(menuW) )) return owner;
+    return 0;
+}
+
+/* copy what the owner shows: its surface, where its children draw too; offset is the
+ * screen position of the copy */
+static DWORD *get_tray_background( HWND owner, POINT *offset, SIZE *size )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *surface = NULL;
+    struct window_rects rects;
+    DWORD *bits = NULL, *color;
+    int y, height;
+    WND *win;
+
+    if (!(win = get_win_ptr( owner )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return NULL;
+    if ((surface = win->surface)) window_surface_add_ref( surface );
+    rects = win->rects;
+    release_win_ptr( win );
+    if (!surface) return NULL;
+    if (surface == &dummy_surface) goto done;
+
+    window_surface_lock( surface );
+    if ((color = window_surface_get_color( surface, info )) && info->bmiHeader.biBitCount == 32)
+    {
+        size->cx = info->bmiHeader.biWidth;
+        size->cy = height = abs( info->bmiHeader.biHeight );
+        offset->x = rects.visible.left + surface->rect.left;
+        offset->y = rects.visible.top + surface->rect.top;
+        if ((bits = malloc( size->cx * size->cy * sizeof(*bits) )))
+            for (y = 0; y < height; y++)
+                memcpy( bits + y * size->cx,
+                        color + (info->bmiHeader.biHeight < 0 ? y : height - 1 - y) * size->cx,
+                        size->cx * sizeof(*bits) );
+    }
+    window_surface_unlock( surface );
+done:
+    window_surface_release( surface );
+    return bits;
+}
+
+/* blend the partly transparent pixels of a premultiplied surface with the background;
+ * window is the window's screen position */
+static void blend_tray_background( struct window_surface *surface, const RECT *rect, const RECT *window,
+                                   POINT offset, SIZE size, const DWORD *background )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    DWORD *color, *row, alpha, pixel, under;
+    int x, y, bx, by, stride;
+
+    if (!(color = window_surface_get_color( surface, info ))) return;
+    if (info->bmiHeader.biBitCount != 32) return;
+    stride = info->bmiHeader.biWidth;
+    for (y = rect->top; y < rect->bottom; y++)
+    {
+        by = window->top + y - offset.y;
+        row = color + (info->bmiHeader.biHeight < 0 ? y : info->bmiHeader.biHeight - 1 - y) * stride;
+        for (x = rect->left; x < rect->right; x++)
+        {
+            bx = window->left + x - offset.x;
+            pixel = row[x];
+            alpha = pixel >> 24;
+            if (!alpha || alpha == 0xff) continue;
+            if (!background || by < 0 || by >= size.cy || bx < 0 || bx >= size.cx || !background[by * size.cx + bx])
+            {
+                /* Outside the owner, or where it has not drawn yet, what is underneath
+                 * is unknown: leave out the mostly transparent pixels and show the
+                 * others unpremultiplied. */
+                if (alpha < 0x80) row[x] = 0;
+                else row[x] = (pixel & 0xff000000) |
+                              min( 255, ((pixel >> 16) & 0xff) * 255 / alpha ) << 16 |
+                              min( 255, ((pixel >> 8) & 0xff) * 255 / alpha ) << 8 |
+                              min( 255, (pixel & 0xff) * 255 / alpha );
+                continue;
+            }
+            under = background[by * size.cx + bx];
+            row[x] = (pixel & 0xff000000) |
+                     (((pixel >> 16) & 0xff) + ((under >> 16) & 0xff) * (255 - alpha) / 255) << 16 |
+                     (((pixel >> 8) & 0xff) + ((under >> 8) & 0xff) * (255 - alpha) / 255) << 8 |
+                     ((pixel & 0xff) + (under & 0xff) * (255 - alpha) / 255);
+        }
+    }
+}
+
+/* The premultiplied images of those windows, to blend them again when their owner
+ * shows new pixels: the Start menu's user picture is made before the menu draws. */
+struct shell_overlay
+{
+    struct list entry;
+    HWND owner;
+    struct window_surface *surface;  /* the overlay's surface, referenced */
+    RECT rect;     /* in the window */
+    RECT window;   /* the window on the screen */
+    DWORD *bits;   /* rect's pixels, top-down */
+};
+static struct list shell_overlays = LIST_INIT( shell_overlays );
+static pthread_mutex_t shell_overlays_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* copy rect of a 32 bpp surface, top-down; the surface is locked */
+static DWORD *copy_surface_rect( struct window_surface *surface, const RECT *rect )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    int y, width = rect->right - rect->left;
+    DWORD *color, *bits;
+
+    if (!(color = window_surface_get_color( surface, info )) || info->bmiHeader.biBitCount != 32) return NULL;
+    if (!(bits = malloc( width * (rect->bottom - rect->top) * sizeof(*bits) ))) return NULL;
+    for (y = rect->top; y < rect->bottom; y++)
+        memcpy( bits + (y - rect->top) * width,
+                color + (info->bmiHeader.biHeight < 0 ? y : info->bmiHeader.biHeight - 1 - y) * info->bmiHeader.biWidth
+                      + rect->left, width * sizeof(*bits) );
+    return bits;
+}
+
+static void restore_surface_rect( struct window_surface *surface, const RECT *rect, const DWORD *bits )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    int y, width = rect->right - rect->left;
+    DWORD *color;
+
+    if (!(color = window_surface_get_color( surface, info )) || info->bmiHeader.biBitCount != 32) return;
+    for (y = rect->top; y < rect->bottom; y++)
+        memcpy( color + (info->bmiHeader.biHeight < 0 ? y : info->bmiHeader.biHeight - 1 - y) * info->bmiHeader.biWidth
+                      + rect->left, bits + (y - rect->top) * width, width * sizeof(*bits) );
+}
+
+static void save_shell_overlay( HWND owner, struct window_surface *surface, const RECT *rect, const RECT *window,
+                                DWORD *bits )
+{
+    struct shell_overlay *overlay;
+
+    pthread_mutex_lock( &shell_overlays_lock );
+    LIST_FOR_EACH_ENTRY( overlay, &shell_overlays, struct shell_overlay, entry )
+        if (overlay->surface->hwnd == surface->hwnd) break;
+    if (&overlay->entry == &shell_overlays)
+    {
+        if (!(overlay = calloc( 1, sizeof(*overlay) )))
+        {
+            pthread_mutex_unlock( &shell_overlays_lock );
+            free( bits );
+            return;
+        }
+        list_add_tail( &shell_overlays, &overlay->entry );
+    }
+    else window_surface_release( overlay->surface );
+    free( overlay->bits );
+    window_surface_add_ref( surface );
+    overlay->owner = owner;
+    overlay->surface = surface;
+    overlay->rect = *rect;
+    overlay->window = *window;
+    overlay->bits = bits;
+    pthread_mutex_unlock( &shell_overlays_lock );
+}
+
+/* OWNER flushed new pixels: blend its overlays again with them */
+void blend_shell_overlays( struct window_surface *owner )
+{
+    struct window_surface *flush[8];
+    struct shell_overlay *overlay;
+    DWORD *background = NULL;
+    POINT offset = {0};
+    SIZE size = {0};
+    unsigned int i, count = 0;
+
+    if (owner == &dummy_surface) return;
+    pthread_mutex_lock( &shell_overlays_lock );
+    LIST_FOR_EACH_ENTRY( overlay, &shell_overlays, struct shell_overlay, entry )
+    {
+        if (overlay->owner != owner->hwnd || overlay->surface == owner || count == ARRAY_SIZE(flush)) continue;
+        if (!background && !(background = get_tray_background( owner->hwnd, &offset, &size ))) break;
+        window_surface_lock( overlay->surface );
+        restore_surface_rect( overlay->surface, &overlay->rect, overlay->bits );
+        blend_tray_background( overlay->surface, &overlay->rect, &overlay->window, offset, size, background );
+        add_bounds_rect( &overlay->surface->bounds, &overlay->rect );
+        window_surface_unlock( overlay->surface );
+        window_surface_add_ref( overlay->surface );
+        flush[count++] = overlay->surface;
+    }
+    pthread_mutex_unlock( &shell_overlays_lock );
+    free( background );
+    for (i = 0; i < count; i++)
+    {
+        window_surface_flush( flush[i] );
+        window_surface_release( flush[i] );
+    }
+}
+
+BOOL have_shell_overlays(void)
+{
+    BOOL ret;
+    pthread_mutex_lock( &shell_overlays_lock );
+    ret = !list_empty( &shell_overlays );
+    pthread_mutex_unlock( &shell_overlays_lock );
+    return ret;
+}
+
