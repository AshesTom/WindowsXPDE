+/***********************************************************************
+ *          SHRestricted2W (ieframe.159)
+ *
+ * Windows 7's shdocvw forwards its SHRestricted2W here.
+ */
+DWORD WINAPI SHRestricted2W(DWORD restriction, const WCHAR *url, DWORD reserved)
+{
+    FIXME("(%ld %s %ld) stub\n", restriction, debugstr_w(url), reserved);
+    return 0;
+}
+
+/***********************************************************************
+ *          SHRestricted2A (ieframe.158)
+ */
+DWORD WINAPI SHRestricted2A(DWORD restriction, const char *url, DWORD reserved)
+{
+    FIXME("(%ld %s %ld) stub\n", restriction, debugstr_a(url), reserved);
+    return 0;
+}
+
 /***********************************************************************
  *          SetQueryNetSessionCount (ieframe.@)
  */
