+++ b/dlls/ntshrui/main.c
@@ -0,0 +1,83 @@
+/*
+ * Shell sharing helpers (ntshrui.dll)
+ *
+ * Wine shares no folders: no path is shared, and no network resource
+ * names a local path.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "objbase.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ntshrui);
+
+BOOL WINAPI IsPathSharedW(const WCHAR *path, BOOL refresh)
+{
+    TRACE("%s, %d\n", debugstr_w(path), refresh);
+    return FALSE;
+}
+
+BOOL WINAPI IsPathSharedA(const char *path, BOOL refresh)
+{
+    TRACE("%s, %d\n", debugstr_a(path), refresh);
+    return FALSE;
+}
+
+BOOL WINAPI GetNetResourceFromLocalPathW(const WCHAR *path, WCHAR *name, DWORD size, DWORD *type)
+{
+    TRACE("%s, %p, %lu, %p\n", debugstr_w(path), name, size, type);
+    SetLastError(ERROR_BAD_NET_NAME);
+    return FALSE;
+}
+
+BOOL WINAPI GetNetResourceFromLocalPathA(const char *path, char *name, DWORD size, DWORD *type)
+{
+    TRACE("%s, %p, %lu, %p\n", debugstr_a(path), name, size, type);
+    SetLastError(ERROR_BAD_NET_NAME);
+    return FALSE;
+}
+
+BOOL WINAPI GetLocalPathFromNetResourceW(const WCHAR *name, DWORD type, WCHAR *path, DWORD size, BOOL *local)
+{
+    TRACE("%s, %lu, %p, %lu, %p\n", debugstr_w(name), type, path, size, local);
+    SetLastError(ERROR_BAD_NET_NAME);
+    return FALSE;
+}
+
+BOOL WINAPI GetLocalPathFromNetResourceA(const char *name, DWORD type, char *path, DWORD size, BOOL *local)
+{
+    TRACE("%s, %lu, %p, %lu, %p\n", debugstr_a(name), type, path, size, local);
+    SetLastError(ERROR_BAD_NET_NAME);
+    return FALSE;
+}
+
+HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID iid, void **obj)
+{
+    FIXME("%s, %s, %p: no sharing pages\n", debugstr_guid(clsid), debugstr_guid(iid), obj);
+    *obj = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
+HRESULT WINAPI DllCanUnloadNow(void)
+{
+    return S_OK;
+}
