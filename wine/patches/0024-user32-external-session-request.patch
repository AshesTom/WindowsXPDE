From: Codex <codex@localhost>
Subject: [PATCH] user32: record external shell session end requests

Purpose: end the Linux session when the user logs off, shuts down or
restarts from the XP shell.
Wine before: ExitWindowsEx asked Wine's processes to end; the session
supervisor saw the shell disappear and restarted it as after a crash.
Change: when WIN4WINE_SESSION_REQUEST names a file, write "logoff",
"shutdown" or "reboot" there first. The supervisor reads it, does not
restart the shell, and ends the session (or asks the system to power off
or restart).
Scope: only when WIN4WINE_SESSION_REQUEST is set, which the session does
for the XP shell; without it ExitWindowsEx is unchanged.
Old patches: 0054.
---
 dlls/user32/user_main.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/dlls/user32/user_main.c b/dlls/user32/user_main.c
index 73ab53b..b484590 100644
--- a/dlls/user32/user_main.c
+++ b/dlls/user32/user_main.c
@@ -268,6 +268,23 @@ BOOL WINAPI ExitWindowsEx( UINT flags, DWORD reason )
     STARTUPINFOW si;
     void *redir;
 
+    /* An external shell session ends the Linux session itself. Record what
+     * was requested before the Wine processes are asked to end, so that the
+     * session supervisor does not treat the shell's exit as a crash. */
+    if (GetEnvironmentVariableW( L"WIN4WINE_SESSION_REQUEST", app, MAX_PATH ) - 1 < MAX_PATH - 1)
+    {
+        const char *request = (flags & EWX_REBOOT) ? "reboot\n" :
+                              (flags & (EWX_SHUTDOWN | EWX_POWEROFF)) ? "shutdown\n" : "logoff\n";
+        HANDLE file = CreateFileW( app, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+        DWORD written;
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            WriteFile( file, request, strlen( request ), &written, NULL );
+            CloseHandle( file );
+        }
+        else ERR( "cannot record session request in %s\n", debugstr_w(app) );
+    }
+
     GetSystemDirectoryW( app, MAX_PATH - ARRAY_SIZE( L"\\wineboot.exe" ));
     lstrcatW( app, L"\\wineboot.exe" );
     lstrcpyW( cmdline, app );
