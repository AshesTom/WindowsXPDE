From: Codex <codex@localhost>
Subject: [PATCH] user32: print external shell descendants into WM_PRINT snapshots

Purpose: let the XP Start panel capture itself before it is shown.
XP behavior: the panel paints itself into a memory DC with WM_PRINT and
PRF_CHILDREN | PRF_OWNED, translated with the viewport origin, and shows
that picture.
Wine before: DefWindowProc ignored owned windows and the non-client
area, and printed children top of the Z order first, without their
parents' clips, so overlapping panes came out in the wrong order;
owner-drawn Button and Static controls converted the already logical
client rectangle with DPtoLP a second time, so their clip was empty in the
translated DC.
Change: print visible descendants bottom to top with translated origins and
their parents' clips, then owned windows, preserving the caller's DC state;
let the non-client painter draw into the supplied DC; for MM_TEXT, clip
controls to the logical client rectangle directly.
Evidence: tests/print-window.c (children, grandchildren, owned and hidden
windows, overflowing children, overlap, frames, viewport and clip
preservation, owner-drawn builtin controls).
Scope: only with WIN4WINE_EXTERNAL_SHELL; same-process windows only.
Old patches: 0012, 0017.
---
 dlls/user32/defwnd.c  | 98 +++++++++++++++++++++++++++++++++++++++++++++++++++
 dlls/user32/uitools.c |  8 ++++-
 dlls/win32u/defwnd.c  | 49 +++++++++++++++++---------
 3 files changed, 137 insertions(+), 18 deletions(-)

diff --git a/dlls/user32/defwnd.c b/dlls/user32/defwnd.c
index fd45c78..6069166 100644
--- a/dlls/user32/defwnd.c
+++ b/dlls/user32/defwnd.c
@@ -22,6 +22,7 @@
 #include "user_private.h"
 #include "controls.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
 
@@ -79,6 +80,89 @@ static void default_ime_compositionA( HWND hwnd, WPARAM wparam, LPARAM lparam )
     HeapFree( GetProcessHeap(), 0, buf );
 }
 
+/* XP captures the Start panel through WM_PRINT before its show animation.
+ * The win32u default only prints the parent; include visible descendants in
+ * the caller's DC for the explicitly selected external shell. */
+static LRESULT external_shell_print( HWND hwnd, HDC dc, LPARAM flags )
+{
+    RECT rect, window;
+    POINT origin = {0};
+    HWND child;
+    int saved;
+
+    if ((flags & PRF_CHECKVISIBLE) && !IsWindowVisible( hwnd )) return 0;
+    if (!(saved = SaveDC( dc ))) return 0;
+    GetClientRect( hwnd, &rect );
+    if (flags & PRF_NONCLIENT)
+    {
+        NtUserMessageCall( hwnd, WM_PRINT, (WPARAM)dc, PRF_NONCLIENT, 0, NtUserDefWindowProc, FALSE );
+        GetWindowRect( hwnd, &window );
+        MapWindowPoints( hwnd, NULL, &origin, 1 );
+        OffsetViewportOrgEx( dc, origin.x - window.left, origin.y - window.top, NULL );
+    }
+    IntersectClipRect( dc, rect.left, rect.top, rect.right, rect.bottom );
+    if (flags & PRF_ERASEBKGND) SendMessageW( hwnd, WM_ERASEBKGND, (WPARAM)dc, 0 );
+    if (flags & PRF_CLIENT) SendMessageW( hwnd, WM_PRINTCLIENT, (WPARAM)dc, flags );
+    if (flags & PRF_CHILDREN)
+    {
+        /* Paint bottom-to-top so overlapping siblings preserve their Z order. */
+        child = GetWindow( hwnd, GW_CHILD );
+        if (child) child = GetWindow( child, GW_HWNDLAST );
+        for (; child; child = GetWindow( child, GW_HWNDPREV ))
+        {
+            int child_saved;
+            if (!(GetWindowLongW( child, GWL_STYLE ) & WS_VISIBLE)) continue;
+            if (!(child_saved = SaveDC( dc ))) continue;
+            if (flags & PRF_NONCLIENT)
+            {
+                GetWindowRect( child, &window );
+                MapWindowPoints( NULL, hwnd, (POINT *)&window, 2 );
+                origin.x = window.left;
+                origin.y = window.top;
+            }
+            else
+            {
+                origin.x = origin.y = 0;
+                MapWindowPoints( child, hwnd, &origin, 1 );
+            }
+            OffsetViewportOrgEx( dc, origin.x, origin.y, NULL );
+            SendMessageW( child, WM_PRINT, (WPARAM)dc, flags & ~PRF_OWNED );
+            RestoreDC( dc, child_saved );
+        }
+    }
+    RestoreDC( dc, saved );
+    if (flags & PRF_OWNED)
+    {
+        POINT parent = {0};
+        MapWindowPoints( hwnd, NULL, &parent, 1 );
+        if (flags & PRF_NONCLIENT)
+        {
+            GetWindowRect( hwnd, &window );
+            parent.x = window.left;
+            parent.y = window.top;
+        }
+        child = GetTopWindow( NULL );
+        if (child) child = GetWindow( child, GW_HWNDLAST );
+        for (; child; child = GetWindow( child, GW_HWNDPREV ))
+        {
+            if (GetWindow( child, GW_OWNER ) != hwnd || !IsWindowVisible( child )) continue;
+            if (!(saved = SaveDC( dc ))) continue;
+            GetWindowRect( child, &window );
+            origin.x = window.left;
+            origin.y = window.top;
+            if (!(flags & PRF_NONCLIENT))
+            {
+                origin.x = origin.y = 0;
+                MapWindowPoints( child, NULL, &origin, 1 );
+            }
+            OffsetViewportOrgEx( dc, origin.x - parent.x, origin.y - parent.y, NULL );
+            SendMessageW( child, WM_PRINT, (WPARAM)dc, flags );
+            RestoreDC( dc, saved );
+        }
+    }
+    return 0;
+}
+
 /***********************************************************************
  *              DefWindowProcA (USER32.@)
  *
@@ -101,6 +185,13 @@ LRESULT WINAPI DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam
 
     switch(msg)
     {
+    case WM_PRINT:
+        if (win4wine_external_shell() && (lParam & (PRF_CHILDREN | PRF_OWNED)))
+            result = external_shell_print( hwnd, (HDC)wParam, lParam );
+        else
+            result = NtUserMessageCall( hwnd, msg, wParam, lParam, 0, NtUserDefWindowProc, TRUE );
+        break;
+
     case WM_SYSCOMMAND:
         result = NC_HandleSysCommand( hwnd, wParam, lParam );
         break;
@@ -166,6 +257,13 @@ LRESULT WINAPI DefWindowProcW(
 
     switch(msg)
     {
+    case WM_PRINT:
+        if (win4wine_external_shell() && (lParam & (PRF_CHILDREN | PRF_OWNED)))
+            result = external_shell_print( hwnd, (HDC)wParam, lParam );
+        else
+            result = NtUserMessageCall( hwnd, msg, wParam, lParam, 0, NtUserDefWindowProc, FALSE );
+        break;
+
     case WM_SYSCOMMAND:
         result = NC_HandleSysCommand( hwnd, wParam, lParam );
         break;
diff --git a/dlls/user32/uitools.c b/dlls/user32/uitools.c
index a8f3a0a..d4b51a9 100644
--- a/dlls/user32/uitools.c
+++ b/dlls/user32/uitools.c
@@ -29,6 +29,7 @@
 #include "user_private.h"
 #include "controls.h"
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(graphics);
 
@@ -129,7 +130,12 @@ HRGN set_control_clipping( HDC hdc, const RECT *rect )
         DeleteObject( hrgn );
         hrgn = 0;
     }
-    DPtoLP( hdc, (POINT *)&rc, 2 );
+    /* WM_PRINT supplies logical client rectangles in a translated MM_TEXT DC.
+     * Converting their coordinates again subtracts the snapshot viewport and
+     * can intersect the control's clip with an unrelated, empty rectangle. */
+    if (GetMapMode( hdc ) != MM_TEXT ||
+        !win4wine_external_shell())
+        DPtoLP( hdc, (POINT *)&rc, 2 );
     if (GetLayout( hdc ) & LAYOUT_RTL)  /* compensate for the shifting done by IntersectClipRect */
     {
         rc.left++;
diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index 7b12d55..d3798ed 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -1805,7 +1805,7 @@ BOOL WINAPI NtUserDrawCaptionTemp( HWND hwnd, HDC hdc, const RECT *rect, HFONT f
 }
 
 /* Paint the non-client area for windows */
-static void nc_paint( HWND hwnd, HRGN clip )
+static void nc_paint( HWND hwnd, HRGN clip, HDC target )
 {
     HDC hdc;
     RECT rfuzz, rect, clip_rect;
@@ -1815,6 +1815,7 @@ static void nc_paint( HWND hwnd, HRGN clip )
     WORD flags;
     HRGN hrgn;
     RECT rectClient;
+    int saved = 0;
 
     if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS) return;
     style = win->dwStyle;
@@ -1826,24 +1827,34 @@ static void nc_paint( HWND hwnd, HRGN clip )
 
     TRACE( "%p %d\n", hwnd, active );
 
-    get_client_rect_rel( hwnd, COORDS_SCREEN, &rectClient, get_thread_dpi() );
-    hrgn = NtGdiCreateRectRgn( rectClient.left, rectClient.top,
-                               rectClient.right, rectClient.bottom );
-
-    if (clip > (HRGN)1)
+    if (target)
     {
-        NtGdiCombineRgn( hrgn, clip, hrgn, RGN_DIFF );
-        hdc = NtUserGetDCEx( hwnd, hrgn, DCX_USESTYLE | DCX_WINDOW | DCX_INTERSECTRGN );
+        hdc = target;
+        if (!(saved = NtGdiSaveDC( hdc ))) return;
+        get_client_rect_rel( hwnd, COORDS_WINDOW, &rectClient, get_thread_dpi() );
+        NtGdiExcludeClipRect( hdc, rectClient.left, rectClient.top, rectClient.right, rectClient.bottom );
     }
     else
     {
-        hdc = NtUserGetDCEx( hwnd, hrgn, DCX_USESTYLE | DCX_WINDOW | DCX_EXCLUDERGN );
-    }
+        get_client_rect_rel( hwnd, COORDS_SCREEN, &rectClient, get_thread_dpi() );
+        hrgn = NtGdiCreateRectRgn( rectClient.left, rectClient.top,
+                                   rectClient.right, rectClient.bottom );
 
-    if (!hdc)
-    {
-        NtGdiDeleteObjectApp( hrgn );
-        return;
+        if (clip > (HRGN)1)
+        {
+            NtGdiCombineRgn( hrgn, clip, hrgn, RGN_DIFF );
+            hdc = NtUserGetDCEx( hwnd, hrgn, DCX_USESTYLE | DCX_WINDOW | DCX_INTERSECTRGN );
+        }
+        else
+        {
+            hdc = NtUserGetDCEx( hwnd, hrgn, DCX_USESTYLE | DCX_WINDOW | DCX_EXCLUDERGN );
+        }
+
+        if (!hdc)
+        {
+            NtGdiDeleteObjectApp( hrgn );
+            return;
+        }
     }
 
     get_window_rect_rel( hwnd, COORDS_WINDOW, &rect, get_thread_dpi() );
@@ -1909,7 +1920,8 @@ static void nc_paint( HWND hwnd, HRGN clip )
         fill_rect( hdc, &r, get_sys_color_brush( COLOR_BTNFACE ) );
     }
 
-    NtUserReleaseDC( hwnd, hdc );
+    if (target) NtGdiRestoreDC( hdc, saved );
+    else NtUserReleaseDC( hwnd, hdc );
 }
 
 static LRESULT handle_nc_paint( HWND hwnd , HRGN clip )
@@ -1919,7 +1931,7 @@ static LRESULT handle_nc_paint( HWND hwnd , HRGN clip )
 
     if (style & WS_VISIBLE)
     {
-        nc_paint( hwnd, clip );
+        nc_paint( hwnd, clip, NULL );
 
         if (parent == get_desktop_window())
             NtUserPostMessage( parent, WM_PARENTNOTIFY, WM_NCPAINT, (LPARAM)hwnd );
@@ -1942,7 +1954,7 @@ static LRESULT handle_nc_activate( HWND hwnd, WPARAM wparam, LPARAM lparam )
      */
     if (lparam != -1)
     {
-        nc_paint( hwnd, (HRGN)1 );
+        nc_paint( hwnd, (HRGN)1, NULL );
 
         if (NtUserGetAncestor( hwnd, GA_PARENT ) == get_desktop_window())
             NtUserPostMessage( get_desktop_window(), WM_PARENTNOTIFY, WM_NCACTIVATE, (LPARAM)hwnd );
@@ -3026,6 +3038,9 @@ LRESULT default_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam,
         if ((lparam & PRF_CHECKVISIBLE) && !is_window_visible ( hwnd )) break;
         result = 1;
 
+        if ((lparam & PRF_NONCLIENT) && win4wine_external_shell())
+            nc_paint( hwnd, 0, (HDC)wparam );
+
         if (lparam & (PRF_OWNED | PRF_NONCLIENT))
             WARN( "WM_PRINT message with unsupported lparam %lx\n", lparam );
 
