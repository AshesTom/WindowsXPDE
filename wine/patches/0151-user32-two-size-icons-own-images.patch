From: Codex <codex@localhost>
Subject: [PATCH] user32: make each size of a two-size icon extraction from its own image

Purpose: XP's Quick Launch icons look as on XP. XP's shell32 asks
PrivateExtractIconsW for two sizes at once (32 and 16, 48 and 16) and puts
the small icon in the toolbar's image list.
Windows behavior: with HIWORD sizes, each size's icon is made from the image
the icon group has for that size: a 16x16 icon is the file's 16x16 image
(measured with a probe on XP: the Show Desktop icon in Quick Launch is
identical to the one Wine draws with this change).
Wine before: both icons were made from the image chosen for the first size,
so the 16x16 icon was the 32x32 or 48x48 image scaled down, without its
alpha edge: jagged Quick Launch and system image list icons.
Change: the second loop creates each icon from its own ID (the IDs
alternate between the two sizes), in .ico/NE files and in PE files.
Scope: all programs; only calls with two sizes change.
---
 dlls/user32/exticon.c | 28 ++++++++++++++++------------
 1 file changed, 16 insertions(+), 12 deletions(-)

diff --git a/dlls/user32/exticon.c b/dlls/user32/exticon.c
index b2254efb..d0bfced5 100644
--- a/dlls/user32/exticon.c
+++ b/dlls/user32/exticon.c
@@ -360,6 +360,7 @@ static UINT ICO_ExtractIconExW(
 	    else if (nIconIndex < iconDirCount)
 	    {
 	      UINT16   i, icon;
+	      UINT16   count;
 	      if (nIcons > iconDirCount - nIconIndex)
 	        nIcons = iconDirCount - nIconIndex;
 
@@ -373,9 +374,14 @@ static UINT ICO_ExtractIconExW(
 	      }
               if (lpiID)	/* *.ico file, deallocate heap pointer*/
 	        HeapFree(GetProcessHeap(), 0, pCIDir);
+              count = i;
 
-	      for (icon = 0; icon < nIcons; icon++)
+	      /* With two sizes the IDs alternate, and each size is made from
+	       * the image chosen for it, as on Windows (not the first size's
+	       * image scaled). */
+	      for (icon = 0; icon < count; icon++)
 	      {
+	        BOOL second = cx2 && cy2 && (icon & 1);
 	        pCIDir = NULL;
 	        if (lpiID)
 	          pCIDir = ICO_LoadIcon(peimage, lpiID->idEntries + (int)pIconId[icon], &uSize);
@@ -385,13 +391,8 @@ static UINT ICO_ExtractIconExW(
 	              pCIDir = USER32_LoadResource(peimage, pIconStorage + i, *(WORD*)pData, &uSize);
 
 	        if (pCIDir)
-                {
 	          RetPtr[icon] = CreateIconFromResourceEx(pCIDir, uSize, TRUE, 0x00030000,
-                                                                 cx1, cy1, flags);
-                  if (cx2 && cy2)
-                      RetPtr[++icon] = CreateIconFromResourceEx(pCIDir, uSize, TRUE, 0x00030000,
-                                                                       cx2, cy2, flags);
-                }
+                                                                 second ? cx2 : cx1, second ? cy2 : cy1, flags);
 	        else
 	          RetPtr[icon] = 0;
 	      }
@@ -409,7 +410,7 @@ static UINT ICO_ExtractIconExW(
         const IMAGE_RESOURCE_DATA_ENTRY *idataent, *igdataent;
         const IMAGE_RESOURCE_DIRECTORY_ENTRY *xresent;
         ULONG size;
-        UINT i;
+        UINT i, count;
 
         rootresdir = RtlImageDirectoryEntryToData((HMODULE)peimage, FALSE, IMAGE_DIRECTORY_ENTRY_RESOURCE, &size);
         if (!rootresdir)
@@ -494,6 +495,7 @@ static UINT ICO_ExtractIconExW(
 	    pIconId[i] = LookupIconIdFromDirectoryEx(igdata, TRUE, cx1, cy1, flags);
             if (cx2 && cy2) pIconId[++i] = LookupIconIdFromDirectoryEx(igdata, TRUE, cx2, cy2, flags);
 	  }
+          count = i;
 
 	  if (!(iconresdir=find_entry_by_id(rootresdir,LOWORD(RT_ICON),rootresdir)))
 	  {
@@ -501,9 +503,12 @@ static UINT ICO_ExtractIconExW(
 	    goto end;		/* failure */
 	  }
 
-	  for (i=0; i<nIcons; i++)
+	  /* With two sizes the IDs alternate, and each size is made from the
+	   * image chosen for it, as on Windows (not the first size's image scaled). */
+	  for (i=0; i<count; i++)
 	  {
 	    const IMAGE_RESOURCE_DIRECTORY *xresdir;
+	    BOOL second = cx2 && cy2 && (i & 1);
 	    xresdir = find_entry_by_id(iconresdir, LOWORD(pIconId[i]), rootresdir);
             if( !xresdir )
             {
@@ -521,9 +526,8 @@ static UINT ICO_ExtractIconExW(
 	      RetPtr[i]=0;
 	      continue;
 	    }
-	    RetPtr[i] = CreateIconFromResourceEx(idata, idataent->Size, TRUE, 0x00030000, cx1, cy1, flags);
-            if (cx2 && cy2)
-                RetPtr[++i] = CreateIconFromResourceEx(idata, idataent->Size, TRUE, 0x00030000, cx2, cy2, flags);
+	    RetPtr[i] = CreateIconFromResourceEx(idata, idataent->Size, TRUE, 0x00030000,
+	                                         second ? cx2 : cx1, second ? cy2 : cy1, flags);
 	  }
 	  ret = i;	/* return number of retrieved icons */
 	}			/* if(sig == IMAGE_NT_SIGNATURE) */
