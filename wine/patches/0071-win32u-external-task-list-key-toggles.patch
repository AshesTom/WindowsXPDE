From: Codex <codex@localhost>
Subject: [PATCH] win32u: tell a Windows key combination from the key alone by the key toggles

Purpose: XP's Run dialog that Win+R opens gets the keyboard every time.
XP behavior: Win+R opens the Run dialog active; the Start menu opens only
for the Windows key pressed and released alone.
Wine before (0023): a Windows key release counted as alone unless a key
message came in between in this process. Win+R's release of R goes to the
thread with the keyboard, which may already be the Run dialog's own, and
the dialog's thread may take it after the desktop's thread took the
Windows key's release; then the task list was posted and the taskbar made
the foreground, and the dialog stayed inactive with the keys going to the
taskbar (about one time in two with a real keyboard in the test VM).
Change: at a new Windows key press, keep the desktop's key toggles, which
the server flips at each press as it gets it, a hotkey's press too; at the
release, a key whose toggle changed meanwhile means it was not alone.
Evidence: in the test VM, Win+R from the desktop gave an active Run dialog
8 times in 8 (inactive in one of two tries before); the Windows key alone,
Ctrl+Esc, and Win+R, the Windows key and Win+E from an xterm keep working.
Scope: only with WIN4WINE_EXTERNAL_SHELL.
---
 dlls/win32u/message.c | 33 +++++++++++++++++++++++++++++++--
 1 file changed, 31 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index f7c0069..10a41de 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2486,6 +2486,11 @@ static BOOL process_pointer_message( MSG *msg, UINT hw_id, const struct hardware
  * comes here, and a key still held is in the desktop's key state. */
 static BOOL win_key_down, win_key_alone;
 static DWORD win_key_time;
+/* The desktop's key toggles when the Windows key went down: a press flips a
+ * key's toggle when the server gets it, also for a hotkey's press, while the
+ * key messages may reach other threads of the process later than the
+ * Windows key's release (XP's Run dialog opening for Win+R). */
+static BYTE win_key_toggles[256];
 
 /* The windows with the shell hook property under PARENT, at most COUNT. */
 static unsigned int find_shell_hooks( HWND parent, HWND *found, unsigned int count )
@@ -2522,6 +2527,26 @@ static void post_task_list(void)
     for (i = 0; i < count; i++) NtUserPostMessage( hooks[i], message, HSHELL_TASKMAN, 0 );
 }
 
+static void save_key_toggles(void)
+{
+    BYTE state[256];
+    unsigned int key;
+
+    if (!get_async_keyboard_state( state )) memset( state, 0, sizeof(state) );
+    for (key = 0; key < 256; key++) win_key_toggles[key] = state[key] & 0x01;
+}
+
+static BOOL other_key_pressed(void)
+{
+    BYTE state[256];
+    unsigned int key;
+
+    if (!get_async_keyboard_state( state )) return FALSE;
+    for (key = VK_BACK; key < 256; key++)
+        if (key != VK_LWIN && key != VK_RWIN && (state[key] & 0x01) != win_key_toggles[key]) return TRUE;
+    return FALSE;
+}
+
 static BOOL other_key_down(void)
 {
     BYTE state[256];
@@ -2549,7 +2574,11 @@ static BOOL task_list_key( const MSG *msg )
              * grab arrives with the key already down in Wine's state. A press
              * long after the last one is new too: the release may have gone to
              * another process, while auto-repeat comes at least every second. */
-            if (!win_key_down || msg->time - win_key_time > 1000) win_key_down = win_key_alone = TRUE;
+            if (!win_key_down || msg->time - win_key_time > 1000)
+            {
+                win_key_down = win_key_alone = TRUE;
+                save_key_toggles();
+            }
             win_key_time = msg->time;
             return FALSE;
         }
@@ -2564,7 +2593,7 @@ static BOOL task_list_key( const MSG *msg )
     case WM_KEYUP:
     case WM_SYSKEYUP:
         if (win) TRACE_(key)( "windows key up, alone %u\n", win_key_alone );
-        if (win && win_key_alone && !other_key_down()) post_task_list();
+        if (win && win_key_alone && !other_key_down() && !other_key_pressed()) post_task_list();
         if (win) win_key_down = FALSE;
         win_key_alone = FALSE;
         return FALSE;
