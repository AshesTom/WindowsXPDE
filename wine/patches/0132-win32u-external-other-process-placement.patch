From: Codex <codex@localhost>
Subject: [PATCH] win32u: set the placement of another process's window

Purpose: Show Desktop (the taskbar's command, Quick Launch's Show Desktop,
Win+D) gives the windows it minimized back when it is used again.
Windows behavior: SetWindowPlacement sets the placement of a window of
another process too. XP's and Windows 7's explorer read each window's
placement (GetWindowPlacement), minimize it, and give it back with
SetWindowPlacement (SW_SHOWNOACTIVATE); measured with a probe that runs the
shell's ToggleDesktop twice on the reference machines (IShellDispatch4):
the windows are minimized, then shown again, and the last active one is
the foreground window.
Wine before: SetWindowPlacement failed for another process's window
(WND_OTHER_PROCESS); the windows stayed minimized (relay trace of XP's
explorer: SetWindowPlacement returned 0).
Change: with WIN4WINE_EXTERNAL_SHELL, the placement of another process's
window is sent to the window's thread (WM_WINE_SETWINDOWPLACEMENT, the
WINDOWPLACEMENT copied as it holds no pointers or handles), which sets it.
Evidence: XP's and Windows 7's Show Desktop (from Quick Launch) give
Notepad back at its place in the X11 sessions, with Notepad the foreground
window as on the reference machines, and Windows 7's in the Wayland
session (where the Start button keeps the keyboard afterwards).
Scope: the external shell sessions; SetWindowPlacement of the caller's own
process is unchanged.
---
 dlls/win32u/message.c        | 9 +++++++++
 dlls/win32u/win32u_private.h | 1 +
 dlls/win32u/window.c         | 7 ++++++-
 include/ntuser.h             | 1 +
 4 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 995b629..c310cc5 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -648,6 +648,9 @@ static BOOL unpack_message( HWND hwnd, UINT message, WPARAM *wparam, LPARAM *lpa
     case WM_GETMINMAXINFO:
         minsize = sizeof(MINMAXINFO);
         break;
+    case WM_WINE_SETWINDOWPLACEMENT:
+        minsize = sizeof(WINDOWPLACEMENT);
+        break;
     case WM_DRAWITEM:
     {
         DRAWITEMSTRUCT dis;
@@ -1038,6 +1041,10 @@ static size_t pack_message( HWND hwnd, UINT message, WPARAM wparam, LPARAM lpara
     case WM_GETMINMAXINFO:
         push_data( data, (MINMAXINFO *)lparam, sizeof(MINMAXINFO) );
         return sizeof(MINMAXINFO);
+    case WM_WINE_SETWINDOWPLACEMENT:
+        /* no pointers or handles: the same layout in every process */
+        push_data( data, (WINDOWPLACEMENT *)lparam, sizeof(WINDOWPLACEMENT) );
+        return 0;
     case WM_DRAWITEM:
     {
         DRAWITEMSTRUCT *dis = (DRAWITEMSTRUCT *)lparam;
@@ -2271,6 +2278,8 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
     case WM_WINE_REFIT_MAXIMIZED:
         refit_maximized_window( hwnd );
         return 0;
+    case WM_WINE_SETWINDOWPLACEMENT:
+        return set_window_placement( hwnd, (const WINDOWPLACEMENT *)lparam, wparam );
     case WM_WINE_SETPIXELFORMAT:
         set_window_pixel_format( hwnd, wparam, lparam );
         return 0;
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index e868f81..d02aef7 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -300,6 +300,7 @@ extern BOOL set_window_pos( WINDOWPOS *winpos, int parent_x, int parent_y );
 extern UINT set_window_style_bits( HWND hwnd, UINT set_bits, UINT clear_bits );
 extern void update_window_state( HWND hwnd );
 extern void refit_maximized_window( HWND hwnd );
+extern BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT flags );
 extern HWND window_from_point( HWND hwnd, POINT pt, INT *hittest, BOOL send_nchittest );
 extern HWND get_shell_window(void);
 extern HWND get_progman_window(void);
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 0d0c69f..155783e 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -3363,7 +3363,7 @@ static void make_point_onscreen( POINT *pt )
     pt->y = rect.top;
 }
 
-static BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT flags )
+BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT flags )
 {
     WND *win = get_win_ptr( hwnd );
     WINDOWPLACEMENT wp = *wndpl;
@@ -3381,6 +3381,11 @@ static BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT
            wp.ptMaxPosition.x, wp.ptMaxPosition.y,
            wine_dbgstr_rect(&wp.rcNormalPosition) );
 
+    /* win4wine: Windows sets the placement of another process's window too; the
+     * thread of the window sets it (XP's Show Desktop restores the windows that
+     * it minimized with their placements). */
+    if (win == WND_OTHER_PROCESS && win4wine_external_shell())
+        return send_message( hwnd, WM_WINE_SETWINDOWPLACEMENT, flags, (LPARAM)wndpl );
     if (!win || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return FALSE;
 
     if (flags & PLACE_MIN) win->min_pos = point_thread_to_win_dpi( hwnd, wp.ptMinPosition );
diff --git a/include/ntuser.h b/include/ntuser.h
index 34985c6..99cc2d1 100644
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -684,6 +684,7 @@ enum wine_internal_message
     WM_WINE_TRACKMOUSEEVENT,
     WM_WINE_SETPIXELFORMAT,
     WM_WINE_REFIT_MAXIMIZED,
+    WM_WINE_SETWINDOWPLACEMENT,
     WM_WINE_FIRST_DRIVER_MSG = 0x80001000,  /* range of messages reserved for the USER driver */
     WM_WINE_CLIPCURSOR = 0x80001ff0, /* internal driver notification messages */
     WM_WINE_SETCURSOR,
