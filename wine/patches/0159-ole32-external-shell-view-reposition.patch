From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] ole32: let the XP shell's view reposition items that allow only links

Purpose: every desktop icon can be dragged to another place, as on XP;
the Recycle Bin (and other items that allow only links) stayed put.
Windows behavior: XP's shell view starts DoDragDrop with its items' allowed
effects (DROPEFFECT_LINK for the Recycle Bin) and, as their target, answers
DROPEFFECT_MOVE over itself; it then moves the icons in its Drop.
Wine before: DoDragDrop kept only the allowed effects of the target's
answer, so the effect became DROPEFFECT_NONE and the target got DragLeave
instead of Drop.
Change: with the external shell, a target in the source's own process keeps
its answer when masking would leave no effect.
Scope: WIN4WINE_EXTERNAL_SHELL, drags whose target is in the source's
process and whose answer is outside the allowed effects.
---
diff --git a/dlls/ole32/ole2.c b/dlls/ole32/ole2.c
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -46,6 +46,7 @@
 #include "wine/list.h"
 
 #include "wine/debug.h"
+#include "wine/win4wine.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(ole);
 WINE_DECLARE_DEBUG_CHANNEL(accel);
@@ -2168,6 +2169,21 @@
   return DefWindowProcW (hwnd, uMsg, wParam, lParam);
 }
 
+/* The effect the target chose, within the source's allowed ones. XP's shell
+ * view repositions its own items with DROPEFFECT_MOVE, also those that allow
+ * only links (the desktop's Recycle Bin): with the external shell, a target
+ * in the source's own process keeps a choice that would be none otherwise,
+ * as on XP. */
+static void mask_effect( TrackerWindowInfo *info )
+{
+    DWORD effect = *info->pdwEffect & info->dwOKEffect, pid = 0;
+
+    if (!effect && *info->pdwEffect && win4wine_external_shell() && info->curTargetHWND &&
+        GetWindowThreadProcessId( info->curTargetHWND, &pid ) && pid == GetCurrentProcessId())
+        return;
+    *info->pdwEffect = effect;
+}
+
 static void drag_enter( TrackerWindowInfo *info, HWND new_target )
 {
     HRESULT hr;
@@ -2185,7 +2201,7 @@
         hr = IDropTarget_DragEnter( info->curDragTarget, info->dataObject,
                                     info->dwKeyState, info->curMousePos,
                                     info->pdwEffect );
-        *info->pdwEffect &= info->dwOKEffect;
+        mask_effect( info );
 
         /* failed DragEnter() means invalid target */
         if (hr != S_OK)
@@ -2212,7 +2228,7 @@
             *info->pdwEffect = info->dwOKEffect;
             hr = IDropTarget_Drop( info->curDragTarget, info->dataObject, info->dwKeyState,
                                    info->curMousePos, info->pdwEffect );
-            *info->pdwEffect &= info->dwOKEffect;
+            mask_effect( info );
 
             if (FAILED( hr ))
                 info->returnValue = hr;
@@ -2319,7 +2335,7 @@
                            trackerInfo->dwKeyState,
                            trackerInfo->curMousePos,
                            trackerInfo->pdwEffect);
-      *trackerInfo->pdwEffect &= trackerInfo->dwOKEffect;
+      mask_effect( trackerInfo );
     }
     give_feedback( trackerInfo );
   }
