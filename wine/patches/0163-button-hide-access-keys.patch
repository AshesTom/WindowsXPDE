From: AshesTom <258768419+AshesTom@users.noreply.github.com>
Subject: [PATCH] user32, comctl32: buttons and statics hide access keys with the UI state

Purpose: button and static labels ("&Turn on Automatic Updates",
"&Background:") show their access key's underline only after Alt is
pressed, as on XP.
Windows behavior: buttons and statics draw their label with DT_HIDEPREFIX while
WM_QUERYUISTATE has UISF_HIDEACCEL, and repaint on WM_UPDATEUISTATE.
Wine before: they always underlined the access key.
Change: DT_HIDEPREFIX with UISF_HIDEACCEL, and a repaint when it changes.
Scope: user32's and comctl32 6's buttons and statics. Without a UI state (Wine's own
DefWindowProc answers 0) nothing changes.
---
diff --git a/dlls/user32/button.c b/dlls/user32/button.c
--- a/dlls/user32/button.c
+++ b/dlls/user32/button.c
@@ -399,6 +399,14 @@
     case WM_GETFONT:
         return (LRESULT)get_button_font( hWnd );
 
+    case WM_UPDATEUISTATE:
+        /* Repaint when the access keys' underlines are shown or hidden. */
+        {
+            LRESULT ret = unicode ? DefWindowProcW( hWnd, uMsg, wParam, lParam ) : DefWindowProcA( hWnd, uMsg, wParam, lParam );
+            if (HIWORD(wParam) & UISF_HIDEACCEL) NtUserInvalidateRect( hWnd, NULL, FALSE );
+            return ret;
+        }
+
     case WM_SETFOCUS:
         TRACE("WM_SETFOCUS %p\n",hWnd);
         set_button_state( hWnd, get_button_state(hWnd) | BST_FOCUS );
@@ -583,6 +591,10 @@
    RECT        r = *rc;
    INT         n;
 
+   /* Access keys' underlines hidden until Alt is pressed (keyboard cues off) */
+   if (SendMessageW( hwnd, WM_QUERYUISTATE, 0, 0 ) & UISF_HIDEACCEL)
+       dtStyle |= DT_HIDEPREFIX;
+
    /* Calculate label rectangle according to label type */
    switch (style & (BS_ICON|BS_BITMAP))
    {
diff --git a/dlls/user32/static.c b/dlls/user32/static.c
--- a/dlls/user32/static.c
+++ b/dlls/user32/static.c
@@ -494,6 +494,14 @@
     case WM_GETFONT:
         return GetWindowLongPtrW( hwnd, HFONT_GWL_OFFSET );
 
+    case WM_UPDATEUISTATE:
+        /* Repaint when the access keys' underlines are shown or hidden. */
+        {
+            LRESULT ret = unicode ? DefWindowProcW( hwnd, uMsg, wParam, lParam ) : DefWindowProcA( hwnd, uMsg, wParam, lParam );
+            if (HIWORD(wParam) & UISF_HIDEACCEL) NtUserInvalidateRect( hwnd, NULL, FALSE );
+            return ret;
+        }
+
     case WM_NCHITTEST:
         if (full_style & SS_NOTIFY)
            return HTCLIENT;
@@ -621,6 +629,9 @@
 
     if (style & SS_NOPREFIX)
         format |= DT_NOPREFIX;
+    /* Access keys' underlines hidden until Alt is pressed (keyboard cues off) */
+    else if (SendMessageW( hwnd, WM_QUERYUISTATE, 0, 0 ) & UISF_HIDEACCEL)
+        format |= DT_HIDEPREFIX;
 
     if ((style & SS_TYPEMASK) != SS_SIMPLE)
     {
diff --git a/dlls/comctl32_v6/button.c b/dlls/comctl32_v6/button.c
--- a/dlls/comctl32_v6/button.c
+++ b/dlls/comctl32_v6/button.c
@@ -901,6 +901,14 @@
     case WM_GETFONT:
         return (LRESULT)infoPtr->font;
 
+    case WM_UPDATEUISTATE:
+        /* Repaint when the access keys' underlines are shown or hidden. */
+        {
+            LRESULT ret = DefWindowProcW( hWnd, uMsg, wParam, lParam );
+            if (HIWORD(wParam) & UISF_HIDEACCEL) InvalidateRect( hWnd, NULL, FALSE );
+            return ret;
+        }
+
     case WM_SETFOCUS:
         TRACE("WM_SETFOCUS %p\n",hWnd);
         infoPtr->state |= BST_FOCUS;
@@ -1736,6 +1744,9 @@
        style |= BS_RIGHT;
    split_style = infoPtr->imagelist.himl ? BUTTON_ILStoBS(infoPtr->imagelist.uAlign) : style;
    dtStyle = BUTTON_BStoDT(style, ex_style);
+   /* Access keys' underlines hidden until Alt is pressed (keyboard cues off) */
+   if (SendMessageW(infoPtr->hwnd, WM_QUERYUISTATE, 0, 0) & UISF_HIDEACCEL)
+       dtStyle |= DT_HIDEPREFIX;
 
    /* Group boxes are top aligned unless BS_PUSHLIKE is set and it's not themed */
    if (get_button_type(style) == BS_GROUPBOX
diff --git a/dlls/comctl32_v6/static.c b/dlls/comctl32_v6/static.c
--- a/dlls/comctl32_v6/static.c
+++ b/dlls/comctl32_v6/static.c
@@ -602,6 +602,14 @@
     case WM_GETFONT:
         return (LRESULT)STATIC_GetFont( hwnd );
 
+    case WM_UPDATEUISTATE:
+        /* Repaint when the access keys' underlines are shown or hidden. */
+        {
+            LRESULT ret = DefWindowProcW( hwnd, uMsg, wParam, lParam );
+            if (HIWORD(wParam) & UISF_HIDEACCEL) InvalidateRect( hwnd, NULL, FALSE );
+            return ret;
+        }
+
     case WM_NCHITTEST:
         if (full_style & SS_NOTIFY)
            return HTCLIENT;
@@ -729,6 +737,9 @@
 
     if (style & SS_NOPREFIX)
         format |= DT_NOPREFIX;
+    /* Access keys' underlines hidden until Alt is pressed (keyboard cues off) */
+    else if (SendMessageW( hwnd, WM_QUERYUISTATE, 0, 0 ) & UISF_HIDEACCEL)
+        format |= DT_HIDEPREFIX;
 
     if ((style & SS_TYPEMASK) != SS_SIMPLE)
     {
