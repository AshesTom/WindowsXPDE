From: Win4Wine contributors
Subject: [PATCH] win32u: preserve external-shell HALFTONE mapping under clipping

Keep the original stretch coordinates and interpolation phase for partial
repaints, and retain the neighboring source sample needed by bilinear
interpolation. Both StretchBlt and StretchDIBits use the same visibility rule.
The behavior is opt-in via WIN4WINE_EXTERNAL_SHELL. Ordinary Wine rendering
retains its original path. No Microsoft binary or resource is modified.

--- a/dlls/win32u/bitblt.c
+++ b/dlls/win32u/bitblt.c
@@ -23,6 +23,7 @@
 #endif
 
 #include <stdarg.h>
+#include <stdlib.h>
 #include <limits.h>
 #include <math.h>
 #include <float.h>
@@ -40,7 +41,7 @@
     return ((rop >> 2) & 0x330000) != (rop & 0x330000);
 }
 
-BOOL intersect_vis_rectangles( struct bitblt_coords *dst, struct bitblt_coords *src )
+BOOL intersect_vis_rectangles( struct bitblt_coords *dst, struct bitblt_coords *src, BOOL halftone )
 {
     RECT rect;
 
@@ -105,8 +106,11 @@
         /* avoid rounding errors */
         rect.left--;
         rect.top--;
-        rect.right++;
-        rect.bottom++;
+        /* HALFTONE needs the next sample for bilinear interpolation. The
+         * right/bottom coordinates are exclusive, so rounding alone is not
+         * enough when the visible destination ends inside a source pixel. */
+        rect.right += halftone && getenv("WIN4WINE_EXTERNAL_SHELL") ? 2 : 1;
+        rect.bottom += halftone && getenv("WIN4WINE_EXTERNAL_SHELL") ? 2 : 1;
         if (!intersect_rect( &src->visrect, &rect, &src->visrect )) return FALSE;
     }
     return TRUE;
@@ -160,7 +164,7 @@
     if (!clip_device_rect( dc_src, &src->visrect, &rect )) return FALSE;
     if (IsRectEmpty( &dst->visrect )) return FALSE;
 
-    return intersect_vis_rectangles( dst, src );
+    return intersect_vis_rectangles( dst, src, dc_dst->attr->stretch_blt_mode == HALFTONE );
 }
 
 void free_heap_bits( struct gdi_image_bits *bits )
