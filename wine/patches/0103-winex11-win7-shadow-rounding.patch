From: Codex <codex@localhost>
Subject: [PATCH] winex11: round Windows 7's drop shadow

Purpose: give menus of the Windows 7 shell session Windows 7's shadow.
Windows behavior: Windows 7's menu shadow on the reference machine has
XP's shape and depth, with the shadowed colors rounded where XP
truncates them (134, 200, 227 over 240 instead of 133, 199, 226).
Wine before: truncated as on XP.
Change: round when WIN4WINE_SHELL is win7.
Evidence: the shadow under a popup menu is pixel-identical to Windows
7's.
Scope: Windows 7 shell session only.
---
 dlls/winex11.drv/window.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 8161ea7..f66aa3e 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -1527,9 +1527,11 @@ static Window create_shadow( Display *display, Window above, int part, int x, in
 {
     Window root = DefaultRootWindow( display ), window;
     int screen = DefaultScreen( display ), cx, cy, left = x, top = y;
+    const char *shell = getenv( "WIN4WINE_SHELL" );
     XSetWindowAttributes attr;
     XImage *image;
     Pixmap pixmap;
+    double bias;
     GC gc;
 
     /* only the part on the screen can be read back */
@@ -1538,6 +1540,10 @@ static Window create_shadow( Display *display, Window above, int part, int x, in
     if (cx <= 0 || cy <= 0) return 0;
     x = max( x, 0 );
     y = max( y, 0 );
+    /* XP truncates the shadowed colors; Windows 7 rounds them (its menus' shadow
+     * on the reference machine is otherwise the same) */
+    bias = shell && !strcmp( shell, "win7" ) ? 0.5 : 0.0;
+
     X11DRV_expect_error( display, shadow_image_error, NULL );
     image = XGetImage( display, root, x, y, cx, cy, AllPlanes, ZPixmap );
     if (X11DRV_check_error() || !image)
@@ -1557,7 +1563,8 @@ static Window create_shadow( Display *display, Window above, int part, int x, in
             unsigned long pixel = XGetPixel( image, i, k );
             /* in double: 32-bit (x87) and 64-bit builds then round alike */
             double keep = 1.0 - shadow_darkness( part, i + x - left, k + y - top, part ? width : height );
-            unsigned int r = ((pixel >> 16) & 0xff) * keep, g = ((pixel >> 8) & 0xff) * keep, b = (pixel & 0xff) * keep;
+            unsigned int r = ((pixel >> 16) & 0xff) * keep + bias, g = ((pixel >> 8) & 0xff) * keep + bias;
+            unsigned int b = (pixel & 0xff) * keep + bias;
             XPutPixel( image, i, k, (pixel & ~0xffffffUL) | (r << 16) | (g << 8) | b );
         }
     pixmap = XCreatePixmap( display, root, cx, cy, image->depth );
